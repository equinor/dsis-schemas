                                                        "OpenWorksCommonModel:GeoShapeSetAttribute.update_date.isCreatable" false,
                                                        UPDATABLE 'FALSE'),
    update_user_id         VARCHAR(32)          OPTIONS("OpenWorksCommonModel:GeoShapeSetAttribute.update_user_id.isUpdatable" false,
                                                        "OpenWorksCommonModel:GeoShapeSetAttribute.update_user_id.isCreatable" false,
                                                        UPDATABLE 'FALSE'),
    alternate_uid    	   VARCHAR(4000)          OPTIONS("OpenWorksCommonModel:GeoShapeSetAttribute.alternate_uid.isCreatable" false,
                                                        "OpenWorksCommonModel:GeoShapeSetAttribute.alternate_uid.isUpdatable" false,
                                                         UPDATABLE 'FALSE'),

    CONSTRAINT GeoShapeSetAttribute_PK PRIMARY KEY (native_uid),

    CONSTRAINT GeoShapeSetAttribute_UK1 UNIQUE (geoshapeset_native_uid, attribute_name),

    CONSTRAINT FK_GeoShapeSetAttribute_geoshapeset_native_uid
    FOREIGN KEY (geoshapeset_native_uid)
    REFERENCES GeoShapeSet(native_uid)


)
OPTIONS (UPDATABLE 'TRUE', GeoShapeSetAttribute.IMPLEMENTED 'TRUE')
  AS
  SELECT
    OpenWorks_SM.GeoShapeSetAttribute.native_uid                   AS native_uid,
    OpenWorks_SM.GeoShapeSet.shape_set_id                          AS geoshapeset_native_uid,
    attribute_name,
    OpenWorks_SM.GeoShapeSetAttribute.data_source                  AS data_source,
    unit_type_id                                                   AS unit_type,
    data_type,
    numerical_value,
    numerical_value_dsdsunit                                       AS numerical_value_unit,
    text_value,
    OpenWorks_SM.GeoShapeSetAttribute.remark                       AS remark,
    OpenWorks_SM.GeoShapeSetAttribute.create_date                  AS create_date,
    OpenWorks_SM.GeoShapeSetAttribute.create_user_id               AS create_user_id,
    OpenWorks_SM.GeoShapeSetAttribute.update_date                  AS update_date,
    OpenWorks_SM.GeoShapeSetAttribute.update_user_id               AS update_user_id,
    OpenWorks_SM.GeoShapeSetAttribute.native_uid                   AS alternate_uid
  FROM
    OpenWorks_SM.GeoShapeSetAttribute LEFT OUTER JOIN OpenWorks_SM.GeoShapeSet ON OpenWorks_SM.GeoShapeSet.shape_set_id = OpenWorks_SM.GeoShapeSetAttribute.shape_set_id;

CREATE TRIGGER ON GeoShapeSetAttribute INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC

  DECLARE string VARIABLES.geoshapeset_native_uid_errorMsg= CONCAT (CONCAT('ERROR: The given shape set id "',"NEW".geoshapeset_native_uid),'" does not exist.');

  DECLARE string VARIABLES.geoshapeset_native_uid;
  IF("NEW".geoshapeset_native_uid IS NOT NULL)
  BEGIN
      VARIABLES.geoshapeset_native_uid = (SELECT shape_set_id FROM OpenWorks_SM.GeoShapeSet WHERE shape_set_id="NEW".geoshapeset_native_uid);
          IF(VARIABLES.geoshapeset_native_uid is NULL)
              ERROR VARIABLES.geoshapeset_native_uid_errorMsg;
  END

  INSERT INTO OpenWorks_SM.GeoShapeSetAttribute
         (shape_set_id,                     attribute_name,       data_source,                        data_type,       numerical_value,       numerical_value_dsdsunit,   text_value,       remark)
  VALUES (VARIABLES.geoshapeset_native_uid, "NEW".attribute_name, SUBSTRING("NEW".data_source, 1, 5), "NEW".data_type, "NEW".numerical_value, "NEW".numerical_value_unit, "NEW".text_value, "NEW".remark );

END;

Create Trigger on GeoShapeSetAttribute INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC

  DECLARE string VARIABLES.geoshapeset_native_uid_errorMsg= CONCAT (CONCAT('ERROR: The given shape set id "',"NEW".geoshapeset_native_uid),'" does not exist.');

  DECLARE string VARIABLES.geoshapeset_native_uid;
  IF("NEW".geoshapeset_native_uid IS NOT NULL)
  BEGIN
      VARIABLES.geoshapeset_native_uid = (SELECT shape_set_id FROM OpenWorks_SM.GeoShapeSet WHERE shape_set_id="NEW".geoshapeset_native_uid);
          IF(VARIABLES.geoshapeset_native_uid is NULL)
              ERROR VARIABLES.geoshapeset_native_uid_errorMsg;
  END

  UPDATE OpenWorks_SM.GeoShapeSetAttribute SET
    attribute_name               = "NEW".attribute_name,
    data_source                  = SUBSTRING("NEW".data_source, 1, 5),
    data_type                    = "NEW".data_type,
    numerical_value              = "NEW".numerical_value,
    numerical_value_dsdsunit     = "NEW".numerical_value_unit,
    text_value                   = "NEW".text_value,
    remark                       = "NEW".remark
  WHERE  native_uid = "OLD".native_uid;
END;

CREATE TRIGGER ON GeoShapeSetAttribute INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC
  DELETE FROM OpenWorks_SM.GeoShapeSetAttribute WHERE native_uid = "OLD".native_uid;
END;

/*
**********************************
* ENTITY: ShapeNodeProperty
**********************************
*/

CREATE VIEW ShapeNodeProperty
(
    native_uid                  VARCHAR(1024) 	    OPTIONS("OpenWorksCommonModel:ShapeNodeProperty.native_uid.isUpdatable" false,
                                                            "OpenWorksCommonModel:ShapeNodeProperty.native_uid.isCreatable" false,
                                                            UPDATABLE 'FALSE'),
    geoshapeset_native_uid      VARCHAR(1024)       NOT NULL,
    attribute_name              VARCHAR(40)         NOT NULL DEFAULT 'UNKNOWN',
    unit_type                   VARCHAR(64)         OPTIONS("OpenWorksCommonModel:ShapeNodeProperty.unit_type.isUpdatable" false,
                                                            "OpenWorksCommonModel:ShapeNodeProperty.unit_type.isCreatable" false,
                                                            UPDATABLE 'FALSE'),
    data_type                   VARCHAR(8)          NOT NULL,
    no_data_value               FLOAT,
    remark                      VARCHAR(200),
    num_values                  INTEGER,
    node_property_values        BLOB,
    create_date                 TIMESTAMP           OPTIONS("OpenWorksCommonModel:ShapeNodeProperty.create_date.isUpdatable" false,
                                                            "OpenWorksCommonModel:ShapeNodeProperty.create_date.isCreatable" false,
                                                            UPDATABLE 'FALSE'),
    create_user_id              VARCHAR(32)         OPTIONS("OpenWorksCommonModel:ShapeNodeProperty.create_user_id.isUpdatable" false,
                                                            "OpenWorksCommonModel:ShapeNodeProperty.create_user_id.isCreatable" false,
                                                            UPDATABLE 'FALSE'),
    update_date                 TIMESTAMP           OPTIONS("OpenWorksCommonModel:ShapeNodeProperty.update_date.isUpdatable" false,
                                                            "OpenWorksCommonModel:ShapeNodeProperty.update_date.isCreatable" false,
                                                            UPDATABLE 'FALSE'),
    update_user_id              VARCHAR(32)         OPTIONS("OpenWorksCommonModel:ShapeNodeProperty.update_user_id.isUpdatable" false,
                                                            "OpenWorksCommonModel:ShapeNodeProperty.update_user_id.isCreatable" false,
                                                            UPDATABLE 'FALSE'),
    alternate_uid    	        VARCHAR(4000)       OPTIONS("OpenWorksCommonModel:ShapeNodeProperty.alternate_uid.isCreatable" false,
                                                            "OpenWorksCommonModel:ShapeNodeProperty.alternate_uid.isUpdatable" false,
                                                             UPDATABLE 'FALSE'),

    CONSTRAINT ShapeNodeProperty_PK PRIMARY KEY (native_uid),

    CONSTRAINT ShapeNodeProperty_UK1 UNIQUE (geoshapeset_native_uid, attribute_name),

    CONSTRAINT FK_ShapeNodeProperty_geoshapeset_native_uid
    FOREIGN KEY (geoshapeset_native_uid)
    REFERENCES GeoShapeSet(native_uid)


)
OPTIONS (UPDATABLE 'TRUE', ShapeNodeProperty.IMPLEMENTED 'TRUE')
    AS
    SELECT
        OpenWorks_SM.ShapeNodeProperty.native_uid                   AS  native_uid,
        OpenWorks_SM.GeoShapeSet.shape_set_id                       AS  geoshapeset_native_uid,
        attribute_name,
        unit_type_id                                                AS unit_type,
        data_type,
        no_data_value,
        OpenWorks_SM.ShapeNodeProperty.remark                       AS  remark,
        num_values,
        node_property_values,
        OpenWorks_SM.ShapeNodeProperty.create_date                  AS create_date,
        OpenWorks_SM.ShapeNodeProperty.create_user_id               AS create_user_id,
        OpenWorks_SM.ShapeNodeProperty.update_date                  AS update_date,
        OpenWorks_SM.ShapeNodeProperty.update_user_id               AS update_user_id,
        OpenWorks_SM.ShapeNodeProperty.native_uid                   AS alternate_uid
    FROM
        OpenWorks_SM.ShapeNodeProperty LEFT OUTER JOIN OpenWorks_SM.GeoShapeSet ON OpenWorks_SM.GeoShapeSet.shape_set_id = OpenWorks_SM.ShapeNodeProperty.shape_set_id;

