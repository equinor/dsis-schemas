END;


CREATE TRIGGER ON InterpProcessInput INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC
    UPDATE OpenWorks_SM.InterpProcessInput SET
    interp_process_id="NEW".interp_process_native_uid,input_data_id="NEW".input_data_id,input_data_type="NEW".input_data_type
    WHERE native_uid = "OLD".native_uid;
END;

CREATE TRIGGER ON InterpProcessInput INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC
    DELETE FROM OpenWorks_SM.InterpProcessInput WHERE native_uid = "OLD".native_uid;
END;


