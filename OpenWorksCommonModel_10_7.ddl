CREATE VIEW Film
(
  native_uid             VARCHAR(1024) OPTIONS("OpenWorksCommonModel:Film.native_uid.isUpdatable" false,
                                               "OpenWorksCommonModel:Film.native_uid.isCreatable" false,
                                                UPDATABLE 'FALSE'),
  attribute_update       VARCHAR(4000),
  bottom_depth           FLOAT,
  comment                VARCHAR(4000),
  creator                VARCHAR(4000),
  date_logged            VARCHAR(4000),
  date_stamp             VARCHAR(4000),
  depth_units            VARCHAR(4000),
  description            VARCHAR(4000),
  dir_directory          VARCHAR(4000),
  directory              VARCHAR(4000),
  ex_file                VARCHAR(4000),
  file                   VARCHAR(4000),
  film_format            VARCHAR(4000) NOT NULL,
  film_type              VARCHAR(4000) NOT NULL,
  film_version           INTEGER       NOT NULL,
  folder                 VARCHAR(4000),
  link_type              VARCHAR(4000),
  logging_contractor     VARCHAR(4000),
  name                   VARCHAR(4000) NOT NULL,
  process_status         VARCHAR(4000),
  program_name           VARCHAR(4000),
  security_access        VARCHAR(4000),
  security_access_list   VARCHAR(4000),
  security_flag          VARCHAR(4000),
  security_grade         VARCHAR(4000),
  security_user_count    INTEGER,
  siz_file               INTEGER,
  top_depth              FLOAT,
  wellbore_native_uid    VARCHAR(1024) NOT NULL,
  wellbore_uwi           VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:Film.wellbore_uwi.isUpdatable" false,
                                                "OpenWorksCommonModel:Film.wellbore_uwi.isCreatable" false, UPDATABLE 'FALSE'),
  file_stream            BLOB          OPTIONS ("OpenWorksCommonModel:Film.file_stream.isMedia"          true,
                                                "OpenWorksCommonModel:Film.file_stream.mediaContentType" 'application/octet-stream'),
  alternate_uid    		     VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:Film.alternate_uid.isCreatable" false,
                                                "OpenWorksCommonModel:Film.alternate_uid.isUpdatable" false,
                                                 UPDATABLE 'FALSE'),

  CONSTRAINT Film_PK PRIMARY KEY (native_uid),

  CONSTRAINT Film_UK1 UNIQUE (wellbore_native_uid, film_version, film_format, name, film_type),

  CONSTRAINT FK_Film_wellbore_native_uid
    FOREIGN KEY        (wellbore_native_uid)
    REFERENCES Wellbore(native_uid)


)
OPTIONS (UPDATABLE 'FALSE' , Film.IMPLEMENTED 'FALSE')
    AS
    SELECT
        null AS native_uid,
        null AS attribute_update,
        null AS bottom_depth,
        null AS comment,
        null AS creator,
        null AS date_logged,
        null AS date_stamp,
        null AS depth_units,
        null AS description,
        null AS dir_directory,
        null AS directory,
        null AS ex_file,
        null AS file,
        null AS film_format,
        null AS film_type,
        null AS film_version,
        null AS folder,
        null AS link_type,
        null AS logging_contractor,
        null AS name,
        null AS process_status,
        null AS program_name,
        null AS security_access,
        null AS security_access_list,
        null AS security_flag,
        null AS security_grade,
        null AS security_user_count,
        null AS siz_file,
        null AS top_depth,
        null AS wellbore_native_uid,
        null AS wellbore_uwi,
        null AS file_stream,
	    null AS alternate_uid
    FROM SYS.Tables
        WHERE 1 = 2
;

