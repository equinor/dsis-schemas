    numerical_value        DOUBLE               OPTIONS("OpenWorksCommonModel:GeoShapeSetAttribute.numerical_value.unitField" 'numerical_value_unit'),
    numerical_value_unit   VARCHAR(64)          OPTIONS("OpenWorksCommonModel:GeoShapeSetAttribute.numerical_value_unit.unitTypeAttribute" 'unit_type'),
    remark                 VARCHAR(200),
