                                VALUES("NEW".litho_class, "NEW".litho_class_by, "NEW".litho_class_symbol, "NEW".litho_foreground_color, "NEW".litho_foreground_color_r, "NEW".litho_foreground_color_g, "NEW".litho_foreground_color_b, "NEW".litho_background_color, "NEW".litho_background_color_r, "NEW".litho_background_color_g, "NEW".litho_background_color_b, "NEW".remark, "NEW".ref_value_status, "NEW".ref_value_source );
