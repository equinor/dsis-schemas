CREATE VIEW WellPlanningGroup
(
  native_uid           VARCHAR(1024) OPTIONS("OpenWorksCommonModel:WellPlanningGroup.native_uid.isUpdatable" false,
                                               "OpenWorksCommonModel:WellPlanningGroup.native_uid.isCreatable" false,
                                                UPDATABLE 'FALSE'),
  group_name             VARCHAR(40) NOT NULL,
  group_description      VARCHAR(200),
  remark                 VARCHAR(200),
 create_date           TIMESTAMP   OPTIONS ("OpenWorksCommonModel:WellPlanningGroup.create_date.isUpdatable" false,
                                            "OpenWorksCommonModel:WellPlanningGroup.create_date.isCreatable" false,UPDATABLE 'FALSE'),
  create_user_id       VARCHAR(32) OPTIONS("OpenWorksCommonModel:WellPlanningGroup.create_user_id.isUpdatable" false,
                                           "OpenWorksCommonModel:WellPlanningGroup.create_user_id.isCreatable" false,
                                            UPDATABLE 'FALSE'),
  update_date          TIMESTAMP   OPTIONS("OpenWorksCommonModel:WellPlanningGroup.update_date.isUpdatable" false,
                                           "OpenWorksCommonModel:WellPlanningGroup.update_date.isCreatable" false,UPDATABLE 'FALSE'),
  update_user_id       VARCHAR(32) OPTIONS("OpenWorksCommonModel:WellPlanningGroup.update_user_id.isUpdatable" false,
                                           "OpenWorksCommonModel:WellPlanningGroup.update_user_id.isCreatable" false,
                                            UPDATABLE 'FALSE'),
  alternate_uid    		   VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:WellPlanningGroup.alternate_uid.isCreatable" false,
                                              "OpenWorksCommonModel:WellPlanningGroup.alternate_uid.isUpdatable" false,
                                               UPDATABLE 'FALSE'),
CONSTRAINT WellPlanningGroup_PK PRIMARY KEY (native_uid),

    CONSTRAINT WellPlanningGroup_UK1 UNIQUE (group_name)
) OPTIONS(UPDATABLE 'TRUE', WellPlanningGroup.IMPLEMENTED 'TRUE')
AS
SELECT
OpenWorks_SM.WellPlanningGroup.WP_GROUP_id,
OpenWorks_SM.WellPlanningGroup.WP_GROUP_NAME,
OpenWorks_SM.WellPlanningGroup.WP_GROUP_DESC,
OpenWorks_SM.WellPlanningGroup.REMARK AS remark,
OpenWorks_SM.WellPlanningGroup.CREATE_DATE AS create_date,
OpenWorks_SM.WellPlanningGroup.CREATE_USER_ID AS create_user_id,
OpenWorks_SM.WellPlanningGroup.UPDATE_DATE AS update_date,
OpenWorks_SM.WellPlanningGroup.UPDATE_USER_ID AS update_user_id,
OpenWorks_SM.WellPlanningGroup.native_uid
    FROM
        OpenWorks_SM.WellPlanningGroup;


CREATE TRIGGER ON WellPlanningGroup INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC
INSERT INTO OpenWorks_SM.WellPlanningGroup(wp_group_name,wp_group_desc,remark) values ("NEW".group_name,"NEW".group_description,"NEW".remark);
END;

CREATE TRIGGER ON WellPlanningGroup INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC
   UPDATE  OpenWorks_SM.WellPlanningGroup SET wp_group_desc="NEW".group_description,remark="NEW".remark WHERE OpenWorks_SM.WellPlanningGroup.wp_group_id="OLD".native_uid;
END;

CREATE TRIGGER ON WellPlanningGroup INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC
   DELETE FROM OpenWorks_SM.WellPlanningGroup  WHERE wp_group_id="OLD".native_uid;
END;


        /*
**********************************
*     "WellPlanProject"
**********************************
*/
CREATE VIEW WellPlanProject
(
  native_uid        VARCHAR(1024)   OPTIONS("OpenWorksCommonModel:WellPlanProject.native_uid.isUpdatable" false,
                                            "OpenWorksCommonModel:WellPlanProject.native_uid.isCreatable" false,
                                             UPDATABLE 'FALSE'),
  project_name      VARCHAR(40) NOT NULL,
  wellplanninggroup_native_uid      VARCHAR(1024),
  group_name        VARCHAR(40), /* Marked NOT NULL in Common Model 1.6*/
  min_x             DOUBLE          NOT NULL DEFAULT '0' OPTIONS ("OpenWorksCommonModel:WellPlanProject.min_x.unitField" 'xy_unit'),
  min_y             DOUBLE          NOT NULL DEFAULT '0' OPTIONS ("OpenWorksCommonModel:WellPlanProject.min_y.unitField" 'xy_unit'),
  max_x             DOUBLE          NOT NULL DEFAULT '0' OPTIONS ("OpenWorksCommonModel:WellPlanProject.max_x.unitField" 'xy_unit'),
  max_y             DOUBLE          NOT NULL DEFAULT '0' OPTIONS ("OpenWorksCommonModel:WellPlanProject.max_y.unitField" 'xy_unit'),
  xy_unit           VARCHAR(64) ,
  crs               VARCHAR(80),
  start_date        TIMESTAMP,
  end_date          TIMESTAMP,
  remark            VARCHAR(200),
create_date         TIMESTAMP   OPTIONS("OpenWorksCommonModel:WellPlanProject.create_date.isUpdatable" false,
                                        "OpenWorksCommonModel:WellPlanProject.create_date.isCreatable" false,UPDATABLE 'FALSE'),
  create_user_id    VARCHAR(32) OPTIONS("OpenWorksCommonModel:WellPlanProject.create_user_id.isUpdatable" false,
                                        "OpenWorksCommonModel:WellPlanProject.create_user_id.isCreatable" false,UPDATABLE 'FALSE'),
  update_date       TIMESTAMP   OPTIONS("OpenWorksCommonModel:WellPlanProject.update_date.isUpdatable" false,
                                        "OpenWorksCommonModel:WellPlanProject.update_date.isCreatable" false,UPDATABLE 'FALSE'),
  update_user_id    VARCHAR(32) OPTIONS("OpenWorksCommonModel:WellPlanProject.update_user_id.isUpdatable" false,
                                        "OpenWorksCommonModel:WellPlanProject.update_user_id.isCreatable" false,UPDATABLE 'FALSE'),
  alternate_uid    		VARCHAR(4000)   OPTIONS ("OpenWorksCommonModel:WellPlanProject.alternate_uid.isCreatable" false,
                                             "OpenWorksCommonModel:WellPlanProject.alternate_uid.isUpdatable" false,
                                             UPDATABLE 'FALSE'),



    CONSTRAINT WellPlanProject_PK PRIMARY KEY (native_uid),

    CONSTRAINT WellPlanProject_UK1 UNIQUE (project_name),

  CONSTRAINT FK_WellPlanProject_crs
    FOREIGN KEY                    (crs)
    REFERENCES CartoReferenceSystem(name),

    CONSTRAINT FK_WellPlanProject_wellplanninggroup_native_uid
        FOREIGN KEY                 (wellplanninggroup_native_uid)
        REFERENCES WellPlanningGroup(native_uid)

) OPTIONS (UPDATABLE 'TRUE',  WellPlanProject.IMPLEMENTED 'TRUE')
AS
SELECT
 OpenWorks_SM.WellPlanProj.wp_project_id,
 OpenWorks_SM.WellPlanProj.wp_project_name ,
 OpenWorks_SM.WellPlanningGroup.wp_group_id,
 OpenWorks_SM.WellPlanningGroup.wp_group_name  ,
 OpenWorks_SM.WellPlanProj.min_x,
 OpenWorks_SM.WellPlanProj.min_y,
 OpenWorks_SM.WellPlanProj.max_x,
 OpenWorks_SM.WellPlanProj.max_y,
 COALESCE(OpenWorks_SM.WellPlanProj.min_x_dsdsunit,OpenWorks_SM.WellPlanProj.min_y_dsdsunit,OpenWorks_SM.WellPlanProj.max_x_dsdsunit,OpenWorks_SM.WellPlanProj.max_x_dsdsunit) as xy_unit,
 getDSDSCrs(OpenWorks_SM.CartoRefSys.name) as crs,
 OpenWorks_SM.WellPlanProj.start_date,
 OpenWorks_SM.WellPlanProj.end_date,
 OpenWorks_SM.WellPlanProj.remark ,
 OpenWorks_SM.WellPlanProj.create_date,
 OpenWorks_SM.WellPlanProj.create_user_id,
  OpenWorks_SM.WellPlanProj.update_date,
 OpenWorks_SM.WellPlanProj.update_user_id,
 OpenWorks_SM.WellPlanProj.native_uid

FROM
  OpenWorks_SM.WellPlanProj LEFT OUTER JOIN OpenWorks_SM.WellPlanningGroup ON OpenWorks_SM.WellPlanProj.wp_group_id = OpenWorks_SM.WellPlanningGroup.wp_group_id, OpenWorks_SM.CartoRefSys  where
   OpenWorks_SM.WellPlanProj.crs_id = OpenWorks_SM.CartoRefSys.id;


CREATE TRIGGER ON WellPlanProject INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC

     DECLARE string VARIABLES.crs_errorMsg='ERROR: The given value for crs does not exist';
     DECLARE string VARIABLES.wp_group_id_errorMsg='ERROR: The WellPlanningGroup with group_id ' || "NEW".wellplanninggroup_native_uid || ' does not exist';
     DECLARE string VARIABLES.wp_group_id;
     DECLARE double VARIABLES.min_x = "NEW".min_x;
     DECLARE double VARIABLES.max_x = "NEW".max_x;
     DECLARE double VARIABLES.min_y = "NEW".min_y;
     DECLARE double VARIABLES.max_y = "NEW".max_y;
     DECLARE string VARIABLES.xy_unit = "NEW".xy_unit;

         DECLARE integer VARIABLES.crs_id;
    IF((VARIABLES.min_x = -1) OR (VARIABLES.min_y = -1))
    BEGIN
        INSERT INTO #TmpTbl (#TmpTbl.min_x, #TmpTbl.min_y, #TmpTbl.max_x,#TmpTbl.max_y,#TmpTbl.xy_unit) select min_x,min_y,max_x,max_y,min_x_dsdsunit from OpenWorks_SM.project;
        VARIABLES.min_x = (select #TmpTbl.min_x from #TmpTbl);
        VARIABLES.max_x = (select #TmpTbl.max_x from #TmpTbl);
        VARIABLES.min_y = (select #TmpTbl.min_y from #TmpTbl);
        VARIABLES.max_y = (select #TmpTbl.max_y from #TmpTbl);
        VARIABLES.xy_unit = (select #TmpTbl.xy_unit from #TmpTbl);
    END

    /*IF("NEW".crs is NOT NULL)
    BEGIN
        VARIABLES.crs_id = (SELECT id FROM OpenWorks_SM.CartoRefSys WHERE name = (SELECT * FROM (EXEC OpenWorks_SM.GetNativeCRS("NEW".crs,'OW')) AS SysGenID));
        IF(VARIABLES.crs_id is NULL) ERROR VARIABLES.crs_errorMsg;
    END*/

    IF("NEW".wellplanninggroup_native_uid is NOT NULL)
        BEGIN
       VARIABLES.wp_group_id = (SELECT OpenWorks_SM.WellPlanningGroup.wp_group_id FROM OpenWorks_SM.WellPlanningGroup WHERE OpenWorks_SM.WellPlanningGroup.wp_group_id = "NEW".wellplanninggroup_native_uid);
    IF(VARIABLES.wp_group_id is NULL) ERROR VARIABLES.wp_group_id_errorMsg;
    END
INSERT INTO OpenWorks_SM.WellPlanProj
(OpenWorks_SM.WellPlanProj.wp_project_name,OpenWorks_SM.WellPlanProj.wp_group_id, OpenWorks_SM.WellPlanProj.min_x, OpenWorks_SM.WellPlanProj.min_y,OpenWorks_SM.WellPlanProj.max_x, OpenWorks_SM.WellPlanProj.max_y, OpenWorks_SM.WellPlanProj.crs_id,OpenWorks_SM.WellPlanProj.start_date, OpenWorks_SM.WellPlanProj.end_date,OpenWorks_SM.WellPlanProj.remark) VALUES ("NEW".project_name, VARIABLES.wp_group_id, VARIABLES.min_x, VARIABLES.min_y, VARIABLES.max_x, VARIABLES.max_y,  VARIABLES.crs_id, "NEW".start_date, "NEW".end_date, "New".remark);
END;



  CREATE TRIGGER ON WellPlanProject INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC

    DECLARE string VARIABLES.crs_errorMsg='ERROR: The given value for crs does not exist';
    DECLARE string VARIABLES.wp_group_id_errorMsg='ERROR: The WellPlanningGroup with given value for group_id does not exist';
    DECLARE string VARIABLES.crs_id;
    DECLARE string VARIABLES.wp_group_id;

      IF("NEW".crs is NOT NULL)
      BEGIN
        VARIABLES.crs_id = (SELECT id FROM OpenWorks_SM.CartoRefSys WHERE name = (SELECT * FROM (EXEC OpenWorks_SM.GetNativeCRS("NEW".crs,'OW')) AS SysGenID));
        IF(VARIABLES.crs_id is NULL) ERROR VARIABLES.crs_errorMsg;
      END

    IF("NEW".wellplanninggroup_native_uid is NOT NULL)
      BEGIN
       VARIABLES.wp_group_id = (SELECT OpenWorks_SM.WellPlanningGroup.wp_group_id FROM OpenWorks_SM.WellPlanningGroup WHERE OpenWorks_SM.WellPlanningGroup.wp_group_id = "NEW".wellplanninggroup_native_uid);
        IF(VARIABLES.wp_group_id is NULL) ERROR VARIABLES.wp_group_id_errorMsg;
      END

      UPDATE OpenWorks_SM.WellPlanProj SET wp_group_id= VARIABLES.wp_group_id,min_x = "NEW".min_x,min_y = "NEW".min_y, max_x = "NEW".max_x, max_y = "NEW".max_y, crs_id = VARIABLES.crs_id,
      start_date = "NEW".start_date, end_date = "NEW".end_date, remark = "NEW".remark WHERE wp_project_id = "OLD".native_uid;
END;


CREATE TRIGGER ON WellPlanProject INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC
   DELETE FROM OpenWorks_SM.WellPlanProj  WHERE OpenWorks_SM.WellPlanProj.wp_project_id="OLD".native_uid;
END;

/*
**********************************
*           "Target"
**********************************
*/

CREATE VIEW Target
(
native_uid                  VARCHAR(1024)  OPTIONS("OpenWorksCommonModel:Target.native_uid.isUpdatable" false,
                                                       "OpenWorksCommonModel:Target.native_uid.isCreatable" false,
                                                       UPDATABLE 'FALSE'),
wellplanproject_native_uid  VARCHAR(1024) NOT NULL,
project_name        VARCHAR(40) OPTIONS("OpenWorksCommonModel:Target.project_name.isUpdatable" false,
                                           "OpenWorksCommonModel:Target.project_name.isCreatable" false,
                                           UPDATABLE 'FALSE'),
target_name         VARCHAR(200) NOT NULL,
target_x            DOUBLE       OPTIONS ("OpenWorksCommonModel:Target.target_x.unitField" 'target_xy_unit'),
target_y            DOUBLE       OPTIONS ("OpenWorksCommonModel:Target.target_y.unitField" 'target_xy_unit'),
target_xy_unit      VARCHAR(64),
target_crs          VARCHAR(80),
target_z            DOUBLE       OPTIONS ("OpenWorksCommonModel:Target.target_z.unitField" 'target_z_unit'),
target_z_unit       VARCHAR(64)  OPTIONS ("OpenWorksCommonModel:Target.target_z_unit.unitType" 'depth measure'),
target_time         DOUBLE       OPTIONS ("OpenWorksCommonModel:Target.target_time.unitField" 'target_time_unit'),
target_time_unit    VARCHAR(64)  OPTIONS ("OpenWorksCommonModel:Target.target_time_unit.unitType" 'seismic time'),
time_datum          DOUBLE       OPTIONS ("OpenWorksCommonModel:Target.time_datum.unitField" 'time_datum_unit'),
time_datum_unit     VARCHAR(64)  OPTIONS ("OpenWorksCommonModel:Target.time_datum_unit.unitType" 'elevation'),
fixed_target_ind    VARCHAR(1),
target_type         VARCHAR(24),
target_subtype      VARCHAR(24),
color_index         INTEGER,
feature_name        VARCHAR(40),
application         VARCHAR(10),
interpreter         VARCHAR(5),
remark              VARCHAR(200),
create_date         TIMESTAMP    OPTIONS("OpenWorksCommonModel:Target.create_date.isUpdatable" false,
                                         "OpenWorksCommonModel:Target.create_date.isCreatable" false,UPDATABLE 'FALSE'),
  create_user_id    VARCHAR(32)  OPTIONS("OpenWorksCommonModel:Target.create_user_id.isUpdatable" false,
                                         "OpenWorksCommonModel:Target.create_user_id.isCreatable" false,UPDATABLE 'FALSE'),
  update_date       TIMESTAMP    OPTIONS("OpenWorksCommonModel:Target.update_date.isUpdatable" false,
                                         "OpenWorksCommonModel:Target.update_date.isCreatable" false,UPDATABLE 'FALSE'),
  update_user_id    VARCHAR(32)  OPTIONS("OpenWorksCommonModel:Target.update_user_id.isUpdatable" false,
                                         "OpenWorksCommonModel:Target.update_user_id.isCreatable" false,UPDATABLE 'FALSE'),
  alternate_uid    		VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:Target.alternate_uid.isCreatable" false,
                                           "OpenWorksCommonModel:Target.alternate_uid.isUpdatable" false,
                                            UPDATABLE 'FALSE'),


    CONSTRAINT Target_PK PRIMARY KEY (native_uid),

    CONSTRAINT Target_UK1 UNIQUE (wellplanproject_native_uid, target_name),

    CONSTRAINT FK_Target_wellplanproject_native_uid
        FOREIGN KEY               (wellplanproject_native_uid)
        REFERENCES WellPlanProject(native_uid),

    CONSTRAINT FK_Target_target_crs
        FOREIGN KEY                    (target_crs)
        REFERENCES CartoReferenceSystem(name)

)
OPTIONS(UPDATABLE 'TRUE', Target.IMPLEMENTED 'TRUE')
As
SELECT
OpenWorks_SM.TARGET.TARGET_ID AS native_uid,
OpenWorks_SM.WellPlanProj.WP_PROJECT_ID AS wellplanproject_native_uid,
OpenWorks_SM.WellPlanProj.WP_PROJECT_NAME,
OpenWorks_SM.TARGET.TARGET_NAME AS target_name,
OpenWorks_SM.TARGET.TARGET_X AS target_x,
OpenWorks_SM.TARGET.TARGET_Y AS target_y,
COALESCE(OpenWorks_SM.TARGET.target_x_dsdsunit,OpenWorks_SM.TARGET.target_y_dsdsunit) AS target_xy_unit,
(Select getDSDSCrs(name) from OpenWorks_SM.CartoRefSys,OpenWorks_SM.Project where OpenWorks_SM.CartoRefSys.id = OpenWorks_SM.Project.xy_crs_id) AS target_crs,
OpenWorks_SM.TARGET.TARGET_Z AS target_z,
OpenWorks_SM.TARGET.TARGET_Z_dsdsunit AS target_z_unit,
OpenWorks_SM.TARGET.TARGET_TIME AS target_time,
OpenWorks_SM.TARGET.TARGET_TIME_dsdsunit AS target_time_unit,
OpenWorks_SM.TARGET.TIME_DATUM AS time_datum,
OpenWorks_SM.TARGET.TIME_DATUM_dsdsunit AS time_datum_unit,
OpenWorks_SM.TARGET.FIXED_TARGET_IND AS fixed_target_ind,
CATEGORY AS target_type,
CATEGORY_SUBTYPE AS target_subtype,
OpenWorks_SM.TARGET.COLOR_INDEX AS color_index,
OpenWorks_SM.TARGET.FEATURE_NAME AS feature_name,
OpenWorks_SM.TARGET.APPLICATION AS application,
OpenWorks_SM.TARGET.INTERPRETER AS interpreter,
OpenWorks_SM.TARGET.REMARK AS remark,
OpenWorks_SM.TARGET.CREATE_DATE AS create_date,
OpenWorks_SM.TARGET.CREATE_USER_ID AS create_user_id,
OpenWorks_SM.TARGET.UPDATE_DATE AS update_date,
OpenWorks_SM.TARGET.UPDATE_USER_ID AS update_user_id,
OpenWorks_SM.TARGET.native_uid
  FROM
  OpenWorks_SM.TARGET INNER JOIN OpenWorks_SM.WellPlanProj
  ON
  OpenWorks_SM.TARGET.WP_PROJECT_ID = OpenWorks_SM.WellPlanProj.WP_PROJECT_ID;

CREATE TRIGGER ON Target INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC
   DECLARE string VARIABLES.wp_project_id_errorMsg='ERROR: The WellPlan Project with given value '|| "NEW".wellplanproject_native_uid || '  does not exist';
   DECLARE string VARIABLES.wp_project_id = (SELECT WP_PROJECT_ID FROM OpenWorks_SM.WellPlanProj WHERE wp_project_id  = "NEW".wellplanproject_native_uid);

   IF (VARIABLES.wp_project_id IS NULL ) ERROR VARIABLES.wp_project_id_errorMsg;

   DECLARE double VARIABLES.X = "NEW".target_x;
   DECLARE double VARIABLES.Y = "NEW".target_y;
   DECLARE string VARIABLES.XYUnit = "NEW".target_xy_unit;
   DECLARE string VARIABLES.targetCRS = (Select name from OpenWorks_SM.CartoRefSys,OpenWorks_SM.Project where OpenWorks_SM.CartoRefSys.id = OpenWorks_SM.Project.xy_crs_id);
   DECLARE blob convertedXYBlob = cartoConvert(getDSDSCrs("NEW".target_crs), getDSDSCrs(VARIABLES.targetCRS),VARIABLES.X, VARIABLES.Y, VARIABLES.XYUnit);
   IF(convertedXYBlob IS NOT NULL)
   BEGIN
       VARIABLES.X= fetchDElementValueFromBlob(convertedXYBlob,'x');
       VARIABLES.Y= fetchDElementValueFromBlob(convertedXYBlob,'y');
       VARIABLES.XYUnit= fetchElementUnitNameFromBlob(convertedXYBlob,'x');
   END

   INSERT INTO OpenWorks_SM.Target (WP_PROJECT_ID,TARGET_NAME,TARGET_X, TARGET_Y,TARGET_Z,TARGET_Z_dsdsunit,TARGET_TIME,TARGET_TIME_dsdsunit,TIME_DATUM,TIME_DATUM_dsdsunit,FIXED_TARGET_IND, CATEGORY, CATEGORY_SUBTYPE, COLOR_INDEX, FEATURE_NAME, APPLICATION,INTERPRETER, REMARK )
   VALUES(VARIABLES.wp_project_id,"NEW".target_name, VARIABLES.X, VARIABLES.Y, "NEW".target_z,"NEW".target_z_unit,"NEW".target_time,"NEW".target_time_unit,"NEW".time_datum,"NEW".time_datum_unit,"NEW".fixed_target_ind, SUBSTRING("NEW".target_type, 1, 24), "NEW".target_subtype, "NEW".color_index,"NEW".feature_name,"NEW".application,"NEW".interpreter,"NEW".remark);


END;




CREATE TRIGGER ON Target INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC

    DECLARE string VARIABLES.wp_project_id = (SELECT WP_PROJECT_ID FROM OpenWorks_SM.WellPlanProj WHERE wp_project_id  = "OLD".wellplanproject_native_uid);
    DECLARE string VARIABLES.target_id = (SELECT target_id from OpenWorks_SM.Target where target_name="OLD".target_name and wp_project_id=VARIABLES.wp_project_id);
      DECLARE double VARIABLES.X = "NEW".target_x;
       DECLARE double VARIABLES.Y = "NEW".target_y;
       DECLARE string VARIABLES.XYUnit = "NEW".target_xy_unit;
       DECLARE string VARIABLES.targetCRS = (Select name from OpenWorks_SM.CartoRefSys,OpenWorks_SM.Project where OpenWorks_SM.CartoRefSys.id = OpenWorks_SM.Project.xy_crs_id);
       DECLARE blob convertedXYBlob = cartoConvert(getDSDSCrs("NEW".target_crs),getDSDSCrs(VARIABLES.targetCRS),VARIABLES.X,VARIABLES.Y,VARIABLES.XYUnit);
       IF(convertedXYBlob IS NOT NULL)
       BEGIN
         VARIABLES.X= fetchDElementValueFromBlob(convertedXYBlob,'x');
         VARIABLES.Y= fetchDElementValueFromBlob(convertedXYBlob,'y');
         VARIABLES.XYUnit= fetchElementUnitNameFromBlob(convertedXYBlob,'x');
       END
    UPDATE OpenWorks_SM.Target Set TARGET_X= VARIABLES.X,TARGET_Y=VARIABLES.Y,TARGET_Z="NEW".target_z,TARGET_Z_dsdsunit="NEW".target_z_unit,TARGET_TIME="NEW".target_time, TARGET_TIME_dsdsunit="NEW".target_time_unit,TIME_DATUM="NEW".time_datum,TIME_DATUM_dsdsunit="NEW".time_datum_unit,FIXED_TARGET_IND="NEW".fixed_target_ind, CATEGORY = SUBSTRING("NEW".target_type, 1, 24), CATEGORY_SUBTYPE = "NEW".target_subtype, COLOR_INDEX="NEW".color_index,FEATURE_NAME="NEW".feature_name,APPLICATION="NEW".application,INTERPRETER="NEW".interpreter,REMARK="NEW".remark
     WHERE
    OpenWorks_SM.Target.TARGET_ID=VARIABLES.target_id;

END;


CREATE TRIGGER ON Target INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC

DECLARE string VARIABLES.wp_project_id = (SELECT WP_PROJECT_ID FROM OpenWorks_SM.WellPlanProj WHERE wp_project_id  = "OLD".wellplanproject_native_uid);
DECLARE string VARIABLES.target_id = (SELECT target_id from OpenWorks_SM.Target where target_name="OLD".target_name and wp_project_id=VARIABLES.wp_project_id);
DELETE FROM RegularGeometry WHERE target_native_uid = VARIABLES.target_id;
DELETE FROM IrregularGeometry WHERE target_native_uid = VARIABLES.target_id;
DELETE FROM IrregularGeometryPoints  WHERE target_native_uid = VARIABLES.target_id;
DELETE FROM WellPlanTarget WHERE target_native_uid = VARIABLES.target_id;
UPDATE OpenWorks_SM.TurnPoint SET target_id = NULL WHERE target_id = VARIABLES.target_id and well_plan_id IN (SELECT DISTINCT well_plan_id FROM OpenWorks_SM.TurnPoint WHERE target_id = VARIABLES.target_id);
DELETE FROM  OpenWorks_SM.Target WHERE OpenWorks_SM.Target.TARGET_ID=VARIABLES.target_id;
END;


/*
**********************************
*     "IrregularGeometry"
**********************************
*/
CREATE VIEW IrregularGeometry
(
  native_uid                  VARCHAR(1024) OPTIONS("OpenWorksCommonModel:IrregularGeometry.native_uid.isUpdatable" false,
                                                    "OpenWorksCommonModel:IrregularGeometry.native_uid.isCreatable" false,
                                                     UPDATABLE 'FALSE'),
  wellplanproject_native_uid  VARCHAR(1024) NOT NULL,
  target_native_uid           VARCHAR(1024) NOT NULL,
  project_name                VARCHAR(40)   OPTIONS("OpenWorksCommonModel:IrregularGeometry.project_name.isUpdatable" false,
                                                    "OpenWorksCommonModel:IrregularGeometry.project_name.isCreatable" false,
                                                    UPDATABLE 'FALSE'),
  target_name                 VARCHAR(50) OPTIONS("OpenWorksCommonModel:IrregularGeometry.target_name.isUpdatable" false,
                                                    "OpenWorksCommonModel:IrregularGeometry.target_name.isCreatable" false,
                                                    UPDATABLE 'FALSE'),
  target_type              VARCHAR(12)  NOT NULL DEFAULT 'GEOLOGIC',
  locked_flag              INTEGER,
  offset_x                 DOUBLE       OPTIONS ("OpenWorksCommonModel:IrregularGeometry.offset_x.unitField" 'offset_xy_unit'),
  offset_y                 DOUBLE       OPTIONS ("OpenWorksCommonModel:IrregularGeometry.offset_y.unitField" 'offset_xy_unit'),
  offset_xy_unit           VARCHAR(64)  OPTIONS ("OpenWorksCommonModel:IrregularGeometry.offset_xy_unit.unitType" 'linear distance'),
  up_distance              FLOAT        OPTIONS ("OpenWorksCommonModel:IrregularGeometry.up_distance.unitField" 'up_distance_unit'),
  up_distance_unit         VARCHAR(64)  OPTIONS ("OpenWorksCommonModel:IrregularGeometry.up_distance_unit.unitType" 'depth measure'),
  down_distance               FLOAT         OPTIONS ("OpenWorksCommonModel:IrregularGeometry.down_distance.unitField"     'down_distance_unit'),
  down_distance_unit       VARCHAR(64)  OPTIONS ("OpenWorksCommonModel:IrregularGeometry.down_distance_unit.unitType" 'depth measure'),
  dip_angle                DOUBLE       OPTIONS ("OpenWorksCommonModel:IrregularGeometry.dip_angle.unitField" 'dip_angle_unit'),
  dip_angle_unit           VARCHAR(64)  OPTIONS ("OpenWorksCommonModel:IrregularGeometry.dip_angle_unit.unitType" 'angular distance'),
  azimuth_angle               DOUBLE        OPTIONS ("OpenWorksCommonModel:IrregularGeometry.azimuth_angle.unitField"     'azimuth_angle_unit'),
  azimuth_angle_unit          VARCHAR(64)   OPTIONS ("OpenWorksCommonModel:IrregularGeometry.azimuth_angle_unit.unitType"    'angular distance'),
  point_count              INTEGER,
  remark                   VARCHAR(200),
  create_date              TIMESTAMP    OPTIONS("OpenWorksCommonModel:IrregularGeometry.create_date.isUpdatable" false,
                                                "OpenWorksCommonModel:IrregularGeometry.create_date.isCreatable" false,
                                                 UPDATABLE 'FALSE'),
  create_user_id           VARCHAR(32) OPTIONS("OpenWorksCommonModel:IrregularGeometry.create_user_id.isUpdatable" false,
                                               "OpenWorksCommonModel:IrregularGeometry.create_user_id.isCreatable" false,
                                                UPDATABLE 'FALSE'),
  update_date              TIMESTAMP   OPTIONS("OpenWorksCommonModel:IrregularGeometry.update_date.isUpdatable" false,
                                               "OpenWorksCommonModel:IrregularGeometry.update_date.isCreatable" false,
                                                UPDATABLE 'FALSE'),
  update_user_id           VARCHAR(32) OPTIONS("OpenWorksCommonModel:IrregularGeometry.update_user_id.isUpdatable" false,
                                               "OpenWorksCommonModel:IrregularGeometry.update_user_id.isCreatable" false,
                                                UPDATABLE 'FALSE'),
  alternate_uid    		         VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:IrregularGeometry.alternate_uid.isCreatable" false,
                                                    "OpenWorksCommonModel:IrregularGeometry.alternate_uid.isUpdatable" false,
                                                     UPDATABLE 'FALSE'),


    CONSTRAINT IrregularGeometry_PK PRIMARY KEY (native_uid),

    CONSTRAINT IrregularGeometry_UK1 UNIQUE (wellplanproject_native_uid, target_native_uid, target_type),

    CONSTRAINT FK_IrregularGeometry_wellplanproject_native_uid
        FOREIGN KEY               (wellplanproject_native_uid)
        REFERENCES WellPlanProject(native_uid),

    CONSTRAINT FK_IrregularGeometry_target_native_uid
        FOREIGN KEY      (target_native_uid)
        REFERENCES Target(native_uid)



) OPTIONS(UPDATABLE 'TRUE',  IrregularGeometry.IMPLEMENTED 'TRUE')

AS

SELECT
 OpenWorks_SM.IGeometry.native_uid,
 OpenWorks_SM.WellPlanProj.wp_project_id,
 OpenWorks_SM.Target.target_id,
 OpenWorks_SM.WellPlanProj.wp_project_name,
 OpenWorks_SM.Target.target_name AS target_name,
 OpenWorks_SM.IGeometry.target_type,
 OpenWorks_SM.IGeometry.locked_flag,
 OpenWorks_SM.IGeometry.offset_x,
 OpenWorks_SM.IGeometry.offset_y,
 COALESCE(OpenWorks_SM.IGeometry.offset_x_dsdsunit,OpenWorks_SM.IGeometry.offset_y_dsdsunit)  as offset_xy_unit,
 OpenWorks_SM.IGeometry.up_distance,
 OpenWorks_SM.IGeometry.up_distance_dsdsunit AS up_distance_unit,
 OpenWorks_SM.IGeometry.down_distance,
 OpenWorks_SM.IGeometry.down_distance_dsdsunit AS down_distance_unit,
 OpenWorks_SM.IGeometry.dip_angle,
 OpenWorks_SM.IGeometry.dip_angle_dsdsunit AS dip_angle_unit,
 OpenWorks_SM.IGeometry.azimuth_angle,
 OpenWorks_SM.IGeometry.azimuth_angle_dsdsunit AS azimuth_angle_unit,
 OpenWorks_SM.IGeometry.point_count,
 OpenWorks_SM.IGeometry.remark,
 OpenWorks_SM.IGeometry.create_date,
 OpenWorks_SM.IGeometry.create_user_id,
 OpenWorks_SM.IGeometry.update_date,
 OpenWorks_SM.IGeometry.update_user_id,
 OpenWorks_SM.IGeometry.native_uid
FROM
  OpenWorks_SM.IGeometry, OpenWorks_SM.WellPlanProj, OpenWorks_SM.Target
WHERE
    OpenWorks_SM.IGeometry.wp_project_id = OpenWorks_SM.WellPlanProj.wp_project_id AND
  OpenWorks_SM.IGeometry.target_id = OpenWorks_SM.Target.target_id;


CREATE TRIGGER ON IrregularGeometry INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC

    DECLARE string VARIABLES.wp_project_name_errorMsg='ERROR: The WellPlan Project with given value '|| "NEW".wellplanproject_native_uid || '  does not exist';
    DECLARE string VARIABLES.wp_project_name = (SELECT wp_project_name FROM OpenWorks_SM.WellPlanProj WHERE wp_project_id  = "NEW".wellplanproject_native_uid);

    IF (VARIABLES.wp_project_name IS NULL ) ERROR VARIABLES.wp_project_name_errorMsg;


    DECLARE string VARIABLES.wp_target_name_errorMsg='ERROR: The Target with given Target:  '|| "NEW".target_native_uid || 'does not exist';
    DECLARE string VARIABLES.target_id = (SELECT target_id  FROM OpenWorks_SM.TARGET WHERE target_id  = "NEW".target_native_uid);

    IF (VARIABLES.target_id IS NULL ) ERROR VARIABLES.wp_target_name_errorMsg;

    INSERT INTO OpenWorks_SM.IGeometry
    (wp_project_id, target_id, target_type, locked_flag, offset_x, offset_y, offset_x_dsdsunit, offset_y_dsdsunit,
                up_distance, up_distance_dsdsunit, down_distance, down_distance_dsdsunit, dip_angle, dip_angle_dsdsunit, azimuth_angle, azimuth_angle_dsdsunit, point_count, remark)
  values
    ("NEW".wellplanproject_native_uid, "NEW".target_native_uid,"NEW".target_type, "NEW".locked_flag, "NEW".offset_x,     "NEW".offset_y ,"NEW".offset_xy_unit,"NEW".offset_xy_unit,
    "NEW".up_distance , "NEW".up_distance_unit ,"NEW".down_distance , "NEW".down_distance_unit , "NEW".dip_angle ,"NEW".dip_angle_unit, "NEW".azimuth_angle , "NEW".azimuth_angle_unit , "NEW".point_count , "NEW".remark);
END;

CREATE TRIGGER ON IrregularGeometry INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC

        UPDATE OpenWorks_SM.IGeometry SET locked_flag = "NEW".locked_flag, offset_x = "NEW".offset_x , offset_y = "NEW".offset_y,offset_x_dsdsunit="NEW".offset_xy_unit,offset_y_dsdsunit="NEW".offset_xy_unit,
        up_distance = "NEW".up_distance, up_distance_dsdsunit = "NEW".up_distance_unit, down_distance = "NEW".down_distance,
        down_distance_dsdsunit = "NEW".down_distance_unit, dip_angle = "NEW".dip_angle, dip_angle_dsdsunit = "NEW".dip_angle_unit, azimuth_angle = "NEW".azimuth_angle,
        azimuth_angle_dsdsunit = "NEW".azimuth_angle_unit, point_count ="NEW".point_count, remark = "NEW".remark
    WHERE native_uid = "OLD".native_uid;

END;


CREATE TRIGGER ON IrregularGeometry INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC

    DELETE FROM OpenWorks_SM.IGeometry WHERE native_uid = "OLD".native_uid;

END;


/*
**********************************
*     "IrregularGeometryPoints"
**********************************
*/
CREATE VIEW IrregularGeometryPoints
(
  native_uid                  VARCHAR(1024) OPTIONS("OpenWorksCommonModel:IrregularGeometryPoints.native_uid.isUpdatable" false,
                                                    "OpenWorksCommonModel:IrregularGeometryPoints.native_uid.isCreatable" false,
                                                     UPDATABLE 'FALSE'),
  wellplanproject_native_uid  VARCHAR(1024) NOT NULL,
  target_native_uid           VARCHAR(1024) NOT NULL,
  project_name                VARCHAR(40)   OPTIONS("OpenWorksCommonModel:IrregularGeometryPoints.project_name.isUpdatable" false,
                                                        "OpenWorksCommonModel:IrregularGeometryPoints.project_name.isCreatable" false,
                                                        UPDATABLE 'FALSE'),
  target_name                 VARCHAR(200)  OPTIONS("OpenWorksCommonModel:IrregularGeometryPoints.target_name.isUpdatable" false,
                                                         "OpenWorksCommonModel:IrregularGeometryPoints.target_name.isCreatable" false,
                                                         UPDATABLE 'FALSE'),
  target_type              VARCHAR(12)  NOT NULL DEFAULT 'GEOLOGIC',
  target_point_seq_no      INTEGER      NOT NULL,
  x                        DOUBLE       OPTIONS ("OpenWorksCommonModel:IrregularGeometryPoints.x.unitField" 'xy_unit'),
  y                        DOUBLE       OPTIONS ("OpenWorksCommonModel:IrregularGeometryPoints.y.unitField" 'xy_unit'),
  xy_unit                  VARCHAR(64),
  crs                      VARCHAR(80),
 alternate_uid 	         VARCHAR(4000)  OPTIONS ("OpenWorksCommonModel:IrregularGeometryPoints.alternate_uid.isCreatable" false,
                                                     "OpenWorksCommonModel:IrregularGeometryPoints.alternate_uid.isUpdatable" false,
                                                     UPDATABLE 'FALSE'),

    CONSTRAINT IrregularGeometryPoints_PK PRIMARY KEY (native_uid),

    CONSTRAINT IrregularGeometryPoints_UK1 UNIQUE (wellplanproject_native_uid, target_native_uid, target_type, target_point_seq_no),

    CONSTRAINT FK_IrregularGeometryPoints_wellplanproject_native_uid
        FOREIGN KEY               (wellplanproject_native_uid)
        REFERENCES WellPlanProject(native_uid),

    CONSTRAINT FK_IrregularGeometryPoints_target_native_uid
        FOREIGN KEY      (target_native_uid)
        REFERENCES Target(native_uid),

    CONSTRAINT FK_IrregularGeometryPoints_crs
        FOREIGN KEY                    (crs)
        REFERENCES CartoReferenceSystem(name)


) OPTIONS(UPDATABLE 'TRUE',  IrregularGeometryPoints.IMPLEMENTED 'TRUE')

AS

SELECT
 OpenWorks_SM.IRPoints.native_uid,
 OpenWorks_SM.WellPlanProj.wp_project_id,
 OpenWorks_SM.Target.target_id,
 OpenWorks_SM.WellPlanProj.wp_project_name,
   OpenWorks_SM.Target.target_lname AS target_name,
 OpenWorks_SM.IRPoints.target_type,
 OpenWorks_SM.IRPoints.target_point_seq_no,
 OpenWorks_SM.IRPoints.x,
 OpenWorks_SM.IRPoints.y,
 COALESCE(OpenWorks_SM.IRPoints.x_dsdsunit,OpenWorks_SM.IRPoints.y_dsdsunit)  as xy_unit,
 (Select getDSDSCrs(name) from OpenWorks_SM.CartoRefSys,OpenWorks_SM.Project where OpenWorks_SM.CartoRefSys.id = OpenWorks_SM.Project.xy_crs_id),
 OpenWorks_SM.IRPoints.native_uid
FROM
  OpenWorks_SM.IRPoints,OpenWorks_SM.WellPlanProj, OpenWorks_SM.Target
WHERE
  OpenWorks_SM.IRPoints.wp_project_id = OpenWorks_SM.WellPlanProj.wp_project_id AND
  OpenWorks_SM.IRPoints.target_id = OpenWorks_SM.Target.target_id
ORDER BY OpenWorks_SM.Target.target_id, OpenWorks_SM.IRPoints.target_point_seq_no;


CREATE TRIGGER ON IrregularGeometryPoints INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC

    DECLARE string VARIABLES.wp_project_name_errorMsg='ERROR: The WellPlan Project with given value '|| "NEW".wellplanproject_native_uid || '  does not exist';
    DECLARE string VARIABLES.wp_project_name = (SELECT wp_project_name FROM OpenWorks_SM.WellPlanProj WHERE wp_project_id  = "NEW".wellplanproject_native_uid);

    IF (VARIABLES.wp_project_name IS NULL ) ERROR VARIABLES.wp_project_name_errorMsg;

    DECLARE string VARIABLES.wp_target_name_errorMsg='ERROR: The Target with given Target:  '|| "NEW".target_native_uid || 'does not exist';
    DECLARE string VARIABLES.target_id = (SELECT target_id  FROM OpenWorks_SM.TARGET WHERE target_id  = "NEW".target_native_uid);

    IF (VARIABLES.target_id IS NULL ) ERROR VARIABLES.wp_target_name_errorMsg;

    DECLARE double VARIABLES.X = "NEW".x;
    DECLARE double VARIABLES.Y = "NEW".y;
    DECLARE string VARIABLES.XYUnit = "NEW".xy_unit;
    DECLARE string VARIABLES.targetCRS = (Select name from OpenWorks_SM.CartoRefSys,OpenWorks_SM.Project where OpenWorks_SM.CartoRefSys.id = OpenWorks_SM.Project.xy_crs_id);
    DECLARE blob convertedXYBlob = select cartoConvert("NEW".crs,VARIABLES.targetCRS,VARIABLES.X,VARIABLES.Y,VARIABLES.XYUnit);
    IF(convertedXYBlob IS NOT NULL)
    BEGIN
          VARIABLES.X= fetchDElementValueFromBlob(convertedXYBlob,'x');
          VARIABLES.Y= fetchDElementValueFromBlob(convertedXYBlob,'y');
          VARIABLES.XYUnit= fetchElementUnitNameFromBlob(convertedXYBlob,'x');
    END

    INSERT INTO OpenWorks_SM.IRPoints
    (wp_project_id, target_id, target_type, target_point_seq_no, x,y)
    values("NEW".wellplanproject_native_uid, "NEW".target_native_uid,"NEW".target_type,"NEW".target_point_seq_no,VARIABLES.X,VARIABLES.Y);
END;

CREATE TRIGGER ON IrregularGeometryPoints INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC

    DECLARE double VARIABLES.X = "NEW".x;
    DECLARE double VARIABLES.Y = "NEW".y;
    DECLARE string VARIABLES.XYUnit = "NEW".xy_unit;
    DECLARE string VARIABLES.targetCRS = (Select name from OpenWorks_SM.CartoRefSys,OpenWorks_SM.Project where OpenWorks_SM.CartoRefSys.id = OpenWorks_SM.Project.xy_crs_id);
    DECLARE blob convertedXYBlob = select cartoConvert("NEW".crs,VARIABLES.targetCRS,VARIABLES.X,VARIABLES.Y,VARIABLES.XYUnit);
    IF(convertedXYBlob IS NOT NULL)
    BEGIN
        VARIABLES.X= fetchDElementValueFromBlob(convertedXYBlob,'x');
        VARIABLES.Y= fetchDElementValueFromBlob(convertedXYBlob,'y');
        VARIABLES.XYUnit= fetchElementUnitNameFromBlob(convertedXYBlob,'x');
    END

    UPDATE OpenWorks_SM.IRPoints SET x = VARIABLES.X, y = VARIABLES.Y
     WHERE
     native_uid = "OLD".native_uid;

END;


CREATE TRIGGER ON IrregularGeometryPoints INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC

    DELETE FROM OpenWorks_SM.IRPoints WHERE native_uid = "OLD".native_uid;

END;



/*
**********************************
*     "Regular Geometry"
**********************************
*/
CREATE VIEW RegularGeometry
(
  native_uid                  VARCHAR(1024)   OPTIONS("OpenWorksCommonModel:RegularGeometry.native_uid.isUpdatable" false,
                                                        "OpenWorksCommonModel:RegularGeometry.native_uid.isCreatable" false,
                                                        UPDATABLE 'FALSE'),
  wellplanproject_native_uid  VARCHAR(1024)   NOT NULL,
  target_native_uid           VARCHAR(1024)   NOT NULL,
  project_name                VARCHAR(40)     OPTIONS("OpenWorksCommonModel:RegularGeometry.project_name.isUpdatable" false,
                                                  "OpenWorksCommonModel:RegularGeometry.project_name.isCreatable" false,
                                                  UPDATABLE 'FALSE'),
  target_name                 VARCHAR(200)    OPTIONS("OpenWorksCommonModel:RegularGeometry.target_name.isUpdatable" false,
                                                  "OpenWorksCommonModel:RegularGeometry.target_name.isCreatable" false,
                                                  UPDATABLE 'FALSE'),
  target_type                 VARCHAR(12)  NOT NULL DEFAULT 'GEOLOGIC',
  geometry_type               INTEGER,
  locked_flag                 INTEGER,
  offset_x                    DOUBLE       OPTIONS ("OpenWorksCommonModel:RegularGeometry.offset_x.unitField" 'offset_xy_unit'),
  offset_y                    DOUBLE       OPTIONS ("OpenWorksCommonModel:RegularGeometry.offset_y.unitField" 'offset_xy_unit'),
  offset_xy_unit              VARCHAR(64)  OPTIONS ("OpenWorksCommonModel:RegularGeometry.offset_xy_unit.unitType" 'linear distance'),
  up_distance                 FLOAT        OPTIONS ("OpenWorksCommonModel:RegularGeometry.up_distance.unitField" 'up_distance_unit'),
  up_distance_unit            VARCHAR(64)  OPTIONS ("OpenWorksCommonModel:RegularGeometry.up_distance_unit.unitType" 'depth measure'),
  down_distance               FLOAT        OPTIONS ("OpenWorksCommonModel:RegularGeometry.down_distance.unitField"
                                                     'down_distance_unit'),
  down_distance_unit          VARCHAR(64)  OPTIONS ("OpenWorksCommonModel:RegularGeometry.down_distance_unit.unitType" 'depth measure'),
  orientation_angle           DOUBLE       OPTIONS ("OpenWorksCommonModel:RegularGeometry.orientation_angle.unitField"
                                                    'orientation_angle_unit'),
  orientation_angle_unit      VARCHAR(64)  OPTIONS ("OpenWorksCommonModel:RegularGeometry.orientation_angle_unit.unitType"
                                                    'angular distance'),
  orientation_radius          DOUBLE       OPTIONS  ("OpenWorksCommonModel:RegularGeometry.orientation_radius.unitField" 'orientation_radius_unit'),
  orientation_radius_unit     VARCHAR(64)  OPTIONS ("OpenWorksCommonModel:RegularGeometry.orientation_radius_unit.unitType"
                                                    'angular distance'),
  perpendicular_radius        DOUBLE       OPTIONS  ("OpenWorksCommonModel:RegularGeometry.perpendicular_radius.unitField"
                                                     'perpendicular_radius_unit'),
  perpendicular_radius_unit   VARCHAR(64)  OPTIONS ("OpenWorksCommonModel:RegularGeometry.perpendicular_radius_unit.unitType"
                                                    'angular distance'),
  dip_angle                   DOUBLE       OPTIONS  ("OpenWorksCommonModel:RegularGeometry.dip_angle.unitField" 'dip_angle_unit'),
  dip_angle_unit              VARCHAR(64)  OPTIONS ("OpenWorksCommonModel:RegularGeometry.dip_angle_unit.unitType" 'angular distance'),
  azimuth_angle               DOUBLE       OPTIONS  ("OpenWorksCommonModel:RegularGeometry.azimuth_angle.unitField"
                                                     'azimuth_angle_unit'),
  azimuth_angle_unit          VARCHAR(64)  OPTIONS ("OpenWorksCommonModel:RegularGeometry.azimuth_angle_unit.unitType"
                                                    'angular distance'),
  remark                      VARCHAR(200),
  create_date                 TIMESTAMP    OPTIONS("OpenWorksCommonModel:RegularGeometry.create_date.isUpdatable" false,
                                                   "OpenWorksCommonModel:RegularGeometry.create_date.isCreatable" false,
                                                    UPDATABLE 'FALSE'),
  create_user_id              VARCHAR(32)  OPTIONS("OpenWorksCommonModel:RegularGeometry.create_user_id.isUpdatable" false,
                                                   "OpenWorksCommonModel:RegularGeometry.create_user_id.isCreatable" false,
                                                    UPDATABLE 'FALSE'),
  update_date                 TIMESTAMP    OPTIONS("OpenWorksCommonModel:RegularGeometry.update_date.isUpdatable" false,
                                                   "OpenWorksCommonModel:RegularGeometry.update_date.isCreatable" false,
                                                    UPDATABLE 'FALSE'),
  update_user_id              VARCHAR(32)  OPTIONS("OpenWorksCommonModel:RegularGeometry.update_user_id.isUpdatable" false,
                                                   "OpenWorksCommonModel:RegularGeometry.update_user_id.isCreatable" false,
                                                    UPDATABLE 'FALSE'),
  alternate_uid    		          VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:RegularGeometry.alternate_uid.isCreatable" false,
                                                     "OpenWorksCommonModel:RegularGeometry.alternate_uid.isUpdatable" false,
                                                      UPDATABLE 'FALSE'),


    CONSTRAINT RegularGeometry_PK PRIMARY KEY (native_uid),

    CONSTRAINT RegularGeometry_UK1 UNIQUE (wellplanproject_native_uid, target_native_uid, target_type),

    CONSTRAINT FK_RegularGeometry_wellplanproject_native_uid
        FOREIGN KEY               (wellplanproject_native_uid)
        REFERENCES WellPlanProject(native_uid),

    CONSTRAINT FK_RegularGeometry_target_native_uid
        FOREIGN KEY      (target_native_uid)
        REFERENCES Target(native_uid)

) OPTIONS (UPDATABLE 'TRUE',  RegularGeometry.IMPLEMENTED 'TRUE')
AS
Select
   OpenWorks_SM.RGeometry.native_uid,
   OpenWorks_SM.WellPlanProj.WP_PROJECT_ID,
   OpenWorks_SM.TARGET.target_id,
   OpenWorks_SM.WellPlanProj.WP_PROJECT_NAME,
   OpenWorks_SM.TARGET.TARGET_NAME AS target_name,
   OpenWorks_SM.RGeometry.TARGET_TYPE AS target_type,
   OpenWorks_SM.RGeometry.GEOMETRY_TYPE AS geometry_type,
   OpenWorks_SM.RGeometry.LOCKED_FLAG AS locked_flag,
   OpenWorks_SM.RGeometry.OFFSET_X AS offset_x,
   OpenWorks_SM.RGeometry.OFFSET_Y AS offset_y,
   COALESCE(OpenWorks_SM.RGeometry.offset_x_dsdsunit,
   OpenWorks_SM.RGeometry.offset_y_dsdsunit)  as offset_xy_unit,
   OpenWorks_SM.RGeometry.UP_DISTANCE AS up_distance,
   OpenWorks_SM.RGeometry.UP_DISTANCE_dsdsunit AS up_distance_unit,
   OpenWorks_SM.RGeometry.DOWN_DISTANCE AS down_distance,
   OpenWorks_SM.RGeometry.DOWN_DISTANCE_dsdsunit AS down_distance_unit,
   OpenWorks_SM.RGeometry.ORIENTATION_ANGLE AS orientation_angle,
   OpenWorks_SM.RGeometry.ORIENTATION_ANGLE_dsdsunit AS orientation_angle_unit,
   OpenWorks_SM.RGeometry.ORIENTATION_RADIUS AS orientation_radius,
   OpenWorks_SM.RGeometry.ORIENTATION_RADIUS_dsdsunit AS orientation_radius_unit,
   OpenWorks_SM.RGeometry.PERPENDICULAR_RADIUS AS perpendicular_radius,
   OpenWorks_SM.RGeometry.PERPENDICULAR_RADIUS_dsdsunit AS perpendicular_radius_unit,
   OpenWorks_SM.RGeometry.DIP_ANGLE AS dip_angle,
   OpenWorks_SM.RGeometry.DIP_ANGLE_dsdsunit AS dip_angle_unit,
   OpenWorks_SM.RGeometry.AZIMUTH_ANGLE AS azimuth_angle,
   OpenWorks_SM.RGeometry.AZIMUTH_ANGLE_dsdsunit AS azimuth_angle_unit,
   OpenWorks_SM.RGeometry.REMARK AS remark,
   OpenWorks_SM.RGeometry.CREATE_DATE AS create_date,
   OpenWorks_SM.RGeometry.CREATE_USER_ID AS create_user_id,
   OpenWorks_SM.RGeometry.UPDATE_DATE AS update_date,
   OpenWorks_SM.RGeometry.UPDATE_USER_ID AS update_user_id,
   OpenWorks_SM.RGeometry.native_uid
FROM
  OpenWorks_SM.WellPlanProj,OpenWorks_SM.TARGET,OpenWorks_SM.RGeometry
WHERE
 OpenWorks_SM.WellPlanProj.WP_PROJECT_ID = OpenWorks_SM.RGeometry.WP_PROJECT_ID  AND
 OpenWorks_SM.TARGET.TARGET_ID = OpenWorks_SM.RGeometry.TARGET_ID;

CREATE TRIGGER ON RegularGeometry INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC

    DECLARE string VARIABLES.wp_project_id_errorMsg='ERROR: The WellPlan Project with given value '|| "NEW".wellplanproject_native_uid || '  does not exist';
        DECLARE string VARIABLES.wp_project_id = (SELECT WP_PROJECT_ID FROM OpenWorks_SM.WellPlanProj WHERE WP_PROJECT_ID = "NEW".wellplanproject_native_uid);

    IF (VARIABLES.wp_project_id IS NULL ) ERROR VARIABLES.wp_project_id_errorMsg;

    DECLARE string VARIABLES.wp_target_id_errorMsg='ERROR: The Target with given Target UID:  '|| "NEW".target_native_uid || '  and Project Name: '||VARIABLES.WP_PROJECT_ID || 'does not exist';
    DECLARE string VARIABLES.target_id = (SELECT target_id FROM OpenWorks_SM.TARGET WHERE target_id = "NEW".target_native_uid  and wp_project_id=VARIABLES.wp_project_id);

    IF (VARIABLES.target_id IS NULL ) ERROR VARIABLES.wp_target_id_errorMsg;

    INSERT INTO OpenWorks_SM.RGeometry (OpenWorks_SM.RGeometry.WP_PROJECT_ID,OpenWorks_SM.RGeometry.TARGET_ID,OpenWorks_SM.RGeometry.TARGET_TYPE,OpenWorks_SM.RGeometry.GEOMETRY_TYPE,OpenWorks_SM.RGeometry.LOCKED_FLAG,OpenWorks_SM.RGeometry.OFFSET_X,OpenWorks_SM.RGeometry.OFFSET_Y,OpenWorks_SM.RGeometry.offset_x_dsdsunit,OpenWorks_SM.RGeometry.offset_y_dsdsunit,OpenWorks_SM.RGeometry.UP_DISTANCE,OpenWorks_SM.RGeometry.UP_DISTANCE_DSDSUNIT,OpenWorks_SM.RGeometry.DOWN_DISTANCE,OpenWorks_SM.RGeometry.DOWN_DISTANCE_DSDSUNIT,OpenWorks_SM.RGeometry.ORIENTATION_ANGLE,OpenWorks_SM.RGeometry.ORIENTATION_ANGLE_DSDSUNIT,OpenWorks_SM.RGeometry.ORIENTATION_RADIUS,OpenWorks_SM.RGeometry.ORIENTATION_RADIUS_DSDSUNIT,OpenWorks_SM.RGeometry.PERPENDICULAR_RADIUS,OpenWorks_SM.RGeometry.PERPENDICULAR_RADIUS_DSDSUNIT,OpenWorks_SM.RGeometry.DIP_ANGLE,OpenWorks_SM.RGeometry.DIP_ANGLE_DSDSUNIT,OpenWorks_SM.RGeometry.AZIMUTH_ANGLE,OpenWorks_SM.RGeometry.AZIMUTH_ANGLE_DSDSUNIT,OpenWorks_SM.RGeometry.REMARK)
    values (
     VARIABLES.wp_project_id,VARIABLES.target_id,"NEW".target_type,"NEW".geometry_type,"NEW".locked_flag,"NEW".offset_x,"NEW".offset_y,    "NEW".offset_xy_unit,"NEW".offset_xy_unit,"NEW".up_distance,"NEW".up_distance_unit,"NEW".down_distance,"NEW".down_distance_unit,"NEW".orientation_angle,"NEW".orientation_angle_unit,"NEW".orientation_radius,"NEW".orientation_radius_unit,"NEW".perpendicular_radius,"NEW".perpendicular_radius_unit,"NEW".dip_angle,"NEW".dip_angle_unit,"NEW".azimuth_angle,"NEW".azimuth_angle_unit,"NEW".remark);
END;

CREATE TRIGGER ON RegularGeometry INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC
        DECLARE string VARIABLES.wp_project_id = (SELECT WP_PROJECT_ID FROM OpenWorks_SM.WellPlanProj WHERE WP_PROJECT_ID = "OLD".wellplanproject_native_uid);
        DECLARE string VARIABLES.target_id = (SELECT target_id FROM OpenWorks_SM.TARGET WHERE target_id = "OLD".target_native_uid and wp_project_id=VARIABLES.wp_project_id);
  UPDATE OpenWorks_SM.RGeometry
    SET
OpenWorks_SM.RGeometry.GEOMETRY_TYPE = "NEW".geometry_type,OpenWorks_SM.RGeometry.LOCKED_FLAG = "NEW".locked_flag,OpenWorks_SM.RGeometry.OFFSET_X = "NEW".offset_x,OpenWorks_SM.RGeometry.OFFSET_Y = "NEW".offset_y,OpenWorks_SM.RGeometry.offset_x_dsdsunit="NEW".offset_xy_unit,OpenWorks_SM.RGeometry.offset_y_dsdsunit="NEW".offset_xy_unit,OpenWorks_SM.RGeometry.UP_DISTANCE = "NEW".up_distance,OpenWorks_SM.RGeometry.UP_DISTANCE_DSDSUNIT = "NEW".up_distance_unit,OpenWorks_SM.RGeometry.DOWN_DISTANCE = "NEW".down_distance,OpenWorks_SM.RGeometry.DOWN_DISTANCE_DSDSUNIT = "NEW".down_distance_unit,OpenWorks_SM.RGeometry.ORIENTATION_ANGLE = "NEW".orientation_angle,OpenWorks_SM.RGeometry.ORIENTATION_ANGLE_DSDSUNIT = "NEW".orientation_angle_unit,OpenWorks_SM.RGeometry.ORIENTATION_RADIUS = "NEW".orientation_radius,OpenWorks_SM.RGeometry.ORIENTATION_RADIUS_DSDSUNIT = "NEW".orientation_radius_unit,OpenWorks_SM.RGeometry.PERPENDICULAR_RADIUS = "NEW".perpendicular_radius,OpenWorks_SM.RGeometry.PERPENDICULAR_RADIUS_DSDSUNIT = "NEW".perpendicular_radius_unit,OpenWorks_SM.RGeometry.DIP_ANGLE = "NEW".dip_angle,OpenWorks_SM.RGeometry.DIP_ANGLE_DSDSUNIT = "NEW".dip_angle_unit,OpenWorks_SM.RGeometry.AZIMUTH_ANGLE = "NEW".azimuth_angle,OpenWorks_SM.RGeometry.AZIMUTH_ANGLE_DSDSUNIT = "NEW".azimuth_angle_unit,OpenWorks_SM.RGeometry.REMARK = "NEW".remark

  WHERE
  OpenWorks_SM.RGeometry.TARGET_ID = VARIABLES.target_id
  AND OpenWorks_SM.RGeometry.TARGET_TYPE = "OLD".target_type
  AND OpenWorks_SM.RGeometry.WP_PROJECT_ID = VARIABLES.wp_project_id;
END;


CREATE TRIGGER ON RegularGeometry INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC

    DECLARE string VARIABLES.wp_project_id = (SELECT WP_PROJECT_ID FROM OpenWorks_SM.WellPlanProj WHERE WP_PROJECT_NAME = "OLD".project_name);
    DECLARE string VARIABLES.target_id = (SELECT target_id FROM OpenWorks_SM.TARGET WHERE TARGET_NAME = "OLD".target_name  and wp_project_id=VARIABLES.wp_project_id);

    DELETE FROM OpenWorks_SM.RGeometry WHERE OpenWorks_SM.RGeometry.TARGET_ID = VARIABLES.target_id AND OpenWorks_SM.RGeometry.TARGET_TYPE = "OLD".target_type AND OpenWorks_SM.RGeometry.WP_PROJECT_ID = VARIABLES.wp_project_id;

END;

/*
**********************************
*     "Target Estimator"
**********************************
*/
CREATE VIEW TargetEstimator
(
  native_uid                         VARCHAR(1024)    OPTIONS("OpenWorksCommonModel:TargetEstimator.native_uid.isUpdatable" false,
                                                                "OpenWorksCommonModel:TargetEstimator.native_uid.isCreatable" false,
                                                                UPDATABLE 'FALSE'),
  target_native_uid                  VARCHAR(1024) NOT NULL,
  project_name                       VARCHAR(40)  OPTIONS("OpenWorksCommonModel:TargetEstimator.project_name.isUpdatable" false,
                                                       "OpenWorksCommonModel:TargetEstimator.project_name.isCreatable" false,
                                                       UPDATABLE 'FALSE'),
  wellplanproject_native_uid         VARCHAR(1024)  OPTIONS("OpenWorksCommonModel:TargetEstimator.project_id.isUpdatable" false,
                                                       "OpenWorksCommonModel:TargetEstimator.project_id.isCreatable" false,
                                                       UPDATABLE 'FALSE'),
  target_name                        VARCHAR(200) OPTIONS("OpenWorksCommonModel:TargetEstimator.target_name.isUpdatable" false,
                                                       "OpenWorksCommonModel:TargetEstimator.target_name.isCreatable" false,
                                                       UPDATABLE 'FALSE'),
  calculation_mode                   INTEGER,
  intersect_mode                     INTEGER,
  driller_intersection_u             DOUBLE       OPTIONS ("OpenWorksCommonModel:TargetEstimator.driller_intersection_u.unitField"
                                                           'driller_intersection_u_unit'),
  driller_intersection_u_unit        VARCHAR(64)  OPTIONS (
                                                         "OpenWorksCommonModel:TargetEstimator.driller_intersection_u_unit.unitType" 'linear distance'),
  driller_intersection_v             DOUBLE       OPTIONS ("OpenWorksCommonModel:TargetEstimator.driller_intersection_v.unitField" 'driller_intersection_v_unit'),
  driller_intersection_v_unit        VARCHAR(64)  OPTIONS (
                                                         "OpenWorksCommonModel:TargetEstimator.driller_intersection_v_unit.unitType" 'linear distance'),
  geo_target_pick_uncertainty        DOUBLE       OPTIONS (
                                                        "OpenWorksCommonModel:TargetEstimator.geo_target_pick_uncertainty.unitField" 'geo_target_pick_uncertainty_unit'),
  geo_target_pick_uncertainty_unit   VARCHAR(64)  OPTIONS (
                                                    "OpenWorksCommonModel:TargetEstimator.geo_target_pick_uncertainty_unit.unitType" 'percent'),
  geo_target_use_pick_ind            VARCHAR(1),
  well_target_azimuth                DOUBLE       OPTIONS ("OpenWorksCommonModel:TargetEstimator.well_target_azimuth.unitField"
                                                           'well_target_azimuth_unit'),
  well_target_azimuth_unit           VARCHAR(64)  OPTIONS ("OpenWorksCommonModel:TargetEstimator.well_target_azimuth_unit.unitType"
                                                           'angular distance'),
  well_target_inclination            DOUBLE       OPTIONS ("OpenWorksCommonModel:TargetEstimator.well_target_inclination.unitField"
                                                           'well_target_inclination_unit'),
  well_target_inclination_unit       VARCHAR(64)  OPTIONS (
                                                        "OpenWorksCommonModel:TargetEstimator.well_target_inclination_unit.unitType" 'angular distance'),
  remark                             VARCHAR(200),
 create_date                         TIMESTAMP    OPTIONS("OpenWorksCommonModel:TargetEstimator.create_date.isUpdatable" false,
                                                          "OpenWorksCommonModel:TargetEstimator.create_date.isCreatable" false,
                                                           UPDATABLE 'FALSE'),
  create_user_id                     VARCHAR(32)  OPTIONS("OpenWorksCommonModel:TargetEstimator.create_user_id.isUpdatable" false,
                                                          "OpenWorksCommonModel:TargetEstimator.create_user_id.isCreatable" false,
                                                           UPDATABLE 'FALSE'),
  update_date                        TIMESTAMP    OPTIONS("OpenWorksCommonModel:TargetEstimator.update_date.isUpdatable" false,
                                                          "OpenWorksCommonModel:TargetEstimator.update_date.isCreatable" false,UPDATABLE 'FALSE'),
  update_user_id                     VARCHAR(32)  OPTIONS("OpenWorksCommonModel:PositionLog.update_user_id.isUpdatable" false,
                                                          "OpenWorksCommonModel:TargetEstimator.update_user_id.isCreatable" false,UPDATABLE 'FALSE'),
  alternate_uid    		                 VARCHAR(4000)    OPTIONS ("OpenWorksCommonModel:TargetEstimator.alternate_uid.isCreatable"  false,
                                                               "OpenWorksCommonModel:TargetEstimator.alternate_uid.isUpdatable" false,
                                                               UPDATABLE 'FALSE'),


    CONSTRAINT TargetEstimator_PK PRIMARY KEY (native_uid),

    CONSTRAINT TargetEstimator_UK1 UNIQUE (target_native_uid),

    CONSTRAINT FK_TargetEstimator_target_native_uid
        FOREIGN KEY      (target_native_uid)
        REFERENCES Target(native_uid)


) OPTIONS (UPDATABLE 'TRUE',  TargetEstimator.IMPLEMENTED 'TRUE')
 AS
Select
    OpenWorks_SM.TargetEstimator.target_id,
    OpenWorks_SM.TARGET.Target_id,
    OpenWorks_SM.WellPlanProj.WP_PROJECT_NAME,
	OpenWorks_SM.WellPlanProj.WP_PROJECT_ID,
    OpenWorks_SM.TARGET.TARGET_LNAME AS target_name,
    OpenWorks_SM.TargetEstimator.CALC_MODE ,
    OpenWorks_SM.TargetEstimator.INTERSECT_MODE AS intersect_mode,
    OpenWorks_SM.TargetEstimator.DRILLER_INT_U AS driller_intersection_u,
    OpenWorks_SM.TargetEstimator.DRILLER_INT_U_DSDSUNIT AS driller_intersection_u_unit,
    OpenWorks_SM.TargetEstimator.DRILLER_INT_V AS driller_intersection_v,
    OpenWorks_SM.TargetEstimator.DRILLER_INT_V_DSDSUNIT AS driller_intersection_v_unit,
    OpenWorks_SM.TargetEstimator.GEO_TARGET_PICK_UNC AS geo_target_pick_uncertainty,
    OpenWorks_SM.TargetEstimator.GEO_TARGET_PICK_UNC_DSDSUNIT AS geo_target_pick_uncertainty_unit,
    OpenWorks_SM.TargetEstimator.GEO_TARGET_USE_PICK AS geo_target_use_pick_ind,
    OpenWorks_SM.TargetEstimator.WELL_TARGET_AZIMUTH AS well_target_azimuth,
    OpenWorks_SM.TargetEstimator.WELL_TARGET_AZIMUTH_DSDSUNIT AS well_target_azimuth_unit,
    OpenWorks_SM.TargetEstimator.WELL_TARGET_INCLINATION AS well_target_inclination,
    OpenWorks_SM.TargetEstimator.WELL_TARGET_INCLINATION_DSDSUNIT AS well_target_inclination_unit,
    OpenWorks_SM.TargetEstimator.REMARK AS remark,
    OpenWorks_SM.TargetEstimator.CREATE_DATE AS create_date,
    OpenWorks_SM.TargetEstimator.CREATE_USER_ID AS create_user_id,
    OpenWorks_SM.TargetEstimator.UPDATE_DATE AS update_date,
    OpenWorks_SM.TargetEstimator.UPDATE_USER_ID AS update_user_id,
	OpenWorks_SM.TargetEstimator.native_uid
FROM
        OpenWorks_SM.WellPlanProj,OpenWorks_SM.TARGET,OpenWorks_SM.TargetEstimator
WHERE
        OpenWorks_SM.WellPlanProj.WP_PROJECT_ID = OpenWorks_SM.TargetEstimator.WP_PROJECT_ID
AND OpenWorks_SM.TARGET.TARGET_ID = OpenWorks_SM.TargetEstimator.TARGET_ID;

CREATE TRIGGER ON TargetEstimator INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC
  DECLARE string VARIABLES.wp_project_id_errorMsg='ERROR: The WellPlan Project with given value '|| "NEW".target_native_uid || '  does not exist';
  DECLARE string VARIABLES.wp_project_id = (SELECT WP_PROJECT_ID FROM OpenWorks_SM.Target WHERE target_id = "NEW".target_native_uid);
  IF (VARIABLES.wp_project_id IS NULL ) ERROR VARIABLES.wp_project_id_errorMsg;

  DECLARE string VARIABLES.wp_target_id_errorMsg='ERROR: The Target with given value:  '|| "NEW".target_native_uid || 'does not exist';
  DECLARE string VARIABLES.target_id = (SELECT target_id FROM OpenWorks_SM.TARGET WHERE target_id = "NEW".target_native_uid);

  IF (VARIABLES.target_id IS NULL ) ERROR VARIABLES.wp_target_id_errorMsg;

  INSERT INTO OpenWorks_SM.TargetEstimator (WP_PROJECT_ID,TARGET_ID,CALC_MODE,INTERSECT_MODE,DRILLER_INT_U,DRILLER_INT_U_DSDSUNIT,DRILLER_INT_V,DRILLER_INT_V_DSDSUNIT,GEO_TARGET_PICK_UNC,GEO_TARGET_PICK_UNC_DSDSUNIT,GEO_TARGET_USE_PICK,WELL_TARGET_AZIMUTH,WELL_TARGET_AZIMUTH_DSDSUNIT,WELL_TARGET_INCLINATION,WELL_TARGET_INCLINATION_DSDSUNIT,REMARK)
  VALUES (VARIABLES.wp_project_id,VARIABLES.target_id,"NEW".calculation_mode,"NEW".intersect_mode,"NEW".driller_intersection_u,"NEW".driller_intersection_u_unit,"NEW".driller_intersection_v,"NEW".driller_intersection_v_unit,"NEW".geo_target_pick_uncertainty,"NEW".geo_target_pick_uncertainty_unit,"NEW".geo_target_use_pick_ind,"NEW".well_target_azimuth,"NEW".well_target_azimuth_unit,"NEW".well_target_inclination,"NEW".well_target_inclination_unit,"NEW".remark);
END;

CREATE TRIGGER ON TargetEstimator INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC
        DECLARE string VARIABLES.target_id = (SELECT target_id FROM OpenWorks_SM.TARGET WHERE target_id = "OLD".target_native_uid);
        UPDATE OpenWorks_SM.TargetEstimator
            SET
                OpenWorks_SM.TargetEstimator.CALC_MODE = "NEW".calculation_mode,
                OpenWorks_SM.TargetEstimator.INTERSECT_MODE = "NEW".intersect_mode,
                OpenWorks_SM.TargetEstimator.DRILLER_INT_U = "NEW".driller_intersection_u,
                OpenWorks_SM.TargetEstimator.DRILLER_INT_U_dsdsunit = "NEW".driller_intersection_u_unit,
                OpenWorks_SM.TargetEstimator.DRILLER_INT_V = "NEW".driller_intersection_v,
                OpenWorks_SM.TargetEstimator.DRILLER_INT_V_dsdsunit = "NEW".driller_intersection_v_unit,
                OpenWorks_SM.TargetEstimator.GEO_TARGET_PICK_UNC = "NEW".geo_target_pick_uncertainty,
                OpenWorks_SM.TargetEstimator.GEO_TARGET_PICK_UNC_dsdsunit = "NEW".geo_target_pick_uncertainty_unit,
                OpenWorks_SM.TargetEstimator.GEO_TARGET_USE_PICK = "NEW".geo_target_use_pick_ind,
                OpenWorks_SM.TargetEstimator.WELL_TARGET_AZIMUTH = "NEW".well_target_azimuth,
                OpenWorks_SM.TargetEstimator.WELL_TARGET_AZIMUTH_dsdsunit = "NEW".well_target_azimuth_unit,
                OpenWorks_SM.TargetEstimator.WELL_TARGET_INCLINATION = "NEW".well_target_inclination,
                OpenWorks_SM.TargetEstimator.WELL_TARGET_INCLINATION_dsdsunit = "NEW".well_target_inclination_unit,
                OpenWorks_SM.TargetEstimator.REMARK = "NEW".remark

            WHERE
                OpenWorks_SM.TargetEstimator.TARGET_ID = VARIABLES.target_id;
END;


CREATE TRIGGER ON TargetEstimator INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC
       DECLARE string VARIABLES.target_id = (SELECT target_id FROM OpenWorks_SM.TARGET WHERE target_id = "OLD".target_native_uid);
       DELETE FROM OpenWorks_SM.TargetEstimator where OpenWorks_SM.TargetEstimator.TARGET_ID = VARIABLES.target_id;
END;


/*
**********************************
*     "Drillers Estimator Point"
**********************************
*/
CREATE VIEW DrillersEstimatorPoint
(
  native_uid                  VARCHAR(1024)  OPTIONS("OpenWorksCommonModel:DrillersEstimatorPoint.native_uid.isUpdatable" false,
                                                     "OpenWorksCommonModel:DrillersEstimatorPoint.native_uid.isCreatable" false,
                                                      UPDATABLE 'FALSE'),
  target_native_uid  		  VARCHAR(1024)  NOT NULL,
  project_name                VARCHAR(40)    OPTIONS("OpenWorksCommonModel:DrillersEstimatorPoint.project_name.isUpdatable" false,
                                                  "OpenWorksCommonModel:DrillersEstimatorPoint.project_name.isCreatable" false,
                                                  UPDATABLE 'FALSE'),
  target_name                 VARCHAR(200)   OPTIONS("OpenWorksCommonModel:DrillersEstimatorPoint.target_name.isUpdatable" false,
                                                  "OpenWorksCommonModel:DrillersEstimatorPoint.target_name.isCreatable" false,
                                                  UPDATABLE 'FALSE'),
  target_point_no          INTEGER      NOT NULL,
  target_corner_u             DOUBLE         OPTIONS ("OpenWorksCommonModel:DrillersEstimatorPoint.target_corner_u.unitField"     'target_corner_u_unit'),
  target_corner_u_unit        VARCHAR(64)    OPTIONS ("OpenWorksCommonModel:DrillersEstimatorPoint.target_corner_u_unit.unitType" 'linear distance'),
  target_corner_v             DOUBLE         OPTIONS ("OpenWorksCommonModel:DrillersEstimatorPoint.target_corner_v.unitField"     'target_corner_v_unit'),
  target_corner_v_unit        VARCHAR(64)    OPTIONS ("OpenWorksCommonModel:DrillersEstimatorPoint.target_corner_v_unit.unitType" 'linear distance'),
  alternate_uid    		          VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:DrillersEstimatorPoint.alternate_uid.isCreatable" false,
                                                     "OpenWorksCommonModel:DrillersEstimatorPoint.alternate_uid.isUpdatable" false,
                                                      UPDATABLE 'FALSE'),

    CONSTRAINT DrillersEstimatorPoint_PK PRIMARY KEY (native_uid),

    CONSTRAINT DrillersEstimatorPoint_UK1 UNIQUE (target_native_uid, target_point_no),

    CONSTRAINT FK_DrillersEstimatorPoint_targetestimator_native_uid
        FOREIGN KEY               (target_native_uid)
        REFERENCES TargetEstimator(native_uid)

) OPTIONS (UPDATABLE 'TRUE',  DrillersEstimatorPoint.IMPLEMENTED 'TRUE')
AS
SELECT
        OpenWorks_SM.DrillersEstimatorPt.native_uid,
        OpenWorks_SM.TARGET.TARGET_ID,
        OpenWorks_SM.WellPlanProj.WP_PROJECT_NAME,
        OpenWorks_SM.TARGET.TARGET_LNAME AS target_name,
        cast(OpenWorks_SM.DrillersEstimatorPt.target_pt_no AS integer),
        OpenWorks_SM.DrillersEstimatorPt.TARGET_CORNER_U AS target_corner_u,
        OpenWorks_SM.DrillersEstimatorPt.TARGET_CORNER_U_DSDSUNIT AS target_corner_u_unit,
        OpenWorks_SM.DrillersEstimatorPt.TARGET_CORNER_V AS target_corner_v,
        OpenWorks_SM.DrillersEstimatorPt.TARGET_CORNER_V_DSDSUNIT AS target_corner_v_unit,
        OpenWorks_SM.DrillersEstimatorPt.native_uid
FROM
        OpenWorks_SM.WellPlanProj,OpenWorks_SM.TARGET,OpenWorks_SM.DrillersEstimatorPt, OpenWorks_SM.TargetEstimator
WHERE
        OpenWorks_SM.DrillersEstimatorPt.TARGET_ID = OpenWorks_SM.TARGET.TARGET_ID AND
        OpenWorks_SM.DrillersEstimatorPt.TARGET_ID = OpenWorks_SM.TargetEstimator.TARGET_ID AND
        OpenWorks_SM.TARGET.WP_PROJECT_ID = OpenWorks_SM.WellPlanProj.WP_PROJECT_ID;


CREATE TRIGGER ON DrillersEstimatorPoint INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC

    DECLARE string VARIABLES.wp_target_id_errorMsg='ERROR: The TargetEstimator with given Target id:  '|| "NEW".target_native_uid || 'does not exist';


   DECLARE string VARIABLES.target_id = (SELECT target_id FROM OpenWorks_SM.TargetEstimator WHERE target_id = "NEW".target_native_uid);

   IF (VARIABLES.target_id IS NULL ) ERROR VARIABLES.wp_target_id_errorMsg;

   INSERT INTO OpenWorks_SM.DrillersEstimatorPt (
                TARGET_ID,
                TARGET_PT_NO,
                TARGET_CORNER_U,
                TARGET_CORNER_V,
                TARGET_CORNER_U_DSDSUNIT,
                TARGET_CORNER_V_DSDSUNIT)
                VALUES (
                cast(VARIABLES.target_id AS integer),
                "NEW".target_point_no,
                "NEW".target_corner_u,
                "NEW".target_corner_v,
                "NEW".target_corner_u_unit,
                "NEW".target_corner_v_unit
               );

END;



CREATE TRIGGER ON DrillersEstimatorPoint INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC
        UPDATE OpenWorks_SM.DrillersEstimatorPt
            SET
                TARGET_CORNER_U = "NEW".target_corner_u,
                TARGET_CORNER_V = "NEW".target_corner_v,
                TARGET_CORNER_U_DSDSUNIT = "NEW".target_corner_u_unit,
                TARGET_CORNER_V_DSDSUNIT = "NEW".target_corner_v_unit
            WHERE
        native_uid = "OLD".native_uid;
END;

CREATE TRIGGER ON DrillersEstimatorPoint INSTEAD OF Delete AS
FOR EACH ROW
BEGIN ATOMIC
    Delete from OpenWorks_SM.DrillersEstimatorPt
    where native_uid = "OLD".native_uid;
END;

/*
**************************************************
*             "GeologicalEstimatorPoint"
**************************************************
*/


CREATE VIEW GeologicalEstimatorPoint
(
  native_uid                     VARCHAR(1024)        OPTIONS("OpenWorksCommonModel:GeologicalEstimatorPoint.native_uid.isUpdatable" false,
                                                                "OpenWorksCommonModel:GeologicalEstimatorPoint.native_uid.isCreatable" false,
                                                               UPDATABLE 'FALSE'),

  target_native_uid     VARCHAR(1024) NOT NULL,
  project_name                   VARCHAR(40)  OPTIONS("OpenWorksCommonModel:GeologicalEstimatorPoint.project_name.isUpdatable" false,
                                                                "OpenWorksCommonModel:GeologicalEstimatorPoint.project_name.isCreatable" false,
                                                                UPDATABLE 'FALSE'),
  target_name                    VARCHAR(200) OPTIONS("OpenWorksCommonModel:GeologicalEstimatorPoint.target_name.isUpdatable" false,
                                                                "OpenWorksCommonModel:GeologicalEstimatorPoint.target_name.isCreatable" false,
                                                                UPDATABLE 'FALSE'),
  target_point_no                INTEGER      NOT NULL,
  border_pick_uncertainty        DOUBLE       OPTIONS
                                                  ("OpenWorksCommonModel:GeologicalEstimatorPoint.border_pick_uncertainty.unitField" 'border_pick_uncertainty_unit'),
  border_pick_uncertainty_unit   VARCHAR(64)  OPTIONS
                                                 ("OpenWorksCommonModel:GeologicalEstimatorPoint.border_pick_uncertainty_unit.unitType" 'percent'),
  border_tolerance_risk          DOUBLE        OPTIONS
                                                   ("OpenWorksCommonModel:GeologicalEstimatorPoint.border_tolerance_risk.unitField" 'border_tolerance_risk_unit'),
  border_tolerance_risk_unit     VARCHAR(64)   OPTIONS
                                                ("OpenWorksCommonModel:GeologicalEstimatorPoint.border_tolerance_risk_unit.unitType" 'percent'),
  border_hardline                VARCHAR(1),
  alternate_uid    		             VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:GeologicalEstimatorPoint.alternate_uid.isCreatable" false,
                                                        "OpenWorksCommonModel:GeologicalEstimatorPoint.alternate_uid.isUpdatable" false,
                                                         UPDATABLE 'FALSE'),

    CONSTRAINT GeologicalEstimatorPt_PK PRIMARY KEY (native_uid),

    CONSTRAINT GeologicalEstimatorPt_UK1 UNIQUE (target_native_uid, target_point_no),

    CONSTRAINT FK_GeologicalEstimatorPoint_targetestimator_native_uid
        FOREIGN KEY               (target_native_uid)
        REFERENCES TargetEstimator(native_uid)


) OPTIONS (UPDATABLE 'TRUE',  GeologicalEstimatorPoint.IMPLEMENTED 'TRUE')
AS
SELECT
        OpenWorks_SM.GeologicalEstimatorPt.native_uid,
        CONVERT(trgEst.TARGET_ID,VARCHAR(1024)),
        OpenWorks_SM.WellPlanProj.WP_PROJECT_NAME,
        OpenWorks_SM.TARGET.TARGET_LNAME AS target_name,
        TARGET_PT_NO,
        BORDER_PICK_UNC AS border_pick_uncertainty,
        BORDER_PICK_UNC_DSDSUNIT AS border_pick_uncertainty_unit,
        BORDER_TOLERANCE_RISK AS border_tolerance_risk,
        BORDER_TOLERANCE_RISK_DSDSUNIT AS border_tolerance_risk_unit,
        BORDER_HARDLINE AS border_hardline,
		OpenWorks_SM.GeologicalEstimatorPt.native_uid
    FROM
        OpenWorks_SM.WellPlanProj,OpenWorks_SM.TARGET,OpenWorks_SM.GeologicalEstimatorPt,OpenWorks_SM.TargetEstimator trgEst
    WHERE
        OpenWorks_SM.GeologicalEstimatorPt.TARGET_ID = OpenWorks_SM.TARGET.TARGET_ID
    AND
        OpenWorks_SM.TARGET.TARGET_ID = trgEst.TARGET_ID
    AND
        OpenWorks_SM.TARGET.WP_PROJECT_ID = OpenWorks_SM.WellPlanProj.WP_PROJECT_ID;


CREATE TRIGGER ON GeologicalEstimatorPoint INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC



    DECLARE string VARIABLES.wp_target_id_errorMsg='ERROR: The Target with given native_uid  '|| "NEW".target_native_uid || ' does not exist';


    DECLARE string VARIABLES.target_id = (SELECT target_id FROM OpenWorks_SM.TargetEstimator WHERE target_id = "NEW".target_native_uid);

    IF (VARIABLES.target_id IS NULL ) ERROR VARIABLES.wp_target_id_errorMsg;

    INSERT INTO OpenWorks_SM.GeologicalEstimatorPt
    (
     TARGET_ID,
     TARGET_PT_NO,
     BORDER_PICK_UNC,
     BORDER_PICK_UNC_DSDSUNIT,
     BORDER_TOLERANCE_RISK,
     BORDER_TOLERANCE_RISK_DSDSUNIT,
     BORDER_HARDLINE
    )
    VALUES
    (
     cast(VARIABLES.target_id AS integer),
     "NEW".target_point_no,
     "NEW".border_pick_uncertainty,
     "NEW".border_pick_uncertainty_unit,
     "NEW".border_tolerance_risk,
     "NEW".border_tolerance_risk_unit,
     "NEW".BORDER_HARDLINE
    );

END;

CREATE TRIGGER ON GeologicalEstimatorPoint INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC

    UPDATE OpenWorks_SM.GeologicalEstimatorPt
        SET
            BORDER_PICK_UNC = "NEW".border_pick_uncertainty,
            BORDER_PICK_UNC_DSDSUNIT  = "NEW".border_pick_uncertainty_unit,
            BORDER_TOLERANCE_RISK = "NEW".border_tolerance_risk,
            BORDER_TOLERANCE_RISK_DSDSUNIT = "NEW".border_tolerance_risk_unit,
            BORDER_HARDLINE = "NEW".BORDER_HARDLINE
        WHERE
            native_uid = "OLD".native_uid;
END;

CREATE TRIGGER ON GeologicalEstimatorPoint INSTEAD OF Delete AS
FOR EACH ROW
BEGIN ATOMIC

    Delete from OpenWorks_SM.GeologicalEstimatorPt where
    native_uid = "OLD".native_uid;

END;


/*
**********************************
*     RelativeUncertainty
**********************************
*/
CREATE VIEW RelativeUncertainty
(
	native_uid                      VARCHAR(1024)   OPTIONS("OpenWorksCommonModel:RelativeUncertainty.native_uid.isUpdatable" false,
                                                            "OpenWorksCommonModel:RelativeUncertainty.native_uid.isCreatable" false,
                                                            UPDATABLE 'FALSE'),
    targetestimator_a_native_uid    VARCHAR(1024) NOT NULL,
    target_a_project_name           VARCHAR(40)  OPTIONS("OpenWorksCommonModel:RelativeUncertainty.target_a_project_name.isUpdatable" false,
                                                          "OpenWorksCommonModel:RelativeUncertainty.target_a_project_name.isCreatable" false,
                                                          UPDATABLE 'FALSE'),
    target_a_name                   VARCHAR(200) OPTIONS("OpenWorksCommonModel:RelativeUncertainty.target_a_name.isUpdatable" false,
                                                          "OpenWorksCommonModel:RelativeUncertainty.target_a_name.isCreatable" false,
                                                          UPDATABLE 'FALSE'),
    targetestimator_b_native_uid    VARCHAR(1024) NOT NULL,
    target_b_project_name           VARCHAR(40)  OPTIONS("OpenWorksCommonModel:RelativeUncertainty.target_b_project_name.isUpdatable" false,
                                                          "OpenWorksCommonModel:RelativeUncertainty.target_b_project_name.isCreatable" false,
                                                          UPDATABLE 'FALSE'),
    target_b_name                   VARCHAR(200) OPTIONS("OpenWorksCommonModel:RelativeUncertainty.target_b_name.isUpdatable" false,
                                                          "OpenWorksCommonModel:RelativeUncertainty.target_b_name.isCreatable" false,
                                                          UPDATABLE 'FALSE'),

    alternate_uid    		                VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:RelativeUncertainty.alternate_uid.isCreatable" false,
                                                           "OpenWorksCommonModel:RelativeUncertainty.alternate_uid.isUpdatable" false,
                                                            UPDATABLE 'FALSE'),

    CONSTRAINT RelativeUncertainty_PK PRIMARY KEY (native_uid),

    CONSTRAINT RelativeUncertainty_UK1 UNIQUE (targetestimator_a_native_uid, targetestimator_b_native_uid),

    CONSTRAINT FK_RelativeUncertainty_targetestimator_a_native_uid
        FOREIGN KEY               (targetestimator_a_native_uid)
        REFERENCES TargetEstimator(native_uid),

    CONSTRAINT FK_RelativeUncertainty_targetestimator_b_native_uid
        FOREIGN KEY               (targetestimator_b_native_uid)
        REFERENCES TargetEstimator(native_uid)


)   OPTIONS (UPDATABLE 'TRUE',  RelativeUncertainty.IMPLEMENTED 'TRUE')
AS
SELECT
     RuA.native_uid,
     TargetEstimatorA.target_id,
     WellPlanProjA.wp_project_name,
     TargetA.target_lname,
     TargetEstimatorB.target_id,
     WellPlanProjB.wp_project_name,
     TargetB.target_lname,
     RuA.native_uid
FROM
     OpenWorks_SM.WellPlanProj WellPlanProjA,
     Openworks_SM.Target TargetA,
     Openworks_SM.TargetEstimator TargetEstimatorA,
     OpenWorks_SM.WellPlanProj WellPlanProjB,
     Openworks_SM.Target TargetB,
     Openworks_SM.TargetEstimator TargetEstimatorB,
     Openworks_SM.RelativeUncertainty RuA,
     Openworks_SM.RelativeUncertainty RuB
WHERE TargetA.wp_project_id  = WellPlanProjA.wp_project_id
  AND TargetEstimatorA.Target_ID =  TargetA.Target_ID
  AND RuA.Target_A_id =  TargetEstimatorA.Target_ID
  AND TargetB.wp_project_id  = WellPlanProjB.wp_project_id
  AND TargetEstimatorB.Target_ID =  TargetB.Target_ID
  AND RuB.Target_b_id =  TargetEstimatorB.Target_ID
  AND RuA.Target_A_id = RuB.Target_A_id
  AND RuA.Target_B_id = RuB.Target_B_id;


  Create Trigger on RelativeUncertainty INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC

  DECLARE string VARIABLES.a_id =
  (SELECT target_id
   FROM OpenWorks_SM.TargetEstimator
   WHERE target_id = "NEW".targetestimator_a_native_uid);

  DECLARE string VARIABLES.b_id =
  (SELECT target_id
   FROM OpenWorks_SM.TargetEstimator
   WHERE target_id = "NEW".targetestimator_b_native_uid);

  INSERT INTO OpenWorks_SM.RelativeUncertainty (Target_A_id, Target_b_id)
  VALUES (cast(VARIABLES.a_id AS integer),cast(VARIABLES.b_id AS integer));

END;

Create Trigger on RelativeUncertainty INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC

DECLARE string VARIABLES.a_id =
  (SELECT target_id
   FROM OpenWorks_SM.TargetEstimator
   WHERE target_id = "OLD".targetestimator_a_native_uid);

  DECLARE string VARIABLES.b_id =
  (SELECT target_id
   FROM OpenWorks_SM.TargetEstimator
   WHERE target_id = "OLD".targetestimator_b_native_uid);

   DELETE FROM OpenWorks_SM.RelativeUncertainty WHERE Target_A_id =VARIABLES.a_id AND Target_b_id = VARIABLES.b_id;

END;

/*
**********************************
*     TargetUncertainty
**********************************
*/
Create View TargetUncertainty
(
  native_uid                    VARCHAR(1024) OPTIONS("OpenWorksCommonModel:TargetUncertainty.native_uid.isUpdatable" false,
                                                        "OpenWorksCommonModel:TargetUncertainty.native_uid.isCreatable" false,
                                                        UPDATABLE 'FALSE'),
  target_native_uid  VARCHAR(1024) NOT NULL,
  project_name                VARCHAR(40) OPTIONS("OpenWorksCommonModel:TargetUncertainty.project_name.isUpdatable" false,
                                                    "OpenWorksCommonModel:TargetUncertainty.project_name.isCreatable" false,
                                                    UPDATABLE 'FALSE'),
  wellplanproject_native_uid  VARCHAR(1024) OPTIONS("OpenWorksCommonModel:TargetUncertainty.wellplanproject_native_uid.isUpdatable" false,
                                                        "OpenWorksCommonModel:TargetUncertainty.wellplanproject_native_uid.isCreatable" false,
                                                        UPDATABLE 'FALSE'),
  target_name                 VARCHAR(200) OPTIONS("OpenWorksCommonModel:TargetUncertainty.target_name.isUpdatable" false,
                                                    "OpenWorksCommonModel:TargetUncertainty.target_name.isCreatable" false,
                                                    UPDATABLE 'FALSE'),
  amount_steering             INTEGER,
  bha_drilling                INTEGER,
  md_target                   DOUBLE            OPTIONS ("OpenWorksCommonModel:TargetUncertainty.md_target.unitField" 'md_target_unit'),
  md_target_unit              VARCHAR(64)       OPTIONS ("OpenWorksCommonModel:TargetUncertainty.md_target_unit.unitType" 'depth measure'),
  measured_depth              DOUBLE            OPTIONS ("OpenWorksCommonModel:TargetUncertainty.measured_depth.unitField"
                                                        'measured_depth_unit'),
  measured_depth_unit         VARCHAR(64)       OPTIONS ("OpenWorksCommonModel:TargetUncertainty.measured_depth_unit.unitType"
                                                         'depth measure'),
  geoph_corrl_function                          INTEGER,
  geoph_covar_xx              DOUBLE            OPTIONS ("OpenWorksCommonModel:TargetUncertainty.geoph_covar_xx.unitField"
                                                         'geoph_covar_unit'),
  geoph_covar_xy              DOUBLE            OPTIONS ("OpenWorksCommonModel:TargetUncertainty.geoph_covar_xy.unitField"
                                                         'geoph_covar_unit'),
  geoph_covar_xz              DOUBLE            OPTIONS ("OpenWorksCommonModel:TargetUncertainty.geoph_covar_xz.unitField"
                                                         'geoph_covar_unit'),
  geoph_covar_yy              DOUBLE            OPTIONS ("OpenWorksCommonModel:TargetUncertainty.geoph_covar_yy.unitField"
                                                         'geoph_covar_unit'),
  geoph_covar_yz              DOUBLE            OPTIONS ("OpenWorksCommonModel:TargetUncertainty.geoph_covar_yz.unitField"
                                                         'geoph_covar_unit'),
  geoph_covar_zz              DOUBLE            OPTIONS ("OpenWorksCommonModel:TargetUncertainty.geoph_covar_zz.unitField"
                                                         'geoph_covar_unit'),
  geoph_covar_unit            VARCHAR(64)       OPTIONS ("OpenWorksCommonModel:TargetUncertainty.geoph_covar_unit.unitType"
                                                         'unitless'),
  geoph_horiz_corrl           DOUBLE            OPTIONS ("OpenWorksCommonModel:TargetUncertainty.geoph_horiz_corrl.unitField"
                                                         'geoph_horiz_corrl_unit'),
  geoph_horiz_corrl_unit      VARCHAR(64)       OPTIONS ("OpenWorksCommonModel:TargetUncertainty.geoph_horiz_corrl_unit.unitType"
                                                         'linear distance'),
  geoph_vert_corrl            DOUBLE            OPTIONS ("OpenWorksCommonModel:TargetUncertainty.geoph_vert_corrl.unitField"
                                                         'geoph_vert_corrl_unit'),
  geoph_vert_corrl_unit       VARCHAR(64)       OPTIONS ("OpenWorksCommonModel:TargetUncertainty.geoph_vert_corrl_unit.unitType"
                                                         'linear distance'),
  geoph_major_horiz_axis      DOUBLE            OPTIONS ("OpenWorksCommonModel:TargetUncertainty.geoph_major_horiz_axis.unitField"
                                                         'geoph_major_horiz_axis_unit'),
  geoph_major_horiz_axis_unit VARCHAR(64)      OPTIONS ("OpenWorksCommonModel:TargetUncertainty.geoph_major_horiz_axis_unit.unitType"
                                                        'linear distance'),
  geoph_minor_horiz_axis      DOUBLE           OPTIONS ("OpenWorksCommonModel:TargetUncertainty.geoph_minor_horiz_axis.unitField"
                                                        'geoph_minor_horiz_axis_unit'),
  geoph_minor_horiz_axis_unit VARCHAR(64)      OPTIONS
                                                     ("OpenWorksCommonModel:TargetUncertainty.geoph_minor_horiz_axis_unit.unitType"  'linear distance'),
  geoph_minor_horiz_azim        DOUBLE         OPTIONS ("OpenWorksCommonModel:TargetUncertainty.geoph_minor_horiz_azim.unitField"
                                                        'geoph_minor_horiz_azim_unit'),
  geoph_minor_horiz_azim_unit   VARCHAR(64)    OPTIONS (
                                                       "OpenWorksCommonModel:TargetUncertainty.geoph_minor_horiz_azim_unit.unitType" 'angular distance'),
  geoph_vert_axis               DOUBLE         OPTIONS ("OpenWorksCommonModel:TargetUncertainty.geoph_vert_axis.unitField"
                                                        'geoph_vert_axis_unit'),
  geoph_vert_axis_unit          VARCHAR(64)    OPTIONS ("OpenWorksCommonModel:TargetUncertainty.geoph_vert_axis_unit.unitType"
                                                        'depth measure'),
  survey_corrl_function         INTEGER,
  survey_corrl_length           DOUBLE         OPTIONS ("OpenWorksCommonModel:TargetUncertainty.survey_corrl_length.unitField"
                                                        'survey_corrl_length_unit'),
  survey_corrl_length_unit      VARCHAR(64)    OPTIONS (
                                                        "OpenWorksCommonModel:TargetUncertainty.survey_corrl_length_unit.unitType" 'linear distance'),
  survey_covar_xx               DOUBLE         OPTIONS ("OpenWorksCommonModel:TargetUncertainty.survey_covar_xx.unitField"
                                                        'survey_covar_unit'),
  survey_covar_xy               DOUBLE         OPTIONS ("OpenWorksCommonModel:TargetUncertainty.survey_covar_xy.unitField"
                                                        'survey_covar_unit'),
  survey_covar_xz               DOUBLE         OPTIONS ("OpenWorksCommonModel:TargetUncertainty.survey_covar_xz.unitField"
                                                        'survey_covar_unit'),
  survey_covar_yy               DOUBLE         OPTIONS ("OpenWorksCommonModel:TargetUncertainty.survey_covar_yy.unitField"
                                                        'survey_covar_unit'),
  survey_covar_yz               DOUBLE         OPTIONS ("OpenWorksCommonModel:TargetUncertainty.survey_covar_yz.unitField"
                                                        'survey_covar_unit'),
  survey_covar_zz               DOUBLE         OPTIONS ("OpenWorksCommonModel:TargetUncertainty.survey_covar_zz.unitField"
                                                         'survey_covar_unit'),
  survey_covar_unit             VARCHAR(64)    OPTIONS ("OpenWorksCommonModel:TargetUncertainty.survey_covar_unit.unitType"
                                                        'unitless'),
  survey_major_horiz_axis       DOUBLE         OPTIONS ("OpenWorksCommonModel:TargetUncertainty.survey_major_horiz_axis.unitField"
                                                        'survey_major_horiz_axis_unit'),
  survey_major_horiz_axis_unit  VARCHAR(64)    OPTIONS (
                                                      "OpenWorksCommonModel:TargetUncertainty.survey_major_horiz_axis_unit.unitType" 'linear distance'),
  survey_minor_horiz_axis       DOUBLE         OPTIONS ("OpenWorksCommonModel:TargetUncertainty.survey_minor_horiz_axis.unitField"
                                                        'survey_minor_horiz_axis_unit'),
  survey_minor_horiz_axis_unit  VARCHAR(64)    OPTIONS (
                                                      "OpenWorksCommonModel:TargetUncertainty.survey_minor_horiz_axis_unit.unitType" 'linear distance'),
  survey_minor_horiz_azim       DOUBLE         OPTIONS ("OpenWorksCommonModel:TargetUncertainty.survey_minor_horiz_azim.unitField"
                                                        'survey_minor_horiz_azim_unit'),
  survey_minor_horiz_azim_unit  VARCHAR(64)    OPTIONS (
                                                      "OpenWorksCommonModel:TargetUncertainty.survey_minor_horiz_azim_unit.unitType" 'linear distance'),
  survey_vert_axis              DOUBLE         OPTIONS ("OpenWorksCommonModel:TargetUncertainty.survey_vert_axis.unitField"
                                                        'survey_vert_axis_unit'),
  survey_vert_axis_unit         VARCHAR(64)    OPTIONS ("OpenWorksCommonModel:TargetUncertainty.survey_vert_axis_unit.unitType"
                                                        'depth measure'),
  steering_target_width         DOUBLE         OPTIONS ("OpenWorksCommonModel:TargetUncertainty.steering_target_width.unitField"
                                                        'steering_target_width_unit'),
  steering_target_width_unit    VARCHAR(64)    OPTIONS ("OpenWorksCommonModel:TargetUncertainty.steering_target_width_unit.unitType"
                                                        'linear distance'),
  steering_target_height        DOUBLE         OPTIONS ("OpenWorksCommonModel:TargetUncertainty.steering_target_height.unitField"
                                                        'steering_target_height_unit'),
  steering_target_height_unit   VARCHAR(64)    OPTIONS (
                                                       "OpenWorksCommonModel:TargetUncertainty.steering_target_height_unit.unitType" 'linear distance'),
  use_geoph_uncert_ind          VARCHAR(1),
  use_markers_pick_uncert_ind   VARCHAR(1),
  use_markers_geop_uncert_ind   VARCHAR(1),
  use_markers_survey_uncert_ind VARCHAR(1),
  use_steering_uncert_ind       VARCHAR(1),
  use_survey_uncert_ind         VARCHAR(1),
  alternate_uid    		            VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:TargetUncertainty.alternate_uid.isCreatable" false,
                                                       "OpenWorksCommonModel:TargetUncertainty.alternate_uid.isUpdatable" false,
                                                        UPDATABLE 'FALSE'),

    CONSTRAINT TargetUncertainty_PK PRIMARY KEY (native_uid),

    CONSTRAINT TargetUncertainty_UK1 UNIQUE (target_native_uid),

    CONSTRAINT FK_TargetUncertainty_targetestimator_native_uid
        FOREIGN KEY               (target_native_uid)
        REFERENCES TargetEstimator(native_uid)

)  OPTIONS (UPDATABLE 'TRUE',  TargetUncertainty.IMPLEMENTED 'TRUE')
AS
SELECT
  cast(OpenWorks_SM.TargetUncertainty.target_id AS string),
  OpenWorks_SM.TargetEstimator.target_id,
  OpenWorks_SM.WellPlanProj.wp_project_name,
  OpenWorks_SM.WellPlanProj.wp_project_id,
  OpenWorks_SM.Target.target_lname AS target_long_name,
  OpenWorks_SM.TargetUncertainty.amount_steering,
  OpenWorks_SM.TargetUncertainty.bha_drilling ,
  OpenWorks_SM.TargetUncertainty.md_target ,
  OpenWorks_SM.TargetUncertainty.md_target_dsdsunit,
  OpenWorks_SM.TargetUncertainty.meas_depth ,
  OpenWorks_SM.TargetUncertainty.meas_depth_dsdsunit ,
  OpenWorks_SM.TargetUncertainty.geop_corr_fnc ,
  OpenWorks_SM.TargetUncertainty.geop_covar_xx ,
  OpenWorks_SM.TargetUncertainty.geop_covar_xy,
  OpenWorks_SM.TargetUncertainty.geop_covar_xz,
  OpenWorks_SM.TargetUncertainty.geop_covar_yy ,
  OpenWorks_SM.TargetUncertainty.geop_covar_yz  ,
  OpenWorks_SM.TargetUncertainty.geop_covar_zz ,
  geop_covar_zz_dsdsunit,
  OpenWorks_SM.TargetUncertainty.geop_hor_corr ,
  OpenWorks_SM.TargetUncertainty.geop_hor_corr_dsdsunit,
  OpenWorks_SM.TargetUncertainty.geop_vert_corr ,
  OpenWorks_SM.TargetUncertainty.geop_vert_corr_dsdsunit ,
  OpenWorks_SM.TargetUncertainty.geop_maj_hor_axis,
  OpenWorks_SM.TargetUncertainty.geop_maj_hor_axis_dsdsunit ,
  OpenWorks_SM.TargetUncertainty.geop_min_hor_axis,
  OpenWorks_SM.TargetUncertainty.geop_min_hor_axis_dsdsunit,
  OpenWorks_SM.TargetUncertainty.geop_min_hor_az ,
  OpenWorks_SM.TargetUncertainty.geop_min_hor_az_dsdsunit ,
  OpenWorks_SM.TargetUncertainty.geop_vert_axis ,
  OpenWorks_SM.TargetUncertainty.geop_vert_axis_dsdsunit,
  OpenWorks_SM.TargetUncertainty.srvy_corr_fnc,
  OpenWorks_SM.TargetUncertainty.srvy_corr_lng,
  OpenWorks_SM.TargetUncertainty.srvy_corr_lng_dsdsunit,
  OpenWorks_SM.TargetUncertainty.srvy_covar_xx ,
  OpenWorks_SM.TargetUncertainty.srvy_covar_xy ,
  OpenWorks_SM.TargetUncertainty.srvy_covar_xz,
  OpenWorks_SM.TargetUncertainty.srvy_covar_yy,
  OpenWorks_SM.TargetUncertainty.srvy_covar_yz,
  OpenWorks_SM.TargetUncertainty.srvy_covar_zz,
  srvy_covar_zz_dsdsunit,
  OpenWorks_SM.TargetUncertainty.srvy_maj_hor_axis,
  OpenWorks_SM.TargetUncertainty.srvy_maj_hor_axis_dsdsunit,
  OpenWorks_SM.TargetUncertainty.srvy_min_hor_axis,
  OpenWorks_SM.TargetUncertainty.srvy_min_hor_axis_dsdsunit,
  OpenWorks_SM.TargetUncertainty.srvy_min_hor_az,
  OpenWorks_SM.TargetUncertainty.srvy_min_hor_az_dsdsunit,
  OpenWorks_SM.TargetUncertainty.srvy_vert_axis,
  srvy_vert_axis_dsdsunit,
  OpenWorks_SM.TargetUncertainty.strg_target_width,
  OpenWorks_SM.TargetUncertainty.strg_target_width_dsdsunit,
  OpenWorks_SM.TargetUncertainty.strg_target_height,
  OpenWorks_SM.TargetUncertainty.strg_target_height_dsdsunit,
  OpenWorks_SM.TargetUncertainty.use_geop_unc,
  OpenWorks_SM.TargetUncertainty.use_markers_pick_unc ,
  OpenWorks_SM.TargetUncertainty.use_markers_geop_unc,
  OpenWorks_SM.TargetUncertainty.use_markers_survey_unc,
  OpenWorks_SM.TargetUncertainty.use_steering_unc ,
  OpenWorks_SM.TargetUncertainty.use_survey_unc,
  OpenWorks_SM.TargetUncertainty.native_uid
FROM
                   OpenWorks_SM.TargetUncertainty,
                   OpenWorks_SM.WellPlanProj,
    Openworks_SM.Target,
    Openworks_SM.TargetEstimator
WHERE
    OpenWorks_SM.TargetUncertainty.target_id = Openworks_SM.Target.target_id
    AND  OpenWorks_SM.TargetEstimator.target_id = Openworks_SM.Target.target_id
    AND Openworks_SM.Target.wp_project_id  = OpenWorks_SM.WellPlanProj.wp_project_id ;


CREATE TRIGGER ON TargetUncertainty INSTEAD OF INSERT AS
    FOR EACH ROW
BEGIN ATOMIC
    DECLARE string VARIABLES.wp_target_id_errorMsg='ERROR: The TargetEstimator with given value '|| "NEW".target_native_uid || '  does not exist';

    DECLARE string VARIABLES.target_id = (SELECT target_id FROM OpenWorks_SM.TargetEstimator WHERE target_id = "NEW".target_native_uid);

    IF (VARIABLES.target_id IS NULL ) ERROR VARIABLES.wp_target_id_errorMsg;

    INSERT INTO OpenWorks_SM.TargetUncertainty
    (
     target_id,  amount_steering, bha_drilling, md_target, md_target_dsdsunit, meas_depth, meas_depth_dsdsunit, geop_corr_fnc, geop_covar_xx,geop_covar_xy, geop_covar_xz,  geop_covar_yy, geop_covar_yz,geop_covar_zz, geop_hor_corr, geop_hor_corr_dsdsunit, geop_vert_corr, geop_vert_corr_dsdsunit, geop_maj_hor_axis, geop_maj_hor_axis_dsdsunit, geop_min_hor_axis, geop_min_hor_axis_dsdsunit, geop_min_hor_az, geop_min_hor_az_dsdsunit, geop_vert_axis, geop_vert_axis_dsdsunit, srvy_corr_fnc, srvy_corr_lng, srvy_corr_lng_dsdsunit, srvy_covar_xx,  srvy_covar_xy, srvy_covar_xz, srvy_covar_yy, srvy_covar_yz,  srvy_covar_zz, srvy_maj_hor_axis, srvy_maj_hor_axis_dsdsunit, srvy_min_hor_axis, srvy_min_hor_axis_dsdsunit, srvy_min_hor_az, srvy_min_hor_az_dsdsunit, srvy_vert_axis, strg_target_width, strg_target_width_dsdsunit, strg_target_height, strg_target_height_dsdsunit, use_geop_unc, use_markers_pick_unc, use_markers_geop_unc, use_markers_survey_unc, use_steering_unc, use_survey_unc
                      )
          VALUES ( cast(VARIABLES.target_id AS integer), "NEW".amount_steering, "NEW".bha_drilling , "NEW".md_target  , "NEW".md_target_unit ,  "NEW".measured_depth  , "NEW".measured_depth_unit ,  "NEW".geoph_corrl_function  , "NEW".geoph_covar_xx  , "NEW".geoph_covar_xy, "NEW".geoph_covar_xz  , "NEW".geoph_covar_yy , "NEW".geoph_covar_yz  , "NEW".geoph_covar_zz , "NEW".geoph_horiz_corrl , "NEW".geoph_horiz_corrl_unit ,  "NEW".geoph_vert_corrl , "NEW".geoph_vert_corrl_unit ,  "NEW".geoph_major_horiz_axis  , "NEW".geoph_major_horiz_axis_unit ,  "NEW".geoph_minor_horiz_axis  , "NEW".geoph_minor_horiz_axis_unit ,  "NEW".geoph_minor_horiz_azim , "NEW".geoph_minor_horiz_azim_unit ,  "NEW".geoph_vert_axis , "NEW".geoph_vert_axis_unit ,  "NEW".survey_corrl_function  , "NEW".survey_corrl_length  , "NEW".survey_corrl_length_unit ,  "NEW".survey_covar_xx , "NEW".survey_covar_xy  , "NEW".survey_covar_xz  , "NEW".survey_covar_yy , "NEW".survey_covar_yz  , "NEW".survey_covar_zz, "NEW".survey_major_horiz_axis  , "NEW".survey_major_horiz_axis_unit ,  "NEW".survey_minor_horiz_axis  , "NEW".survey_minor_horiz_axis_unit ,  "NEW".survey_minor_horiz_azim  , "NEW".survey_minor_horiz_azim_unit ,  "NEW".survey_vert_axis  , "NEW".steering_target_width , "NEW".steering_target_width_unit ,  "NEW".steering_target_height  , "NEW".steering_target_height_unit ,  "NEW".use_geoph_uncert_ind , "NEW".use_markers_pick_uncert_ind , "NEW".use_markers_geop_uncert_ind  , "NEW".use_markers_survey_uncert_ind  , "NEW".use_steering_uncert_ind  , "NEW".use_survey_uncert_ind   );


END;

Create Trigger on TargetUncertainty INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC


UPDATE OpenWorks_SM.TargetUncertainty
SET
       amount_steering                            =  "NEW".amount_steering ,
          bha_drilling                               =  "NEW".bha_drilling ,
          md_target                                  =  "NEW".md_target ,
          md_target_dsdsunit                             = "NEW".md_target_unit,
          meas_depth                             =  "NEW".measured_depth ,
          meas_depth_dsdsunit                        = "NEW".measured_depth_unit,
          geop_corr_fnc           =  "NEW".geoph_corrl_function ,
          geop_covar_xx                   =  "NEW".geoph_covar_xx ,
          geop_covar_xy                  =  "NEW".geoph_covar_xy ,
          geop_covar_xz                   =  "NEW".geoph_covar_xz ,
          geop_covar_yy                   =  "NEW".geoph_covar_yy ,
          geop_covar_yz                   =  "NEW".geoph_covar_yz ,
          geop_covar_zz                   =  "NEW".geoph_covar_zz ,
          geop_hor_corr         =  "NEW".geoph_horiz_corrl ,
          geop_hor_corr_dsdsunit    = "NEW".geoph_horiz_corrl_unit,
          geop_vert_corr           =  "NEW".geoph_vert_corrl ,
          geop_vert_corr_dsdsunit      = "NEW".geoph_vert_corrl_unit,
          geop_maj_hor_axis          =  "NEW".geoph_major_horiz_axis ,
          geop_maj_hor_axis_dsdsunit     = "NEW".geoph_major_horiz_axis_unit,
          geop_min_hor_axis          =  "NEW".geoph_minor_horiz_axis ,
          geop_min_hor_axis_dsdsunit     = "NEW".geoph_minor_horiz_axis_unit,
       geop_min_hor_az       =  "NEW".geoph_minor_horiz_azim ,
       geop_min_hor_az_dsdsunit  = "NEW".geoph_minor_horiz_azim_unit,
          geop_vert_axis                  =  "NEW".geoph_vert_axis ,
          geop_vert_axis_dsdsunit             = "NEW".geoph_vert_axis_unit,
          srvy_corr_fnc                =  "NEW".survey_corrl_function ,
          srvy_corr_lng                  =  "NEW".survey_corrl_length ,
          srvy_corr_lng_dsdsunit             = "NEW".survey_corrl_length_unit,
          srvy_covar_xx                        =  "NEW".survey_covar_xx ,
          srvy_covar_xy                        =  "NEW".survey_covar_xy ,
          srvy_covar_xz                        =  "NEW".survey_covar_xz ,
          srvy_covar_yy                        =  "NEW".survey_covar_yy ,
          srvy_covar_yz                        =  "NEW".survey_covar_yz ,
          srvy_covar_zz                        =  "NEW".survey_covar_zz ,
          srvy_maj_hor_axis               =  "NEW".survey_major_horiz_axis ,
          srvy_maj_hor_axis_dsdsunit          = "NEW".survey_major_horiz_axis_unit,
          srvy_min_hor_axis               =  "NEW".survey_minor_horiz_axis ,
          srvy_min_hor_axis_dsdsunit          = "NEW".survey_minor_horiz_axis_unit,
       srvy_min_hor_az            =  "NEW".survey_minor_horiz_azim ,
       srvy_min_hor_az_dsdsunit       = "NEW".survey_minor_horiz_azim_unit,
          srvy_vert_axis                       =  "NEW".survey_vert_axis ,
          strg_target_width                      =  "NEW".steering_target_width ,
          strg_target_width_dsdsunit                 = "NEW".steering_target_width_unit,
          strg_target_height                     =  "NEW".steering_target_height ,
          strg_target_height_dsdsunit                = "NEW".steering_target_height_unit,
          use_geop_unc            =  "NEW".use_geoph_uncert_ind ,
          use_markers_pick_unc           =  "NEW".use_markers_pick_uncert_ind ,
          use_markers_geop_unc           =  "NEW".use_markers_geop_uncert_ind ,
          use_markers_survey_unc         =  "NEW".use_markers_survey_uncert_ind ,
          use_steering_unc               =  "NEW".use_steering_uncert_ind ,
          use_survey_unc                  =  "NEW".use_survey_uncert_ind
WHERE target_id = "OLD".target_native_uid;
END;


CREATE TRIGGER ON TargetUncertainty INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC

                DELETE FROM OpenWorks_SM.TargetUncertainty  WHERE target_id = "OLD".target_native_uid;
END;

/*
**********************************
*     "Target Optimization Parameter"
**********************************
*/
CREATE VIEW TargetOptimizationParameter
(
  native_uid              				VARCHAR(1024)   OPTIONS("OpenWorksCommonModel:TargetOptimizationParameter.native_uid.isUpdatable" false,
                                                    "OpenWorksCommonModel:TargetOptimizationParameter.native_uid.isCreatable" false,
                                                    UPDATABLE 'FALSE'),
  target_native_uid       				VARCHAR(1024) NOT NULL,
  project_name         	  				VARCHAR(40)  OPTIONS("OpenWorksCommonModel:TargetOptimizationParameter.project_name.isUpdatable" false,
                                                    "OpenWorksCommonModel:TargetOptimizationParameter.project_name.isCreatable" false,
                                                    UPDATABLE 'FALSE'),
  wellplanproject_native_uid            VARCHAR(1024)  OPTIONS("OpenWorksCommonModel:TargetOptimizationParameter.wellplanproject_native_uid.isUpdatable" false,
                                                    "OpenWorksCommonModel:TargetOptimizationParameter.wellplanproject_native_uid.isCreatable" false,
                                                    UPDATABLE 'FALSE'),
  target_name             				VARCHAR(200) OPTIONS("OpenWorksCommonModel:TargetOptimizationParameter.target_name.isUpdatable" false,
                                                    "OpenWorksCommonModel:TargetOptimizationParameter.target_name.isCreatable" false,
                                                    UPDATABLE 'FALSE'),
  parameter_name          				VARCHAR(40)  NOT NULL Default 'UNKNOWN',
  parameter_value         				FLOAT        OPTIONS ("OpenWorksCommonModel:TargetOptimizationParameter.parameter_value.unitField"
                                             'parameter_value_unit'),
  parameter_value_unit     				VARCHAR(64)  OPTIONS ("OpenWorksCommonModel:TargetOptimizationParameter.parameter_value_unit.unitTypeAttribute" 'unit_type'),
  unit_type                				VARCHAR(64),
  remark                   				VARCHAR(200),
  create_date              				TIMESTAMP    OPTIONS ("OpenWorksCommonModel:TargetOptimizationParameter.create_date.isUpdatable" false,
                                             "OpenWorksCommonModel:TargetOptimizationParameter.create_date.isCreatable" false,
                                              UPDATABLE 'FALSE'),
  create_user_id           				VARCHAR(32)    OPTIONS ("OpenWorksCommonModel:TargetOptimizationParameter.create_user_id.isUpdatable" false,
                                             "OpenWorksCommonModel:TargetOptimizationParameter.create_user_id.isCreatable" false,
                                              UPDATABLE 'FALSE'),
  update_date              				TIMESTAMP      OPTIONS ("OpenWorksCommonModel:TargetOptimizationParameter.update_date.isUpdatable" false,
                                             "OpenWorksCommonModel:TargetOptimizationParameter.update_date.isCreatable" false,
                                              UPDATABLE 'FALSE'),
  update_user_id           				VARCHAR(32)    OPTIONS ("OpenWorksCommonModel:TargetOptimizationParameter.update_user_id.isUpdatable" false,
                                             "OpenWorksCommonModel:TargetOptimizationParameter.update_user_id.isCreatable" false,UPDATABLE 'FALSE'),
  alternate_uid    		    VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:TargetOptimizationParameter.alternate_uid.isCreatable" false,
                                               "OpenWorksCommonModel:TargetOptimizationParameter.alternate_uid.isUpdatable" false,
                                                UPDATABLE 'FALSE'),

  CONSTRAINT TargetOptimizationParameter_PK PRIMARY KEY (native_uid),

    CONSTRAINT TargetOptimizationParameter_UK1 UNIQUE (target_native_uid, parameter_name),

    CONSTRAINT FK_TargetOptimizationParameter_target_native_uid
        FOREIGN KEY      (target_native_uid)
        REFERENCES Target(native_uid)

)
OPTIONS (UPDATABLE 'TRUE',  TargetOptimizationParameter.IMPLEMENTED 'TRUE')
AS
SELECT
  OpenWorks_SM.TargetOptParm.native_uid,
  OpenWorks_SM.TARGET.Target_id,
  OpenWorks_SM.WellPlanProj.wp_project_name,
  OpenWorks_SM.WellPlanProj.wp_project_id,
  OpenWorks_SM.TARGET.target_lname                        AS target_name,
  OpenWorks_SM.TargetOptParm.parameter_name               AS parameter_name,
  OpenWorks_SM.TargetOptParm.parameter_value              AS parameter_value,
  OpenWorks_SM.TargetOptParm.parameter_value_dsdsunit    AS parameter_value_unit,
  OpenWorks_SM.TargetOptParm.unit_type_id                 AS unit_type,
  OpenWorks_SM.TargetOptParm.remark                       AS remark,
  OpenWorks_SM.TargetOptParm.create_date                  AS create_date,
  OpenWorks_SM.TargetOptParm.create_user_id               AS create_user_id,
  OpenWorks_SM.TargetOptParm.update_date                  AS update_date,
  OpenWorks_SM.TargetOptParm.update_user_id               AS update_user_id,
  OpenWorks_SM.TargetOptParm.native_uid

FROM OpenWorks_SM.TargetOptParm ,
     OpenWorks_SM.WellPlanProj,
     OpenWorks_SM.TARGET
WHERE OpenWorks_SM.TargetOptParm.wp_project_id = OpenWorks_SM.WellPlanProj.wp_project_id
AND OpenWorks_SM.TARGET.Target_id = OpenWorks_SM.TargetOptParm.Target_id;

Create Trigger on TargetOptimizationParameter INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC

    DECLARE string VARIABLES.wp_project_id_errorMsg='ERROR: The WellPlan Project with given value '|| "NEW".target_native_uid || '  does not exist';
    DECLARE string VARIABLES.wp_project_id = (SELECT WP_PROJECT_ID FROM OpenWorks_SM.Target WHERE target_id = "NEW".target_native_uid);
    IF (VARIABLES.wp_project_id IS NULL ) ERROR VARIABLES.wp_project_id_errorMsg;

    DECLARE string VARIABLES.wp_target_id_errorMsg='ERROR: The Target with given value:  '|| "NEW".target_native_uid || 'does not exist';
    DECLARE string VARIABLES.target_id = (SELECT target_id FROM OpenWorks_SM.TARGET WHERE target_id = "NEW".target_native_uid);
    IF (VARIABLES.target_id IS NULL ) ERROR VARIABLES.wp_target_id_errorMsg;

    INSERT INTO OpenWorks_SM.TargetOptParm  (wp_project_id , target_id , parameter_name, parameter_value, parameter_value_dsdsunit,remark)
    VALUES (VARIABLES.wp_project_id, VARIABLES.target_id, "NEW".parameter_name, "NEW".parameter_value, "NEW".parameter_value_unit, "NEW".remark);

END;


Create Trigger on TargetOptimizationParameter INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC
/*DECLARE integer VARIABLES.wp_project_id = (SELECT OpenWorks_SM.WellPlanProj.wp_project_id FROM OpenWorks_SM.WellPlanProj WHERE OpenWorks_SM.WellPlanProj.wp_project_name = "OLD".project_name);
DECLARE integer VARIABLES.target_id = (SELECT OpenWorks_SM.Target.target_id FROM OpenWorks_SM.Target WHERE OpenWorks_SM.Target.target_lname = "OLD".target_name and wp_project_id= VARIABLES.wp_project_id); */

  UPDATE OpenWorks_SM.TargetOptParm SET parameter_value = "NEW".parameter_value,parameter_value_dsdsunit="NEW".parameter_value_unit, remark  = "NEW".remark
  WHERE
        native_uid = "OLD".native_uid;

END;

CREATE TRIGGER ON TargetOptimizationParameter INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC
/*DECLARE integer VARIABLES.wp_project_id = (SELECT OpenWorks_SM.WellPlanProj.wp_project_id FROM OpenWorks_SM.WellPlanProj WHERE OpenWorks_SM.WellPlanProj.wp_project_name = "OLD".project_name);
DECLARE integer VARIABLES.target_id = (SELECT OpenWorks_SM.Target.target_id FROM OpenWorks_SM.Target WHERE OpenWorks_SM.Target.target_lname = "OLD".target_name and wp_project_id= VARIABLES.wp_project_id);   */

DELETE FROM OpenWorks_SM.TargetOptParm WHERE native_uid = "OLD".native_uid;
END;

/*
**********************************
*     "WellPlan"
**********************************
*/
CREATE VIEW WellPlan
(
    native_uid                      VARCHAR(1024)       OPTIONS("OpenWorksCommonModel:WellPlan.native_uid.isUpdatable" false,
                                                                "OpenWorksCommonModel:WellPlan.native_uid.isCreatable" false,
                                                                UPDATABLE 'FALSE'),
    wellplanproject_native_uid      VARCHAR(1024) NOT NULL,
    wellplan_site_native_uid        VARCHAR(1024),
    project_name                    VARCHAR(40),
    well_plan_name                  VARCHAR(200) NOT NULL DEFAULT 'UNKNOWN',
    well_plan_version               INTEGER      NOT NULL DEFAULT '0',
    planparameterset_native_uid     VARCHAR(1024),
    plan_parameter_set_name         VARCHAR(40)   DEFAULT 'UNKNOWN' 
                                                        OPTIONS("OpenWorksCommonModel:WellPlan.plan_parameter_set_name.isUpdatable" false,
                                                                "OpenWorksCommonModel:WellPlan.plan_parameter_set_name.isCreatable" false,
                                                                UPDATABLE 'FALSE'),
    wellbore_native_uid             VARCHAR(1024),
    wellbore_uwi                    VARCHAR(26)         OPTIONS("OpenWorksCommonModel:WellPlan.wellbore_uwi.isUpdatable" false,
                                                                "OpenWorksCommonModel:WellPlan.wellbore_uwi.isCreatable" false,
                                                                UPDATABLE 'FALSE'),
    location_type                   INTEGER      DEFAULT '1',
    method_index                    INTEGER      DEFAULT '2',
    platformslot_native_uid         VARCHAR(1024),
    platform_code                   VARCHAR(20)         OPTIONS("OpenWorksCommonModel:WellPlan.platform_code.isUpdatable" false,
                                                                "OpenWorksCommonModel:WellPlan.platform_code.isCreatable" false,
                                                                UPDATABLE 'FALSE'),
    platform_slot_no                VARCHAR(12)         OPTIONS("OpenWorksCommonModel:WellPlan.platform_slot_no.isUpdatable" false,
                                                                "OpenWorksCommonModel:WellPlan.platform_slot_no.isCreatable" false,
                                                                UPDATABLE 'FALSE'),
    tie_pt_x                        DOUBLE              OPTIONS ("OpenWorksCommonModel:WellPlan.tie_pt_x.unitField" 'tie_pt_xy_unit'),
    tie_pt_y                        DOUBLE              OPTIONS ("OpenWorksCommonModel:WellPlan.tie_pt_y.unitField" 'tie_pt_xy_unit'),
    tie_pt_z                        DOUBLE              OPTIONS ("OpenWorksCommonModel:WellPlan.tie_pt_z.unitField" 'tie_pt_z_unit'),
    tie_pt_md                       DOUBLE              OPTIONS ("OpenWorksCommonModel:WellPlan.tie_pt_md.unitField" 'tie_pt_md_unit'),
    tie_pt_xy_unit                  VARCHAR(64),
    tie_pt_crs                      VARCHAR(80),
    tie_pt_z_unit                   VARCHAR(64)         OPTIONS ("OpenWorksCommonModel:WellPlan.tie_pt_z_unit.unitType" 'depth measure'),
    tie_pt_md_unit                  VARCHAR(64)         OPTIONS ("OpenWorksCommonModel:WellPlan.tie_pt_md_unit.unitType" 'depth measure'),
     ground_elevation                FLOAT              OPTIONS ("OpenWorksCommonModel:WellPlan.ground_elevation.unitField"
                                                                'ground_elevation_unit',
                                                                "OpenWorksCommonModel:WellPlan.ground_elevation.isImplemented" false,UPDATABLE 'FALSE'),
    ground_elevation_unit           VARCHAR(64)         OPTIONS ("OpenWorksCommonModel:WellPlan.ground_elevation_unit.unitType" 'elevation',
                                                                "OpenWorksCommonModel:WellPlan.ground_elevation_unit.isImplemented" false,UPDATABLE 'FALSE'),
    parent_wellbore_native_uid      VARCHAR(1024),
    parent_wellplan_native_uid      VARCHAR(1024),
    parent_wellbore_uwi             VARCHAR(26)         OPTIONS("OpenWorksCommonModel:WellPlan.parent_wellbore_uwi.isUpdatable" false,
                                                                "OpenWorksCommonModel:WellPlan.parent_wellbore_uwi.isCreatable" false,
                                                                UPDATABLE 'FALSE'),
    parent_project_name             VARCHAR(40)         OPTIONS("OpenWorksCommonModel:WellPlan.parent_project_name.isUpdatable" false,
                                                                "OpenWorksCommonModel:WellPlan.parent_project_name.isCreatable" false,
                                                                UPDATABLE 'FALSE'),
    parent_plan_name                VARCHAR(200)        OPTIONS("OpenWorksCommonModel:WellPlan.parent_plan_name.isUpdatable" false,
                                                                "OpenWorksCommonModel:WellPlan.parent_plan_name.isCreatable" false,
                                                                UPDATABLE 'FALSE'),
    parent_plan_version             INTEGER       DEFAULT '0'
                                                        OPTIONS("OpenWorksCommonModel:WellPlan.parent_plan_version.isUpdatable" false,
                                                                "OpenWorksCommonModel:WellPlan.parent_plan_version.isCreatable" false,
                                                                UPDATABLE 'FALSE'),
    current_status                  VARCHAR(12),
    input_dogleg_severity           FLOAT               OPTIONS ("OpenWorksCommonModel:WellPlan.input_dogleg_severity.unitField"            'input_dogleg_severity_unit'),
    input_dogleg_severity_unit      VARCHAR(64)         OPTIONS ("OpenWorksCommonModel:WellPlan.input_dogleg_severity_unit.unitType"        'curvature'),
    input_hole_extension            FLOAT               OPTIONS ("OpenWorksCommonModel:WellPlan.input_hole_extension.unitField"             'input_hole_extension_unit'),
    input_hole_extension_unit       VARCHAR(64)         OPTIONS ("OpenWorksCommonModel:WellPlan.input_hole_extension_unit.unitType"         'depth measure'),
    auxiliary_dogleg_severity       FLOAT               OPTIONS ("OpenWorksCommonModel:WellPlan.auxiliary_dogleg_severity.unitField"        'auxiliary_dogleg_severity_unit',
                                                                "OpenWorksCommonModel:WellPlan.auxiliary_dogleg_severity.isImplemented" false,UPDATABLE 'FALSE'),
    auxiliary_dogleg_severity_unit  VARCHAR(64)         OPTIONS ("OpenWorksCommonModel:WellPlan.auxiliary_dogleg_severity_unit.unitType"
                                                                'curvature',
                                                                "OpenWorksCommonModel:WellPlan.auxiliary_dogleg_severity_unit.isImplemented" false,UPDATABLE 'FALSE'),
    remark                          VARCHAR(200),
    create_date                     TIMESTAMP           OPTIONS("OpenWorksCommonModel:WellPlan.create_date.isUpdatable" false,
                                                                "OpenWorksCommonModel:WellPlan.create_date.isCreatable" false,UPDATABLE 'FALSE'),
    create_user_id                  VARCHAR(32)         OPTIONS("OpenWorksCommonModel:WellPlan.create_user_id.isUpdatable" false,
                                                                "OpenWorksCommonModel:WellPlan.create_user_id.isCreatable" false,UPDATABLE 'FALSE'),
    update_date                     TIMESTAMP           OPTIONS("OpenWorksCommonModel:WellPlan.update_date.isUpdatable" false,
                                                                "OpenWorksCommonModel:WellPlan.update_date.isCreatable" false,UPDATABLE 'FALSE'),
    update_user_id                  VARCHAR(32)         OPTIONS("OpenWorksCommonModel:WellPlan.update_user_id.isUpdatable" false,
                                                                "OpenWorksCommonModel:WellPlan.update_user_id.isCreatable" false,UPDATABLE 'FALSE'),
    alternate_uid    		        VARCHAR(4000)       OPTIONS ("OpenWorksCommonModel:WellPlan.alternate_uid.isCreatable" false,
                                                                "OpenWorksCommonModel:WellPlan.alternate_uid.isUpdatable" false,
                                                                UPDATABLE 'FALSE'),

    data                            BLOB,

    CONSTRAINT WellPlan_PK PRIMARY KEY (native_uid),

    CONSTRAINT WellPlan_UK1 UNIQUE (wellplanproject_native_uid, well_plan_name, well_plan_version, wellbore_native_uid),

    CONSTRAINT FK_WellPlan_wellbore_native_uid
        FOREIGN KEY        (wellbore_native_uid)
        REFERENCES PlannedWellbore(native_uid),

    -- CONSTRAINT FK_WellPlan_parent_wellbore_native_uid
    --     FOREIGN KEY        (parent_wellbore_native_uid)
    --     REFERENCES PlannedWellbore(native_uid),

    CONSTRAINT FK_WellPlan_wellplanproject_native_uid
        FOREIGN KEY               (wellplanproject_native_uid)
        REFERENCES WellPlanProject(native_uid),

    CONSTRAINT FK_WellPlan_wellplan_site_native_uid
        FOREIGN KEY               (wellplan_site_native_uid)
        REFERENCES WellPlanSite(native_uid),

    CONSTRAINT FK_WellPlan_parent_wellplan_native_uid
        FOREIGN KEY        (parent_wellplan_native_uid)
        REFERENCES WellPlan(native_uid),

    CONSTRAINT FK_WellPlan_planparameterset_native_uid
        FOREIGN KEY                (planparameterset_native_uid)
        REFERENCES PlanParameterSet(native_uid),

    CONSTRAINT FK_WellPlan_platformslot_native_uid
        FOREIGN KEY            (platformslot_native_uid)
        REFERENCES PlatformSlot(native_uid),

    CONSTRAINT FK_WellPlan_tie_pt_crs
        FOREIGN KEY                    (tie_pt_crs)
        REFERENCES CartoReferenceSystem(name)
)
OPTIONS (UPDATABLE 'TRUE', WellPlan.IMPLEMENTED 'TRUE')
AS
SELECT
    WP.well_plan_id as native_uid,
    WPP.wp_project_id,
    wplan.platform_native_uid,
    WPP.wp_project_name,
    WP.well_plan_name,
    cast(WP.well_plan_version AS integer),
    planParam.plan_parm_set_id,
    WP.plan_parm_set_name,
    wplan.wellbore_native_uid,
    null,
    WP.location_type,
    WP.method_index,
    platSlot.native_uid,
    WP.platform_code,
    WP.platform_slot_no,
    TP.x AS tie_pt_x,
    TP.y AS tie_pt_y,
    TP.z AS tie_pt_z,
    TP.measured_depth AS tie_pt_md,
    proj.min_x_dsdsunit AS tie_pt_xy_unit,
    getDSDSCrs(carto.name) AS tie_pt_crs,
    TP.z_dsdsunit AS tie_pt_z_unit,
    TP.measured_depth_dsdsunit AS tie_pt_md_unit,
    null AS ground_elevation,
    null AS ground_elevation_unit,
    null,
    wplan.parent_well_plan_id,
    null,
    WPP.wp_project_name,
    null,
    cast(0 AS integer),
    WP.current_status,
    WP.input_dogleg_severity,
    WP.input_dogleg_severity_dsdsunit,
    WP.input_hole_extension,
    WP.input_hole_extension_dsdsunit,
    null,
    null,
    WP.remark,
    WP.create_date,
    WP.create_user_id,
    WP.update_date,
    WP.update_user_id,
    WP.native_uid,
	WP.data as data
    from (
      WITH wellplanwithwb (native_uid,wellbore_native_uid,parent_well_plan_id,location_type,parent_location_type,platform_native_uid) AS 
	  (
       select native_uid,wellbore_native_uid,null,location_type,parent_location_type,platform_native_uid from tmpwellplanview
        union 
       select wp.well_plan_id as native_uid,wp.well_plan_id as wellbore_native_uid,wp.sidetrack_plan_id as parent_well_plan_id,wp.location_type,wellplanwithwb.location_type,wellplanwithwb.platform_native_uid
       from openworks_SM.wellplan wp inner join wellplanwithwb on wp.sidetrack_plan_id=wellplanwithwb.native_uid and wp.location_type=3
      ) -- WITH wellplanwithwb
      select native_uid,wellbore_native_uid,parent_well_plan_id,location_type,parent_location_type,platform_native_uid from wellplanwithwb
       union
      select wp1.well_plan_id  as native_uid,wp2.well_plan_id as wellbore_native_uid,null as parent_well_plan_id,wp1.location_type as location_type,wp2.location_type as parent_location_type,null as platform_native_uid 
       from openworks_SM.wellplan wp1 left join openworks_SM.wellplan wp2 on wp1.sidetrack_plan_id=wp2.well_plan_id where wp1.location_type=2 and wp2.location_type=5 and wp2.current_well_id is not null 
    ) wplan
    inner join OpenWorks_SM.WellPlan WP on wplan.native_uid=WP.well_plan_id
    INNER JOIN OpenWorks_SM.Project proj ON 1 = 1
    INNER JOIN OpenWorks_SM.CartoRefSys carto ON carto.id = proj.xy_crs_id
    LEFT OUTER JOIN OpenWorks_SM.WellEntire WE ON WP.current_well_id = WE.wellid
    LEFT OUTER JOIN OpenWorks_SM.WellEntire WESideTrack  ON WP.sidetrack_well_id = WESideTrack.wellid
    LEFT OUTER JOIN   OpenWorks_SM.WellPlanProj WPP ON WP.wp_project_id = WPP.wp_project_id
    INNER JOIN OpenWorks_SM.TurnPoint TP ON WP.well_plan_id = TP.well_plan_id AND TP.turn_point_seq_no = 0
    LEFT OUTER JOIN OpenWorks_SM.PlanParameterSet planParam ON WP.plan_parm_set_name = planParam.plan_parm_set_name
    LEFT OUTER JOIN OpenWorks_SM.PlatformSlot platSlot  ON  WP.platform_code  = platSlot.platform_code;

CREATE TRIGGER ON WellPlan INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC

    DECLARE string VARIABLES.current_well_id_errorMsg='ERROR: Wellbore_native_uid ' || "NEW".wellbore_native_uid || 'does not exist';
    DECLARE string VARIABLES.parent_well_id_errorMsg='ERROR: Parent Wellbore_uid ' || "NEW".parent_wellbore_native_uid || 'does not exist';
    DECLARE string VARIABLES.parent_plan_id_errorMsg='ERROR: The Parent WellPlan does not exist';
    DECLARE string VARIABLES.plan_parameter_set_name_errorMsg='ERROR: PlanParameterSet with given value for native_uid' || "NEW".planparameterset_native_uid || 'does not exist';

    DECLARE STRING VARIABLES.parent_plan_id;
    DECLARE INTEGER VARIABLES.location_type = 1;
    
    DECLARE INTEGER VARIABLES.well_plan_id = (SELECT CONVERT(well_plan_id, INTEGER) from OpenWorks_SM.WellPlan  where well_plan_id= "NEW".wellbore_native_uid LIMIT 1);
        
    IF("NEW".parent_wellplan_native_uid IS NOT NULL)
    BEGIN
        VARIABLES.parent_plan_id = (SELECT well_plan_id from OpenWorks_SM.WellPlan  where well_plan_id= "NEW".parent_wellplan_native_uid);
    END

    IF(VARIABLES.parent_plan_id IS NULL)
    BEGIN
        IF("NEW".wellplan_site_native_uid IS NOT NULL)
        BEGIN
            VARIABLES.parent_plan_id = (SELECT well_plan_id from OpenWorks_SM.WellPlan  where well_plan_id= "NEW".wellplan_site_native_uid);
            IF(VARIABLES.parent_plan_id IS NULL )
                ERROR 'WellPlanSite: ' || "NEW".wellplan_site_native_uid || ' ' || VARIABLES.parent_plan_id_errorMsg;
            VARIABLES.location_type = 8;
        END
    END
    ELSE
    BEGIN
        VARIABLES.location_type = 3;
    END

    IF(VARIABLES.well_plan_id IS NOT NULL)
    BEGIN
        LOOP ON (SELECT well_plan_id FROM OpenWorks_SM.WellPlan WHERE well_plan_name = "NEW".well_plan_name AND wp_project_id ="NEW".wellplanproject_native_uid ORDER BY well_plan_id) AS idCursor
        BEGIN
            UPDATE OpenWorks_SM.WellPlan
            SET well_plan_version = well_plan_version - 1
            WHERE native_uid = idCursor.well_plan_id;
        END
        DECLARE string VARIABLES.targetCRS = (Select name from OpenWorks_SM.CartoRefSys,OpenWorks_SM.Project where OpenWorks_SM.CartoRefSys.id = OpenWorks_SM.Project.xy_crs_id);
        DECLARE blob   VARIABLES.data = null;
        IF("NEW".data IS NOT NULL)
        BEGIN
            DECLARE STRING VARIABLES.sourceCRS = getCrsNameFromBlob("NEW".data);
            VARIABLES.data = cartoConvertXYInBlob(getDSDSCrs(VARIABLES.sourceCRS), VARIABLES.targetCrs, "NEW".data, null);
			delete from OpenWorks_SM.TurnPoint where well_plan_id=VARIABLES.well_plan_id;
            UPDATE OpenWorks_SM.WellPlan
            SET well_plan_name = "NEW".well_plan_name, 
                well_plan_lname = "NEW".well_plan_name,
                location_type = VARIABLES.location_type,
                sidetrack_plan_id = VARIABLES.parent_plan_id,
				wp_project_id = "NEW".wellplanproject_native_uid,
                data = VARIABLES.data
            WHERE native_uid = VARIABLES.well_plan_id;
        END
        ELSE
        BEGIN
            UPDATE OpenWorks_SM.WellPlan
            SET well_plan_name = "NEW".well_plan_name, 
                well_plan_lname = "NEW".well_plan_name,
                location_type = VARIABLES.location_type,
                sidetrack_plan_id = VARIABLES.parent_plan_id
            WHERE native_uid = VARIABLES.well_plan_id;
        END
    END
    ELSE
    BEGIN
        VARIABLES.well_plan_id = (SELECT * FROM (EXEC OpenWorks_SM.nextval('WellPlan')) AS SysGenID);
            
        DECLARE string VARIABLES.wp_project_id        = (SELECT OpenWorks_SM.WellPlanProj.wp_project_id FROM OpenWorks_SM.WellPlanProj WHERE OpenWorks_SM.WellPlanProj.wp_project_id = "NEW".wellplanproject_native_uid);

        DECLARE string VARIABLES.targetCRS = (Select name from OpenWorks_SM.CartoRefSys,OpenWorks_SM.Project where OpenWorks_SM.CartoRefSys.id = OpenWorks_SM.Project.xy_crs_id);
        DECLARE blob   VARIABLES.data = null;

        IF("NEW".data IS NOT NULL)
        BEGIN
            DECLARE STRING VARIABLES.sourceCRS = getCrsNameFromBlob("NEW".data);
            VARIABLES.data = cartoConvertXYInBlob(getDSDSCrs(VARIABLES.sourceCRS), VARIABLES.targetCrs, "NEW".data, null);
        END

        DECLARE string VARIABLES.plan_parameter_set_name;
        IF("NEW".planparameterset_native_uid is NOT NULL)
        BEGIN
            VARIABLES.plan_parameter_set_name = (SELECT plan_parm_set_name from OpenWorks_SM.PlanParameterSet where plan_parm_set_id = "NEW".planparameterset_native_uid);
            IF(VARIABLES.plan_parameter_set_name  IS NULL) ERROR VARIABLES.plan_parameter_set_name_errorMsg;
        END

        DECLARE string VARIABLES.platform_code;
        DECLARE string VARIABLES.slot_no;
        IF("NEW".platformslot_native_uid IS NOT NULL)
        BEGIN
            INSERT INTO #TmpTbl (#TmpTbl.platform_code, #TmpTbl.slot_no) SELECT platform_code,slot_no FROM OpenWorks_SM.PlatformSlot where native_uid = "NEW".platformslot_native_uid;
            VARIABLES.platform_code = (select #TmpTbl.platform_code from #TmpTbl);
            VARIABLES.slot_no = (select #TmpTbl.slot_no from #TmpTbl);
        END

        DECLARE double VARIABLES.X;
        DECLARE double VARIABLES.Y;
        DECLARE string VARIABLES.XYUnit;
        IF(("NEW".tie_pt_x is NOT NULL) AND ("NEW".tie_pt_y is NOT NULL) AND ("NEW".tie_pt_xy_unit is NOT NULL) AND ("NEW".tie_pt_crs is NOT NULL))
        BEGIN
            VARIABLES.X = "NEW".tie_pt_x;
            VARIABLES.Y = "NEW".tie_pt_y;
            VARIABLES.XYUnit = "NEW".tie_pt_xy_unit;
            DECLARE blob convertedXYBlob = select cartoConvert("NEW".tie_pt_crs,VARIABLES.targetCRS,VARIABLES.X,VARIABLES.Y,VARIABLES.XYUnit);
            IF(convertedXYBlob IS NOT NULL)
            BEGIN
                VARIABLES.X= fetchDElementValueFromBlob(convertedXYBlob,'x');
                VARIABLES.Y= fetchDElementValueFromBlob(convertedXYBlob,'y');
                VARIABLES.XYUnit= fetchElementUnitNameFromBlob(convertedXYBlob,'x');
            END
        END
        ELSE
        BEGIN
            IF("NEW".wellbore_native_uid is NOT NULL)
            BEGIN
                INSERT INTO #TmpTbl1 (#TmpTbl1.x, #TmpTbl1.y) SELECT x_coordinate,y_coordinate  FROM OpenWorks_SM.WellEntire WHERE OpenWorks_SM.WellEntire.wellid = "NEW".wellbore_native_uid;
                VARIABLES.X = (select #TmpTbl1.x from #TmpTbl1);
                VARIABLES.Y = (select #TmpTbl1.y from #TmpTbl1);
            END
        END
        
        INSERT INTO OpenWorks_SM.WellPlan
        (well_plan_id,wp_project_id, plan_parm_set_name, well_plan_lname, well_plan_name, well_plan_version, location_type, method_index, platform_code, platform_slot_no , sidetrack_plan_id,current_status, input_dogleg_severity, input_dogleg_severity_dsdsunit, input_hole_extension , input_hole_extension_dsdsunit, remark, data)
        VALUES
        (VARIABLES.well_plan_id,VARIABLES.wp_project_id, VARIABLES.plan_parameter_set_name, "NEW".well_plan_name,  "NEW".well_plan_name, "NEW".well_plan_version, VARIABLES.location_type, "NEW".method_index,VARIABLES.platform_code, VARIABLES.slot_no , VARIABLES.parent_plan_id,"New".current_status, "New".input_dogleg_severity, "New".input_dogleg_severity_unit, "New".input_hole_extension , "New".input_hole_extension_unit, "New".remark, VARIABLES.data);

        IF((VARIABLES.X is NOT NULL) AND (VARIABLES.Y is NOT NULL))
        BEGIN
            INSERT INTO OpenWorks_SM.TurnPoint
                (well_plan_id,turn_point_seq_no,wp_project_id, well_plan_meth_cd,measured_depth, measured_depth_dsdsunit, dogleg_severity, dogleg_severity_dsdsunit,
                x, y, z, z_dsdsunit, inclination_angle, azimuth_angle)
            VALUES
                (VARIABLES.well_plan_id,-1, VARIABLES.wp_project_id ,0, "NEW".tie_pt_md, "NEW".tie_pt_md_unit, "NEW".input_dogleg_severity, "NEW".input_dogleg_severity_unit,
                VARIABLES.X, VARIABLES.Y, "NEW".tie_pt_z, "NEW".tie_pt_z_unit, 0, 0 );
        END

    END
	  DECLARE STRING VARIABLES.interval_text  = CONVERT(XMLELEMENT("INTERVAL_DATA",
        XMLATTRIBUTES(1 AS "DISPLAY_TYPE", NVL("NEW".ground_elevation, 0) AS "GROUND_LEVEL", 2 AS "LINE_WEIGHT", 'Planned' AS "STATUS",'true' AS "VISIBLE")), STRING);

        INSERT INTO OpenWorks_SM.WellPlanInterval ("well_plan_id","wp_project_id","wp_interval_type","occurrence_no","top_depth","top_depth_dsdsunit","base_depth","base_depth_dsdsunit","interval_text","remark")
        VALUES (VARIABLES.well_plan_id, "NEW".wellplanproject_native_uid, 'PROPERTIES', 1, 0, 'feet', 0, 'feet',
        VARIABLES.interval_text, 'WellPlan');
END;

CREATE TRIGGER ON WellPlan INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC

    DECLARE string VARIABLES.current_well_id_errorMsg='ERROR: The given value for wellbore_uwi does not exist';
    DECLARE string VARIABLES.parent_well_id_errorMsg='ERROR: The given value for parent_wellbore_uwi does not exist';
    DECLARE string VARIABLES.parent_plan_id_errorMsg='ERROR: The  Parent WellPlan for given value does not exist';
    DECLARE string VARIABLES.plan_parameter_set_name_errorMsg='ERROR: PlanParameterSet with given value for native_uid' || "NEW".planparameterset_native_uid || 'does not exist';
    DECLARE string VARIABLES.wp_project_id = (SELECT OpenWorks_SM.WellPlanProj.wp_project_id FROM OpenWorks_SM.WellPlanProj WHERE OpenWorks_SM.WellPlanProj.wp_project_id = "OLD".wellplanproject_native_uid);

    DECLARE string VARIABLES.current_well_id;
    DECLARE string VARIABLES.parent_well_id;
    DECLARE string VARIABLES.parent_project_id;
    DECLARE string VARIABLES.parent_plan_id;


    DECLARE string VARIABLES.plan_parameter_set_name;
    IF("NEW".planparameterset_native_uid is NOT NULL)
    BEGIN
        VARIABLES.plan_parameter_set_name = (SELECT plan_parm_set_name from OpenWorks_SM.PlanParameterSet where plan_parm_set_id = "NEW".planparameterset_native_uid);

    IF(VARIABLES.plan_parameter_set_name  IS NULL) ERROR VARIABLES.plan_parameter_set_name_errorMsg;

    END

    IF("NEW".parent_wellplan_native_uid IS NOT NULL)
    BEGIN
        VARIABLES.parent_plan_id = (SELECT well_plan_id from OpenWorks_SM.WellPlan  where well_plan_id= "NEW".parent_wellplan_native_uid);
    END

    DECLARE INTEGER VARIABLES.location_type = 1;

    IF(VARIABLES.parent_plan_id IS NULL)
    BEGIN
        IF("NEW".wellplan_site_native_uid IS NOT NULL)
        BEGIN
            VARIABLES.parent_plan_id = (SELECT well_plan_id from OpenWorks_SM.WellPlan  where well_plan_id= "NEW".wellplan_site_native_uid);
            IF(VARIABLES.parent_plan_id IS NULL )
                ERROR 'WellPlanSite: ' || "NEW".wellplan_site_native_uid || ' ' || VARIABLES.parent_plan_id_errorMsg;
            VARIABLES.location_type = 8;
        END
    END
    ELSE
    BEGIN
        VARIABLES.location_type = 3;
    END

    UPDATE OpenWorks_SM.WellPlan SET wp_project_id=VARIABLES.wp_project_id,plan_parm_set_name=VARIABLES.plan_parameter_set_name,current_well_id=VARIABLES.current_well_id ,well_plan_name= "NEW".well_plan_name,location_type=VARIABLES.location_type,method_index="NEW".method_index,platform_code="New".platform_code,platform_slot_no="NEW".platform_slot_no,sidetrack_well_id=VARIABLES.parent_well_id ,sidetrack_plan_id=VARIABLES.parent_plan_id,current_status="New".current_status,input_dogleg_severity="New".input_dogleg_severity,input_dogleg_severity_dsdsunit= "New".input_dogleg_severity_unit,input_hole_extension="New".input_hole_extension,input_hole_extension_dsdsunit= "New".input_hole_extension_unit,remark= "New".remark WHERE OpenWorks_SM.WellPlan.well_plan_id ="OLD".native_uid;

    DECLARE string VARIABLES.targetCRS = (Select name from OpenWorks_SM.CartoRefSys,OpenWorks_SM.Project where OpenWorks_SM.CartoRefSys.id = OpenWorks_SM.Project.xy_crs_id);
    
    IF("NEW".data IS NOT NULL)
    BEGIN
        DECLARE STRING VARIABLES.sourceCRS = getCrsNameFromBlob("NEW".data);

        DECLARE blob VARIABLES.data = cartoConvertXYInBlob(getDSDSCrs(VARIABLES.sourceCRS), VARIABLES.targetCRS, "NEW".data, null);
		
		delete from OpenWorks_SM.TurnPoint where well_plan_id="OLD".native_uid and turn_point_seq_no=-1;
        UPDATE OpenWorks_SM.WellPlan
        SET data = VARIABLES.data
        WHERE native_uid = "OLD".native_uid;
    END

    IF ((CHANGING.tie_pt_x) OR (CHANGING.tie_pt_y) OR (CHANGING.tie_pt_xy_unit) OR (CHANGING.tie_pt_md) OR (CHANGING.tie_pt_md_unit) OR (CHANGING.tie_pt_z) OR (CHANGING.tie_pt_z_unit))
    BEGIN
        DECLARE double VARIABLES.X = "NEW".tie_pt_x;
        DECLARE double VARIABLES.Y = "NEW".tie_pt_y;
        DECLARE string VARIABLES.XYUnit = "NEW".tie_pt_xy_unit;
        DECLARE blob convertedXYBlob = select cartoConvert("NEW".tie_pt_crs,VARIABLES.targetCRS,VARIABLES.X,VARIABLES.Y,VARIABLES.XYUnit);
        IF(convertedXYBlob IS NOT NULL)
        BEGIN
            VARIABLES.X= fetchDElementValueFromBlob(convertedXYBlob,'x');
            VARIABLES.Y= fetchDElementValueFromBlob(convertedXYBlob,'y');
            VARIABLES.XYUnit= fetchElementUnitNameFromBlob(convertedXYBlob,'x');
        END

        UPDATE OpenWorks_SM.TurnPoint
        SET measured_depth = "NEW".tie_pt_md,
            measured_depth_dsdsunit = "NEW".tie_pt_md_unit,
            dogleg_severity = "NEW".input_dogleg_severity,
            dogleg_severity_dsdsunit = "NEW".input_dogleg_severity_unit,
            x = VARIABLES.X,
            y = VARIABLES.Y,
            z = "NEW".tie_pt_z,
            z_dsdsunit = "NEW".tie_pt_z_unit
        WHERE well_plan_id="OLD".native_uid and turn_point_seq_no=-1;
    END

    DECLARE STRING VARIABLES.wpi_id = (SELECT native_uid FROM OpenWorks_SM.WellPlanInterval WHERE well_plan_id = "OLD".native_uid
    AND wp_project_id = "OLD".wellplanproject_native_uid AND wp_interval_type = 'PROPERTIES');

    DECLARE STRING VARIABLES.interval_text  = CONVERT(XMLELEMENT("INTERVAL_DATA",
    XMLATTRIBUTES(1 AS "DISPLAY_TYPE", NVL("NEW".ground_elevation, 0) AS "GROUND_LEVEL", 2 AS "LINE_WEIGHT", 'Planned' As "STATUS",'true' AS "VISIBLE")), STRING);

    IF(VARIABLES.wpi_id IS NOT NULL)
    BEGIN
        UPDATE OpenWorks_SM.WellPlanInterval
        SET interval_text = VARIABLES.interval_text
        WHERE native_uid = VARIABLES.wpi_id;
    END
    ELSE
    BEGIN
        INSERT INTO OpenWorks_SM.WellPlanInterval ("well_plan_id","wp_project_id","wp_interval_type","occurrence_no","top_depth","top_depth_dsdsunit","base_depth","base_depth_dsdsunit","interval_text","remark")
        VALUES ("OLD".native_uid, "OLD".wellplanproject_native_uid, 'PROPERTIES', 1, 0, 'feet', 0, 'feet',
        VARIABLES.interval_text, 'WellPlan');
    END
END;


CREATE TRIGGER ON WellPlan INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC
   DELETE FROM OpenWorks_SM.TurnPoint WHERE well_plan_id = "OLD".native_uid;
   DELETE FROM OpenWorks_SM.WellPlan WHERE  OpenWorks_SM.WellPlan.well_plan_id ="OLD".native_uid;
END;

/*
**********************************
*     "PlanParameterSet"
**********************************
*/

CREATE VIEW PlanParameterSet
(
 native_uid              VARCHAR(1024)  OPTIONS("OpenWorksCommonModel:PlanParameterSet.native_uid.isUpdatable" false,
                                                "OpenWorksCommonModel:PlanParameterSet.native_uid.isCreatable" false,
                                                 UPDATABLE 'FALSE'),
 plan_parameter_set_name VARCHAR(40) NOT NULL Default 'UNKNOWN',
 remark                  VARCHAR(200),
 create_date             TIMESTAMP   OPTIONS ("OpenWorksCommonModel:PlanParameterSet.create_date.isUpdatable" false,
                                             "OpenWorksCommonModel:PlanParameterSet.create_date.isCreatable" false,UPDATABLE 'FALSE'),
 create_user_id          VARCHAR(32) OPTIONS ("OpenWorksCommonModel:PlanParameterSet.create_user_id.isUpdatable" false,
                                              "OpenWorksCommonModel:PlanParameterSet.create_user_id.isCreatable" false,UPDATABLE 'FALSE'),
 update_date             TIMESTAMP      OPTIONS ("OpenWorksCommonModel:PlanParameterSet.update_date.isUpdatable" false,
                                             "OpenWorksCommonModel:PlanParameterSet.update_date.isCreatable" false,UPDATABLE 'FALSE'),
 update_user_id          VARCHAR(32)    OPTIONS ("OpenWorksCommonModel:PlanParameterSet.update_user_id.isUpdatable" false,
                                             "OpenWorksCommonModel:PlanParameterSet.update_user_id.isCreatable" false,UPDATABLE 'FALSE'),
 alternate_uid    		     VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:PlanParameterSet.alternate_uid.isCreatable" false,
                                                "OpenWorksCommonModel:PlanParameterSet.alternate_uid.isUpdatable" false,
                                                 UPDATABLE 'FALSE'),


  CONSTRAINT PlanParameterSet_PK PRIMARY KEY (native_uid),

  CONSTRAINT PlanParameterSet_UK1 UNIQUE (plan_parameter_set_name)

)
OPTIONS (UPDATABLE 'TRUE',  PlanParameterSet.IMPLEMENTED 'TRUE')
AS
SELECT
        OpenWorks_SM.PlanParameterSet.plan_parm_set_id,
        OpenWorks_SM.PlanParameterSet.plan_parm_set_name,
        OpenWorks_SM.PlanParameterSet.remark,
        OpenWorks_SM.PlanParameterSet.create_date,
        OpenWorks_SM.PlanParameterSet.create_user_id,
        OpenWorks_SM.PlanParameterSet.update_date,
        OpenWorks_SM.PlanParameterSet.update_user_id,
        OpenWorks_SM.PlanParameterSet.native_uid
FROM
        OpenWorks_SM.PlanParameterSet;


CREATE TRIGGER ON PlanParameterSet INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC

INSERT INTO OpenWorks_SM.PlanParameterSet(plan_parm_set_name,remark) values ("NEW".plan_parameter_set_name,"NEW".remark);

END;

CREATE TRIGGER ON PlanParameterSet INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC

UPDATE OpenWorks_SM.PlanParameterSet SET remark="NEW".remark where plan_parm_set_name="OLD".plan_parameter_set_name;

END;

CREATE TRIGGER ON PlanParameterSet INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC
DELETE FROM OpenWorks_SM.PlanParameterSet where plan_parm_set_name="OLD".plan_parameter_set_name;

END;


/*
**********************************
*     "PlatformSlot"
**********************************
*/


CREATE VIEW PlatformSlot
(
  native_uid             VARCHAR(1024)OPTIONS("OpenWorksCommonModel:PlatformSlot.native_uid.isUpdatable" false,
                                             "OpenWorksCommonModel:PlatformSlot.native_uid.isCreatable" false,
                                              UPDATABLE 'FALSE'),
  platform_native_uid    VARCHAR(1024) NOT NULL,
  platform_code          VARCHAR(20) OPTIONS("OpenWorksCommonModel:PlatformSlot.platform_code.isUpdatable" false,
                                            "OpenWorksCommonModel:PlatformSlot.platform_code.isCreatable" false,
                                             UPDATABLE 'FALSE'),
  slot_no                VARCHAR(12) NOT NULL,
  location_type          VARCHAR(12),
  x_offset               DOUBLE      OPTIONS ("OpenWorksCommonModel:PlatformSlot.x_offset.unitField" 'xy_offset_unit'),
  y_offset               DOUBLE      OPTIONS ("OpenWorksCommonModel:PlatformSlot.y_offset.unitField" 'xy_offset_unit'),
  xy_offset_unit         VARCHAR(64) OPTIONS ("OpenWorksCommonModel:PlatformSlot.xy_offset_unit.unitType" 'distance ft or m'),
  offset_north_reference VARCHAR(12),
  offset_unit            VARCHAR(64),
  x_coordinate           DOUBLE      OPTIONS ("OpenWorksCommonModel:PlatformSlot.x_coordinate.unitField" 'xy_unit'),
  y_coordinate           DOUBLE      OPTIONS ("OpenWorksCommonModel:PlatformSlot.y_coordinate.unitField" 'xy_unit'),
  xy_unit                VARCHAR(64),
  crs                    VARCHAR(80),
  remark                 VARCHAR(200),
  create_date            TIMESTAMP   OPTIONS("OpenWorksCommonModel:PlatformSlot.create_date.isUpdatable" false,
                                             "OpenWorksCommonModel:PlatformSlot.create_date.isCreatable" false,UPDATABLE 'FALSE'),
  create_user_id         VARCHAR(32) OPTIONS("OpenWorksCommonModel:PlatformSlot.create_user_id.isUpdatable" false,
                                             "OpenWorksCommonModel:PlatformSlot.create_user_id.isCreatable" false,UPDATABLE 'FALSE'),
  update_date            TIMESTAMP   OPTIONS("OpenWorksCommonModel:PlatformSlot.update_date.isUpdatable" false,
                                             "OpenWorksCommonModel:PlatformSlot.update_date.isCreatable" false,UPDATABLE 'FALSE'),
  update_user_id         VARCHAR(32) OPTIONS("OpenWorksCommonModel:PlatformSlot.update_user_id.isUpdatable" false,
                                             "OpenWorksCommonModel:PlatformSlot.update_user_id.isCreatable" false,UPDATABLE 'FALSE'),
  alternate_uid    		     VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:PlatformSlot.alternate_uid.isCreatable" false,
                                                "OpenWorksCommonModel:PlatformSlot.alternate_uid.isUpdatable" false,
                                                 UPDATABLE 'FALSE'),

 CONSTRAINT PlatformSlot_PK PRIMARY KEY (native_uid),

 CONSTRAINT PlatformSlot_UK1 UNIQUE (platform_native_uid, slot_no),

 CONSTRAINT FK_PlatformSlot_crs
        FOREIGN KEY                    (crs)
        REFERENCES CartoReferenceSystem(name),

    CONSTRAINT FK_PlatformSlot_platform_native_uid
        FOREIGN KEY        (platform_native_uid)
        REFERENCES Platform(native_uid)

)
  OPTIONS (UPDATABLE 'TRUE',  PlatformSlot.IMPLEMENTED 'TRUE')
    AS
        SELECT
       ps.native_uid,
       ptInfo.platform_code,
       ps.platform_code,
       ps.slot_no,
       ps.location_type,
       ps.x_offset,
       ps.y_offset,
       COALESCE(ps.x_offset_dsdsunit,ps.y_offset_dsdsunit),
       ps.offset_north_ref,
      (select abbrev  from Openworks_SM.MeasurementUnit where id=ps.offset_unit) as offset_unit,
       ps.original_x,
       ps.original_y,
       COALESCE(ps.original_x_dsdsunit,ps.original_y_dsdsunit),
       getDSDSCrs(c.name) as crs,
       ps.remark, ps.create_date, ps.create_user_id, ps.update_date, ps.update_user_id,
	   ps.native_uid
FROM
      (OpenWorks_SM.PlatformSlot ps LEFT OUTER JOIN Openworks_SM.cartoRefSys c ON ps.original_crs_id = c.id), OpenWorks_SM.PlatformInfo ptInfo
WHERE
   ps.platform_code = ptInfo.platform_code;


CREATE TRIGGER ON PlatformSlot INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC


     DECLARE string VARIABLES.crs_errorMsg='ERROR: The given value for crs does not exist';
     DECLARE string VARIABLES.platform_code_errorMsg='ERROR: The given value platform_native_uid does not exist';
     DECLARE string VARIABLES.offset_unit_id_errorMsg='ERROR: The given value offset_unit does not exist';
     DECLARE string VARIABLES.crs_id;
     DECLARE string VARIABLES.offset_unit_id ;

     IF("NEW".crs is NOT NULL)
     BEGIN
       VARIABLES.crs_id    = (SELECT id FROM OpenWorks_SM.CartoRefSys WHERE name = (SELECT * FROM (EXEC OpenWorks_SM.GetNativeCRS("NEW".crs, 'OW')) AS SysGenID));
       IF(VARIABLES.crs_id is NULL) ERROR VARIABLES.crs_errorMsg;
     END

     IF("NEW".offset_unit is NOT NULL)
     BEGIN
       VARIABLES.offset_unit_id=   (select id  from Openworks_SM.MeasurementUnit where abbrev="NEW".offset_unit);
       IF(VARIABLES.offset_unit_id is NULL) ERROR VARIABLES.offset_unit_id_errorMsg;
     END

    DECLARE string VARIABLES.platform_code = (select platform_code from Openworks_SM.PlatformInfo where platform_code="NEW".platform_code);
    IF(VARIABLES.platform_code is NULL) ERROR platform_code_errorMsg;


    INSERT INTO OpenWorks_SM.PlatformSlot(platform_code,slot_no,location_type,x_offset,y_offset,x_offset_dsdsunit,y_offset_dsdsunit,offset_north_ref,offset_unit,original_x,original_y,original_crs_id,remark) VALUES(VARIABLES.platform_code,"NEW.slot_no","NEW".location_type,"NEW".x_offset,"NEW".y_offset,"NEW".xy_offset_unit,"NEW".xy_offset_unit,"NEW".offset_north_reference,offset_unit_id,"NEW".x_coordinate,"NEW".y_coordinate,VARIABLES.crs_id,"NEW".remark);

END;

CREATE TRIGGER ON PlatformSlot INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC

DECLARE string VARIABLES.crs_errorMsg='ERROR: The given value for crs does not exist';
   DECLARE string VARIABLES.offset_unit_id_errorMsg='ERROR: The given value offset_unit does not exist';
     DECLARE string VARIABLES.crs_id;
     DECLARE string VARIABLES.offset_unit_id ;
   IF("NEW".crs is NOT NULL)
   BEGIN
     VARIABLES.crs_id = (SELECT id FROM OpenWorks_SM.CartoRefSys WHERE name = (SELECT * FROM (EXEC OpenWorks_SM.GetNativeCRS("NEW".crs, 'OW')) AS SysGenID));
     IF(VARIABLES.crs_id is NULL) ERROR VARIABLES.crs_errorMsg;
   END

   IF("NEW".offset_unit is NOT NULL)
   BEGIN
     VARIABLES.offset_unit_id=   (select id  from Openworks_SM.MeasurementUnit where abbrev="NEW".offset_unit);
     IF(VARIABLES.offset_unit_id is NULL) ERROR VARIABLES.offset_unit_id_errorMsg;
   END

UPDATE OpenWorks_SM.PlatformSlot SET location_type="NEW".location_type,x_offset="NEW".x_offset,y_offset="NEW".y_offset,x_offset_dsdsunit="NEW".xy_offset_unit,y_offset_dsdsunit="NEW".xy_offset_unit,offset_north_ref="NEW".offset_north_reference,offset_unit=offset_unit_id,original_x="NEW".x_coordinate,original_y="NEW".y_coordinate,original_crs_id=VARIABLES.crs_id,remark="NEW".remark
WHERE native_uid="OLD".native_uid;
END;

CREATE TRIGGER ON PlatformSlot INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC
DELETE FROM OpenWorks_SM.PlatformSlot WHERE native_uid="OLD".native_uid;
END;


/*
**********************************
*     "Plan Optimization Parameter"
**********************************
*/
CREATE VIEW PlanOptimizationParameter
(
  native_uid           					VARCHAR(1024) OPTIONS("OpenWorksCommonModel:PlanOptimizationParameter.native_uid.isUpdatable" false,
                                                    "OpenWorksCommonModel:PlanOptimizationParameter.native_uid.isCreatable" false,
                                                    UPDATABLE 'FALSE'),
  wellplan_native_uid  					VARCHAR(1024) NOT NULL,
  wellbore_native_uid  					VARCHAR(1024) NOT NULL,
  project_name         					VARCHAR(40)   OPTIONS("OpenWorksCommonModel:PlanOptimizationParameter.project_name.isUpdatable" false,
                                                "OpenWorksCommonModel:PlanOptimizationParameter.project_name.isCreatable" false,
                                                UPDATABLE 'FALSE'),
  wellplanproject_native_uid          	VARCHAR(1024)   OPTIONS("OpenWorksCommonModel:PlanOptimizationParameter.wellplanproject_native_uid.isUpdatable" false,
                                                "OpenWorksCommonModel:PlanOptimizationParameter.wellplanproject_native_uid.isCreatable" false,
                                                UPDATABLE 'FALSE'),
  well_plan_name       				   	VARCHAR(200)  OPTIONS("OpenWorksCommonModel:PlanOptimizationParameter.well_plan_name.isUpdatable" false,
                                                "OpenWorksCommonModel:PlanOptimizationParameter.well_plan_name.isCreatable" false,
                                                UPDATABLE 'FALSE'),
  well_plan_version    					INTEGER       OPTIONS("OpenWorksCommonModel:PlanOptimizationParameter.well_plan_version.isUpdatable" false,
                                                  "OpenWorksCommonModel:PlanOptimizationParameter.well_plan_version.isCreatable" false,
                                                  UPDATABLE 'FALSE'),
  wellbore_uwi         					VARCHAR(26)   OPTIONS("OpenWorksCommonModel:PlanOptimizationParameter.wellbore_uwi.isUpdatable" false,
                                                "OpenWorksCommonModel:PlanOptimizationParameter.wellbore_uwi.isCreatable" false,
                                                UPDATABLE 'FALSE'),
  parameter_name       					VARCHAR(40)  NOT NULL DEFAULT 'UNKNOWN',
  parameter_value      					FLOAT        OPTIONS ("OpenWorksCommonModel:PlanOptimizationParameter.parameter_value.unitField" 'parameter_value_unit'),
  parameter_value_unit 					VARCHAR(64)  OPTIONS ("OpenWorksCommonModel:PlanOptimizationParameter.parameter_value_unit.unitTypeAttribute" 'unit_type'),
  unit_type            					VARCHAR(64),
  remark               					VARCHAR(200),
  create_date          					TIMESTAMP    OPTIONS("OpenWorksCommonModel:PlanOptimizationParameter.create_date.isUpdatable" false,
                                            "OpenWorksCommonModel:PlanOptimizationParameter.create_date.isCreatable" false,UPDATABLE 'FALSE'),
  create_user_id       					VARCHAR(32)  OPTIONS("OpenWorksCommonModel:PlanOptimizationParameter.create_user_id.isUpdatable" false,
                                            "OpenWorksCommonModel:PlanOptimizationParameter.create_user_id.isCreatable" false,UPDATABLE 'FALSE'),
  update_date          					TIMESTAMP    OPTIONS("OpenWorksCommonModel:PlanOptimizationParameter.update_date.isUpdatable" false,
                                            "OpenWorksCommonModel:PlanOptimizationParameter.update_date.isCreatable" false,UPDATABLE 'FALSE'),
  update_user_id       					VARCHAR(32)  OPTIONS("OpenWorksCommonModel:PlanOptimizationParameter.update_user_id.isUpdatable" false,
                                            "OpenWorksCommonModel:PlanOptimizationParameter.update_user_id.isCreatable" false,UPDATABLE 'FALSE'),
  alternate_uid    		   VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:PlanOptimizationParameter.alternate_uid.isCreatable" false,
                                              "OpenWorksCommonModel:PlanOptimizationParameter.alternate_uid.isUpdatable" false,
                                               UPDATABLE 'FALSE'),


    CONSTRAINT PlanOptimizationParameter_PK PRIMARY KEY (native_uid),

    CONSTRAINT PlanOptimizationParameter_UK1 UNIQUE (wellplan_native_uid, parameter_name),

    CONSTRAINT FK_PlanOptimizationParameter_wellbore_native_uid
        FOREIGN KEY        (wellbore_native_uid)
        REFERENCES Wellbore(native_uid),

    CONSTRAINT FK_PlanOptimizationParameter_wellplan_native_uid
        FOREIGN KEY        (wellplan_native_uid)
        REFERENCES WellPlan(native_uid)

)
OPTIONS (UPDATABLE 'TRUE',  PlanOptimizationParameter.IMPLEMENTED 'TRUE')
AS
 SELECT
  OpenWorks_SM.PlanOptParm.native_uid,
  OW_WP.well_plan_id,
  OW_WP.wellid,
  OpenWorks_SM.WellPlanProj.wp_project_name,
  OpenWorks_SM.PlanOptParm.wp_project_id,
  OW_WP.well_plan_lname      AS well_plan_name,
  cast(OW_WP.well_plan_version AS integer)      		AS well_plan_version,
  NVL(OW_WP.wellbore_uwi,'NONE') AS wellbore_uwi,
  OpenWorks_SM.PlanOptParm.parameter_name               AS parameter_name,
  OpenWorks_SM.PlanOptParm.parameter_value              AS parameter_value,
  OpenWorks_SM.PlanOptParm.parameter_value_dsdsunit  	AS parameter_value_unit,
  OpenWorks_SM.PlanOptParm.unit_type_id                 AS unit_type,
  OpenWorks_SM.PlanOptParm.remark                       AS remark,
   OpenWorks_SM.PlanOptParm.create_date                 AS create_date,
  OpenWorks_SM.PlanOptParm.create_user_id               AS create_user_id,
 OpenWorks_SM.PlanOptParm.update_date                  	AS update_date,
  OpenWorks_SM.PlanOptParm.update_user_id               AS update_user_id,
  OpenWorks_SM.PlanOptParm.native_uid
FROM
 OpenWorks_SM.PlanOptParm,
    (SELECT WP.wp_project_id as wp_project_id,WP.well_plan_id as well_plan_id, WP.well_plan_lname as well_plan_lname,WP.well_plan_version as well_plan_version,WB.uwi as "wellbore_uwi", WB.wellid as wellid FROM OpenWorks_SM.WellPlan WP LEFT OUTER JOIN OpenWorks_SM.WellEntire WB ON WP.current_well_id = WB.wellid) OW_WP, OpenWorks_SM.WellPlanProj
WHERE
     OpenWorks_SM.PlanOptParm.wp_project_id = OW_WP.wp_project_id
     AND OpenWorks_SM.PlanOptParm.well_plan_id  = OW_WP.well_plan_id
     AND OpenWorks_SM.PlanOptParm.wp_project_id=OpenWorks_SM.WellPlanProj.wp_project_id;


Create Trigger on PlanOptimizationParameter INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC

    DECLARE string VARIABLES.well_plan_id_errorMsg='ERROR: The WellPlan with given WellPlan native_uid:  '|| "NEW".wellplan_native_uid || ' does not exist';

    DECLARE string VARIABLES.well_plan_id    = (SELECT OpenWorks_SM.WellPlan.well_plan_id  FROM OpenWorks_SM.WellPlan where well_plan_id="NEW".wellplan_native_uid);

    IF (VARIABLES.well_plan_id IS NULL ) ERROR VARIABLES.well_plan_id_errorMsg;

    DECLARE string VARIABLES.wp_project_id_errorMsg='ERROR: The WellPlan Project with given value '|| "NEW".wellplan_native_uid || '  does not exist';
    DECLARE string VARIABLES.wp_project_id = (SELECT WP_PROJECT_ID FROM OpenWorks_SM.WellPlan WHERE well_plan_id  = "NEW".wellplan_native_uid);

    IF (VARIABLES.wp_project_id IS NULL ) ERROR VARIABLES.wp_project_id_errorMsg;

  INSERT INTO OpenWorks_SM.PlanOptParm
    (wp_project_id , well_plan_id  , parameter_name, parameter_value,parameter_value_dsdsunit,  remark)
  VALUES (VARIABLES.wp_project_id, VARIABLES.well_plan_id, "NEW".parameter_name, "NEW".parameter_value, "NEW".parameter_value_unit, "NEW".remark);

END;

Create Trigger on PlanOptimizationParameter INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC

  UPDATE OpenWorks_SM.PlanOptParm SET
   parameter_value= "NEW".parameter_value,parameter_value_dsdsunit="NEW".parameter_value_unit,  remark="NEW".remark WHERE native_uid= "OLD".native_uid;

END;

Create Trigger on PlanOptimizationParameter INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC
  DELETE FROM OpenWorks_SM.PlanOptParm WHERE native_uid= "OLD".native_uid;
END;

/*
**********************************
*     "Platform"
**********************************
*/
CREATE View Platform
(
  native_uid              VARCHAR(1024) OPTIONS("OpenWorksCommonModel:Platform.native_uid.isUpdatable" false,
                                                "OpenWorksCommonModel:Platform.native_uid.isCreatable" false,
                                                  UPDATABLE 'FALSE'),
  platform_code           VARCHAR(20)   NOT NULL,
  country                 VARCHAR(25)   DEFAULT 'UNKNOWN',
  data_source             VARCHAR(5),
  seq_no                  INTEGER,
  name                    VARCHAR(24),
  company                 VARCHAR(40)   DEFAULT 'UNKNOWN',
  field_native_uid        VARCHAR(1024),
  field_name              VARCHAR(60)   OPTIONS("OpenWorksCommonModel:Platform.field_name.isUpdatable" false,
                                               "OpenWorksCommonModel:Platform.field_name.isCreatable" false,
                                                UPDATABLE 'FALSE'),
  block_no                VARCHAR(8),
  platform_size           VARCHAR(18),
  water_depth             FLOAT         OPTIONS ("OpenWorksCommonModel:Platform.water_depth.unitField" 'water_depth_unit'),
  water_depth_unit        VARCHAR(64)   OPTIONS ("OpenWorksCommonModel:Platform.water_depth_unit.unitType" 'depth measure'),
  type                    VARCHAR(20),
  x_coordinate            DOUBLE        OPTIONS ("OpenWorksCommonModel:Platform.x_coordinate.unitField" 'xy_unit'),
  y_coordinate            DOUBLE        OPTIONS ("OpenWorksCommonModel:Platform.y_coordinate.unitField" 'xy_unit'),
  xy_unit                 VARCHAR(64)   OPTIONS ("OpenWorksCommonModel:Platform.xy_unit.isUpdatable" false,
                                                 "OpenWorksCommonModel:Platform.xy_unit.isCreatable" false),
  crs                     VARCHAR(80),
  district_name       VARCHAR(50),
  division_name        VARCHAR(30),
  region_name            VARCHAR(32),
  state_name            VARCHAR(40),
  county_name            VARCHAR(40),
  remark                  VARCHAR(200),
  create_date             TIMESTAMP     OPTIONS ("OpenWorksCommonModel:Platform.create_date.isUpdatable" false,
                                                 "OpenWorksCommonModel:Platform.create_date.isCreatable" false,UPDATABLE 'FALSE'),
  create_user_id          VARCHAR(32)   OPTIONS ("OpenWorksCommonModel:Platform.create_user_id.isUpdatable" false,
                                                 "OpenWorksCommonModel:Platform.create_user_id.isCreatable" false,UPDATABLE 'FALSE'),
  update_date             TIMESTAMP     OPTIONS ("OpenWorksCommonModel:Platform.update_date.isUpdatable" false,
                                                 "OpenWorksCommonModel:Platform.update_date.isCreatable" false,UPDATABLE 'FALSE'),
  update_user_id          VARCHAR(32)   OPTIONS ("OpenWorksCommonModel:Platform.update_user_id.isUpdatable" false,
                                                 "OpenWorksCommonModel:Platform.update_user_id.isCreatable" false,UPDATABLE 'FALSE'),
  alternate_uid    		      VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:Platform.alternate_uid.isCreatable" false,
                                                 "OpenWorksCommonModel:Platform.alternate_uid.isUpdatable" false,
                                                 UPDATABLE 'FALSE'),

  CONSTRAINT Platform_PK PRIMARY KEY(native_uid),

  CONSTRAINT Platform_UK1 UNIQUE (platform_code),

  CONSTRAINT FK_Platform_crs
      FOREIGN KEY                    (crs)
      REFERENCES CartoReferenceSystem(name),

  CONSTRAINT FK_Platform_field_native_uid
      FOREIGN KEY     (field_native_uid)
      REFERENCES Field(native_uid),

  CONSTRAINT FK_Platform_data_source
      FOREIGN KEY          (data_source)
      REFERENCES DataSource(name),

  CONSTRAINT FK_Platform_company
      FOREIGN KEY       (company)
      REFERENCES Company(company_name)

)
OPTIONS (UPDATABLE 'TRUE',Platform.IMPLEMENTED 'TRUE')
AS

SELECT
   OpenWorks_SM.PlatformInfo.platform_code,
   OpenWorks_SM.PlatformInfo.platform_code,
   OpenWorks_SM.PlatformInfo.country,
   OpenWorks_SM.PlatformInfo.data_source,
   OpenWorks_SM.PlatformInfo.seq_no,
   OpenWorks_SM.PlatformInfo.name,
   OpenWorks_SM.PlatformInfo.company,
   fieldinfo.field_id,
   fieldinfo.field,
   OpenWorks_SM.PlatformInfo.blk_no as block_no,
   OpenWorks_SM.PlatformInfo.size as platform_size,
   OpenWorks_SM.PlatformInfo.water_depth,
   OpenWorks_SM.PlatformInfo.water_depth_dsdsunit,
   OpenWorks_SM.PlatformInfo.type,
   x_coord AS x_coordinate,
   y_coord AS y_coordinate,
   COALESCE(OpenWorks_SM.PlatformInfo.x_coord_dsdsunit,OpenWorks_SM.PlatformInfo.y_coord_dsdsunit) AS xy_unit,
   (Select getDSDSCrs(name) from OpenWorks_SM.CartoRefSys,OpenWorks_SM.Project where OpenWorks_SM.CartoRefSys.id = OpenWorks_SM.Project.xy_crs_id) AS crs,
   null AS district_name,
   null AS division_name,
   null AS region_name,
   null AS state_name,
   null AS county_name,
   OpenWorks_SM.PlatformInfo.remark,
   OpenWorks_SM.PlatformInfo.create_date,
   OpenWorks_SM.PlatformInfo.create_user_id,
   OpenWorks_SM.PlatformInfo.update_date,
   OpenWorks_SM.PlatformInfo.update_user_id,
   OpenWorks_SM.PlatformInfo.native_uid
FROM
   OpenWorks_SM.PlatformInfo LEFT OUTER JOIN (select distinct WE.platform_id,WE.field,field.field_id from OpenWorks_SM.WellEntire WE, OpenWorks_SM.FieldPros field where WE.field = field.field_name)fieldinfo ON OpenWorks_SM.PlatformInfo.platform_code = fieldInfo.platform_id;

CREATE TRIGGER ON Platform INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC
DECLARE string VARIABLES.crs_errorMsg='ERROR: The given value for crs does not exist';
        DECLARE string VARIABLES.crs_id;

    IF("NEW".crs is NOT NULL)
    BEGIN
        VARIABLES.crs_id = (SELECT id FROM OpenWorks_SM.CartoRefSys WHERE name = (SELECT * FROM (EXEC OpenWorks_SM.GetNativeCRS("NEW".crs,'OW')) AS SysGenID));
        IF(VARIABLES.crs_id is NULL) ERROR VARIABLES.crs_errorMsg;
    END


INSERT INTO OpenWorks_SM.PlatformInfo(platform_code,country,data_source,seq_no,name,company,blk_no,size,water_depth,water_depth_dsdsunit,type,orig_x_coord,orig_y_coord,original_crs_id,remark) values ("NEW".platform_code,"NEW".country,"NEW".data_source,"NEW".seq_no,"NEW".name,"NEW".company,"NEW".block_no,"NEW".platform_size,"NEW".water_depth,"NEW".water_depth_unit,"NEW".type,"NEW".x_coordinate,"NEW".y_coordinate,VARIABLES.crs_id,"NEW".remark);

END;


CREATE TRIGGER ON Platform INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC
DECLARE string VARIABLES.crs_errorMsg='ERROR: The given value for crs does not exist';
        DECLARE string VARIABLES.crs_id;

    IF("NEW".crs is NOT NULL)
    BEGIN
           VARIABLES.crs_id = (SELECT id FROM OpenWorks_SM.CartoRefSys WHERE name = (SELECT * FROM (EXEC OpenWorks_SM.GetNativeCRS("NEW".crs,'OW')) AS SysGenID));
        IF(VARIABLES.crs_id is NULL) ERROR VARIABLES.crs_errorMsg;
    END


UPDATE OpenWorks_SM.PlatformInfo SET
country="NEW".country,data_source="NEW".data_source,seq_no="NEW".seq_no,name="NEW".name,company="NEW".company,blk_no="NEW".block_no,size="NEW".platform_size,water_depth="NEW".water_depth,water_depth_dsdsunit="NEW".water_depth_unit,
type="NEW".type,orig_x_coord="NEW".x_coordinate,orig_y_coord="NEW".y_coordinate,original_crs_id=VARIABLES.crs_id,remark="NEW".remark
WHERE OpenWorks_SM.PlatformInfo.platform_code="OLD".platform_code;
END;

CREATE TRIGGER ON Platform INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC

DELETE FROM  OpenWorks_SM.PlatformInfo WHERE OpenWorks_SM.PlatformInfo.platform_code="OLD".platform_code;
END;

/*
**********************************
*     "TurnPoint"
**********************************
*/

CREATE VIEW TurnPoint
(
  native_uid                  VARCHAR(1024) OPTIONS("OpenWorksCommonModel:TurnPoint.native_uid.isUpdatable" false,
                                                      "OpenWorksCommonModel:TurnPoint.native_uid.isCreatable" false,
                                                       UPDATABLE 'FALSE'),
  wellplanproject_native_uid  VARCHAR(1024) NOT NULL,
  wellplan_native_uid         VARCHAR(1024) NOT NULL,
  target_native_uid           VARCHAR(1024),
  wellbore_native_uid         VARCHAR(1024) NOT NULL,
  project_name                VARCHAR(40)        OPTIONS("OpenWorksCommonModel:TurnPoint.project_name.isUpdatable" false,
                                                         "OpenWorksCommonModel:TurnPoint.project_name.isCreatable" false,
                                                          UPDATABLE 'FALSE'),

  well_plan_name           VARCHAR(200)          OPTIONS("OpenWorksCommonModel:TurnPoint.well_plan_name.isUpdatable" false,
                                                         "OpenWorksCommonModel:TurnPoint.well_plan_name.isCreatable" false,
                                                          UPDATABLE 'FALSE'),
  well_plan_version        INTEGER               OPTIONS("OpenWorksCommonModel:TurnPoint.well_plan_version.isUpdatable" false,
                                                         "OpenWorksCommonModel:TurnPoint.well_plan_version.isCreatable" false,
                                                          UPDATABLE 'FALSE'),
  turn_point_seq_no        INTEGER NOT NULL DEFAULT '0',
  wellbore_uwi             VARCHAR(26)           OPTIONS("OpenWorksCommonModel:TurnPoint.wellbore_uwi.isUpdatable" false,
                                                        "OpenWorksCommonModel:TurnPoint.wellbore_uwi.isCreatable" false,
                                                         UPDATABLE 'FALSE'),
  well_plan_method_code    INTEGER,
  target_name              VARCHAR(200)          OPTIONS("OpenWorksCommonModel:TurnPoint.target_name.isUpdatable" false,
                                                          "OpenWorksCommonModel:TurnPoint.target_name.isCreatable" false,
                                                          UPDATABLE 'FALSE'),
  point_type               VARCHAR(12),
  measured_depth           DOUBLE                OPTIONS ("OpenWorksCommonModel:TurnPoint.measured_depth.unitField"
                                                          'measured_depth_unit'),
  measured_depth_unit      VARCHAR(64)           OPTIONS ("OpenWorksCommonModel:TurnPoint.measured_depth_unit.unitType"
                                                           'depth measure'),
  azimuth_angle            DOUBLE                OPTIONS ("OpenWorksCommonModel:TurnPoint.azimuth_angle.unitField"
                                                          'azimuth_angle_unit'),
  azimuth_angle_unit       VARCHAR(64)           OPTIONS ("OpenWorksCommonModel:TurnPoint.azimuth_angle_unit.unitType"
                                                          'angular distance'),
  inclination_angle        DOUBLE                OPTIONS ("OpenWorksCommonModel:TurnPoint.inclination_angle.unitField"
                                                          'inclination_angle_unit'),
  inclination_angle_unit   VARCHAR(64)           OPTIONS ("OpenWorksCommonModel:TurnPoint.inclination_angle_unit.unitType"
                                                          'angular distance'),
  build_rate               DOUBLE                OPTIONS ("OpenWorksCommonModel:TurnPoint.build_rate.unitField" 'build_rate_unit'),
  build_rate_unit          VARCHAR(64)           OPTIONS ("OpenWorksCommonModel:TurnPoint.build_rate_unit.unitType" 'curvature'),
  turn_rate                DOUBLE                OPTIONS ("OpenWorksCommonModel:TurnPoint.turn_rate.unitField" 'turn_rate_unit'),
  turn_rate_unit           VARCHAR(64)           OPTIONS ("OpenWorksCommonModel:TurnPoint.turn_rate_unit.unitType" 'curvature'),
  dogleg_severity          DOUBLE                OPTIONS ("OpenWorksCommonModel:TurnPoint.dogleg_severity.unitField"
                                                          'dogleg_severity_unit'),
  dogleg_severity_unit     VARCHAR(64)           OPTIONS ("OpenWorksCommonModel:TurnPoint.dogleg_severity_unit.unitType" 'curvature'),
  tool_face                DOUBLE                OPTIONS ("OpenWorksCommonModel:TurnPoint.tool_face.unitField" 'tool_face_unit'),
  tool_face_unit           VARCHAR(64)           OPTIONS ("OpenWorksCommonModel:TurnPoint.tool_face_unit.unitType"
                                                          'angular distance'),
  x                        DOUBLE                OPTIONS ("OpenWorksCommonModel:TurnPoint.x.unitField" 'xy_unit'),
  y                        DOUBLE                OPTIONS ("OpenWorksCommonModel:TurnPoint.y.unitField" 'xy_unit'),
  xy_unit                  VARCHAR(64),
  crs                      VARCHAR(80),
  z                        DOUBLE                OPTIONS ("OpenWorksCommonModel:TurnPoint.z.unitField" 'z_unit'),
  z_unit                   VARCHAR(64)           OPTIONS ("OpenWorksCommonModel:TurnPoint.z_unit.unitType" 'depth measure'),
  alternate_uid    		          VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:TurnPoint.alternate_uid.isCreatable" false,
                                                     "OpenWorksCommonModel:TurnPoint.alternate_uid.isUpdatable" false,
                                                      UPDATABLE 'FALSE'),

    CONSTRAINT TurnPoint_PK PRIMARY KEY (native_uid),

    CONSTRAINT TurnPoint_UK1 UNIQUE (wellplan_native_uid, turn_point_seq_no),

    CONSTRAINT FK_TurnPoint_WellPlan_native_uid
        FOREIGN KEY        (wellplan_native_uid)
        REFERENCES WellPlan(native_uid),

    CONSTRAINT FK_TurnPoint_target_native_uid
        FOREIGN KEY      (target_native_uid)
        REFERENCES Target(native_uid),

    CONSTRAINT FK_TurnPoint_wellbore_native_uid
        FOREIGN KEY        (wellbore_native_uid)
        REFERENCES Wellbore(native_uid),

    CONSTRAINT FK_TurnPoint_crs
        FOREIGN KEY                    (crs)
        REFERENCES CartoReferenceSystem(name),

    CONSTRAINT FK_TurnPoint_wellplanproject_native_uid
        FOREIGN KEY               (wellplanproject_native_uid)
        REFERENCES WellPlanProject(native_uid)

)
OPTIONS (UPDATABLE 'TRUE',  TurnPoint.IMPLEMENTED 'TRUE')
AS
SELECT
  tp.native_uid,
  OpenWorks_SM.WellPlanProj.wp_project_id,
  OW_WP.well_plan_id,
  t.target_id,
  OW_WP.wellid,
  OpenWorks_SM.WellPlanProj.wp_project_name,
  OW_WP.well_plan_lname      AS well_plan_name,
  OW_WP.well_plan_version      AS well_plan_version,
  tp.turn_point_seq_no      AS turn_point_seq_no,
  NVL(OW_WP.wellbore_uwi,'NONE') AS wellbore_uwi,
  tp.well_plan_meth_cd ,
  t.target_lname      AS target_name,
  tp.point_type      AS point_type,
  tp.measured_depth      AS measured_depth,
  tp.measured_depth_dsdsunit      AS measured_depth_unit,
  tp.azimuth_angle      AS azimuth_angle,
  tp.azimuth_angle_dsdsunit      AS azimuth_angle_unit,
  tp.inclination_angle      AS inclination_angle,
  tp.inclination_angle_dsdsunit      AS inclination_angle_unit,
  tp.build_rate      AS build_rate,
  tp.build_rate_dsdsunit      AS build_rate_unit,
  tp.turn_rate      AS turn_rate,
  tp.turn_rate_dsdsunit      AS turn_rate_unit,
  tp.dogleg_severity      AS dogleg_severity,
  tp.dogleg_severity_dsdsunit      AS dogleg_severity_unit,
  tp.tool_face      AS tool_face,
  tp.tool_face_dsdsunit      AS tool_face_unit,
  tp.x      AS x,
  tp.y      AS y,
  COALESCE(tp.x_dsdsunit,tp.y_dsdsunit)  AS xy_unit,
  (Select getDSDSCrs(name) from OpenWorks_SM.CartoRefSys,OpenWorks_SM.Project where OpenWorks_SM.CartoRefSys.id = OpenWorks_SM.Project.xy_crs_id) AS crs,
  tp.z      AS z,
  tp.z_dsdsunit      AS z_unit,
  tp.native_uid
 FROM
     (OpenWorks_SM.TurnPoint tp LEFT OUTER JOIN Openworks_SM.Target t ON t.target_id = tp.target_id),
     (SELECT WP.wp_project_id as wp_project_id,WP.well_plan_id as well_plan_id, WP.well_plan_lname as well_plan_lname,WP.well_plan_version as well_plan_version,WB.uwi as "wellbore_uwi", WB.wellid as wellid FROM OpenWorks_SM.WellPlan WP LEFT OUTER JOIN OpenWorks_SM.WellEntire WB ON WP.current_well_id = WB.wellid) OW_WP,
     OpenWorks_SM.WellPlanProj
WHERE
     tp.well_plan_id =  OW_WP.well_plan_id and tp.wp_project_id=OpenWorks_SM.WellPlanProj.wp_project_id
ORDER BY OW_WP.well_plan_id, tp.turn_point_seq_no;



CREATE TRIGGER ON TurnPoint INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC

    DECLARE string VARIABLES.wp_project_id_errorMsg='ERROR: The WellPlan Project with given value '|| "NEW".wellplanproject_native_uid || '  does not exist';
    DECLARE string VARIABLES.wp_project_id = (SELECT WP_PROJECT_ID FROM OpenWorks_SM.WellPlanProj WHERE wp_project_id = "NEW".wellplanproject_native_uid);


    IF (VARIABLES.wp_project_id IS NULL ) ERROR VARIABLES.wp_project_id_errorMsg;

    DECLARE string VARIABLES.well_plan_id_errorMsg='ERROR: The WellPlan with given WellPlan native_uid:  '|| "NEW".wellplan_native_uid || ' and Project Name: '||"NEW".wellplanproject_native_uid || ' does not exist';
    DECLARE string VARIABLES.well_plan_id    = (SELECT OpenWorks_SM.WellPlan.well_plan_id  FROM OpenWorks_SM.WellPlan where well_plan_id="NEW".wellplan_native_uid and wp_project_id=VARIABLES.wp_project_id);

    IF (VARIABLES.well_plan_id IS NULL ) ERROR VARIABLES.well_plan_id_errorMsg;

    DECLARE string VARIABLES.target_id_errorMsg='ERROR: The Target with given Target native_uid:  '|| "NEW".target_native_uid || '  and Project wellplanproject_native_uid: '||"NEW".wellplanproject_native_uid || 'does not exist';

    DECLARE string VARIABLES.target_id;

 IF("NEW".target_native_uid IS NOT NULL)
BEGIN
 VARIABLES.target_id = (SELECT target_id FROM OpenWorks_SM.TARGET WHERE target_id = "NEW".target_native_uid and wp_project_id= VARIABLES.wp_project_id );
IF(VARIABLES.target_id is NULL) ERROR VARIABLES.target_id_errorMsg;
    END

 DECLARE double VARIABLES.X = "NEW".x;
 DECLARE double VARIABLES.Y = "NEW".y;
    DECLARE string VARIABLES.XYUnit = "NEW".xy_unit;
    DECLARE string VARIABLES.targetCRS = (Select name from OpenWorks_SM.CartoRefSys,OpenWorks_SM.Project where OpenWorks_SM.CartoRefSys.id = OpenWorks_SM.Project.xy_crs_id);
    DECLARE blob convertedXYBlob = select cartoConvert("NEW".crs,VARIABLES.targetCRS,VARIABLES.X,VARIABLES.Y,VARIABLES.XYUnit);
    IF(convertedXYBlob IS NOT NULL)
    BEGIN
         VARIABLES.X= fetchDElementValueFromBlob(convertedXYBlob,'x');
         VARIABLES.Y= fetchDElementValueFromBlob(convertedXYBlob,'y');
         VARIABLES.XYUnit= fetchElementUnitNameFromBlob(convertedXYBlob,'x');
    END

    INSERT INTO OpenWorks_SM.TurnPoint
      (well_plan_id,turn_point_seq_no,wp_project_id, well_plan_meth_cd,target_id, point_type, measured_depth, measured_depth_dsdsunit, azimuth_angle,
       azimuth_angle_dsdsunit, inclination_angle, inclination_angle_dsdsunit, build_rate, build_rate_dsdsunit,
       turn_rate, turn_rate_dsdsunit, dogleg_severity, dogleg_severity_dsdsunit, tool_face, tool_face_dsdsunit,
       x, y , z, z_dsdsunit )
    VALUES
    (VARIABLES.well_plan_id,"NEW".turn_point_seq_no, VARIABLES.wp_project_id , "NEW".well_plan_method_code,VARIABLES.target_id , "NEW".point_type, "NEW".measured_depth, "NEW".measured_depth_unit, "NEW".azimuth_angle,
   "NEW".azimuth_angle_unit, "NEW".inclination_angle, "NEW".inclination_angle_unit, "NEW".build_rate, "NEW".build_rate_unit,
   "NEW".turn_rate, "NEW".turn_rate_unit, "NEW".dogleg_severity, "NEW".dogleg_severity_unit, "NEW".tool_face, "NEW".tool_face_unit,
   VARIABLES.X, VARIABLES.Y , "NEW".z, "NEW".z_unit );

END;

CREATE TRIGGER ON TurnPoint INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC

 DECLARE string VARIABLES.wp_project_id_errorMsg='ERROR: The WellPlanProject with given value for does not exist';
 DECLARE string VARIABLES.well_plan_id_errorMsg='ERROR: The WellPlan with given WellPlan native_uid:  '||"NEW".wellplan_native_uid || ' and wp_project_id: '|| "NEW".wellplanproject_native_uid || ' does not exist';
 DECLARE string VARIABLES.target_id_errorMsg='ERROR: The Target with given values for (target_name,project_name) does not exist';
 DECLARE string VARIABLES.wp_project_id = (SELECT OpenWorks_SM.WellPlanProj.wp_project_id FROM OpenWorks_SM.WellPlanProj WHERE OpenWorks_SM.WellPlanProj.wp_project_id = "OLD".wellplanproject_native_uid);
 DECLARE string VARIABLES.well_plan_id    = (SELECT OpenWorks_SM.WellPlan.well_plan_id  FROM OpenWorks_SM.WellPlan where well_plan_id="NEW".wellplan_native_uid and wp_project_id=VARIABLES.wp_project_id);
DECLARE string VARIABLES.target_id;
  IF(VARIABLES.wp_project_id is NULL) ERROR VARIABLES.wp_project_id_errorMsg;
    IF(VARIABLES.well_plan_id is NULL) ERROR VARIABLES.well_plan_id_errorMsg;
 IF("NEW".target_native_uid IS NOT NULL)
BEGIN
 VARIABLES.target_id = (SELECT target_id FROM OpenWorks_SM.TARGET WHERE target_id = "NEW".target_native_uid and wp_project_id= VARIABLES.wp_project_id );
IF(VARIABLES.target_id is NULL) ERROR VARIABLES.target_id_errorMsg;
 END

 DECLARE double VARIABLES.X = "NEW".x;
 DECLARE double VARIABLES.Y = "NEW".y;
 DECLARE string VARIABLES.XYUnit = "NEW".xy_unit;
  DECLARE string VARIABLES.targetCRS = (Select name from OpenWorks_SM.CartoRefSys,OpenWorks_SM.Project where OpenWorks_SM.CartoRefSys.id = OpenWorks_SM.Project.xy_crs_id);
  DECLARE blob convertedXYBlob = select cartoConvert("NEW".crs,VARIABLES.targetCRS,VARIABLES.X,VARIABLES.Y,VARIABLES.XYUnit);
  IF(convertedXYBlob IS NOT NULL)
  BEGIN
          VARIABLES.X= fetchDElementValueFromBlob(convertedXYBlob,'x');
          VARIABLES.Y= fetchDElementValueFromBlob(convertedXYBlob,'y');
          VARIABLES.XYUnit= fetchElementUnitNameFromBlob(convertedXYBlob,'x');
  END

 UPDATE OpenWorks_SM.TurnPoint SET
 well_plan_meth_cd="NEW".well_plan_method_code,target_id=VARIABLES.target_id ,point_type= "NEW".point_type,measured_depth="NEW".measured_depth,measured_depth_dsdsunit="NEW".measured_depth_unit, azimuth_angle="NEW".azimuth_angle,
 azimuth_angle_dsdsunit="NEW".azimuth_angle_unit, inclination_angle= "NEW".inclination_angle, inclination_angle_dsdsunit="NEW".inclination_angle_unit, build_rate= "NEW".build_rate, build_rate_dsdsunit="NEW".build_rate_unit,
 turn_rate="NEW".turn_rate, turn_rate_dsdsunit="NEW".turn_rate_unit, dogleg_severity= "NEW".dogleg_severity, dogleg_severity_dsdsunit= "NEW".dogleg_severity_unit, tool_face="NEW".tool_face, tool_face_dsdsunit="NEW".tool_face_unit, x=VARIABLES.X, y =VARIABLES.Y, z="NEW".z, z_dsdsunit="NEW".z_unit where native_uid = "OLD".native_uid;

END;

CREATE TRIGGER ON TurnPoint INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC
 DELETE FROM OpenWorks_SM.TurnPoint where native_uid = "OLD".native_uid;
END;


/*
**********************************
*     "WellPlanTarget"
**********************************
*/
CREATE VIEW WellPlanTarget
(
  native_uid              VARCHAR(1024)   OPTIONS("OpenWorksCommonModel:WellPlanTarget.native_uid.isUpdatable" false,
                                                    "OpenWorksCommonModel:WellPlanTarget.native_uid.isCreatable" false,
                                                    UPDATABLE 'FALSE'),
  wellplanproject_native_uid   VARCHAR(1024)   OPTIONS("OpenWorksCommonModel:WellPlanTarget.wellplanproject_native_uid.isUpdatable"
													false, "OpenWorksCommonModel:WellPlanTarget.wellplanproject_native_uid.isCreatable" false,
                                                    UPDATABLE 'FALSE'),
  wellplan_native_uid     VARCHAR(1024) NOT NULL,
  target_native_uid       VARCHAR(1024) NOT NULL,
  wellbore_native_uid     VARCHAR(1024) NOT NULL,
  project_name        VARCHAR(40)  OPTIONS("OpenWorksCommonModel:WellPlanTarget.project_name.isUpdatable" false,
                                              "OpenWorksCommonModel:WellPlanTarget.project_name.isCreatable" false,
                                              UPDATABLE 'FALSE'),
  well_plan_name      VARCHAR(200) OPTIONS("OpenWorksCommonModel:WellPlanTarget.well_plan_name.isUpdatable" false,
                                             "OpenWorksCommonModel:WellPlanTarget.well_plan_name.isCreatable" false,
                                             UPDATABLE 'FALSE'),
  well_plan_version   INTEGER      OPTIONS("OpenWorksCommonModel:WellPlanTarget.well_plan_version.isUpdatable" false,
                                             "OpenWorksCommonModel:WellPlanTarget.well_plan_version.isCreatable" false,
                                             UPDATABLE 'FALSE'),
  target_name         VARCHAR(200) OPTIONS("OpenWorksCommonModel:WellPlanTarget.target_name.isUpdatable" false,
                                             "OpenWorksCommonModel:WellPlanTarget.target_name.isCreatable" false,
                                             UPDATABLE 'FALSE'),
  wellbore_uwi        VARCHAR(26)  OPTIONS("OpenWorksCommonModel:WellPlanTarget.wellbore_uwi.isUpdatable" false,
                                             "OpenWorksCommonModel:WellPlanTarget.wellbore_uwi.isCreatable" false,
                                             UPDATABLE 'FALSE'),
  target_seq_no       INTEGER,
  target_status       VARCHAR(12),
  alternate_uid    		      VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:WellPlanTarget.alternate_uid.isCreatable" false,
                                                 "OpenWorksCommonModel:WellPlanTarget.alternate_uid.isUpdatable" false,
                                                  UPDATABLE 'FALSE'),

    CONSTRAINT WellPlanTarget_PK PRIMARY KEY (native_uid),

    CONSTRAINT WellPlanTarget_UK1 UNIQUE (wellplan_native_uid, target_native_uid),

    CONSTRAINT FK_WellPlanTarget_wellplan_native_uid
        FOREIGN KEY        (wellplan_native_uid)
        REFERENCES WellPlan(native_uid),

    CONSTRAINT FK_WellPlanTarget_target_native_uid
        FOREIGN KEY      (target_native_uid)
        REFERENCES Target(native_uid),

    CONSTRAINT FK_WellPlanTarget_wellbore_native_uid
        FOREIGN KEY        (wellbore_native_uid)
        REFERENCES Wellbore(native_uid),

    CONSTRAINT FK_WellPlanTarget_project_name
        FOREIGN KEY (project_name)
        REFERENCES WellPlanProject(project_name)


) OPTIONS (UPDATABLE 'TRUE', WellPlanTarget.IMPLEMENTED 'TRUE')
AS
SELECT
		OpenWorks_SM.WPTarget.native_uid,
		OpenWorks_SM.WPTarget.wp_project_id,
        OW_WP.well_plan_id,
        OpenWorks_SM.TARGET.target_id,
        OW_WP.wellid,
        OpenWorks_SM.WellPlanProj.wp_project_name,
        OW_WP.well_plan_name,
        OW_WP.Well_plan_version,
        OpenWorks_SM.TARGET.TARGET_NAME,
        NVL(OW_WP.wellbore_uwi,'NONE') AS wellbore_uwi,
        OpenWorks_SM.WPTarget.target_seq_no,
        OpenWorks_SM.WPTarget.target_status,
        OpenWorks_SM.WPTarget.native_uid
FROM
        (SELECT WP.wp_project_id as wp_project_id,WP.well_plan_id as well_plan_id, WP.well_plan_name as well_plan_name,WP.well_plan_version as well_plan_version,WB.uwi as "wellbore_uwi", WB.wellid as wellid FROM OpenWorks_SM.WellPlan WP LEFT OUTER JOIN OpenWorks_SM.WellEntire WB ON WP.current_well_id = WB.wellid) OW_WP,
        OpenWorks_SM.TARGET,
        OpenWorks_SM.WPTarget,
        OpenWorks_SM.WellPlanProj
WHERE
            OpenWorks_SM.WPTarget.wp_project_id = OW_WP.wp_project_id AND
            OpenWorks_SM.WPTarget.well_plan_id =  OW_WP.well_plan_id AND
            OpenWorks_SM.WPTarget.wp_project_id=OpenWorks_SM.WellPlanProj.wp_project_id AND
           OpenWorks_SM.TARGET.target_id = OpenWorks_SM.WPTarget.target_id;



CREATE TRIGGER ON WellPlanTarget INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC


   DECLARE string VARIABLES.wp_project_id_errorMsg='ERROR: The WellPlan Project with given value '|| "NEW".wellplan_native_uid || '  does not exist';
   DECLARE string VARIABLES.wp_project_id = (SELECT WP_PROJECT_ID FROM OpenWorks_SM.WellPlan WHERE well_plan_id = "NEW".wellplan_native_uid);

   IF (VARIABLES.wp_project_id IS NULL ) ERROR VARIABLES.wp_project_id_errorMsg;

   DECLARE string VARIABLES.well_plan_id_errorMsg='ERROR: The WellPlan with given WellPlan native_uid:  '||"NEW".wellplan_native_uid || ' and wp_project_id: '|| VARIABLES.wp_project_id || ' does not exist';
   DECLARE string VARIABLES.well_plan_id = (SELECT well_plan_id  FROM OpenWorks_SM.WellPlan where well_plan_id="NEW".wellplan_native_uid and wp_project_id=VARIABLES.wp_project_id);

   IF (VARIABLES.well_plan_id IS NULL ) ERROR VARIABLES.well_plan_id_errorMsg;

   DECLARE string VARIABLES.target_id_errorMsg='ERROR: The Target with given Target id:  '|| "NEW".target_native_uid || '  and wp_project_id: '||VARIABLES.wp_project_id|| ' does not exist';
   DECLARE string VARIABLES.target_id = (SELECT target_id FROM OpenWorks_SM.TARGET WHERE target_id = "NEW".target_native_uid and wp_project_id= VARIABLES.wp_project_id );

   IF(VARIABLES.target_id is NULL) ERROR VARIABLES.target_id_errorMsg;

    INSERT INTO OpenWorks_SM.WPTarget
    (wp_project_id,well_plan_id,TARGET_ID,target_seq_no,target_status)
    VALUES(VARIABLES.wp_project_id,VARIABLES.well_plan_id,VARIABLES.target_id,"NEW".target_seq_no,"NEW".target_status);
END;


CREATE TRIGGER ON WellPlanTarget INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC

   /* DECLARE integer VARIABLES.wp_project_id = (SELECT WP_PROJECT_ID FROM OpenWorks_SM.WellPlan WHERE well_plan_id = "OLD".wellplan_native_uid);
    DECLARE integer VARIABLES.well_plan_id    = (SELECT OpenWorks_SM.WellPlan.well_plan_id  FROM OpenWorks_SM.WellPlan where well_plan_lname="OLD".well_plan_name and well_plan_version="OLD".well_plan_version and wp_project_id=VARIABLES.wp_project_id);
    DECLARE integer VARIABLES.target_id = (SELECT target_id FROM OpenWorks_SM.TARGET WHERE target_id = "OLD".target_native_uid and wp_project_id= VARIABLES.wp_project_id );*/

    UPDATE OpenWorks_SM.WPTarget SET target_seq_no="NEW".target_seq_no,target_status="NEW".target_status where native_uid = "OLD".native_uid;
END;


CREATE TRIGGER ON WellPlanTarget INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC

    /*DECLARE integer VARIABLES.wp_project_id = (SELECT OpenWorks_SM.WellPlanProj.wp_project_id FROM OpenWorks_SM.WellPlanProj WHERE OpenWorks_SM.WellPlanProj.wp_project_name = "OLD".project_name);
 DECLARE integer VARIABLES.well_plan_id    = (SELECT OpenWorks_SM.WellPlan.well_plan_id  FROM OpenWorks_SM.WellPlan where well_plan_lname="OLD".well_plan_name and well_plan_version="OLD".well_plan_version and wp_project_id=VARIABLES.wp_project_id);
 DECLARE integer VARIABLES.target_id = (SELECT target_id FROM OpenWorks_SM.TARGET WHERE TARGET_LNAME = "OLD".target_name and wp_project_id= VARIABLES.wp_project_id );*/


 DELETE FROM OpenWorks_SM.WPTarget where native_uid = "OLD".native_uid;
END;


/*
**********************************
*     "WellPlanInterval"
**********************************
*/
CREATE VIEW WellPlanInterval
    (
	native_uid              VARCHAR(1024)   OPTIONS("OpenWorksCommonModel:WellPlanInterval.native_uid.isUpdatable" false,
                                                    "OpenWorksCommonModel:WellPlanInterval.native_uid.isCreatable" false,
                                                    UPDATABLE 'FALSE'),
    wellplanproject_native_uid  VARCHAR(1024) NOT NULL,
    wellplan_native_uid     VARCHAR(1024) NOT NULL,
    wellbore_native_uid     VARCHAR(1024) NOT NULL,
    project_name      VARCHAR(40)  OPTIONS("OpenWorksCommonModel:WellPlanInterval.project_name.isUpdatable" false,
                                                "OpenWorksCommonModel:WellPlanInterval.project_name.isCreatable" false,
                                                UPDATABLE 'FALSE'),
    well_plan_name    VARCHAR(200) OPTIONS("OpenWorksCommonModel:WellPlanInterval.well_plan_name.isUpdatable" false,
                                               "OpenWorksCommonModel:WellPlanInterval.well_plan_name.isCreatable" false,
                                               UPDATABLE 'FALSE'),
    well_plan_version INTEGER OPTIONS("OpenWorksCommonModel:WellPlanInterval.well_plan_version.isUpdatable" false,
                                               "OpenWorksCommonModel:WellPlanInterval.well_plan_version.isCreatable" false,
                                               UPDATABLE 'FALSE'),
    interval_type     VARCHAR(20)  NOT NULL Default 'UNKNOWN',
    occurrence_no     INTEGER NOT  NULL,
    wellbore_uwi      VARCHAR(26)  OPTIONS("OpenWorksCommonModel:WellPlanInterval.wellbore_uwi.isUpdatable" false,
                                               "OpenWorksCommonModel:WellPlanInterval.wellbore_uwi.isCreatable" false,
                                               UPDATABLE 'FALSE'),
    top_depth         FLOAT        OPTIONS ("OpenWorksCommonModel:WellPlanInterval.top_depth.unitField" 'top_depth_unit'),
    top_depth_unit    VARCHAR(64)  OPTIONS ("OpenWorksCommonModel:WellPlanInterval.top_depth_unit.unitType" 'depth measure'),
    base_depth        FLOAT        OPTIONS ("OpenWorksCommonModel:WellPlanInterval.base_depth.unitField" 'base_depth_unit'),
    base_depth_unit   VARCHAR(64)  OPTIONS ("OpenWorksCommonModel:WellPlanInterval.base_depth_unit.unitType" 'depth measure'),
    interval_text     VARCHAR(256),
    remark            VARCHAR(200),
    create_date       TIMESTAMP    OPTIONS ("OpenWorksCommonModel:WellPlanInterval.create_date.isUpdatable" false,
                                            "OpenWorksCommonModel:WellPlanInterval.create_date.isCreatable" false,UPDATABLE 'FALSE'),
  create_user_id      VARCHAR(32)  OPTIONS ("OpenWorksCommonModel:WellPlanInterval.create_user_id.isUpdatable" false,
                                            "OpenWorksCommonModel:WellPlanInterval.create_user_id.isCreatable" false,UPDATABLE 'FALSE'),
  update_date         TIMESTAMP    OPTIONS ("OpenWorksCommonModel:WellPlanInterval.update_date.isUpdatable" false,
                                            "OpenWorksCommonModel:WellPlanInterval.update_date.isCreatable" false,UPDATABLE 'FALSE'),
  update_user_id      VARCHAR(32)  OPTIONS ("OpenWorksCommonModel:WellPlanInterval.update_user_id.isUpdatable" false,
                                            "OpenWorksCommonModel:WellPlanInterval.update_user_id.isCreatable" false,UPDATABLE 'FALSE'),
    alternate_uid    		  VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:WellPlanInterval.alternate_uid.isCreatable" false,
                                             "OpenWorksCommonModel:WellPlanInterval.alternate_uid.isUpdatable" false,
                                             UPDATABLE 'FALSE'),
    CONSTRAINT WellPlanInterval_PK PRIMARY KEY (native_uid),

    CONSTRAINT WellPlanInterval_UK1 UNIQUE (wellplan_native_uid, interval_type, occurrence_no),

    CONSTRAINT FK_WellPlanInterval_wellplanproject_native_uid
        FOREIGN KEY               (wellplanproject_native_uid)
        REFERENCES WellPlanProject(native_uid),

    CONSTRAINT FK_WellPlanInterval_wellplan_native_uid
        FOREIGN KEY        (wellplan_native_uid)
        REFERENCES WellPlan(native_uid),

    CONSTRAINT FK_WellPlanInterval_wellbore_native_uid
        FOREIGN KEY        (wellbore_native_uid)
        REFERENCES Wellbore(native_uid)

     )OPTIONS (UPDATABLE 'TRUE', WellPlanInterval.IMPLEMENTED 'TRUE')
    AS
SELECT

    wpi.native_uid,
    OpenWorks_SM.WellPlanProj.wp_project_id,
    OpenWorks_SM.WellPlan.well_plan_id,
    OpenWorks_SM.WellEntire.wellid,
    OpenWorks_SM.WellPlanProj.wp_project_name,
    OW_WP.well_plan_lname,
    OW_WP.well_plan_version,
    wpi.wp_interval_type,
    wpi.occurrence_no,
    NVL(OW_WP.wellbore_uwi,'NONE') AS wellbore_uwi,
    wpi.top_depth,
    wpi.top_depth_dsdsunit,
    wpi.base_depth,
    wpi.base_depth_dsdsunit,
    wpi.interval_text,
    wpi.remark,
    wpi.create_date ,
    wpi.create_user_id,
    wpi.update_date,
    wpi.update_user_id,
	wpi.native_uid

FROM
     OpenWorks_SM.WellPlanInterval wpi,
     (SELECT WP.wp_project_id as wp_project_id,WP.well_plan_id as well_plan_id, WP.well_plan_lname as well_plan_lname,WP.well_plan_version
             as well_plan_version,WB.uwi as "wellbore_uwi" FROM OpenWorks_SM.WellPlan WP
             LEFT OUTER JOIN OpenWorks_SM.WellEntire WB ON WP.current_well_id = WB.wellid) OW_WP
             , OpenWorks_SM.WellPlanProj, OpenWorks_SM.WellPlan LEFT OUTER JOIN OpenWorks_SM.WellEntire
             ON OpenWorks_SM.WellPlan.current_well_id = OpenWorks_SM.WellEntire.wellid
WHERE
      wpi.well_plan_id =  OW_WP.well_plan_id
      AND wpi.wp_project_id = OpenWorks_SM.WellPlanProj.wp_project_id
      AND OpenWorks_SM.WellPlan.well_plan_id = wpi.well_plan_id;



CREATE TRIGGER ON WellPlanInterval INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC



   DECLARE string VARIABLES.wp_project_id_errorMsg='ERROR: The WellPlan Project with given value '|| "NEW".wellplanproject_native_uid || '  does not exist';
   DECLARE string VARIABLES.wp_project_id = (SELECT WP_PROJECT_ID FROM OpenWorks_SM.WellPlanProj WHERE WP_PROJECT_ID = "NEW".wellplanproject_native_uid);

   IF (VARIABLES.wp_project_id IS NULL ) ERROR VARIABLES.wp_project_id_errorMsg;

   DECLARE string VARIABLES.well_plan_id_errorMsg='ERROR: The WellPlan with given WellPlan native_uid:  '|| "NEW".wellplan_native_uid || ' and wp_project_id: '|| "NEW".wellplanproject_native_uid || ' does not exist';
   DECLARE string VARIABLES.well_plan_id = (SELECT OpenWorks_SM.WellPlan.well_plan_id  FROM OpenWorks_SM.WellPlan where well_plan_id = "NEW".wellplan_native_uid and wp_project_id=VARIABLES.wp_project_id);

   IF (VARIABLES.well_plan_id IS NULL ) ERROR VARIABLES.well_plan_id_errorMsg;

    INSERT INTO OpenWorks_SM.WellPlanInterval
          (well_plan_id,wp_interval_type,occurrence_no,wp_project_id,top_depth, top_depth_dsdsunit,
            base_depth, base_depth_dsdsunit, interval_text, remark)
    VALUES
         (VARIABLES.well_plan_id,"NEW".interval_type, "NEW".occurrence_no,VARIABLES.wp_project_id,"NEW".top_depth, "NEW".top_depth_unit,
           "NEW".base_depth, "NEW".base_depth_unit, "NEW".interval_text, "NEW".remark);
END;


CREATE TRIGGER ON WellPlanInterval INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC

  /*DECLARE integer VARIABLES.wp_project_id = (SELECT WP_PROJECT_ID FROM OpenWorks_SM.WellPlanProj WHERE WP_PROJECT_ID = "OLD".wellplanproject_native_uid);
  DECLARE integer VARIABLES.well_plan_id = (SELECT OpenWorks_SM.WellPlan.well_plan_id  FROM OpenWorks_SM.WellPlan where well_plan_id = "OLD".wellplan_native_uid); */

   UPDATE OpenWorks_SM.WellPlanInterval  SET top_depth="NEW".top_depth , top_depth_dsdsunit="NEW".top_depth_unit, base_depth="NEW".base_depth ,base_depth_dsdsunit= "NEW".base_depth_unit ,interval_text= "NEW".interval_text , remark="NEW".remark WHERE native_uid = "OLD".native_uid;

END;


CREATE TRIGGER ON WellPlanInterval INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC
/*
  DECLARE integer VARIABLES.wp_project_id = (SELECT OpenWorks_SM.WellPlanProj.wp_project_id FROM OpenWorks_SM.WellPlanProj WHERE OpenWorks_SM.WellPlanProj.wp_project_name = "OLD".project_name);
  DECLARE integer VARIABLES.well_plan_id    = (SELECT OpenWorks_SM.WellPlan.well_plan_id  FROM OpenWorks_SM.WellPlan where well_plan_lname="OLD".well_plan_name and well_plan_version="OLD".well_plan_version and wp_project_id=VARIABLES.wp_project_id); */

    DELETE from OpenWorks_SM.WellPlanInterval WHERE native_uid = "OLD".native_uid;

END;

