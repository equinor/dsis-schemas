    output_data_id        VARCHAR(12)            NOT NULL        OPTIONS ("OpenWorksCommonModel:InterpProcessOutput.output_data_id.isUpdatable" false,"OpenWorksCommonModel:InterpProcessOutput.output_data_id.isCreatable" true),
    output_data_type    VARCHAR(40)            NOT NULL        OPTIONS ("OpenWorksCommonModel:InterpProcessOutput.output_data_type.isUpdatable" false,"OpenWorksCommonModel:InterpProcessOutput.output_data_type.isCreatable" true),
    key1_name            VARCHAR(40)            OPTIONS ("OpenWorksCommonModel:InterpProcessOutput.key1_name.isUpdatable" false,"OpenWorksCommonModel:InterpProcessOutput.key1_name.isCreatable" false,UPDATABLE 'FALSE'),
    key1_value            VARCHAR(256)        OPTIONS ("OpenWorksCommonModel:InterpProcessOutput.key1_value.isUpdatable" false,"OpenWorksCommonModel:InterpProcessOutput.key1_value.isCreatable" false,UPDATABLE 'FALSE'),
    key2_name            VARCHAR(40)            OPTIONS ("OpenWorksCommonModel:InterpProcessOutput.key2_name.isUpdatable" false,"OpenWorksCommonModel:InterpProcessOutput.key2_name.isCreatable" false,UPDATABLE 'FALSE'),
    key2_value            VARCHAR(256)        OPTIONS ("OpenWorksCommonModel:InterpProcessOutput.key2_value.isUpdatable" false,"OpenWorksCommonModel:InterpProcessOutput.key2_value.isCreatable" false,UPDATABLE 'FALSE'),
    key3_name            VARCHAR(40)            OPTIONS ("OpenWorksCommonModel:InterpProcessOutput.key3_name.isUpdatable" false,"OpenWorksCommonModel:InterpProcessOutput.key3_name.isCreatable" false,UPDATABLE 'FALSE'),
    key3_value            VARCHAR(256)        OPTIONS ("OpenWorksCommonModel:InterpProcessOutput.key3_value.isUpdatable" false,"OpenWorksCommonModel:InterpProcessOutput.key3_value.isCreatable" false,UPDATABLE 'FALSE'),
    key4_name            VARCHAR(40)            OPTIONS ("OpenWorksCommonModel:InterpProcessOutput.key4_name.isUpdatable" false,"OpenWorksCommonModel:InterpProcessOutput.key4_name.isCreatable" false,UPDATABLE 'FALSE'),
    key4_value            VARCHAR(256)        OPTIONS ("OpenWorksCommonModel:InterpProcessOutput.key4_value.isUpdatable" false,"OpenWorksCommonModel:InterpProcessOutput.key4_value.isCreatable" false,UPDATABLE 'FALSE'),
    key5_name            VARCHAR(40)            OPTIONS ("OpenWorksCommonModel:InterpProcessOutput.key5_name.isUpdatable" false,"OpenWorksCommonModel:InterpProcessOutput.key5_name.isCreatable" false,UPDATABLE 'FALSE'),
    key5_value            VARCHAR(256)        OPTIONS ("OpenWorksCommonModel:InterpProcessOutput.key5_value.isUpdatable" false,"OpenWorksCommonModel:InterpProcessOutput.key5_value.isCreatable" false,UPDATABLE 'FALSE'),
    key6_name            VARCHAR(40)            OPTIONS ("OpenWorksCommonModel:InterpProcessOutput.key6_name.isUpdatable" false,"OpenWorksCommonModel:InterpProcessOutput.key6_name.isCreatable" false,UPDATABLE 'FALSE'),
    key6_value            VARCHAR(256)        OPTIONS ("OpenWorksCommonModel:InterpProcessOutput.key6_value.isUpdatable" false,"OpenWorksCommonModel:InterpProcessOutput.key6_value.isCreatable" false,UPDATABLE 'FALSE'),
    key7_name            VARCHAR(40)            OPTIONS ("OpenWorksCommonModel:InterpProcessOutput.key7_name.isUpdatable" false,"OpenWorksCommonModel:InterpProcessOutput.key7_name.isCreatable" false,UPDATABLE 'FALSE'),
    key7_value            VARCHAR(256)        OPTIONS ("OpenWorksCommonModel:InterpProcessOutput.key7_value.isUpdatable" false,"OpenWorksCommonModel:InterpProcessOutput.key7_value.isCreatable" false,UPDATABLE 'FALSE'),
    key8_name            VARCHAR(40)            OPTIONS ("OpenWorksCommonModel:InterpProcessOutput.key8_name.isUpdatable" false,"OpenWorksCommonModel:InterpProcessOutput.key8_name.isCreatable" false,UPDATABLE 'FALSE'),
    key8_value            VARCHAR(256)        OPTIONS ("OpenWorksCommonModel:InterpProcessOutput.key8_value.isUpdatable" false,"OpenWorksCommonModel:InterpProcessOutput.key8_value.isCreatable" false,UPDATABLE 'FALSE'),
    create_date            timestamp           OPTIONS ("OpenWorksCommonModel:InterpProcessOutput.create_date.isUpdatable" false,"OpenWorksCommonModel:InterpProcessOutput.create_date.isCreatable" false,UPDATABLE 'FALSE'),
    create_user_id        VARCHAR(32)         OPTIONS ("OpenWorksCommonModel:InterpProcessOutput.create_user_id.isUpdatable" false,"OpenWorksCommonModel:InterpProcessOutput.create_user_id.isCreatable" false,UPDATABLE 'FALSE'),
    update_date            timestamp           OPTIONS ("OpenWorksCommonModel:InterpProcessOutput.update_user_id.isUpdatable" false,"OpenWorksCommonModel:InterpProcessOutput.update_user_id.isCreatable" false,UPDATABLE 'FALSE'),
    update_user_id        VARCHAR(32)         OPTIONS ("OpenWorksCommonModel:InterpProcessOutput.update_date.isUpdatable" false,"OpenWorksCommonModel:InterpProcessOutput.update_date.isCreatable" false,UPDATABLE 'FALSE'),
    alternate_uid    		      VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:InterpProcessOutput.alternate_uid.isCreatable" false,
