      VARIABLES.point_set_field_id = (SELECT point_set_field_id FROM OpenWorks_SM.PointSetField WHERE point_set_id = VARIABLES.point_set_id and attribute ="OLD".attribute and field_type = "OLD".field_type);
  END ELSE
  BEGIN
      VARIABLES.point_set_field_id = (SELECT point_set_field_id FROM OpenWorks_SM.PointSetField WHERE point_set_id = VARIABLES.point_set_id and attribute ="OLD".attribute and field_type = "OLD".field_type and data_domain = "OLD".data_domain);
  END*/

   DELETE FROM OpenWorks_SM.PointSetField WHERE point_set_field_id = "OLD".native_uid;

END;

/*
