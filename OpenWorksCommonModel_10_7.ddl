/*
****************************************
*    Virtual Procedure - GetXYPointSetBlob
****************************************
*/

CREATE VIRTUAL PROCEDURE GetXYPointSetBlob(pointSetID integer,fieldType integer) RETURNS (pointSetBlob Blob) AS
BEGIN
    DECLARE string VARIABLES.pointSetFieldID=0;
    LOOP ON (select point_set_field_id,attribute,field_type,data_domain from Openworks_SM.PointSetField where point_set_id = GetXYPointSetBlob.pointSetID AND field_type=GetXYPointSetBlob.fieldType) AS PSF
    BEGIN
        IF ((lower(PSF.attribute) = lower('X')) OR (lower(PSF.attribute) = lower('Y')))
        BEGIN
            VARIABLES.pointSetFieldID = PSF.point_set_field_id;
            BREAK;
        END
        VARIABLES.pointSetFieldID = PSF.point_set_field_id;
    END

    select data from Openworks_SM.PointSetField where point_set_field_id = VARIABLES.pointSetFieldID;

END;



/*
****************************************
*    Virtual Procedure - GetZPointSetBlob
****************************************
*/

CREATE VIRTUAL PROCEDURE GetZPointSetBlob(pointSetFieldID integer) RETURNS (pointSetBlob Blob) AS
BEGIN

    select data from Openworks_SM.PointSetField where point_set_field_id = GetZPointSetBlob.pointSetFieldID;

END;




/*
****************************************
*    Virtual Procedure - ZPointSetTable
****************************************
*/

CREATE VIRTUAL PROCEDURE ZPointSetTable() RETURNS (pointSetId Integer,pointSetFieldId Integer,z_domain string,min_z float,max_z float,z_unit string,z_unit_type string,datum float, datum_unit string) AS
BEGIN
    DECLARE string VARIABLES.bestPointSetFieldID='0';
    DECLARE string VARIABLES.pointSetFieldID='0';
    DECLARE string VARIABLES.currentPointSetID='0';
	DECLARE string VARIABLES.currentLoopID='0';
	DECLARE string VARIABLES.foundBestOne='false';

    INSERT INTO #TmpPsfTbl(#TmpPsfTbl.pointSetFieldID) VALUES ('0');

	INSERT INTO #TmpPsfDataTbl(point_set_id , point_set_field_id , attribute, data_domain ,min_val , max_val, min_val_dsdsunit , unit_type_id,working_datum,working_datum_dsdsunit )
    select cast(point_set_id AS integer), cast(point_set_field_id AS integer), attribute, data_domain,min_val,max_val,min_val_dsdsunit,unit_type_id,working_datum,working_datum_dsdsunit from  Openworks_SM.PointSetField where field_type=3 AND data_domain IN ('MD','TVD','TVDSS','SSTVD','TIME','DEPTH') AND  lower(unit_type_id) IN ('depth measure' , 'seismic time') order by point_set_id;

        LOOP ON (select point_set_id, point_set_field_id,attribute,unit_type_id from #TmpPsfDataTbl order by point_set_id) AS PSF
        BEGIN

            IF(VARIABLES.currentPointSetID = '0')
            BEGIN
                VARIABLES.currentPointSetID = PSF.point_set_id;
            END

            VARIABLES.currentLoopID = PSF.point_set_id;
            IF(VARIABLES.currentPointSetID <> VARIABLES.currentLoopID)
            BEGIN
                IF(VARIABLES.bestPointSetFieldID <> '0')
                BEGIN
                    INSERT INTO #TmpPsfTbl(#TmpPsfTbl.pointSetFieldID) VALUES (VARIABLES.bestPointSetFieldID);
                END
                ELSE
                BEGIN
                    IF(VARIABLES.pointSetFieldID <> '0')
                    BEGIN
                        INSERT INTO #TmpPsfTbl(#TmpPsfTbl.pointSetFieldID) VALUES (VARIABLES.pointSetFieldID);
                    END
                END
                VARIABLES.bestPointSetFieldID = '0';
                VARIABLES.pointSetFieldID = '0';
                VARIABLES.currentPointSetID = PSF.point_set_id;
				VARIABLES.foundBestOne='false';
            END
			ELSE
			BEGIN
			    IF(VARIABLES.foundBestOne = 'true')
				BEGIN
				    CONTINUE;
				END
			END

              IF (isAttributeZField(PSF.attribute))
                BEGIN
                    VARIABLES.bestPointSetFieldID = PSF.point_set_field_id;
					VARIABLES.foundBestOne='true';
                    CONTINUE;
                END
                IF(VARIABLES.pointSetFieldID = '0')
					BEGIN
						VARIABLES.pointSetFieldID = PSF.point_set_field_id;
					END
        END
        IF(VARIABLES.bestPointSetFieldID <> '0')
        BEGIN
            INSERT INTO #TmpPsfTbl(#TmpPsfTbl.pointSetFieldID) VALUES (VARIABLES.bestPointSetFieldID);
        END
        ELSE
        BEGIN
            IF(VARIABLES.pointSetFieldID <> '0')
            BEGIN
                INSERT INTO #TmpPsfTbl(#TmpPsfTbl.pointSetFieldID) VALUES (VARIABLES.pointSetFieldID);
            END
        END

    select point_set_id,point_set_field_id, data_domain,min_val,max_val,min_val_dsdsunit,unit_type_id,working_datum,working_datum_dsdsunit from
	#TmpPsfDataTbl,#TmpPsfTbl where #TmpPsfDataTbl.point_set_field_id= #TmpPsfTbl.pointSetFieldID;

END;



/*
*************************************************
*    Virtual Procedure - DeterminePointSetFieldZ
*************************************************
*/

CREATE VIRTUAL PROCEDURE DeterminePointSetFieldZ(pointSetID integer,fieldType integer) RETURNS (pointSetField integer) AS
BEGIN
    DECLARE string VARIABLES.bestPointSetFieldID=0;
    DECLARE string VARIABLES.pointSetFieldID=0;
        LOOP ON (select point_set_field_id,attribute,field_type,data_domain,unit_type_id from Openworks_SM.PointSetField where point_set_id = DeterminePointSetFieldZ.pointSetID AND field_type=3) AS PSF
        BEGIN
            IF((PSF.data_domain IN('MD','TVD','TVDSS','SSTVD','TIME')) AND ((lower(PSF.unit_type_id) = lower('depth measure')) OR (lower(PSF.unit_type_id) = lower('seismic time'))))
            BEGIN
                IF ((lower(PSF.attribute) = lower('Z')) OR (lower(PSF.attribute) = lower('Z Value')))
                BEGIN
                    VARIABLES.bestPointSetFieldID = PSF.point_set_field_id;
                    BREAK;
                END
                VARIABLES.bestPointSetFieldID = PSF.point_set_field_id;
            END ELSE
            BEGIN
                IF((PSF.data_domain IN('MD','TVD','TVDSS','SSTVD','TIME')) OR ((lower(PSF.unit_type_id) = lower('depth measure')) OR (lower(PSF.unit_type_id) = lower('seismic time'))))
                BEGIN
                    IF ((lower(PSF.attribute) = lower('Z')) OR (lower(PSF.attribute) = lower('Z Value')))
                    BEGIN
                        IF(bestPointSetFieldID = 0)
                        BEGIN
                            VARIABLES.bestPointSetFieldID = PSF.point_set_field_id;
                        END
                    END
                    VARIABLES.pointSetFieldID = PSF.point_set_field_id;

                END ELSE
                BEGIN
                    IF ((lower(PSF.attribute) = lower('Z')) OR (lower(PSF.attribute) = lower('Z Value')))
                    BEGIN
                        IF(pointSetFieldID = 0)
                        BEGIN
                            VARIABLES.pointSetFieldID = PSF.point_set_field_id;
                        END
                    END
                END
                IF(pointSetFieldID = 0)
                BEGIN
                    VARIABLES.pointSetFieldID = PSF.point_set_field_id;
                END
            END
        END

        IF(VARIABLES.bestPointSetFieldID = 0)
        BEGIN
            VARIABLES.bestPointSetFieldID = VARIABLES.pointSetFieldID;
        END

        select cast(point_set_field_id AS integer) from Openworks_SM.PointSetField where point_set_field_id = VARIABLES.bestPointSetFieldID;

END;

/*
*************************************************
*    Virtual Procedure - LogCurveRead
*************************************************
* Purpose
* Reads the log curve data for a given depth or time range.
* Input parameters
*  native_uid    � The native uid for the log curve to be read.
*  start_index   - Specifies the start depth or start time from which the user is requesting the log curve data.
*                  If the depth/time specified is not part of the index curve, read the first depth/time prior to this index.
*                  If this value is null, then the start_index will be the first depth/time index value.
*  end_index     - Specifies the end depth or end time to which the user is requesting the log curve data.
*                  If the depth/time specified is not part of the index curve, read the first depth/time that is available after this value.
*                  If this value is null and the no of samples is also null, then the end_index will be the last depth/time index value.
*  no_of_samples   The total no of samples to be read from the start index.
*                  If  no_of_samples is specified the end_index will be ignored.
*                  If this value is null and the end_index is also null, then the end_index will be the last depth/time index value.
*
* Output
*  curve_data  The actual curve data blob. Contains an array of curve data values the curve_data should be represented as a log curve protobuf object
*               that holds some the necessary header as well as the curve data. If the curve_data is a non-periodic curve, the index curve values also need
*               to be passed along with curve data values
*/


CREATE VIRTUAL PROCEDURE LogCurveRead(native_uid string, start_index double,end_index double,no_of_samples integer) RETURNS (curve_data BLOB) AS
BEGIN
    SELECT curve_data FROM (EXEC Openworks_SM.LogCurveRead(native_uid,start_index,end_index,no_of_samples)) AS curve_data;
END;


/*
*************************************************
*    Virtual Procedure - LogCurveReadJSON
*************************************************
* Purpose
* Reads the log curve data for a given depth or time range.
* Input parameters
*  native_uid  � The native uid for the log curve to be read.
*  start_index   - Specifies the start depth or start time from which the user is requesting the log curve data.
*                  If the depth/time specified is not part of the index curve, read the first depth/time prior to this index.
*                  If this value is null, then the start_index will be the first depth/time index value.
*  end_index     - Specifies the end depth or end time to which the user is requesting the log curve data.
*                  If the depth/time specified is not part of the index curve, read the first depth/time that is available after this value.
*                  If this value is null and the no of samples is also null, then the end_index will be the last depth/time index value.
*  no_of_samples  The total no of samples to be read from the start index.
*                 If  no_of_samples is specified the end_index will be ignored.
*                  If this value is null and the end_index is also null, then the end_index will be the last depth/time index value.
*
* Output
*  curve_data  The actual curve data blob. Contains an array of curve data values the curve_data should be represented as a log curve protobuf object
*               that holds some the necessary header as well as the curve data. If the curve_data is a non-periodic curve, the index curve values also need
*               to be passed along with curve data values
*/

CREATE VIRTUAL PROCEDURE LogCurveReadJSON(native_uid string, start_index double,end_index double,no_of_samples integer) RETURNS (curve_data CLOB) AS
BEGIN
    DECLARE blob logCurveData = SELECT curve_data FROM (EXEC Openworks_SM.LogCurveRead(native_uid,start_index,end_index,no_of_samples)) AS curve_data;
    select LogCurveDataInJSON(logCurveData);
END;

/*
*************************************************
**    Virtual Procedure - LogCurveReadBySamples
*
* Purpose
* Reads the log curve data for a given sample range.
*
* Input parameters
*  native_uid     The native uid for the log curve to be read.
*  start_sample_no - Specifies the sample number, from which the log curve needs to be read.
*                    Number of first sample is 1.
*                    If this value is null, then the Start_sample will be the first sample value.
*  no_of_samples    The total no of samples to be read from the start sample.
*                    If this value is null, then read all the samples from the start_sample.
*
* Output
* curve_data  The actual curve data blob. Contains an array of curve data values the curve_data should be represented as a log curve protobuf object
*             that holds some the necessary header as well as the curve data. If the curve_data is a non-periodic curve, the index curve values also need
*             to be passed along with curve data values.
*
*
*************************************************
*/

CREATE VIRTUAL PROCEDURE LogCurveReadBySamples(native_uid string, start_sample_no integer,no_of_samples integer) RETURNS (curve_data BLOB) AS
BEGIN
    SELECT curve_data FROM (EXEC Openworks_SM.LogCurveReadBySamples(native_uid,start_sample_no,no_of_samples)) AS curve_data;
END;


/*
****************************************************
*    Virtual Procedure - LogCurveReadBySamplesJSON
****************************************************
* Purpose
* Reads the log curve data for a given sample range.
*
* Input parameters
*  native_uid      � The native uid for the log curve to be read.
*  start_sample_no - Specifies the sample number, from which the log curve needs to be read.
*                    Number of first sample is 1.
*                    If this value is null, then the Start_sample will be the first sample value.
*  no_of_samples    The total no of samples to be read from the start sample.
*                    If this value is null, then read all the samples from the start_sample.
*
* Output
* curve_data  The actual curve data blob. Contains an array of curve data values the curve_data should be represented as a log curve protobuf object
*             that holds some the necessary header as well as the curve data. If the curve_data is a non-periodic curve, the index curve values also need
*             to be passed along with curve data values.
*
*
*************************************************
*/

CREATE VIRTUAL PROCEDURE LogCurveReadBySamplesJSON(native_uid string, start_sample_no integer,no_of_samples integer) RETURNS (curve_data CLOB) AS
BEGIN
    DECLARE blob logCurveData = SELECT curve_data FROM (EXEC Openworks_SM.LogCurveReadBySamples(native_uid,start_sample_no,no_of_samples)) AS curve_data;
    select LogCurveDataInJSON(logCurveData);
END;

/*
*************************************************
*    Virtual Procedure - LogReadJSON
*************************************************
*/
CREATE VIRTUAL PROCEDURE LogReadJSON(wellbore_uwi string,frameworkObsNo integer, log_name string, log_version string, log_run_no integer, log_pass string, requested_mode string,offset_value integer,length integer,starttime timestamp, time_offset_in_seconds integer) RETURNS (log_data CLOB) AS
BEGIN
DECLARE string well_id = (select wellid from OpenWorks_SM.WellEntire where uwi=wellbore_uwi);
select log_data from (EXEC Openworks_SM.LogReadJSON(well_id,frameworkObsNo,log_run_no,log_name,log_pass,requested_mode,offset_value,length)) as log_data;

END;

/*
*************************************************
*    Virtual Procedure - LogCurveReadProtoBuf
*************************************************
*/

CREATE VIRTUAL PROCEDURE LogCurveReadProtoBuf(wellbore_uwi string, log_curve_name string,log_curve_version string,log_name string, log_version string, log_run_no integer, log_pass string, requested_mode string,offset_value integer,length integer,starttime timestamp, time_offset integer)  RETURNS (startIndexTime string, startIndexDepth double, increment double, indexType string, curveData blob) AS
BEGIN
DECLARE string well_id = (select wellid from OpenWorks_SM.WellEntire where uwi=wellbore_uwi);
DECLARE string logCurveId = (SELECT log_curve_id  FROM Openworks_SM.LogCurve where wellid=well_id and log_crv_name=log_curve_name and  log_crv_version = log_curve_version and log_name=log_name and log_run_no= log_run_no and log_pass_id=log_pass);
select startIndexTime,startIndexDepth,increment,indexType,curveData from  (EXEC Openworks_SM.LogCurveReadProtoBuf(cast(logCurveId AS integer),requested_mode,offset_value,length)) as log_curve;
END;

/*
*************************************************
*    Virtual Procedure - LogReadProtoBuf
*************************************************
*/
CREATE VIRTUAL PROCEDURE LogReadProtoBuf(wellbore_uwi string,frameworkObsNo integer,log_name string, log_version string, log_run_no integer, log_pass string, requested_mode string,offset_value integer,length integer,starttime timestamp, time_offset_in_seconds integer) RETURNS (startIndexTime string, startIndexDepth double, increment double, indexType string, curveData blob) AS
BEGIN
DECLARE string well_id = (select wellid from OpenWorks_SM.WellEntire where uwi=wellbore_uwi);
select startIndexTime,startIndexDepth,increment,indexType,curveData from  (EXEC Openworks_SM.LogReadProtoBuf(well_id,frameworkObsNo,log_run_no,log_name,log_pass,requested_mode,offset_value,length)) as log;
END;


CREATE VIRTUAL PROCEDURE NextVal(entityName string) RETURNS(native_uid integer) AS
BEGIN
DECLARE string tableName = NextVal.entityName;
IF (lower(NextVal.entityName) = lower('Well'))
BEGIN
  tableName = 'WellLocation';
END
  select SysGenId as native_uid from  (EXEC Openworks_SM.NextVal(tableName)) as next_val;
END;

/*
**************************************************
*  Virtual Procedure - LogCurveWrite
**************************************************
*/

/*
Purpose Replace or append to an existing log curve.

Input parameters
  native_uid � the native uid for the existing log curve.
  curve_data � The actual curve data blob. Contains an array of curve data values the curve_data should be represented as a log curve protobuf object that
               holds some the necessary header as well as the curve data. If the curve_data is a non-periodic curve, the index curve values also need to be
               passed along with curve data values.
  write_mode � replace or append. Default is append.

Output
status �  success = 0/ error = -1
*/

CREATE VIRTUAL PROCEDURE LogCurveWrite (native_uid string, curve_data blob, write_mode string) RETURNS (status boolean) AS
BEGIN
    DECLARE boolean VARIABLES.status;
    SELECT VARIABLES.status;
END;

/*
Purpose Get all the CurveSets belonging to a welllog.

Input parameters
  welllog_native_uid � the native uid for the welllog.

Output
status �  success = 0/ error = -1
*/


CREATE VIRTUAL PROCEDURE GetCurveSetList (welllog_native_uid string, curveIds object) RETURNS (curveset_id string) AS
BEGIN

      DECLARE integer VARIABLES.curveCount=0;
      DECLARE integer VARIABLES.iter=0;
      DECLARE string VARIABLES.id='';
      DECLARE object VARIABLES.curveIdArray = null;

      CREATE LOCAL TEMPORARY TABLE #temp (Id string);

      IF(curveIds IS NOT NULL)
      BEGIN
        curveIdArray = getArray(curveIds);
          curveCount = array_length(curveIdArray);
      END
      WHILE (iter < curveCount)
      BEGIN
        id = cast(curveIdArray[iter+1] as string);
        Insert into #temp values(id);
          iter = iter+1;
      END

      IF(curveCount > 0)
      BEGIN
           SELECT distinct cast(jsonobject(ROUND(index_min,4) as index_min,ROUND(index_max,4) as index_max,ROUND(index_increment,4) as index_increment,index_unit as index_unit,total_samples as total_samples) as string) from openworksCommonmodel.logcurve where welllog_native_uid = GetCurveSetList.welllog_native_uid AND native_uid IN (SELECT id from #temp);
      END
      ELSE
      BEGIN
          SELECT distinct cast(jsonobject(ROUND(index_min,4) as index_min,ROUND(index_max,4) as index_max,ROUND(index_increment,4) as index_increment,index_unit as index_unit,total_samples as total_samples) as string) from openworksCommonmodel.logcurve where welllog_native_uid = GetCurveSetList.welllog_native_uid;
      END
END;


CREATE VIRTUAL PROCEDURE GetParentId (seis_geom_set string, horizon_nm string, data_source string, interep_version_name string) RETURNS (parent_id string) AS
BEGIN

      DECLARE integer VARIABLES.ValCount=0;


      CREATE LOCAL TEMPORARY TABLE #temp (Id string,name string);

      insert into #temp SELECT hd.horizon_data_id,HAH.horizon_name FROM OpenWorks_SM.HorizonData HD INNER JOIN OpenWorks_SM.HorizonAttributeHdr HAH ON HD.horizon_attr_hdr_id = HAH.horizon_attr_hdr_id WHERE hd.seis_geom_set_id = seis_geom_set AND HAH.horizon_attr_name IN ('TIME_STRUCTURE', 'DEPTH_STRUCTURE') AND horizon_nm LIKE '%'||HAH.horizon_name||'%' /*AND HAHdr.data_source = HAH.data_source*/ AND interep_version_name = HAH.interpretation_version_name ORDER BY HD.create_date;

      valCount = select count(*) from #temp where name = horizon_nm;

	  IF(valCount > 0)
      BEGIN
           select id from #temp where name = horizon_nm LIMIT 1;
      END
      ELSE
      BEGIN
          select id from #temp LIMIT 1;
      END
END;


CREATE VIRTUAL PROCEDURE CurveSetRead (welllog_native_uid string,curve_set_id string,curveIds object,start_index double,end_index double,index_unit string) RETURNS (curveSetData blob) AS
BEGIN
   DECLARE integer VARIABLES.curveCount=0;
   DECLARE integer VARIABLES.iter=0;
   DECLARE string VARIABLES.log_curve_id = null;
   DECLARE object VARIABLES.curveList = null;
   DECLARE object VARIABLES.finalCurveList = null;
   DECLARE blob VARIABLES.curveset_data = null;
   DECLARE double VARIABLES.index_min=0;
   DECLARE double VARIABLES.index_max=-1;
    DECLARE string VARIABLES.indexUnit = '';

   DECLARE double VARIABLES.curveset_index_min = cast(getJSONElementValue(curve_set_id,'index_min') as double);
   DECLARE double VARIABLES.curveset_index_max = cast(getJSONElementValue(curve_set_id,'index_max') as double);
   DECLARE string VARIABLES.curveset_index_unit = getJSONElementValue(curve_set_id,'index_unit');
   DECLARE double VARIABLES.curveset_index_increment = cast(getJSONElementValue(curve_set_id,'index_increment') as double);
   DECLARE integer VARIABLES.total_samples = cast(getJSONElementValue(curve_set_id,'total_samples') as integer);

   IF(CurveSetRead.start_index IS NOT NULL)
   BEGIN
           VARIABLES.index_min = CurveSetRead.start_index;
   END

   IF(CurveSetRead.end_index IS NOT NULL)
   BEGIN
           VARIABLES.index_max = CurveSetRead.end_index;
   END

   IF(CurveSetRead.index_unit IS NOT NULL)
   BEGIN
           VARIABLES.indexUnit = CurveSetRead.index_unit;
   END


   curveList = select column2SArray(native_uid) from openworksCommonmodel.logcurve where welllog_native_uid = CurveSetRead.welllog_native_uid AND ROUND(index_min,4)=ROUND(VARIABLES.curveset_index_min,4) and ROUND(index_max,4) = ROUND(VARIABLES.curveset_index_max,4) and index_unit = VARIABLES.curveset_index_unit and ROUND(index_increment,4) = ROUND(VARIABLES.curveset_index_increment,4) and total_samples = VARIABLES.total_samples and sample_type='VALUE';
   finalCurveList = getFinalLogCurveIds(curveList,curveIds);

   SELECT curve_data from (EXEC Openworks_SM.LogRead(finalCurveList,VARIABLES.index_min,VARIABLES.index_max,-98765,VARIABLES.indexUnit)) AS curve_data;

END;

CREATE VIRTUAL PROCEDURE LogRead(welllog_native_uid string, curveIds object, start_index double,end_index double,resample_increment double, resample_unit string) RETURNS (curveSetData blob) AS
BEGIN
   DECLARE double VARIABLES.index_min=0;
   DECLARE double VARIABLES.index_max=-1;
   DECLARE double VARIABLES.index_increment=-98765.0;
   DECLARE string VARIABLES.log_curve_id = null;
   DECLARE object VARIABLES.curveList = null;
   DECLARE object VARIABLES.finalCurveList = null;
   DECLARE blob VARIABLES.curveset_data = null;
   DECLARE string VARIABLES.index_unit = '';

   INSERT INTO #TmpTbl(#TmpTbl.index_min,#TmpTbl.index_max,#TmpTbl.curve_list) select min(index_min), max(index_max), column2SArray(native_uid) from openworksCommonmodel.logcurve where welllog_native_uid = LogRead.welllog_native_uid and sample_type='VALUE';
   VARIABLES.index_min = (select #TmpTbl.index_min from #TmpTbl);
   VARIABLES.index_max = (select #TmpTbl.index_max from #TmpTbl);
   VARIABLES.curveList = (select #TmpTbl.curve_list from #TmpTbl);


   IF(LogRead.resample_increment IS NOT NULL AND LogRead.resample_increment <> 0)
   BEGIN
       VARIABLES.index_increment = LogRead.resample_increment;
   END
   ELSE
   BEGIN
          VARIABLES.index_increment = select min(index_increment) from openworksCommonmodel.logcurve where welllog_native_uid = LogRead.welllog_native_uid and index_increment <> 0 and sample_type='VALUE';
          IF(VARIABLES.index_increment IS NULL)
        BEGIN
            VARIABLES.index_increment = -98765.0;
        END
   END

   finalCurveList = getFinalLogCurveIds(curveList,curveIds);

   IF(LogRead.start_index IS NOT NULL AND LogRead.start_index <> 0)
   BEGIN
           VARIABLES.index_min = LogRead.start_index;
   END

   IF(LogRead.end_index IS NOT NULL AND LogRead.end_index <> -1)
   BEGIN
           VARIABLES.index_max = LogRead.end_index;
   END

   IF(LogRead.resample_unit IS NOT NULL)
   BEGIN
           VARIABLES.index_unit = LogRead.resample_unit;
   END
   SELECT curve_data from (EXEC Openworks_SM.LogRead(finalCurveList,VARIABLES.index_min,VARIABLES.index_max,VARIABLES.index_increment,VARIABLES.index_unit)) AS curve_data;
END;

CREATE VIRTUAL PROCEDURE GetConvergenceAngleForCoordinate (crs string, x double, y double) RETURNS (convergence_angle double) AS
BEGIN
    DECLARE DOUBLE convergenceAngle = azimuthConversion(crs, x, y);
    SELECT VARIABLES.convergenceAngle;
END;

CREATE VIRTUAL PROCEDURE GetConvergenceAngleForProjectCRS (wellid string) RETURNS (convergence_angle double) AS
BEGIN
        INSERT INTO #TmpTbl (#TmpTbl.surfaceX, #TmpTbl.surfaceY, #TmpTbl.surfaceUnits) select x_coordinate,y_coordinate,x_coordinate_dsdsunit from OpenWorks_SM.WellEntire where wellid = GetConvergenceAngleForProjectCRS.wellid;

        DECLARE double VARIABLES.surfaceX = (select #TmpTbl.surfaceX from #TmpTbl);
        DECLARE double VARIABLES.surfaceY = (select #TmpTbl.surfaceY from #TmpTbl);
        DECLARE string VARIABLES.surfaceUnits = (select #TmpTbl.surfaceUnits from #TmpTbl);

        DECLARE string VARIABLES.targetCRS = (Select name from OpenWorks_SM.CartoRefSys,OpenWorks_SM.Project where OpenWorks_SM.CartoRefSys.id = OpenWorks_SM.Project.xy_crs_id);

    DECLARE DOUBLE convergenceAngle = azimuthConversion(targetCRS, surfaceX, surfaceY);
    SELECT VARIABLES.convergenceAngle;
END;

/*
*
****************************************************************************************
   Virtual Procedure - ReadTraceData3D

   Generates the Trace data in protobuf format from SeismicDataSet3D blob

   Input parameters
    •    native_uid   : Id of the dataset for which the trace data is required
    •    start_inline : start inline for trace data
    •    end_inline   : end inline for trace data
    •    start_xline  : start xline for trace data
    •    end_xline    : end xline for trace data
    •    start_sample : start sample for trace data
    •    end_sample   : end sample for trace data

*****************************************************************************************/

CREATE VIRTUAL PROCEDURE ReadTraceData3D(native_uid string, start_inline double, end_inline double, start_xline double, end_xline double, start_sample double, end_sample double) RETURNS (seismic_data BLOB) AS
BEGIN
    SELECT seismic_data FROM (EXEC Openworks_SM.SeismicTraceRead(native_uid,start_inline, end_inline, start_xline, end_xline, start_sample, end_sample, 'TRACE', 'XYZ')) AS seismic_data;
END;

/*
*************************************************
   Virtual Procedure - ReadTraceData2D


   Generates the Trace data in protobuf format from SeismicDataSet2D blob

   Input parameters
    •    native_uid   : Id of the dataset for which the trace data is required
    •    start_trace  : start trace for trace data
    •    end_trace    : end trace for trace data
    •    start_sample : start sample for trace data
    •    end_sample   : end sample for trace data
******************************************************************/

CREATE VIRTUAL PROCEDURE ReadTraceData2D(native_uid string, start_trace double, end_trace double, start_sample double, end_sample double) RETURNS (seismic_data BLOB) AS
BEGIN
    SELECT seismic_data FROM (EXEC Openworks_SM.SeismicTraceRead(native_uid, 1 , 1 , start_trace, end_trace, start_sample, end_sample, 'TRACE', 'XYZ')) AS seismic_data;
END;


/*

CREATE VIRTUAL PROCEDURE GetWellLogIDs(curveIds string[]) RETURNS (welllog_native_uid string) AS
BEGIN
   DECLARE integer VARIABLES.curveCount=0;
   DECLARE integer VARIABLES.iter=0;
   DECLARE string VARIABLES.inClause='';

   IF(curveIds IS NOT NULL)
   BEGIN
       curveCount = array_length(curveIds);
   END
   WHILE (iter < curveCount)
   BEGIN
       IF(iter+1 < curveCount)
       BEGIN
           inClause = inClause||curveIds[iter+1]||',';
        END
       ELSE
       BEGIN
           inClause = inClause||curveIds[iter+1];
       END
       iter = iter+1;
   END
   EXECUTE IMMEDIATE 'SELECT distinct welllog_native_uid from OpenworksCommonModel.logcurve where native_uid IN ('||inClause||')';
END;
*/

 /*
****************************************
*    Virtual Procedure - FaultPlane
****************************************
*/

CREATE VIRTUAL PROCEDURE FaultPlaneRead(native_uid string, seismic_data_set_native_uid string) RETURNS (data blob) AS
BEGIN


   SELECT * FROM  ( EXEC Openworks_SM.FaultPlaneRead(native_uid,seismic_data_set_native_uid)) AS data;

END;

CREATE VIRTUAL PROCEDURE convertPosLogToTargetCRS(native_uid string,cartosystem string,measurementsystem string) RETURNS (data CLOB) AS
BEGIN

	DECLARE string VARIABLES.target_measurement_system = NULL;
	DECLARE string VARIABLES.target_crs = NULL;
	VARIABLES.target_measurement_system = CONVERT((SELECT teiid_session_get('measurementsystem')),STRING);
	VARIABLES.target_crs = CONVERT((SELECT teiid_session_get('cartosystem')),STRING);
	IF((VARIABLES.target_measurement_system IS NULL) AND (convertPosLogToTargetCRS.measurementsystem IS NOT NULL))
	BEGIN
	    VARIABLES.target_measurement_system = convertPosLogToTargetCRS.measurementsystem;
	    DECLARE string VARIABLES.setms = CONVERT((SELECT teiid_session_set('measurementsystem',VARIABLES.target_measurement_system)),STRING);
	END
	IF((VARIABLES.target_crs IS NULL) AND (convertPosLogToTargetCRS.cartosystem IS NOT NULL))
	BEGIN
	    VARIABLES.target_crs = convertPosLogToTargetCRS.cartosystem;
	    DECLARE string VARIABLES.setcrs = CONVERT((SELECT teiid_session_set('cartosystem',VARIABLES.target_crs)),STRING);
	END
    INSERT INTO #TmpTbl1 (#TmpTbl1.wellbore_native_uid,#TmpTbl1.crs,#TmpTbl1.xy_offset_unit,#TmpTbl1.data)select wellbore_native_uid,crs,xy_offset_unit,data from PositionLog where native_uid = convertPosLogToTargetCRS.native_uid;
	DECLARE string VARIABLES.wellbore_id=(select #TmpTbl1.wellbore_native_uid from #TmpTbl1);
	DECLARE string VARIABLES.source_crs=(select #TmpTbl1.crs from #TmpTbl1);
	DECLARE string VARIABLES.offset_unit=(select #TmpTbl1.xy_offset_unit from #TmpTbl1);
	DECLARE Blob VARIABLES.data=(select #TmpTbl1.data from #TmpTbl1);

	IF(VARIABLES.wellbore_id IS NOT NULL)
	BEGIN
       INSERT INTO #TmpTbl (#TmpTbl.surfaceX, #TmpTbl.surfaceY, #TmpTbl.surfaceUnits) select x_coordinate,y_coordinate,x_coordinate_dsdsunit from OpenWorks_SM.WellEntire where wellid = VARIABLES.wellbore_id;

       DECLARE double VARIABLES.surface_x = (select #TmpTbl.surfaceX from #TmpTbl);
       DECLARE double VARIABLES.surface_y = (select #TmpTbl.surfaceY from #TmpTbl);
       DECLARE string VARIABLES.surface_units = (select #TmpTbl.surfaceUnits from #TmpTbl);
	   DECLARE string VARIABLES.projected_crs=(select xy_crs from OpenWorksCommonModel.Project);


	   select convertPosLogToTargetCRS2(VARIABLES.source_crs,VARIABLES.projected_crs, VARIABLES.surface_x, VARIABLES.surface_y, VARIABLES.surface_units, VARIABLES.offset_unit, VARIABLES.data, VARIABLES.target_crs,VARIABLES.target_measurement_system);
	END
END;

CREATE VIRTUAL PROCEDURE convertSurveyDataToTargetCRS(native_uid string,cartosystem string,measurementsystem string) RETURNS (data CLOB) AS
BEGIN

	DECLARE string VARIABLES.target_measurement_system = NULL;
	DECLARE string VARIABLES.target_crs = NULL;
	VARIABLES.target_measurement_system = CONVERT((SELECT teiid_session_get('measurementsystem')),STRING);
	VARIABLES.target_crs = CONVERT((SELECT teiid_session_get('cartosystem')),STRING);
	IF((VARIABLES.target_measurement_system IS NULL) AND (convertSurveyDataToTargetCRS.measurementsystem IS NOT NULL))
	BEGIN
	    VARIABLES.target_measurement_system = convertSurveyDataToTargetCRS.measurementsystem;
	    DECLARE string VARIABLES.setms = CONVERT((SELECT teiid_session_set('measurementsystem',VARIABLES.target_measurement_system)),STRING);
	END
	IF((VARIABLES.target_crs IS NULL) AND (convertSurveyDataToTargetCRS.cartosystem IS NOT NULL))
	BEGIN
	    VARIABLES.target_crs = convertSurveyDataToTargetCRS.cartosystem;
	    DECLARE string VARIABLES.setcrs = CONVERT((SELECT teiid_session_set('cartosystem',VARIABLES.target_crs)),STRING);
	END
    INSERT INTO #TmpTbl1 (#TmpTbl1.wellbore_native_uid,#TmpTbl1.crs,#TmpTbl1.tie_pt_md,#TmpTbl1.md_unit,#TmpTbl1.tie_pt_tvd,#TmpTbl1.tvd_unit,#TmpTbl1.tie_pt_x_offset,#TmpTbl1.tie_pt_y_offset,#TmpTbl1.xy_offset_unit,#TmpTbl1.tie_pt_initial_azimuth,#TmpTbl1.azimuth_unit,#TmpTbl1.tie_pt_initial_angle,#TmpTbl1.inclination_unit,#TmpTbl1.data)select wellbore_native_uid,crs,tie_pt_md,md_unit,tie_pt_tvd,tvd_unit,tie_pt_x_offset,tie_pt_y_offset,xy_offset_unit,tie_pt_initial_azimuth,azimuth_unit,tie_pt_initial_angle,inclination_unit,data from DirectionalSurvey where native_uid = convertSurveyDataToTargetCRS.native_uid;
	DECLARE string VARIABLES.wellbore_id=(select #TmpTbl1.wellbore_native_uid from #TmpTbl1);
	DECLARE string VARIABLES.source_crs=(select #TmpTbl1.crs from #TmpTbl1);
	DECLARE float VARIABLES.tie_pt_md=(select NVL(#TmpTbl1.tie_pt_md,0) from #TmpTbl1);
	DECLARE string VARIABLES.md_unit=(select #TmpTbl1.md_unit from #TmpTbl1);
	DECLARE float VARIABLES.tie_pt_tvd=(select NVL(#TmpTbl1.tie_pt_tvd,0) from #TmpTbl1);
	DECLARE string VARIABLES.tvd_unit=(select #TmpTbl1.tvd_unit from #TmpTbl1);
	DECLARE float VARIABLES.tie_pt_x_offset=(select NVL(#TmpTbl1.tie_pt_x_offset,0) from #TmpTbl1);
	DECLARE float VARIABLES.tie_pt_y_offset=(select NVL(#TmpTbl1.tie_pt_y_offset,0) from #TmpTbl1);
	DECLARE string VARIABLES.xy_offset_unit=(select #TmpTbl1.xy_offset_unit from #TmpTbl1);
	DECLARE float VARIABLES.tie_pt_azi=(select NVL(#TmpTbl1.tie_pt_initial_azimuth,0) from #TmpTbl1);
	DECLARE string VARIABLES.azimuth_unit=(select #TmpTbl1.azimuth_unit from #TmpTbl1);
	DECLARE float VARIABLES.tie_pt_inc=(select NVL(#TmpTbl1.tie_pt_initial_angle,0) from #TmpTbl1);
	DECLARE string VARIABLES.inclination_unit=(select #TmpTbl1.inclination_unit from #TmpTbl1);
	DECLARE Blob VARIABLES.data=(select #TmpTbl1.data from #TmpTbl1);

	IF(VARIABLES.wellbore_id IS NOT NULL)
	BEGIN
       INSERT INTO #TmpTbl (#TmpTbl.surfaceX, #TmpTbl.surfaceY, #TmpTbl.surfaceUnits,#TmpTbl.crs) select x_coordinate,y_coordinate,x_coordinate_dsdsunit,getDSDSCrs(OpenWorks_SM.CartoRefSys.name) AS crs from OpenWorks_SM.WellEntire, OpenWorks_SM.CartoRefSys  where orig_crs_id = id and wellid = VARIABLES.wellbore_id;

       DECLARE double VARIABLES.surface_x = (select #TmpTbl.surfaceX from #TmpTbl);
       DECLARE double VARIABLES.surface_y = (select #TmpTbl.surfaceY from #TmpTbl);
       DECLARE string VARIABLES.surface_units = (select #TmpTbl.surfaceUnits from #TmpTbl);
	   DECLARE string VARIABLES.well_crs=(select #TmpTbl.crs from #TmpTbl);
	   DECLARE string VARIABLES.projected_crs=(select xy_crs from OpenWorksCommonModel.Project);

	   IF(VARIABLES.source_crs IS NULL)
	   BEGIN
	     VARIABLES.source_crs=VARIABLES.well_crs;
	   END
	   IF(VARIABLES.source_crs != VARIABLES.well_crs)
	   BEGIN
	     DECLARE blob convertedXYBlob = cartoConvert(getDSDSCrs(VARIABLES.well_crs), getDSDSCrs(VARIABLES.source_crs),VARIABLES.surface_x, VARIABLES.surface_y, VARIABLES.surface_units);
         IF(convertedXYBlob IS NOT NULL)
         BEGIN
           VARIABLES.surface_x= fetchDElementValueFromBlob(convertedXYBlob,'x');
           VARIABLES.surface_y= fetchDElementValueFromBlob(convertedXYBlob,'y');
           VARIABLES.surface_units= fetchElementUnitNameFromBlob(convertedXYBlob,'x');
         END
	   END

	   select convertSurveyDataToTargetCRS(VARIABLES.source_crs,VARIABLES.projected_crs, VARIABLES.surface_x, VARIABLES.surface_y, VARIABLES.surface_units, VARIABLES.data, VARIABLES.tie_pt_md, VARIABLES.tie_pt_tvd, VARIABLES.tie_pt_x_offset, VARIABLES.tie_pt_y_offset, VARIABLES.tie_pt_azi, VARIABLES.tie_pt_inc, VARIABLES.md_unit, VARIABLES.tvd_unit, VARIABLES.xy_offset_unit, VARIABLES.azimuth_unit, VARIABLES.inclination_unit, VARIABLES.target_crs, VARIABLES.target_measurement_system);
	END
END;

/*
**********************************
* ENTITY: SeismicDataSet3DAttribute
**********************************
*/
CREATE VIEW SeismicDataSet3DAttribute
(
	native_uid                      VARCHAR(1024)               OPTIONS("OpenWorksCommonModel:SeismicDataSet3DAttribute.native_uid.isUpdatable" false,
                                                                        "OpenWorksCommonModel:SeismicDataSet3DAttribute.native_uid.isCreatable" false,
                                                                        UPDATABLE 'FALSE'),
    seismic3dsurvey_native_uid      VARCHAR(1024),
    seismic_data_set_name           VARCHAR(256) NOT NULL,
	parent_seismic_data_set_native_uid		VARCHAR(1024),
	seismic_version_name            VARCHAR(40),
    binsetgrid3dgrid_native_uid     VARCHAR(1024),
    data_source                     VARCHAR(5),
    seismic_attribute_name          VARCHAR(40),
    interpretation_status           VARCHAR(12),
    seismic_class                   VARCHAR(12),
    attribute_unit                  VARCHAR(12),
    acquired_by                     VARCHAR(40),
    acquisition_date                TIMESTAMP,
    data_file_name                  VARCHAR(50) NOT NULL,
    data_file_format                VARCHAR(12),
    binary_data_format              VARCHAR(24),
    start_inline                    DOUBLE,
    end_inline                      DOUBLE,
    increment_inline                INTEGER,
    start_xline                     DOUBLE,
    end_xline                       DOUBLE,
    increment_xline                    INTEGER,
    num_traces                      INTEGER,
    min_amplitude                   DOUBLE,
    min_amplitude_unit              VARCHAR(64),
    max_amplitude                   DOUBLE,
    max_amplitude_unit              VARCHAR(64),
    polarity                        VARCHAR(40) DEFAULT 'UNKNOWN',
    processed_by                    VARCHAR(40),
    processed_date                  TIMESTAMP,
    total_size                      DOUBLE,
    total_size_unit                 VARCHAR(64),
    z_domain                        VARCHAR(12),
    z_start                         DOUBLE,
    z_start_unit                    VARCHAR(64),
    z_start_unittype                VARCHAR(64),
    z_start_actual                  DOUBLE,
    z_start_actual_unit             VARCHAR(64),
    z_start_actual_unittype         VARCHAR(64),
    z_sample_rate                   DOUBLE,
    z_sample_rate_unit              VARCHAR(64),
    z_sample_rate_unittype          VARCHAR(64),
    z_npts                          INTEGER,
    z_npts_actual                   INTEGER,
    data                            BLOB           NOT NULL    OPTIONS ("OpenWorksCommonModel:SeismicDataSet3DAttribute.data.isMedia" 'true',
                                                                        "OpenWorksCommonModel:SeismicDataSet3DAttribute.data.mediaContentType" 'application/octet-stream'),
    remark                          VARCHAR(200),
    create_date                     TIMESTAMP,
    create_user_id                  VARCHAR(32),
    update_date                     TIMESTAMP,
    update_user_id                  VARCHAR(32),
    alternate_uid    		                VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:SeismicDataSet3DAttribute.alternate_uid.isCreatable"  false,
                                                           "OpenWorksCommonModel:SeismicDataSet3DAttribute.alternate_uid.isUpdatable" false,
                                                           UPDATABLE 'FALSE'),

    CONSTRAINT SeismicDataSet3DAttribute_PK PRIMARY KEY (native_uid),

    CONSTRAINT SeismicDataSet3DAttribute_UK1 UNIQUE (seismic_data_set_name,seismic_version_name,seismic3dsurvey_native_uid),

    CONSTRAINT FK_SeismicDataSet3DAttribute_seismic3dsurvey_native_uid
    FOREIGN KEY               (seismic3dsurvey_native_uid)
    REFERENCES Seismic3DSurvey(native_uid),

    CONSTRAINT FK_SeismicDataSet3DAttribute_binsetgrid3dgrid_native_uid
    FOREIGN KEY                (binsetgrid3dgrid_native_uid)
    REFERENCES BinsetGrid3DGrid(native_uid)
)
OPTIONS (UPDATABLE 'TRUE', SeismicDataSet3DAttribute.IMPLEMENTED 'TRUE')
AS

SELECT
        A.seismic_data_set_id                    AS        native_uid,
        A.seis_geom_set_id                       AS        seismic3dsurvey_native_uid,
        A.seis_data_set_name                     AS        seismic_data_set_name,

		(select native_uid from OpenWorks_SM.SeismicDataSet SDS where SDS.r_seis_attr_nm = 'AMPLITUDE' and
		 SDS.seis_geom_set_id = A.seis_geom_set_id and
		SDS.binset_grid_id = A.binset_grid_id and
		A.seis_data_set_name LIKE '%'||SDS.seis_data_set_name||'%'  order by CHAR_LENGTH(SDS.seis_data_set_name) desc limit 1) as parent_seismic_data_set_native_uid,

        A.seismic_version_name                   AS        seismic_version_name,
        A.binset_grid_id                         AS        binsetgrid3dgrid_native_uid,
        A.data_source                            AS        data_source,
        A.r_seis_attr_nm                         AS        seismic_attribute_name,
        A.interpretation_status                  AS        interpretation_status,
        A.seismic_class                          AS        seismic_class,
        A.attribute_uom                          AS        attribute_unit,
        A.acquired_by                            AS        acquired_by,
        A.acquisition_date                       AS        acquisition_date,
        A.data_file_name                         AS        data_file_name,
        A.data_file_format                       AS        data_file_format,
        A.binary_data_format                     AS        binary_data_format,
        A.line_min                               AS        start_inline,
        A.line_max                               AS        end_inline,
        CASE
        WHEN B.grid_i_direction = 'TRACE' AND B.grid_jsize = 1 THEN
        1
        WHEN B.grid_i_direction = 'LINE' AND B.grid_isize = 1 THEN
        1
        WHEN B.grid_i_direction = 'TRACE' THEN
        CAST( ABS((B.line_at_isize_jsize - B.line_at_i1_j1 ) / (B.grid_jsize -1  )) AS integer )
        ELSE
        CAST( ABS((B.line_at_isize_jsize - B.line_at_i1_j1 ) / (B.grid_isize -1 )) AS integer )
        END                                      AS         increment_inline,
        A.trace_min                              AS        start_xline,
        A.trace_max                              AS        end_xline,
        CASE
        WHEN B.grid_i_direction = 'TRACE' AND B.grid_isize = 1 THEN
        1
        WHEN B.grid_i_direction = 'LINE' AND B.grid_jsize = 1 THEN
	    1
        WHEN B.grid_i_direction = 'TRACE'
        THEN
        CAST( ABS((B.trace_at_isize_jsize - B.trace_at_i1_j1 ) / (B.grid_isize -1 )) AS integer )
        ELSE
        CAST( ABS((B.trace_at_isize_jsize - B.trace_at_i1_j1 ) / (B.grid_jsize  -1 )) AS integer )
        END
                                                 AS         increment_xline,
        CASE
        WHEN B.grid_i_direction = 'TRACE' AND B.grid_jsize = 1 THEN
        CAST(((
            (line_max-line_min                                                          /*Line Differencce    */
            +1))                                                                        /*Add increment of 1 only*/
        *
            (trace_max-trace_min                                                        /*Trace Differencce    */
            +ABS((B.trace_at_isize_jsize - B.trace_at_i1_j1 ) / (B.grid_isize -1 )))    /*Add Trace Inc    */
             /ABS((B.trace_at_isize_jsize - B.trace_at_i1_j1 ) / (B.grid_isize -1 )))   /*Div by Trace Inc    */
         AS integer)
        WHEN B.grid_i_direction = 'TRACE' AND B.grid_isize = 1 THEN
        CAST(((
            (line_max-line_min                                                          /*Line Differencce    */
            +ABS((B.line_at_isize_jsize - B.line_at_i1_j1 ) / (B.grid_jsize -1 )))      /*Add Line Inc    */
            /ABS((B.line_at_isize_jsize - B.line_at_i1_j1 ) / (B.grid_jsize -1 )))      /*Div by Line Inc    */
        *
            (trace_max-trace_min                                                        /*Trace Differencce    */
            +1))                                                                        /*Add increment of 1 only*/
         AS integer)
        WHEN B.grid_i_direction = 'LINE' AND B.grid_jsize = 1 THEN
	    CAST(((
            (line_max-line_min                                                          /*Line Differencce    */
            +ABS((B.line_at_isize_jsize - B.line_at_i1_j1 ) / (B.grid_isize -1 )))      /*Add Line Inc    */
            /ABS((B.line_at_isize_jsize - B.line_at_i1_j1 ) / (B.grid_isize -1 )))      /*Div by Line Inc    */
        *
            (trace_max-trace_min                                                        /*Trace Differencce    */
            +1))                                                                        /*Add increment of 1 only*/
         AS integer)
        WHEN B.grid_i_direction = 'LINE' AND B.grid_isize = 1 THEN
        CAST(((
            (line_max-line_min                                                          /*Line Differencce    */
            +1))                                                                        /*Add increment of 1 only*/
        *
            (trace_max-trace_min                                                        /*Trace Differencce    */
            +ABS((B.trace_at_isize_jsize - B.trace_at_i1_j1 ) / (B.grid_jsize -1 )))    /*Add Trace Inc    */
            /ABS((B.trace_at_isize_jsize - B.trace_at_i1_j1 ) / (B.grid_jsize -1 )))    /*Div by Trace Inc    */
         AS integer)
        WHEN B.grid_i_direction = 'TRACE'
        THEN
        CAST(((
            (line_max-line_min                                                          /*Line Differencce    */
            +ABS((B.line_at_isize_jsize - B.line_at_i1_j1 ) / (B.grid_jsize -1 )))      /*Add Line Inc    */
            /ABS((B.line_at_isize_jsize - B.line_at_i1_j1 ) / (B.grid_jsize -1 )))      /*Div by Line Inc    */
        *
            (trace_max-trace_min                                                        /*Trace Differencce    */
            +ABS((B.trace_at_isize_jsize - B.trace_at_i1_j1 ) / (B.grid_isize -1 )))    /*Add Trace Inc    */
             /ABS((B.trace_at_isize_jsize - B.trace_at_i1_j1 ) / (B.grid_isize -1 )))   /*Div by Trace Inc    */
         AS integer)
        ELSE
        CAST(((
            (line_max-line_min                                                          /*Line Differencce    */
            +ABS((B.line_at_isize_jsize - B.line_at_i1_j1 ) / (B.grid_isize -1 )))      /*Add Line Inc    */
            /ABS((B.line_at_isize_jsize - B.line_at_i1_j1 ) / (B.grid_isize -1 )))      /*Div by Line Inc    */
        *
            (trace_max-trace_min                                                        /*Trace Differencce    */
            +ABS((B.trace_at_isize_jsize - B.trace_at_i1_j1 ) / (B.grid_jsize -1 )))    /*Add Trace Inc    */
            /ABS((B.trace_at_isize_jsize - B.trace_at_i1_j1 ) / (B.grid_jsize -1 )))    /*Div by Trace Inc    */
        AS integer)
        END
                                                AS        num_traces,
        A.min                                    AS        min_amplitude,
        A.min_dsdsunit                           AS        min_amplitude_unit,
        A.max                                    AS        max_amplitude,
        A.max_dsdsunit                           AS        max_amplitude_unit,
        A.polarity                               AS        polarity,
        A.processed_by                           AS        processed_by,
        A.processed_date                         AS        processed_date,
        A.total_size                             AS        total_size,
        A.total_size_dsdsunit                    AS        total_size_unit,
        A.z_domain                               AS        z_domain,
        A.z_start                                AS        z_start,
        A.z_start_dsdsunit                       AS        z_start_unit,
        A.z_start_dsdsunittype                   AS        z_start_unittype,
        A.z_start_actual                         AS        z_start_actual,
        A.z_start_actual_dsdsunit                AS        z_start_actual_unit,
        A.z_start_actual_dsdsunittype            AS        z_start_actual_unittype,
        A.z_sample_rate                         AS        z_sample_rate,
        A.z_sample_rate_dsdsunit                 AS        z_sample_rate_unit,
        A.z_sample_rate_dsdsunittype             AS        z_sample_rate_unittype,
        A.z_npts                                 AS        z_npts,
        A.z_npts_actual                          AS        z_npts_actual,
        A.data                                     AS        data,
        A.remark                                  AS        remark,
        A.create_date                             AS        create_date,
        A.create_user_id                        AS        create_user_id,
        A.update_date                            AS        update_date,
        A.update_user_id                        AS        update_user_id,
	    A.native_uid							 AS        alternate_uid
    FROM OpenWorks_SM.SeismicDataSet A
    INNER JOIN OpenWorks_SM.BinsetGrid3DGrid B
    ON A.binset_grid_id = B.binset_grid_id
    WHERE geom_set_type = '3D Survey'
	and  A.r_seis_attr_nm <> 'AMPLITUDE' AND A.r_seis_attr_nm <> 'UNKNOWN' ;



Create Trigger on SeismicDataSet3DAttribute INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC

    DECLARE string VARIABLES.geom_set_type                =    '3D Survey';

	--check if this is attribute and not main dataset
	if("NEW".seismic_attribute_name = 'AMPLITUDE' OR "NEW".seismic_attribute_name = 'UNKNOWN')
		ERROR 'The data is not an attribute.';

    INSERT into OpenWorks_SM.SeismicDataSet ("seis_geom_set_id","seis_data_set_name","seismic_version_name","geom_set_type","data_file_name","binary_data_format","data_file_format","polarity","z_domain","z_start","z_start_dsdsunit","z_npts","z_sample_rate","z_sample_rate_dsdsunit","data_source","data")


    VALUES ("NEW".seismic3dsurvey_native_uid,"NEW".seismic_data_set_name,"NEW".seismic_version_name,VARIABLES.geom_set_type,"NEW".data_file_name,"NEW".binary_data_format,"NEW".data_file_format,"NEW".polarity,"NEW".z_domain,"NEW".z_start,"NEW".z_start_unit,"NEW".z_npts,"NEW".z_sample_rate,"NEW".z_sample_rate_unit,"NEW".data_source,"NEW".data);

	--set the seismic attribute name and remark

	update OpenWorks_SM.SeismicDataSet
	set r_seis_attr_nm = "NEW".seismic_attribute_name, remark = "NEW".remark where
	seis_data_set_name = "NEW".seismic_data_set_name and
	seis_geom_set_id   = "NEW".seismic3dsurvey_native_uid and
	seismic_version_name = "NEW".seismic_version_name;

END;

Create Trigger on SeismicDataSet3DAttribute INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC

    DECLARE string VARIABLES.geom_set_type                =    '3D Survey';

	IF((CHANGING.data)) --updating data attribute has huge cost so only update data if required
		BEGIN

			UPDATE OpenWorks_SM.SeismicDataSet SET

			"geom_set_type"                 =    VARIABLES.geom_set_type,
			"data_file_name"                =    "OLD".data_file_name,
			"binary_data_format"            =    "NEW".binary_data_format,
			"data_file_format"              =    "NEW".data_file_format,
			"polarity"                      =    "NEW".polarity,
			"z_domain"                      =    "NEW".z_domain,
			"z_start"                       =    "NEW".z_start,
			"z_start_dsdsunit"              =    "NEW".z_start_unit,
			"z_npts"                        =    "NEW".z_npts,
			"z_sample_rate"                 =    "NEW".z_sample_rate,
			"z_sample_rate_dsdsunit"        =    "NEW".z_sample_rate_unit,
			"data_source"                   =    "NEW".data_source,
			"data"                          =    "NEW".data,
			"seismic_version_name"          =    "OLD".seismic_version_name,
			"remark"                        =    "NEW".remark

			WHERE  OpenWorks_SM.SeismicDataSet.seis_data_set_name="OLD".seismic_data_set_name and seis_geom_set_id = "OLD".seismic3dsurvey_native_uid;

		END
	ELSE
		BEGIN
			UPDATE OpenWorks_SM.SeismicDataSet SET

			"geom_set_type"                 =    VARIABLES.geom_set_type,
			"data_file_name"                =    "OLD".data_file_name,
			"binary_data_format"            =    "NEW".binary_data_format,
			"data_file_format"              =    "NEW".data_file_format,
			"polarity"                      =    "NEW".polarity,
			"z_domain"                      =    "NEW".z_domain,
			"z_start"                       =    "NEW".z_start,
			"z_start_dsdsunit"              =    "NEW".z_start_unit,
			"z_npts"                        =    "NEW".z_npts,
			"z_sample_rate"                 =    "NEW".z_sample_rate,
			"z_sample_rate_dsdsunit"        =    "NEW".z_sample_rate_unit,
			"data_source"                   =    "NEW".data_source,
			"seismic_version_name"          =    "OLD".seismic_version_name,
			"remark"                        =    "NEW".remark

			WHERE  OpenWorks_SM.SeismicDataSet.seis_data_set_name="OLD".seismic_data_set_name and seis_geom_set_id = "OLD".seismic3dsurvey_native_uid;

		END
END;

Create Trigger on SeismicDataSet3DAttribute INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC
DELETE from OpenWorks_SM.SeismicDataSet WHERE  OpenWorks_SM.SeismicDataSet.seis_data_set_name="OLD".seismic_data_set_name;

END;


CREATE VIRTUAL PROCEDURE GetSeismicAttributesFromDataset(parent_seismic_data_set_name string)  RETURNS (
																parent_dataset_name string,
																attribute_key   string,
																attribute_name   string
                                                                ) AS

BEGIN

	select
	parent_seismic_data_set_name as parent_dataset_name,
	native_uid as attribute_key,
	seismic_data_set_name as attribute_name

	from SeismicDataSet3DAttribute where
	parent_seismic_data_set_native_uid =
	(select native_uid from SeismicDataSet3D where seismic_data_set_name = parent_seismic_data_set_name );

END

/*
****************************************
*    Virtual Procedure - convertWellPlanTurnPointTrajectoryToTargetCRS
*	 This procedure returns the json which includes values of x and y offset
****************************************
*/
CREATE VIRTUAL PROCEDURE convertWellPlanToTargetCRS(native_uid string,cartosystem string,measurementsystem string) RETURNS (data CLOB) AS
BEGIN

	DECLARE string VARIABLES.target_measurement_system = NULL;
	DECLARE string VARIABLES.target_crs = NULL;
	VARIABLES.target_measurement_system = CONVERT((SELECT teiid_session_get('measurementsystem')),STRING);
	VARIABLES.target_crs = CONVERT((SELECT teiid_session_get('cartosystem')),STRING);
	IF((VARIABLES.target_measurement_system IS NULL) AND (convertWellPlanToTargetCRS.measurementsystem IS NOT NULL))
	BEGIN
	    VARIABLES.target_measurement_system = convertWellPlanToTargetCRS.measurementsystem;
	    DECLARE string VARIABLES.setms = CONVERT((SELECT teiid_session_set('measurementsystem',VARIABLES.target_measurement_system)),STRING);
	END
	IF((VARIABLES.target_crs IS NULL) AND (convertWellPlanToTargetCRS.cartosystem IS NOT NULL))
	BEGIN
	    VARIABLES.target_crs = convertWellPlanToTargetCRS.cartosystem;
	    DECLARE string VARIABLES.setcrs = CONVERT((SELECT teiid_session_set('cartosystem',VARIABLES.target_crs)),STRING);
	END
    INSERT INTO #TmpTbl1 (#TmpTbl1.wellbore_native_uid,#TmpTbl1.crs,#TmpTbl1.data)select wellbore_native_uid,tie_pt_crs,data from OpenWorksCommonModel.WellPlan where native_uid = convertWellPlanToTargetCRS.native_uid;

	DECLARE string VARIABLES.source_crs=(select #TmpTbl1.crs from #TmpTbl1);

	DECLARE Blob VARIABLES.data=(select #TmpTbl1.data from #TmpTbl1);

	IF(convertWellPlanToTargetCRS.native_uid IS NOT NULL)
	BEGIN
       INSERT INTO #TmpTbl (#TmpTbl.surfaceX, #TmpTbl.surfaceY, #TmpTbl.surfaceUnits) select tie_pt_x,tie_pt_y,tie_pt_xy_unit from OpenWorksCommonModel.WellPlan where native_uid = convertWellPlanToTargetCRS.native_uid;

       DECLARE double VARIABLES.surface_x = (select #TmpTbl.surfaceX from #TmpTbl);
       DECLARE double VARIABLES.surface_y = (select #TmpTbl.surfaceY from #TmpTbl);
       DECLARE string VARIABLES.surface_units = (select #TmpTbl.surfaceUnits from #TmpTbl);

	   VARIABLES.data = ReplaceAbsXYWithOffsets(VARIABLES.data,0);
	   DECLARE string VARIABLES.offset_unit=VARIABLES.surface_units;

	  /* DECLARE string VARIABLES.offset_unit=fetchElementUnitNameFromBlob(VARIABLES.data,'x_offset');*/
	   select convertPosLogToTargetCRS2(VARIABLES.source_crs,VARIABLES.source_crs, VARIABLES.surface_x, VARIABLES.surface_y, VARIABLES.surface_units, VARIABLES.offset_unit, VARIABLES.data, VARIABLES.target_crs,VARIABLES.target_measurement_system);
	END
END;


/*
****************************************
*    Virtual Procedure - LocateSeismicFile
*	 This procedure returns the path of SeismicDataFile for a SeismicDataSet if the file exists, empty string otherwise
****************************************
*/

CREATE VIRTUAL PROCEDURE LocateSeismicFile(seismic_dataset_native_uid string) RETURNS (seismic_file_path String) AS
BEGIN

	--create a temporary table and store the file and folder name to reduce the number of individual queries
	CREATE LOCAL TEMPORARY TABLE tempSeisProperties (folder_name string, data_file_name string);

	select directory_name_3d, data_file_name
	INTO
	tempSeisProperties
	FROM  OpenWorksCommonModel.BinsetGrid3DGrid as bgrid
	JOIN SeismicDataSet3D as Seis3D ON bgrid.seismic3dsurvey_native_uid = Seis3D.seismic3dsurvey_native_uid where  Seis3D.native_uid= seismic_dataset_native_uid;

	DECLARE INTEGER VARIABLES.TOTAL_ROWS = select count(*) from tempSeisProperties;

    --if the temporary table is empty, that means no data matches the query
	IF(TOTAL_ROWS=0)
		ERROR 'No seismic dataset exists for this nativeuid in SeismicDataSet3D or BinsetGrid3DGrid.';

    SELECT SeismicFilePath FROM (EXEC OpenWorks_SM.LocateSeismicFile((select folder_name from tempSeisProperties limit 1),(select data_file_name from tempSeisProperties limit 1))) AS filePath;

END;

 /*
****************************************
*    Virtual Procedure - GetSeismicMountInformation
*	 This procedure returns the mounted drives information for Seismic data for the current district
****************************************
*/ 

CREATE VIRTUAL PROCEDURE GetSeismicMountInformation() RETURNS (nfs_host string, nfs_path string, local_mount_name string, available_space_kb long) AS
BEGIN
    
    SELECT nfs_host,nfs_path,local_mount_name,available_space_kb FROM (EXEC OpenWorks_SM.GetSeismicMountInformation()) AS data;
        
END;

 /*
****************************************
*    Virtual Procedure - ComputeDeviationFromWellhead
****************************************
*/

CREATE VIRTUAL PROCEDURE ComputeDeviationFromWellhead(poslog_native_uid string) RETURNS (deviationData blob) AS
BEGIN

	SELECT computeDeviationFromWellhead(PositionLog.data) AS deviationData FROM PositionLog WHERE native_uid = poslog_native_uid ;
END;


/*
****************************************
*    Virtual Procedure - SeismicFileSize
****************************************
*/

CREATE VIRTUAL PROCEDURE SeismicFilesSize(seismic_data_set_id string) RETURNS (TotalFileSizeInKB long) AS
BEGIN
    DECLARE INTEGER VARIABLES.seismic_data_set_id_int =  convert(seismic_data_set_id, integer);
    SELECT TotalFileSizeInKB FROM (EXEC OpenWorks_SM.SeismicFilesSize(VARIABLES.seismic_data_set_id_int)) AS TotalFileSizeInKB;
END;

/*
**********************************
* ENTITY: PolyTarget
**********************************
*/
CREATE VIEW PolyTarget
(
    native_uid                  		VARCHAR(1024)           AUTO_INCREMENT          OPTIONS("OpenWorksCommonModel:PolyTarget.native_uid.isUpdatable" false,
                                                                                                "OpenWorksCommonModel:PolyTarget.native_uid.isCreatable" false,
                                                                                                UPDATABLE 'FALSE'),
    wellplanproject_native_uid          VARCHAR(1024)           NOT NULL,
    project_name                		VARCHAR(4000)                                   OPTIONS("OpenWorksCommonModel:PolyTarget.project_name.isUpdatable" false,
                                                                                                "OpenWorksCommonModel:PolyTarget.project_name.isCreatable" false,
                                                                                                UPDATABLE 'FALSE'),
    target_name                         VARCHAR(50)             NOT NULL,
    target_x                            DOUBLE                                          OPTIONS("OpenWorksCommonModel:PolyTarget.target_x.unitField" 'target_xy_unit'),
    target_y                            DOUBLE                                          OPTIONS("OpenWorksCommonModel:PolyTarget.target_y.unitField" 'target_xy_unit'),
    target_xy_unit                      VARCHAR(64)                                     OPTIONS("OpenWorksCommonModel:PolyTarget.target_xy_unit.isUpdatable" false),
    target_crs                          VARCHAR(80),
    target_z                            DOUBLE                                          OPTIONS("OpenWorksCommonModel:PolyTarget.target_z.unitField" 'target_z_unit'),
    target_z_unit                       VARCHAR(64)                                     OPTIONS("OpenWorksCommonModel:PolyTarget.target_z_unit.unitType" 'depth measure'),
    target_type                         VARCHAR(50),
    target_main_type                    VARCHAR(4000),
    target_sub_type                     VARCHAR(4000),
    target_point_type                   VARCHAR(4000),
    offset_x                            DOUBLE                                          OPTIONS("OpenWorksCommonModel:PolyTarget.offset_x.unitField" 'offset_xy_unit'),
    offset_y                            DOUBLE                                          OPTIONS("OpenWorksCommonModel:PolyTarget.offset_y.unitField" 'offset_xy_unit'),
    offset_xy_unit                      VARCHAR(4000)                                   OPTIONS("OpenWorksCommonModel:PolyTarget.offset_xy_unit.unitType" 'linear distance'),
    dip_angle                           DOUBLE                                          OPTIONS("OpenWorksCommonModel:PolyTarget.dip_angle.unitField" 'dip_angle_unit'),
    dip_angle_unit                      VARCHAR(4000)                                   OPTIONS("OpenWorksCommonModel:PolyTarget.dip_angle_unit.unitType" 'angular distance'),
    azimuth_angle                       DOUBLE                                          OPTIONS("OpenWorksCommonModel:PolyTarget.azimuth_angle.unitField" 'azimuth_angle_unit'),
    azimuth_angle_unit                  VARCHAR(4000)                                   OPTIONS("OpenWorksCommonModel:PolyTarget.azimuth_angle_unit.unitType" 'angular distance'),
    point_count                         INTEGER,
    application                         VARCHAR(20),
    interpreter                         VARCHAR(4000)                                   OPTIONS("OpenWorksCommonModel:PolyTarget.interpreter.isUpdatable" false,
                                                                                                "OpenWorksCommonModel:PolyTarget.interpreter.isCreatable" false,
                                                                                                UPDATABLE 'FALSE'),
    remark                              VARCHAR(4000)                                   OPTIONS("OpenWorksCommonModel:PolyTarget.remark.isUpdatable" false,
                                                                                                "OpenWorksCommonModel:PolyTarget.remark.isCreatable" false,
                                                                                                UPDATABLE 'FALSE'),
    create_date                         TIMESTAMP                                       OPTIONS("OpenWorksCommonModel:PolyTarget.create_date.isUpdatable" false,
                                                                                                "OpenWorksCommonModel:PolyTarget.create_date.isCreatable" false,
                                                                                                UPDATABLE 'FALSE'),
    create_user_id                      VARCHAR(30)                                     OPTIONS("OpenWorksCommonModel:PolyTarget.create_user_id.isUpdatable" false,
                                                                                                "OpenWorksCommonModel:PolyTarget.create_user_id.isCreatable" false,
                                                                                                UPDATABLE 'FALSE'),
    update_date                         TIMESTAMP                                       OPTIONS("OpenWorksCommonModel:PolyTarget.update_date.isUpdatable" false,
                                                                                                "OpenWorksCommonModel:PolyTarget.update_date.isCreatable" false,
                                                                                                UPDATABLE 'FALSE'),
    update_user_id                      VARCHAR(30)                                     OPTIONS("OpenWorksCommonModel:PolyTarget.update_user_id.isUpdatable" false,
                                                                                                "OpenWorksCommonModel:PolyTarget.update_user_id.isCreatable" false,
                                                                                                UPDATABLE 'FALSE'),
    data                                BLOB,
    CONSTRAINT PolyTarget_PK PRIMARY KEY (native_uid),

    CONSTRAINT PolyTarget_UK UNIQUE (wellplanproject_native_uid, target_name),

    CONSTRAINT FK_PolyTarget_WellPlanProject
        FOREIGN KEY               (wellplanproject_native_uid)
        REFERENCES WellPlanProject(native_uid),

    CONSTRAINT FK_PolyTarget_CRS
        FOREIGN KEY                    (target_crs)
        REFERENCES CartoReferenceSystem(name)
)
OPTIONS(UPDATABLE 'FALSE',  PolyTarget.IMPLEMENTED 'FALSE')
    AS
    SELECT
        null                                            AS native_uid,
        null                                            AS wellplanproject_native_uid,
        null                                            AS project_name,
        null                                            AS target_name,
        null                                            AS target_x,
        null                                            AS target_y,
        null                                            AS target_xy_unit,
        null                                            AS target_crs,
        null                                            AS target_z,
        null                                            AS target_z_unit,
        null                                            AS target_type,
        null                                            AS target_main_type,
        null                                            AS target_sub_type,
        null                                            AS target_point_type,
        null                                            AS offset_x,
        null                                            AS offset_y,
        null                                            AS offset_xy_unit,
        null                                            AS dip_angle,
        null                                            AS dip_angle_unit,
        null                                            AS azimuth_angle,
        null                                            AS azimuth_angle_unit,
        null                                            AS point_count,
        null                                            AS application,
        null                                            AS interpreter,
        null                                            AS remark,
        null                                            AS create_date,
        null                                            AS create_user_id,
        null                                            AS update_date,
        null                                            AS update_user_id,
        null                                            AS data
    FROM SYS.Tables
    WHERE 1 = 2;

CREATE VIEW WellPlanSite
(
    native_uid                      VARCHAR(1024)      AUTO_INCREMENT OPTIONS("OpenWorksCommonModel:WellPlanSite.native_uid.isUpdatable" false,
                                                                "OpenWorksCommonModel:WellPlanSite.native_uid.isCreatable" false,
                                                                UPDATABLE 'FALSE'),
    wellplanproject_native_uid      VARCHAR(1024)       NOT NULL,
    project_name                    VARCHAR(4000)       OPTIONS("OpenWorksCommonModel:WellPlanSite.project_name.isUpdatable" false,
                                                                "OpenWorksCommonModel:WellPlanSite.project_name.isCreatable" false,
                                                                UPDATABLE 'FALSE'),
    site_name                       VARCHAR(60)         NOT NULL,
    location_type                   INTEGER,
    method_index                    INTEGER,
    tie_pt_x                        DOUBLE              OPTIONS ("OpenWorksCommonModel:WellPlanSite.tie_pt_x.unitField" 'tie_pt_xy_unit'),
    tie_pt_y                        DOUBLE              OPTIONS ("OpenWorksCommonModel:WellPlanSite.tie_pt_y.unitField" 'tie_pt_xy_unit'),
    tie_pt_z                        DOUBLE              OPTIONS ("OpenWorksCommonModel:WellPlanSite.tie_pt_z.unitField" 'tie_pt_z_unit'),
    tie_pt_xy_unit                  VARCHAR(64),
    tie_pt_crs                      VARCHAR(80),
    tie_pt_z_unit                   VARCHAR(64)         OPTIONS ("OpenWorksCommonModel:WellPlanSite.tie_pt_z_unit.unitType" 'depth measure'),
    remark                          VARCHAR(2000),
    create_date                     TIMESTAMP           OPTIONS ("OpenWorksCommonModel:WellPlanSite.create_date.isUpdatable" false),
    create_user_id                  VARCHAR(30)         OPTIONS ("OpenWorksCommonModel:WellPlanSite.create_user_id.isCreatable" false,
                                                                "OpenWorksCommonModel:WellPlanSite.create_user_id.isUpdatable" false,UPDATABLE 'FALSE'),
    update_date                     TIMESTAMP,
    update_user_id                  VARCHAR(30)         OPTIONS ("OpenWorksCommonModel:WellPlanSite.update_user_id.isCreatable" false,
                                                                "OpenWorksCommonModel:WellPlanSite.update_user_id.isUpdatable" false,UPDATABLE 'FALSE'),

    CONSTRAINT WellPlanSite_PK PRIMARY KEY (native_uid),

    CONSTRAINT WellPlanSite_UK1 UNIQUE (site_name,wellplanproject_native_uid),

    CONSTRAINT FK_WellPlanSite_wellplanproject_native_uid
        FOREIGN KEY               (wellplanproject_native_uid)
        REFERENCES WellPlanProject(native_uid),


    CONSTRAINT FK_WellPlanSite_tie_pt_crs
        FOREIGN KEY                    (tie_pt_crs)
        REFERENCES CartoReferenceSystem(name)
)
OPTIONS(UPDATABLE 'TRUE',  WellPlanSite.IMPLEMENTED 'TRUE')
AS
    SELECT
        WP.well_plan_id  as native_uid,
        WPP.wp_project_id as wellplanproject_native_uid,
        WPP.wp_project_name as project_name,
        WP.well_plan_name as site_name,
        WP.location_type as location_type,
        WP.method_index as method_index,
        TP.x as tie_pt_x,
        TP.y as tie_pt_y,
        TP.z as tie_pt_z,
        proj.min_x_dsdsunit AS tie_pt_xy_unit,
        getDSDSCrs(carto.name) AS tie_pt_crs,
        TP.z_dsdsunit as tie_pt_z_unit,
        WP.remark as remarks,
        WP.create_date as create_date,
        WP.create_user_id as create_user_id,
        WP.update_date as update_date,
        WP.update_user_id
    FROM OpenWorks_SM.WellPlan WP
    	INNER JOIN OpenWorks_SM.Project proj ON 1 = 1
    	INNER JOIN OpenWorks_SM.CartoRefSys carto ON carto.id = proj.xy_crs_id
        LEFT OUTER JOIN OpenWorks_SM.WellPlanProj WPP ON WP.wp_project_id = WPP.wp_project_id
        LEFT OUTER JOIN OpenWorks_SM.TurnPoint TP ON WP.well_plan_id = TP.well_plan_id and TP.turn_point_seq_no = -1
	WHERE WP.location_type IN (7, 1);

CREATE TRIGGER ON WellPlanSite INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC

    DECLARE integer VARIABLES.well_plan_id = (SELECT * FROM (EXEC OpenWorks_SM.nextval('WellPlan')) AS SysGenID);
    DECLARE string VARIABLES.targetCRS = (Select name from OpenWorks_SM.CartoRefSys,OpenWorks_SM.Project where OpenWorks_SM.CartoRefSys.id = OpenWorks_SM.Project.xy_crs_id);

    DECLARE double VARIABLES.X;
    DECLARE double VARIABLES.Y;
    DECLARE string VARIABLES.XYUnit;
    IF(("NEW".tie_pt_x is NOT NULL) AND ("NEW".tie_pt_y is NOT NULL) AND ("NEW".tie_pt_xy_unit is NOT NULL) AND ("NEW".tie_pt_crs is NOT NULL))
    BEGIN
        VARIABLES.X = "NEW".tie_pt_x;
        VARIABLES.Y = "NEW".tie_pt_y;
        VARIABLES.XYUnit = "NEW".tie_pt_xy_unit;
        DECLARE blob convertedXYBlob = select cartoConvert("NEW".tie_pt_crs,VARIABLES.targetCRS,VARIABLES.X,VARIABLES.Y,VARIABLES.XYUnit);
        IF(convertedXYBlob IS NOT NULL)
        BEGIN
            VARIABLES.X= fetchDElementValueFromBlob(convertedXYBlob,'x');
            VARIABLES.Y= fetchDElementValueFromBlob(convertedXYBlob,'y');
            VARIABLES.XYUnit= fetchElementUnitNameFromBlob(convertedXYBlob,'x');
        END
    END

    INSERT INTO OpenWorks_SM.WellPlan
    (well_plan_id,wp_project_id,  well_plan_name, well_plan_version, location_type, method_index,current_status,remark)
    VALUES
    (VARIABLES.well_plan_id,"NEW".wellplanproject_native_uid, "NEW".site_name, 0, "NEW".location_type, "NEW".method_index,'UNLOCKED',"New".remark);

    IF((VARIABLES.X is NOT NULL) AND (VARIABLES.Y is NOT NULL))
    BEGIN
        INSERT INTO OpenWorks_SM.TurnPoint
            (well_plan_id,turn_point_seq_no,wp_project_id, well_plan_meth_cd,
            x, y , z, z_dsdsunit)
        VALUES
            (VARIABLES.well_plan_id, -1, "NEW".wellplanproject_native_uid, 0,
            VARIABLES.X, VARIABLES.Y , COALESCE("NEW".tie_pt_z, 0), "NEW".tie_pt_z_unit );
    END

    DECLARE INTEGER VARIABLES.occurrence_no =  (SELECT MAX(occurrence_no) + 1 FROM OpenWorks_SM.WellPlanInterval WHERE well_plan_id = VARIABLES.well_plan_id);
    IF (VARIABLES.occurrence_no IS NULL)
    BEGIN
        VARIABLES.occurrence_no = 0;
    END

    DECLARE STRING VARIABLES.interval_text = CONVERT(XMLELEMENT("INTERVAL_DATA",
    XMLATTRIBUTES(0 AS "WATER_DEPTH")), STRING);

	INSERT INTO OpenWorks_SM.WellPlanInterval ("well_plan_id","wp_project_id","wp_interval_type","occurrence_no","top_depth","top_depth_dsdsunit","base_depth","base_depth_dsdsunit","interval_text","remark")
    VALUES (VARIABLES.well_plan_id, "NEW".wellplanproject_native_uid,'PLATFORM_INFO',VARIABLES.occurrence_no, 0,'feet', 0, 'feet', VARIABLES.interval_text, 'WellPlanSite');

    VARIABLES.interval_text = CONVERT(XMLELEMENT("INTERVAL_DATA",
    XMLATTRIBUTES(1 AS "DISPLAY_TYPE", 0 AS "GROUND_LEVEL", 2 AS "LINE_WEIGHT", 'Planned' As "STATUS",'true' AS "VISIBLE")), STRING);

	INSERT INTO OpenWorks_SM.WellPlanInterval ("well_plan_id","wp_project_id","wp_interval_type","occurrence_no","top_depth","top_depth_dsdsunit","base_depth","base_depth_dsdsunit","interval_text","remark")
    VALUES (VARIABLES.well_plan_id, "NEW".wellplanproject_native_uid,'PROPERTIES',VARIABLES.occurrence_no + 1, 0,'feet', 0, 'feet',
    VARIABLES.interval_text, 'WellPlanSite');

END;

CREATE TRIGGER ON WellPlanSite INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC

    DECLARE STRING VARIABLES.interval_text  = CONVERT(XMLELEMENT("INTERVAL_DATA",
    XMLATTRIBUTES(1 AS "DISPLAY_TYPE", 0 AS "GROUND_LEVEL", 2 AS "LINE_WEIGHT", 'Planned' As "STATUS",'true' AS "VISIBLE")), STRING);

    DECLARE STRING VARIABLES.wpi_id = (SELECT native_uid FROM OpenWorks_SM.WellPlanInterval WHERE well_plan_id = "OLD".native_uid
    AND wp_project_id = "OLD".wellplanproject_native_uid AND wp_interval_type = 'PROPERTIES');

    IF(VARIABLES.wpi_id IS NOT NULL)
    BEGIN
        UPDATE OpenWorks_SM.WellPlanInterval
        SET interval_text = VARIABLES.interval_text
        WHERE native_uid = VARIABLES.wpi_id;
    END
    ELSE
    BEGIN
        INSERT INTO OpenWorks_SM.WellPlanInterval ("well_plan_id","wp_project_id","wp_interval_type","occurrence_no","top_depth","top_depth_dsdsunit","base_depth","base_depth_dsdsunit","interval_text","remark")
        VALUES ("OLD".native_uid, "OLD".wellplanproject_native_uid, 'PROPERTIES', 1, 0, 'feet', 0, 'feet', VARIABLES.interval_text, 'WellPlanSite');
    END

    VARIABLES.interval_text = CONVERT(XMLELEMENT("INTERVAL_DATA", XMLATTRIBUTES(0 AS "WATER_DEPTH")), STRING);

    VARIABLES.wpi_id = (SELECT native_uid FROM OpenWorks_SM.WellPlanInterval WHERE well_plan_id = "OLD".native_uid
    AND wp_project_id = "OLD".wellplanproject_native_uid AND wp_interval_type = 'PLATFORM_INFO');

    IF(VARIABLES.wpi_id IS NOT NULL)
    BEGIN
        UPDATE OpenWorks_SM.WellPlanInterval
        SET interval_text = VARIABLES.interval_text
        WHERE native_uid = VARIABLES.wpi_id;
    END
    ELSE
    BEGIN
        INSERT INTO OpenWorks_SM.WellPlanInterval ("well_plan_id","wp_project_id","wp_interval_type","occurrence_no","top_depth","top_depth_dsdsunit","base_depth","base_depth_dsdsunit","interval_text","remark")
        VALUES ("OLD".native_uid, "OLD".wellplanproject_native_uid, 'PLATFORM_INFO', 0, 0, 'feet', 0, 'feet', VARIABLES.interval_text, 'WellPlanSite');
    END
END;

CREATE TRIGGER ON WellPlanSite INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC
  DELETE from OpenWorks_SM.WellPlanInterval WHERE  well_plan_id = "OLD".native_uid;
  DELETE from OpenWorks_SM.TurnPoint WHERE  well_plan_id = "OLD".native_uid;
  DELETE from OpenWorks_SM.WellPlan WHERE   native_uid = "OLD".native_uid;
END;

CREATE VIEW SiteTemplates
(
    native_uid                  VARCHAR(1024) AUTO_INCREMENT OPTIONS("OpenWorksCommonModel:SiteTemplates.native_uid.isUpdatable" false,
                                                                    "OpenWorksCommonModel:SiteTemplates.native_uid.isCreatable" false,
                                                                    UPDATABLE 'FALSE'),
    wellplanproject_native_uid  VARCHAR(1024) NOT NULL,
    project_name                VARCHAR(4000),
    wellplan_site_native_uid    VARCHAR(1024) NOT NULL,
    site_name                   VARCHAR(60),
    custom_names                VARCHAR(256),
    name                        VARCHAR(256) NOT NULL,
    shortname                   VARCHAR(256),
    is_named_slots              CHAR,
    north                       DOUBLE,
    east                        DOUBLE,
    start_number                INTEGER,
    num_rows                    INTEGER,
    num_cols                    INTEGER,
    name_direction              INTEGER,
    spacing_rows                FLOAT,
    spacing_columns             FLOAT,
    ns_edge                     FLOAT,
    ew_edge                     FLOAT,
    orientation                 FLOAT,
    radius                      FLOAT,
    CONSTRAINT SiteTemplates_PK PRIMARY KEY (native_uid),

    CONSTRAINT SiteTemplates_UK1 UNIQUE (wellplan_site_native_uid,name),

    CONSTRAINT FK_SiteTemplates_wellplan_site_native_uid
        FOREIGN KEY               (wellplan_site_native_uid)
        REFERENCES WellPlanSite(native_uid)
)
OPTIONS(UPDATABLE 'TRUE',  SiteTemplates.IMPLEMENTED 'TRUE')
AS
SELECT
    wpi.native_uid                                  AS native_uid,
    wpp.wp_project_id                               AS wellplanproject_native_uid,
    wpp.wp_project_name                             AS project_name,
    wp.well_plan_id                                 AS wellplan_site_native_uid,
    wp.well_plan_name                               AS site_name,
    slot_templates.custom_names                     AS custom_names,
    slot_templates.name                             AS name,
    slot_templates.short_name                       AS shortname,
    CASE slot_templates.LETTERS
    WHEN 'true' THEN CONVERT('Y', CHAR)
    ELSE CONVERT('N', CHAR) END                     AS is_named_slots,
    slot_templates.north                            AS north,
    slot_templates.east                             AS east,
    CONVERT(slot_templates.STRT, INTEGER)           AS start_number,
    CONVERT(slot_templates.NUMROWS, INTEGER)        AS num_rows,
    CONVERT(slot_templates.NUMCOLS, INTEGER)        AS num_columns,
    CONVERT(slot_templates.NUMBER_BY, INTEGER) - 1  AS name_direction,
    slot_templates.XSPACING                         AS spacing_rows,
    slot_templates.YSPACING                         AS spacing_columns,
    slot_templates.TOPLEFTX                         AS ns_edge,
    slot_templates.TOPLEFTY                         AS ew_edge,
    slot_templates.ROTATIONANGLE                    AS orientation,
    slot_templates.RADIUS                           AS radius
FROM (SELECT native_uid,well_plan_id,wp_interval_type,interval_text FROM openworks_SM.wellplaninterval WHERE wp_interval_type='TEMPLATE') wpi,
 xmltable('INTERVAL_DATA' PASSING xmlparse(document wpi.interval_text)
 COLUMNS
   CUSTOM_NAMES  STRING     PATH '@CUSTOM_NAMES',
   NAME          STRING     PATH '@NAME',
   SHORT_NAME    STRING     PATH '@SHORT',
   NORTH         DOUBLE     PATH '@NORTH',
   EAST          DOUBLE     PATH '@EAST',
   LETTERS       STRING     PATH '@LETTERS',
   PLAN_TYPE     STRING     PATH '@PLAN_TYPE',
   NUMBER_BY     STRING     PATH '@NUMBER_BY',
   RADIUS        FLOAT      PATH '@RADIUS',
   TOPLEFTX      FLOAT      PATH '@UL_X',
   TOPLEFTY      FLOAT      PATH '@UL_Y',
   NUMROWS       FLOAT      PATH '@ROWS',
   NUMCOLS       FLOAT      PATH '@COLS',
   XSPACING      FLOAT      PATH '@X_SP',
   YSPACING      FLOAT      PATH '@Y_SP',
   ROTATIONANGLE FLOAT      PATH '@ROT',
   STRT          FLOAT      PATH '@START') AS slot_templates, OpenWorks_SM.WellPlan wp, OpenWorks_SM.WellPlanProj wpp
WHERE wp.well_plan_id=wpi.well_plan_id AND wp.wp_project_id = wpp.wp_project_id;

CREATE TRIGGER ON SiteTemplates INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC

    DECLARE STRING VARIABLES.interval_text  = '';
    DECLARE STRING VARIABLES.letters = CASE "NEW".is_named_slots WHEN 'Y' THEN 'true' ELSE 'false' END;

    DECLARE FLOAT VARIABLES.XSP = "NEW".spacing_rows;

    IF(VARIABLES.XSP IS NULL OR VARIABLES.XSP < 1)
    BEGIN VARIABLES.XSP = 1; END

    DECLARE FLOAT VARIABLES.YSP = "NEW".spacing_columns;

    IF(VARIABLES.YSP IS NULL OR VARIABLES.YSP < 1)
    BEGIN VARIABLES.YSP = 1; END

    DECLARE INTEGER VARIABLES.NUMBERBY = "NEW".name_direction;

    IF(VARIABLES.NUMBERBY IS NULL OR (VARIABLES.NUMBERBY  > 0 AND VARIABLES.NUMBERBY  < 2))
    BEGIN VARIABLES.NUMBERBY = 2; END
    ELSE
    BEGIN VARIABLES.NUMBERBY = 1; END

    IF("NEW".num_rows IS NULL OR "NEW".num_rows < 1)
    BEGIN
        VARIABLES.interval_text  = CONVERT(XMLELEMENT("INTERVAL_DATA",
            XMLATTRIBUTES("NEW".name AS "NAME", NVL("NEW".shortname, "NEW".name) AS "SHORT", "NEW".north AS "NORTH", "NEW".east AS "EAST", "NEW".start_number AS "START",
            VARIABLES.XSP AS "X_SP", VARIABLES.YSP AS "Y_SP", VARIABLES.NUMBERBY AS "NUMBER_BY", VARIABLES.letters AS "LETTERS",
            "NEW".orientation AS "ROT", "NEW".radius AS "RADIUS", 'Any' AS "PLAN_TYPE")), STRING);
    END
    ELSE IF (("NEW".num_rows IS NOT NULL AND "NEW".num_rows > 0) AND ("NEW".num_cols IS NULL OR "NEW".num_cols < 1))
    BEGIN
        VARIABLES.interval_text  = CONVERT(XMLELEMENT("INTERVAL_DATA",
            XMLATTRIBUTES("NEW".name AS "NAME",NVL("NEW".shortname, "NEW".name) AS "SHORT","NEW".north AS "NORTH","NEW".east AS "EAST","NEW".start_number AS "START",
            VARIABLES.XSP AS "X_SP",VARIABLES.YSP AS "Y_SP", VARIABLES.NUMBERBY AS "NUMBER_BY", VARIABLES.letters AS "LETTERS",
            "NEW".orientation AS "ROT","NEW".radius AS "RADIUS",'Any' AS "PLAN_TYPE",
            "NEW".num_rows AS "ROWS")), STRING);
    END
    ELSE IF (("NEW".num_rows IS NOT NULL AND "NEW".num_rows > 0) AND ("NEW".num_cols IS NOT NULL AND "NEW".num_cols > 0))
    BEGIN
        VARIABLES.interval_text  = CONVERT(XMLELEMENT("INTERVAL_DATA",
            XMLATTRIBUTES("NEW".name AS "NAME",NVL("NEW".shortname, "NEW".name) AS "SHORT","NEW".north AS "NORTH","NEW".east AS "EAST","NEW".start_number AS "START",
            VARIABLES.XSP AS "X_SP",VARIABLES.YSP AS "Y_SP", VARIABLES.NUMBERBY AS "NUMBER_BY", VARIABLES.letters AS "LETTERS",
            "NEW".orientation AS "ROT","NEW".radius AS "RADIUS",'Any' AS "PLAN_TYPE",
            "NEW".num_rows AS "ROWS","NEW".num_cols AS "COLS", "NEW".ns_edge AS "UL_X", "NEW".ew_edge AS "UL_Y")), STRING);
    END

    DECLARE STRING VARIABLES.wp_project_id = SELECT wp_project_id FROM openworks_SM.wellplan WHERE well_plan_id = "NEW".wellplan_site_native_uid;

    DECLARE INTEGER VARIABLES.occurrence_no =  (SELECT MAX(occurrence_no) + 1 FROM OpenWorks_SM.WellPlanInterval WHERE well_plan_id = "NEW".wellplan_site_native_uid AND wp_interval_type='TEMPLATE');
    IF (VARIABLES.occurrence_no IS NULL)
    BEGIN
        VARIABLES.occurrence_no = 1;
    END

	INSERT INTO OpenWorks_SM.WellPlanInterval ("well_plan_id","wp_project_id","wp_interval_type","occurrence_no","top_depth","top_depth_dsdsunit","base_depth","base_depth_dsdsunit","interval_text","remark")
    VALUES ("NEW".wellplan_site_native_uid,VARIABLES.wp_project_id,'TEMPLATE',VARIABLES.occurrence_no,0,'feet',0,'feet',VARIABLES.interval_text,'');

END;

CREATE TRIGGER on SiteTemplates INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC


    DECLARE STRING VARIABLES.interval_text  = '';
    DECLARE STRING VARIABLES.letters = CASE "NEW".is_named_slots WHEN 'Y' THEN 'true' ELSE 'false' END;

    DECLARE FLOAT VARIABLES.XSP = "NEW".spacing_rows;

    IF(VARIABLES.XSP IS NULL OR VARIABLES.XSP < 1)
    BEGIN VARIABLES.XSP = 1; END

    DECLARE FLOAT VARIABLES.YSP = "NEW".spacing_columns;

    IF(VARIABLES.YSP IS NULL OR VARIABLES.YSP < 1)
    BEGIN VARIABLES.YSP = 1; END

    DECLARE INTEGER VARIABLES.NUMBERBY = "NEW".name_direction;

    IF(VARIABLES.NUMBERBY IS NULL OR (VARIABLES.NUMBERBY  > 0 AND VARIABLES.NUMBERBY  < 2))
    BEGIN VARIABLES.NUMBERBY = 2; END
    ELSE
    BEGIN VARIABLES.NUMBERBY = 1; END

    IF("NEW".num_rows IS NULL OR "NEW".num_rows < 1)
    BEGIN
        VARIABLES.interval_text  = CONVERT(XMLELEMENT("INTERVAL_DATA",
            XMLATTRIBUTES("NEW".name AS "NAME", NVL("NEW".shortname, "NEW".name) AS "SHORT", "NEW".north AS "NORTH", "NEW".east AS "EAST", "NEW".start_number AS "START",
            VARIABLES.XSP AS "X_SP", VARIABLES.YSP AS "Y_SP", VARIABLES.NUMBERBY AS "NUMBER_BY", VARIABLES.letters AS "LETTERS",
            "NEW".orientation AS "ROT", "NEW".radius AS "RADIUS", 'Any' AS "PLAN_TYPE")), STRING);
    END
    ELSE IF (("NEW".num_rows IS NOT NULL AND "NEW".num_rows > 0) AND ("NEW".num_cols IS NULL OR "NEW".num_cols < 1))
    BEGIN
        VARIABLES.interval_text  = CONVERT(XMLELEMENT("INTERVAL_DATA",
            XMLATTRIBUTES("NEW".name AS "NAME",NVL("NEW".shortname, "NEW".name) AS "SHORT","NEW".north AS "NORTH","NEW".east AS "EAST","NEW".start_number AS "START",
            VARIABLES.XSP AS "X_SP",VARIABLES.YSP AS "Y_SP", VARIABLES.NUMBERBY AS "NUMBER_BY", VARIABLES.letters AS "LETTERS",
            "NEW".orientation AS "ROT","NEW".radius AS "RADIUS",'Any' AS "PLAN_TYPE",
            "NEW".num_rows AS "ROWS")), STRING);
    END
    ELSE IF (("NEW".num_rows IS NOT NULL AND "NEW".num_rows > 0) AND ("NEW".num_cols IS NOT NULL AND "NEW".num_cols > 0))
    BEGIN
        VARIABLES.interval_text  = CONVERT(XMLELEMENT("INTERVAL_DATA",
            XMLATTRIBUTES("NEW".name AS "NAME",NVL("NEW".shortname, "NEW".name) AS "SHORT","NEW".north AS "NORTH","NEW".east AS "EAST","NEW".start_number AS "START",
            VARIABLES.XSP AS "X_SP",VARIABLES.YSP AS "Y_SP", VARIABLES.NUMBERBY AS "NUMBER_BY", VARIABLES.letters AS "LETTERS",
            "NEW".orientation AS "ROT","NEW".radius AS "RADIUS",'Any' AS "PLAN_TYPE",
            "NEW".num_rows AS "ROWS","NEW".num_cols AS "COLS", "NEW".ns_edge AS "UL_X", "NEW".ew_edge AS "UL_Y")), STRING);
    END

	UPDATE OpenWorks_SM.WellPlanInterval SET interval_text = VARIABLES.interval_text WHERE native_uid = "NEW".native_uid;
END;

Create Trigger on SiteTemplates INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC
    DELETE FROM OpenWorks_SM.WellPlanInterval WHERE  native_uid = "OLD".native_uid;
END;

CREATE VIEW PlannedWell
(
    native_uid                      VARCHAR(1024)       AUTO_INCREMENT OPTIONS("OpenWorksCommonModel:PlannedWell.native_uid.isUpdatable" false, 
                                                                "OpenWorksCommonModel:PlannedWell.native_uid.isCreatable" false, 
                                                                UPDATABLE 'FALSE'),
    project_native_uid              VARCHAR(1024)       NOT NULL,
    wellplansite_native_uid         VARCHAR(1024)		NOT NULL,
    project_name                    VARCHAR(60)         OPTIONS("OpenWorksCommonModel:PlannedWell.project_name.isUpdatable" false, 
                                                                "OpenWorksCommonModel:PlannedWell.project_name.isCreatable" false, 
                                                                UPDATABLE 'FALSE'),
    site_name                       VARCHAR(20)         NOT NULL,
    well_name                       VARCHAR(80)         NOT NULL,
    well_uwi                        VARCHAR(26)         NOT NULL,
	slot_name                       VARCHAR(50),
    x_coordinate                    DOUBLE              OPTIONS ("OpenWorksCommonModel:PlannedWell.x_coordinate.unitField" 'xy_unit'),
    y_coordinate                    DOUBLE              OPTIONS ("OpenWorksCommonModel:PlannedWell.y_coordinate.unitField" 'xy_unit'),
    elevation                       DOUBLE              OPTIONS ("OpenWorksCommonModel:PlannedWell.elevation.unitField" 'elevation_unit'),
    xy_unit                         VARCHAR(64),
    on_off_shore                    VARCHAR(4000),
    is_subsea                       VARCHAR(40),
    ground_elevation                FLOAT			    OPTIONS ("OpenWorksCommonModel:PlannedWell.ground_elevation.unitField" 'ground_elevation_unit'),
    ground_elevation_unit           VARCHAR(4000)	    OPTIONS ("OpenWorksCommonModel:PlannedWell.ground_elevation_unit.unitType" 'elevation'),
    water_depth                     FLOAT 			    OPTIONS ("OpenWorksCommonModel:PlannedWell.water_depth.unitField" 'water_depth_unit'),
    water_depth_unit                VARCHAR(4000)	    OPTIONS ("OpenWorksCommonModel:PlannedWell.water_depth_unit.unitType" 'elevation'),
    elevation_reference             VARCHAR(64)         NOT NULL DEFAULT 'RKB',
    elevation_unit                  VARCHAR(64)         OPTIONS ("OpenWorksCommonModel:PlannedWell.elevation_unit.unitType" 'depth measure'),
    crs                             VARCHAR(80),
    location_type                   INTEGER      DEFAULT '1',
    remark                          VARCHAR(2000),
    create_date                     TIMESTAMP           OPTIONS ("OpenWorksCommonModel:PlannedWell.create_date.isUpdatable" false),
    create_user_id                  VARCHAR(30)         OPTIONS ("OpenWorksCommonModel:PlannedWell.create_user_id.isCreatable" false,
                                                                "OpenWorksCommonModel:PlannedWell.create_user_id.isUpdatable" false,UPDATABLE 'FALSE'),
    update_date                     TIMESTAMP, 
    update_user_id                  VARCHAR(30)         OPTIONS ("OpenWorksCommonModel:PlannedWell.update_user_id.isCreatable" false,
                                                                "OpenWorksCommonModel:PlannedWell.update_user_id.isUpdatable" false,UPDATABLE 'FALSE'),
  
    CONSTRAINT PlannedWell_PK PRIMARY KEY (native_uid),
    
    CONSTRAINT PlannedWell_UK1 UNIQUE (well_name, wellplansite_native_uid,project_native_uid),

    CONSTRAINT FK_PlannedWell_WellPlanProject
        FOREIGN KEY               (project_native_uid)
        REFERENCES WellPlanProject(native_uid),

    CONSTRAINT FK_PlannedWell_WellPlanSite
        FOREIGN KEY               (wellplansite_native_uid)
        REFERENCES WellPlanSite(native_uid),

    CONSTRAINT FK_PlannedWell_CRS
        FOREIGN KEY                    (crs)
        REFERENCES CartoReferenceSystem(name)          
)
OPTIONS(UPDATABLE 'TRUE',  PlannedWell.IMPLEMENTED 'TRUE')
AS
    SELECT
        wp.native_uid                                   AS native_uid,
        WPP.wp_project_id                               AS project_native_uid,
        COALESCE(wp.sidetrack_plan_id, wp.native_uid)   AS wellplansite_native_uid,
		WPP.wp_project_name                             AS project_name,
        COALESCE(wp2.well_plan_name, wp.well_plan_name) AS site_name,
        wp.well_plan_name                               AS well_name,
        CONCAT(wp.well_plan_name, '-uwi')               AS well_uwi,
		pws.slot_name                                   AS slot_name,
        tp.x                                            AS x_coordinate,
        tp.y                                            AS y_coordinate,
        tp.z                                            AS elevation,
        proj.min_x_dsdsunit                             AS xy_unit,
        CASE pws.ground_level
        WHEN 0.0 THEN 'off' ELSE 'on' END               AS on_off_shore,
	    NULL                                            AS is_subsea,
        UnitConvert(NVL(pws.ground_level, 0), 'ft', 
            tp.z_dsdsunit, 'length')                    AS ground_elevation,
        tp.z_dsdsunit                                   AS ground_elevation_unit,
        UnitConvert(NVL(wpsi.water_depth, 0), 'ft', 
            tp.z_dsdsunit, 'length')                    AS water_depth,
        tp.z_dsdsunit                                   AS water_depth_unit,
        'RKB'                                           AS elevation_reference,
        tp.z_dsdsunit   					            AS elevation_unit,
        getDSDSCrs(carto.name)                          AS crs,
        wp.location_type,
        wp.remark                                       AS remarks,
        wp.create_date                                  AS create_date,
        wp.create_user_id                               AS create_user_id,
        wp.update_date                                  AS update_date,
        wp.update_user_id                               AS update_user_id
    FROM openworks_SM.wellplan wp
    INNER JOIN (
      SELECT tp.x,tp.y,tp.z,tp.z_dsdsunit,wp.well_plan_id FROM openworks_SM.turnpoint tp 
      INNER JOIN openworks_SM.wellplan wp ON tp.well_plan_id=wp.well_plan_id AND wp.location_type =5 AND tp.turn_point_seq_no = -1 AND  wp.current_well_id IS NOT NULL
      UNION ALL
      SELECT tp.x,tp.y,tp.z,tp.z_dsdsunit,wp.well_plan_id FROM openworks_SM.turnpoint tp 
      INNER JOIN openworks_SM.wellplan wp ON tp.well_plan_id=wp.well_plan_id AND wp.location_type in (1,8) AND tp.turn_point_seq_no = 0
      ) tp ON wp.well_plan_id=tp.well_plan_id 
    LEFT JOIN openworks_SM.wellplan wp2 ON wp.sidetrack_plan_id=wp2.well_plan_id
    INNER JOIN OpenWorks_SM.Project proj ON 1 = 1
    INNER JOIN OpenWorks_SM.CartoRefSys carto ON carto.id = proj.xy_crs_id
    INNER JOIN OpenWorks_SM.WellPlanProj WPP ON wp.wp_project_id = WPP.wp_project_id
	LEFT JOIN plannedwellslots pws ON pws.native_uid = wp.well_plan_id
    LEFT JOIN WellPlanSiteInfo wpsi ON wpsi.native_uid = wp.sidetrack_plan_id;

CREATE TRIGGER ON PlannedWell INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC
    DECLARE INTEGER VARIABLES.location_type = "NEW".location_type;

    IF("NEW".wellplansite_native_uid IS NOT NULL)
    BEGIN
        VARIABLES.location_type = 8;
    END

    DECLARE string VARIABLES.targetCRS = (SELECT name FROM OpenWorks_SM.CartoRefSys,OpenWorks_SM.Project WHERE OpenWorks_SM.CartoRefSys.id = OpenWorks_SM.Project.xy_crs_id);
    DECLARE double VARIABLES.X;
    DECLARE double VARIABLES.Y;
    DECLARE string VARIABLES.XYUnit;
    IF(("NEW".x_coordinate IS NOT NULL) AND ("NEW".y_coordinate IS NOT NULL) AND ("NEW".xy_unit IS NOT NULL) AND ("NEW".crs IS NOT NULL))
    BEGIN
        VARIABLES.X = "NEW".x_coordinate;
        VARIABLES.Y = "NEW".y_coordinate;
        VARIABLES.XYUnit = "NEW".xy_unit;
        DECLARE blob convertedXYBlob = select cartoConvert("NEW".crs,VARIABLES.targetCRS,VARIABLES.X,VARIABLES.Y,VARIABLES.XYUnit);
        IF(convertedXYBlob IS NOT NULL)
        BEGIN
            VARIABLES.X= fetchDElementValueFromBlob(convertedXYBlob,'x');
            VARIABLES.Y= fetchDElementValueFromBlob(convertedXYBlob,'y');
            VARIABLES.XYUnit= fetchElementUnitNameFromBlob(convertedXYBlob,'x');
        END
    END

    DECLARE STRING VARIABLES.well_plan_id = SELECT well_plan_id FROM OpenWorks_SM.WellPlan 
                                            WHERE well_plan_name = "NEW".well_name
                                            AND sidetrack_plan_id = "NEW".wellplansite_native_uid
                                            AND wp_project_id = "NEW".project_native_uid;

    IF(VARIABLES.well_plan_id IS NOT NULL)
    BEGIN
        ERROR 'WellPlan ' || "NEW".well_name || ' already exists in project';
    END
    ELSE
    BEGIN
        VARIABLES.well_plan_id = (SELECT * FROM (EXEC OpenWorks_SM.nextval('WellPlan')) AS SysGenID);
    END

    INSERT INTO OpenWorks_SM.WellPlan (well_plan_id,wp_project_id, well_plan_lname, well_plan_name, well_plan_version, location_type, method_index, sidetrack_plan_id, remark)
    VALUES (CONVERT(VARIABLES.well_plan_id, INTEGER),"NEW".project_native_uid, "NEW".well_name, "NEW".well_name, 1, VARIABLES.location_type, 9, "NEW".wellplansite_native_uid, "NEW".remark);

    IF((VARIABLES.X IS NOT NULL) AND (VARIABLES.Y IS NOT NULL))
    BEGIN
        INSERT INTO OpenWorks_SM.TurnPoint (well_plan_id,turn_point_seq_no,wp_project_id, well_plan_meth_cd, x, y, z, z_dsdsunit)
        VALUES (VARIABLES.well_plan_id,0, "NEW".project_native_uid ,0, VARIABLES.X, VARIABLES.Y, "NEW".elevation, "NEW".elevation_unit);
    END

   
END;

CREATE TRIGGER ON PlannedWell INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC

    DECLARE INTEGER VARIABLES.location_type = "NEW".location_type;

    IF("NEW".wellplansite_native_uid IS NOT NULL)
    BEGIN
        VARIABLES.location_type = 8;
    END

    UPDATE OpenWorks_SM.WellPlan
    SET wp_project_id = "NEW".project_native_uid,
        well_plan_name = "NEW".well_name,
        location_type = VARIABLES.location_type,
        sidetrack_plan_id = "NEW".wellplansite_native_uid,
        remark = "New".remark 
    WHERE OpenWorks_SM.WellPlan.well_plan_id ="OLD".native_uid;

    IF ((CHANGING.x_coordinate) OR (CHANGING.y_coordinate) OR (CHANGING.xy_unit) OR (CHANGING.elevation_reference) OR (CHANGING.elevation_unit))
    BEGIN
        DECLARE double VARIABLES.X = "NEW".x_coordinate;
        DECLARE double VARIABLES.Y = "NEW".y_coordinate;
        DECLARE string VARIABLES.XYUnit = "NEW".xy_unit;
        DECLARE string VARIABLES.targetCRS = (SELECT name FROM OpenWorks_SM.CartoRefSys,OpenWorks_SM.Project WHERE OpenWorks_SM.CartoRefSys.id = OpenWorks_SM.Project.xy_crs_id);
        DECLARE blob convertedXYBlob = SELECT cartoConvert("NEW".crs,VARIABLES.targetCRS,VARIABLES.X,VARIABLES.Y,VARIABLES.XYUnit);
        IF(convertedXYBlob IS NOT NULL)
        BEGIN
            VARIABLES.X= fetchDElementValueFromBlob(convertedXYBlob,'x');
            VARIABLES.Y= fetchDElementValueFromBlob(convertedXYBlob,'y');
            VARIABLES.XYUnit= fetchElementUnitNameFromBlob(convertedXYBlob,'x');
        END

        UPDATE OpenWorks_SM.TurnPoint
        SET x = VARIABLES.X, y = VARIABLES.Y, z = "NEW".elevation, z_dsdsunit = "NEW".elevation_unit
        WHERE well_plan_id = "OLD".native_uid AND turn_point_seq_no = 0;
    END

   
 
END;

CREATE TRIGGER ON PlannedWell INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC
    DELETE FROM OpenWorks_SM.WellPlanInterval WHERE well_plan_id = "OLD".native_uid;
    DELETE FROM OpenWorks_SM.TurnPoint WHERE well_plan_id = "OLD".native_uid;
    DELETE FROM OpenWorks_SM.WellPlan WHERE  OpenWorks_SM.WellPlan.well_plan_id ="OLD".native_uid;
END;

CREATE VIEW PlannedWellbore
(
    native_uid                              VARCHAR(1024)       AUTO_INCREMENT OPTIONS("OpenWorksCommonModel:PlannedWellbore.native_uid.isUpdatable" false, 
                                                                                    "OpenWorksCommonModel:PlannedWellbore.native_uid.isCreatable" false, 
                                                                                    UPDATABLE 'FALSE'),
    project_native_uid                      VARCHAR(1024)       NOT NULL,
    wellplansite_native_uid                 VARCHAR(1024),
    plannedwell_native_uid                  VARCHAR(1024)       NOT NULL,
    plannedwell_uwi                         VARCHAR(26)         NOT NULL,
    project_name                            VARCHAR(60)         OPTIONS("OpenWorksCommonModel:PlannedWellbore.project_name.isUpdatable" false, 
                                                                        "OpenWorksCommonModel:PlannedWellbore.project_name.isCreatable" false, 
                                                                        UPDATABLE 'FALSE'),
    site_name                               VARCHAR(20),
    well_name                               VARCHAR(80)         NOT NULL,
    wellbore_name                           VARCHAR(80)         NOT NULL,
    wellbore_uwi                            VARCHAR(26)         NOT NULL,
    parent_plannedwellbore_native_uid       VARCHAR(1024),
    x_coordinate                            DOUBLE              OPTIONS ("OpenWorksCommonModel:PlannedWellbore.x_coordinate.unitField" 'xy_unit'),
    y_coordinate                            DOUBLE              OPTIONS ("OpenWorksCommonModel:PlannedWellbore.y_coordinate.unitField" 'xy_unit'),
    elevation                               DOUBLE              OPTIONS ("OpenWorksCommonModel:PlannedWellbore.elevation.unitField" 'elevation_unit'),
    xy_unit                                 VARCHAR(64),
    elevation_reference                     VARCHAR(64)         NOT NULL DEFAULT 'RKB',
    elevation_unit                          VARCHAR(64)         OPTIONS ("OpenWorksCommonModel:PlannedWellbore.elevation_unit.unitType" 'depth measure'),
    crs                                     VARCHAR(80),
    location_type                           INTEGER             DEFAULT '1',
    remark                                  VARCHAR(2000),
    create_date                             TIMESTAMP           OPTIONS ("OpenWorksCommonModel:PlannedWellbore.create_date.isUpdatable" false),
    create_user_id                          VARCHAR(30)         OPTIONS ("OpenWorksCommonModel:PlannedWellbore.create_user_id.isCreatable" false,
                                                                        "OpenWorksCommonModel:PlannedWellbore.create_user_id.isUpdatable" false,UPDATABLE 'FALSE'),
    update_date                             TIMESTAMP, 
    update_user_id                          VARCHAR(30)         OPTIONS ("OpenWorksCommonModel:PlannedWellbore.update_user_id.isCreatable" false,
                                                                        "OpenWorksCommonModel:PlannedWellbore.update_user_id.isUpdatable" false,UPDATABLE 'FALSE'),
  
    CONSTRAINT PlannedWellbore_PK PRIMARY KEY (native_uid),
    
    CONSTRAINT PlannedWellbore_UK1 UNIQUE (wellbore_name, plannedwell_native_uid),

    CONSTRAINT FK_PlannedWellbore_WellPlanSite
        FOREIGN KEY (wellplansite_native_uid)
        REFERENCES WellPlanSite(native_uid),

    CONSTRAINT FK_PlannedWellbore_WellPlanProject
        FOREIGN KEY (project_native_uid)
        REFERENCES WellPlanProject(native_uid),
        
    CONSTRAINT FK_PlannedWellbore_PlannedWell
        FOREIGN KEY (plannedwell_native_uid)
        REFERENCES PlannedWell(native_uid),

	CONSTRAINT FK_PlannedWellbore_PlannedWellbore
        FOREIGN KEY (parent_plannedwellbore_native_uid)
        REFERENCES PlannedWellbore(native_uid)
)
OPTIONS(UPDATABLE 'TRUE',  PlannedWellbore.IMPLEMENTED 'TRUE')
AS
     SELECT 
        wp.well_plan_id                          AS native_uid,
        WPP.wp_project_id                        AS project_native_uid,
        COALESCE(wp.sidetrack_plan_id, 
            wp.well_plan_id)                     AS wellplansite_native_uid,
        tp.well_id                               AS plannedwell_native_uid,
        wp.well_plan_name                        AS plannedwell_uwi,
        WPP.wp_project_name                      AS project_name,
        COALESCE(wp2.well_plan_name,
            wp.well_plan_name)                   AS site_name,
        wp.well_plan_name                        AS well_name,
        wp.well_plan_name                        AS wellbore_name,
        wp.well_plan_name                        AS wellbore_uwi,
        tp.parent_wellbore_id                    AS parent_plannedwellbore_native_uid,
        tp.x                                     AS x_coordinate,
        tp.y                                     AS y_coordinate,
        tp.z                                     AS elevation,
        proj.min_x_dsdsunit                      AS xy_unit,
        'RKB'                                    AS elevation_reference,
        tp.z_dsdsunit       				     AS elevation_unit,
        getDSDSCrs(carto.name)                   AS crs,
        wp.location_type                         AS location_type,
        wp.remark                                AS remarks,
        wp.create_date                           AS create_date,
        wp.create_user_id                        AS create_user_id,
        wp.update_date                           AS update_date,
        wp.update_user_id                        AS update_user_id
       FROM openworks_SM.wellplan wp
    INNER JOIN (
      select tp.x,tp.y,tp.z,tp.z_dsdsunit,wp.well_plan_id,wp.well_plan_id as well_id,null as parent_wellbore_id from openworks_SM.turnpoint tp inner join openworks_SM.wellplan wp on tp.well_plan_id=wp.well_plan_id and wp.location_type =5 and tp.turn_point_seq_no = -1 and wp.current_well_id is not null
      union all
      select tp.x,tp.y,tp.z,tp.z_dsdsunit,wp.well_plan_id,wp.well_plan_id as well_id, null as parent_wellbore_id from openworks_SM.turnpoint tp  inner join openworks_SM.wellplan wp on tp.well_plan_id=wp.well_plan_id and wp.location_type in (1,8) and tp.turn_point_seq_no = 0
	  union all
      select tp.x,tp.y,tp.z,tp.z_dsdsunit,wp.well_plan_id,wp.sidetrack_plan_id as well_id,wp.sidetrack_plan_id as parent_wellbore_id  from openworks_SM.turnpoint tp  inner join openworks_SM.wellplan wp on tp.well_plan_id=wp.well_plan_id and wp.location_type in (3) and tp.turn_point_seq_no = 0
      )tp on wp.well_plan_id=tp.well_plan_id 
    LEFT JOIN openworks_SM.wellplan wp2 ON wp.sidetrack_plan_id=wp2.well_plan_id
    INNER JOIN OpenWorks_SM.Project proj ON 1 = 1
    INNER JOIN OpenWorks_SM.CartoRefSys carto ON carto.id = proj.xy_crs_id
    INNER JOIN OpenWorks_SM.WellPlanProj WPP ON wp.wp_project_id = WPP.wp_project_id;
	
CREATE TRIGGER ON PlannedWellbore INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC
    DECLARE INTEGER VARIABLES.well_plan_id = NULL;
    IF("NEW".parent_plannedwellbore_native_uid IS NULL)
    BEGIN
        VARIABLES.well_plan_id = (SELECT CONVERT(well_plan_id, INTEGER) from OpenWorks_SM.WellPlan  where well_plan_id= "NEW".plannedwell_native_uid);
    END
    
    IF(VARIABLES.well_plan_id IS NOT NULL)
    BEGIN
        DECLARE STRING VARIABLES.plan_name = (SELECT well_plan_name FROM OpenWorks_SM.WellPlan WHERE well_plan_name = "NEW".wellbore_name);
        IF(VARIABLES.plan_name IS NULL)
        BEGIN
            UPDATE OpenWorks_SM.WellPlan SET
                well_plan_name = "NEW".wellbore_name,
                well_plan_lname = "NEW".wellbore_name
            WHERE well_plan_id = VARIABLES.well_plan_id;
        END
        ELSE
        BEGIN
            ERROR '(PlannedWellbore) WellPlan with name ' || "NEW".wellbore_name || ' already exists';
        END
    END
    ELSE
    BEGIN
        VARIABLES.well_plan_id = (SELECT * FROM (EXEC OpenWorks_SM.nextval('WellPlan')) AS SysGenID);
        DECLARE INTEGER VARIABLES.location_type = "NEW".location_type;
        DECLARE STRING VARIABLES.parent_plan_id = NULL;

        IF("NEW".parent_plannedwellbore_native_uid IS NOT NULL)
        BEGIN
            VARIABLES.location_type = 3;
            VARIABLES.parent_plan_id = (SELECT well_plan_id from OpenWorks_SM.WellPlan  where well_plan_id= "NEW".parent_plannedwellbore_native_uid);
        END
        
        IF("NEW".plannedwell_native_uid IS NOT NULL AND VARIABLES.parent_plan_id IS NULL)
        BEGIN
            VARIABLES.location_type = 3;
            VARIABLES.parent_plan_id = (SELECT well_plan_id from OpenWorks_SM.WellPlan  where well_plan_id= "NEW".plannedwell_native_uid);
        END
        
        IF("NEW".wellplansite_native_uid IS NOT NULL AND VARIABLES.parent_plan_id IS NULL)
        BEGIN
            VARIABLES.location_type = 8;
            VARIABLES.parent_plan_id = (SELECT well_plan_id from OpenWorks_SM.WellPlan  where well_plan_id= "NEW".wellplansite_native_uid);
        END

        DECLARE string VARIABLES.targetCRS = (SELECT name FROM OpenWorks_SM.CartoRefSys,OpenWorks_SM.Project WHERE OpenWorks_SM.CartoRefSys.id = OpenWorks_SM.Project.xy_crs_id);
        DECLARE double VARIABLES.X;
        DECLARE double VARIABLES.Y;
        DECLARE string VARIABLES.XYUnit;
        IF(("NEW".x_coordinate IS NOT NULL) AND ("NEW".y_coordinate IS NOT NULL) AND ("NEW".xy_unit IS NOT NULL) AND ("NEW".crs IS NOT NULL))
        BEGIN
            VARIABLES.X = "NEW".x_coordinate;
            VARIABLES.Y = "NEW".y_coordinate;
            VARIABLES.XYUnit = "NEW".xy_unit;
            DECLARE blob convertedXYBlob = select cartoConvert("NEW".crs,VARIABLES.targetCRS,VARIABLES.X,VARIABLES.Y,VARIABLES.XYUnit);
            IF(convertedXYBlob IS NOT NULL)
            BEGIN
                VARIABLES.X= fetchDElementValueFromBlob(convertedXYBlob,'x');
                VARIABLES.Y= fetchDElementValueFromBlob(convertedXYBlob,'y');
                VARIABLES.XYUnit= fetchElementUnitNameFromBlob(convertedXYBlob,'x');
            END
        END

        INSERT INTO OpenWorks_SM.WellPlan (well_plan_id,wp_project_id, well_plan_lname, well_plan_name, well_plan_version, location_type, method_index, sidetrack_plan_id, remark)
        VALUES (VARIABLES.well_plan_id,"NEW".project_native_uid, "NEW".wellbore_name, "NEW".wellbore_name, 1, VARIABLES.location_type, 1, VARIABLES.parent_plan_id, "New".remark);

        IF((VARIABLES.X is NOT NULL) AND (VARIABLES.Y is NOT NULL))
        BEGIN
            INSERT INTO OpenWorks_SM.TurnPoint (well_plan_id,turn_point_seq_no,wp_project_id, well_plan_meth_cd, x, y, z, z_dsdsunit)
            VALUES (VARIABLES.well_plan_id,0, "NEW".project_native_uid ,0, VARIABLES.X, VARIABLES.Y, "NEW".elevation, "NEW".elevation_unit);
        END

    END
END;

CREATE TRIGGER ON PlannedWellbore INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC

    DECLARE INTEGER VARIABLES.location_type = "NEW".location_type;
    DECLARE STRING VARIABLES.parent_plan_id = NULL;
    
    IF("CHANGING".parent_plannedwellbore_native_uid IS NOT NULL)
    BEGIN
        VARIABLES.location_type = 3;
        VARIABLES.parent_plan_id = (SELECT well_plan_id from OpenWorks_SM.WellPlan  where well_plan_id= "NEW".parent_plannedwellbore_native_uid);
    END
    
    IF("CHANGING".plannedwell_native_uid IS NOT NULL AND VARIABLES.parent_plan_id IS NULL)
    BEGIN
        VARIABLES.location_type = 3;
        VARIABLES.parent_plan_id = (SELECT well_plan_id from OpenWorks_SM.WellPlan  where well_plan_id= "NEW".plannedwell_native_uid);
    END
    
    IF("CHANGING".wellplansite_native_uid IS NOT NULL AND VARIABLES.parent_plan_id IS NULL)
    BEGIN
        VARIABLES.location_type = 8;
        VARIABLES.parent_plan_id = (SELECT well_plan_id from OpenWorks_SM.WellPlan  where well_plan_id = "NEW".wellplansite_native_uid);
    END

    IF(VARIABLES.parent_plan_id IS NOT NULL)
    BEGIN
        UPDATE OpenWorks_SM.WellPlan
        SET wp_project_id = "NEW".project_native_uid,
            well_plan_name = "NEW".wellbore_name,
            location_type = VARIABLES.location_type,
            sidetrack_plan_id = VARIABLES.parent_plan_id,
            remark = "New".remark 
        WHERE OpenWorks_SM.WellPlan.well_plan_id ="OLD".native_uid;
    END

    IF ((CHANGING.x_coordinate) OR (CHANGING.y_coordinate) OR (CHANGING.xy_unit) OR (CHANGING.elevation_reference) OR (CHANGING.elevation_unit))
    BEGIN
        DECLARE double VARIABLES.X = "NEW".x_coordinate;
        DECLARE double VARIABLES.Y = "NEW".y_coordinate;
        DECLARE string VARIABLES.XYUnit = "NEW".xy_unit;
        DECLARE string VARIABLES.targetCRS = (SELECT name FROM OpenWorks_SM.CartoRefSys,OpenWorks_SM.Project WHERE OpenWorks_SM.CartoRefSys.id = OpenWorks_SM.Project.xy_crs_id);
        DECLARE blob convertedXYBlob = SELECT cartoConvert("NEW".crs,VARIABLES.targetCRS,VARIABLES.X,VARIABLES.Y,VARIABLES.XYUnit);
        IF(convertedXYBlob IS NOT NULL)
        BEGIN
            VARIABLES.X= fetchDElementValueFromBlob(convertedXYBlob,'x');
            VARIABLES.Y= fetchDElementValueFromBlob(convertedXYBlob,'y');
            VARIABLES.XYUnit= fetchElementUnitNameFromBlob(convertedXYBlob,'x');
        END

        UPDATE OpenWorks_SM.TurnPoint
        SET x = VARIABLES.X, y = VARIABLES.Y, z = "NEW".elevation, z_dsdsunit = "NEW".elevation_unit
        WHERE well_plan_id = "OLD".native_uid AND turn_point_seq_no = 0;
    END

END;

CREATE TRIGGER ON PlannedWellbore INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC
    DELETE FROM OpenWorks_SM.WellPlanInterval WHERE well_plan_id = "OLD".native_uid;
    DELETE FROM OpenWorks_SM.TurnPoint WHERE well_plan_id = "OLD".native_uid;
    DELETE FROM OpenWorks_SM.WellPlan WHERE  OpenWorks_SM.WellPlan.well_plan_id ="OLD".native_uid;
END;

CREATE VIEW wellplanlocation
(
    native_uid                              VARCHAR(20),
    spatial                          BLOB        OPTIONS ("OpenWorksCommonModel:wellplanlocation.spatial.isSpatial" true,
                                                  "OpenWorksCommonModel:wellplanlocation.spatial.isCreatable" false,
                                                  "OpenWorksCommonModel:wellplanlocation.spatial.isUpdatable" false,
                                                  UPDATABLE 'FALSE',
                                                  "OpenWorksCommonModel:wellplanlocation.spatial.isComplexType" true,
                                                  "OpenWorksCommonModel:wellplanlocation.spatial.isComplexTypeArray" false,
                                                  "OpenWorksCommonModel:wellplanlocation.spatial.elementType" 'POINT',
                                                  "OpenWorksCommonModel:wellplanlocation.spatial.elementStruct" '[{"name":"linestring":"type":[{"name":"x","type":"double"},{"name":"y","type":"double"}]}]')
)
OPTIONS(UPDATABLE 'FALSE',  wellplanlocation.IMPLEMENTED 'TRUE')
AS
  select wp.well_plan_id,
  GETSURFACELOCATIONPT(null,null,convert(x,string),convert(y,string),(Select getDSDSCrs(name) from OpenWorks_SM.CartoRefSys,OpenWorks_SM.Project where CartoRefSys.id = OpenWorks_SM.Project.xy_crs_id),x_dsdsunit) 
  from openworks_SM.wellplan wp
  inner join openworks_SM.turnpoint tp on wp.well_plan_id=tp.well_plan_id where tp.turn_point_seq_no=0 and wp.location_type IN (1,3,5,8);

CREATE VIEW tmpwellplanview
(
    native_uid                              VARCHAR(20),
    wellbore_native_uid                     VARCHAR(20),
    location_type                           INTEGER,
	parent_location_type                    INTEGER,
    platform_native_uid                     VARCHAR(20)
)
OPTIONS(UPDATABLE 'FALSE',  tmpwellplanview.IMPLEMENTED 'TRUE')
AS
  SELECT 
    wp1.well_plan_id as native_uid,
    wp1.native_uid as wellbore_native_uid,
    wp1.location_type, 
    wp2.location_type as parent_location_type,
    wp1.sidetrack_plan_id 
  FROM openworks_SM.wellplan wp1
  INNER JOIN openworks_SM.turnpoint tp ON wp1.well_plan_id = tp.well_plan_id AND tp.turn_point_seq_no = 0
  LEFT JOIN openworks_SM.wellplan wp2 ON wp1.sidetrack_plan_id = wp2.well_plan_id 
  WHERE wp1.location_type IN (1,8);
  
CREATE VIEW plannedwellslots
(
    native_uid                              VARCHAR(20),
    wellplan_site_native_uid                VARCHAR(20),
	slot_name                               VARCHAR(40),
	ground_level                            FLOAT
)
OPTIONS(UPDATABLE 'FALSE',  plannedwellslots.IMPLEMENTED 'TRUE')
AS  
  SELECT
    wp.well_plan_id                         AS native_uid,
    wp.sidetrack_plan_id                    AS wellplan_site_native_uid,
    slot_templates.SLOT_NAME                AS SLOT_NAME,
    slot_templates.GROUND_LEVEL             AS GROUND_LEVEL
    FROM (SELECT intvl.native_uid,intvl.well_plan_id,intvl.wp_interval_type,intvl.interval_text FROM openworks_SM.wellplan wplan,openworks_SM.wellplaninterval intvl WHERE  wplan.well_plan_id=intvl.well_plan_id and wplan.location_type=8 and intvl.wp_interval_type='PROPERTIES') wpi,
 xmltable('INTERVAL_DATA' PASSING xmlparse(document wpi.interval_text)
 COLUMNS
   GROUND_LEVEL FLOAT  PATH '@GROUND_LEVEL',
   SLOT_NAME  STRING   PATH '@SLOT_ID'
  ) AS slot_templates, openworks_SM.wellplan wp
WHERE wp.well_plan_id=wpi.well_plan_id and wp.location_type=8;
 
CREATE VIEW WellPlanSiteInfo
(
    native_uid                      VARCHAR(20),
    wellplan_project_native_uid     VARCHAR(20),
	cost                            DOUBLE,
	day_rate                        DOUBLE,
	override_cost                   VARCHAR(6),
	override_day_rate               VARCHAR(6),
	override_slots                  VARCHAR(6),
	slots                           DOUBLE,
	type                            VARCHAR(50),
	water_depth                     FLOAT
)
OPTIONS(UPDATABLE 'FALSE',  WellPlanSiteInfo.IMPLEMENTED 'FALSE')
AS
    SELECT
        wp.well_plan_id                 AS native_uid,
        wp.wp_project_id                AS wellplan_project_native_uid,
        siteinfo.cost,
        siteinfo.day_rate,
        siteinfo.override_cost,
        siteinfo.override_day_rate,
        siteinfo.override_slots,
        siteinfo.slots,
        siteinfo.type,
        siteinfo.water_depth
    FROM (SELECT intvl.native_uid,intvl.well_plan_id,intvl.wp_interval_type,intvl.interval_text FROM OpenWorks_SM.WellPlanInterval intvl, OpenWorks_SM.WellPlan wplan 
        WHERE  wplan.well_plan_id = intvl.well_plan_id and wplan.location_type = 7 and intvl.wp_interval_type='PLATFORM_INFO') wpi,
        XMLTABLE('INTERVAL_DATA' PASSING XMLPARSE(document wpi.interval_text) 
            COLUMNS 
                COST                DOUBLE      PATH '@COST',
                DAY_RATE            DOUBLE      PATH '@DAY_RATE',
                OVERRIDE_COST       VARCHAR(6)  PATH '@OVERRIDE_COST',
                OVERRIDE_DAY_RATE   VARCHAR(6)  PATH '@OVERRIDE_DAY_RATE',
                OVERRIDE_SLOTS      VARCHAR(6)  PATH '@OVERRIDE_SLOTS',
                SLOTS               DOUBLE      PATH '@SLOTS',
                TYPE                VARCHAR(50) PATH '@TYPE',
                WATER_DEPTH         FLOAT       PATH '@WATER_DEPTH') AS siteinfo, OpenWorks_SM.WellPlan wp
    WHERE wp.well_plan_id = wpi.well_plan_id;


/*
**********************************
* ENTITY: Concepts
**********************************
*/
CREATE VIEW Concepts
( concept_id             VARCHAR(1024) AUTO_INCREMENT 
                                           OPTIONS ("OpenWorksCommonModel:Concepts.concept_id.isUpdatable" false,
                                                    "OpenWorksCommonModel:Concepts.concept_id.isCreatable" false,
                                                     UPDATABLE 'FALSE'), 													 
  project_name       VARCHAR(40) NOT NULL,
  scenario_name       VARCHAR(40) NOT NULL,
  concept_name          VARCHAR(24) NOT NULL,
  concept_description                 VARCHAR(200),
  boundries                 VARCHAR(4000),
  hazards                 VARCHAR(4000),
  targets                 VARCHAR(4000),
  siteOutlines                 VARCHAR(4000),
  sites                 VARCHAR(4000),
  plans                 VARCHAR(4000),
  CONSTRAINT concepts_PK PRIMARY KEY (concept_id)
)
OPTIONS (UPDATABLE 'TRUE' , Concepts.IMPLEMENTED 'TRUE')
    AS
    SELECT
        native_uid as concept_id,
        projectName AS project_name,
		scenarioName AS scenario_name,
        conceptName AS concept_name,
        conceptDescription AS concept_description, 
        convert(boundries,varchar) as boundries,
		convert(hazards,varchar) as hazards,
		convert(targets,varchar) as targets,
		convert(siteOutlines,varchar) as siteOutlines,
		convert(sites,varchar) as sites,
		convert(plans,varchar) as plans
    FROM OpenWorks_SM.ApplicationData,
	XMLTABLE('concept' passing JSONTOXML('concept', data )
	COLUMNS 
	projectName string PATH 'projectName',
	scenarioName string PATH 'scenarioName',
	conceptName string PATH 'conceptName',
	conceptDescription string PATH 'conceptDescription',
	boundries XML PATH 'boundries',
	hazards XML PATH 'boundries',
	targets XML PATH 'targets',
	siteOutlines XML PATH 'siteOutlines',
	sites XML PATH 'sites',
	plans XML PATH 'plans'
	) AS concept_data
where application_name='FDP';

/*
**********************************
* ENTITY: ConceptTargets
**********************************
*/
CREATE VIEW ConceptTargets
(
  target_id                 VARCHAR(1024) AUTO_INCREMENT 
                                           OPTIONS ("OpenWorksCommonModel:ConceptTargets.target_id.isUpdatable" false,
                                                    "OpenWorksCommonModel:ConceptTargets.target_id.isCreatable" false,
                                                     UPDATABLE 'FALSE'),
  concept_id                VARCHAR(1024)  NOT NULL,
  concept_name              VARCHAR(1024),        
  target_name               VARCHAR(1024),
  project_name              VARCHAR(1024) 
)
OPTIONS (UPDATABLE 'TRUE', ConceptTargets.IMPLEMENTED 'TRUE')
AS  
SELECT tgt.native_uid as target_id,
       ad.native_uid as concept_id,
	   targetData.conceptName as concept_name,
       targetData.targetName as target_name,
	   targetData.scenarioName as project_name
    FROM (select native_uid,data,application_name from OpenWorks_SM.ApplicationData where application_name='FDP') ad,
	XMLTABLE('/concept/targets' passing JSONTOXML('concept',data)
	COLUMNS
	scenarioName varchar PATH '../scenarioName',
	conceptName varchar PATH '../conceptName',
	targetName varchar PATH 'text()')	as targetData,OpenWorks_SM.WellPlanProj wpp,
    /*+ MAKEDEP */ OpenWorks_SM.TARGET tgt where wpp.WP_PROJECT_NAME = targetData.scenarioName and tgt.TARGET_NAME = targetData.targetName and tgt.WP_PROJECT_ID = wpp.WP_PROJECT_ID; 


/*
**********************************
* ENTITY: ConceptPlans
**********************************
*/
CREATE VIEW ConceptPlans
(
  plan_id                 VARCHAR(1024) AUTO_INCREMENT 
                                           OPTIONS ("OpenWorksCommonModel:ConceptPlans.plan_id.isUpdatable" false,
                                                    "OpenWorksCommonModel:ConceptPlans.plan_id.isCreatable" false,
                                                     UPDATABLE 'FALSE'),
  concept_id                VARCHAR(1024)  NOT NULL,
  concept_name              VARCHAR(1024),        
  plan_name               VARCHAR(1024),
  project_name              VARCHAR(1024) 
)
OPTIONS (UPDATABLE 'TRUE', ConceptPlans.IMPLEMENTED 'TRUE')
AS  
SELECT wp.well_plan_id as plan_id,
       ad.native_uid as concept_id,
	   planData.conceptName as concept_name,
       planData.planName as plan_name,
	   planData.scenarioName as project_name
    FROM (select native_uid,data,application_name from OpenWorks_SM.ApplicationData where application_name='FDP') ad,
	XMLTABLE('/concept/plans' passing JSONTOXML('concept',data)
	COLUMNS
	scenarioName varchar PATH '../scenarioName',
	conceptName varchar PATH '../conceptName',
	planName varchar PATH 'text()')	as planData,OpenWorks_SM.WellPlanProj wpp,
    /*+ MAKEDEP */ OpenWorks_SM.WellPlan wp where wpp.WP_PROJECT_NAME = planData.scenarioName 
	and wp.well_plan_name = planData.planName and wp.WP_PROJECT_ID = wpp.WP_PROJECT_ID;	
	
/*
**********************************
* ENTITY: ConceptSites
**********************************
*/	
CREATE VIEW ConceptSites
(
  site_id                 VARCHAR(1024) AUTO_INCREMENT 
                                           OPTIONS ("OpenWorksCommonModel:ConceptSites.site_id.isUpdatable" false,
                                                    "OpenWorksCommonModel:ConceptSites.site_id.isCreatable" false,
                                                     UPDATABLE 'FALSE'),
  concept_id                VARCHAR(1024)  NOT NULL,
  concept_name              VARCHAR(1024),        
  site_name               VARCHAR(1024),
  project_name              VARCHAR(1024) 
)
OPTIONS (UPDATABLE 'TRUE', ConceptSites.IMPLEMENTED 'TRUE')
AS  
SELECT wp.well_plan_id as site_id,
       ad.native_uid as concept_id,
	   siteData.conceptName as concept_name,
       siteData.siteName as site_name,
	   siteData.scenarioName as project_name
    FROM (select native_uid,data,application_name from OpenWorks_SM.ApplicationData where application_name='FDP') ad,
	XMLTABLE('/concept/sites' passing JSONTOXML('concept',data)
	COLUMNS
	scenarioName varchar PATH '../scenarioName',
	conceptName varchar PATH '../conceptName',
	siteName varchar PATH 'text()')	as siteData,OpenWorks_SM.WellPlanProj wpp,
    /*+ MAKEDEP */ OpenWorks_SM.WellPlan wp where wpp.WP_PROJECT_NAME = siteData.scenarioName 
	and wp.well_plan_name = siteData.siteName and wp.WP_PROJECT_ID = wpp.WP_PROJECT_ID;		

	
/*
**********************************
* ENTITY: ConceptSiteOutlines
**********************************
*/
CREATE VIEW ConceptSiteOutlines
(
  site_outline_id                 VARCHAR(1024) AUTO_INCREMENT 
                                           OPTIONS ("OpenWorksCommonModel:ConceptSiteOutlines.site_outline_id.isUpdatable" false,
                                                    "OpenWorksCommonModel:ConceptSiteOutlines.site_outline_id.isCreatable" false,
                                                     UPDATABLE 'FALSE'),
  concept_id                VARCHAR(1024)  NOT NULL,
  concept_name              VARCHAR(1024),        
  site_outline_name               VARCHAR(1024),
  project_name              VARCHAR(1024) 
)
OPTIONS (UPDATABLE 'TRUE', ConceptSiteOutlines.IMPLEMENTED 'TRUE')
AS  
SELECT tgt.native_uid as site_outline_id,
       ad.native_uid as concept_id,
	   siteOutlines.conceptName as concept_name,
       siteOutlines.siteOutlineName as site_outline_name,
	   siteOutlines.scenarioName as project_name
    FROM (select native_uid,data,application_name from OpenWorks_SM.ApplicationData where application_name='FDP') ad,
	XMLTABLE('/concept/siteOutlines' passing JSONTOXML('concept',data)
	COLUMNS
	scenarioName varchar PATH '../scenarioName',
	conceptName varchar PATH '../conceptName',
	siteOutlineName varchar PATH 'text()')	as siteOutlines,OpenWorks_SM.WellPlanProj wpp,
    /*+ MAKEDEP */ OpenWorks_SM.TARGET tgt where wpp.WP_PROJECT_NAME = siteOutlines.scenarioName and tgt.TARGET_NAME = siteOutlines.siteOutlineName and tgt.WP_PROJECT_ID = wpp.WP_PROJECT_ID;
