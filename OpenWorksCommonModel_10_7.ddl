/*
**********************************
* ENTITY: WellCoreAnalysis
**********************************
*/

CREATE VIEW WellCoreAnalysis
(
	native_uid                          VARCHAR(1024)   OPTIONS("OpenWorksCommonModel:WellCoreAnalysis.native_uid.isUpdatable" false,
                                                                "OpenWorksCommonModel:WellCoreAnalysis.native_uid.isCreatable" false,
                                                                UPDATABLE 'FALSE'),
    wellbore_native_uid                 VARCHAR(1024)   NOT NULL,
    wellcore_native_uid                 VARCHAR(1024)   NOT NULL,
    core_id                             VARCHAR(20)     NOT NULL,
    data_source                         VARCHAR(6)      NOT NULL,
    analysis_obs_no                     INTEGER			NOT NULL,
    sample_analysis_obs_no              INTEGER         NOT NULL,
    data                          		BLOB 			NOT NULL OPTIONS ("OpenWorksCommonModel:WellCoreAnalysis.data.isComplexType"      true,
    														 "OpenWorksCommonModel:WellCoreAnalysis.data.isComplexTypeArray" false,
    														 "OpenWorksCommonModel:WellCoreAnalysis.data.elementType"        'WellCoreAnalysis',
    														 "OpenWorksCommonModel:WellCoreAnalysis.data.elementStruct"
    															 '[{"name":"sample_number", "type":"string[]"},
    															 {"name":"top_depth", "type":"float[]"},
    															 {"name":"interval_depth", "type":"float[]"},
    															 {"name":"interval_length", "type":"float[]"},
    															 {"name":"bulk_volume", "type":"float[]"},
    															 {"name":"bulk_volume_oil_sat", "type":"float[]"},
    															 {"name":"bulk_mass_water_sat", "type":"float[]"},
    															 {"name":"water_sat", "type":"float[]"},
    															 {"name":"irr_water_sat", "type":"float[]"},
    															 {"name":"critical_water_sat", "type":"float[]"},
    															 {"name":"cation_exchange_cap", "type":"float[]"},
    															 {"name":"porosity", "type":"float[]"},
    															 {"name":"pore_volume_water_sat", "type":"float[]"},
    															 {"name":"pore_volume_oil_sat", "type":"float[]"},
    															 {"name":"oil_sat", "type":"float[]"},
    															 {"name":"grain_mass_water_sat", "type":"float[]"},
    															 {"name":"grain_mass_oil_sat", "type":"float[]"},
    															 {"name":"grain_density", "type":"float[]"},
    															 {"name":"gas_sat_pore_vol", "type":"float[]"},
    															 {"name":"gas_sat_bulk_vol", "type":"float[]"},
    															 {"name":"combustible_gas", "type":"float[]"},
    															 {"name":"effective_porosity", "type":"float[]"},
    															 {"name":"helium_porosity", "type":"float[]"},
    															 {"name":"kvert", "type":"float[]"},
    															 {"name":"kmax", "type":"float[]"},
    															 {"name":"khoriz", "type":"float[]"},
    															 {"name":"k90", "type":"float[]"},
    															 {"name":"bulk_volume_water_sat", "type":"float[]"},
    															 {"name":"bulk_density", "type":"float[]"},
    															 {"name":"bulk_mass_oil_sat", "type":"float[]"},
    															 {"name":"bulk_mass_sand_sat", "type":"float[]"},
    															 {"name":"confine_sat_press", "type":"float[]"},
    															 {"name":"confine_perm_press", "type":"float[]"},
    															 {"name":"confine_por_press", "type":"float[]"},
    															 {"name":"water_resistivity", "type":"float[]"},
    															 {"name":"water_resistivity_temp", "type":"float[]"},
    															 {"name":"resistivity_index", "type":"float[]"},
    															 {"name":"skin_factor", "type":"float[]"},
    															 {"name":"klinkenberg_kvert", "type":"float[]"},
    															 {"name":"klinkenberg_khoriz", "type":"float[]"},
    															 {"name":"klinkenberg_kmax", "type":"float[]"},
    															 {"name":"klinkenberg_k90", "type":"float[]"},
    															 {"name":"oil_gravity", "type":"float[]"},
    															 {"name":"prob_production", "type":"string[]"},
    															 {"name":"original_data_source", "type":"string[]"},
    															 {"name":"remark", "type":"string[]"},
    															 {"name":"property_value", "type":"float[]"}]',
    														 "OpenWorksCommonModel:WellCoreAnalysis.data.elementMetadata"
    															 '[{"name":"top_depth", "unitField":"top_depth_unit"},
    															 {"name":"interval_length", "unitField":"interval_depth_unit"},
    															 {"name":"interval_length", "unitField":"interval_length_unit"},
    															 {"name":"bulk_volume", "unitField":"bulk_volume_unit"},
    															 {"name":"bulk_volume_oil_sat", "unitField":"bulk_volume_oil_sat_unit"},
    															 {"name":"bulk_mass_water_sat", "unitField":"bulk_mass_water_sat_unit"},
    															 {"name":"water_sat", "unitField":"water_sat_unit"},
    															 {"name":"irr_water_sat", "unitField":"irr_water_sat_unit"},
    															 {"name":"critical_water_sat", "unitField":"critical_water_sat_unit"},
    															 {"name":"cation_exchange_cap", "unitField":"cation_exchange_cap_unit"},
    															 {"name":"porosity", "unitField":"porosity_unit"},
    															 {"name":"pore_volume_water_sat", "unitField":"pore_volume_water_sat_unit"},
    															 {"name":"pore_volume_oil_sat", "unitField":"pore_volume_oil_sat_unit"},
    															 {"name":"oil_sat", "unitField":"oil_sat_unit"},
    															 {"name":"grain_mass_water_sat", "unitField":"grain_mass_water_sat_unit"},
    															 {"name":"grain_mass_oil_sat", "unitField":"grain_mass_oil_sat_unit"},
    															 {"name":"grain_density", "unitField":"grain_density_unit"},
    															 {"name":"gas_sat_pore_vol", "unitField":"gas_sat_pore_vol_unit"},
    															 {"name":"gas_sat_bulk_vol", "unitField":"gas_sat_bulk_vol_unit"},
    															 {"name":"combustible_gas", "unitField":"combustible_gas_unit"},
    															 {"name":"effective_porosity", "unitField":"effective_porosity_unit"},
    															 {"name":"helium_porosity", "unitField":"helium_porosity_unit"},
    															 {"name":"kvert", "unitField":"kvert_unit"},
    															 {"name":"kmax", "unitField":"kmax_unit"},
    															 {"name":"khoriz", "unitField":"khoriz_unit"},
    															 {"name":"k90", "unitField":"k90_unit"},
    															 {"name":"bulk_volume_water_sat", "unitField":"bulk_volume_water_sat_unit"},
    															 {"name":"bulk_density", "unitField":"bulk_density_unit"},
    															 {"name":"bulk_mass_oil_sat", "unitField":"bulk_mass_oil_sat_unit"},
    															 {"name":"bulk_mass_sand_sat", "unitField":"bulk_mass_sand_sat_unit"},
    															 {"name":"confine_sat_press", "unitField":"confine_sat_press_unit"},
    															 {"name":"confine_perm_press", "unitField":"confine_perm_press_unit"},
    															 {"name":"confine_por_press", "unitField":"confine_por_press_unit"},
    															 {"name":"water_resistivity", "unitField":"water_resistivity_unit"},
    															 {"name":"water_resistivity_temp", "unitField":"water_resistivity_temp_unit"},
    															 {"name":"resistivity_index", "unitField":"resistivity_index_unit"},
    															 {"name":"skin_factor", "unitField":"skin_factor_unit"},
    															 {"name":"klinkenberg_kvert", "unitField":"klinkenberg_kvert_unit"},
    															 {"name":"klinkenberg_khoriz", "unitField":"klinkenberg_khoriz_unit"},
    															 {"name":"klinkenberg_kmax", "unitField":"klinkenberg_kmax_unit"},
    															 {"name":"klinkenberg_k90", "unitField":"klinkenberg_k90_unit"},
    															 {"name":"oil_gravity", "unitField":"oil_gravity_unit"},
    															 {"name":"property_value", "unitField":"property_value_unit"}]')
    															 ,
    analyzing_company                   VARCHAR(40),
    analysis_date                       DATE,
    primary_sample_type                 VARCHAR(12),
    sample_shape                        VARCHAR(12),
    sample_length                       FLOAT           OPTIONS("OpenWorksCommonModel:WellCoreAnalysis.top_depth.unitField" 'sample_length_unit'),
    sample_length_unit                  VARCHAR(64)     OPTIONS("OpenWorksCommonModel:WellCoreAnalysis.sample_length_unit.unitType" 'length sample'),
    sample_diameter                     FLOAT           OPTIONS("OpenWorksCommonModel:WellCoreAnalysis.top_depth.unitField" 'sample_diameter_unit'),
    sample_diameter_unit                VARCHAR(64)     OPTIONS("OpenWorksCommonModel:WellCoreAnalysis.sample_diameter_unit.unitType" 'length sample'),
    analyzing_company_location          VARCHAR(32),
    analyzing_file_no                   VARCHAR(15),
    core_analyst_name                   VARCHAR(60),
    analysis_cost                       FLOAT,
    original_data_source                VARCHAR(5),
    remark                              VARCHAR(200),
    currency                            VARCHAR(24),
    create_date                         TIMESTAMP       OPTIONS ("OpenWorksCommonModel:WellCoreAnalysis.create_date.isUpdatable" false,
                                                                 "OpenWorksCommonModel:WellCoreAnalysis.create_date.isCreatable" false,
                                                                 UPDATABLE 'FALSE'),
    create_user_id                      VARCHAR(32)     OPTIONS ("OpenWorksCommonModel:WellCoreAnalysis.create_user_id.isUpdatable" false,
                                                                 "OpenWorksCommonModel:WellCoreAnalysis.create_user_id.isCreatable" false,
                                                                 UPDATABLE 'FALSE'),
    update_user_id                      VARCHAR(32)     OPTIONS ("OpenWorksCommonModel:WellCoreAnalysis.update_user_id.isUpdatable" false,
                                                                 "OpenWorksCommonModel:WellCoreAnalysis.update_user_id.isCreatable" false,
                                                                 UPDATABLE 'FALSE'),
    update_date                         TIMESTAMP       OPTIONS ("OpenWorksCommonModel:WellCoreAnalysis.update_date.isUpdatable" false,
                                                                 "OpenWorksCommonModel:WellCoreAnalysis.update_date.isCreatable" false,
                                                                 UPDATABLE 'FALSE'),
    alternate_uid    		                    VARCHAR(4000)   OPTIONS("OpenWorksCommonModel:WellCoreAnalysis.alternate_uid.isCreatable" false,
                                                                "OpenWorksCommonModel:WellCoreAnalysis.alternate_uid.isUpdatable" false,
                                                                 UPDATABLE 'FALSE'),
    CONSTRAINT WellCoreAnalysis_PK PRIMARY KEY (native_uid),

    CONSTRAINT WellCoreAnalysis_UK1 UNIQUE (wellcore_native_uid, data_source, analysis_obs_no,sample_analysis_obs_no),

    CONSTRAINT FK_WellCoreAnalysis_wellbore_native_uid
         FOREIGN KEY       (wellbore_native_uid)
         REFERENCES Wellbore(native_uid),

    CONSTRAINT FK_WellCoreAnalysis_well_core_native_uid
         FOREIGN KEY       (wellcore_native_uid)
         REFERENCES WellCore(native_uid),

    CONSTRAINT FK_WellCoreAnalysis_data_source
         FOREIGN KEY       (data_source)
         REFERENCES DataSource(name)

)
    OPTIONS (UPDATABLE 'TRUE', WellCoreAnalysis.IMPLEMENTED 'TRUE')
    AS

SELECT
	composeNativeUid(distsampanal.wellid, distsampanal.core_id,distsampanal.data_source,distsampanal.analysis_obs_no, distsampanal.sample_analysis_obs_no) AS native_uid,
    distsampanal.wellid AS wellbore_native_uid,
    Openworks_SM.WellCore.native_uid AS wellcore_native_uid,
    distsampanal.core_id AS core_id,
    distsampanal.data_source AS data_source,
    distsampanal.analysis_obs_no AS analysis_obs_no,
    distsampanal.sample_analysis_obs_no as sample_analysis_obs_no,
    (SELECT t.data FROM TABLE(EXEC Openworks_SM.CoreAnalysisRead(distsampanal.wellid,distsampanal.core_id, distsampanal.data_source, distsampanal.analysis_obs_no,distsampanal.sample_analysis_obs_no)) AS t) AS data,
    analyzing_company AS analyzing_company,
    convert(analysis_date, date) AS analysis_date,
    primary_sample_type AS primary_sample_type,
    sample_shape AS sample_shape,
    sample_length AS sample_length,
    sample_length_dsdsunit AS sample_length_unit,
    sample_diam AS sample_diameter,
    sample_diam_dsdsunit AS sample_diam_unit,
    analyzing_company_loc AS analyzing_company_location,
    analyzing_file_no AS analyzing_file_no,
    core_analyst_name AS core_analyst_name,
    analysis_cost AS analysis_cost,
    Openworks_SM.WellCoreAnalysis.original_data_source AS original_data_source,
    Openworks_SM.WellCoreAnalysis.remark AS remark,
    Openworks_SM.WellCoreAnalysis.currency AS currency,
    Openworks_SM.WellCoreAnalysis.create_date AS create_date,
    Openworks_SM.WellCoreAnalysis.create_user_id AS create_user_id,
    Openworks_SM.WellCoreAnalysis.update_user_id AS update_user_id,
    Openworks_SM.WellCoreAnalysis.update_date AS update_date,
    Openworks_SM.WellCoreAnalysis.native_uid AS alternate_uid
    FROM (select distinct wellid,core_id,data_source,analysis_obs_no,sample_analysis_obs_no from openworks_SM.wellcoresampleanal) distsampanal,
    Openworks_SM.WellCore,
    Openworks_SM.WellCoreAnalysis
    where
    distsampanal.wellid = Openworks_SM.WellCoreAnalysis.wellid
    and distsampanal.core_id = Openworks_SM.WellCoreAnalysis.core_id
    and distsampanal.data_source = Openworks_SM.WellCoreAnalysis.data_source
    and distsampanal.analysis_obs_no = Openworks_SM.WellCoreAnalysis.analysis_obs_no
    and Openworks_SM.WellCoreAnalysis.wellid = Openworks_SM.WellCore.wellid
    and Openworks_SM.WellCoreAnalysis.core_id = Openworks_SM.WellCore.core_id
    and Openworks_SM.WellCoreAnalysis.data_source = Openworks_SM.WellCore.data_source;



CREATE TRIGGER ON WellCoreAnalysis INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC

   DECLARE string VARIABLES.wellid = getJSONElementValue("NEW".wellcore_native_uid,'wellid');
   DECLARE string VARIABLES.core_id = getJSONElementValue("NEW".wellcore_native_uid,'core_id');
   DECLARE string VARIABLES.data_source = getJSONElementValue("NEW".wellcore_native_uid,'data_source');

   DECLARE string VARIABLES.wellcore_errorMsg='ERROR: The given wellcore_native_uid "' ||"NEW".wellcore_native_uid || '" does not exist in OpenWorks';
   DECLARE string VARIABLES.coreid = (SELECT core_id FROM OpenWorks_SM.WellCore WHERE wellid = VARIABLES.wellid AND core_id=VARIABLES.core_id AND data_source=VARIABLES.data_source);

     IF(VARIABLES.coreid IS NULL)
  BEGIN
    ERROR VARIABLES.wellcore_errorMsg;
  END

   DECLARE integer VARIABLES.analysisObsNo= (Select analysis_obs_no from Openworks_SM.WellCoreAnalysis where core_id=VARIABLES.core_id and wellid = VARIABLES.wellid and data_source=VARIABLES.data_source and analysis_obs_no="NEW".analysis_obs_no);


    IF(VARIABLES.analysisObsNo IS NULL)
  BEGIN

	INSERT INTO Openworks_SM.WellCoreAnalysis(wellid,           core_id,          data_source,           analysis_obs_no,       analyzing_company, analysis_date, primary_sample_type, sample_shape, sample_length, sample_length_dsdsunit, sample_diam, sample_diam_dsdsunit, analyzing_company_loc, analyzing_file_no, core_analyst_name, analysis_cost, original_data_source, remark, currency)
                                   VALUES(VARIABLES.wellid ,VARIABLES.coreid, VARIABLES.data_source, "NEW".analysis_obs_no, "NEW".analyzing_company, convert("NEW".analysis_date, timestamp), "NEW".primary_sample_type, "NEW".sample_shape, "NEW".sample_length, "NEW".sample_length_unit, "NEW".sample_diameter, "NEW".sample_diameter_unit, "NEW".analyzing_company_location, "NEW".analyzing_file_no, "NEW".core_analyst_name, "NEW".analysis_cost, "NEW".original_data_source, "NEW".remark, "NEW".currency);
  END


 EXEC Openworks_SM.CoreSampleAnalysisWrite(VARIABLES.wellid, VARIABLES.core_id,
		VARIABLES.data_source, "NEW".analysis_obs_no, "NEW".sample_analysis_obs_no, "NEW".data);

 EXEC Openworks_SM.CoreSampleDescriptionWrite(VARIABLES.wellid, VARIABLES.core_id,
		VARIABLES.data_source, "NEW".analysis_obs_no, "NEW".sample_analysis_obs_no, "NEW".data);


 EXEC Openworks_SM.CoreSamplePropertyWrite(VARIABLES.wellid, VARIABLES.core_id,
		VARIABLES.data_source, "NEW".analysis_obs_no, "NEW".sample_analysis_obs_no, "NEW".data);

END;


CREATE TRIGGER ON WellCoreAnalysis INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC

DECLARE string VARIABLES.wellid = getJSONElementValue("NEW".wellcore_native_uid,'wellid');
DECLARE string VARIABLES.core_id = getJSONElementValue("NEW".wellcore_native_uid,'core_id');
DECLARE string VARIABLES.data_source = getJSONElementValue("NEW".wellcore_native_uid,'data_source');

Update Openworks_SM.WellCoreAnalysis Set    analyzing_company="NEW".analyzing_company, analysis_date=convert("NEW".analysis_date, timestamp), primary_sample_type="NEW".primary_sample_type, sample_shape="NEW".sample_shape, sample_length="NEW".sample_length, sample_length_dsdsunit="NEW".sample_length_unit, sample_diam="NEW".sample_diameter, sample_diam_dsdsunit="NEW".sample_diameter_unit, analyzing_company_loc="NEW".analyzing_company_location, analyzing_file_no="NEW".analyzing_file_no, core_analyst_name="NEW".core_analyst_name, analysis_cost="NEW".analysis_cost, original_data_source="NEW".original_data_source, remark="NEW".remark, currency="NEW".currency
Where   native_uid = "OLD".native_uid;

 EXEC Openworks_SM.CoreSampleAnalysisWrite(VARIABLES.wellid, VARIABLES.core_id,
		VARIABLES.data_source, "NEW".analysis_obs_no, "NEW".sample_analysis_obs_no, "NEW".data);

 EXEC Openworks_SM.CoreSampleDescriptionWrite(VARIABLES.wellid, VARIABLES.core_id,
		VARIABLES.data_source, "NEW".analysis_obs_no, "NEW".sample_analysis_obs_no, "NEW".data);

 EXEC Openworks_SM.CoreSamplePropertyWrite(VARIABLES.wellid, VARIABLES.core_id,
		VARIABLES.data_source, "NEW".analysis_obs_no, "NEW".sample_analysis_obs_no, "NEW".data);

END;

CREATE TRIGGER ON WellCoreAnalysis INSTEAD OF Delete AS
FOR EACH ROW
BEGIN ATOMIC
Delete from Openworks_SM.WellCoreAnalysis    Where native_uid="OLD".native_uid ;
END;


/*
**********************************
* ENTITY: WELL_CORE
**********************************
*/
CREATE VIEW WellCore
(
	native_uid                  VARCHAR(1024)   OPTIONS("OpenWorksCommonModel:WellCore.native_uid.isUpdatable" false,
                                                        "OpenWorksCommonModel:WellCore.native_uid.isCreatable" false,
                                                        UPDATABLE 'FALSE'),
    wellbore_native_uid         VARCHAR(1024)   NOT NULL,
    wellbore_uwi                VARCHAR(1024)   OPTIONS("OpenWorksCommonModel:WellCore.wellbore_uwi.isUpdatable" false,
                                                        "OpenWorksCommonModel:WellCore.wellbore_uwi.isCreatable" false,UPDATABLE 'FALSE'),
    core_id                     VARCHAR(20)     NOT NULL,
    data_source                 VARCHAR(6)     NOT NULL,
    contractor                  VARCHAR(40)     DEFAULT 'UNKNOWN',
    recovery_date               DATE,
    core_type                   VARCHAR(12),
    run_number                  INTEGER,
    job_number                  INTEGER,
    top_depth                   FLOAT           OPTIONS("OpenWorksCommonModel:WellCore.top_depth.unitField" 'top_depth_unit'),
    top_depth_unit              VARCHAR(64)     OPTIONS("OpenWorksCommonModel:WellCore.top_depth_unit.unitType" 'depth measure'),
    base_depth                  FLOAT           OPTIONS("OpenWorksCommonModel:WellCore.base_depth.unitField" 'base_depth_unit'),
    base_depth_unit             VARCHAR(64)     OPTIONS("OpenWorksCommonModel:WellCore.base_depth_unit.unitType" 'depth measure'),
    primary_core_form           VARCHAR(40),
    analysis_report             VARCHAR(12),
    sidewall_ind                VARCHAR(1),
    core_diam                   FLOAT           OPTIONS("OpenWorksCommonModel:WellCore.core_diam.unitField" 'core_diam_unit'),
    core_diam_unit              VARCHAR(64)     OPTIONS("OpenWorksCommonModel:WellCore.core_diam_unit.unitType" 'length equipment short'),
    core_barrel_size            FLOAT           OPTIONS("OpenWorksCommonModel:WellCore.core_barrel_size.unitField" 'core_barrel_size_unit'),
    core_barrel_size_unit       VARCHAR(64)     OPTIONS("OpenWorksCommonModel:WellCore.core_barrel_size_unit.unitType" 'length equipment short'),
    gamma_correlation_ind       VARCHAR(1),
    reported_core_number        VARCHAR(12),
    core_handling_type          VARCHAR(12),
    shot_recovered_count        INTEGER,
    total_shot_count            INTEGER,
    total_planned               INTEGER,
    number_misfires             INTEGER,
    number_lost                 INTEGER,
    number_empty                INTEGER,
    recovered_amt               FLOAT,
    recovered_amt_unit          VARCHAR(64),
    operation_sequence_number   VARCHAR(3),
    digital_availability_ind    VARCHAR(1),
    coring_fluid                VARCHAR(12),
    core_oriented_ind           VARCHAR(1),
    core_show_type              VARCHAR(12),
    well_status_name            VARCHAR(40),
    well_symbol                 INTEGER,
    downtime                    FLOAT           OPTIONS("OpenWorksCommonModel:WellCore.downtime.unitField" 'downtime_unit'),
    downtime_unit               VARCHAR(64)     OPTIONS("OpenWorksCommonModel:WellCore.downtime_unit.unitType" 'time'),
    reason_down                 VARCHAR(40),
    hours_coring                FLOAT           OPTIONS("OpenWorksCommonModel:WellCore.hours_coring.unitField" 'hours_coring_unit'),
    hours_coring_unit           VARCHAR(64)     OPTIONS("OpenWorksCommonModel:WellCore.hours_coring_unit.unitType" 'time hour'),
    total_hours                 FLOAT           OPTIONS("OpenWorksCommonModel:WellCore.total_hours.unitField" 'total_hours_unit'),
    total_hours_unit            VARCHAR(64)     OPTIONS("OpenWorksCommonModel:WellCore.total_hours_unit.unitType" 'time hour'),
    coring_cost                 FLOAT,
    original_data_source        VARCHAR(5),
    remark                      VARCHAR(200),
    currency                    VARCHAR(24),
    user_def_1                  VARCHAR(20),
    create_date                         TIMESTAMP      OPTIONS ("OpenWorksCommonModel:WellCore.create_date.isUpdatable" false,
                                                                "OpenWorksCommonModel:WellCore.create_date.isCreatable" false,
                                                                UPDATABLE 'FALSE'),
    create_user_id                      VARCHAR(32)    OPTIONS ("OpenWorksCommonModel:WellCore.create_user_id.isUpdatable" false,
                                                                "OpenWorksCommonModel:WellCore.create_user_id.isCreatable" false,
                                                                UPDATABLE 'FALSE'),
    update_user_id                      VARCHAR(32)    OPTIONS ("OpenWorksCommonModel:WellCore.update_user_id.isUpdatable" false,
                                                                "OpenWorksCommonModel:WellCore.update_user_id.isCreatable" false,
                                                                UPDATABLE 'FALSE'),
    update_date                         TIMESTAMP      OPTIONS ("OpenWorksCommonModel:WellCore.update_date.isUpdatable" false,
                                                                "OpenWorksCommonModel:WellCore.update_date.isCreatable" false,
                                                                UPDATABLE 'FALSE'),
    alternate_uid    		            VARCHAR(4000)   OPTIONS ("OpenWorksCommonModel:WellCore.alternate_uid.isCreatable"  false,
                                                         "OpenWorksCommonModel:WellCore.alternate_uid.isUpdatable" false,
                                                          UPDATABLE 'FALSE'),

    CONSTRAINT WellCore_PK PRIMARY KEY (native_uid),

    CONSTRAINT WellCore_UK1 UNIQUE (wellbore_native_uid, core_id, data_source),

    CONSTRAINT FK_WellCore_wellbore_native_uid
         FOREIGN KEY       (wellbore_native_uid)
         REFERENCES Wellbore (native_uid),

    CONSTRAINT FK_WellCore_data_source
         FOREIGN KEY       (data_source)
         REFERENCES DataSource(name),

    CONSTRAINT FK_WellCore_contractor
         FOREIGN KEY       (contractor)
         REFERENCES Company(company_name),

    CONSTRAINT FK_WellCore_primary_core_form
         FOREIGN KEY       (primary_core_form)
         REFERENCES RefStratigraphicUnitName(strat_unit_name),

    CONSTRAINT FK_WellCore_well_status_name
         FOREIGN KEY       (well_status_name)
         REFERENCES RefWellboreStatus(wellbore_status_name)

)
    OPTIONS (UPDATABLE 'TRUE', WellCore.IMPLEMENTED 'TRUE')
    AS
    SELECT
        Openworks_SM.WellCore.native_uid AS native_uid,
        Openworks_SM.WellEntire.wellid AS wellbore_native_uid,
        Openworks_SM.WellEntire.uwi AS wellbore_uwi,
        Openworks_SM.WellCore.core_id AS core_id,
        Openworks_SM.WellCore.data_source AS data_source,
        contractor AS contractor,
    convert(recovery_date, date) AS recovery_date,
    core_type AS core_type,
    run_number AS run_number,
    job_number AS job_number,
    top_depth AS top_depth,
    top_depth_dsdsunit AS top_depth_unit,
    base_depth AS base_depth,
    base_depth_dsdsunit AS base_depth_unit,
    primary_core_form AS primary_core_form,
    analysis_report AS analysis_report,
    sidewall_ind AS sidewall_ind,
    core_diam AS core_diam,
    core_diam_dsdsunit AS core_diam_unit,
    core_barrel_size AS core_barrel_size,
    core_barrel_size_dsdsunit AS core_barrel_size_unit,
    gamma_correlation_ind AS gamma_correlation_ind,
    reported_core_number AS reported_core_number,
    core_handling_type AS core_handling_type,
    shot_recovered_count AS shot_recovered_count,
    total_shot_count AS total_shot_count,
    total_planned AS total_planned,
    no_misfires AS number_misfires,
    no_lost AS number_lost,
    no_empty AS number_empty,
    recovered_amt AS recovered_amt,
    recovered_amt_dsdsunit AS recovered_amt_unit,
    operation_sequence_number AS operation_sequence_number,
    digit_avail_ind AS digital_availability_ind,
    coring_fluid AS coring_fluid,
    core_oriented_ind AS core_oriented_ind,
    core_show_type AS core_show_type,
    well_status AS well_status_name,
    well_symbol AS well_symbol,
    downtime AS downtime,
    downtime_dsdsunit AS downtime_unit,
    reason_down AS reason_down,
    hours_coring AS hours_coring,
    hours_coring_dsdsunit AS hours_coring_unit,
    total_hours AS total_hours,
    total_hours_dsdsunit AS total_hours_unit,
    coring_cost AS coring_cost,
    original_data_source AS original_data_source,
    Openworks_SM.WellCore.remark AS remark,
    Openworks_SM.WellCore.currency AS currency,
    user_def_1 AS user_def_1,
        Openworks_SM.WellCore.create_date              AS create_date,
        Openworks_SM.WellCore.create_user_id           AS create_user_id,
        Openworks_SM.WellCore.update_user_id           AS update_user_id,
        Openworks_SM.WellCore.update_date              AS update_date,
		Openworks_SM.WellCore.native_uid AS alternate_uid

    FROM Openworks_SM.WellCore, Openworks_SM.WellEntire
    where Openworks_SM.WellCore.wellid = Openworks_SM.WellEntire.wellid;

CREATE TRIGGER ON WellCore INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC

   DECLARE string VARIABLES.wellbore_uwi_errorMsg='ERROR: The given wellbore_native_uid "' ||"NEW".wellbore_native_uid || '" does not exist in OpenWorks';
   DECLARE string VARIABLES.wellid = (SELECT wellid FROM OpenWorks_SM.WellEntire WHERE wellid = "NEW".wellbore_native_uid);
   DECLARE string VARIABLES.sidewall_ind ="NEW".sidewall_ind;

  IF(VARIABLES.wellid IS NULL)
  BEGIN
    ERROR VARIABLES.wellbore_uwi_errorMsg;
  END

    IF(VARIABLES.sidewall_ind IS NOT NULL)
    BEGIN
      VARIABLES.sidewall_ind =  UPPER(VARIABLES.sidewall_ind);
    END

Insert into Openworks_SM.WellCore(wellid,           core_id,       data_source,                        contractor, recovery_date, core_type, run_number, job_number, top_depth, top_depth_dsdsunit, base_depth, base_depth_dsdsunit, primary_core_form, analysis_report, sidewall_ind, core_diam, core_diam_dsdsunit, core_barrel_size, core_barrel_size_dsdsunit, gamma_correlation_ind, reported_core_number, core_handling_type, shot_recovered_count, total_shot_count, total_planned, no_misfires, no_lost, no_empty, recovered_amt, recovered_amt_dsdsunit, operation_sequence_number, digit_avail_ind, coring_fluid, core_oriented_ind, core_show_type, well_status, downtime, downtime_dsdsunit, reason_down, hours_coring, hours_coring_dsdsunit, total_hours, total_hours_dsdsunit, coring_cost, original_data_source, remark, currency, user_def_1)
                           VALUES(VARIABLES.wellid ,"NEW".core_id, SUBSTRING("NEW".data_source, 1, 5), "NEW".contractor, convert("NEW".recovery_date, timestamp), "NEW".core_type, "NEW".run_number, "NEW".job_number, "NEW".top_depth, "NEW".top_depth_unit, "NEW".base_depth, "NEW".base_depth_unit, "NEW".primary_core_form, "NEW".analysis_report, VARIABLES.sidewall_ind, "NEW".core_diam, "NEW".core_diam_unit, "NEW".core_barrel_size, "NEW".core_barrel_size_unit, "NEW".gamma_correlation_ind, "NEW".reported_core_number, "NEW".core_handling_type, "NEW".shot_recovered_count, "NEW".total_shot_count, "NEW".total_planned, "NEW".number_misfires, "NEW".number_lost, "NEW".number_empty, "NEW".recovered_amt, "NEW".recovered_amt_unit, "NEW".operation_sequence_number, "NEW".digital_availability_ind, "NEW".coring_fluid, "NEW".core_oriented_ind, "NEW".core_show_type, "NEW".well_status_name, "NEW".downtime, "NEW".downtime_unit, "NEW".reason_down, "NEW".hours_coring, "NEW".hours_coring_unit, "NEW".total_hours, "NEW".total_hours_unit, "NEW".coring_cost, "NEW".original_data_source, "NEW".remark, "NEW".currency, "NEW".user_def_1);
END;


CREATE TRIGGER ON WellCore INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC

   DECLARE string VARIABLES.sidewall_ind ="NEW".sidewall_ind;

    IF(VARIABLES.sidewall_ind IS NOT NULL)
      BEGIN
        VARIABLES.sidewall_ind =  UPPER(VARIABLES.sidewall_ind);
      END

Update Openworks_SM.WellCore Set    contractor="NEW".contractor, recovery_date=convert("NEW".recovery_date, timestamp), core_type="NEW".core_type, run_number="NEW".run_number, job_number="NEW".job_number, top_depth="NEW".top_depth, top_depth_dsdsunit="NEW".top_depth_unit, base_depth="NEW".base_depth, base_depth_dsdsunit="NEW".base_depth_unit, primary_core_form="NEW".primary_core_form, analysis_report="NEW".analysis_report, sidewall_ind=VARIABLES.sidewall_ind, core_diam="NEW".core_diam, core_diam_dsdsunit="NEW".core_diam_unit, core_barrel_size="NEW".core_barrel_size, core_barrel_size_dsdsunit="NEW".core_barrel_size_unit, gamma_correlation_ind="NEW".gamma_correlation_ind, reported_core_number="NEW".reported_core_number, core_handling_type="NEW".core_handling_type, shot_recovered_count="NEW".shot_recovered_count, total_shot_count="NEW".total_shot_count, total_planned="NEW".total_planned, no_misfires="NEW".number_misfires, no_lost="NEW".number_lost, no_empty="NEW".number_empty, recovered_amt="NEW".recovered_amt, recovered_amt_dsdsunit="NEW".recovered_amt_unit, operation_sequence_number="NEW".operation_sequence_number, digit_avail_ind="NEW".digital_availability_ind, coring_fluid="NEW".coring_fluid, core_oriented_ind="NEW".core_oriented_ind, core_show_type="NEW".core_show_type, well_status="NEW".well_status_name, downtime="NEW".downtime, downtime_dsdsunit="NEW".downtime_unit, reason_down="NEW".reason_down, hours_coring="NEW".hours_coring, hours_coring_dsdsunit="NEW".hours_coring_unit, total_hours="NEW".total_hours, total_hours_dsdsunit="NEW".total_hours_unit, coring_cost="NEW".coring_cost, original_data_source="NEW".original_data_source, remark="NEW".remark, currency="NEW".currency, user_def_1="NEW".user_def_1
Where   native_uid = "OLD".native_uid;

END;

CREATE TRIGGER ON WellCore INSTEAD OF Delete AS
FOR EACH ROW
BEGIN ATOMIC
Delete from Openworks_SM.WellCore    Where native_uid="OLD".native_uid ;
END;


/*
**********************************
* ENTITY: WellCoreDescription
**********************************
*/

CREATE VIEW WellCoreDescription
(
	native_uid                          VARCHAR(1024)   OPTIONS("OpenWorksCommonModel:WellCoreDescription.native_uid.isUpdatable" false,
                                                                "OpenWorksCommonModel:WellCoreDescription.native_uid.isCreatable" false,
                                                                UPDATABLE 'FALSE'),
    wellbore_native_uid                 VARCHAR(1024)   NOT NULL,
    wellcore_native_uid                 VARCHAR(1024)   NOT NULL,
    core_id                             VARCHAR(20)     NOT NULL,
    data_source                         VARCHAR(6)      NOT NULL,


     data                          		BLOB 			NOT NULL OPTIONS ("OpenWorksCommonModel:WellCoreDescription.data.isComplexType"      true,
        														 "OpenWorksCommonModel:WellCoreDescription.data.isComplexTypeArray" true,
        														 "OpenWorksCommonModel:WellCoreDescription.data.elementType"        'WellCoreDescription',
        														 "OpenWorksCommonModel:WellCoreDescription.data.elementStruct"
        															 '[{"name":"description_obs_no", "type":"integer[]"},
        															 {"name":"well_status", "type":"string[]"},
        															 {"name":"well_symbol", "type":"int[]"},
        															 {"name":"litho_class", "type":"string[]"},
        															 {"name":"top_depth", "type":"float[]"},
        															 {"name":"base_depth", "type":"float[]"},
        															 {"name":"interval_thickness", "type":"float[]"},
        															 {"name":"porosity_type", "type":"string[]"},
        															 {"name":"show_length", "type":"float[]"},
        															 {"name":"show_type", "type":"string[]"},
        															 {"name":"core_description_company", "type":"string[]"},
        															 {"name":"porosity_length", "type":"float[]"},
        															 {"name":"porosity_quality", "type":"string[]"},
        															 {"name":"dip_angle", "type":"float[]"},
        															 {"name":"lithology_description", "type":"string[]"},
        															 {"name":"description_date", "type":"string[]"},
        															 {"name":"original_data_source", "type":"string[]"},
        															 {"name":"remark", "type":"string[]"}]',
        														 "OpenWorksCommonModel:WellCoreDescription.data.elementMetadata"
        															 '[{"name":"top_depth", "unitField":"top_depth_unit"},
        															 {"name":"base_depth", "unitField":"base_depth_unit"},
        															 {"name":"interval_thickness", "unitField":"interval_thickness_unit"},
        															 {"name":"show_length", "unitField":"show_length_unit"},
        															 {"name":"porosity_length", "unitField":"porosity_length_unit"},
        															 {"name":"dip_angle", "unitField":"dip_angle_unit"}]'),

    create_date                         TIMESTAMP      OPTIONS ("OpenWorksCommonModel:WellCoreDescription.create_date.isUpdatable" false,
                                                                "OpenWorksCommonModel:WellCoreDescription.create_date.isCreatable" false,
                                                                UPDATABLE 'FALSE'),
    create_user_id                      VARCHAR(32)    OPTIONS ("OpenWorksCommonModel:WellCoreDescription.create_user_id.isUpdatable" false,
                                                                "OpenWorksCommonModel:WellCoreDescription.create_user_id.isCreatable" false,
                                                                UPDATABLE 'FALSE'),
    update_user_id                      VARCHAR(32)    OPTIONS ("OpenWorksCommonModel:WellCoreDescription.update_user_id.isUpdatable" false,
                                                                "OpenWorksCommonModel:WellCoreDescription.update_user_id.isCreatable" false,
                                                                UPDATABLE 'FALSE'),
    update_date                         TIMESTAMP      OPTIONS ("OpenWorksCommonModel:WellCoreDescription.update_date.isUpdatable" false,
                                                                "OpenWorksCommonModel:WellCoreDescription.update_date.isCreatable" false,
                                                                UPDATABLE 'FALSE'),
    alternate_uid    		                    VARCHAR(4000)   OPTIONS("OpenWorksCommonModel:WellCoreDescription.alternate_uid.isCreatable" false,
                                                                "OpenWorksCommonModel:WellCoreDescription.alternate_uid.isUpdatable" false,
                                                                UPDATABLE 'FALSE'),
    CONSTRAINT WellCoreDescription_PK PRIMARY KEY (native_uid),

    CONSTRAINT WellCoreDescription_UK1 UNIQUE (wellbore_native_uid, core_id, data_source),

    CONSTRAINT FK_WellCoreDescription_wellbore_native_uid
         FOREIGN KEY       (wellbore_native_uid)
         REFERENCES    Wellbore(native_uid),

    CONSTRAINT FK_WellCoreDescription_wellcore_native_uid
         FOREIGN KEY        (wellcore_native_uid)
         REFERENCES WellCore(native_uid),

    CONSTRAINT FK_WellCoreDescription_data_source
         FOREIGN KEY          (data_source)
         REFERENCES DataSource(name)
)
    OPTIONS (UPDATABLE 'TRUE', WellCoreDescription.IMPLEMENTED 'TRUE')
    AS

SELECT
    Openworks_SM.WellCore.native_uid AS native_uid,
    distsampDesc.wellid AS wellbore_native_uid,
    Openworks_SM.WellCore.native_uid AS wellcore_native_uid,
    distsampDesc.core_id AS core_id,
    distsampDesc.data_source AS data_source,
     (SELECT t.data
         FROM TABLE(EXEC Openworks_SM.CoreDescriptionRead(distsampDesc.wellid,distsampDesc.core_id, distsampDesc.data_source)) AS t) AS data,
     Openworks_SM.WellCore.create_date              AS create_date,
     Openworks_SM.WellCore.create_user_id           AS create_user_id,
     Openworks_SM.WellCore.update_user_id           AS update_user_id,
     Openworks_SM.WellCore.update_date              AS update_date,

     distsampDesc.native_uid AS alternate_uid
    FROM
    (select distinct native_uid, wellid,core_id,data_source from openworks_SM.WellCoreDescription) distsampDesc,
    Openworks_SM.WellCore
    where Openworks_SM.WellCore.wellid = distsampDesc.wellid
    and   Openworks_SM.WellCore.core_id = distsampDesc.core_id
    and   Openworks_SM.WellCore.data_source = distsampDesc.data_source;

CREATE TRIGGER ON WellCoreDescription INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC

   DECLARE string VARIABLES.wellid = getJSONElementValue("NEW".wellcore_native_uid,'wellid');
   DECLARE string VARIABLES.core_id = getJSONElementValue("NEW".wellcore_native_uid,'core_id');
   DECLARE string VARIABLES.data_source = getJSONElementValue("NEW".wellcore_native_uid,'data_source');

   DECLARE string VARIABLES.wellcore_errorMsg='ERROR: The given wellcore_native_uid "' ||"NEW".wellcore_native_uid || '" does not exist in OpenWorks';
   DECLARE string VARIABLES.coreid = (SELECT core_id FROM OpenWorks_SM.WellCore WHERE wellid = VARIABLES.wellid AND core_id=VARIABLES.core_id AND data_source=VARIABLES.data_source);


  IF(VARIABLES.coreid IS NULL)
  BEGIN
    -- ERROR VARIABLES.wellcore_errorMsg;
  END

     EXEC Openworks_SM.CoreDescriptionWrite(VARIABLES.wellid, VARIABLES.core_id,
		VARIABLES.data_source, "NEW".data);

END;


CREATE TRIGGER ON WellCoreDescription INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC

   DECLARE string VARIABLES.wellid = getJSONElementValue("NEW".wellcore_native_uid,'wellid');
   DECLARE string VARIABLES.core_id = getJSONElementValue("NEW".wellcore_native_uid,'core_id');
   DECLARE string VARIABLES.data_source = getJSONElementValue("NEW".wellcore_native_uid,'data_source');

     EXEC Openworks_SM.CoreDescriptionWrite(VARIABLES.wellid, VARIABLES.core_id,
		VARIABLES.data_source, "NEW".data);

END;

CREATE TRIGGER ON WellCoreDescription INSTEAD OF Delete AS
FOR EACH ROW
BEGIN ATOMIC
Delete from Openworks_SM.WellCoreDescription    Where native_uid="OLD".native_uid ;
END;


/*
**********************************
*    "WellList"
**********************************
*/
CREATE VIEW WellList
(
  native_uid             VARCHAR(128)  AUTO_INCREMENT OPTIONS ("OpenWorksCommonModel:WellList.native_uid.isCreatable" false,
                                               "OpenWorksCommonModel:WellList.native_uid.isUpdatable" false,UPDATABLE 'FALSE'),
  name                   VARCHAR(80)  NOT NULL,
  type                   VARCHAR(15)  NOT NULL DEFAULT 'WELL_LIST',
  data_source            VARCHAR(5)   NOT NULL,
  original_data_source   VARCHAR(5),
 create_date             TIMESTAMP    OPTIONS("OpenWorksCommonModel:WellList.create_date.isUpdatable" false,
                                              "OpenWorksCommonModel:WellList.create_date.isCreatable" false,UPDATABLE 'FALSE'),
  create_user_id         VARCHAR(32)  OPTIONS("OpenWorksCommonModel:WellList.create_user_id.isUpdatable" false,
                                              "OpenWorksCommonModel:WellList.create_user_id.isCreatable" false,UPDATABLE 'FALSE'),
  update_date            TIMESTAMP    OPTIONS("OpenWorksCommonModel:WellList.update_date.isUpdatable" false,
                                              "OpenWorksCommonModel:WellList.update_date.isCreatable" false,UPDATABLE 'FALSE'),
  update_user_id         VARCHAR(32)  OPTIONS("OpenWorksCommonModel:WellList.update_user_id.isUpdatable" false,
                                              "OpenWorksCommonModel:WellList.update_user_id.isCreatable" false,UPDATABLE 'FALSE'),
  alternate_uid    		    VARCHAR(4000)  OPTIONS ("OpenWorksCommonModel:WellList.alternate_uid.isCreatable" false,
                                                "OpenWorksCommonModel:WellList.alternate_uid.isUpdatable" false,
                                                 UPDATABLE 'FALSE'),


   CONSTRAINT WellList_PK PRIMARY KEY (native_uid),

    CONSTRAINT WellList_UK1 UNIQUE (name,type, data_source),

    CONSTRAINT FK_WellList_data_source
        FOREIGN KEY (data_source)
        REFERENCES DataSource(name),

    CONSTRAINT FK_WellList_original_data_source
        FOREIGN KEY (original_data_source)
        REFERENCES DataSource(name)

)
OPTIONS (UPDATABLE 'TRUE',WellList.IMPLEMENTED 'TRUE')
AS
SELECT
 id,
 name,
 type,
 data_source,
 original_data_source,
 create_date,
 create_user_id,
 update_date,
 update_user_id,
 native_uid
    FROM
        OpenWorks_SM.WellList;



CREATE TRIGGER ON WellList INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC
    DECLARE integer VARIABLES.welllist_id = (SELECT * FROM (EXEC OpenWorks_SM.nextval('WellList')) AS SysGenID);
    INSERT INTO OpenWorks_SM.WellList (id, name, type, data_source, original_data_source) VALUES (welllist_id, SUBSTRING("NEW".name, 1, 80), 'WELL_LIST', SUBSTRING("NEW".data_source, 1, 5), SUBSTRING("NEW".original_data_source, 1, 5));
END;



/*
**********************************
*    "WellListMember"
**********************************
*/

CREATE VIEW WellListMember
(
  native_uid          VARCHAR(1024)       OPTIONS("OpenWorksCommonModel:WellListMember.native_uid.isUpdatable" false,
                                                    "OpenWorksCommonModel:WellListMember.native_uid.isCreatable" false,
                                                    UPDATABLE 'FALSE'),

  welllist_native_uid VARCHAR(1024),
  wellbore_native_uid VARCHAR(1024),
  wellbore_uwi        VARCHAR(4000)       OPTIONS("OpenWorksCommonModel:WellListMember.wellbore_uwi.isUpdatable" false,
                                                    "OpenWorksCommonModel:WellListMember.wellbore_uwi.isCreatable" false,
                                                    UPDATABLE 'FALSE'),
  "order"          INTEGER,
  create_date      TIMESTAMP   OPTIONS("OpenWorksCommonModel:WellListMember.create_date.isUpdatable" false,
                                       "OpenWorksCommonModel:WellListMember.create_date.isCreatable" false,UPDATABLE 'FALSE'),
  create_user_id   VARCHAR(32) OPTIONS("OpenWorksCommonModel:WellListMember.create_user_id.isUpdatable" false,
                                       "OpenWorksCommonModel:WellListMember.create_user_id.isCreatable" false,UPDATABLE 'FALSE'),
  update_date      TIMESTAMP   OPTIONS("OpenWorksCommonModel:WellListMember.update_date.isUpdatable" false,
                                       "OpenWorksCommonModel:WellListMember.update_date.isCreatable" false,UPDATABLE 'FALSE'),
  update_user_id   VARCHAR(32) OPTIONS("OpenWorksCommonModel:WellListMember.update_user_id.isUpdatable" false,
                                       "OpenWorksCommonModel:WellListMember.update_user_id.isCreatable" false,UPDATABLE 'FALSE'),

  name             VARCHAR(80)  OPTIONS("OpenWorksCommonModel:WellListMember.name.isUpdatable" false,
                                                    "OpenWorksCommonModel:WellListMember.name.isCreatable" false,
                                                    UPDATABLE 'FALSE'),
  type             VARCHAR(15) OPTIONS("OpenWorksCommonModel:WellListMember.type.isUpdatable" false,
                                                    "OpenWorksCommonModel:WellListMember.type.isCreatable" false,
                                                    UPDATABLE 'FALSE'),
  data_source      VARCHAR(5)  OPTIONS("OpenWorksCommonModel:WellListMember.data_source.isUpdatable" false,
                                                    "OpenWorksCommonModel:WellListMember.data_source.isCreatable" false,
                                                    UPDATABLE 'FALSE'),
  alternate_uid    		  VARCHAR(4000)       OPTIONS ("OpenWorksCommonModel:WellListMember.alternate_uid.isCreatable" false,
                                                   "OpenWorksCommonModel:WellListMember.alternate_uid.isUpdatable" false,
                                                    UPDATABLE 'FALSE'),

  CONSTRAINT WellListMember_PK PRIMARY KEY (native_uid),

    CONSTRAINT WellListMember_UK1 UNIQUE (welllist_native_uid, wellbore_native_uid),

    CONSTRAINT FK_WellListMember_welllist_native_uid
        FOREIGN KEY        (welllist_native_uid)
        REFERENCES WellList(native_uid),

    CONSTRAINT FK_WellListMember_wellbore_native_uid
        FOREIGN KEY        (wellbore_native_uid)
        REFERENCES Wellbore(native_uid),

    CONSTRAINT FK_WellListMember_data_source
        FOREIGN KEY (data_source)
        REFERENCES DataSource(name)

)
OPTIONS (UPDATABLE 'TRUE', WellListMember.IMPLEMENTED 'TRUE')
AS
    SELECT
 OpenWorks_SM.WellListMember.native_uid AS native_uid,
 OpenWorks_SM.WellList.id AS welllist_native_uid,
 OpenWorks_SM.WellEntire.wellid AS wellbore_native_uid,
 uwi,
 "order",
 OpenWorks_SM.WellListMember.create_date,
 OpenWorks_SM.WellListMember.create_user_id,
 OpenWorks_SM.WellListMember.update_date,
 OpenWorks_SM.WellListMember.update_user_id,
 name,
 type,
 OpenWorks_SM.WellList.data_source,
 OpenWorks_SM.WellListMember.native_uid AS alternate_uid
    FROM
    OpenWorks_SM.WellListMember LEFT OUTER JOIN /*+ optional */ OpenWorks_SM.WellList ON OpenWorks_SM.WellListMember.id = Openworks_SM.WellList.id, /*+ optional */ OpenWorks_SM.WellEntire
    WHERE
        (Openworks_SM.WellEntire.wellid = Openworks_SM.WellListMember.wellid);



CREATE TRIGGER ON WellListMember INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC

    DECLARE string VARIABLES.welllist_id_errorMsg='ERROR: WellList_native_uid ' || "NEW".welllist_native_uid || 'does not exist';
    DECLARE string VARIABLES.welllist_id = (SELECT id from OpenWorks_SM.WellList where id = "NEW".welllist_native_uid);
    IF(VARIABLES.welllist_id is NULL)
       ERROR VARIABLES.welllist_id_errorMsg;

    DECLARE string VARIABLES.wellbore_id_errorMsg='ERROR: Wellbore_native_uid ' || "NEW".Wellbore_native_uid || 'does not exist';
    DECLARE string VARIABLES.wellbore_id = (SELECT wellid FROM Openworks_SM.WellEntire WHERE wellid ="NEW".Wellbore_native_uid);
    IF(VARIABLES.wellbore_id is NULL)
       ERROR VARIABLES.wellbore_id_errorMsg;

    INSERT INTO Openworks_SM.WellListMember (id, wellid, "order") VALUES (VARIABLES.welllist_id , VARIABLES.wellbore_id, "NEW"."order");
END;


CREATE TRIGGER ON WellListMember INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC
    UPDATE OpenWorks_SM.WellListMember SET "order" = "NEW"."order" WHERE native_uid = "OLD".native_uid;
END;

CREATE TRIGGER ON WellListMember INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC
    DELETE FROM OpenWorks_SM.WellListMember WHERE native_uid = "OLD".native_uid;
END;


/*
**********************************
*     "Seismic3DSurvey"
**********************************
*/
CREATE VIEW Seismic3DSurvey
(
  native_uid                          VARCHAR(1024) OPTIONS("OpenWorksCommonModel:Seismic3DSurvey.native_uid.isUpdatable" false,
                                                              "OpenWorksCommonModel:Seismic3DSurvey.native_uid.isCreatable" false,
                                                              UPDATABLE 'FALSE'),
  seismic_survey_name                 VARCHAR(40) NOT NULL,
  seismic_geometry_kind               VARCHAR(40) OPTIONS("OpenWorksCommonModel:Seismic3DSurvey.seismic_geometry_kind.isUpdatable" false,
                                                            "OpenWorksCommonModel:Seismic3DSurvey.seismic_geometry_kind.isCreatable" false,
                                                             UPDATABLE 'FALSE'),
  data_source                         VARCHAR(5),
  acquired_by                         VARCHAR(40) DEFAULT 'UNKNOWN',
  acquired_for                        VARCHAR(40) DEFAULT 'UNKNOWN',
  acquisition_start_date              TIMESTAMP,
  acquisition_end_date                TIMESTAMP,
  acquisition_cost                    FLOAT,
  currency                            VARCHAR(24) DEFAULT 'UNKNOWN',
  survey_environment_kind             VARCHAR(40) DEFAULT 'UNKNOWN',
  acquisition_area_name               VARCHAR(4000) DEFAULT 'UNKNOWN',
  county_name                         VARCHAR(25) DEFAULT 'UNKNOWN',
  state_name                          VARCHAR(20) DEFAULT 'UNKNOWN',
  country_name                        VARCHAR(25) DEFAULT 'UNKNOWN',
  source_total                        INTEGER,
  min_channel                         INTEGER,
  max_channel                         INTEGER,
  channel_incr                        INTEGER,
  acquisition_crew                    VARCHAR(80),
  acquisition_survey                  VARCHAR(40) DEFAULT 'UNKNOWN',
  vertical_misclosure_factor          FLOAT            OPTIONS ("OpenWorksCommonModel:Seismic3DSurvey.vertical_misclosure_factor.unitField" 'vertical_misclosure_factor_unit'),
  vertical_misclosure_factor_unit     VARCHAR(64)      OPTIONS ("OpenWorksCommonModel:Seismic3DSurvey.vertical_misclosure_factor_unit.unitType" 'factor'),
  horizontal_misclosure_factor        FLOAT            OPTIONS ("OpenWorksCommonModel:Seismic3DSurvey.horizontal_misclosure_factor.unitField" 'horizontal_misclosure_factor_unit'),
  horizontal_misclosure_factor_unit   VARCHAR(64)      OPTIONS ("OpenWorksCommonModel:Seismic3DSurvey.horizontal_misclosure_factor_unit.unitType" 'factor'),
  azimuth_misclosure_factor           FLOAT            OPTIONS ("OpenWorksCommonModel:Seismic3DSurvey.azimuth_misclosure_factor.unitField" 'azimuth_misclosure_factor_unit'),
  azimuth_misclosure_factor_unit      VARCHAR(64)      OPTIONS ("OpenWorksCommonModel:Seismic3DSurvey.azimuth_misclosure_factor_unit.unitType" 'factor'),
  min_source_index                    INTEGER,
  max_source_index                    INTEGER,
  source_index_incr                   INTEGER,
  source_index_total                  INTEGER,
  azm_surfloc                         FLOAT,
  min_surfloc_x                       DOUBLE,
  min_surfloc_y                       DOUBLE,
  min_surfloc_index                   INTEGER,
  max_surfloc_index                   INTEGER,
  surfloc_index_incr                  INTEGER,
  surfloc_total                       INTEGER,
  z_datum                             FLOAT        OPTIONS ("OpenWorksCommonModel:Seismic3DSurvey.z_datum.unitField" 'z_datum_unit'),
  z_datum_unit                        VARCHAR(64)  OPTIONS ("OpenWorksCommonModel:Seismic3DSurvey.z_datum_unit.unitType" 'elevation'),
  restricted_data_ind                 VARCHAR(1)  DEFAULT 'N',
  remark                              VARCHAR(200),
 create_date                          TIMESTAMP   OPTIONS("OpenWorksCommonModel:Seismic3DSurvey.create_date.isUpdatable" false,
                                                          "OpenWorksCommonModel:Seismic3DSurvey.create_date.isCreatable" false,
                                                           UPDATABLE 'FALSE'),
  create_user_id                      VARCHAR(32) OPTIONS("OpenWorksCommonModel:Seismic3DSurvey.create_user_id.isUpdatable" false,
                                                          "OpenWorksCommonModel:Seismic3DSurvey.create_user_id.isCreatable" false,
                                                           UPDATABLE 'FALSE'),
  update_date                         TIMESTAMP   OPTIONS("OpenWorksCommonModel:Seismic3DSurvey.update_date.isUpdatable" false,
                                                          "OpenWorksCommonModel:Seismic3DSurvey.update_date.isCreatable" false,
                                                           UPDATABLE 'FALSE'),
  update_user_id                VARCHAR(32)       OPTIONS("OpenWorksCommonModel:Seismic3DSurvey.update_user_id.isUpdatable" false,
                                                          "OpenWorksCommonModel:Seismic3DSurvey.update_user_id.isCreatable" false,
                                                           UPDATABLE 'FALSE'),
  alternate_uid    		                  VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:Seismic3DSurvey.alternate_uid.isCreatable" false,
                                                             "OpenWorksCommonModel:Seismic3DSurvey.alternate_uid.isUpdatable" false,
                                                              UPDATABLE 'FALSE'),


 CONSTRAINT Seismic3DSurvey_PK PRIMARY KEY (native_uid),

    CONSTRAINT Seismic3DSurvey_UK1 UNIQUE (seismic_survey_name),

    CONSTRAINT FK_Seismic3DSurvey_data_source
        FOREIGN KEY (data_source)
        REFERENCES DataSource(name),

    CONSTRAINT FK_Seismic3DSurvey_acquired_by
        FOREIGN KEY (acquired_by)
        REFERENCES Company(company_name),

    CONSTRAINT FK_Seismic3DSurvey_acquired_for
        FOREIGN KEY (acquired_for)
        REFERENCES Company(company_name),

    CONSTRAINT FK_Seismic3DSurvey_acquisition_survey
        FOREIGN KEY (acquisition_survey)
        REFERENCES Company(company_name)

)
OPTIONS (UPDATABLE 'TRUE', Seismic3DSurvey.IMPLEMENTED 'TRUE')
AS
SELECT
 OpenWorks_SM.SeisGeomSet3DSurvey.seis_geom_set_id AS native_uid,
 OpenWorks_SM.SeisGeomSet3DSurvey.seis_geom_set_nm AS seismic_survey_name,
 OpenWorks_SM.SeisGeomSet3DSurvey.r_seismic_geom_kd,
 OpenWorks_SM.SeisGeomSet3DSurvey.data_source,
 OpenWorks_SM.SeisGeomSet3DSurvey.acquired_by,
 OpenWorks_SM.SeisGeomSet3DSurvey.acquired_for,
 OpenWorks_SM.SeisGeomSet3DSurvey.acq_start_date,
 OpenWorks_SM.SeisGeomSet3DSurvey.acq_end_date,
 OpenWorks_SM.SeisGeomSet3DSurvey.acq_cost,
 OpenWorks_SM.SeisGeomSet3DSurvey.currency,
 OpenWorks_SM.SeisGeomSet3DSurvey.r_survey_envr_kd,
 OpenWorks_SM.SeisGeomSet3DSurvey.geop_acq_area_nm,
 OpenWorks_SM.SeisGeomSet3DSurvey.county_nm,
 OpenWorks_SM.SeisGeomSet3DSurvey.state_nm,
 OpenWorks_SM.SeisGeomSet3DSurvey.country_nm,
 OpenWorks_SM.SeisGeomSet3DSurvey.source_total,
 OpenWorks_SM.SeisGeomSet3DSurvey.min_channel,
 OpenWorks_SM.SeisGeomSet3DSurvey.max_channel,
 OpenWorks_SM.SeisGeomSet3DSurvey.channel_incr,
 OpenWorks_SM.SeisGeomSet3DSurvey.acq_crew,
 OpenWorks_SM.SeisGeomSet3DSurvey.acq_survey,
 OpenWorks_SM.SeisGeomSet3DSurvey.vert_mclos_fact,
 OpenWorks_SM.SeisGeomSet3DSurvey.vert_mclos_fact_dsdsunit,
 OpenWorks_SM.SeisGeomSet3DSurvey.horz_mclos_fact,
 OpenWorks_SM.SeisGeomSet3DSurvey.horz_mclos_fact_dsdsunit ,
 OpenWorks_SM.SeisGeomSet3DSurvey.azm_mclos_fact,
 OpenWorks_SM.SeisGeomSet3DSurvey.azm_mclos_fact_dsdsunit ,
 OpenWorks_SM.SeisGeomSet3DSurvey.min_src_idx,
 OpenWorks_SM.SeisGeomSet3DSurvey.max_src_idx,
 OpenWorks_SM.SeisGeomSet3DSurvey.src_idx_incr,
 OpenWorks_SM.SeisGeomSet3DSurvey.src_idx_total,
 OpenWorks_SM.SeisGeomSet3DSurvey.azm_surfloc,
 OpenWorks_SM.SeisGeomSet3DSurvey.min_surfloc_x,
 OpenWorks_SM.SeisGeomSet3DSurvey.min_surfloc_y,
 OpenWorks_SM.SeisGeomSet3DSurvey.min_surfloc_idx,
 OpenWorks_SM.SeisGeomSet3DSurvey.max_surfloc_idx,
 OpenWorks_SM.SeisGeomSet3DSurvey.surfloc_idx_incr,
 OpenWorks_SM.SeisGeomSet3DSurvey.surfloc_total,
 OpenWorks_SM.SeisGeomSet3DSurvey.z_datum,
 OpenWorks_SM.SeisGeomSet3DSurvey.z_datum_dsdsunit,
 OpenWorks_SM.SeisGeomSet3DSurvey.restricted_data_ind,
 OpenWorks_SM.SeisGeomSet3DSurvey.remark,
 OpenWorks_SM.SeisGeomSet3DSurvey.create_date,
 OpenWorks_SM.SeisGeomSet3DSurvey.create_user_id,
 OpenWorks_SM.SeisGeomSet3DSurvey.update_date,
 OpenWorks_SM.SeisGeomSet3DSurvey.update_user_id,
 OpenWorks_SM.SeisGeomSet3DSurvey.native_uid AS alternate_uid
    FROM

    OpenWorks_SM.SeisGeomSet3DSurvey;



    CREATE TRIGGER ON Seismic3DSurvey INSTEAD OF INSERT AS
    FOR EACH ROW
BEGIN ATOMIC
        INSERT INTO OpenWorks_SM.SeisGeomSet3DSurvey (OpenWorks_SM.SeisGeomSet3DSurvey.seis_geom_set_nm, OpenWorks_SM.SeisGeomSet3DSurvey.data_source, OpenWorks_SM.SeisGeomSet3DSurvey.acquired_by, OpenWorks_SM.SeisGeomSet3DSurvey.acquired_for, OpenWorks_SM.SeisGeomSet3DSurvey.acq_start_date, OpenWorks_SM.SeisGeomSet3DSurvey.acq_end_date, OpenWorks_SM.SeisGeomSet3DSurvey.acq_cost, OpenWorks_SM.SeisGeomSet3DSurvey.currency, OpenWorks_SM.SeisGeomSet3DSurvey.r_survey_envr_kd, OpenWorks_SM.SeisGeomSet3DSurvey.geop_acq_area_nm, OpenWorks_SM.SeisGeomSet3DSurvey.county_nm, OpenWorks_SM.SeisGeomSet3DSurvey.state_nm, OpenWorks_SM.SeisGeomSet3DSurvey.country_nm, OpenWorks_SM.SeisGeomSet3DSurvey.source_total, OpenWorks_SM.SeisGeomSet3DSurvey.min_channel, OpenWorks_SM.SeisGeomSet3DSurvey.max_channel, OpenWorks_SM.SeisGeomSet3DSurvey.channel_incr, OpenWorks_SM.SeisGeomSet3DSurvey.acq_crew, OpenWorks_SM.SeisGeomSet3DSurvey.acq_survey, OpenWorks_SM.SeisGeomSet3DSurvey.vert_mclos_fact, OpenWorks_SM.SeisGeomSet3DSurvey.vert_mclos_fact_dsdsunit, OpenWorks_SM.SeisGeomSet3DSurvey.horz_mclos_fact, OpenWorks_SM.SeisGeomSet3DSurvey.horz_mclos_fact_dsdsunit, OpenWorks_SM.SeisGeomSet3DSurvey.azm_mclos_fact, OpenWorks_SM.SeisGeomSet3DSurvey.azm_mclos_fact_dsdsunit, OpenWorks_SM.SeisGeomSet3DSurvey.min_src_idx, OpenWorks_SM.SeisGeomSet3DSurvey.max_src_idx, OpenWorks_SM.SeisGeomSet3DSurvey.src_idx_incr, OpenWorks_SM.SeisGeomSet3DSurvey.src_idx_total, OpenWorks_SM.SeisGeomSet3DSurvey.azm_surfloc, OpenWorks_SM.SeisGeomSet3DSurvey.min_surfloc_x, OpenWorks_SM.SeisGeomSet3DSurvey.min_surfloc_y, OpenWorks_SM.SeisGeomSet3DSurvey.min_surfloc_idx, OpenWorks_SM.SeisGeomSet3DSurvey.max_surfloc_idx, OpenWorks_SM.SeisGeomSet3DSurvey.surfloc_idx_incr, OpenWorks_SM.SeisGeomSet3DSurvey.surfloc_total, OpenWorks_SM.SeisGeomSet3DSurvey.z_datum, OpenWorks_SM.SeisGeomSet3DSurvey.z_datum_dsdsunit, OpenWorks_SM.SeisGeomSet3DSurvey.restricted_data_ind, OpenWorks_SM.SeisGeomSet3DSurvey.remark) VALUES (SUBSTRING("NEW".seismic_survey_name, 1, 40), SUBSTRING("NEW".data_source, 1, 5), SUBSTRING("NEW".acquired_by, 1, 40), SUBSTRING("NEW".acquired_for, 1, 40), "NEW".acquisition_start_date, "NEW".acquisition_end_date, "NEW".acquisition_cost, SUBSTRING("NEW".currency, 1, 24), SUBSTRING("NEW".survey_environment_kind, 1, 40), SUBSTRING("NEW".acquisition_area_name, 1, 40), SUBSTRING("NEW".county_name, 1, 25), SUBSTRING("NEW".state_name, 1, 20), SUBSTRING("NEW".country_name, 25), "NEW".source_total, "NEW".min_channel, "NEW".max_channel, "NEW".channel_incr, SUBSTRING("NEW".acquisition_crew, 1, 80), SUBSTRING("NEW".acquisition_survey, 1, 40), "NEW".vertical_misclosure_factor, SUBSTRING("NEW".vertical_misclosure_factor_unit, 1, 64), "NEW".horizontal_misclosure_factor, SUBSTRING("NEW".horizontal_misclosure_factor_unit, 1, 64), "NEW".azimuth_misclosure_factor, SUBSTRING("NEW".azimuth_misclosure_factor_unit, 1, 64), "NEW".min_source_index, "NEW".max_source_index, "NEW".source_index_incr, "NEW".source_index_total, "NEW".azm_surfloc, "NEW".min_surfloc_x, "NEW".min_surfloc_y, "NEW".min_surfloc_index, "NEW".max_surfloc_index, "NEW".surfloc_index_incr, "NEW".surfloc_total, "NEW".z_datum, SUBSTRING("NEW".z_datum_unit, 1, 64), SUBSTRING("NEW".restricted_data_ind, 1, 1), SUBSTRING("NEW".remark, 1, 200));
END;


    CREATE TRIGGER ON Seismic3DSurvey INSTEAD OF UPDATE AS
    FOR EACH ROW
BEGIN ATOMIC
    DECLARE string VARIABLES.seis_geom_set_id = (SELECT OpenWorks_SM.SeisGeomSet3DSurvey.seis_geom_set_id FROM OpenWorks_SM.SeisGeomSet3DSurvey WHERE OpenWorks_SM.SeisGeomSet3DSurvey.seis_geom_set_nm = "OLD".seismic_survey_name);
    UPDATE OpenWorks_SM.SeisGeomSet3DSurvey SET data_source = SUBSTRING("NEW".data_source, 1, 5), acquired_by = SUBSTRING("NEW".acquired_by, 1, 40), acquired_for = SUBSTRING("NEW".acquired_for, 1, 40), acq_start_date = "NEW".acquisition_start_date, acq_end_date = "NEW".acquisition_end_date, acq_cost = "NEW".acquisition_cost, currency = SUBSTRING("NEW".currency, 1, 24), r_survey_envr_kd = SUBSTRING("NEW".survey_environment_kind, 1, 40), geop_acq_area_nm = SUBSTRING("NEW".acquisition_area_name, 1, 40), county_nm = SUBSTRING("NEW".county_name, 1, 25), state_nm = SUBSTRING("NEW".state_name, 1, 20), country_nm = SUBSTRING("NEW".country_name,1, 25), source_total = "NEW".source_total, min_channel = "NEW".min_channel, max_channel = "NEW".max_channel, channel_incr = "NEW".channel_incr, acq_crew = SUBSTRING("NEW".acquisition_crew, 1, 80), acq_survey = SUBSTRING("NEW".acquisition_survey, 1, 40), vert_mclos_fact = "NEW".vertical_misclosure_factor, vert_mclos_fact_dsdsunit = SUBSTRING("NEW".vertical_misclosure_factor_unit, 1, 64), horz_mclos_fact = "NEW".horizontal_misclosure_factor, horz_mclos_fact_dsdsunit = SUBSTRING("NEW".horizontal_misclosure_factor_unit, 1, 64), azm_mclos_fact = "NEW".azimuth_misclosure_factor, azm_mclos_fact_dsdsunit = SUBSTRING("NEW".azimuth_misclosure_factor_unit, 1, 64), min_src_idx = "NEW".min_source_index, max_src_idx = "NEW".max_source_index, src_idx_incr = "NEW".source_index_incr, src_idx_total = "NEW".source_index_total, azm_surfloc = "NEW".azm_surfloc, min_surfloc_x = "NEW".min_surfloc_x, min_surfloc_y = "NEW".min_surfloc_y, min_surfloc_idx = "NEW".min_surfloc_index, max_surfloc_idx = "NEW".max_surfloc_index, surfloc_idx_incr = "NEW".surfloc_index_incr, surfloc_total = "NEW".surfloc_total, z_datum = "NEW".z_datum, z_datum_dsdsunit = SUBSTRING("NEW".z_datum_unit, 1, 64), restricted_data_ind = SUBSTRING("NEW".restricted_data_ind, 1, 1), remark = SUBSTRING("NEW".remark, 1, 200) WHERE OpenWorks_SM.SeisGeomSet3DSurvey.seis_geom_set_id = VARIABLES.seis_geom_set_id;

END;

CREATE TRIGGER ON Seismic3DSurvey INSTEAD OF DELETE AS
    FOR EACH ROW
BEGIN ATOMIC
DECLARE string VARIABLES.seis_geom_set_id = (SELECT OpenWorks_SM.SeisGeomSet3DSurvey.seis_geom_set_id FROM OpenWorks_SM.SeisGeomSet3DSurvey WHERE OpenWorks_SM.SeisGeomSet3DSurvey.seis_geom_set_nm = "OLD".seismic_survey_name);
DELETE from OpenWorks_SM.SeisGeomSet3DSurvey WHERE OpenWorks_SM.SeisGeomSet3DSurvey.seis_geom_set_id = VARIABLES.seis_geom_set_id;
END;


/*
**********************************
*     "BinsetGrid3DGrid"
**********************************
*/

CREATE VIEW BinsetGrid3DGrid
(
  native_uid                  VARCHAR(1024) OPTIONS("OpenWorksCommonModel:BinsetGrid3DGrid.native_uid.isUpdatable" false,
                                               "OpenWorksCommonModel:BinsetGrid3DGrid.native_uid.isCreatable" false,UPDATABLE 'FALSE'),
  seismic3dsurvey_native_uid  VARCHAR(1024) NOT NULL,
  binset_name                 VARCHAR(4000),
  data_source                 VARCHAR(4000),
  seismic_survey_name         VARCHAR(4000)  OPTIONS("OpenWorksCommonModel:BinsetGrid3DGrid.seismic_survey_name.isUpdatable" false,
                                               "OpenWorksCommonModel:BinsetGrid3DGrid.seismic_survey_name.isCreatable" false,UPDATABLE 'FALSE'),
  seismic_3d_project_id       VARCHAR(4000),
  grid_isize                  INTEGER,
  grid_jsize                  INTEGER,
  line_at_i1_j1               DOUBLE,
  trace_at_i1_j1              DOUBLE,
  line_at_isize_jsize         DOUBLE,
  trace_at_isize_jsize        DOUBLE,
  grid_i_direction            VARCHAR(4000),
  x_at_i1_j1                  DOUBLE,
  y_at_i1_j1                  DOUBLE,
  x_at_i1_jsize               DOUBLE,
  y_at_i1_jsize               DOUBLE,
  x_at_isize_jsize            DOUBLE,
  y_at_isize_jsize            DOUBLE,
  x_at_isize_j1               DOUBLE,
  y_at_isize_j1               DOUBLE,
  lon_at_i1_j1                DOUBLE,
  lat_at_i1_j1                DOUBLE,
  lon_at_i1_jsize             DOUBLE,
  lat_at_i1_jsize             DOUBLE,
  lon_at_isize_jsize          DOUBLE,
  lat_at_isize_jsize          DOUBLE,
  lon_at_isize_j1             DOUBLE,
  lat_at_isize_j1             DOUBLE,
  orig_x_lon_at_i1_j1         DOUBLE,
  orig_y_lat_at_i1_j1         DOUBLE,
  orig_x_lon_at_i1_jsize      DOUBLE,
  orig_y_lat_at_i1_jsize      DOUBLE,
  orig_x_lon_at_isize_jsize   DOUBLE,
  orig_y_lat_at_isize_jsize   DOUBLE,
  orig_x_lon_at_isize_j1      DOUBLE,
  orig_y_lat_at_isize_j1      DOUBLE,
  orig_crs                    VARCHAR(4000) OPTIONS("OpenWorksCommonModel:BinsetGrid3DGrid.orig_crs.isUpdatable" true,
                                                    "OpenWorksCommonModel:BinsetGrid3DGrid.orig_crs.isCreatable" true,
                                                    "OpenWorksCommonModel:BinsetGrid3DGrid.orig_crs.isImplemented" true,
                                                     UPDATABLE 'TRUE'),
  orig_xy_unit                VARCHAR(4000) OPTIONS("OpenWorksCommonModel:BinsetGrid3DGrid.orig_xy_unit.isUpdatable" true,
                                                    "OpenWorksCommonModel:BinsetGrid3DGrid.orig_xy_unit.isCreatable" true,
                                                    "OpenWorksCommonModel:BinsetGrid3DGrid.orig_xy_unit.isImplemented" true,
                                                     UPDATABLE 'TRUE'),
  offset_bin_total            INTEGER,
  offset_distance_increment   FLOAT,
  min_offset_bin              INTEGER,
  max_offset_bin              INTEGER,
  offset_bin_increment        INTEGER,
  min_cdp_index               INTEGER,
  max_cdp_index               INTEGER,
  cdp_index_increment         INTEGER,
  cdp_total                   INTEGER,
  directory_name_3d           VARCHAR(4000)  DEFAULT 'seis3dDir' OPTIONS("OpenWorksCommonModel:BinsetGrid3DGrid.directory_name_3d.isUpdatable" true,
                                                    "OpenWorksCommonModel:BinsetGrid3DGrid.directory_name_3d.isCreatable" true,
                                                     UPDATABLE 'TRUE'),
  spatial                     BLOB  OPTIONS ("OpenWorksCommonModel:BinsetGrid3DGrid.spatial.isSpatial" true,
                                                  "OpenWorksCommonModel:BinsetGrid3DGrid.spatial.isCreatable" false,
                                                  "OpenWorksCommonModel:BinsetGrid3DGrid.spatial.isUpdatable" false,
                                                  UPDATABLE 'FALSE',
                                                  "OpenWorksCommonModel:BinsetGrid3DGrid.spatial.isComplexType" true,
                                                  "OpenWorksCommonModel:BinsetGrid3DGrid.spatial.isComplexTypeArray" false,
                                                  "OpenWorksCommonModel:BinsetGrid3DGrid.spatial.elementType" 'POLYGONZM',
                                                  "OpenWorksCommonModel:BinsetGrid3DGrid.spatial.elementStruct" '[{"name":"linestringzm":"type":[{"name":"x","type":"double"},{"name":"y","type":"double"},{"name":"z","type":"double"},{"name":"m","type":"double"}]}]'),
  remark                      VARCHAR(4000),
  create_date                 TIMESTAMP     OPTIONS("OpenWorksCommonModel:BinsetGrid3DGrid.create_date.isUpdatable" false,
                                                    "OpenWorksCommonModel:BinsetGrid3DGrid.create_date.isCreatable" false,
                                                     UPDATABLE 'FALSE'),
  create_user_id              VARCHAR(32)   OPTIONS("OpenWorksCommonModel:BinsetGrid3DGrid.create_user_id.isUpdatable" false,
                                                    "OpenWorksCommonModel:BinsetGrid3DGrid.create_user_id.isCreatable" false,
                                                     UPDATABLE 'FALSE'),
  update_date                 TIMESTAMP     OPTIONS("OpenWorksCommonModel:BinsetGrid3DGrid.update_date.isUpdatable" false,
                                                    "OpenWorksCommonModel:BinsetGrid3DGrid.update_date.isCreatable" false,
                                                     UPDATABLE 'FALSE'),
  update_user_id              VARCHAR(32)   OPTIONS("OpenWorksCommonModel:BinsetGrid3DGrid.update_user_id.isUpdatable" false,
                                                    "OpenWorksCommonModel:BinsetGrid3DGrid.update_user_id.isCreatable" false,
                                                     UPDATABLE 'FALSE'),
  alternate_uid    		          VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:BinsetGrid3DGrid.alternate_uid.isCreatable" false,
                                                     "OpenWorksCommonModel:BinsetGrid3DGrid.alternate_uid.isUpdatable" false,
                                                      UPDATABLE 'FALSE'),

  CONSTRAINT BinsetGrid3DGrid_PK PRIMARY KEY (native_uid),

  CONSTRAINT BinsetGrid3DGrid_UK1 UNIQUE (seismic3dsurvey_native_uid),

  CONSTRAINT FK_BinsetGrid3DGrid_orig_crs
    FOREIGN KEY                    (orig_crs)
    REFERENCES CartoReferenceSystem(name),

  CONSTRAINT FK_BinsetGrid3DGrid_seismic_survey_name
        FOREIGN KEY               (seismic3dsurvey_native_uid)
        REFERENCES Seismic3DSurvey(native_uid),

    CONSTRAINT FK_BinsetGrid3DGrid_data_source
        FOREIGN KEY (data_source)
        REFERENCES DataSource(name)

)
OPTIONS (UPDATABLE 'TRUE',BinsetGrid3DGrid.IMPLEMENTED 'TRUE')
    AS
SELECT
        BG.binset_grid_id AS native_uid,
        BG.seis_geom_set_id AS seismic3dsurvey_native_uid,
        binset_name AS binset_name,
        BG.data_source AS data_source,
        SS.seis_geom_set_nm AS seismic_survey_name,
        BG.seis_3d_project_id AS seismic_3d_project_id,
        BG.grid_isize AS grid_isize,
        BG.grid_jsize AS grid_jsize,
        BG.line_at_i1_j1 AS line_at_i1_j1,
        BG.trace_at_i1_j1 AS trace_at_i1_j1,
        BG.line_at_isize_jsize AS line_at_isize_jsize,
        BG.trace_at_isize_jsize AS trace_at_isize_jsize,
        BG.grid_i_direction AS grid_i_direction,
        BG.x_at_i1_j1 AS x_at_i1_j1,
        BG.y_at_i1_j1 AS y_at_i1_j1,
        BG.x_at_i1_jsize AS x_at_i1_jsize,
        BG.y_at_i1_jsize AS y_at_i1_jsize,
        BG.x_at_isize_jsize AS x_at_isize_jsize,
        BG.y_at_isize_jsize AS y_at_isize_jsize,
        BG.x_at_isize_j1 AS x_at_isize_j1,
        BG.y_at_isize_j1 AS y_at_isize_j1,
        null AS lon_at_i1_j1,
        null AS lat_at_i1_j1,
        null AS lon_at_i1_jsize,
        null AS lat_at_i1_jsize,
        null AS lon_at_isize_jsize,
        null AS lat_at_isize_jsize,
        null AS lon_at_isize_j1,
        null AS lat_at_isize_j1,
        BG.orig_x_lon_at_i1_j1 AS orig_x_lon_at_i1_j1,
        BG.orig_y_lat_at_i1_j1 AS orig_y_lat_at_i1_j1,
        BG.orig_x_lon_at_i1_jsize AS orig_x_lon_at_i1_jsize,
        BG.orig_y_lat_at_i1_jsize AS orig_y_lat_at_i1_jsize,
        BG.orig_x_lon_at_isize_jsize AS orig_x_lon_at_isize_jsize,
        BG.orig_y_lat_at_isize_jsize AS orig_y_lat_at_isize_jsize,
        BG.orig_x_lon_at_isize_j1 AS orig_x_lon_at_isize_j1,
        BG.orig_y_lat_at_isize_j1 AS orig_y_lat_at_isize_j1,
        Carto.name AS orig_crs,
        getDSDSCrsUnit(Carto.name) AS orig_xy_unit,
        BG.ofst_bin_total AS offset_bin_total,
        BG.ofst_dist_incr AS offset_distance_increment,
        BG.min_ofst_bin AS min_offset_bin,
        BG.max_ofst_bin AS max_offset_bin,
        BG.ofst_bin_incr AS offset_bin_increment,
        BG.min_cdp_idx AS min_cdp_index,
        BG.max_cdp_idx AS max_cdp_index,
        BG.cdp_idx_incr AS cdp_index_increment,
        BG.cdp_total AS cdp_total,
        BG.directory_name_3d AS directory_name_3d,
        SS.spatial AS spatial,
        BG.remark AS remark,
        BG.create_date AS create_date,
        BG.create_user_id AS create_user_id,
        BG.update_date AS update_date,
        BG.update_user_id AS update_user_id,
        BG.native_uid AS alternate_uid
    FROM (OpenWorks_SM.BinsetGrid3DGrid BG INNER JOIN
    OpenWorks_SM.Seis3DSurvey SS
    ON BG.seis_geom_set_id = SS.seis_geom_set_id
    LEFT OUTER JOIN OpenWorks_SM.CartoRefSys Carto ON
    BG.orig_crs_id = Carto.id
    );
Create Trigger on BinsetGrid3DGrid INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC

    DECLARE string VARIABLES.orig_crs_id = (SELECT id FROM OpenWorks_SM.CartoRefSys where name = (SELECT * FROM (EXEC OpenWorks_SM.GetNativeCRS("NEW".orig_crs,'OW')) AS SysGenID));
    DECLARE float VARIABLES.z_datum = (SELECT z_datum from OpenWorks_SM.SeisGeomSet3DSurvey where seis_geom_set_nm = "NEW".seismic_survey_name);
    DECLARE string VARIABLES.z_datum_dsdsunit = (SELECT z_datum_dsdsunit from OpenWorks_SM.SeisGeomSet3DSurvey where seis_geom_set_nm = "NEW".seismic_survey_name);
    DECLARE string VARIABLES.restricted_data_ind = (SELECT restricted_data_ind from OpenWorks_SM.SeisGeomSet3DSurvey where seis_geom_set_nm = "NEW".seismic_survey_name);
    --DECLARE string VARIABLES.directory_name_3d = 'testseistransfer';
    DECLARE string VARIABLES.binset_grid_id =  (SELECT * FROM (EXEC OpenWorks_SM.nextval('BinsetGrid3DGrid')) AS SysGenID) ;


INSERT INTO OpenWorks_SM.BinsetGrid3DGrid
("trace_at_isize_jsize"    ,"orig_y_lat_at_isize_jsize"    ,"grid_jsize"    ,"y_at_i1_jsize"    ,"y_at_isize_jsize"    ,"orig_y_lat_at_isize_j1"    ,"orig_crs_id"        ,"orig_x_lon_at_i1_j1"    ,"grid_isize"    ,"orig_x_lon_at_i1_jsize"    ,"x_at_i1_jsize"    ,"y_at_i1_j1"    ,"line_at_i1_j1"    ,"binset_name"       ,"seis_3d_project_id","trace_at_i1_j1"    ,"binset_grid_id"        ,"orig_y_lat_at_i1_jsize" ,"data_source"    ,"orig_x_lon_at_isize_j1"    ,"y_at_isize_j1"    ,"x_at_isize_j1"    ,"grid_i_direction"    ,"line_at_isize_jsize"    ,"x_at_i1_j1"    ,"orig_x_lon_at_isize_jsize"    ,"orig_y_lat_at_i1_j1" ,"directory_name_3d"    ,"x_at_isize_jsize"  , "seis_geom_set_id"  ) VALUES
("NEW".trace_at_isize_jsize,"NEW".orig_y_lat_at_isize_jsize,"NEW".grid_jsize,"NEW".y_at_i1_jsize,"NEW".y_at_isize_jsize,"NEW".orig_y_lat_at_isize_j1,VARIABLES.orig_crs_id,"NEW".orig_x_lon_at_i1_j1,"NEW".grid_isize,"NEW".orig_x_lon_at_i1_jsize,"NEW".x_at_i1_jsize,"NEW".y_at_i1_j1,"NEW".line_at_i1_j1,"NEW".binset_name,SUBSTRING("NEW".seismic_3d_project_id,1,8),"NEW".trace_at_i1_j1,VARIABLES.binset_grid_id,"NEW".orig_y_lat_at_i1_jsize,"NEW".data_source,"NEW".orig_x_lon_at_isize_j1,"NEW".y_at_isize_j1,"NEW".x_at_isize_j1,"NEW".grid_i_direction,"NEW".line_at_isize_jsize,"NEW".x_at_i1_j1,"NEW".orig_x_lon_at_isize_jsize,"NEW".orig_y_lat_at_i1_j1,"NEW".directory_name_3d,"NEW".x_at_isize_jsize , "NEW".seismic3dsurvey_native_uid);


END;

Create Trigger on BinsetGrid3DGrid INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC

    DECLARE string VARIABLES.crs_errorMsg= CONCAT (CONCAT('ERROR: The given crs value "',"NEW".orig_crs),'" does not exist in OpenWorks or an equivalent mapping does not exist in DSDS');
    DECLARE string VARIABLES.orig_crs_id;
    IF("NEW".orig_crs IS NOT NULL)
    BEGIN
        VARIABLES.orig_crs_id = (SELECT id FROM OpenWorks_SM.CartoRefSys WHERE name = (SELECT * FROM (EXEC OpenWorks_SM.GetNativeCRS("NEW".orig_crs,'OW')) AS SysGenID));
            IF(VARIABLES.orig_crs_id is NULL)
                ERROR VARIABLES.crs_errorMsg;
    END

    DECLARE integer VARIABLES.seis_geom_set_id = (SELECT * FROM (EXEC OpenWorks_SM.nextval('Seis3DSurvey')) AS SysGenID);
    DECLARE float VARIABLES.z_datum = (SELECT z_datum from OpenWorks_SM.SeisGeomSet3DSurvey where seis_geom_set_nm = "NEW".seismic_survey_name);
    DECLARE string VARIABLES.z_datum_dsdsunit = (SELECT z_datum_dsdsunit from OpenWorks_SM.SeisGeomSet3DSurvey where seis_geom_set_nm = "NEW".seismic_survey_name);
    DECLARE string VARIABLES.restricted_data_ind = (SELECT restricted_data_ind from OpenWorks_SM.SeisGeomSet3DSurvey where seis_geom_set_nm = "NEW".seismic_survey_name);


    UPDATE OpenWorks_SM.BinsetGrid3DGrid SET
    trace_at_isize_jsize        = "NEW".trace_at_isize_jsize,
    orig_y_lat_at_isize_jsize   = "NEW".orig_y_lat_at_isize_jsize,
    grid_jsize                  = "NEW".grid_jsize,
    y_at_i1_jsize               = "NEW".y_at_i1_jsize,
    y_at_isize_jsize            = "NEW".y_at_isize_jsize,
    orig_y_lat_at_isize_j1      = "NEW".orig_y_lat_at_isize_j1,
    orig_crs_id                 = VARIABLES.orig_crs_id,
    orig_x_lon_at_i1_j1         = "NEW".orig_x_lon_at_i1_j1,
    grid_isize                  = "NEW".grid_isize,
    orig_x_lon_at_i1_jsize      = "NEW".orig_x_lon_at_i1_jsize,
    x_at_i1_jsize               = "NEW".x_at_i1_jsize,
    y_at_i1_j1                  = "NEW".y_at_i1_j1,
    line_at_i1_j1               = "NEW".line_at_i1_j1,
    binset_name                 = "NEW".binset_name,
    seis_3d_project_id          = SUBSTRING("NEW".seismic_3d_project_id,1,8),
    trace_at_i1_j1              = "NEW".trace_at_i1_j1,
    orig_y_lat_at_i1_jsize      = "NEW".orig_y_lat_at_i1_jsize,
    data_source                 = "NEW".data_source,
    orig_x_lon_at_isize_j1      = "NEW".orig_x_lon_at_isize_j1,
    y_at_isize_j1               = "NEW".y_at_isize_j1,
    x_at_isize_j1               = "NEW".x_at_isize_j1,
    grid_i_direction            = "NEW".grid_i_direction,
    line_at_isize_jsize         = "NEW".line_at_isize_jsize,
    x_at_i1_j1                  = "NEW".x_at_i1_j1,
    orig_x_lon_at_isize_jsize   = "NEW".orig_x_lon_at_isize_jsize,
    orig_y_lat_at_i1_j1         = "NEW".orig_y_lat_at_i1_j1,
    directory_name_3d           = SUBSTRING("NEW".directory_name_3d,1,40),
    x_at_isize_jsize            = "NEW".x_at_isize_jsize,
    seis_geom_set_id             = "NEW".seismic3dsurvey_native_uid

    WHERE  OpenWorks_SM.BinsetGrid3DGrid.binset_grid_id="OLD".native_uid;

END;

Create Trigger on BinsetGrid3DGrid INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC
DELETE from OpenWorks_SM.BinsetGrid3DGrid WHERE  OpenWorks_SM.BinsetGrid3DGrid.binset_grid_id="OLD".native_uid;

END;

/*
**********************************
* ENTITY: SeismicDataSet3D
**********************************
*/
CREATE VIEW SeismicDataSet3D
(
	native_uid                      VARCHAR(1024)               OPTIONS("OpenWorksCommonModel:SeismicDataSet3D.native_uid.isUpdatable" false,
                                                                        "OpenWorksCommonModel:SeismicDataSet3D.native_uid.isCreatable" false,
                                                                        UPDATABLE 'FALSE'),
    seismic3dsurvey_native_uid      VARCHAR(1024)               NOT NULL,
    seismic_data_set_name           VARCHAR(256)                NOT NULL,
    seismic_version_name            VARCHAR(40)                 NOT NULL,
    binsetgrid3dgrid_native_uid     VARCHAR(1024),
    data_source                     VARCHAR(5),
    seismic_attribute_name          VARCHAR(40),
    interpretation_status           VARCHAR(12),
    seismic_class                   VARCHAR(12),
    attribute_unit                  VARCHAR(12),
    acquired_by                     VARCHAR(40),
    acquisition_date                TIMESTAMP,
    data_file_name                  VARCHAR(50)                  NOT NULL,
    data_file_format                VARCHAR(12)                  NOT NULL,
    binary_data_format              VARCHAR(24),
    start_inline                    DOUBLE,
    end_inline                      DOUBLE,
    increment_inline                INTEGER,
    start_xline                     DOUBLE,
    end_xline                       DOUBLE,
    increment_xline                    INTEGER,
    num_traces                      INTEGER,
    min_amplitude                   DOUBLE,
    min_amplitude_unit              VARCHAR(64),
    max_amplitude                   DOUBLE,
    max_amplitude_unit              VARCHAR(64),
    polarity                        VARCHAR(40)          DEFAULT 'UNKNOWN',
    processed_by                    VARCHAR(40),
    processed_date                  TIMESTAMP,
    total_size                      DOUBLE,
    total_size_unit                 VARCHAR(64),
    z_domain                        VARCHAR(12)                   NOT NULL,
    z_start                         DOUBLE                        NOT NULL,
    z_start_unit                    VARCHAR(64),
    z_start_unittype                VARCHAR(64),
    z_start_actual                  DOUBLE,
    z_start_actual_unit             VARCHAR(64),
    z_start_actual_unittype         VARCHAR(64),
    z_sample_rate                   DOUBLE                        NOT NULL,
    z_sample_rate_unit              VARCHAR(64),
    z_sample_rate_unittype          VARCHAR(64),
    z_npts                          INTEGER                       NOT NULL,
    z_npts_actual                   INTEGER,
    data                            BLOB           NOT NULL    OPTIONS ("OpenWorksCommonModel:SeismicDataSet3D.data.isMedia" 'true',
                                                                        "OpenWorksCommonModel:SeismicDataSet3D.data.mediaContentType" 'application/octet-stream'),
    remark                          VARCHAR(200),
    file_exists                      BOOLEAN,
    create_date                     TIMESTAMP,
    create_user_id                  VARCHAR(32),
    update_date                     TIMESTAMP,
    update_user_id                  VARCHAR(32),
    alternate_uid    		                VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:SeismicDataSet3D.alternate_uid.isCreatable"  false,
                                                           "OpenWorksCommonModel:SeismicDataSet3D.alternate_uid.isUpdatable" false,
                                                           UPDATABLE 'FALSE'),


    CONSTRAINT SeismicDataSet3D_PK PRIMARY KEY (native_uid),

    CONSTRAINT SeismicDataSet3D_UK1 UNIQUE (seismic_data_set_name,seismic_version_name,seismic3dsurvey_native_uid),

    CONSTRAINT FK_SeismicDataSet3D_seismic3dsurvey_native_uid
    FOREIGN KEY               (seismic3dsurvey_native_uid)
    REFERENCES Seismic3DSurvey(native_uid),

    CONSTRAINT FK_SeismicDataSet3D_binsetgrid3dgrid_native_uid
    FOREIGN KEY                (binsetgrid3dgrid_native_uid)
    REFERENCES BinsetGrid3DGrid(native_uid)
)
OPTIONS (UPDATABLE 'TRUE', SeismicDataSet3D.IMPLEMENTED 'TRUE')
AS
    SELECT
        A.seismic_data_set_id                    AS        native_uid,
        A.seis_geom_set_id                       AS        seismic3dsurvey_native_uid,
        A.seis_data_set_name                     AS        seismic_data_set_name,
        A.seismic_version_name                   AS        seismic_version_name,
        A.binset_grid_id                         AS        binsetgrid3dgrid_native_uid,
        A.data_source                            AS        data_source,
        A.r_seis_attr_nm                         AS        seismic_attribute_name,
        A.interpretation_status                  AS        interpretation_status,
        A.seismic_class                          AS        seismic_class,
        A.attribute_uom                          AS        attribute_unit,
        A.acquired_by                            AS        acquired_by,
        A.acquisition_date                       AS        acquisition_date,
        A.data_file_name                         AS        data_file_name,
        A.data_file_format                       AS        data_file_format,
        A.binary_data_format                     AS        binary_data_format,
        A.line_min                               AS        start_inline,
        A.line_max                               AS        end_inline,
        CASE
        WHEN B.grid_i_direction = 'TRACE' AND B.grid_jsize = 1 THEN
        1
        WHEN B.grid_i_direction = 'LINE' AND B.grid_isize = 1 THEN
        1
        WHEN B.grid_i_direction = 'TRACE' THEN
        CAST( ABS((B.line_at_isize_jsize - B.line_at_i1_j1 ) / (B.grid_jsize -1  )) AS integer )
        ELSE
        CAST( ABS((B.line_at_isize_jsize - B.line_at_i1_j1 ) / (B.grid_isize -1 )) AS integer )
        END                                      AS         increment_inline,
        A.trace_min                              AS        start_xline,
        A.trace_max                              AS        end_xline,
        CASE
        WHEN B.grid_i_direction = 'TRACE' AND B.grid_isize = 1 THEN
        1
        WHEN B.grid_i_direction = 'LINE' AND B.grid_jsize = 1 THEN
	    1
        WHEN B.grid_i_direction = 'TRACE'
        THEN
        CAST( ABS((B.trace_at_isize_jsize - B.trace_at_i1_j1 ) / (B.grid_isize -1 )) AS integer )
        ELSE
        CAST( ABS((B.trace_at_isize_jsize - B.trace_at_i1_j1 ) / (B.grid_jsize  -1 )) AS integer )
        END
                                                 AS         increment_xline,

        CASE
        WHEN B.grid_i_direction = 'TRACE' AND B.grid_jsize = 1 THEN
        CAST(((
            (line_max-line_min                                                          /*Line Differencce    */
            +1))                                                                        /*Add increment of 1 only*/
        *
            (trace_max-trace_min                                                        /*Trace Differencce    */
            +ABS((B.trace_at_isize_jsize - B.trace_at_i1_j1 ) / (B.grid_isize -1 )))    /*Add Trace Inc    */
             /ABS((B.trace_at_isize_jsize - B.trace_at_i1_j1 ) / (B.grid_isize -1 )))   /*Div by Trace Inc    */
         AS integer)

        WHEN B.grid_i_direction = 'TRACE' AND B.grid_isize = 1 THEN
        CAST(((
            (line_max-line_min                                                          /*Line Differencce    */
            +ABS((B.line_at_isize_jsize - B.line_at_i1_j1 ) / (B.grid_jsize -1 )))      /*Add Line Inc    */
            /ABS((B.line_at_isize_jsize - B.line_at_i1_j1 ) / (B.grid_jsize -1 )))      /*Div by Line Inc    */
        *
            (trace_max-trace_min                                                        /*Trace Differencce    */
            +1))                                                                        /*Add increment of 1 only*/
         AS integer)

        WHEN B.grid_i_direction = 'LINE' AND B.grid_jsize = 1 THEN
	    CAST(((
            (line_max-line_min                                                          /*Line Differencce    */
            +ABS((B.line_at_isize_jsize - B.line_at_i1_j1 ) / (B.grid_isize -1 )))      /*Add Line Inc    */
            /ABS((B.line_at_isize_jsize - B.line_at_i1_j1 ) / (B.grid_isize -1 )))      /*Div by Line Inc    */
        *
            (trace_max-trace_min                                                        /*Trace Differencce    */
            +1))                                                                        /*Add increment of 1 only*/
         AS integer)

        WHEN B.grid_i_direction = 'LINE' AND B.grid_isize = 1 THEN
        CAST(((
            (line_max-line_min                                                          /*Line Differencce    */
            +1))                                                                        /*Add increment of 1 only*/
        *
            (trace_max-trace_min                                                        /*Trace Differencce    */
            +ABS((B.trace_at_isize_jsize - B.trace_at_i1_j1 ) / (B.grid_jsize -1 )))    /*Add Trace Inc    */
            /ABS((B.trace_at_isize_jsize - B.trace_at_i1_j1 ) / (B.grid_jsize -1 )))    /*Div by Trace Inc    */
         AS integer)

        WHEN B.grid_i_direction = 'TRACE'
        THEN

        CAST(((
            (line_max-line_min                                                          /*Line Differencce    */
            +ABS((B.line_at_isize_jsize - B.line_at_i1_j1 ) / (B.grid_jsize -1 )))      /*Add Line Inc    */
            /ABS((B.line_at_isize_jsize - B.line_at_i1_j1 ) / (B.grid_jsize -1 )))      /*Div by Line Inc    */
        *
            (trace_max-trace_min                                                        /*Trace Differencce    */
            +ABS((B.trace_at_isize_jsize - B.trace_at_i1_j1 ) / (B.grid_isize -1 )))    /*Add Trace Inc    */
             /ABS((B.trace_at_isize_jsize - B.trace_at_i1_j1 ) / (B.grid_isize -1 )))   /*Div by Trace Inc    */
         AS integer)

        ELSE

        CAST(((
            (line_max-line_min                                                          /*Line Differencce    */
            +ABS((B.line_at_isize_jsize - B.line_at_i1_j1 ) / (B.grid_isize -1 )))      /*Add Line Inc    */
            /ABS((B.line_at_isize_jsize - B.line_at_i1_j1 ) / (B.grid_isize -1 )))      /*Div by Line Inc    */
        *
            (trace_max-trace_min                                                        /*Trace Differencce    */
            +ABS((B.trace_at_isize_jsize - B.trace_at_i1_j1 ) / (B.grid_jsize -1 )))    /*Add Trace Inc    */
            /ABS((B.trace_at_isize_jsize - B.trace_at_i1_j1 ) / (B.grid_jsize -1 )))    /*Div by Trace Inc    */

        AS integer)
        END
                                                AS        num_traces,
        A.min                                    AS        min_amplitude,
        A.min_dsdsunit                           AS        min_amplitude_unit,
        A.max                                    AS        max_amplitude,
        A.max_dsdsunit                           AS        max_amplitude_unit,
        A.polarity                               AS        polarity,
        A.processed_by                           AS        processed_by,
        A.processed_date                         AS        processed_date,
        A.total_size                             AS        total_size,
        A.total_size_dsdsunit                    AS        total_size_unit,
        A.z_domain                               AS        z_domain,
        A.z_start                                AS        z_start,
        A.z_start_dsdsunit                       AS        z_start_unit,
        A.z_start_dsdsunittype                   AS        z_start_unittype,
        A.z_start_actual                         AS        z_start_actual,
        A.z_start_actual_dsdsunit                AS        z_start_actual_unit,
        A.z_start_actual_dsdsunittype            AS        z_start_actual_unittype,
        A.z_sample_rate                          AS        z_sample_rate,
        A.z_sample_rate_dsdsunit                 AS        z_sample_rate_unit,
        A.z_sample_rate_dsdsunittype             AS        z_sample_rate_unittype,
        A.z_npts                                 AS        z_npts,
        A.z_npts_actual                          AS        z_npts_actual,
        A.data                                   AS        data,
        A.remark                                 AS        remark,
        CONVERT(A.fileExists,Boolean)            AS        file_exists,
        A.create_date                            AS        create_date,
        A.create_user_id                         AS        create_user_id,
        A.update_date                            AS        update_date,
        A.update_user_id                         AS        update_user_id,
	    A.native_uid							 AS        alternate_uid

    FROM OpenWorks_SM.SeismicDataSet A
    INNER JOIN OpenWorks_SM.BinsetGrid3DGrid B
    ON A.binset_grid_id = B.binset_grid_id
    WHERE geom_set_type = '3D Survey';

Create Trigger on SeismicDataSet3D INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC

    DECLARE string VARIABLES.geom_set_type                =    '3D Survey';

    INSERT into OpenWorks_SM.SeismicDataSet ("seis_geom_set_id","seis_data_set_name","seismic_version_name","geom_set_type","data_file_name","binary_data_format","data_file_format","polarity","z_domain","z_start","z_start_dsdsunit","z_npts","z_sample_rate","z_sample_rate_dsdsunit","data_source","data")


    VALUES ("NEW".seismic3dsurvey_native_uid,"NEW".seismic_data_set_name,"NEW".seismic_version_name,VARIABLES.geom_set_type,"NEW".data_file_name,"NEW".binary_data_format,"NEW".data_file_format,"NEW".polarity,"NEW".z_domain,"NEW".z_start,"NEW".z_start_unit,"NEW".z_npts,"NEW".z_sample_rate,"NEW".z_sample_rate_unit,"NEW".data_source,"NEW".data);

    --set the remark

    update OpenWorks_SM.SeismicDataSet
    set remark = "NEW".remark where
    seis_data_set_name = "NEW".seismic_data_set_name and
    seis_geom_set_id   = "NEW".seismic3dsurvey_native_uid and
    seismic_version_name = "NEW".seismic_version_name;

END;

Create Trigger on SeismicDataSet3D INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC

    DECLARE string VARIABLES.geom_set_type                =    '3D Survey';

	IF((CHANGING.data))
        BEGIN

            UPDATE OpenWorks_SM.SeismicDataSet SET

            "geom_set_type"                 =    VARIABLES.geom_set_type,
            "data_file_name"                =    "OLD".data_file_name,
            "binary_data_format"            =    "NEW".binary_data_format,
            "data_file_format"              =    "NEW".data_file_format,
            "polarity"                      =    "NEW".polarity,
            "z_domain"                      =    "NEW".z_domain,
            "z_start"                       =    "NEW".z_start,
            "z_start_dsdsunit"              =    "NEW".z_start_unit,
            "z_npts"                        =    "NEW".z_npts,
            "z_sample_rate"                 =    "NEW".z_sample_rate,
            "z_sample_rate_dsdsunit"        =    "NEW".z_sample_rate_unit,
            "data_source"                   =    "NEW".data_source,
            "data"                          =    "NEW".data,
            "seismic_version_name"          =    "OLD".seismic_version_name,
            "trace_min"						=	 "NEW".start_xline,
            "trace_max"						=	 "NEW".end_xline,
            "line_min"						=	 "NEW".start_inline,
            "line_max"						=	 "NEW".end_inline,
            "remark"                        =    "NEW".remark

            WHERE  OpenWorks_SM.SeismicDataSet.seismic_data_set_id="OLD".native_uid;
		END
	ELSE
		BEGIN

			UPDATE OpenWorks_SM.SeismicDataSet SET

			"geom_set_type"                 =    VARIABLES.geom_set_type,
			"data_file_name"                =    "OLD".data_file_name,
			"binary_data_format"            =    "NEW".binary_data_format,
			"data_file_format"              =    "NEW".data_file_format,
			"polarity"                      =    "NEW".polarity,
			"z_domain"                      =    "NEW".z_domain,
			"z_start"                       =    "NEW".z_start,
			"z_start_dsdsunit"              =    "NEW".z_start_unit,
			"z_npts"                        =    "NEW".z_npts,
			"z_sample_rate"                 =    "NEW".z_sample_rate,
			"z_sample_rate_dsdsunit"        =    "NEW".z_sample_rate_unit,
			"data_source"                   =    "NEW".data_source,
			"seismic_version_name"          =    "OLD".seismic_version_name,
			"trace_min"						=	 "NEW".start_xline,
			"trace_max"						=	 "NEW".end_xline,
			"line_min"						=	 "NEW".start_inline,
			"line_max"						=	 "NEW".end_inline,
            "remark"                        =    "NEW".remark

			WHERE  OpenWorks_SM.SeismicDataSet.seis_data_set_name="OLD".seismic_data_set_name and seis_geom_set_id = "OLD".seismic3dsurvey_native_uid and OpenWorks_SM.SeismicDataSet.seismic_version_name = "OLD".seismic_version_name;
		END

END;

Create Trigger on SeismicDataSet3D INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC
DELETE from OpenWorks_SM.SeismicDataSet WHERE  OpenWorks_SM.SeismicDataSet.seismic_data_set_id="OLD".native_uid;

END;
/*
**********************************
*     "Seismic2DSurvey"
**********************************
*/

CREATE VIEW Seismic2DSurvey
(
  native_uid                         VARCHAR(1024) OPTIONS("OpenWorksCommonModel:Seismic2DSurvey.native_uid.isUpdatable" false,
                                                             "OpenWorksCommonModel:Seismic2DSurvey.native_uid.isCreatable" false,
                                                             UPDATABLE 'FALSE'),
  seismic_survey_name                VARCHAR(40) NOT NULL,
  seismic_geometry_kind              VARCHAR(40) OPTIONS ("OpenWorksCommonModel:Seismic2DSurvey.seismic_geometry_kind.isUpdatable" false,
                                                          "OpenWorksCommonModel:Seismic2DSurvey.seismic_geometry_kind.isCreatable" false,
                                                          UPDATABLE 'FALSE'),
  data_source                        VARCHAR(5),
  acquired_by                        VARCHAR(40) DEFAULT 'UNKNOWN',
  acquired_for                       VARCHAR(40) DEFAULT 'UNKNOWN',
  acquisition_start_date             TIMESTAMP,
  acquisition_end_date               TIMESTAMP,
  acquisition_cost                   FLOAT,
  currency                           VARCHAR(24) DEFAULT 'UNKNOWN',
  survey_environment_kind            VARCHAR(40) DEFAULT 'UNKNOWN',
  acquisition_area_name              VARCHAR(40) DEFAULT 'UNKNOWN',
  county_name                        VARCHAR(25) DEFAULT 'UNKNOWN',
  state_name                         VARCHAR(20) DEFAULT 'UNKNOWN',
  country_name                       VARCHAR(25) DEFAULT 'UNKNOWN',
  acquisition_crew                   VARCHAR(80),
  acquisition_survey                 VARCHAR(40) DEFAULT 'UNKNOWN',
  vertical_misclosure_factor         FLOAT          OPTIONS ("OpenWorksCommonModel:Seismic2DSurvey.vertical_misclosure_factor.unitField" 'vertical_misclosure_factor_unit'),
  vertical_misclosure_factor_unit    VARCHAR(64)    OPTIONS ("OpenWorksCommonModel:Seismic2DSurvey.vertical_misclosure_factor_unit.unitType" 'factor'),
  horizontal_misclosure_factor       FLOAT          OPTIONS ("OpenWorksCommonModel:Seismic2DSurvey.horizontal_misclosure_factor.unitField" 'horizontal_misclosure_factor_unit'),
  horizontal_misclosure_factor_unit  VARCHAR(64)    OPTIONS ("OpenWorksCommonModel:Seismic2DSurvey.horizontal_misclosure_factor_unit.unitType" 'factor'),
  azimuth_misclosure_factor          FLOAT          OPTIONS ("OpenWorksCommonModel:Seismic2DSurvey.azimuth_misclosure_factor.unitField" 'azimuth_misclosure_factor_unit'),
  azimuth_misclosure_factor_unit     VARCHAR(64)    OPTIONS ("OpenWorksCommonModel:Seismic2DSurvey.azimuth_misclosure_factor_unit.unitType" 'factor'),
  remark                             VARCHAR(200),
  create_date                        TIMESTAMP   OPTIONS("OpenWorksCommonModel:Seismic2DSurvey.create_date.isUpdatable" false,
                                                         "OpenWorksCommonModel:Seismic2DSurvey.create_date.isCreatable" false,
                                                          UPDATABLE 'FALSE'),
  create_user_id                     VARCHAR(32) OPTIONS("OpenWorksCommonModel:Seismic2DSurvey.create_user_id.isUpdatable" false,
                                                         "OpenWorksCommonModel:Seismic2DSurvey.create_user_id.isCreatable" false,
                                                          UPDATABLE 'FALSE'),
  update_date                        TIMESTAMP   OPTIONS("OpenWorksCommonModel:Seismic2DSurvey.update_date.isUpdatable" false,
                                                         "OpenWorksCommonModel:Seismic2DSurvey.update_date.isCreatable" false,
                                                          UPDATABLE 'FALSE'),
  update_user_id                     VARCHAR(32) OPTIONS("OpenWorksCommonModel:Seismic2DSurvey.update_user_id.isUpdatable" false,
                                                         "OpenWorksCommonModel:Seismic2DSurvey.update_user_id.isCreatable" false,
                                                          UPDATABLE 'FALSE'),
  alternate_uid    		                 VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:Seismic2DSurvey.alternate_uid.isCreatable" false,
                                                            "OpenWorksCommonModel:Seismic2DSurvey.alternate_uid.isUpdatable" false,
                                                             UPDATABLE 'FALSE'),
    CONSTRAINT Seismic2DSurvey_PK PRIMARY KEY (native_uid),

    CONSTRAINT Seismic2DSurvey_UK1 UNIQUE (seismic_survey_name),

    CONSTRAINT FK_Seismic2DSurvey_data_source
        FOREIGN KEY (data_source)
        REFERENCES DataSource(name),

    CONSTRAINT FK_Seismic2DSurvey_acquired_by
        FOREIGN KEY (acquired_by)
        REFERENCES Company(company_name),

    CONSTRAINT FK_Seismic2DSurvey_acquired_for
        FOREIGN KEY (acquired_for)
        REFERENCES Company(company_name),

    CONSTRAINT FK_Seismic2DSurvey_acquisition_survey
        FOREIGN KEY (acquisition_survey)
        REFERENCES Company(company_name)

)
OPTIONS (UPDATABLE 'TRUE', Seismic2DSurvey.IMPLEMENTED 'TRUE')
AS
SELECT
 OpenWorks_SM.SeisGeomSet2DSurvey.seis_geom_set_id AS native_uid,
 OpenWorks_SM.SeisGeomSet2DSurvey.seis_geom_set_nm AS seismic_survey_name,
 OpenWorks_SM.SeisGeomSet2DSurvey.r_seismic_geom_kd,
 OpenWorks_SM.SeisGeomSet2DSurvey.data_source,
 OpenWorks_SM.SeisGeomSet2DSurvey.acquired_by,
 OpenWorks_SM.SeisGeomSet2DSurvey.acquired_for,
 OpenWorks_SM.SeisGeomSet2DSurvey.acq_start_date,
 OpenWorks_SM.SeisGeomSet2DSurvey.acq_end_date,
 OpenWorks_SM.SeisGeomSet2DSurvey.acq_cost,
 OpenWorks_SM.SeisGeomSet2DSurvey.currency,
 OpenWorks_SM.SeisGeomSet2DSurvey.r_survey_envr_kd,
 OpenWorks_SM.SeisGeomSet2DSurvey.geop_acq_area_nm,
 OpenWorks_SM.SeisGeomSet2DSurvey.county_nm,
 OpenWorks_SM.SeisGeomSet2DSurvey.state_nm,
 OpenWorks_SM.SeisGeomSet2DSurvey.country_nm,
 OpenWorks_SM.SeisGeomSet2DSurvey.acq_crew,
 OpenWorks_SM.SeisGeomSet2DSurvey.acq_survey,
 OpenWorks_SM.SeisGeomSet2DSurvey.vert_mclos_fact,
 OpenWorks_SM.SeisGeomSet2DSurvey.vert_mclos_fact_dsdsunit ,
 OpenWorks_SM.SeisGeomSet2DSurvey.horz_mclos_fact,
 OpenWorks_SM.SeisGeomSet2DSurvey.horz_mclos_fact_dsdsunit ,
 OpenWorks_SM.SeisGeomSet2DSurvey.azm_mclos_fact,
 OpenWorks_SM.SeisGeomSet2DSurvey.azm_mclos_fact_dsdsunit,
 OpenWorks_SM.SeisGeomSet2DSurvey.remark,
 OpenWorks_SM.SeisGeomSet2DSurvey.create_date,
 OpenWorks_SM.SeisGeomSet2DSurvey.create_user_id,
 OpenWorks_SM.SeisGeomSet2DSurvey.update_date,
 OpenWorks_SM.SeisGeomSet2DSurvey.update_user_id,
 OpenWorks_SM.SeisGeomSet2DSurvey.native_uid AS alternate_uid
    FROM
        OpenWorks_SM.SeisGeomSet2DSurvey;

     CREATE TRIGGER ON Seismic2DSurvey INSTEAD OF INSERT AS
     FOR EACH ROW
BEGIN ATOMIC
    DECLARE integer VARIABLES.seis_geom_set_id = (SELECT * FROM (EXEC OpenWorks_SM.nextval('SeisGeomSet2DSurvey')) AS SysGenID);
    INSERT INTO OpenWorks_SM.SeisGeomSet2DSurvey (OpenWorks_SM.SeisGeomSet2DSurvey.seis_geom_set_id, OpenWorks_SM.SeisGeomSet2DSurvey.seis_geom_set_nm, OpenWorks_SM.SeisGeomSet2DSurvey.data_source, OpenWorks_SM.SeisGeomSet2DSurvey.acquired_by, OpenWorks_SM.SeisGeomSet2DSurvey.acquired_for, OpenWorks_SM.SeisGeomSet2DSurvey.acq_start_date, OpenWorks_SM.SeisGeomSet2DSurvey.acq_end_date, OpenWorks_SM.SeisGeomSet2DSurvey.acq_cost, OpenWorks_SM.SeisGeomSet2DSurvey.currency, OpenWorks_SM.SeisGeomSet2DSurvey.r_survey_envr_kd, OpenWorks_SM.SeisGeomSet2DSurvey.geop_acq_area_nm, OpenWorks_SM.SeisGeomSet2DSurvey.county_nm, OpenWorks_SM.SeisGeomSet2DSurvey.state_nm, OpenWorks_SM.SeisGeomSet2DSurvey.country_nm, OpenWorks_SM.SeisGeomSet2DSurvey.acq_crew, OpenWorks_SM.SeisGeomSet2DSurvey.acq_survey, OpenWorks_SM.SeisGeomSet2DSurvey.vert_mclos_fact, OpenWorks_SM.SeisGeomSet2DSurvey.vert_mclos_fact_dsdsunit, OpenWorks_SM.SeisGeomSet2DSurvey.horz_mclos_fact, OpenWorks_SM.SeisGeomSet2DSurvey.horz_mclos_fact_dsdsunit, OpenWorks_SM.SeisGeomSet2DSurvey.azm_mclos_fact, OpenWorks_SM.SeisGeomSet2DSurvey.azm_mclos_fact_dsdsunit, OpenWorks_SM.SeisGeomSet2DSurvey.remark) VALUES (VARIABLES.seis_geom_set_id, SUBSTRING("NEW".seismic_survey_name, 1, 40), SUBSTRING("NEW".data_source, 1, 5), SUBSTRING("NEW".acquired_by, 1, 40), SUBSTRING("NEW".acquired_for, 1, 40), "NEW".acquisition_start_date, "NEW".acquisition_end_date, "NEW".acquisition_cost, SUBSTRING("NEW".currency, 1, 24), SUBSTRING("NEW".survey_environment_kind, 1, 40), SUBSTRING("NEW".acquisition_area_name, 1, 40), SUBSTRING("NEW".county_name, 1, 25), SUBSTRING("NEW".state_name, 1, 20), SUBSTRING("NEW".country_name, 25), SUBSTRING("NEW".acquisition_crew, 1, 80), SUBSTRING("NEW".acquisition_survey, 1, 40), "NEW".vertical_misclosure_factor, SUBSTRING("NEW".vertical_misclosure_factor_unit, 1, 64), "NEW".horizontal_misclosure_factor, SUBSTRING("NEW".horizontal_misclosure_factor_unit, 1, 64), "NEW".azimuth_misclosure_factor, SUBSTRING("NEW".azimuth_misclosure_factor_unit, 1, 64), SUBSTRING("NEW".remark, 1, 200));
END;

     CREATE TRIGGER ON Seismic2DSurvey INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC
    DECLARE string VARIABLES.seis_geom_set_id = (SELECT seis_geom_set_id FROM OpenWorks_SM.SeisGeomSet2DSurvey WHERE (seis_geom_set_nm = "OLD".seismic_survey_name));
    UPDATE OpenWorks_SM.SeisGeomSet2DSurvey SET data_source = SUBSTRING("NEW".data_source, 1, 5),acquired_by = SUBSTRING("NEW".acquired_by, 1, 40), acquired_for = SUBSTRING("NEW".acquired_for, 1, 40),acq_start_date = "NEW".acquisition_start_date, acq_end_date = "NEW".acquisition_end_date, acq_cost = "NEW".acquisition_cost,currency = SUBSTRING("NEW".currency, 1, 24), r_survey_envr_kd = SUBSTRING("NEW".survey_environment_kind, 1, 40), geop_acq_area_nm = SUBSTRING("NEW".acquisition_area_name, 1, 40), county_nm = SUBSTRING("NEW".county_name, 1, 25), state_nm = SUBSTRING("NEW".state_name, 1, 20), country_nm = SUBSTRING("NEW".country_name,1, 25),acq_crew = SUBSTRING("NEW".acquisition_crew, 1, 80), acq_survey = SUBSTRING("NEW".acquisition_survey, 1, 40), vert_mclos_fact = "NEW".vertical_misclosure_factor, vert_mclos_fact_dsdsunit = SUBSTRING("NEW".vertical_misclosure_factor_unit, 1, 64), horz_mclos_fact = "NEW".horizontal_misclosure_factor, horz_mclos_fact_dsdsunit = SUBSTRING("NEW".horizontal_misclosure_factor_unit, 1, 64), azm_mclos_fact = "NEW".azimuth_misclosure_factor, azm_mclos_fact_dsdsunit = SUBSTRING("NEW".azimuth_misclosure_factor_unit, 1, 64), remark = SUBSTRING("NEW".remark, 1, 200) WHERE OpenWorks_SM.SeisGeomSet2DSurvey.seis_geom_set_id=VARIABLES.seis_geom_set_id;
END;

/*
**********************************
*     "Seis2DLine"
**********************************
*/

CREATE VIEW Seis2DLine
(
  native_uid                  VARCHAR(1024)   OPTIONS("OpenWorksCommonModel:Seis2DLine.native_uid.isUpdatable" false,
                                                        "OpenWorksCommonModel:Seis2DLine.native_uid.isCreatable" false,
                                                        UPDATABLE 'FALSE'),
  seismic_line_name         VARCHAR(40) NOT NULL,
  seismic2dsurvey_native_uid  VARCHAR(1024) NOT NULL,
  seismic_survey_name       VARCHAR(40) OPTIONS("OpenWorksCommonModel:Seis2DLine.seismic_survey_name.isUpdatable" false,
                                                        "OpenWorksCommonModel:Seis2DLine.seismic_survey_name.isCreatable" false,
                                                        UPDATABLE 'FALSE'),
  binset_grid_id            INTEGER,
  data_source               VARCHAR(5),
  seis2d_unique_line_id     VARCHAR(30), /* This is a NULLABLE field in Common Model 1.6*/
  ll_crnr_x                 DOUBLE,
  ll_crnr_y                 DOUBLE,
  ur_crnr_x                 DOUBLE,
  ur_crnr_y                 DOUBLE,
  opt_bbox_ll_x             DOUBLE,
  opt_bbox_ll_y             DOUBLE,
  opt_bbox_ul_x             DOUBLE,
  opt_bbox_ul_y             DOUBLE,
  opt_bbox_lr_x             DOUBLE,
  opt_bbox_lr_y             DOUBLE,
  opt_bbox_ur_x             DOUBLE,
  opt_bbox_ur_y             DOUBLE,
  decimation_tolerance      FLOAT,
  decimation_indicator      INTEGER,
  restricted_data_ind       VARCHAR(1),
  overall_min_trace         INTEGER,
  overall_max_trace         INTEGER,
  trimmed_min_trace         INTEGER,
  trimmed_max_trace         INTEGER,
  num_shotpoints            INTEGER,
  shotpoints                blob
                                        OPTIONS ("OpenWorksCommonModel:Seis2DLine.shotpoints.isComplexType" true,
                                                 "OpenWorksCommonModel:Seis2DLine.shotpoints.isComplexTypeArray" true,
                                                 "OpenWorksCommonModel:Seis2DLine.shotpoints.elementType" 'Shotpoint',
                                                 "OpenWorksCommonModel:Seis2DLine.shotpoints.elementStruct" '[{"name":"shotpoint","type":"float[]"},{"name":"x","type":"double[]"},{"name":"y","type":"double[]"}]'),
  num_orig_shotpoints       integer,
  orig_shotpoints           blob
                                        OPTIONS ("OpenWorksCommonModel:Seis2DLine.orig_shotpoints.isComplexType" true,
                                                 "OpenWorksCommonModel:Seis2DLine.orig_shotpoints.isComplexTypeArray" true,
                                                 "OpenWorksCommonModel:Seis2DLine.orig_shotpoints.elementType" 'Shotpoint',
                                                 "OpenWorksCommonModel:Seis2DLine.orig_shotpoints.elementStruct" '[{"name":"shotpoint","type":"float[]"},{"name":"x","type":"double[]"},{"name":"y","type":"double[]"}]'),
  orig_shotpoints_xy_unit   VARCHAR(64) ,
  z_datum                   FLOAT       OPTIONS ("OpenWorksCommonModel:Seis2DLine.z_datum.unitField" 'z_datum_unit'),
  z_datum_unit              VARCHAR(64) OPTIONS ("OpenWorksCommonModel:Seis2DLine.z_datum_unit.unitType" 'elevation'),
  orig_shotpoints_crs       VARCHAR(80),
  num_mappings              INTEGER,
  mappings                  blob
                                        OPTIONS ("OpenWorksCommonModel:Seis2DLine.mappings.isComplexType" true,
                                                 "OpenWorksCommonModel:Seis2DLine.mappings.isComplexTypeArray" true,
                                                 "OpenWorksCommonModel:Seis2DLine.mappings.elementType" 'ShptTraceMap',
                                                 "OpenWorksCommonModel:Seis2DLine.mappings.elementStruct" '[{"name":"shotpoint","type":"float[]"},{"name":"trace","type":"float[]"}]'),
  directory_name            VARCHAR(40) DEFAULT 'mfl2d',
  remark                    VARCHAR(200),
   spatial                          BLOB        OPTIONS ("OpenWorksCommonModel:Seis2DLine.spatial.isSpatial" true,
                                                  "OpenWorksCommonModel:Seis2DLine.spatial.isCreatable" false,
                                                  "OpenWorksCommonModel:Seis2DLine.spatial.isUpdatable" false,
                                                  UPDATABLE 'FALSE',
                                                  "OpenWorksCommonModel:Seis2DLine.spatial.isComplexType" true,
                                                  "OpenWorksCommonModel:Seis2DLine.spatial.isComplexTypeArray" false,
                                                  "OpenWorksCommonModel:Seis2DLine.spatial.elementType" 'LINESTRINGZM',
                                                  "OpenWorksCommonModel:Seis2DLine.spatial.elementStruct" '[{"name":"x","type":"double"},{"name":"y","type":"double"},{"name":"z","type":"double"},{"name":"m","type":"double"}]'),
  create_date               TIMESTAMP   OPTIONS("OpenWorksCommonModel:Seis2DLine.create_date.isUpdatable" false,
                                                "OpenWorksCommonModel:Seis2DLine.create_date.isCreatable" false,UPDATABLE 'FALSE'),
  create_user_id            VARCHAR(32) OPTIONS("OpenWorksCommonModel:Seis2DLine.create_user_id.isUpdatable" false,
                                                "OpenWorksCommonModel:Seis2DLine.create_user_id.isCreatable" false,UPDATABLE 'FALSE'),
  update_date               TIMESTAMP   OPTIONS("OpenWorksCommonModel:Seis2DLine.update_date.isUpdatable" false,
                                                "OpenWorksCommonModel:Seis2DLine.update_date.isCreatable" false,UPDATABLE 'FALSE'),
  update_user_id            VARCHAR(32) OPTIONS("OpenWorksCommonModel:Seis2DLine.update_user_id.isUpdatable" false,
                                                "OpenWorksCommonModel:Seis2DLine.update_user_id.isCreatable" false,UPDATABLE 'FALSE'),
  alternate_uid    		         VARCHAR(4000)    OPTIONS ("OpenWorksCommonModel:Seis2DLine.alternate_uid.isCreatable" false,
                                                       "OpenWorksCommonModel:Seis2DLine.alternate_uid.isUpdatable" false,
                                                        UPDATABLE 'FALSE'),


    CONSTRAINT Seis2DLine_PK PRIMARY KEY (native_uid),

    CONSTRAINT Seis2DLine_UK1 UNIQUE (seismic2dsurvey_native_uid, seismic_line_name),

    CONSTRAINT FK_Seis2DLine_seismic2dsurvey_native_uid
        FOREIGN KEY                (seismic2dsurvey_native_uid)
        REFERENCES Seismic2DSurvey (native_uid),

    CONSTRAINT FK_Seis2DLine_data_source
        FOREIGN KEY (data_source)
        REFERENCES DataSource(name)

)
OPTIONS (UPDATABLE 'TRUE', Seis2DLine.IMPLEMENTED 'TRUE')
AS
SELECT
 OpenWorks_SM.Seis2DLine.seis_geom_set_id AS native_uid,
 OpenWorks_SM.Seis2DLine.seis_geom_set_nm AS seismic_line_name,
 OpenWorks_SM.SeisGeomSet2DSurvey.seis_geom_set_id,
 OpenWorks_SM.SeisGeomSet2DSurvey.seis_geom_set_nm AS seismic_survey_name,
 cast(OpenWorks_SM.Seis2DLine.binset_grid_id AS integer),
 OpenWorks_SM.Seis2DLine.data_source,
 OpenWorks_SM.Seis2DLine.seis2d_unique_line_id,
 OpenWorks_SM.Seis2DLine.ll_crnr_x,
 OpenWorks_SM.Seis2DLine.ll_crnr_y,
 OpenWorks_SM.Seis2DLine.ur_crnr_x,
 OpenWorks_SM.Seis2DLine.ur_crnr_y,
 OpenWorks_SM.Seis2DLine.opt_bbox_ll_x,
 OpenWorks_SM.Seis2DLine.opt_bbox_ll_y,
 OpenWorks_SM.Seis2DLine.opt_bbox_ul_x,
 OpenWorks_SM.Seis2DLine.opt_bbox_ul_y,
 OpenWorks_SM.Seis2DLine.opt_bbox_lr_x,
 OpenWorks_SM.Seis2DLine.opt_bbox_lr_y,
 OpenWorks_SM.Seis2DLine.opt_bbox_ur_x,
 OpenWorks_SM.Seis2DLine.opt_bbox_ur_y,
 OpenWorks_SM.Seis2DLine.decimation_tolerance,
 OpenWorks_SM.Seis2DLine.decimation_indicator,
 OpenWorks_SM.Seis2DLine.restricted_data_ind,
 OpenWorks_SM.Seis2DLine.overall_min_trace,
 OpenWorks_SM.Seis2DLine.overall_max_trace,
 OpenWorks_SM.Seis2DLine.trimmed_min_trace,
 OpenWorks_SM.Seis2DLine.trimmed_max_trace,
 OpenWorks_SM.Seis2DLine.num_shotpoints,
 OpenWorks_SM.Seis2DLine.shotpoints,
 OpenWorks_SM.Seis2DLine.num_orig_shotpoints,
 orig_shotpoints,
 OpenWorks_SM.Seis2DLine.ll_crnr_x_dsdsunit AS orig_shotpoints_xy_unit,
 OpenWorks_SM.Seis2DLine.z_datum,
 OpenWorks_SM.Seis2DLine.z_datum_dsdsunit,
 OpenWorks_SM.CartoRefSys.name AS orig_shotpoints_crs,
 OpenWorks_SM.Seis2DLine.num_mappings,
 mappings,
 OpenWorks_SM.Seis2DLine.directory_name,
 OpenWorks_SM.Seis2DLine.remark,
 OpenWorks_SM.Seis2DLine.spatial,
 OpenWorks_SM.Seis2DLine.create_date,
 OpenWorks_SM.Seis2DLine.create_user_id,
 OpenWorks_SM.Seis2DLine.update_date,
 OpenWorks_SM.Seis2DLine.update_user_id,
 OpenWorks_SM.Seis2DLine.native_uid AS alternate_uid
    FROM
        (OpenWorks_SM.Seis2DLine LEFT OUTER JOIN OpenWorks_SM.SeisGeomSet2DSurvey ON OpenWorks_SM.Seis2DLine.component_geom_id = OpenWorks_SM.SeisGeomSet2DSurvey.seis_geom_set_id) LEFT OUTER JOIN OpenWorks_SM.CartoRefSys ON OpenWorks_SM.Seis2DLine.orig_shotpoints_crs_id = OpenWorks_SM.CartoRefSys.id;

CREATE TRIGGER ON Seis2DLine INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC
    DECLARE integer VARIABLES.seis_geom_set_id = (SELECT * FROM (EXEC OpenWorks_SM.nextval('Seis2DLine')) AS SysGenID);
    DECLARE string VARIABLES.component_geom_id = (SELECT OpenWorks_SM.SeisGeomSet2DSurvey.seis_geom_set_id FROM OpenWorks_SM.SeisGeomSet2DSurvey WHERE OpenWorks_SM.SeisGeomSet2DSurvey.seis_geom_set_id ="NEW".seismic2dsurvey_native_uid);
    DECLARE string VARIABLES.orig_shotpoints_crs_id;
    DECLARE string VARIABLES.crs_errorMsg='ERROR: The given crs value does not exist';
        IF("NEW".orig_shotpoints_crs IS NOT NULL)
        BEGIN
            VARIABLES.orig_shotpoints_crs_id  = (SELECT id FROM OpenWorks_SM.CartoRefSys WHERE name = (SELECT * FROM (EXEC OpenWorks_SM.GetNativeCRS("NEW".orig_shotpoints_crs,'OW')) AS SysGenID));
                IF (VARIABLES.orig_shotpoints_crs_id  is NULL)
                    ERROR VARIABLES.crs_errorMsg;
        END


    INSERT INTO OpenWorks_SM.Seis2DLine (OpenWorks_SM.Seis2DLine.seis_geom_set_id, OpenWorks_SM.Seis2DLine.seis_geom_set_nm, OpenWorks_SM.Seis2DLine.component_geom_id, OpenWorks_SM.Seis2DLine.binset_grid_id, OpenWorks_SM.Seis2DLine.data_source, OpenWorks_SM.Seis2DLine.seis2d_unique_line_id, OpenWorks_SM.Seis2DLine.ll_crnr_x, OpenWorks_SM.Seis2DLine.ll_crnr_y, OpenWorks_SM.Seis2DLine.ur_crnr_x, OpenWorks_SM.Seis2DLine.ur_crnr_y, OpenWorks_SM.Seis2DLine.opt_bbox_ll_x, OpenWorks_SM.Seis2DLine.opt_bbox_ll_y, OpenWorks_SM.Seis2DLine.opt_bbox_ul_x, OpenWorks_SM.Seis2DLine.opt_bbox_ul_y, OpenWorks_SM.Seis2DLine.opt_bbox_lr_x, OpenWorks_SM.Seis2DLine.opt_bbox_lr_y, OpenWorks_SM.Seis2DLine.opt_bbox_ur_x, OpenWorks_SM.Seis2DLine.opt_bbox_ur_y, OpenWorks_SM.Seis2DLine.decimation_tolerance, OpenWorks_SM.Seis2DLine.decimation_indicator, OpenWorks_SM.Seis2DLine.restricted_data_ind, OpenWorks_SM.Seis2DLine.overall_min_trace, OpenWorks_SM.Seis2DLine.overall_max_trace, OpenWorks_SM.Seis2DLine.trimmed_min_trace, OpenWorks_SM.Seis2DLine.trimmed_max_trace, OpenWorks_SM.Seis2DLine.num_shotpoints, OpenWorks_SM.Seis2DLine.shotpoints, OpenWorks_SM.Seis2DLine.num_orig_shotpoints, OpenWorks_SM.Seis2DLine.orig_shotpoints, OpenWorks_SM.Seis2DLine.z_datum, OpenWorks_SM.Seis2DLine.z_datum_dsdsunit, OpenWorks_SM.Seis2DLine.orig_shotpoints_crs_id, OpenWorks_SM.Seis2DLine.num_mappings, OpenWorks_SM.Seis2DLine.mappings, OpenWorks_SM.Seis2DLine.directory_name, OpenWorks_SM.Seis2DLine.remark) VALUES (VARIABLES.seis_geom_set_id, SUBSTRING("NEW".seismic_line_name, 1, 40), VARIABLES.component_geom_id, "NEW".binset_grid_id, SUBSTRING("NEW".data_source, 1, 5), SUBSTRING("NEW".seis2d_unique_line_id, 1, 30), "NEW".ll_crnr_x, "NEW".ll_crnr_y, "NEW".ur_crnr_x, "NEW".ur_crnr_y, "NEW".opt_bbox_ll_x, "NEW".opt_bbox_ll_y, "NEW".opt_bbox_ul_x, "NEW".opt_bbox_ul_y, "NEW".opt_bbox_lr_x, "NEW".opt_bbox_lr_y, "NEW".opt_bbox_ur_x, "NEW".opt_bbox_ur_y, "NEW".decimation_tolerance, "NEW".decimation_indicator, SUBSTRING("NEW".restricted_data_ind, 1, 1), "NEW".overall_min_trace, "NEW".overall_max_trace, "NEW".trimmed_min_trace, "NEW".trimmed_max_trace, "NEW".num_shotpoints, "NEW".shotpoints, "NEW".num_orig_shotpoints, "NEW".orig_shotpoints, "NEW".z_datum, SUBSTRING("NEW".z_datum_unit, 1, 64), VARIABLES.orig_shotpoints_crs_id, "NEW".num_mappings, "NEW".mappings, SUBSTRING("NEW".directory_name, 1, 40), SUBSTRING("NEW".remark, 1, 200));
END;

CREATE TRIGGER ON Seis2DLine INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC
    DECLARE string VARIABLES.seis_geom_set_id = (SELECT OpenWorks_SM.Seis2DLine.seis_geom_set_id FROM OpenWorks_SM.Seis2DLine WHERE OpenWorks_SM.Seis2DLine.seis_geom_set_nm = "OLD".seismic_line_name);

    DECLARE string VARIABLES.orig_shotpoints_crs_id;
    DECLARE string VARIABLES.crs_errorMsg='ERROR: The given crs value does not exist';
        IF("NEW".orig_shotpoints_crs IS NOT NULL)
        BEGIN
            VARIABLES.orig_shotpoints_crs_id  = (SELECT id FROM OpenWorks_SM.CartoRefSys WHERE name = (SELECT * FROM (EXEC OpenWorks_SM.GetNativeCRS("NEW".orig_shotpoints_crs,'OW')) AS SysGenID));
                IF (VARIABLES.orig_shotpoints_crs_id  is NULL)
                    ERROR VARIABLES.crs_errorMsg;
        END

    UPDATE OpenWorks_SM.Seis2DLine SET seis_geom_set_nm = SUBSTRING("NEW".seismic_line_name, 1, 40), binset_grid_id = "NEW".binset_grid_id, data_source = SUBSTRING("NEW".data_source, 1, 5), seis2d_unique_line_id = SUBSTRING("NEW".seis2d_unique_line_id, 1, 30), ll_crnr_x = "NEW".ll_crnr_x, ll_crnr_y = "NEW".ll_crnr_y, ur_crnr_x = "NEW".ur_crnr_x, ur_crnr_y = "NEW".ur_crnr_y, opt_bbox_ll_x = "NEW".opt_bbox_ll_x, opt_bbox_ll_y = "NEW".opt_bbox_ll_y, opt_bbox_ul_x = "NEW".opt_bbox_ul_x, opt_bbox_ul_y = "NEW".opt_bbox_ul_y, opt_bbox_lr_x = "NEW".opt_bbox_lr_x, opt_bbox_lr_y = "NEW".opt_bbox_lr_y, opt_bbox_ur_x = "NEW".opt_bbox_ur_x, opt_bbox_ur_y = "NEW".opt_bbox_ur_y, decimation_tolerance = "NEW".decimation_tolerance, decimation_indicator = "NEW".decimation_indicator, restricted_data_ind = SUBSTRING("NEW".restricted_data_ind, 1, 1), overall_min_trace = "NEW".overall_min_trace, overall_max_trace = "NEW".overall_max_trace, trimmed_min_trace = "NEW".trimmed_min_trace, trimmed_max_trace = "NEW".trimmed_max_trace, num_shotpoints = "NEW".num_shotpoints, shotpoints = "NEW".shotpoints, num_orig_shotpoints = "NEW".num_orig_shotpoints, orig_shotpoints = "NEW".orig_shotpoints, z_datum = "NEW".z_datum, z_datum_dsdsunit = SUBSTRING("NEW".z_datum_unit, 1, 64), orig_shotpoints_crs_id = VARIABLES.orig_shotpoints_crs_id, num_mappings = "NEW".num_mappings, mappings ="NEW".mappings, directory_name = SUBSTRING("NEW".directory_name, 1, 40), remark = SUBSTRING("NEW".remark, 1, 200) WHERE OpenWorks_SM.Seis2DLine.seis_geom_set_id = VARIABLES.seis_geom_set_id;
END;

/*
**********************************
* ENTITY: SeismicDataSet2D
**********************************
*/
CREATE VIEW SeismicDataSet2D
(
	native_uid                      VARCHAR(1024)               OPTIONS("OpenWorksCommonModel:SeismicDataSet2D.native_uid.isUpdatable" false,
                                                                        "OpenWorksCommonModel:SeismicDataSet2D.native_uid.isCreatable" false,
                                                                        UPDATABLE 'FALSE'),
    seismic2dline_native_uid        VARCHAR(1024),
    seismic_data_set_name           VARCHAR(256) NOT NULL,
    seismic_version_name            VARCHAR(40),
    data_source                     VARCHAR(5),
    seismic_attribute_name          VARCHAR(40),
    interpretation_status           VARCHAR(12),
    seismic_class                   VARCHAR(12),
    attribute_unit                   VARCHAR(12),
    acquired_by                     VARCHAR(40),
    acquisition_date                TIMESTAMP,
    data_file_name                  VARCHAR(50) NOT NULL,
    data_file_format                VARCHAR(12),
    binary_data_format              VARCHAR(24),
    start_trace                     DOUBLE,
    end_trace                       DOUBLE,
    num_traces                      INTEGER,
    min_amplitude                   DOUBLE,
    min_amplitude_unit              VARCHAR(64),
    max_amplitude                   DOUBLE,
    max_amplitude_unit              VARCHAR(64),
    polarity                        VARCHAR(40) DEFAULT 'UNKNOWN',
    processed_by                    VARCHAR(40),
    processed_date                  TIMESTAMP,
    total_size                      DOUBLE,
    total_size_unit                 VARCHAR(64),
    z_domain                        VARCHAR(12),
    z_start                         DOUBLE,
    z_start_unit                    VARCHAR(64),
    z_start_unittype                VARCHAR(64),
    z_start_actual                  DOUBLE,
    z_start_actual_unit             VARCHAR(64),
    z_start_actual_unittype         VARCHAR(64),
    z_sample_rate                   DOUBLE,
    z_sample_rate_unit              VARCHAR(64),
    z_sample_rate_unittype          VARCHAR(64),
    z_npts                          INTEGER,
    z_npts_actual                   INTEGER,
    data                            BLOB          NOT NULL      OPTIONS ("OpenWorksCommonModel:SeismicDataSet2D.data.isMedia" 'true',
                                                                         "OpenWorksCommonModel:SeismicDataSet2D.data.mediaContentType" 'application/octet-stream'),
    remark                          VARCHAR(200),
    create_date                     TIMESTAMP,
    create_user_id                  VARCHAR(32),
    update_date                     TIMESTAMP,
    update_user_id                  VARCHAR(32),
    alternate_uid    		                VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:SeismicDataSet2D.alternate_uid.isCreatable" false,
                                                           "OpenWorksCommonModel:SeismicDataSet2D.alternate_uid.isUpdatable" false,
                                                            UPDATABLE 'FALSE'),

    CONSTRAINT SeismicDataSet2D_PK PRIMARY KEY (native_uid),

    CONSTRAINT SeismicDataSet2D_UK1 UNIQUE (seismic_data_set_name,seismic_version_name,seismic2dline_native_uid),

    CONSTRAINT FK_SeismicDataSet2D_seismic2dline_native_uid
    FOREIGN KEY          (seismic2dline_native_uid)
    REFERENCES Seis2DLine(native_uid)
)
OPTIONS (UPDATABLE 'TRUE', SeismicDataSet2D.IMPLEMENTED 'TRUE')
    AS
    SELECT
        seismic_data_set_id                        AS native_uid,
        seis_geom_set_id                           AS seismic2dline_native_uid,
        seis_data_set_name                         AS seismic_data_set_name,
        seismic_version_name                       AS seismic_version_name,
        data_source                                AS data_source,
        r_seis_attr_nm                             AS seismic_attribute_name,
        interpretation_status                      AS interpretation_status,
        seismic_class                              AS seismic_class,
        attribute_uom                              AS attribute_unit,
        acquired_by                                AS acquired_by,
        acquisition_date                           AS acquisition_date,
        data_file_name                             AS data_file_name,
        data_file_format                           AS data_file_format,
        binary_data_format                         AS binary_data_format,
        trace_min                                  AS start_trace,
        trace_max                                  AS end_trace,
        COALESCE(num_traces,
        CAST((trace_max-trace_min+1)  AS integer)) AS num_traces,
        min                                        AS min_amplitude,
        min_dsdsunit                               AS min_amplitude_unit,
        max                                        AS max_amplitude,
        max_dsdsunit                               AS max_amplitude_unit,
        polarity                                   AS polarity,
        processed_by                               AS processed_by,
        processed_date                             AS processed_date,
        total_size                                 AS total_size,
        total_size_dsdsunit                        AS total_size_unit,
        z_domain                                   AS z_domain,
        z_start                                    AS z_start,
        z_start_dsdsunit                           AS z_start_unit,
        z_start_dsdsunittype                       AS z_start_unittype,
        z_start_actual                             AS z_start_actual,
        z_start_actual_dsdsunit                    AS z_start_actual_unit,
        z_start_actual_dsdsunittype                AS z_start_actual_unittype,
        z_sample_rate                              AS z_sample_rate,
        z_sample_rate_dsdsunit                     AS z_sample_rate_unit,
        z_sample_rate_dsdsunittype                 AS z_sample_rate_unittype,
        z_npts                                     AS z_npts,
        z_npts_actual                              AS z_npts_actual,
        data                                       AS data,
        remark                                     AS remark,
        create_date                                AS create_date,
        create_user_id                             AS create_user_id,
        update_date                                AS update_date,
        update_user_id                             AS update_user_id,
	    native_uid                                 AS alternate_uid

    FROM OpenWorks_SM.SeismicDataSet where geom_set_type = '2D Line';

Create Trigger on SeismicDataSet2D INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC

    DECLARE string     VARIABLES.geom_set_type                =    '2D Line';

    INSERT into OpenWorks_SM.SeismicDataSet ("seis_geom_set_id","seis_data_set_name","seismic_version_name","geom_set_type","data_file_name","binary_data_format","data_file_format","polarity","z_domain",
    "z_start","z_start_dsdsunit","z_npts","z_sample_rate","z_sample_rate_dsdsunit","data_source","data")

    VALUES ("NEW".seismic2dline_native_uid,"NEW".seismic_data_set_name,"NEW".seismic_version_name,VARIABLES.geom_set_type,"NEW".data_file_name,"NEW".binary_data_format,"NEW".data_file_format,"NEW".polarity,"NEW".z_domain,"NEW".z_start,"NEW".z_start_unit,"NEW".z_npts,"NEW".z_sample_rate,"NEW".z_sample_rate_unit,"NEW".data_source,"NEW".data);

    --set the remark

    update OpenWorks_SM.SeismicDataSet
    set remark = "NEW".remark where
    seis_data_set_name = "NEW".seismic_data_set_name and
    seis_geom_set_id   = "NEW".seismic2dline_native_uid and
    seismic_version_name = "NEW".seismic_version_name;

END;

Create Trigger on SeismicDataSet2D INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC

    DECLARE string     VARIABLES.geom_set_type                =    '2D Line';

    UPDATE OpenWorks_SM.SeismicDataSet SET

    "geom_set_type"                 =    VARIABLES.geom_set_type,
    "data_file_name"                =    "OLD".data_file_name,
    "binary_data_format"            =    "NEW".binary_data_format,
    "data_file_format"              =    "NEW".data_file_format,
    "polarity"                      =    "NEW".polarity,
    "z_domain"                      =    "NEW".z_domain,
    "z_start"                       =    "NEW".z_start,
    "z_start_dsdsunit"              =    "NEW".z_start_unit,
    "z_npts"                        =    "NEW".z_npts,
    "z_sample_rate"                 =    "NEW".z_sample_rate,
    "z_sample_rate_dsdsunit"        =    "NEW".z_sample_rate_unit,
    "data_source"                   =    "NEW".data_source,
    "data"                          =    "NEW".data,
	"seismic_version_name"          =    "OLD".seismic_version_name,
	"remark"                        =    "NEW".remark

    WHERE  OpenWorks_SM.SeismicDataSet.seismic_data_set_id="OLD".native_uid;

END;

Create Trigger on SeismicDataSet2D INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC
DELETE from OpenWorks_SM.SeismicDataSet WHERE  OpenWorks_SM.SeismicDataSet.seismic_data_set_id="OLD".native_uid;

END;

/*
**********************************
*     "HorizonData2D"
**********************************
*/
CREATE VIEW HorizonData2D
(
  native_uid                  VARCHAR(1024)   OPTIONS ("OpenWorksCommonModel:HorizonData2D.native_uid.isUpdatable" false,
                                                       "OpenWorksCommonModel:HorizonData2D.native_uid.isCreatable" false,
                                                       UPDATABLE 'FALSE'),
  horizon_name                VARCHAR(60)   NOT NULL,
  data_source                 VARCHAR(5)    NOT NULL,
  horizon_attribute_name      VARCHAR(40)   NOT NULL,
  interpretation_version_name VARCHAR(40)   NOT NULL,
  seismicdataset2d_native_uid VARCHAR(1024),
  seis2dline_native_uid       VARCHAR(1024)   NOT NULL,
  seismic_survey_name         VARCHAR(40)     OPTIONS ("OpenWorksCommonModel:HorizonData2D.seismic_survey_name.isUpdatable" false,
                                                       "OpenWorksCommonModel:HorizonData2D.seismic_survey_name.isCreatable" false,
                                                       UPDATABLE 'FALSE'),
  seismic_line_name           VARCHAR(40)     OPTIONS ("OpenWorksCommonModel:HorizonData2D.seismic_line_name.isUpdatable" false,
                                                       "OpenWorksCommonModel:HorizonData2D.seismic_line_name.isCreatable" false,
                                                        UPDATABLE 'FALSE'),
  interpretation_status       VARCHAR(12)     DEFAULT 'UNKNOWN',
  horizon_class               VARCHAR(4000),
  pick_surface_name           VARCHAR(4000),
  seis_pick_onset             VARCHAR(4000),
  line_style                  INTEGER,
  line_weight                 INTEGER,
  line_color                  INTEGER,
  line_color_r                INTEGER,
  line_color_g                INTEGER,
  line_color_b                INTEGER,
  horizon_alias               VARCHAR(60),
  horizon_mean                DOUBLE          OPTIONS ("OpenWorksCommonModel:HorizonData2D.horizon_mean.unitField" 'horizon_mean_unit'),
  horizon_mean_unit           VARCHAR(4000)   OPTIONS ("OpenWorksCommonModel:HorizonData2D.horizon_mean_unit.unitTypeAttribute" 'unit_type'),
  horizon_min                 DOUBLE          OPTIONS ("OpenWorksCommonModel:HorizonData2D.horizon_min.unitField" 'horizon_min_unit'),
  horizon_min_unit            VARCHAR(4000)   OPTIONS ("OpenWorksCommonModel:HorizonData2D.horizon_min_unit.unitTypeAttribute" 'unit_type'),
  horizon_max                 DOUBLE          OPTIONS ("OpenWorksCommonModel:HorizonData2D.horizon_max.unitField" 'horizon_max_unit'),
  horizon_max_unit            VARCHAR(4000)   OPTIONS ("OpenWorksCommonModel:HorizonData2D.horizon_max_unit.unitTypeAttribute" 'unit_type'),
  horizon_min_trace           INTEGER,
  horizon_max_trace           INTEGER,
  name_of_data_repository     VARCHAR(40),
  percent_coverage            DOUBLE          OPTIONS ("OpenWorksCommonModel:HorizonData2D.percent_coverage.unitField" 'percent_coverage_unit'),
  percent_coverage_unit       VARCHAR(64)     OPTIONS ("OpenWorksCommonModel:HorizonData2D.percent_coverage_unit.unitType" 'percent'),
  total_samples               INTEGER         DEFAULT '0',
  datum                       FLOAT           OPTIONS ("OpenWorksCommonModel:HorizonData2D.datum.unitField" 'z_datum_unit'),
  z_datum_unit                VARCHAR(64)     OPTIONS ("OpenWorksCommonModel:HorizonData2D.z_datum_unit.unitType" 'elevation'),
  data_domain                 VARCHAR(12),
  z_domain_qualifier          VARCHAR(24),
  data                        BLOB
                                              OPTIONS ("OpenWorksCommonModel:HorizonData2D.data.elementType"       'arrayfloat',
                                                       "OpenWorksCommonModel:HorizonData2D.data.isPrimitiveArray"  'true',
                                                       "OpenWorksCommonModel:HorizonData2D.data.unitField"         'data_unit'),

  data_unit                   VARCHAR(4000)   OPTIONS ("OpenWorksCommonModel:HorizonData2D.data_unit.unitTypeAttribute" 'unit_type'),
  unit_type                   VARCHAR(4000),
  original_create_date        TIMESTAMP,
  remark                      VARCHAR(200),
  create_date                 TIMESTAMP        OPTIONS("OpenWorksCommonModel:HorizonData2D.create_date.isUpdatable" false,
                                                       "OpenWorksCommonModel:HorizonData2D.create_date.isCreatable" false,
                                                       UPDATABLE 'FALSE'),
  create_user_id              VARCHAR(32)      OPTIONS("OpenWorksCommonModel:HorizonData2D.create_user_id.isUpdatable" false,
                                                       "OpenWorksCommonModel:HorizonData2D.create_user_id.isCreatable" false,
                                                       UPDATABLE 'FALSE'),
  update_date                 TIMESTAMP        OPTIONS("OpenWorksCommonModel:HorizonData2D.update_date.isUpdatable" false,
                                                       "OpenWorksCommonModel:HorizonData2D.update_date.isCreatable" false,
                                                       UPDATABLE 'FALSE'),
  update_user_id              VARCHAR(32)      OPTIONS("OpenWorksCommonModel:HorizonData2D.update_user_id.isUpdatable" false,
                                                       "OpenWorksCommonModel:HorizonData2D.update_user_id.isCreatable" false,
                                                       UPDATABLE 'FALSE'),
  alternate_uid    		          VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:HorizonData2D.alternate_uid.isCreatable" false,
                                                     "OpenWorksCommonModel:HorizonData2D.alternate_uid.isUpdatable" false,
                                                      UPDATABLE 'FALSE'),

    CONSTRAINT HorizonData2D_PK PRIMARY KEY (native_uid),

    CONSTRAINT HorizonData2D_UK1 UNIQUE (horizon_name, data_source, horizon_attribute_name, interpretation_version_name, seis2dline_native_uid),

    CONSTRAINT FK_HorizonData2D_seis2dline_native_uid
        FOREIGN KEY          (seis2dline_native_uid)
        REFERENCES Seis2DLine(native_uid),

    CONSTRAINT FK_HorizonData2D_seismicdataset2d_native_uid
        FOREIGN KEY                (seismicdataset2d_native_uid)
        REFERENCES SeismicDataSet2D(native_uid),

    CONSTRAINT FK_HorizonData2D_data_source
        FOREIGN KEY (data_source)
        REFERENCES DataSource(name)
)
OPTIONS (UPDATABLE 'TRUE', HorizonData2D.IMPLEMENTED 'TRUE')
AS
SELECT
    hd.horizon_data_id,
    hah.horizon_name,
    hah.data_source,
    hah.horizon_attr_name,
    hah.interpretation_version_name,
    hd.seismic_data_set_id,
    hd.seis_geom_set_id AS seis2dline_native_uid,
    survey.seis_geom_set_nm AS seismic_survey_name,
    line.seis_geom_set_nm AS seismic_line_name,
    hd.interpretation_status,
    hah.horizon_class,
    hah.pick_surf_name,
    hah.seis_pick_onset,
    hah.line_style,
    hah.line_weight,
    hah.line_color,
    hah.line_color_r,
    hah.line_color_g,
    hah.line_color_b,
    hd.horizon_alias,
    hd.horizon_mean,
    hd.horizon_mean_dsdsunit AS horizon_mean_unit,
    hd.horizon_min,
    hd.horizon_min_dsdsunit AS horizon_min_unit,
    hd.horizon_max,
    hd.horizon_max_dsdsunit AS horizon_max_unit,
    hd.horizon_min_trace,
    hd.horizon_max_trace,
    hd.name_of_data_rep,
    hd.percent_coverage,
    hd.percent_coverage_dsdsunit AS percent_coverage_unit,
    hd.total_samples,
    hd.working_datum ,
    hd.working_datum_dsdsunit ,
    hd.data_domain,
    hah.z_domain_qualifier,
    hd."values" AS data,
    hd.values_dsdsunit,
    hd.unit_type_id AS unit_type,
    hd.orig_create_date,
    hd.remark,
    hd.create_date,
    hd.create_user_id,
    hd.update_date,
    hd.update_user_id,
    hd.native_uid
    FROM
         OpenWorks_SM.HorizonData hd
         INNER JOIN OpenWorks_SM.Seis2DLine line ON hd.seis_geom_set_id =  line.seis_geom_set_id
         INNER JOIN OpenWorks_SM.SeisGeomSet2DSurvey survey ON line.component_geom_id = survey.seis_geom_set_id
         INNER JOIN OpenWorks_SM.HorizonAttributeHdr hah ON hd.horizon_attr_hdr_id = hah.horizon_attr_hdr_id
        where hah.horizon_attr_name IN ('TIME_STRUCTURE', 'DEPTH_STRUCTURE')
		AND hd.geom_set_type='2D Line';


CREATE TRIGGER ON HorizonData2D INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC

    DECLARE string VARIABLES.horizon_attr_hdr_id_errorMsg='ERROR: The HorizonAttributeHdr with given values for (horizon_name,data_source,horizon_attribute_name,interpretation_version_name) does not exist';
    DECLARE string VARIABLES.seis_geom_set_id_errorMsg='ERROR: The seis_geom_set_id with given values for (seismic_line_name,seismic_survey_name) does not exist';
    DECLARE string VARIABLES.horizon_errorMsg='ERROR: Attribute Name should be in TIME_STRUCTURE or DEPTH_STRUCTURE for base horizon';
        IF("NEW".horizon_attribute_name NOT IN('TIME_STRUCTURE', 'DEPTH_STRUCTURE'))
        BEGIN
            ERROR VARIABLES.horizon_errorMsg;
        END

    DECLARE integer VARIABLES.horizon_data_id = (SELECT * FROM (EXEC OpenWorks_SM.nextval('HorizonData')) AS SysGenID);

    DECLARE string VARIABLES.horizon_attr_hdr_id= null;

    VARIABLES.horizon_attr_hdr_id = (SELECT OpenWorks_SM.HorizonAttributeHdr.horizon_attr_hdr_id FROM OpenWorks_SM.HorizonAttributeHdr WHERE (OpenWorks_SM.HorizonAttributeHdr.horizon_name = SUBSTRING("NEW".horizon_name, 1, 60)) AND (OpenWorks_SM.HorizonAttributeHdr.data_source = SUBSTRING("NEW".data_source, 1, 5)) AND (OpenWorks_SM.HorizonAttributeHdr.horizon_attr_name = SUBSTRING("NEW".horizon_attribute_name, 1, 40)) AND (OpenWorks_SM.HorizonAttributeHdr.interpretation_version_name = SUBSTRING("NEW".interpretation_version_name, 1, 40)));

    DECLARE string VARIABLES.seis_geom_set_id = null;
    IF(VARIABLES.horizon_attr_hdr_id IS NULL)
    BEGIN
        INSERT INTO OpenWorks_SM.HorizonAttributeHdr(horizon_name, data_source, horizon_attr_name, interpretation_version_name)
         values(SUBSTRING("NEW".horizon_name, 1, 60), SUBSTRING("NEW".data_source, 1, 5), SUBSTRING("NEW".horizon_attribute_name, 1, 40), SUBSTRING("NEW".interpretation_version_name, 1, 40));

        VARIABLES.horizon_attr_hdr_id = (SELECT OpenWorks_SM.HorizonAttributeHdr.horizon_attr_hdr_id FROM OpenWorks_SM.HorizonAttributeHdr WHERE (OpenWorks_SM.HorizonAttributeHdr.horizon_name = SUBSTRING("NEW".horizon_name, 1, 60)) AND (OpenWorks_SM.HorizonAttributeHdr.data_source = SUBSTRING("NEW".data_source, 1, 5)) AND (OpenWorks_SM.HorizonAttributeHdr.horizon_attr_name = SUBSTRING("NEW".horizon_attribute_name, 1, 40)) AND (OpenWorks_SM.HorizonAttributeHdr.interpretation_version_name = SUBSTRING("NEW".interpretation_version_name, 1, 40)));

    END

    VARIABLES.seis_geom_set_id = (SELECT OpenWorks_SM.Seis2DLine.seis_geom_set_id FROM OpenWorks_SM.Seis2DLine WHERE OpenWorks_SM.Seis2DLine.seis_geom_set_id = "NEW".seis2dline_native_uid);

        IF(VARIABLES.seis_geom_set_id IS NULL)  ERROR VARIABLES.seis_geom_set_id_errorMsg;


    INSERT INTO OpenWorks_SM.HorizonData (OpenWorks_SM.HorizonData.horizon_data_id, OpenWorks_SM.HorizonData.horizon_attr_hdr_id, OpenWorks_SM.HorizonData.seismic_data_set_id, OpenWorks_SM.HorizonData.seis_geom_set_id, OpenWorks_SM.HorizonData.geom_set_type, OpenWorks_SM.HorizonData.interpretation_status, OpenWorks_SM.HorizonData.data_source, OpenWorks_SM.HorizonData.horizon_alias, OpenWorks_SM.HorizonData.horizon_mean, OpenWorks_SM.HorizonData.horizon_mean_dsdsunit, OpenWorks_SM.HorizonData.horizon_min, OpenWorks_SM.HorizonData.horizon_min_dsdsunit, OpenWorks_SM.HorizonData.horizon_max, OpenWorks_SM.HorizonData.horizon_max_dsdsunit, OpenWorks_SM.HorizonData.horizon_min_trace, OpenWorks_SM.HorizonData.horizon_max_trace, OpenWorks_SM.HorizonData.name_of_data_rep,     OpenWorks_SM.HorizonData.percent_coverage, OpenWorks_SM.HorizonData.percent_coverage_dsdsunit, OpenWorks_SM.HorizonData.total_samples, OpenWorks_SM.HorizonData.data_id, OpenWorks_SM.HorizonData.storage_datum, OpenWorks_SM.HorizonData.storage_datum_dsdsunit, OpenWorks_SM.HorizonData.values_storage_uom, OpenWorks_SM.HorizonData.remark, OpenWorks_SM.HorizonData."values", OpenWorks_SM.HorizonData.orig_create_date)
                                  VALUES (VARIABLES.horizon_data_id,                VARIABLES.horizon_attr_hdr_id,                "NEW".seismicdataset2d_native_uid,            VARIABLES.seis_geom_set_id,                '2D Line',                              SUBSTRING("NEW".interpretation_status,1,12),    SUBSTRING("NEW".data_source,1,5),     SUBSTRING("NEW".horizon_alias,1,60),    "NEW".horizon_mean,                    SUBSTRING("NEW".horizon_mean_unit,1,64),        "NEW".horizon_min,                    SUBSTRING("NEW".horizon_min_unit,1,64),        "NEW".horizon_max,                    SUBSTRING("NEW".horizon_max_unit,1,64),        "NEW".horizon_min_trace,                    "NEW".horizon_max_trace,                    SUBSTRING("NEW".name_of_data_repository,1,40), "NEW".percent_coverage,                    SUBSTRING("NEW".percent_coverage_unit,1,64),        "NEW".total_samples,                    null,                             "NEW".datum,                            NEW.z_datum_unit,                                NEW.data_unit,                               SUBSTRING("NEW".remark,1,200),   "NEW".data,                        "NEW".original_create_date);
END;


CREATE TRIGGER ON HorizonData2D INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC
DECLARE string VARIABLES.horizon_attr_hdr_id_errorMsg='ERROR: The HorizonAttributeHdr with given values for (horizon_name,data_source,horizon_attribute_name,interpretation_version_name) does not exist';
    DECLARE string VARIABLES.seis_geom_set_id_errorMsg='ERROR: The seis_geom_set_id with given values for (seismic_line_name,seismic_survey_name) does not exist';
    DECLARE string VARIABLES.horizon_data_id_errorMsg='ERROR: The HorizonData2D with given values for (horizon_name,data_source,horizon_attribute_name,interpretation_version_name,seismic_line_name,seismic_survey_name) does not exist';

    DECLARE string VARIABLES.horizon_errorMsg='ERROR: Attribute Name should be in TIME_STRUCTURE or DEPTH_STRUCTURE for base horizon';
        IF("NEW".horizon_attribute_name NOT IN('TIME_STRUCTURE', 'DEPTH_STRUCTURE'))
        BEGIN
            ERROR VARIABLES.horizon_errorMsg;
        END
    DECLARE string VARIABLES.horizon_attr_hdr_id;
    VARIABLES.horizon_attr_hdr_id= (SELECT OpenWorks_SM.HorizonAttributeHdr.horizon_attr_hdr_id FROM OpenWorks_SM.HorizonAttributeHdr WHERE (OpenWorks_SM.HorizonAttributeHdr.horizon_name = SUBSTRING("OLD".horizon_name, 1, 60)) AND (OpenWorks_SM.HorizonAttributeHdr.data_source = SUBSTRING("OLD".data_source, 1, 5)) AND (OpenWorks_SM.HorizonAttributeHdr.horizon_attr_name = SUBSTRING("OLD".horizon_attribute_name, 1, 40)) AND (OpenWorks_SM.HorizonAttributeHdr.interpretation_version_name = SUBSTRING("OLD".interpretation_version_name, 1, 40)));

    IF(VARIABLES.horizon_attr_hdr_id IS NULL)  ERROR VARIABLES.horizon_attr_hdr_id_errorMsg;

    DECLARE string VARIABLES.seis_geom_set_id = null;

    VARIABLES.seis_geom_set_id = (SELECT OpenWorks_SM.Seis2DLine.seis_geom_set_id FROM OpenWorks_SM.Seis2DLine WHERE OpenWorks_SM.Seis2DLine.seis_geom_set_id = "OLD".seis2dline_native_uid);

    IF(VARIABLES.seis_geom_set_id IS NULL)  ERROR VARIABLES.seis_geom_set_id_errorMsg;
    DECLARE integer VARIABLES.horizon_data_id = (SELECT CONVERT(horizon_data_id,Integer) FROM OpenWorks_SM.HorizonData WHERE horizon_attr_hdr_id = VARIABLES.horizon_attr_hdr_id and seis_geom_set_id=VARIABLES.seis_geom_set_id);

    IF(VARIABLES.horizon_data_id IS NULL)
      ERROR VARIABLES.horizon_data_id_errorMsg;


    UPDATE OpenWorks_SM.HorizonData SET
        seismic_data_set_id = "NEW".seismicdataset2d_native_uid,
        geom_set_type='2D Line',
        interpretation_status = SUBSTRING("NEW".interpretation_status,1,12),
        horizon_alias = SUBSTRING("NEW".horizon_alias,1,60),
        horizon_mean = "NEW".horizon_mean,
        horizon_mean_dsdsunit = SUBSTRING("NEW".horizon_mean_unit,1,64),
        horizon_min = "NEW".horizon_min,
        horizon_min_dsdsunit = SUBSTRING("NEW".horizon_min_unit,1,64),
        horizon_max = "NEW".horizon_max,
        horizon_max_dsdsunit = SUBSTRING("NEW".horizon_max_unit,1,64),
        horizon_min_trace = "NEW".horizon_min_trace,
        horizon_max_trace = "NEW".horizon_max_trace,
        name_of_data_rep = SUBSTRING("NEW".name_of_data_repository,1,40),
        percent_coverage = "NEW".percent_coverage,
        percent_coverage_dsdsunit = SUBSTRING("NEW".percent_coverage_unit,1,64),
        total_samples = "NEW".total_samples,
        data_id = null,
        storage_datum = "NEW".datum,
        storage_datum_dsdsunit = "NEW".z_datum_unit,
        values_storage_uom = "NEW".data_unit,
        remark = SUBSTRING("NEW".remark,1,200),
        "values" = "NEW".data,
        orig_create_date = "NEW".original_create_date
    WHERE OpenWorks_SM.HorizonData.horizon_data_id = "OLD".native_uid;
END;

 CREATE TRIGGER ON HorizonData2D INSTEAD OF DELETE AS
 FOR EACH ROW
BEGIN ATOMIC
/*DECLARE integer VARIABLES.horizon_attr_hdr_id = (SELECT OpenWorks_SM.HorizonAttributeHdr.horizon_attr_hdr_id FROM OpenWorks_SM.HorizonAttributeHdr WHERE (OpenWorks_SM.HorizonAttributeHdr.horizon_name = SUBSTRING("OLD".horizon_name, 1, 60)) AND (OpenWorks_SM.HorizonAttributeHdr.data_source = SUBSTRING("OLD".data_source, 1, 5)) AND (OpenWorks_SM.HorizonAttributeHdr.horizon_attr_name = SUBSTRING("OLD".horizon_attribute_name, 1, 40)) AND (OpenWorks_SM.HorizonAttributeHdr.interpretation_version_name = SUBSTRING("OLD".interpretation_version_name, 1, 40)));
    DECLARE integer VARIABLES.seis_geom_set_id = null;

            VARIABLES.seis_geom_set_id = (SELECT OpenWorks_SM.Seis2DLine.seis_geom_set_id FROM OpenWorks_SM.Seis2DLine WHERE (OpenWorks_SM.Seis2DLine.seis_geom_set_nm = "OLD".seismic_line_name) AND (OpenWorks_SM.Seis2DLine.component_geom_id = (SELECT OpenWorks_SM.SeisGeomSet2DSurvey.seis_geom_set_id FROM OpenWorks_SM.SeisGeomSet2DSurvey WHERE OpenWorks_SM.SeisGeomSet2DSurvey.seis_geom_set_nm = "OLD".seismic_survey_name)));


    DECLARE integer VARIABLES.horizon_data_id = (SELECT horizon_data_id FROM OpenWorks_SM.HorizonData WHERE horizon_attr_hdr_id = VARIABLES.horizon_attr_hdr_id and seis_geom_set_id=VARIABLES.seis_geom_set_id);*/
DELETE from OpenWorks_SM.HorizonData WHERE OpenWorks_SM.HorizonData.horizon_data_id = "OLD".native_uid;

END;


/*
******************************
*     "HorizonProperties2D"
******************************
*/
CREATE VIEW HorizonProperties2D
(
  native_uid                  VARCHAR(1024)   OPTIONS("OpenWorksCommonModel:HorizonProperties2D.native_uid.isUpdatable" false,
                                                      "OpenWorksCommonModel:HorizonProperties2D.native_uid.isCreatable" false,
                                                      UPDATABLE 'FALSE'),
  parent_horizon_id           VARCHAR(1024),
  horizon_name                VARCHAR(60)   NOT NULL,
  data_source                 VARCHAR(5)    NOT NULL,
  horizon_attribute_name      VARCHAR(40)   NOT NULL,
  interpretation_version_name VARCHAR(40)   NOT NULL,
  interpretation_status       VARCHAR(12)     DEFAULT 'UNKNOWN',
  horizon_class               VARCHAR(4000),
  pick_surface_name           VARCHAR(4000),
  seis_pick_onset             VARCHAR(4000),
  line_style                  INTEGER,
  line_weight                 INTEGER,
  line_color                  INTEGER,
  line_color_r                INTEGER,
  line_color_g                INTEGER,
  line_color_b                INTEGER,
  horizon_alias               VARCHAR(60),
  horizon_mean                DOUBLE          OPTIONS("OpenWorksCommonModel:HorizonProperties2D.horizon_mean.unitField" 'horizon_mean_unit'),
  horizon_mean_unit           VARCHAR(4000)   OPTIONS("OpenWorksCommonModel:HorizonProperties2D.horizon_mean_unit.unitTypeAttribute" 'unit_type'),
  horizon_min                 DOUBLE          OPTIONS("OpenWorksCommonModel:HorizonProperties2D.horizon_min.unitField" 'horizon_min_unit'),
  horizon_min_unit            VARCHAR(4000)   OPTIONS("OpenWorksCommonModel:HorizonProperties2D.horizon_min_unit.unitTypeAttribute" 'unit_type'),
  horizon_max                 DOUBLE          OPTIONS("OpenWorksCommonModel:HorizonProperties2D.horizon_max.unitField" 'horizon_max_unit'),
  horizon_max_unit            VARCHAR(4000)   OPTIONS("OpenWorksCommonModel:HorizonProperties2D.horizon_max_unit.unitTypeAttribute" 'unit_type'),
  horizon_min_trace           INTEGER,
  horizon_max_trace           INTEGER,
  name_of_data_repository     VARCHAR(40),
  percent_coverage            DOUBLE          OPTIONS("OpenWorksCommonModel:HorizonProperties2D.percent_coverage.unitField" 'percent_coverage_unit'),
  percent_coverage_unit       VARCHAR(64)     OPTIONS("OpenWorksCommonModel:HorizonProperties2D.percent_coverage_unit.unitType" 'percent'),
  total_samples               INTEGER         DEFAULT '0',
  datum                       FLOAT           OPTIONS("OpenWorksCommonModel:HorizonProperties2D.datum.unitField" 'z_datum_unit'),
  z_datum_unit                VARCHAR(64)     OPTIONS("OpenWorksCommonModel:HorizonProperties2D.z_datum_unit.unitType" 'elevation'),
  data_domain                 VARCHAR(12),
  z_domain_qualifier          VARCHAR(24),
  data                        BLOB            OPTIONS("OpenWorksCommonModel:HorizonProperties2D.data.elementType"       'arrayfloat',
                                                      "OpenWorksCommonModel:HorizonProperties2D.data.isPrimitiveArray"  'true',
                                                      "OpenWorksCommonModel:HorizonProperties2D.data.unitField"         'data_unit'),
  data_unit                   VARCHAR(4000)   OPTIONS("OpenWorksCommonModel:HorizonProperties2D.data_unit.unitTypeAttribute" 'unit_type'),
  unit_type                   VARCHAR(4000),
  original_create_date        TIMESTAMP,
  remark                      VARCHAR(200),
  create_date                 TIMESTAMP       OPTIONS("OpenWorksCommonModel:HorizonProperties2D.create_date.isUpdatable" false,
                                                      "OpenWorksCommonModel:HorizonProperties2D.create_date.isCreatable" false,
                                                      UPDATABLE 'FALSE'),
  create_user_id              VARCHAR(32)     OPTIONS("OpenWorksCommonModel:HorizonProperties2D.create_user_id.isUpdatable" false,
                                                      "OpenWorksCommonModel:HorizonProperties2D.create_user_id.isCreatable" false,
                                                      UPDATABLE 'FALSE'),
  update_date                 TIMESTAMP       OPTIONS("OpenWorksCommonModel:HorizonProperties2D.update_date.isUpdatable" false,
                                                      "OpenWorksCommonModel:HorizonProperties2D.update_date.isCreatable" false,
                                                      UPDATABLE 'FALSE'),
  update_user_id              VARCHAR(32)     OPTIONS("OpenWorksCommonModel:HorizonProperties2D.update_user_id.isUpdatable" false,
                                                      "OpenWorksCommonModel:HorizonProperties2D.update_user_id.isCreatable" false,
                                                      UPDATABLE 'FALSE'),
  alternate_uid    		          VARCHAR(4000)   OPTIONS ("OpenWorksCommonModel:HorizonProperties2D.alternate_uid.isCreatable" false,
                                                       "OpenWorksCommonModel:HorizonProperties2D.alternate_uid.isUpdatable" false,
                                                       UPDATABLE 'FALSE'),

    CONSTRAINT HorizonProperties2D_PK PRIMARY KEY (native_uid),

    CONSTRAINT HorizonProperties2D_UK1 UNIQUE (parent_horizon_id,horizon_name, data_source, horizon_attribute_name, interpretation_version_name),

    CONSTRAINT FK_HorizonProperties2D_data_source
        FOREIGN KEY          (data_source)
        REFERENCES DataSource(name),

    CONSTRAINT FK_HorizonProperties2D_parent_horizon_id
        FOREIGN KEY             (parent_horizon_id)
        REFERENCES HorizonData2D(native_uid)

)
OPTIONS (UPDATABLE 'TRUE', HorizonProperties2D.IMPLEMENTED 'TRUE')
AS
SELECT
    hor.horizon_data_id,
	(call GetParentId(hor.seis_geom_set_id,HAHdr.horizon_name,HAHdr.data_source,HAHdr.interpretation_version_name)) AS parent_horizon_id,
	HAHdr.horizon_name,
    HAHdr.data_source,
    HAHdr.horizon_attr_name,
    HAHdr.interpretation_version_name,
    hor.interpretation_status,
    HAHdr.horizon_class,
    HAHdr.pick_surf_name,
    HAHdr.seis_pick_onset,
    HAHdr.line_style,
    HAHdr.line_weight,
    HAHdr.line_color,
    HAHdr.line_color_r,
    HAHdr.line_color_g,
    HAHdr.line_color_b,
    hor.horizon_alias,
    hor.horizon_mean,
    hor.horizon_mean_dsdsunit AS horizon_mean_unit,
    hor.horizon_min,
    hor.horizon_min_dsdsunit AS horizon_min_unit,
    hor.horizon_max,
    hor.horizon_max_dsdsunit AS horizon_max_unit,
    hor.horizon_min_trace,
    hor.horizon_max_trace,
    hor.name_of_data_rep,
    hor.percent_coverage,
    hor.percent_coverage_dsdsunit AS percent_coverage_unit,
    hor.total_samples,
    hor.working_datum ,
    hor.working_datum_dsdsunit ,
    hor.data_domain,
    HAHdr.z_domain_qualifier,
    hor."values" AS data,
    hor.values_dsdsunit,
    hor.unit_type_id AS unit_type,
    hor.orig_create_date,
    hor.remark,
    hor.create_date,
    hor.create_user_id,
    hor.update_date,
    hor.update_user_id,
    hor.native_uid
FROM
    OpenWorks_SM.HorizonData hor
    INNER JOIN OpenWorks_SM.Seis2DLine line ON hor.seis_geom_set_id =  line.seis_geom_set_id
    INNER JOIN OpenWorks_SM.SeisGeomSet2DSurvey survey ON line.component_geom_id = survey.seis_geom_set_id
    --- using right join instead of inner join to circumvent a teiid bug where join applies from values of the right table to only one row of the left table, therefore, total number of rows equate distinct matcing rows of the second table instead of a combination of them.
    --i.e. if ONE HorizonAttributeHdr header matches to FIVE rows on horizondata, ONE row will be returned instead of FIVE. This is fixed by right join. This can be restored to inner join once teiid overcomes this bug.
    RIGHT JOIN OpenWorks_SM.HorizonAttributeHdr HAHdr ON hor.horizon_attr_hdr_id = HAHdr.horizon_attr_hdr_id
WHERE HAHdr.horizon_attr_name NOT IN ('TIME_STRUCTURE', 'DEPTH_STRUCTURE')
AND hor.geom_set_type='2D Line' AND (call GetParentId(hor.seis_geom_set_id,HAHdr.horizon_name,HAHdr.data_source,HAHdr.interpretation_version_name)) is not null;

CREATE TRIGGER ON HorizonProperties2D INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC

    DECLARE string VARIABLES.horizon_attr_hdr_id_errorMsg='ERROR: The HorizonAttributeHdr with given values for (horizon_name,data_source,horizon_attribute_name,interpretation_version_name) does not exist';
    DECLARE string VARIABLES.seis_geom_set_id_errorMsg='ERROR: The seis_geom_set_id with given values for (seismic_line_name,seismic_survey_name) does not exist';

    DECLARE string VARIABLES.horizon_errorMsg='ERROR: Attribute Name should not be TIME_STRUCTURE or DEPTH_STRUCTURE for property horizon';
        IF("NEW".horizon_attribute_name IN('TIME_STRUCTURE', 'DEPTH_STRUCTURE'))
        BEGIN
            ERROR VARIABLES.horizon_errorMsg;
        END
    DECLARE integer VARIABLES.horizon_data_id = (SELECT * FROM (EXEC OpenWorks_SM.nextval('HorizonData')) AS SysGenID);

    DECLARE string VARIABLES.horizon_attr_hdr_id= null;

    VARIABLES.horizon_attr_hdr_id = (SELECT OpenWorks_SM.HorizonAttributeHdr.horizon_attr_hdr_id FROM OpenWorks_SM.HorizonAttributeHdr WHERE (OpenWorks_SM.HorizonAttributeHdr.horizon_name = SUBSTRING("NEW".horizon_name, 1, 60)) AND (OpenWorks_SM.HorizonAttributeHdr.data_source = SUBSTRING("NEW".data_source, 1, 5)) AND (OpenWorks_SM.HorizonAttributeHdr.horizon_attr_name = SUBSTRING("NEW".horizon_attribute_name, 1, 40)) AND (OpenWorks_SM.HorizonAttributeHdr.interpretation_version_name = SUBSTRING("NEW".interpretation_version_name, 1, 40)));


    IF(VARIABLES.horizon_attr_hdr_id IS NULL)
    BEGIN
        INSERT INTO OpenWorks_SM.HorizonAttributeHdr(horizon_name, data_source, horizon_attr_name, interpretation_version_name)
         values(SUBSTRING("NEW".horizon_name, 1, 60), SUBSTRING("NEW".data_source, 1, 5), SUBSTRING("NEW".horizon_attribute_name, 1, 40), SUBSTRING("NEW".interpretation_version_name, 1, 40));

        VARIABLES.horizon_attr_hdr_id = (SELECT OpenWorks_SM.HorizonAttributeHdr.horizon_attr_hdr_id FROM OpenWorks_SM.HorizonAttributeHdr WHERE (OpenWorks_SM.HorizonAttributeHdr.horizon_name = SUBSTRING("NEW".horizon_name, 1, 60)) AND (OpenWorks_SM.HorizonAttributeHdr.data_source = SUBSTRING("NEW".data_source, 1, 5)) AND (OpenWorks_SM.HorizonAttributeHdr.horizon_attr_name = SUBSTRING("NEW".horizon_attribute_name, 1, 40)) AND (OpenWorks_SM.HorizonAttributeHdr.interpretation_version_name = SUBSTRING("NEW".interpretation_version_name, 1, 40)));

    END
    DECLARE STRING VARIABLES.seis2dline_native_uid = select hd.seis_geom_set_id from  OpenWorks_SM.HorizonData hd where  hd.horizon_data_id="NEW".parent_horizon_id;


    DECLARE STRING VARIABLES.seismic_data_set_id = select hd.seismic_data_set_id from  OpenWorks_SM.HorizonData hd where  hd.horizon_data_id="NEW".parent_horizon_id;

    INSERT INTO OpenWorks_SM.HorizonData (OpenWorks_SM.HorizonData.horizon_data_id, OpenWorks_SM.HorizonData.horizon_attr_hdr_id, OpenWorks_SM.HorizonData.seismic_data_set_id, OpenWorks_SM.HorizonData.seis_geom_set_id, OpenWorks_SM.HorizonData.geom_set_type, OpenWorks_SM.HorizonData.interpretation_status, OpenWorks_SM.HorizonData.data_source, OpenWorks_SM.HorizonData.horizon_alias, OpenWorks_SM.HorizonData.horizon_mean, OpenWorks_SM.HorizonData.horizon_mean_dsdsunit, OpenWorks_SM.HorizonData.horizon_min, OpenWorks_SM.HorizonData.horizon_min_dsdsunit, OpenWorks_SM.HorizonData.horizon_max, OpenWorks_SM.HorizonData.horizon_max_dsdsunit, OpenWorks_SM.HorizonData.horizon_min_trace, OpenWorks_SM.HorizonData.horizon_max_trace, OpenWorks_SM.HorizonData.name_of_data_rep, OpenWorks_SM.HorizonData.percent_coverage, OpenWorks_SM.HorizonData.percent_coverage_dsdsunit, OpenWorks_SM.HorizonData.total_samples, OpenWorks_SM.HorizonData.data_id, OpenWorks_SM.HorizonData.storage_datum, OpenWorks_SM.HorizonData.storage_datum_dsdsunit,OpenWorks_SM.HorizonData.values_storage_uom, OpenWorks_SM.HorizonData.remark, OpenWorks_SM.HorizonData."values", OpenWorks_SM.HorizonData.orig_create_date)
    VALUES (VARIABLES.horizon_data_id,VARIABLES.horizon_attr_hdr_id,VARIABLES.seismic_data_set_id,VARIABLES.seis2dline_native_uid,'2D Line',SUBSTRING("NEW".interpretation_status,1,12),SUBSTRING("NEW".data_source,1,5),SUBSTRING("NEW".horizon_alias,1,60),"NEW".horizon_mean,SUBSTRING("NEW".horizon_mean_unit,1,64),"NEW".horizon_min,SUBSTRING("NEW".horizon_min_unit,1,64),"NEW".horizon_max,SUBSTRING("NEW".horizon_max_unit,1,64),"NEW".horizon_min_trace,"NEW".horizon_max_trace,SUBSTRING("NEW".name_of_data_repository,1,40),"NEW".percent_coverage,SUBSTRING("NEW".percent_coverage_unit,1,64),"NEW".total_samples,null,"NEW".datum,NEW.z_datum_unit,NEW.data_unit,SUBSTRING("NEW".remark,1,200),"NEW".data,"NEW".original_create_date);
END;


CREATE TRIGGER ON HorizonProperties2D INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC
DECLARE string VARIABLES.horizon_attr_hdr_id_errorMsg='ERROR: The HorizonAttributeHdr with given values for (horizon_name,data_source,horizon_attribute_name,interpretation_version_name) does not exist';
    DECLARE string VARIABLES.seis_geom_set_id_errorMsg='ERROR: The seis_geom_set_id with given values for (seismic_line_name,seismic_survey_name) does not exist';
    DECLARE string VARIABLES.horizon_data_id_errorMsg='ERROR: The HorizonProperties2D with given values for (horizon_name,data_source,horizon_attribute_name,interpretation_version_name,seismic_line_name,seismic_survey_name) does not exist';

    DECLARE string VARIABLES.horizon_errorMsg='ERROR: Attribute Name should not be TIME_STRUCTURE or DEPTH_STRUCTURE for property horizon';
        IF("NEW".horizon_attribute_name IN('TIME_STRUCTURE', 'DEPTH_STRUCTURE'))
        BEGIN
            ERROR VARIABLES.horizon_errorMsg;
        END

    DECLARE string VARIABLES.horizon_attr_hdr_id;
    VARIABLES.horizon_attr_hdr_id= (SELECT OpenWorks_SM.HorizonAttributeHdr.horizon_attr_hdr_id FROM OpenWorks_SM.HorizonAttributeHdr WHERE (OpenWorks_SM.HorizonAttributeHdr.horizon_name = SUBSTRING("OLD".horizon_name, 1, 60)) AND (OpenWorks_SM.HorizonAttributeHdr.data_source = SUBSTRING("OLD".data_source, 1, 5)) AND (OpenWorks_SM.HorizonAttributeHdr.horizon_attr_name = SUBSTRING("OLD".horizon_attribute_name, 1, 40)) AND (OpenWorks_SM.HorizonAttributeHdr.interpretation_version_name = SUBSTRING("OLD".interpretation_version_name, 1, 40)));

    IF(VARIABLES.horizon_attr_hdr_id IS NULL)  ERROR VARIABLES.horizon_attr_hdr_id_errorMsg;


    DECLARE STRING VARIABLES.seis2dline_native_uid = select hd.seis_geom_set_id from  OpenWorks_SM.HorizonData hd where  hd.horizon_data_id="OLD".parent_horizon_id;

    DECLARE integer VARIABLES.horizon_data_id = (SELECT CONVERT(horizon_data_id,Integer) FROM OpenWorks_SM.HorizonData WHERE horizon_attr_hdr_id = VARIABLES.horizon_attr_hdr_id and seis_geom_set_id=VARIABLES.seis2dline_native_uid);

    IF(VARIABLES.horizon_data_id IS NULL)
      ERROR VARIABLES.horizon_data_id_errorMsg;

    DECLARE STRING VARIABLES.seismic_data_set_id = select hd.seismic_data_set_id from  OpenWorks_SM.HorizonData hd where  hd.horizon_data_id="OLD".parent_horizon_id;

    UPDATE OpenWorks_SM.HorizonData SET seismic_data_set_id = VARIABLES.seismic_data_set_id,geom_set_type='2D Line',interpretation_status = SUBSTRING("NEW".interpretation_status,1,12), horizon_alias = SUBSTRING("NEW".horizon_alias,1,60),horizon_mean = "NEW".horizon_mean,horizon_mean_dsdsunit = SUBSTRING("NEW".horizon_mean_unit,1,64),horizon_min = "NEW".horizon_min, horizon_min_dsdsunit = SUBSTRING("NEW".horizon_min_unit,1,64),horizon_max = "NEW".horizon_max,horizon_max_dsdsunit = SUBSTRING("NEW".horizon_max_unit,1,64),horizon_min_trace = "NEW".horizon_min_trace, horizon_max_trace = "NEW".horizon_max_trace,name_of_data_rep = SUBSTRING("NEW".name_of_data_repository,1,40),percent_coverage = "NEW".percent_coverage,percent_coverage_dsdsunit = SUBSTRING("NEW".percent_coverage_unit,1,64), total_samples = "NEW".total_samples,data_id = null,storage_datum = "NEW".datum,storage_datum_dsdsunit = "NEW".z_datum_unit,values_storage_uom = "NEW".data_unit,remark = SUBSTRING("NEW".remark,1,200), "values" = "NEW".data,orig_create_date = "NEW".original_create_date WHERE OpenWorks_SM.HorizonData.horizon_data_id = "OLD".native_uid;
END;

 CREATE TRIGGER ON HorizonProperties2D INSTEAD OF DELETE AS
 FOR EACH ROW
BEGIN ATOMIC
DELETE from OpenWorks_SM.HorizonData WHERE OpenWorks_SM.HorizonData.horizon_data_id = "OLD".native_uid;

END;

/*
**********************************
*     "HorizonData3D"
**********************************
*/

CREATE VIEW HorizonData3D
(
	native_uid                      VARCHAR(1024)   OPTIONS("OpenWorksCommonModel:HorizonData3D.native_uid.isUpdatable" false,
                                                            "OpenWorksCommonModel:HorizonData3D.native_uid.isCreatable" false,
                                                            UPDATABLE 'FALSE'),

    horizon_name                    VARCHAR(4000)   NOT NULL,
    data_source                     VARCHAR(4000)   NOT NULL,
    horizon_attribute_name          VARCHAR(4000)   NOT NULL,
    interpretation_version_name     VARCHAR(4000)   NOT NULL,
    seismicdataset3d_native_uid     VARCHAR(1024),
    seismic3dsurvey_native_uid      VARCHAR(1024)   NOT NULL,
    seismic_survey_name             VARCHAR(4000)   OPTIONS("OpenWorksCommonModel:HorizonData3D.seismic_survey_name.isUpdatable" false,
                                                            "OpenWorksCommonModel:HorizonData3D.seismic_survey_name.isCreatable" false,
                                                            UPDATABLE 'FALSE'),
    interpretation_status           VARCHAR(4000),
    horizon_class                   VARCHAR(4000),
    pick_surface_name               VARCHAR(4000),
    seis_pick_onset                 VARCHAR(4000),
    line_style                      INTEGER,
    line_weight                     INTEGER,
    line_color                      INTEGER,
    line_color_r                    INTEGER,
    line_color_g                    INTEGER,
    line_color_b                    INTEGER,
    horizon_alias                   VARCHAR(4000),
    horizon_mean                    DOUBLE          OPTIONS("OpenWorksCommonModel:HorizonData3D.horizon_mean.unitField" 'horizon_mean_unit',
                                                            "OpenWorksCommonModel:HorizonData3D.horizon_mean.isUpdatable" false,
                                                            "OpenWorksCommonModel:HorizonData3D.horizon_mean.isCreatable" false,
                                                            UPDATABLE 'FALSE'),
    horizon_mean_unit               VARCHAR(4000)   OPTIONS("OpenWorksCommonModel:HorizonData3D.horizon_mean_unit.unitTypeAttribute" 'unit_type',
                                                            "OpenWorksCommonModel:HorizonData3D.horizon_mean_unit.isUpdatable" false,
                                                            "OpenWorksCommonModel:HorizonData3D.horizon_mean_unit.isCreatable" false,
                                                            UPDATABLE 'FALSE'),
    horizon_min                     DOUBLE          OPTIONS("OpenWorksCommonModel:HorizonData3D.horizon_min.unitField" 'horizon_min_unit',
                                                            "OpenWorksCommonModel:HorizonData3D.horizon_min.isUpdatable" false,
                                                            "OpenWorksCommonModel:HorizonData3D.horizon_min.isCreatable" false,
                                                            UPDATABLE 'FALSE'),
    horizon_min_unit                VARCHAR(4000)   OPTIONS("OpenWorksCommonModel:HorizonData3D.horizon_min_unit.unitTypeAttribute"  'unit_type',
                                                            "OpenWorksCommonModel:HorizonData3D.horizon_min_unit.isUpdatable" false,
                                                            "OpenWorksCommonModel:HorizonData3D.horizon_min_unit.isCreatable" false,
                                                            UPDATABLE 'FALSE'),
    horizon_max                     DOUBLE          OPTIONS("OpenWorksCommonModel:HorizonData3D.horizon_max.unitField" 'horizon_max_unit',
                                                            "OpenWorksCommonModel:HorizonData3D.horizon_max.isUpdatable" false,
                                                            "OpenWorksCommonModel:HorizonData3D.horizon_max.isCreatable" false,
                                                            UPDATABLE 'FALSE'),
    horizon_max_unit                VARCHAR(4000)   OPTIONS("OpenWorksCommonModel:HorizonData3D.horizon_max_unit.unitTypeAttribute"  'unit_type',
                                                            "OpenWorksCommonModel:HorizonData3D.horizon_max_unit.isUpdatable" false,
                                                            "OpenWorksCommonModel:HorizonData3D.horizon_max_unit.isCreatable" false,
                                                            UPDATABLE 'FALSE'),
    horizon_min_trace               INTEGER         OPTIONS("OpenWorksCommonModel:HorizonData3D.horizon_min_trace.isUpdatable" false,
                                                            "OpenWorksCommonModel:HorizonData3D.horizon_min_trace.isCreatable" false,
                                                            UPDATABLE 'FALSE'),
    horizon_max_trace               INTEGER         OPTIONS("OpenWorksCommonModel:HorizonData3D.horizon_max_trace.isUpdatable" false,
                                                            "OpenWorksCommonModel:HorizonData3D.horizon_max_trace.isCreatable" false,
                                                            UPDATABLE 'FALSE'),
    name_of_data_repository         VARCHAR(4000)   OPTIONS("OpenWorksCommonModel:HorizonData3D.name_of_data_repository.isUpdatable" false,
                                                            "OpenWorksCommonModel:HorizonData3D.name_of_data_repository.isCreatable" false,
                                                            UPDATABLE 'FALSE'),
    percent_coverage                DOUBLE          OPTIONS("OpenWorksCommonModel:HorizonData3D.percent_coverage.unitField" 'percent_coverage_unit',
                                                            "OpenWorksCommonModel:HorizonData3D.percent_coverage.isUpdatable" false,
                                                            "OpenWorksCommonModel:HorizonData3D.percent_coverage.isCreatable" false,
                                                            UPDATABLE 'FALSE'),
    percent_coverage_unit           VARCHAR(4000)   OPTIONS("OpenWorksCommonModel:HorizonData3D.percent_coverage_unit.unitType"      'percent',
                                                            "OpenWorksCommonModel:HorizonData3D.percent_coverage_unit.isUpdatable" false,
                                                            "OpenWorksCommonModel:HorizonData3D.percent_coverage_unit.isCreatable" false,
                                                            UPDATABLE 'FALSE'),
    total_samples                   INTEGER DEFAULT '0'  OPTIONS("OpenWorksCommonModel:HorizonData3D.total_samples.isUpdatable" false,
                                                                 "OpenWorksCommonModel:HorizonData3D.total_samples.isCreatable" false,
                                                                 UPDATABLE 'FALSE'),
    data_id                         VARCHAR(4000)   OPTIONS("OpenWorksCommonModel:HorizonData3D.data_id.isUpdatable" false,
                                                            "OpenWorksCommonModel:HorizonData3D.data_id.isCreatable" false,
                                                            UPDATABLE 'FALSE'),
    datum                           FLOAT           OPTIONS("OpenWorksCommonModel:HorizonData3D.datum.unitField" 'z_datum_unit'),
    z_datum_unit                    VARCHAR(4000)   OPTIONS("OpenWorksCommonModel:HorizonData3D.z_datum_unit.unitType" 'elevation'),
    data_domain                     VARCHAR(4000),
    z_domain_qualifier              VARCHAR(4000),
    data                            BLOB            OPTIONS("OpenWorksCommonModel:HorizonData3D.data.isMedia" true,
                                                            "OpenWorksCommonModel:HorizonData3D.data.mediaContentType" 'application/octet-stream',
                                                            "OpenWorksCommonModel:HorizonData3D.data.elementType"   'arrayfloat',
                                                            "OpenWorksCommonModel:HorizonData3D.data.isPrimitiveArray"   true,
                                                            "OpenWorksCommonModel:HorizonData3D.data.unitField"         'data_unit'),


    data_unit                       VARCHAR(4000)   OPTIONS("OpenWorksCommonModel:HorizonData3D.data_unit.unitTypeAttribute" 'unit_type'),
    unit_type                       VARCHAR(4000),
    original_create_date            TIMESTAMP,
    remark                          VARCHAR(4000),
    create_date                     TIMESTAMP,
    create_user_id                  VARCHAR(4000),
    update_date                     TIMESTAMP,
    update_user_id                  VARCHAR(4000),
    alternate_uid    		                VARCHAR(4000)   OPTIONS ("OpenWorksCommonModel:HorizonData3D.alternate_uid.isCreatable" false,
                                                             "OpenWorksCommonModel:HorizonData3D.alternate_uid.isUpdatable" false,
                                                             UPDATABLE 'FALSE'),

    CONSTRAINT HorizonData3D_PK PRIMARY KEY (native_uid),

    CONSTRAINT HorizonData3D_UK1 UNIQUE (horizon_name, data_source, horizon_attribute_name, interpretation_version_name, seismic3dsurvey_native_uid),

    CONSTRAINT FK_HorizonData3D_Seismic3DSurvey_seismic3dsurvey_native_uid
        FOREIGN KEY               (seismic3dsurvey_native_uid)
        REFERENCES Seismic3DSurvey(native_uid),

    CONSTRAINT FK_HorizonData3D_seismicdataset3d_native_uid
        FOREIGN KEY                (seismicdataset3d_native_uid)
        REFERENCES SeismicDataSet3D(native_uid),

    CONSTRAINT FK_HorizonData3D_data_source
        FOREIGN KEY (data_source)
        REFERENCES DataSource(name)

)
OPTIONS (UPDATABLE 'TRUE', HorizonData3D.IMPLEMENTED 'TRUE')
AS
SELECT
OpenWorks_SM.HorizonData.horizon_data_id AS native_uid,
OpenWorks_SM.HorizonAttributeHdr.horizon_name AS horizon_name ,
OpenWorks_SM.HorizonAttributeHdr.data_source AS  data_source ,
OpenWorks_SM.HorizonAttributeHdr.horizon_attr_name AS horizon_attribute_name,
OpenWorks_SM.HorizonAttributeHdr.interpretation_version_name AS interpretation_version_name,
OpenWorks_SM.HorizonData.seismic_data_set_id,
OpenWorks_SM.Seis3DSurvey.seis_geom_set_id AS seismic3dsurvey_native_uid,
OpenWorks_SM.Seis3DSurvey.seis_geom_set_nm AS seismic_survey_name,
OpenWorks_SM.HorizonData.interpretation_status AS  interpretation_status,
OpenWorks_SM.HorizonAttributeHdr.horizon_class AS horizon_class,
OpenWorks_SM.HorizonAttributeHdr.pick_surf_name AS pick_surface_name,
OpenWorks_SM.HorizonAttributeHdr.seis_pick_onset AS seis_pick_onset,
OpenWorks_SM.HorizonAttributeHdr.line_style AS line_style,
OpenWorks_SM.HorizonAttributeHdr.line_weight AS line_weight,
OpenWorks_SM.HorizonAttributeHdr.line_color AS line_color,
OpenWorks_SM.HorizonAttributeHdr.line_color_r AS line_color_r,
OpenWorks_SM.HorizonAttributeHdr.line_color_g AS line_color_g,
OpenWorks_SM.HorizonAttributeHdr.line_color_b AS line_color_b,
OpenWorks_SM.HorizonData.horizon_alias AS horizon_alias,
OpenWorks_SM.HorizonData.horizon_mean AS horizon_mean,
OpenWorks_SM.HorizonData.horizon_mean_dsdsunit AS horizon_mean_unit,
OpenWorks_SM.HorizonData.horizon_min AS horizon_min,
OpenWorks_SM.HorizonData.horizon_min_dsdsunit AS horizon_min_unit,
OpenWorks_SM.HorizonData.horizon_max AS horizon_max,
OpenWorks_SM.HorizonData.horizon_max_dsdsunit AS horizon_max_unit,
OpenWorks_SM.HorizonData.horizon_min_trace AS horizon_min_trace,
OpenWorks_SM.HorizonData.horizon_max_trace AS horizon_max_trace,
OpenWorks_SM.HorizonData.name_of_data_rep AS name_of_data_repository,
OpenWorks_SM.HorizonData.percent_coverage AS percent_coverage,
OpenWorks_SM.HorizonData.percent_coverage_dsdsunit AS percent_coverage_unit,
OpenWorks_SM.HorizonData.total_samples AS total_samples,
OpenWorks_SM.HorizonData.data_id AS data_id,
null AS datum,
null AS z_datum_unit,
OpenWorks_SM.HorizonData.data_domain AS data_domain,
OpenWorks_SM.HorizonAttributeHdr.z_domain_qualifier AS z_domain_qualifier,
OpenWorks_SM.HorizonData."data" AS data,
OpenWorks_SM.HorizonData.values_dsdsunit AS data_unit,
OpenWorks_SM.HorizonData.unit_type_id AS unit_type,
OpenWorks_SM.HorizonData.orig_create_date AS original_create_date,
OpenWorks_SM.HorizonData.remark AS remark,
OpenWorks_SM.HorizonData.create_date AS create_date,
OpenWorks_SM.HorizonData.create_user_id AS create_user_id ,
OpenWorks_SM.HorizonData.update_date AS update_date,
OpenWorks_SM.HorizonData.update_user_id AS update_user_id,
OpenWorks_SM.HorizonData.native_uid AS alternate_uid

FROM
OpenWorks_SM.HorizonData , OpenWorks_SM.Seis3DSurvey , OpenWorks_SM.HorizonAttributeHdr
where
OpenWorks_SM.HorizonData.seis_geom_set_id= OpenWorks_SM.Seis3DSurvey.seis_geom_set_id
AND OpenWorks_SM.HorizonData.horizon_attr_hdr_id = OpenWorks_SM.HorizonAttributeHdr.horizon_attr_hdr_id
AND OpenWorks_SM.HorizonAttributeHdr.horizon_attr_name IN ('TIME_STRUCTURE', 'DEPTH_STRUCTURE')
AND OpenWorks_SM.HorizonData.geom_set_type='3D Survey';


CREATE TRIGGER ON HorizonData3D INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC

    DECLARE string VARIABLES.horizon_attr_hdr_id_errorMsg='ERROR: The HorizonAttributeHdr with given values for (horizon_name,data_source,horizon_attribute_name,interpretation_version_name) does not exist';
    DECLARE string VARIABLES.seis_geom_set_id_errorMsg='ERROR: The seis_geom_set_id with given values for (seismic_line_name,seismic_survey_name) does not exist';

    DECLARE string VARIABLES.horizon_errorMsg='ERROR: Attribute Name should be TIME_STRUCTURE or DEPTH_STRUCTURE for base horizon';
        IF("NEW".horizon_attribute_name NOT IN('TIME_STRUCTURE', 'DEPTH_STRUCTURE'))
        BEGIN
            ERROR VARIABLES.horizon_errorMsg;
        END

    DECLARE integer VARIABLES.horizon_data_id = (SELECT * FROM (EXEC OpenWorks_SM.nextval('HorizonData')) AS SysGenID);

    DECLARE string VARIABLES.horizon_attr_hdr_id= null;

    VARIABLES.horizon_attr_hdr_id = (SELECT OpenWorks_SM.HorizonAttributeHdr.horizon_attr_hdr_id FROM OpenWorks_SM.HorizonAttributeHdr WHERE (OpenWorks_SM.HorizonAttributeHdr.horizon_name = SUBSTRING("NEW".horizon_name, 1, 60)) AND (OpenWorks_SM.HorizonAttributeHdr.data_source = SUBSTRING("NEW".data_source, 1, 5)) AND (OpenWorks_SM.HorizonAttributeHdr.horizon_attr_name = SUBSTRING("NEW".horizon_attribute_name, 1, 40)) AND (OpenWorks_SM.HorizonAttributeHdr.interpretation_version_name = SUBSTRING("NEW".interpretation_version_name, 1, 40)));

    DECLARE string VARIABLES.seis_geom_set_id = null;
    IF(VARIABLES.horizon_attr_hdr_id IS NULL)
    BEGIN
        INSERT INTO OpenWorks_SM.HorizonAttributeHdr(horizon_name,                         data_source,                        horizon_attr_name,                              interpretation_version_name)
                                              values(SUBSTRING("NEW".horizon_name, 1, 60), SUBSTRING("NEW".data_source, 1, 5), SUBSTRING("NEW".horizon_attribute_name, 1, 40), SUBSTRING("NEW".interpretation_version_name, 1, 40));

        VARIABLES.horizon_attr_hdr_id = (SELECT OpenWorks_SM.HorizonAttributeHdr.horizon_attr_hdr_id FROM OpenWorks_SM.HorizonAttributeHdr WHERE (OpenWorks_SM.HorizonAttributeHdr.horizon_name = SUBSTRING("NEW".horizon_name, 1, 60)) AND (OpenWorks_SM.HorizonAttributeHdr.data_source = SUBSTRING("NEW".data_source, 1, 5)) AND (OpenWorks_SM.HorizonAttributeHdr.horizon_attr_name = SUBSTRING("NEW".horizon_attribute_name, 1, 40)) AND (OpenWorks_SM.HorizonAttributeHdr.interpretation_version_name = SUBSTRING("NEW".interpretation_version_name, 1, 40)));

    END

    VARIABLES.seis_geom_set_id = (SELECT OpenWorks_SM.Seis3DSurvey.seis_geom_set_id FROM OpenWorks_SM.Seis3DSurvey WHERE OpenWorks_SM.Seis3DSurvey.seis_geom_set_id = "NEW".seismic3dsurvey_native_uid);

        IF(VARIABLES.seis_geom_set_id IS NULL)  ERROR VARIABLES.seis_geom_set_id_errorMsg;

        DECLARE string VARIABLES.seismic_data_set_id = null;

    INSERT INTO OpenWorks_SM.HorizonData (OpenWorks_SM.HorizonData.horizon_data_id, OpenWorks_SM.HorizonData.horizon_attr_hdr_id, OpenWorks_SM.HorizonData.seismic_data_set_id, OpenWorks_SM.HorizonData.seis_geom_set_id, OpenWorks_SM.HorizonData.geom_set_type, OpenWorks_SM.HorizonData.interpretation_status, OpenWorks_SM.HorizonData.data_source, OpenWorks_SM.HorizonData.horizon_alias,OpenWorks_SM.HorizonData.storage_datum, OpenWorks_SM.HorizonData.storage_datum_dsdsunit, OpenWorks_SM.HorizonData.values_storage_uom, OpenWorks_SM.HorizonData.remark, OpenWorks_SM.HorizonData."data", OpenWorks_SM.HorizonData.orig_create_date)
                                  VALUES (VARIABLES.horizon_data_id,                VARIABLES.horizon_attr_hdr_id,                VARIABLES.seismic_data_set_id,                VARIABLES.seis_geom_set_id,                '3D Survey',                            SUBSTRING("NEW".interpretation_status,1,12),    SUBSTRING("NEW".data_source,1,5),     SUBSTRING("NEW".horizon_alias,1,60),"NEW".datum,                            NEW.z_datum_unit,                                NEW.data_unit,                               SUBSTRING("NEW".remark,1,200),   "NEW".data,                      "NEW".original_create_date);
END;



CREATE TRIGGER ON HorizonData3D INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC
DECLARE string VARIABLES.horizon_attr_hdr_id_errorMsg='ERROR: The HorizonAttributeHdr with given values for (horizon_name,data_source,horizon_attribute_name,interpretation_version_name) does not exist';
    DECLARE string VARIABLES.seis_geom_set_id_errorMsg='ERROR: The seis_geom_set_id with given values for (seismic_line_name,seismic_survey_name) does not exist';
    DECLARE string VARIABLES.horizon_data_id_errorMsg='ERROR: The HorizonData3D with given values for (horizon_name,data_source,horizon_attribute_name,interpretation_version_name,seismic_line_name,seismic_survey_name) does not exist';

    DECLARE string VARIABLES.horizon_errorMsg='ERROR: Attribute Name should be TIME_STRUCTURE or DEPTH_STRUCTURE for base horizon';
        IF("NEW".horizon_attribute_name NOT IN('TIME_STRUCTURE', 'DEPTH_STRUCTURE'))
        BEGIN
            ERROR VARIABLES.horizon_errorMsg;
        END

    DECLARE string VARIABLES.horizon_attr_hdr_id;
    VARIABLES.horizon_attr_hdr_id= (SELECT OpenWorks_SM.HorizonAttributeHdr.horizon_attr_hdr_id FROM OpenWorks_SM.HorizonAttributeHdr WHERE (OpenWorks_SM.HorizonAttributeHdr.horizon_name = SUBSTRING("OLD".horizon_name, 1, 60)) AND (OpenWorks_SM.HorizonAttributeHdr.data_source = SUBSTRING("OLD".data_source, 1, 5)) AND (OpenWorks_SM.HorizonAttributeHdr.horizon_attr_name = SUBSTRING("OLD".horizon_attribute_name, 1, 40)) AND (OpenWorks_SM.HorizonAttributeHdr.interpretation_version_name = SUBSTRING("OLD".interpretation_version_name, 1, 40)));

    IF(VARIABLES.horizon_attr_hdr_id IS NULL)  ERROR VARIABLES.horizon_attr_hdr_id_errorMsg;

    DECLARE string VARIABLES.seis_geom_set_id = null;
    DECLARE string VARIABLES.seismic_data_set_id = null;

    VARIABLES.seis_geom_set_id = (SELECT OpenWorks_SM.Seis3DSurvey.seis_geom_set_id FROM OpenWorks_SM.Seis3DSurvey WHERE OpenWorks_SM.Seis3DSurvey.seis_geom_set_id = "OLD".seismic3dsurvey_native_uid);

    IF(VARIABLES.seis_geom_set_id IS NULL)  ERROR VARIABLES.seis_geom_set_id_errorMsg;
    DECLARE integer VARIABLES.horizon_data_id = (SELECT CONVERT(horizon_data_id,Integer) FROM OpenWorks_SM.HorizonData WHERE horizon_attr_hdr_id = VARIABLES.horizon_attr_hdr_id and seis_geom_set_id=VARIABLES.seis_geom_set_id);

    IF(VARIABLES.horizon_data_id IS NULL)
      ERROR VARIABLES.horizon_data_id_errorMsg;

    IF("NEW".data IS NOT NULL AND CHANGING.data)
    BEGIN
    UPDATE OpenWorks_SM.HorizonData SET
        seis_geom_set_id=VARIABLES.seis_geom_set_id,
        horizon_attr_hdr_id=VARIABLES.horizon_attr_hdr_id,
        data="NEW".data,
        seismic_data_set_id = VARIABLES.seismic_data_set_id,
        horizon_alias = SUBSTRING("NEW".horizon_alias,1,60),
        storage_datum = "NEW".datum,
        storage_datum_dsdsunit = "NEW".z_datum_unit,
        values_storage_uom = "NEW".data_unit,
        remark = SUBSTRING("NEW".remark,1,200),
        geom_set_type = '3D Survey',
        orig_create_date = "NEW".original_create_date
    WHERE OpenWorks_SM.HorizonData.horizon_data_id = "OLD".native_uid;
    END
    ELSE
    BEGIN
      UPDATE OpenWorks_SM.HorizonData SET
          seis_geom_set_id=VARIABLES.seis_geom_set_id,
          horizon_attr_hdr_id=VARIABLES.horizon_attr_hdr_id,
          seismic_data_set_id = VARIABLES.seismic_data_set_id,
          horizon_alias = SUBSTRING("NEW".horizon_alias,1,60),
          storage_datum = "NEW".datum,
          storage_datum_dsdsunit = "NEW".z_datum_unit,
          values_storage_uom = "NEW".data_unit,
          remark = SUBSTRING("NEW".remark,1,200),
          geom_set_type = '3D Survey',
          orig_create_date = "NEW".original_create_date
      WHERE OpenWorks_SM.HorizonData.horizon_data_id = "OLD".native_uid;
    END
END;

CREATE TRIGGER ON HorizonData3D INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC

DELETE from OpenWorks_SM.HorizonData WHERE OpenWorks_SM.HorizonData.horizon_data_id = "OLD".native_uid;

END;

/*
**********************************
*     "HorizonProperties3D"
**********************************
*/

CREATE VIEW HorizonProperties3D
(
	native_uid                      VARCHAR(1024)  OPTIONS("OpenWorksCommonModel:HorizonProperties3D.native_uid.isUpdatable" false,
                                                            "OpenWorksCommonModel:HorizonProperties3D.native_uid.isCreatable" false,
                                                            UPDATABLE 'FALSE'),
    parent_horizon_id                VARCHAR(1024),
    horizon_name                    VARCHAR(4000)   NOT NULL,
    data_source                     VARCHAR(4000)     NOT NULL,
    horizon_attribute_name          VARCHAR(4000)   NOT NULL,
    interpretation_version_name     VARCHAR(4000)   NOT NULL,
    interpretation_status           VARCHAR(4000),
    horizon_class                   VARCHAR(4000),
    pick_surface_name               VARCHAR(4000),
    seis_pick_onset                 VARCHAR(4000),
    line_style                      INTEGER,
    line_weight                     INTEGER,
    line_color                      INTEGER,
    line_color_r                    INTEGER,
    line_color_g                    INTEGER,
    line_color_b                    INTEGER,
    horizon_alias                   VARCHAR(4000),
    horizon_mean                    DOUBLE          OPTIONS("OpenWorksCommonModel:HorizonProperties3D.horizon_mean.unitField" 'horizon_mean_unit',
                                                            "OpenWorksCommonModel:HorizonProperties3D.horizon_mean.isUpdatable" false,
                                                            "OpenWorksCommonModel:HorizonProperties3D.horizon_mean.isCreatable" false,
                                                            UPDATABLE 'FALSE'),
    horizon_mean_unit               VARCHAR(4000)   OPTIONS("OpenWorksCommonModel:HorizonProperties3D.horizon_mean_unit.unitTypeAttribute" 'unit_type',
                                                            "OpenWorksCommonModel:HorizonProperties3D.horizon_mean_unit.isUpdatable" false,
                                                            "OpenWorksCommonModel:HorizonProperties3D.horizon_mean_unit.isCreatable" false,
                                                            UPDATABLE 'FALSE'),
    horizon_min                     DOUBLE          OPTIONS("OpenWorksCommonModel:HorizonProperties3D.horizon_min.unitField" 'horizon_min_unit',
                                                            "OpenWorksCommonModel:HorizonProperties3D.horizon_min.isUpdatable" false,
                                                            "OpenWorksCommonModel:HorizonProperties3D.horizon_min.isCreatable" false,
                                                            UPDATABLE 'FALSE'),
    horizon_min_unit                VARCHAR(4000)   OPTIONS("OpenWorksCommonModel:HorizonProperties3D.horizon_min_unit.unitTypeAttribute"  'unit_type',
                                                            "OpenWorksCommonModel:HorizonProperties3D.horizon_min_unit.isUpdatable" false,
                                                            "OpenWorksCommonModel:HorizonProperties3D.horizon_min_unit.isCreatable" false,
                                                            UPDATABLE 'FALSE'),
    horizon_max                     DOUBLE          OPTIONS("OpenWorksCommonModel:HorizonProperties3D.horizon_max.unitField" 'horizon_max_unit',
                                                            "OpenWorksCommonModel:HorizonProperties3D.horizon_max.isUpdatable" false,
                                                            "OpenWorksCommonModel:HorizonProperties3D.horizon_max.isCreatable" false,
                                                            UPDATABLE 'FALSE'),
    horizon_max_unit                VARCHAR(4000)   OPTIONS("OpenWorksCommonModel:HorizonProperties3D.horizon_max_unit.unitTypeAttribute"  'unit_type',
                                                            "OpenWorksCommonModel:HorizonProperties3D.horizon_max_unit.isUpdatable" false,
                                                            "OpenWorksCommonModel:HorizonProperties3D.horizon_max_unit.isCreatable" false,
                                                            UPDATABLE 'FALSE'),
    horizon_min_trace               INTEGER         OPTIONS("OpenWorksCommonModel:HorizonProperties3D.horizon_min_trace.isUpdatable" false,
                                                            "OpenWorksCommonModel:HorizonProperties3D.horizon_min_trace.isCreatable" false,
                                                            UPDATABLE 'FALSE'),
    horizon_max_trace               INTEGER         OPTIONS("OpenWorksCommonModel:HorizonProperties3D.horizon_max_trace.isUpdatable" false,
                                                            "OpenWorksCommonModel:HorizonProperties3D.horizon_max_trace.isCreatable" false,
                                                            UPDATABLE 'FALSE'),
    name_of_data_repository         VARCHAR(4000)   OPTIONS("OpenWorksCommonModel:HorizonProperties3D.name_of_data_repository.isUpdatable" false,
                                                            "OpenWorksCommonModel:HorizonProperties3D.name_of_data_repository.isCreatable" false,
                                                            UPDATABLE 'FALSE'),
    percent_coverage                DOUBLE          OPTIONS("OpenWorksCommonModel:HorizonProperties3D.percent_coverage.unitField" 'percent_coverage_unit',
                                                            "OpenWorksCommonModel:HorizonProperties3D.percent_coverage.isUpdatable" false,
                                                            "OpenWorksCommonModel:HorizonProperties3D.percent_coverage.isCreatable" false,
                                                            UPDATABLE 'FALSE'),
    percent_coverage_unit           VARCHAR(4000)   OPTIONS("OpenWorksCommonModel:HorizonProperties3D.percent_coverage_unit.unitType"      'percent',
                                                            "OpenWorksCommonModel:HorizonProperties3D.percent_coverage_unit.isUpdatable" false,
                                                            "OpenWorksCommonModel:HorizonProperties3D.percent_coverage_unit.isCreatable" false,
                                                            UPDATABLE 'FALSE'),
    total_samples                   INTEGER DEFAULT '0' OPTIONS("OpenWorksCommonModel:HorizonProperties3D.total_samples.isUpdatable" false,
                                                                "OpenWorksCommonModel:HorizonProperties3D.total_samples.isCreatable" false,
                                                                UPDATABLE 'FALSE'),
    data_id                         VARCHAR(4000)   OPTIONS("OpenWorksCommonModel:HorizonProperties3D.data_id.isUpdatable" false,
                                                               "OpenWorksCommonModel:HorizonProperties3D.data_id.isCreatable" false,
                                                               UPDATABLE 'FALSE'),
    datum                           FLOAT           OPTIONS("OpenWorksCommonModel:HorizonProperties3D.datum.unitField" 'z_datum_unit'),
    z_datum_unit                    VARCHAR(4000)   OPTIONS("OpenWorksCommonModel:HorizonProperties3D.z_datum_unit.unitType" 'elevation'),
    data_domain                     VARCHAR(4000),
    z_domain_qualifier              VARCHAR(4000),

    data                            BLOB              OPTIONS( "OpenWorksCommonModel:HorizonProperties3D.data.isMedia" true,
                                                               "OpenWorksCommonModel:HorizonProperties3D.data.mediaContentType" 'application/octet-stream',
                                                               "OpenWorksCommonModel:HorizonProperties3D.data.elementType"   'arrayfloat',
                                                               "OpenWorksCommonModel:HorizonProperties3D.data.isPrimitiveArray"   true,
                                                               "OpenWorksCommonModel:HorizonProperties3D.data.unitField"         'data_unit'),


    data_unit                       VARCHAR(4000)   OPTIONS("OpenWorksCommonModel:HorizonProperties3D.data_unit.unitTypeAttribute" 'unit_type'),
    unit_type                       VARCHAR(4000),
    original_create_date            TIMESTAMP,
    remark                          VARCHAR(4000),
    create_date                     TIMESTAMP,
    create_user_id                  VARCHAR(4000),
    update_date                     TIMESTAMP,
    update_user_id                  VARCHAR(4000),
    alternate_uid    		                VARCHAR(4000)  OPTIONS ("OpenWorksCommonModel:HorizonProperties3D.alternate_uid.isCreatable" false,
                                                            "OpenWorksCommonModel:HorizonProperties3D.alternate_uid.isUpdatable" false,
                                                            UPDATABLE 'FALSE'),

    CONSTRAINT HorizonProperties3D_PK PRIMARY KEY (native_uid),

    CONSTRAINT HorizonProperties3D_UK1 UNIQUE (parent_horizon_id, horizon_name, data_source, horizon_attribute_name, interpretation_version_name),

    CONSTRAINT FK_HorizonProperties3D_data_source
        FOREIGN KEY (data_source)
        REFERENCES DataSource(name),

    CONSTRAINT FK_HorizonProperties3D_parent_horizon_id
        FOREIGN KEY (parent_horizon_id)
        REFERENCES HorizonData3D(native_uid)

)
OPTIONS (UPDATABLE 'TRUE', HorizonProperties3D.IMPLEMENTED 'TRUE')
AS
SELECT
        OpenWorks_SM.HorizonData.horizon_data_id AS native_uid,
        (call GetParentId(OpenWorks_SM.HorizonData.seis_geom_set_id,HAHdr.horizon_name,HAHdr.data_source,HAHdr.interpretation_version_name)) AS parent_horizon_id,
        HAHdr.horizon_name AS horizon_name ,
        HAHdr.data_source AS  data_source ,
        HAHdr.horizon_attr_name AS horizon_attribute_name,
        HAHdr.interpretation_version_name AS interpretation_version_name,
        OpenWorks_SM.HorizonData.interpretation_status AS  interpretation_status,
        HAHdr.horizon_class AS horizon_class,
        HAHdr.pick_surf_name AS pick_surface_name,
        HAHdr.seis_pick_onset AS seis_pick_onset,
        HAHdr.line_style AS line_style,
        HAHdr.line_weight AS line_weight,
        HAHdr.line_color AS line_color,
        HAHdr.line_color_r AS line_color_r,
        HAHdr.line_color_g AS line_color_g,
        HAHdr.line_color_b AS line_color_b,
        OpenWorks_SM.HorizonData.horizon_alias AS horizon_alias,
        OpenWorks_SM.HorizonData.horizon_mean AS horizon_mean,
        OpenWorks_SM.HorizonData.horizon_mean_dsdsunit AS horizon_mean_unit,
        OpenWorks_SM.HorizonData.horizon_min AS horizon_min,
        OpenWorks_SM.HorizonData.horizon_min_dsdsunit AS horizon_min_unit,
        OpenWorks_SM.HorizonData.horizon_max AS horizon_max,
        OpenWorks_SM.HorizonData.horizon_max_dsdsunit AS horizon_max_unit,
        OpenWorks_SM.HorizonData.horizon_min_trace AS horizon_min_trace,
        OpenWorks_SM.HorizonData.horizon_max_trace AS horizon_max_trace,
        OpenWorks_SM.HorizonData.name_of_data_rep AS name_of_data_repository,
        OpenWorks_SM.HorizonData.percent_coverage AS percent_coverage,
        OpenWorks_SM.HorizonData.percent_coverage_dsdsunit AS percent_coverage_unit,
        OpenWorks_SM.HorizonData.total_samples AS total_samples,
        OpenWorks_SM.HorizonData.data_id AS data_id,
        OpenWorks_SM.HorizonData.working_datum AS datum,
        OpenWorks_SM.HorizonData.working_datum_dsdsunit AS z_datum_unit,
        OpenWorks_SM.HorizonData.data_domain AS data_domain,
        HAHdr.z_domain_qualifier AS z_domain_qualifier,
        OpenWorks_SM.HorizonData."data" AS data,
        OpenWorks_SM.HorizonData.values_dsdsunit AS data_unit,
        OpenWorks_SM.HorizonData.unit_type_id AS unit_type,
        OpenWorks_SM.HorizonData.orig_create_date AS original_create_date,
        OpenWorks_SM.HorizonData.remark AS remark,
        OpenWorks_SM.HorizonData.create_date AS create_date,
        OpenWorks_SM.HorizonData.create_user_id AS create_user_id ,
        OpenWorks_SM.HorizonData.update_date AS update_date,
        OpenWorks_SM.HorizonData.update_user_id AS update_user_id,
		OpenWorks_SM.HorizonData.native_uid AS alternate_uid
    FROM
    OpenWorks_SM.HorizonData , OpenWorks_SM.Seis3DSurvey , OpenWorks_SM.HorizonAttributeHdr AS HAHdr
    where
    OpenWorks_SM.HorizonData.seis_geom_set_id= OpenWorks_SM.Seis3DSurvey.seis_geom_set_id
    AND OpenWorks_SM.HorizonData.horizon_attr_hdr_id = HAHdr.horizon_attr_hdr_id
    AND HAHdr.horizon_attr_name NOT IN ('TIME_STRUCTURE', 'DEPTH_STRUCTURE')
	AND OpenWorks_SM.HorizonData.geom_set_type='3D Survey' AND (call GetParentId(OpenWorks_SM.HorizonData.seis_geom_set_id,HAHdr.horizon_name,HAHdr.data_source,HAHdr.interpretation_version_name)) is not null;


CREATE TRIGGER ON HorizonProperties3D INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC

    DECLARE string VARIABLES.horizon_attr_hdr_id_errorMsg='ERROR: The HorizonAttributeHdr with given values for (horizon_name,data_source,horizon_attribute_name,interpretation_version_name) does not exist';
    DECLARE string VARIABLES.seis_geom_set_id_errorMsg='ERROR: The seis_geom_set_id with given values for (seismic_line_name,seismic_survey_name) does not exist';

    DECLARE string VARIABLES.horizon_errorMsg='ERROR: Attribute Name should not be TIME_STRUCTURE or DEPTH_STRUCTURE for property horizon';
        IF("NEW".horizon_attribute_name IN('TIME_STRUCTURE', 'DEPTH_STRUCTURE'))
        BEGIN
            ERROR VARIABLES.horizon_errorMsg;
        END

    DECLARE integer VARIABLES.horizon_data_id = (SELECT * FROM (EXEC OpenWorks_SM.nextval('HorizonData')) AS SysGenID);

    DECLARE string VARIABLES.horizon_attr_hdr_id= null;

    VARIABLES.horizon_attr_hdr_id = (SELECT OpenWorks_SM.HorizonAttributeHdr.horizon_attr_hdr_id FROM OpenWorks_SM.HorizonAttributeHdr WHERE (OpenWorks_SM.HorizonAttributeHdr.horizon_name = SUBSTRING("NEW".horizon_name, 1, 60)) AND (OpenWorks_SM.HorizonAttributeHdr.data_source = SUBSTRING("NEW".data_source, 1, 5)) AND (OpenWorks_SM.HorizonAttributeHdr.horizon_attr_name = SUBSTRING("NEW".horizon_attribute_name, 1, 40)) AND (OpenWorks_SM.HorizonAttributeHdr.interpretation_version_name = SUBSTRING("NEW".interpretation_version_name, 1, 40)));

    DECLARE string VARIABLES.seis_geom_set_id = null;
    IF(VARIABLES.horizon_attr_hdr_id IS NULL)
    BEGIN
        INSERT INTO OpenWorks_SM.HorizonAttributeHdr(horizon_name, data_source, horizon_attr_name, interpretation_version_name)
         values(SUBSTRING("NEW".horizon_name, 1, 60), SUBSTRING("NEW".data_source, 1, 5), SUBSTRING("NEW".horizon_attribute_name, 1, 40), SUBSTRING("NEW".interpretation_version_name, 1, 40));

        VARIABLES.horizon_attr_hdr_id = (SELECT OpenWorks_SM.HorizonAttributeHdr.horizon_attr_hdr_id FROM OpenWorks_SM.HorizonAttributeHdr WHERE (OpenWorks_SM.HorizonAttributeHdr.horizon_name = SUBSTRING("NEW".horizon_name, 1, 60)) AND (OpenWorks_SM.HorizonAttributeHdr.data_source = SUBSTRING("NEW".data_source, 1, 5)) AND (OpenWorks_SM.HorizonAttributeHdr.horizon_attr_name = SUBSTRING("NEW".horizon_attribute_name, 1, 40)) AND (OpenWorks_SM.HorizonAttributeHdr.interpretation_version_name = SUBSTRING("NEW".interpretation_version_name, 1, 40)));

    END

    DECLARE string VARIABLES.seismic3dsurvey_native_uid = select hd.seis_geom_set_id from OpenWorks_SM.HorizonData hd where hd.horizon_data_id="NEW".parent_horizon_id;

    DECLARE string VARIABLES.seismic_data_set_id = null;

    INSERT INTO OpenWorks_SM.HorizonData (OpenWorks_SM.HorizonData.horizon_data_id, OpenWorks_SM.HorizonData.horizon_attr_hdr_id, OpenWorks_SM.HorizonData.seismic_data_set_id, OpenWorks_SM.HorizonData.seis_geom_set_id, OpenWorks_SM.HorizonData.interpretation_status, OpenWorks_SM.HorizonData.data_source, OpenWorks_SM.HorizonData.horizon_alias, OpenWorks_SM.HorizonData.storage_datum, OpenWorks_SM.HorizonData.storage_datum_dsdsunit, OpenWorks_SM.HorizonData.values_storage_uom, OpenWorks_SM.HorizonData.remark, OpenWorks_SM.HorizonData."data", OpenWorks_SM.HorizonData.orig_create_date, OpenWorks_SM.HorizonData.geom_set_type)
                                  VALUES (VARIABLES.horizon_data_id,                VARIABLES.horizon_attr_hdr_id,                VARIABLES.seismic_data_set_id,                VARIABLES.seismic3dsurvey_native_uid,      SUBSTRING("NEW".interpretation_status,1,12),    SUBSTRING("NEW".data_source,1,5),     SUBSTRING("NEW".horizon_alias,1,60),    "NEW".datum,                            NEW.z_datum_unit,                                NEW.data_unit,                               SUBSTRING("NEW".remark,1,200),   "NEW".data,                      "NEW".original_create_date,                '3D Survey');
END;



CREATE TRIGGER ON HorizonProperties3D INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC
DECLARE string VARIABLES.horizon_attr_hdr_id_errorMsg='ERROR: The HorizonAttributeHdr with given values for (horizon_name,data_source,horizon_attribute_name,interpretation_version_name) does not exist';
    DECLARE string VARIABLES.seis_geom_set_id_errorMsg='ERROR: The seis_geom_set_id with given values for (seismic_line_name,seismic_survey_name) does not exist';
    DECLARE string VARIABLES.horizon_data_id_errorMsg='ERROR: The HorizonProperties3D with given values for (horizon_name,data_source,horizon_attribute_name,interpretation_version_name,seismic_line_name,seismic_survey_name) does not exist';

   DECLARE string VARIABLES.horizon_errorMsg='ERROR: Attribute Name should not be TIME_STRUCTURE or DEPTH_STRUCTURE for property horizon';
        IF("NEW".horizon_attribute_name IN('TIME_STRUCTURE', 'DEPTH_STRUCTURE'))
        BEGIN
            ERROR VARIABLES.horizon_errorMsg;
        END

    DECLARE string VARIABLES.horizon_attr_hdr_id;
    VARIABLES.horizon_attr_hdr_id= (SELECT OpenWorks_SM.HorizonAttributeHdr.horizon_attr_hdr_id FROM OpenWorks_SM.HorizonAttributeHdr WHERE (OpenWorks_SM.HorizonAttributeHdr.horizon_name = SUBSTRING("OLD".horizon_name, 1, 60)) AND (OpenWorks_SM.HorizonAttributeHdr.data_source = SUBSTRING("OLD".data_source, 1, 5)) AND (OpenWorks_SM.HorizonAttributeHdr.horizon_attr_name = SUBSTRING("OLD".horizon_attribute_name, 1, 40)) AND (OpenWorks_SM.HorizonAttributeHdr.interpretation_version_name = SUBSTRING("OLD".interpretation_version_name, 1, 40)));

    IF(VARIABLES.horizon_attr_hdr_id IS NULL)  ERROR VARIABLES.horizon_attr_hdr_id_errorMsg;

    DECLARE string VARIABLES.seis_geom_set_id = null;
    DECLARE string VARIABLES.seismic_data_set_id = null;
    DECLARE string VARIABLES.seismic3dsurvey_native_uid = select hd.seis_geom_set_id from OpenWorks_SM.HorizonData hd where hd.horizon_data_id="NEW".parent_horizon_id;

    /*
    DECLARE integer VARIABLES.horizon_data_id = (SELECT CONVERT(horizon_data_id,Integer) FROM OpenWorks_SM.HorizonData WHERE horizon_attr_hdr_id = VARIABLES.horizon_attr_hdr_id and seis_geom_set_id=VARIABLES.seis_geom_set_id);

    IF(VARIABLES.horizon_data_id IS NULL)
      ERROR VARIABLES.horizon_data_id_errorMsg;
    */

    UPDATE OpenWorks_SM.HorizonData SET
        seis_geom_set_id=VARIABLES.seismic3dsurvey_native_uid,
        horizon_attr_hdr_id=VARIABLES.horizon_attr_hdr_id,
        data="NEW".data,
        seismic_data_set_id = VARIABLES.seismic_data_set_id,
        interpretation_status = SUBSTRING("NEW".interpretation_status,1,12),
        horizon_alias = SUBSTRING("NEW".horizon_alias,1,60),
        storage_datum = "NEW".datum,
        storage_datum_dsdsunit = "NEW".z_datum_unit,
        values_storage_uom = "NEW".data_unit,
        remark = SUBSTRING("NEW".remark,1,200),
        geom_set_type = '3D Survey',
        orig_create_date = "NEW".original_create_date
    WHERE OpenWorks_SM.HorizonData.horizon_data_id = "OLD".native_uid;

END;

CREATE TRIGGER ON HorizonProperties3D INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC

DELETE from OpenWorks_SM.HorizonData WHERE OpenWorks_SM.HorizonData.horizon_data_id = "OLD".native_uid;

END;

/*
**********************************
*     "FaultPlane"
**********************************
*/
CREATE VIEW FaultPlane
(
  native_uid                    VARCHAR(1024) OPTIONS("OpenWorksCommonModel:FaultPlane.native_uid.isUpdatable" false,
                                                      "OpenWorksCommonModel:FaultPlane.native_uid.isCreatable" false,UPDATABLE 'FALSE'),
  fault_name                    VARCHAR(50) NOT NULL DEFAULT 'UNKNOWN',
  data_source                   VARCHAR(5) NOT NULL,
  original_data_source          VARCHAR(5),
  interpretation_version_name   VARCHAR(40) NOT NULL DEFAULT 'UNKNOWN',
  interpretation_status         VARCHAR(12) DEFAULT 'UNKNOWN',
  z_domain                      VARCHAR(12) NOT NULL,
  z_domain_qualifier            VARCHAR(24),
  segment_modification_date     TIMESTAMP,

  enable_triangulation          VARCHAR(1)  DEFAULT 'Y',
  remark                        VARCHAR(200),

  create_date                   TIMESTAMP   OPTIONS("OpenWorksCommonModel:FaultPlane.create_date.isUpdatable" false,
                                                    "OpenWorksCommonModel:FaultPlane.create_date.isCreatable" false,
                                                     UPDATABLE 'FALSE'),
  create_user_id                VARCHAR(32) OPTIONS("OpenWorksCommonModel:FaultPlane.create_user_id.isUpdatable" false,
                                                    "OpenWorksCommonModel:FaultPlane.create_user_id.isCreatable" false,
                                                     UPDATABLE 'FALSE'),
  update_date                   TIMESTAMP   OPTIONS("OpenWorksCommonModel:FaultPlane.update_date.isUpdatable" false,
                                                    "OpenWorksCommonModel:FaultPlane.update_date.isCreatable" false,
                                                     UPDATABLE 'FALSE'),
  update_user_id                VARCHAR(32) OPTIONS("OpenWorksCommonModel:FaultPlane.update_user_id.isUpdatable" false,
                                                    "OpenWorksCommonModel:FaultPlane.update_user_id.isCreatable" false,
                                                     UPDATABLE 'FALSE'),
  alternate_uid    		            VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:FaultPlane.alternate_uid.isCreatable" false,
                                                       "OpenWorksCommonModel:FaultPlane.alternate_uid.isUpdatable" false,
                                                        UPDATABLE 'FALSE'),
  crs                           VARCHAR(80),

    CONSTRAINT FaultPlane_PK PRIMARY KEY (native_uid),

    CONSTRAINT FaultPlane_UK1 UNIQUE (fault_name, data_source, interpretation_version_name),

    CONSTRAINT FK_FaultPlane_data_source
        FOREIGN KEY (data_source)
        REFERENCES DataSource(name),

    CONSTRAINT FK_FaultPlane_original_data_source
        FOREIGN KEY (original_data_source)
        REFERENCES DataSource(name),

	CONSTRAINT FK_FaultPlane_Fault
        FOREIGN KEY (fault_name)
        REFERENCES Fault(native_uid)

) OPTIONS(UPDATABLE 'TRUE',FaultPlane.IMPLEMENTED 'TRUE')
AS
SELECT
 OpenWorks_SM.FaultPlane.fault_plane_id AS native_uid,
 OpenWorks_SM.FaultPlane.fault_name,
 OpenWorks_SM.FaultPlane.data_source,
 OpenWorks_SM.FaultPlane.original_data_source,
 OpenWorks_SM.FaultPlane.interpretation_version_name,
 OpenWorks_SM.FaultPlane.interpretation_status,
 OpenWorks_SM.FaultPlane.z_domain,
 OpenWorks_SM.FaultPlane.z_domain_qualifier,
 OpenWorks_SM.FaultPlane.segment_modification_date,
 OpenWorks_SM.FaultPlane.enable_triangulation,
 OpenWorks_SM.FaultPlane.remark,
 OpenWorks_SM.FaultPlane.create_date,
 OpenWorks_SM.FaultPlane.create_user_id,
 OpenWorks_SM.FaultPlane.update_date,
 OpenWorks_SM.FaultPlane.update_user_id,
 OpenWorks_SM.FaultPlane.native_uid,
 getDSDSCrs(tmptbl.name)
FROM OpenWorks_SM.FaultPlane
LEFT OUTER JOIN 
(select distinct OpenWorks_SM.FaultSegment.fault_plane_id, OpenWorks_SM.CartoRefSys.name 
 from OpenWorks_SM.FaultSegment LEFT OUTER JOIN OpenWorks_SM.CartoRefSys ON OpenWorks_SM.FaultSegment.crs_id = OpenWorks_SM.CartoRefSys.id)
 AS tmptbl ON OpenWorks_SM.FaultPlane.fault_plane_id = tmptbl.fault_plane_id;

CREATE TRIGGER ON FaultPlane INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC
    DECLARE integer VARIABLES.fault_plane_id = (SELECT * FROM (EXEC OpenWorks_SM.nextval('FaultPlane')) AS SysGenID);
    INSERT INTO OpenWorks_SM.FaultPlane (OpenWorks_SM.FaultPlane.fault_plane_id, OpenWorks_SM.FaultPlane.fault_name, OpenWorks_SM.FaultPlane.data_source, OpenWorks_SM.FaultPlane.original_data_source, OpenWorks_SM.FaultPlane.interpretation_version_name, OpenWorks_SM.FaultPlane.interpretation_status, OpenWorks_SM.FaultPlane.z_domain, OpenWorks_SM.FaultPlane.z_domain_qualifier,  OpenWorks_SM.FaultPlane.enable_triangulation, OpenWorks_SM.FaultPlane.remark) VALUES (VARIABLES.fault_plane_id, SUBSTRING("NEW".fault_name, 1, 50), SUBSTRING("NEW".data_source, 1, 5), SUBSTRING("NEW".original_data_source, 1, 5), NVL(SUBSTRING("NEW".interpretation_version_name, 1, 40), 'UNKNOWN'), NVL(SUBSTRING("NEW".interpretation_status, 1, 12), 'UNKNOWN'), SUBSTRING("NEW".z_domain, 1, 12), SUBSTRING("NEW".z_domain_qualifier, 1, 24),  "NEW".enable_triangulation, SUBSTRING("NEW".remark, 1, 200));
END;

CREATE TRIGGER ON FaultPlane INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC
    BEGIN
        UPDATE OpenWorks_SM.FaultPlane SET original_data_source = SUBSTRING("NEW".original_data_source, 1, 5), interpretation_status = NVL(SUBSTRING("NEW".interpretation_status, 1, 12), 'UNKNOWN'), z_domain = SUBSTRING("NEW".z_domain, 1, 12), z_domain_qualifier = SUBSTRING("NEW".z_domain_qualifier, 1, 24), enable_triangulation = "NEW".enable_triangulation, remark = SUBSTRING("NEW".remark, 1, 200) WHERE OpenWorks_SM.FaultPlane.fault_plane_id = "OLD".native_uid;
    END
END;

CREATE TRIGGER ON FaultPlane INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC
    DELETE FROM OpenWorks_SM.FaultPlane WHERE OpenWorks_SM.FaultPlane.fault_plane_id = "OLD".native_uid;
END;

/*
**********************************
*     "FaultSegment"
**********************************
*/

CREATE VIEW FaultSegment
(
  native_uid                     VARCHAR(1024)   OPTIONS("OpenWorksCommonModel:FaultSegment.native_uid.isUpdatable" false,
                                                            "OpenWorksCommonModel:FaultSegment.native_uid.isCreatable" false,
                                                            UPDATABLE 'FALSE'),
  faultplane_native_uid          VARCHAR(1024),
  fault_name                     VARCHAR(50)     OPTIONS("OpenWorksCommonModel:FaultSegment.fault_name.isUpdatable" false,
                                                            "OpenWorksCommonModel:FaultSegment.fault_name.isCreatable" false,
                                                            UPDATABLE 'FALSE'),
 fault_plane_version             VARCHAR(40)     OPTIONS("OpenWorksCommonModel:FaultSegment.fault_plane_version.isUpdatable" false,
                                                            "OpenWorksCommonModel:FaultSegment.fault_plane_version.isCreatable" false,
                                                            UPDATABLE 'FALSE'),
  fault_plane_source              VARCHAR(5)      OPTIONS("OpenWorksCommonModel:FaultSegment.fault_plane_source.isUpdatable" false,
                                                            "OpenWorksCommonModel:FaultSegment.fault_plane_source.isCreatable" false,
                                                            UPDATABLE 'FALSE'),
  data_source                VARCHAR(5),
  seismic3dsurvey_native_uid      VARCHAR(1024),
  seismic_survey_3d_name          VARCHAR(4000)	  OPTIONS("OpenWorksCommonModel:FaultSegment.seismic_survey_3d_name.isUpdatable" false,
                                                            "OpenWorksCommonModel:FaultSegment.seismic_survey_3d_name.isCreatable" false,
                                                            UPDATABLE 'FALSE'),
  seis2dline_native_uid           VARCHAR(1024),
  seismic_line_name               VARCHAR(40)	  OPTIONS("OpenWorksCommonModel:FaultSegment.seismic_line_name.isUpdatable" false,
                                                            "OpenWorksCommonModel:FaultSegment.seismic_line_name.isCreatable" false,
                                                            UPDATABLE 'FALSE'),
  seismic_survey_2d_name          VARCHAR(4000)	  OPTIONS("OpenWorksCommonModel:FaultSegment.seismic_survey_2d_name.isUpdatable" false,
                                                            "OpenWorksCommonModel:FaultSegment.seismic_survey_2d_name.isCreatable" false,
                                                            UPDATABLE 'FALSE'),
  horizon_name                    VARCHAR(60)     OPTIONS("OpenWorksCommonModel:FaultSegment.horizon_name.isUpdatable" false,
                                                            "OpenWorksCommonModel:FaultSegment.horizon_name.isCreatable" false,
                                                            UPDATABLE 'FALSE'),
  header_source                   VARCHAR(5)      OPTIONS("OpenWorksCommonModel:FaultSegment.header_source.isUpdatable" false,
                                                            "OpenWorksCommonModel:FaultSegment.header_source.isCreatable" false,
                                                            UPDATABLE 'FALSE'),
  attribute_name                  VARCHAR(40)     OPTIONS("OpenWorksCommonModel:FaultSegment.attribute_name.isUpdatable" false,
                                                            "OpenWorksCommonModel:FaultSegment.attribute_name.isCreatable" false,
                                                            UPDATABLE 'FALSE'),
  header_version                  VARCHAR(40)     OPTIONS("OpenWorksCommonModel:FaultSegment.header_version.isUpdatable" false,
                                                            "OpenWorksCommonModel:FaultSegment.header_version.isCreatable" false,
                                                            UPDATABLE 'FALSE'),
  geometry_set_type          VARCHAR(12),
  bounding_pt1_x             DOUBLE,
  bounding_pt1_y             DOUBLE,
  bounding_pt2_x             DOUBLE,
  bounding_pt2_y             DOUBLE,
  bounding_pt3_x             DOUBLE,
  bounding_pt3_y             DOUBLE,
  bounding_pt4_x             DOUBLE,
  bounding_pt4_y             DOUBLE,
  min_x                      DOUBLE      NOT NULL    OPTIONS ("OpenWorksCommonModel:FaultSegment.min_x.unitField" 'xy_unit'),
  max_x                      DOUBLE      NOT NULL    OPTIONS ("OpenWorksCommonModel:FaultSegment.max_x.unitField" 'xy_unit'),
  min_y                      DOUBLE      NOT NULL    OPTIONS ("OpenWorksCommonModel:FaultSegment.min_y.unitField" 'xy_unit'),
  max_y                      DOUBLE      NOT NULL    OPTIONS ("OpenWorksCommonModel:FaultSegment.max_y.unitField" 'xy_unit'),
  min_z                      DOUBLE      NOT NULL    OPTIONS ("OpenWorksCommonModel:FaultSegment.min_z.unitField" 'z_unit'),
  max_z                      DOUBLE      NOT NULL    OPTIONS ("OpenWorksCommonModel:FaultSegment.max_z.unitField" 'z_unit'),
  crs                        VARCHAR(80) NOT NULL,
  z_domain                   VARCHAR(12) NOT NULL,
  z_domain_qualifier         VARCHAR(24),
  datum                      DOUBLE                  OPTIONS ("OpenWorksCommonModel:FaultSegment.datum.unitField" 'datum_unit'),
  datum_unit                 VARCHAR(64)             OPTIONS ("OpenWorksCommonModel:FaultSegment.datum_unit.unitType" 'elevation'),
  xy_unit                    VARCHAR(64),
  z_unit                     VARCHAR(64) NOT NULL   OPTIONS ("OpenWorksCommonModel:FaultSegment.z_unit.unitType" 'time depth measure'),
  original_data_source       VARCHAR(5),
  number_of_points           INTEGER     DEFAULT '0' OPTIONS("OpenWorksCommonModel:FaultSegment.number_of_points.isUpdatable" false,
                                                            "OpenWorksCommonModel:FaultSegment.number_of_points.isCreatable" false,
                                                            UPDATABLE 'FALSE'),
  data                       blob        NOT NULL
                                         OPTIONS ("OpenWorksCommonModel:FaultSegment.data.isComplexType" true,
                                                  "OpenWorksCommonModel:FaultSegment.data.isComplexTypeArray" true,
                                                  "OpenWorksCommonModel:FaultSegment.data.elementType" 'ThreeSpaceCoordinate',
                                                  "OpenWorksCommonModel:FaultSegment.data.elementStruct" '[{"name":"x","type":"double[]"},{"name":"y","type":"double[]"},{"name":"z","type":"double[]"}]',
                                                  "OpenWorksCommonModel:FaultSegment.data.elementMetadata"    '[{"name":"x","unitField":"xy_unit"}, {"name":"y", "unitField":"xy_unit"}, {"name":"z", "unitField":"z_unit"}]'),
  remark                    VARCHAR(200),
  create_date                 TIMESTAMP   OPTIONS("OpenWorksCommonModel:FaultSegment.create_date.isUpdatable" false,
                                                 "OpenWorksCommonModel:FaultSegment.create_date.isCreatable" false,UPDATABLE 'FALSE'),
  create_user_id             VARCHAR(32) OPTIONS("OpenWorksCommonModel:FaultSegment.create_user_id.isUpdatable" false,
                                                 "OpenWorksCommonModel:FaultSegment.create_user_id.isCreatable" false,
                                                  UPDATABLE 'FALSE'),
  update_date                TIMESTAMP   OPTIONS("OpenWorksCommonModel:FaultSegment.update_date.isUpdatable" false,
                                                 "OpenWorksCommonModel:FaultSegment.update_date.isCreatable" false,UPDATABLE 'FALSE'),
  update_user_id             VARCHAR(32) OPTIONS("OpenWorksCommonModel:FaultSegment.update_user_id.isUpdatable" false,
                                                 "OpenWorksCommonModel:FaultSegment.update_user_id.isCreatable" false,
                                                  UPDATABLE 'FALSE'),
  alternate_uid    		             VARCHAR(4000)    OPTIONS ("OpenWorksCommonModel:FaultSegment.alternate_uid.isCreatable" false,
                                                           "OpenWorksCommonModel:FaultSegment.alternate_uid.isUpdatable" false,
                                                           UPDATABLE 'FALSE'),

    CONSTRAINT FaultSegment_PK PRIMARY KEY (native_uid),

    CONSTRAINT FK_FaultSegment_faultplane_native_uid
        FOREIGN KEY          (faultplane_native_uid)
        REFERENCES FaultPlane(native_uid),

    CONSTRAINT FK_FaultSegment_seismic3dsurvey_native_uid
        FOREIGN KEY                (seismic3dsurvey_native_uid)
        REFERENCES Seismic3DSurvey (native_uid),

    CONSTRAINT FK_FaultSegment_seis2dline_native_uid
        FOREIGN KEY          (seis2dline_native_uid)
        REFERENCES Seis2DLine(native_uid),

  CONSTRAINT FK_FaultSegment_fault_plane_source
      FOREIGN KEY (fault_plane_source)
      REFERENCES DataSource(name),

  CONSTRAINT FK_FaultSegment_data_source
      FOREIGN KEY (data_source)
      REFERENCES DataSource(name),

  CONSTRAINT FK_FaultSegment_original_data_source
      FOREIGN KEY (original_data_source)
      REFERENCES DataSource(name)

)
OPTIONS (UPDATABLE 'TRUE',FaultSegment.IMPLEMENTED 'TRUE',FaultSegment.ODATAREADBACK 'FALSE')
AS
SELECT
CONVERT(fault_segment_id,VARCHAR(1024)),
CONVERT(OpenWorks_SM.FaultPlane.fault_plane_id,VARCHAR(1024)),
fault_name,
OpenWorks_SM.FaultPlane.interpretation_version_name AS fault_plane_version,
OpenWorks_SM.FaultPlane.data_source AS fault_plane_source,
OpenWorks_SM.FaultSegment.data_source,
CONVERT(OpenWorks_SM.Seis3DSurvey.seis_geom_set_id,VARCHAR(1024)),
OpenWorks_SM.Seis3DSurvey.seis_geom_set_nm,
CONVERT(GEOMSETID,VARCHAR(1024)),
Line AS seismic_line_name,
Survey AS seismic_survey_2d_name,
horizon_name,
OpenWorks_SM.HorizonAttributeHdr.data_source AS header_source,
horizon_attr_name AS attribute_name,
OpenWorks_SM.HorizonAttributeHdr.interpretation_version_name AS header_version,
geom_set_type,
bounding_pt1_x,
bounding_pt1_y,
bounding_pt2_x,
bounding_pt2_y,
bounding_pt3_x,
bounding_pt3_y,
bounding_pt4_x,
bounding_pt4_y,
min_x,
max_x,
min_y,
max_y,
min_z,
max_z,
getDSDSCrs(name) AS crs,
OpenWorks_SM.FaultSegment.z_domain,
OpenWorks_SM.FaultSegment.z_domain_qualifier,
working_datum AS datum,
working_datum_dsdsunit AS datum_unit,
bounding_pt1_x_dsdsunit AS xy_unit,
min_z_dsdsunit AS z_unit,
OpenWorks_SM.FaultSegment.original_data_source,
number_of_points,
"values" as data,
null AS remark,
OpenWorks_SM.FaultSegment.create_date,
OpenWorks_SM.FaultSegment.create_user_id,
OpenWorks_SM.FaultSegment.update_date,
OpenWorks_SM.FaultSegment.update_user_id,
OpenWorks_SM.FaultSegment.native_uid
    FROM
        ((((OpenWorks_SM.FaultSegment LEFT OUTER JOIN /*+ MAKENOTDEP */ OpenWorks_SM.FaultPlane ON OpenWorks_SM.FaultSegment.fault_plane_id = OpenWorks_SM.FaultPlane.fault_plane_id) LEFT OUTER JOIN (SELECT Geom2DLine.SEIS_GEOM_SET_ID AS GEOMSETID, Geom2DLine.SEIS_GEOM_SET_NM AS Line, Geom2DSurvey.SEIS_GEOM_SET_NM AS Survey FROM OpenWorks_SM.Seis2DLine AS Geom2DLine, Openworks_SM.SeisGeomSet2DSurvey AS Geom2DSurvey WHERE COMPONENT_GEOM_ID = Geom2DSurvey.SEIS_GEOM_SET_ID) AS GEOM2DLine ON seis_geom_set_id = GEOMSETID) LEFT OUTER JOIN OpenWorks_SM.Seis3DSurvey ON OpenWorks_SM.FaultSegment.seis_geom_set_id = OpenWorks_SM.Seis3DSurvey.seis_geom_set_id) LEFT OUTER JOIN OpenWorks_SM.HorizonAttributeHdr ON OpenWorks_SM.FaultSegment.horizon_attr_hdr_id = OpenWorks_SM.HorizonAttributeHdr.horizon_attr_hdr_id) LEFT OUTER JOIN OpenWorks_SM.CartoRefSys ON crs_id = id;


CREATE TRIGGER ON FaultSegment INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC
    DECLARE string VARIABLES.crs_errorMsg='ERROR: The given value for crs does not exist';
    DECLARE string VARIABLES.fault_plane_id_errorMsg='ERROR: The given FaultPlane does not exist';
    DECLARE string VARIABLES.horizon_attr_hdr_id_errorMsg='ERROR: The HorizonAttributeHdr with given values for (horizon_name,header_source,attribute_name,header_version) does not exist';


    DECLARE integer VARIABLES.fault_segment_id = (SELECT * FROM (EXEC OpenWorks_SM.nextval('FaultSegment')) AS SysGenID);
    DECLARE string VARIABLES.crs_id;
    DECLARE string VARIABLES.fault_plane_id;
    DECLARE string VARIABLES.horizon_attr_hdr_id;
    DECLARE string VARIABLES.seis_geom_set_id = null;

    IF("NEW".crs is NOT NULL)
    BEGIN
    VARIABLES.crs_id     = (SELECT id FROM OpenWorks_SM.CartoRefSys WHERE name = (SELECT * FROM (EXEC OpenWorks_SM.GetNativeCRS(SUBSTRING("NEW".crs, 1, 80), 'OW')) AS SysGenID));
    IF(VARIABLES.crs_id is NULL) ERROR VARIABLES.crs_errorMsg;
    END

    BEGIN
        VARIABLES.fault_plane_id= (SELECT fault_plane_id FROM OpenWorks_SM.FaultPlane WHERE fault_plane_id = "NEW".faultplane_native_uid);
    IF(VARIABLES.fault_plane_id is NULL) ERROR VARIABLES.fault_plane_id_errorMsg;
    END

    IF("NEW".geometry_set_type IS NOT NULL)
    BEGIN
        IF("NEW".geometry_set_type = '3D Survey')
        BEGIN
            VARIABLES.seis_geom_set_id = (SELECT seis_geom_set_id FROM OpenWorks_SM.Seis3DSurvey WHERE seis_geom_set_id = "NEW".seismic3dsurvey_native_uid);

        END
        IF("NEW".geometry_set_type = '2D Line')
        BEGIN
            VARIABLES.seis_geom_set_id = (SELECT seis_geom_set_id FROM OpenWorks_SM.Seis2DLine WHERE (seis_geom_set_id = "NEW".seis2dline_native_uid));

        END
    END

    INSERT INTO OpenWorks_SM.FaultSegment (fault_segment_id,fault_plane_id, data_source, seis_geom_set_id, geom_set_type, bounding_pt1_x, bounding_pt1_y, bounding_pt2_x, bounding_pt2_y, bounding_pt3_x, bounding_pt3_y, bounding_pt4_x, bounding_pt4_y, min_x, max_x, min_y, max_y, min_z, max_z, min_z_dsdsunit, max_z_dsdsunit, crs_id, z_domain, z_domain_qualifier, storage_datum, storage_datum_dsdsunit, original_data_source, number_of_points, "values") VALUES (VARIABLES.fault_segment_id ,VARIABLES.fault_plane_id, SUBSTRING("NEW".data_source, 1, 5), VARIABLES.seis_geom_set_id, "NEW".geometry_set_type, "NEW".bounding_pt1_x, "NEW".bounding_pt1_y, "NEW".bounding_pt2_x, "NEW".bounding_pt2_y, "NEW".bounding_pt3_x, "NEW".bounding_pt3_y, "NEW".bounding_pt4_x, "NEW".bounding_pt4_y, "NEW".min_x, "NEW".max_x, "NEW".min_y, "NEW".max_y, "NEW".min_z, "NEW".max_z, "NEW".z_unit, "NEW".z_unit, VARIABLES.crs_id, "NEW".z_domain, "NEW".z_domain_qualifier, "NEW".datum, "NEW".datum_unit, "NEW".original_data_source, sizeOfBlob("NEW".data), "NEW".data);
END;

CREATE TRIGGER ON FaultSegment INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC
    DECLARE string VARIABLES.crs_errorMsg='ERROR: The given value for crs does not exist';
    DECLARE string VARIABLES.fault_plane_id_errorMsg='ERROR: The FaultPlane with given values for (fault_name,fault_plane_source,fault_plane_version) does not exist';
    DECLARE string VARIABLES.horizon_attr_hdr_id_errorMsg='ERROR: The HorizonAttributeHdr with given values for (horizon_name,header_source,attribute_name,header_version) does not exist';

    DECLARE string VARIABLES.crs_id;
    DECLARE string VARIABLES.fault_plane_id;
    DECLARE string VARIABLES.horizon_attr_hdr_id;
    DECLARE string VARIABLES.seis_geom_set_id = null;

    IF("NEW".crs is NOT NULL)
    BEGIN
    VARIABLES.crs_id     = (SELECT id FROM OpenWorks_SM.CartoRefSys WHERE name = (SELECT * FROM (EXEC OpenWorks_SM.GetNativeCRS(SUBSTRING("NEW".crs, 1, 80),'OW')) AS SysGenID));
    IF(VARIABLES.crs_id is NULL) ERROR VARIABLES.crs_errorMsg;
    END
    IF(("NEW".fault_name is NOT NULL) AND ("NEW".fault_plane_source is NOT NULL ) AND ("NEW".fault_plane_version is NOT NULL))
    BEGIN
    VARIABLES.fault_plane_id= (SELECT fault_plane_id FROM OpenWorks_SM.FaultPlane WHERE fault_plane_id = "NEW".faultplane_native_uid);
    IF(VARIABLES.fault_plane_id is NULL) ERROR VARIABLES.fault_plane_id_errorMsg;
    END
    IF("NEW".geometry_set_type IS NOT NULL)
    BEGIN
        IF("NEW".geometry_set_type = '3D Survey')
        BEGIN
            VARIABLES.seis_geom_set_id = (SELECT seis_geom_set_id FROM OpenWorks_SM.Seis3DSurvey WHERE seis_geom_set_id = "NEW".seismic3dsurvey_native_uid);

        END
        IF("NEW".geometry_set_type = '2D Line')
        BEGIN
            VARIABLES.seis_geom_set_id = (SELECT seis_geom_set_id FROM OpenWorks_SM.Seis2DLine WHERE (seis_geom_set_id = "NEW".seis2dline_native_uid) AND (COMPONENT_GEOM_ID = (SELECT seis_geom_set_id FROM OpenWorks_SM.SeisGeomSet2DSurvey WHERE seis_geom_set_id = "NEW".seis2dline_native_uid)));

        END
    END

    UPDATE OpenWorks_SM.FaultSegment SET fault_plane_id = VARIABLES.fault_plane_id, data_source = SUBSTRING("NEW".data_source, 1, 5), seis_geom_set_id = VARIABLES.seis_geom_set_id, geom_set_type = "NEW".geometry_set_type, bounding_pt1_x = "NEW".bounding_pt1_x, bounding_pt1_y = "NEW".bounding_pt1_y, bounding_pt2_x = "NEW".bounding_pt2_x, bounding_pt2_y = "NEW".bounding_pt2_y, bounding_pt3_x = "NEW".bounding_pt3_x, bounding_pt3_y = "NEW".bounding_pt3_y, bounding_pt4_x = "NEW".bounding_pt4_x, bounding_pt4_y = "NEW".bounding_pt4_y, min_x = "NEW".min_x, max_x = "NEW".max_x, min_y = "NEW".min_y, max_y = "NEW".max_y, min_z = "NEW".min_z, max_z = "NEW".max_z, min_z_dsdsunit = "NEW".z_unit, max_z_dsdsunit = "NEW".z_unit, crs_id = VARIABLES.crs_id, z_domain = "NEW".z_domain, z_domain_qualifier = "NEW".z_domain_qualifier, storage_datum = "NEW".datum, storage_datum_dsdsunit = "NEW".datum_unit, original_data_source = "NEW".original_data_source, number_of_points = sizeOfBlob("NEW".data), "values" =  "NEW".data WHERE fault_segment_id = "OLD".native_uid;
END;


CREATE TRIGGER ON FaultSegment INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC
    DELETE FROM OpenWorks_SM.FaultSegment WHERE OpenWorks_SM.FaultSegment.fault_segment_id = "OLD".native_uid;
END;

/*
**********************************
*     "ControlPoint"
**********************************
*/

CREATE VIEW ControlPoint
(
  native_uid                  VARCHAR(1024)           OPTIONS("OpenWorksCommonModel:ControlPoint.native_uid.isUpdatable" false,
                                                                "OpenWorksCommonModel:ControlPoint.native_uid.isCreatable" false,
                                                                UPDATABLE 'FALSE'),
  faultplane_native_uid       VARCHAR(1024),
  fault_name               VARCHAR(50) OPTIONS("OpenWorksCommonModel:ControlPoint.fault_name.isUpdatable" false,
                                                                "OpenWorksCommonModel:ControlPoint.fault_name.isCreatable" false,
                                                                UPDATABLE 'FALSE'),
  fault_plane_version      VARCHAR(40) OPTIONS("OpenWorksCommonModel:ControlPoint.fault_plane_version.isUpdatable" false,
                                                                "OpenWorksCommonModel:ControlPoint.fault_plane_version.isCreatable" false,
                                                                UPDATABLE 'FALSE'),
  fault_plane_source       VARCHAR(5) OPTIONS("OpenWorksCommonModel:ControlPoint.fault_plane_source.isUpdatable" false,
                                                                "OpenWorksCommonModel:ControlPoint.fault_plane_source.isCreatable" false,
                                                                UPDATABLE 'FALSE'),
  data_source              VARCHAR(5),
  x_coord                  DOUBLE       NOT NULL    OPTIONS("OpenWorksCommonModel:ControlPoint.x_coord.unitField" 'xy_unit'),
  y_coord                  DOUBLE       NOT NULL    OPTIONS("OpenWorksCommonModel:ControlPoint.y_coord.unitField" 'xy_unit'),
  xy_unit                  VARCHAR(64)              OPTIONS("OpenWorksCommonModel:ControlPoint.xy_unit.isUpdatable" false,
                                                    "OpenWorksCommonModel:ControlPoint.xy_unit.isCreatable" false,UPDATABLE 'FALSE'),
  z_value                  FLOAT        NOT NULL    OPTIONS("OpenWorksCommonModel:ControlPoint.z_value.unitField" 'z_unit'),
  z_unit                   VARCHAR(64)  NOT NULL    OPTIONS("OpenWorksCommonModel:ControlPoint.z_unit.unitType" 'time depth measure'),
  datum                    FLOAT                    OPTIONS("OpenWorksCommonModel:ControlPoint.datum.unitField" 'datum_unit'),
  datum_unit               VARCHAR(64)              OPTIONS("OpenWorksCommonModel:ControlPoint.datum_unit.unitType" 'elevation'),
  z_domain                 VARCHAR(12)  NOT NULL,
  z_domain_qualifier       VARCHAR(24),
  crs                      VARCHAR(80)  NOT NULL,
  remark                   VARCHAR(200) OPTIONS ( "OpenWorksCommonModel:ControlPoint.remark.isImplemented" false,UPDATABLE 'FALSE'),
  create_date              TIMESTAMP    OPTIONS("OpenWorksCommonModel:ControlPoint.create_date.isUpdatable" false, UPDATABLE 'FALSE',
                                                "OpenWorksCommonModel:ControlPoint.create_date.isCreatable" false),
  create_user_id           VARCHAR(32)  OPTIONS("OpenWorksCommonModel:ControlPoint.create_user_id.isUpdatable" false,UPDATABLE
                                                'FALSE', "OpenWorksCommonModel:ControlPoint.create_user_id.isCreatable" false),
  update_date              TIMESTAMP    OPTIONS("OpenWorksCommonModel:ControlPoint.update_date.isUpdatable" false,UPDATABLE 'FALSE',
                                                "OpenWorksCommonModel:ControlPoint.update_date.isCreatable" false),
  update_user_id           VARCHAR(32)  OPTIONS("OpenWorksCommonModel:ControlPoint.update_user_id.isUpdatable" false,
                                                UPDATABLE 'FALSE',
                                                "OpenWorksCommonModel:ControlPoint.update_user_id.isCreatable" false),
  alternate_uid    		        VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:ControlPoint.alternate_uid.isCreatable" false,
                                                   "OpenWorksCommonModel:ControlPoint.alternate_uid.isUpdatable" false,
                                                    UPDATABLE 'FALSE'),


  CONSTRAINT ControlPoint_PK PRIMARY KEY (native_uid),

    CONSTRAINT FK_ControlPoint_faultplane_native_uid
        FOREIGN KEY          (faultplane_native_uid)
        REFERENCES FaultPlane(native_uid),

  CONSTRAINT FK_ControlPoint_crs
    FOREIGN KEY                    (crs)
        REFERENCES CartoReferenceSystem(name),

    CONSTRAINT FK_ControlPoint_fault_plane_source
        FOREIGN KEY (fault_plane_source)
        REFERENCES DataSource(name)

)
OPTIONS (UPDATABLE 'TRUE',ControlPoint.IMPLEMENTED 'TRUE')
AS
SELECT
 control_point_id,
 OpenWorks_SM.ControlPoint.fault_plane_id,
 fault_name,
 interpretation_version_name AS fault_plane_version,
 OpenWorks_SM.FaultPlane.data_source AS fault_plane_source,
 OpenWorks_SM.ControlPoint.data_source,
 orig_x AS x_coord,
 orig_y AS y_coord,
 coalesce(orig_x_dsdsunit, orig_y_dsdsunit) AS xy_unit,
 z_value,
 z_value_dsdsunit AS z_unit,
 working_datum AS datum,
 working_datum_dsdsunit AS datum_unit,
 OpenWorks_SM.ControlPoint.z_domain,
 OpenWorks_SM.ControlPoint.z_domain_qualifier,
 getDSDSCrs(name) AS crs,
 null AS remark,
 OpenWorks_SM.ControlPoint.create_date,
 OpenWorks_SM.ControlPoint.create_user_id,
 OpenWorks_SM.ControlPoint.update_date,
 OpenWorks_SM.ControlPoint.update_user_id,
 OpenWorks_SM.ControlPoint.native_uid
    FROM
        (OpenWorks_SM.ControlPoint LEFT OUTER JOIN Openworks_SM.FaultPlane ON OpenWorks_SM.ControlPoint.fault_plane_id = OpenWorks_SM.FaultPlane.fault_plane_id) LEFT OUTER JOIN OpenWorks_SM.CartoRefSys ON orig_crs_id = id;




CREATE TRIGGER ON ControlPoint INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC

    DECLARE string VARIABLES.crs_errorMsg='ERROR: The given value for crs does not exist';
    DECLARE string VARIABLES.fault_plane_id_errorMsg='ERROR: The FaultPlane with given values for faultplane_native_uid does not exist';
    DECLARE integer VARIABLES.control_point_id = (SELECT * FROM (EXEC OpenWorks_SM.nextval('ControlPoint')) AS SysGenID);

    DECLARE string VARIABLES.crs_id;
    DECLARE string VARIABLES.fault_plane_id;
    DECLARE string  VARIABLES.fault_plane_source;

    IF("NEW".crs is NOT NULL)
    BEGIN
    VARIABLES.crs_id     = (SELECT id FROM OpenWorks_SM.CartoRefSys WHERE name = (SELECT * FROM (EXEC OpenWorks_SM.GetNativeCRS(SUBSTRING("NEW".crs, 1, 80), 'OW')) AS SysGenID));
    IF(VARIABLES.crs_id is NULL) ERROR VARIABLES.crs_errorMsg;
    END

    IF("NEW".faultplane_native_uid is NOT NULL)
    BEGIN

    INSERT INTO #TmpTbl (#TmpTbl.fault_plane_id, #TmpTbl.fault_plane_source) SELECT fault_plane_id,data_source FROM OpenWorks_SM.FaultPlane where fault_plane_id = "NEW".faultplane_native_uid;

    VARIABLES.fault_plane_id = (select #TmpTbl.fault_plane_id from #TmpTbl);
    VARIABLES.fault_plane_source = (select #TmpTbl.fault_plane_source from #TmpTbl);

    IF(VARIABLES.fault_plane_id is NULL) ERROR VARIABLES.fault_plane_id_errorMsg;

    END


    INSERT INTO OpenWorks_SM.ControlPoint (control_point_id,fault_plane_id, data_source, orig_x, orig_y, z_value, z_value_dsdsunit, z_domain, z_domain_qualifier, storage_datum, orig_crs_id) VALUES (VARIABLES.control_point_id,fault_plane_id, "NEW".data_source, "NEW".x_coord, "NEW".y_coord, "NEW".z_value, "NEW".z_unit, "NEW".z_domain, "NEW".z_domain_qualifier, "NEW".datum, crs_id);
END;



CREATE TRIGGER ON ControlPoint INSTEAD OF UPDATE AS
        FOR EACH ROW
BEGIN ATOMIC

    DECLARE string VARIABLES.crs_errorMsg='ERROR: The given value for crs does not exist';
    DECLARE string VARIABLES.fault_plane_id_errorMsg='ERROR: The FaultPlane with given values for (fault_name,fault_plane_source,fault_plane_version) does not exist';
    DECLARE string VARIABLES.crs_id;
    DECLARE string VARIABLES.fault_plane_id;

    IF("NEW".crs is NOT NULL)
    BEGIN
    VARIABLES.crs_id     = (SELECT id FROM OpenWorks_SM.CartoRefSys WHERE name = (SELECT * FROM (EXEC OpenWorks_SM.GetNativeCRS(SUBSTRING("NEW".crs, 1, 80), 'OW')) AS SysGenID));
    IF(VARIABLES.crs_id is NULL) ERROR VARIABLES.crs_errorMsg;
    END

    IF(("NEW".fault_name is NOT NULL) AND ("NEW".fault_plane_source is NOT NULL ) AND ("NEW".fault_plane_version is NOT NULL))
    BEGIN
    VARIABLES.fault_plane_id= (SELECT fault_plane_id FROM OpenWorks_SM.FaultPlane WHERE (fault_name = SUBSTRING("NEW".fault_name, 1, 50)) AND (data_source = SUBSTRING("NEW".fault_plane_source, 1, 5)) AND (interpretation_version_name = SUBSTRING("NEW".fault_plane_version, 1, 40)));
    IF(VARIABLES.fault_plane_id is NULL) ERROR VARIABLES.fault_plane_id_errorMsg;
    END

    UPDATE OpenWorks_SM.ControlPoint SET fault_plane_id = VARIABLES.fault_plane_id, data_source = "NEW".data_source, orig_x = "NEW".x_coord, orig_y = "NEW".y_coord, z_value = "NEW".z_value, z_value_dsdsunit = "NEW".z_unit, z_domain = "NEW".z_domain, z_domain_qualifier = "NEW".z_domain_qualifier, storage_datum = "NEW".datum, orig_crs_id = crs_id WHERE control_point_id = "OLD".native_uid;
END;


/*
**********************************
*     "FaultPlaneTrimesh"
**********************************
*/
CREATE VIEW FaultPlaneTrimesh
(
  native_uid                    VARCHAR(1024) OPTIONS("OpenWorksCommonModel:FaultPlaneTrimesh.native_uid.isUpdatable" false,
                                                      "OpenWorksCommonModel:FaultPlaneTrimesh.native_uid.isCreatable" false, UPDATABLE 'FALSE'),
  fault_name                    VARCHAR(50)   NOT NULL DEFAULT 'UNKNOWN',
  interpretation_version_name   VARCHAR(40)   NOT NULL DEFAULT 'UNKNOWN',
  data_source                   VARCHAR(5)    NOT NULL,
  fault_id                      INTEGER,
  fault_trimesh_id              INTEGER,
  domain                        VARCHAR(12)   NOT NULL,
  z_domain_qualifier            VARCHAR(24),
  min_x                         DOUBLE        NOT NULL  OPTIONS ("OpenWorksCommonModel:FaultPlaneTrimesh.min_x.unitField" 'xy_unit'),
  max_x                         DOUBLE        NOT NULL  OPTIONS ("OpenWorksCommonModel:FaultPlaneTrimesh.max_x.unitField" 'xy_unit'),
  min_y                         DOUBLE        NOT NULL  OPTIONS ("OpenWorksCommonModel:FaultPlaneTrimesh.min_y.unitField" 'xy_unit'),
  max_y                         DOUBLE        NOT NULL  OPTIONS ("OpenWorksCommonModel:FaultPlaneTrimesh.max_y.unitField" 'xy_unit'),
  min_z                         DOUBLE        NOT NULL  OPTIONS ("OpenWorksCommonModel:FaultPlaneTrimesh.min_z.unitField" 'z_unit'),
  max_z                         DOUBLE        NOT NULL  OPTIONS ("OpenWorksCommonModel:FaultPlaneTrimesh.max_z.unitField" 'z_unit'),
  xy_unit                       VARCHAR(64),
  z_unit                        VARCHAR(64)   NOT NULL  OPTIONS ("OpenWorksCommonModel:FaultPlaneTrimesh.z_unit.unitType" 'time depth measure'),
  interpretation_status         VARCHAR(12)   DEFAULT   'UNKNOWN',
  segment_modification_date     TIMESTAMP,
  enable_triangulation          VARCHAR(1),
  vertex_count                  INTEGER,
  triangle_count                INTEGER,
  original_data_source          VARCHAR(5),
  vertices                      BLOB          OPTIONS ("OpenWorksCommonModel:FaultPlaneTrimesh.vertices.isComplexType"      true,
                                                       "OpenWorksCommonModel:FaultPlaneTrimesh.vertices.isComplexTypeArray" true,
                                                       "OpenWorksCommonModel:FaultPlaneTrimesh.vertices.elementType"        'ThreeSpaceCoordinate',
                                                       "OpenWorksCommonModel:FaultPlaneTrimesh.vertices.elementStruct"      '[{"name":"x","type":"double[]"},{"name":"y","type":"double[]"},{"name":"z","type":"double[]"}]',
                                                       "OpenWorksCommonModel:FaultPlaneTrimesh.vertices.elementMetadata"    '[{"name":"x","unitField":"xy_unit"}, {"name":"y", "unitField":"xy_unit"}, {"name":"z", "unitField":"z_unit"}]'),
  vertices_unit                 VARCHAR(64),
  vertices_unit_type            VARCHAR(64),
  triangles                     BLOB          OPTIONS ("OpenWorksCommonModel:FaultPlaneTrimesh.triangles.isComplexType"      true,
                                                       "OpenWorksCommonModel:FaultPlaneTrimesh.triangles.isComplexTypeArray" true,
                                                       "OpenWorksCommonModel:FaultPlaneTrimesh.triangles.elementType"        'TriangleVertices',
                                                       "OpenWorksCommonModel:FaultPlaneTrimesh.triangles.elementStruct"      '[{"name":"vertex_1","type":"int[]"},{"name":"vertex_2","type":"int[]"},{"name":"vertex_3","type":"int[]"}]'),
  remark                        VARCHAR(200),
  create_date                   TIMESTAMP     OPTIONS ("OpenWorksCommonModel:FaultPlaneTrimesh.create_date.isUpdatable" false,
                                                       "OpenWorksCommonModel:FaultPlaneTrimesh.create_date.isCreatable" false,
                                                       UPDATABLE 'FALSE'),
  created_by                    VARCHAR(32)   OPTIONS ("OpenWorksCommonModel:FaultPlaneTrimesh.created_by.isUpdatable" false,
                                                       "OpenWorksCommonModel:FaultPlaneTrimesh.created_by.isCreatable" false,
                                                       UPDATABLE 'FALSE'),
  update_date                   TIMESTAMP     OPTIONS ("OpenWorksCommonModel:FaultPlaneTrimesh.update_date.isUpdatable" false,
                                                       "OpenWorksCommonModel:FaultPlaneTrimesh.update_date.isCreatable" false,
                                                       UPDATABLE 'FALSE'),
  updated_by                    VARCHAR(32)   OPTIONS ("OpenWorksCommonModel:FaultPlaneTrimesh.updated_by.isUpdatable" false,
                                                       "OpenWorksCommonModel:FaultPlaneTrimesh.updated_by.isCreatable" false,
                                                       UPDATABLE 'FALSE'),  
  alternate_uid    		          VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:FaultPlaneTrimesh.alternate_uid.isCreatable" false, 
                                                       "OpenWorksCommonModel:FaultPlaneTrimesh.alternate_uid.isUpdatable" false,
                                                       UPDATABLE 'FALSE'),

  CONSTRAINT FaultPlaneTrimesh_PK PRIMARY KEY (native_uid),

  CONSTRAINT FaultPlaneTrimesh_UK1 UNIQUE (fault_name, data_source, interpretation_version_name),

  CONSTRAINT FK_FaultPlaneTrimesh_data_source
      FOREIGN KEY (data_source)
      REFERENCES DataSource(name),	

  CONSTRAINT FK_FaultPlaneTrimesh_original_data_source
      FOREIGN KEY (original_data_source)
      REFERENCES DataSource(name),
	
	CONSTRAINT FK_FaultPlaneTrimesh_Fault
        FOREIGN KEY (fault_name)
        REFERENCES Fault(native_uid)
)
OPTIONS(UPDATABLE 'FALSE', FaultPlaneTrimesh.IMPLEMENTED 'TRUE')
AS
SELECT
  fpt.fault_plane_id              AS native_uid,
  fpt.fault_name                  AS fault_name,
  fpt.interpretation_version_name AS interpretation_version_name,
  fpt.data_source                 AS data_source,
  fpt.fault_id                    AS fault_id,
  fpt.fault_trimesh_id            AS fault_trimesh_id,
  fpt.domain                      AS domain,
  fpt.z_domain_qualifier          AS z_domain_qualifier,
  fpt.min_x                       AS min_x,
  fpt.max_x                       AS max_x,
  fpt.min_y                       AS min_y,
  fpt.max_y                       AS max_y,
  fpt.min_z                       AS min_z,
  fpt.max_z                       AS max_z,
  fpt.min_x_dsdsunit              AS xy_unit,
  fpt.min_z_dsdsunit              AS z_unit,
  fpt.interpretation_status       AS interpretation_status,
  fpt.segment_modification_date   AS segment_modification_date,
  fpt.enable_triangulation        AS enable_triangulation,
  fpt.vertex_count                AS vertex_count,
  fpt.triangle_count              AS triangle_count,
  fpt.original_data_source        AS original_data_source,
  fpt.vertices                    AS vertices,
  fpt.vertices_dsdsunit           AS vertices_unit,
  fpt.vertices_dsdsunittype       AS vertices_unit_type,
  fpt.triangles                   AS triangles,
  fpt.remark                      AS remark,
  fpt.create_date                 AS create_date,
  fpt.create_user_id              AS created_by,
  fpt.update_date                 AS update_date,
  fpt.update_user_id              AS updated_by,
  fpt.native_uid    		          AS alternate_uid
FROM
  OpenWorks_SM.FaultPlaneTrimesh fpt;

/*
**********************************
*     "FaultTrimesh"
**********************************
*/
CREATE VIEW FaultTrimesh
(
  native_uid                    VARCHAR(1024) OPTIONS("OpenWorksCommonModel:FaultTrimesh.native_uid.isUpdatable" false,
                                                      "OpenWorksCommonModel:FaultTrimesh.native_uid.isCreatable" false, UPDATABLE 'FALSE'),
  fault_plane_id                VARCHAR(12)   NOT NULL,
  min_wrk_prj_x                 DOUBLE        NOT NULL  OPTIONS ("OpenWorksCommonModel:FaultTrimesh.min_wrk_prj_x.unitField" 'xy_unit'),
  max_wrk_prj_x                 DOUBLE        NOT NULL  OPTIONS ("OpenWorksCommonModel:FaultTrimesh.max_wrk_prj_x.unitField" 'xy_unit'),
  min_wrk_prj_y                 DOUBLE        NOT NULL  OPTIONS ("OpenWorksCommonModel:FaultTrimesh.min_wrk_prj_y.unitField" 'xy_unit'),
  max_wrk_prj_y                 DOUBLE        NOT NULL  OPTIONS ("OpenWorksCommonModel:FaultTrimesh.max_wrk_prj_y.unitField" 'xy_unit'),
  min_z                         DOUBLE        NOT NULL  OPTIONS ("OpenWorksCommonModel:FaultTrimesh.min_z.unitField" 'z_unit'),
  max_z                         DOUBLE        NOT NULL  OPTIONS ("OpenWorksCommonModel:FaultTrimesh.max_z.unitField" 'z_unit'),
  xy_unit                       VARCHAR(64),
  z_unit                        VARCHAR(64)   NOT NULL  OPTIONS ("OpenWorksCommonModel:FaultTrimesh.z_unit.unitType" 'time depth measure'),
  z_domain                      VARCHAR(12)   NOT NULL,
  vertex_count                  INTEGER,
  triangle_count                INTEGER,
  vertices                      BLOB          OPTIONS ("OpenWorksCommonModel:FaultTrimesh.vertices.isComplexType"      true,
                                                       "OpenWorksCommonModel:FaultTrimesh.vertices.isComplexTypeArray" true,
                                                       "OpenWorksCommonModel:FaultTrimesh.vertices.elementType"        'ThreeSpaceCoordinate',
                                                       "OpenWorksCommonModel:FaultTrimesh.vertices.elementStruct"      '[{"name":"x","type":"double[]"},{"name":"y","type":"double[]"},{"name":"z","type":"double[]"}]',
                                                       "OpenWorksCommonModel:FaultTrimesh.vertices.elementMetadata"    '[{"name":"x","unitField":"xy_unit"}, {"name":"y", "unitField":"xy_unit"}, {"name":"z", "unitField":"z_unit"}]'),
  vertices_unit                 VARCHAR(64),
  vertices_unit_type            VARCHAR(64),
  triangles                     BLOB          OPTIONS ("OpenWorksCommonModel:FaultTrimesh.triangles.isComplexType"      true,
                                                       "OpenWorksCommonModel:FaultTrimesh.triangles.isComplexTypeArray" true,
                                                       "OpenWorksCommonModel:FaultTrimesh.triangles.elementType"        'TriangleVertices',
                                                       "OpenWorksCommonModel:FaultTrimesh.triangles.elementStruct"      '[{"name":"vertex_1","type":"int[]"},{"name":"vertex_2","type":"int[]"},{"name":"vertex_3","type":"int[]"}]'),
  remark                        VARCHAR(200),
  create_date                   TIMESTAMP     OPTIONS ("OpenWorksCommonModel:FaultTrimesh.create_date.isUpdatable" false,
                                                       "OpenWorksCommonModel:FaultTrimesh.create_date.isCreatable" false,
                                                       UPDATABLE 'FALSE'),
  created_by                    VARCHAR(32)   OPTIONS ("OpenWorksCommonModel:FaultTrimesh.created_by.isUpdatable" false,
                                                       "OpenWorksCommonModel:FaultTrimesh.created_by.isCreatable" false,
                                                       UPDATABLE 'FALSE'),
  update_date                   TIMESTAMP     OPTIONS ("OpenWorksCommonModel:FaultTrimesh.update_date.isUpdatable" false,
                                                       "OpenWorksCommonModel:FaultTrimesh.update_date.isCreatable" false,
                                                       UPDATABLE 'FALSE'),
  updated_by                    VARCHAR(32)   OPTIONS ("OpenWorksCommonModel:FaultTrimesh.updated_by.isUpdatable" false,
                                                       "OpenWorksCommonModel:FaultTrimesh.updated_by.isCreatable" false,
                                                       UPDATABLE 'FALSE'),  
  alternate_uid    		          VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:FaultTrimesh.alternate_uid.isCreatable" false, 
                                                       "OpenWorksCommonModel:FaultTrimesh.alternate_uid.isUpdatable" false,
                                                       UPDATABLE 'FALSE'),

  CONSTRAINT FaultTrimesh_PK PRIMARY KEY (native_uid),

  CONSTRAINT FaultTrimesh_UK1 UNIQUE (fault_plane_id),

	CONSTRAINT FK_FaultTrimesh_FaultPlane
        FOREIGN KEY (fault_plane_id)
        REFERENCES FaultPlane(native_uid)
)
OPTIONS(UPDATABLE 'FALSE', FaultTrimesh.IMPLEMENTED 'TRUE')
AS
SELECT
  ft.fault_trimesh_id            AS native_uid,
  ft.fault_plane_id              AS fault_plane_id,
  ft.min_wrk_prj_x               AS min_wrk_prj_x,
  ft.max_wrk_prj_x               AS max_wrk_prj_x,
  ft.min_wrk_prj_y               AS min_wrk_prj_y,
  ft.max_wrk_prj_y               AS max_wrk_prj_y,
  ft.min_z                       AS min_z,
  ft.max_z                       AS max_z,
  ft.min_wrk_prj_x_dsdsunit      AS xy_unit,
  ft.min_z_dsdsunit              AS z_unit,
  ft.z_domain                    AS z_domain,
  ft.vertex_count                AS vertex_count,
  ft.triangle_count              AS triangle_count,
  ft.vertices                    AS vertices,
  ft.vertices_dsdsunit           AS vertices_unit,
  ft.vertices_dsdsunittype       AS vertices_unit_type,
  ft.triangles                   AS triangles,
  ft.remark                      AS remark,
  ft.create_date                 AS create_date,
  ft.create_user_id              AS created_by,
  ft.update_date                 AS update_date,
  ft.update_user_id              AS updated_by,
  ft.native_uid    		           AS alternate_uid
FROM
  OpenWorks_SM.FaultTrimesh ft;


/*
**********************************
*     "SurfaceGrid"
**********************************
*/
CREATE VIEW SurfaceGrid
(
  native_uid           VARCHAR(1024)   OPTIONS("OpenWorksCommonModel:SurfaceGrid.native_uid.isUpdatable" false,
                                                 "OpenWorksCommonModel:SurfaceGrid.native_uid.isCreatable" false,
                                                 UPDATABLE 'FALSE'),
  map_data_set_name    VARCHAR(4000)  NOT NULL DEFAULT 'UNKNOWN',
  geo_type             VARCHAR(4000)  NOT NULL,
  geo_name             VARCHAR(4000)  NOT NULL DEFAULT 'UNKNOWN',
  attribute            VARCHAR(4000)  NOT NULL DEFAULT 'UNKNOWN',
  data_source          VARCHAR(4000)  NOT NULL,
  geologic_feature     VARCHAR(4000),
  fault_set_type       VARCHAR(4000),
  crs                  VARCHAR(4000),
  data_domain          VARCHAR(4000)  NOT NULL,
  z_domain_qualifier   VARCHAR(4000),
  x_min                DOUBLE         NOT NULL OPTIONS ("OpenWorksCommonModel:SurfaceGrid.x_min.unitField" 'xy_unit'),
  x_max                DOUBLE         NOT NULL OPTIONS ("OpenWorksCommonModel:SurfaceGrid.x_max.unitField" 'xy_unit'),
  y_min                DOUBLE         NOT NULL OPTIONS ("OpenWorksCommonModel:SurfaceGrid.y_min.unitField" 'xy_unit'),
  y_max                DOUBLE         NOT NULL OPTIONS ("OpenWorksCommonModel:SurfaceGrid.y_max.unitField" 'xy_unit'),
  grid_interval_x      FLOAT          NOT NULL OPTIONS ("OpenWorksCommonModel:SurfaceGrid.grid_interval_x.unitField" 'xy_unit'),
  grid_interval_y      FLOAT          NOT NULL OPTIONS ("OpenWorksCommonModel:SurfaceGrid.grid_interval_y.unitField" 'xy_unit'),
  num_cols             INTEGER        NOT NULL DEFAULT '0',
  num_rows             INTEGER        NOT NULL DEFAULT '0',
  rotation_i           DOUBLE         NOT NULL OPTIONS ("OpenWorksCommonModel:SurfaceGrid.rotation_i.unitField" 'rotation_unit'),
  rotation_j           DOUBLE         OPTIONS ("OpenWorksCommonModel:SurfaceGrid.rotation_j.unitField" 'rotation_unit'),
  rotation_unit        VARCHAR(4000)  OPTIONS ("OpenWorksCommonModel:SurfaceGrid.rotation_unit.unitType" 'angular distance'),
  rotation_origin_x    DOUBLE         NOT NULL OPTIONS ("OpenWorksCommonModel:SurfaceGrid.rotation_origin_x.unitField" 'xy_unit'),
  rotation_origin_y    DOUBLE         NOT NULL OPTIONS ("OpenWorksCommonModel:SurfaceGrid.rotation_origin_y.unitField" 'xy_unit'),
  data_min             FLOAT          OPTIONS ("OpenWorksCommonModel:SurfaceGrid.data_min.unitField" 'z_unit'),
  data_max             FLOAT          OPTIONS ("OpenWorksCommonModel:SurfaceGrid.data_max.unitField" 'z_unit'),
  data_null_value      FLOAT,
  data_values          BLOB             OPTIONS ("OpenWorksCommonModel:SurfaceGrid.data_values.isMedia"          true,
                                                "OpenWorksCommonModel:SurfaceGrid.data_values.mediaContentType" 'application/octet-stream'),
  xy_unit              VARCHAR(4000),
  z_unit               VARCHAR(4000)  OPTIONS ("OpenWorksCommonModel:SurfaceGrid.z_unit.unitTypeAttribute" 'z_unit_type'),
  z_unit_type          VARCHAR(4000),
  remark               VARCHAR(4000),
  create_date          TIMESTAMP      OPTIONS ("OpenWorksCommonModel:SurfaceGrid.create_date.isUpdatable" false,UPDATABLE 'FALSE',
                                               "OpenWorksCommonModel:SurfaceGrid.create_date.isCreatable" false),
  create_user_id       VARCHAR(32)    OPTIONS ("OpenWorksCommonModel:SurfaceGrid.create_user_id.isUpdatable" false,UPDATABLE 'FALSE',
                                               "OpenWorksCommonModel:SurfaceGrid.create_user_id.isCreatable" false),
  update_date          TIMESTAMP      OPTIONS( "OpenWorksCommonModel:SurfaceGrid.update_date.isUpdatable" false,UPDATABLE 'FALSE',
                                               "OpenWorksCommonModel:SurfaceGrid.update_date.isCreatable" false),
  update_user_id       VARCHAR(32)    OPTIONS ("OpenWorksCommonModel:SurfaceGrid.update_user_id.isUpdatable" false,UPDATABLE 'FALSE',
                                               "OpenWorksCommonModel:SurfaceGrid.update_user_id.isCreatable" false),
  alternate_uid    		    VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:SurfaceGrid.alternate_uid.isCreatable" false,
                                               "OpenWorksCommonModel:SurfaceGrid.alternate_uid.isUpdatable" false,
                                                UPDATABLE 'FALSE'),


    CONSTRAINT SurfaceGrid_PK PRIMARY KEY (native_uid),

    CONSTRAINT SurfaceGrid_UK1 UNIQUE (geo_name, geo_type, map_data_set_name, attribute, data_source),

  CONSTRAINT FK_SurfaceGrid_crs
    FOREIGN KEY                    (crs)
        REFERENCES CartoReferenceSystem(name),

    CONSTRAINT FK_SurfaceGrid_data_source
        FOREIGN KEY (data_source)
        REFERENCES DataSource(name)


)
OPTIONS (UPDATABLE 'TRUE',SurfaceGrid.IMPLEMENTED 'TRUE')
    AS
    SELECT
        OpenWorks_SM.Rgrid.grid_id AS native_uid,
        OpenWorks_SM.Rgrid.map_data_set_name AS map_data_set_name,
        OpenWorks_SM.Rgrid.geo_type AS geo_type,
        OpenWorks_SM.Rgrid.geo_name AS geo_name,
        OpenWorks_SM.Rgrid.attribute AS attribute,
        OpenWorks_SM.Rgrid.data_source AS data_source,
        OpenWorks_SM.Rgrid.geologic_feature AS geologic_feature,
        OpenWorks_SM.Rgrid.fault_set_type AS fault_set_type,
        getDSDSCrs(OpenWorks_SM.CartoRefSys.name) AS crs,
        OpenWorks_SM.Rgrid.data_domain AS data_domain,
        OpenWorks_SM.Rgrid.z_domain_qualifier AS z_domain_qualifier,
        OpenWorks_SM.Rgrid.x_min AS x_min,
        OpenWorks_SM.Rgrid.x_max AS x_max,
        OpenWorks_SM.Rgrid.y_min AS y_min,
        OpenWorks_SM.Rgrid.y_max AS y_max,
        OpenWorks_SM.Rgrid.grid_intvl_x AS grid_interval_x,
        OpenWorks_SM.Rgrid.grid_intvl_y AS grid_interval_y,
        OpenWorks_SM.Rgrid.no_cols AS num_cols,
        OpenWorks_SM.Rgrid.no_rows AS num_rows,
        CONVERT(PARSE(SurfaceGridExtendedProperties.extended_properties, 'rotation_i', '0'), double) AS rotation_i,
        CONVERT(PARSE(SurfaceGridExtendedProperties.extended_properties, 'rotation_j', '0'), double) AS rotation_j,
        'rad' AS rotation_unit,
        CONVERT(PARSE(SurfaceGridExtendedProperties.extended_properties, 'rotation_origin_x', '0'), double) AS rotation_origin_x,
        CONVERT(PARSE(SurfaceGridExtendedProperties.extended_properties, 'rotation_origin_y', '0'), double) AS rotation_origin_y,
        OpenWorks_SM.Rgrid.z_min AS data_min,
        OpenWorks_SM.Rgrid.z_max AS data_max,
        OpenWorks_SM.Rgrid.znon AS data_null_value,
        OpenWorks_SM.Rgrid.data AS data_values,
        OpenWorks_SM.CartoRefSys.uom AS xy_unit,
        OpenWorks_SM.Rgrid.z_min_dsdsunit AS z_unit,
        OpenWorks_SM.Rgrid.unit_type_id AS z_unit_type,
        OpenWorks_SM.Rgrid.remark AS remark,
        OpenWorks_SM.Rgrid.create_date AS create_date,
        OpenWorks_SM.Rgrid.create_user_id AS create_user_id,
        OpenWorks_SM.Rgrid.update_date AS update_date,
        OpenWorks_SM.Rgrid.update_user_id AS update_user_id,
	    OpenWorks_SM.Rgrid.native_uid AS alternate_uid
    FROM
        OpenWorks_SM.Rgrid, OpenWorks_SM.CartoRefSys, SurfaceGridExtendedProperties
    WHERE
        OpenWorks_SM.Rgrid.crs_id = OpenWorks_SM.CartoRefSys.id AND OpenWorks_SM.Rgrid.grid_id = SurfaceGridExtendedProperties.grid_id
        AND OpenWorks_SM.Rgrid.data_domain IN ('TIME', 'DEPTH','TVDSS','SSTVD','TVD');

CREATE TRIGGER ON SurfaceGrid INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC
     DECLARE string VARIABLES.crs_errorMsg='ERROR: The given value for crs does not exist';
    DECLARE integer VARIABLES.grid_id = (SELECT * FROM (EXEC OpenWorks_SM.nextval('Rgrid')) AS SysGenID);
    DECLARE string VARIABLES.native_properties = composeRotationMatrix("NEW".num_rows, "NEW".num_cols, "NEW".rotation_i, "NEW".grid_interval_x, "NEW".grid_interval_y, "NEW".rotation_origin_x, "NEW".rotation_origin_y);
    DECLARE string VARIABLES.grid_type = PARSE(VARIABLES.native_properties, 'grid_type', 'Unrotated');
    DECLARE double VARIABLES.matrix11 = CONVERT(PARSE(VARIABLES.native_properties, 'matrix11', '0'), double);
    DECLARE double VARIABLES.matrix12 = CONVERT(PARSE(VARIABLES.native_properties, 'matrix12', '0'), double);
    DECLARE double VARIABLES.matrix21 = CONVERT(PARSE(VARIABLES.native_properties, 'matrix21', '0'), double);
    DECLARE double VARIABLES.matrix22 = CONVERT(PARSE(VARIABLES.native_properties, 'matrix22', '0'), double);

    DECLARE double VARIABLES.u_min = CONVERT(PARSE(VARIABLES.native_properties, 'u_min', '0'), double);
    DECLARE double VARIABLES.u_max = CONVERT(PARSE(VARIABLES.native_properties, 'u_max', '0'), double);
    DECLARE double VARIABLES.v_min = CONVERT(PARSE(VARIABLES.native_properties, 'v_min', '0'), double);
    DECLARE double VARIABLES.v_max = CONVERT(PARSE(VARIABLES.native_properties, 'v_max', '0'), double);

    DECLARE string VARIABLES.crs_id;
    IF("NEW".crs is NOT NULL)
    BEGIN
    VARIABLES.crs_id     = (SELECT id FROM OpenWorks_SM.CartoRefSys WHERE name = (SELECT * FROM (EXEC OpenWorks_SM.GetNativeCRS("NEW".crs, 'OW')) AS SysGenID));
    IF(VARIABLES.crs_id is NULL) ERROR VARIABLES.crs_errorMsg;
    END

    DECLARE string VARIABLES.grid_errorMsg='ERROR: Domain should be TIME,DEPTH,TVDSS,SSTVD,TVD for base surface grid';
    IF("NEW".data_domain NOT IN('TIME', 'DEPTH','TVDSS','SSTVD','TVD'))
    BEGIN
        ERROR VARIABLES.grid_errorMsg;
    END


    INSERT INTO OpenWorks_SM.Rgrid (grid_id, map_data_set_name,       geo_type,       geo_name,       attribute,       data_source,       geologic_feature,       fault_set_type,       crs_id, data_domain,       z_domain_qualifier,       x_min,       x_max,       y_min,       y_max,       grid_intvl_x,          grid_intvl_y,          no_cols,        no_rows,        /*rotation_i,       rotation_j,       rotation_unit,       rotation_origin_x,       rotation_origin_y, */       OpenWorks_SM.Rgrid.znon, OpenWorks_SM.Rgrid.data, unit_type_id,      remark,                          matrix11,           matrix12,           matrix21,           matrix22,           u_min,           u_max,           v_min,           v_max,           z_min,          z_max,          z_max_dsdsunit, z_min_dsdsunit)
                            VALUES (grid_id, "NEW".map_data_set_name, "NEW".geo_type, "NEW".geo_name, "NEW".attribute, "NEW".data_source, "NEW".geologic_feature, "NEW".fault_set_type, crs_id, "NEW".data_domain, "NEW".z_domain_qualifier, "NEW".x_min, "NEW".x_max, "NEW".y_min, "NEW".y_max, "NEW".grid_interval_x, "NEW".grid_interval_y, "NEW".num_cols, "NEW".num_rows, /*"NEW".rotation_i, "NEW".rotation_j, "NEW".rotation_unit, "NEW".rotation_origin_x, "NEW".rotation_origin_y, */ "NEW".data_null_value,   "NEW".data_values,       "NEW".z_unit_type, SUBSTRING("NEW".remark, 1, 200), VARIABLES.matrix11, VARIABLES.matrix12, VARIABLES.matrix21, VARIABLES.matrix22, VARIABLES.u_min, VARIABLES.u_max, VARIABLES.v_min, VARIABLES.v_max, "NEW".data_min, "NEW".data_max, "NEW".z_unit,   "NEW".z_unit);
END;

CREATE TRIGGER ON SurfaceGrid INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC
  DECLARE string VARIABLES.crs_errorMsg='ERROR: The given value for crs does not exist';


    DECLARE string VARIABLES.crs_id;
    IF("NEW".crs is NOT NULL)
    BEGIN
    VARIABLES.crs_id     = (SELECT id FROM OpenWorks_SM.CartoRefSys WHERE name = (SELECT * FROM (EXEC OpenWorks_SM.GetNativeCRS(SUBSTRING("NEW".crs, 1, 80), 'OW')) AS SysGenID));
    IF(VARIABLES.crs_id is NULL) ERROR VARIABLES.crs_errorMsg;
    END

    DECLARE string VARIABLES.grid_errorMsg='ERROR: Domain should be TIME,DEPTH,TVDSS,SSTVD,TVD for base surface grid';
    IF("NEW".data_domain NOT IN('TIME', 'DEPTH','TVDSS','SSTVD','TVD'))
    BEGIN
        ERROR VARIABLES.grid_errorMsg;
    END

    IF("NEW".data_values IS NOT NULL AND CHANGING.data_values)
    BEGIN
      UPDATE OpenWorks_SM.Rgrid SET
        geologic_feature = "NEW".geologic_feature,
        fault_set_type = "NEW".fault_set_type,
        data_domain = "NEW".data_domain,
        z_domain_qualifier = "NEW".z_domain_qualifier,
        x_min = "NEW".x_min,
        x_max = "NEW".x_max,
        z_min = "NEW".data_min,
        z_max = "NEW".data_max,
        y_min = "NEW".y_min,
        z_max_dsdsunit = "NEW".z_unit,
        z_min_dsdsunit = "NEW".z_unit,
        y_max = "NEW".y_max,
        grid_intvl_x = "NEW".grid_interval_x,
        grid_intvl_y = "NEW".grid_interval_y,
        no_cols = "NEW".num_cols,
        no_rows = "NEW".num_rows,
        /*rotation_i = "NEW".rotation_i,
        rotation_j = "NEW".rotation_j,
        rotation_unit = "NEW".rotation_unit,
        rotation_origin_x = "NEW".rotation_origin_x,
        rotation_origin_y = "NEW".rotation_origin_y,*/
        OpenWorks_SM.Rgrid.znon = "NEW".data_null_value,
        OpenWorks_SM.Rgrid.data = "NEW".data_values,
        unit_type_id = "NEW".z_unit_type,
        remark = SUBSTRING("NEW".remark, 1, 200)
    WHERE (data_source = "OLD".data_source) AND (geo_name = "OLD".geo_name) AND (map_data_set_name = "OLD".map_data_set_name)
    AND (attribute = "OLD".attribute) AND (geo_type = "OLD".geo_type) AND (OpenWorks_SM.Rgrid.grid_id = "OLD".native_uid);
    END
    ELSE
    BEGIN
      UPDATE OpenWorks_SM.Rgrid SET
        geologic_feature = "NEW".geologic_feature,
        fault_set_type = "NEW".fault_set_type,
        data_domain = "NEW".data_domain,
        z_domain_qualifier = "NEW".z_domain_qualifier,
        x_min = "NEW".x_min,
        x_max = "NEW".x_max,
        z_min = "NEW".data_min,
        z_max = "NEW".data_max,
        y_min = "NEW".y_min,
        z_max_dsdsunit = "NEW".z_unit,
        z_min_dsdsunit = "NEW".z_unit,
        y_max = "NEW".y_max,
        grid_intvl_x = "NEW".grid_interval_x,
        grid_intvl_y = "NEW".grid_interval_y,
        no_cols = "NEW".num_cols,
        no_rows = "NEW".num_rows,
        /*rotation_i = "NEW".rotation_i,
        rotation_j = "NEW".rotation_j,
        rotation_unit = "NEW".rotation_unit,
        rotation_origin_x = "NEW".rotation_origin_x,
        rotation_origin_y = "NEW".rotation_origin_y,*/
        OpenWorks_SM.Rgrid.znon = "NEW".data_null_value,
        unit_type_id = "NEW".z_unit_type,
        remark = SUBSTRING("NEW".remark, 1, 200)
    WHERE (data_source = "OLD".data_source) AND (geo_name = "OLD".geo_name) AND (map_data_set_name = "OLD".map_data_set_name)
    AND (attribute = "OLD".attribute) AND (geo_type = "OLD".geo_type) AND (OpenWorks_SM.Rgrid.grid_id = "OLD".native_uid);
    END

END;

CREATE TRIGGER ON SurfaceGrid INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC
    DELETE FROM OpenWorks_SM.Rgrid WHERE grid_id = "OLD".native_uid;
END;


CREATE VIEW SurfaceGridExtendedProperties
(
  grid_id           VARCHAR(1024)   OPTIONS("OpenWorksCommonModel:SurfaceGridExtendedProperties.grid_id.isUpdatable" false,
                                                 "OpenWorksCommonModel:SurfaceGridExtendedProperties.grid_id.isCreatable" false,
                                                 UPDATABLE 'FALSE'),
  extended_properties    VARCHAR(4000)  NOT NULL DEFAULT 'UNKNOWN',

  CONSTRAINT SurfaceGridExtendedProperties_PK PRIMARY KEY (grid_id)
)
OPTIONS (UPDATABLE 'FALSE',SurfaceGridExtendedProperties.IMPLEMENTED 'FALSE')
    AS
    SELECT
        OpenWorks_SM.Rgrid.grid_id AS grid_id,
        composeCoordinateVector(OpenWorks_SM.Rgrid.no_rows, OpenWorks_SM.Rgrid.grid_type, OpenWorks_SM.Rgrid.grid_intvl_x,  OpenWorks_SM.Rgrid.grid_intvl_y,
        OpenWorks_SM.Rgrid.matrix11, OpenWorks_SM.Rgrid.matrix12, OpenWorks_SM.Rgrid.matrix21, OpenWorks_SM.Rgrid.matrix22,OpenWorks_SM.Rgrid.x_min,
        OpenWorks_SM.Rgrid.y_max, OpenWorks_SM.Rgrid.u_min, OpenWorks_SM.Rgrid.v_max) AS extended_properties
    FROM
        OpenWorks_SM.Rgrid;

/*
**********************************
*     "SurfaceGridProperties"
**********************************
*/
 CREATE VIEW SurfaceGridProperties
(
  native_uid           VARCHAR(1024)   OPTIONS("OpenWorksCommonModel:SurfaceGridProperties.native_uid.isUpdatable" false,
                                                 "OpenWorksCommonModel:SurfaceGridProperties.native_uid.isCreatable" false,
                                                 UPDATABLE 'FALSE'),
  parent_surface_grid_id    VARCHAR(1024),
  map_data_set_name    VARCHAR(4000)  NOT NULL DEFAULT 'UNKNOWN',
  geo_type             VARCHAR(4000)  NOT NULL,
  geo_name             VARCHAR(4000)  NOT NULL DEFAULT 'UNKNOWN',
  attribute            VARCHAR(4000)  NOT NULL DEFAULT 'UNKNOWN',
  data_source          VARCHAR(4000)  NOT NULL,
  geologic_feature     VARCHAR(4000),
  fault_set_type       VARCHAR(4000),
  crs                  VARCHAR(4000),
  data_domain          VARCHAR(4000)  NOT NULL,
  z_domain_qualifier   VARCHAR(4000),
  x_min                DOUBLE         NOT NULL OPTIONS ("OpenWorksCommonModel:SurfaceGridProperties.x_min.unitField" 'xy_unit'),
  x_max                DOUBLE         NOT NULL OPTIONS ("OpenWorksCommonModel:SurfaceGridProperties.x_max.unitField" 'xy_unit'),
  y_min                DOUBLE         NOT NULL OPTIONS ("OpenWorksCommonModel:SurfaceGridProperties.y_min.unitField" 'xy_unit'),
  y_max                DOUBLE         NOT NULL OPTIONS ("OpenWorksCommonModel:SurfaceGridProperties.y_max.unitField" 'xy_unit'),
  grid_interval_x      FLOAT          NOT NULL OPTIONS ("OpenWorksCommonModel:SurfaceGridProperties.grid_interval_x.unitField" 'xy_unit'),
  grid_interval_y      FLOAT          NOT NULL OPTIONS ("OpenWorksCommonModel:SurfaceGridProperties.grid_interval_y.unitField" 'xy_unit'),
  num_cols             INTEGER        NOT NULL DEFAULT '0',
  num_rows             INTEGER        NOT NULL DEFAULT '0',
  rotation_i           DOUBLE         NOT NULL OPTIONS ("OpenWorksCommonModel:SurfaceGridProperties.rotation_i.unitField" 'rotation_unit'),
  rotation_j           DOUBLE         OPTIONS ("OpenWorksCommonModel:SurfaceGridProperties.rotation_j.unitField" 'rotation_unit'),
  rotation_unit        VARCHAR(4000)  OPTIONS ("OpenWorksCommonModel:SurfaceGridProperties.rotation_unit.unitType" 'angular distance'),
  rotation_origin_x    DOUBLE         NOT NULL OPTIONS ("OpenWorksCommonModel:SurfaceGridProperties.rotation_origin_x.unitField" 'xy_unit'),
  rotation_origin_y    DOUBLE         NOT NULL OPTIONS ("OpenWorksCommonModel:SurfaceGridProperties.rotation_origin_y.unitField" 'xy_unit'),
  data_min             FLOAT          OPTIONS ("OpenWorksCommonModel:SurfaceGridProperties.data_min.unitField" 'z_unit'),
  data_max             FLOAT          OPTIONS ("OpenWorksCommonModel:SurfaceGridProperties.data_max.unitField" 'z_unit'),
  data_null_value      FLOAT,
  data_values          BLOB             OPTIONS ("OpenWorksCommonModel:SurfaceGridProperties.data_values.isMedia"          true,
                                                "OpenWorksCommonModel:SurfaceGridProperties.data_values.mediaContentType" 'application/octet-stream'),
  xy_unit              VARCHAR(4000),
  z_unit               VARCHAR(4000)  OPTIONS ("OpenWorksCommonModel:SurfaceGridProperties.z_unit.unitTypeAttribute" 'z_unit_type'),
  z_unit_type          VARCHAR(4000),
  remark               VARCHAR(4000),
  create_date          TIMESTAMP      OPTIONS ("OpenWorksCommonModel:SurfaceGridProperties.create_date.isUpdatable" false,UPDATABLE 'FALSE',
                                               "OpenWorksCommonModel:SurfaceGridProperties.create_date.isCreatable" false),
  create_user_id       VARCHAR(32)    OPTIONS ("OpenWorksCommonModel:SurfaceGridProperties.create_user_id.isUpdatable" false,UPDATABLE 'FALSE',
                                               "OpenWorksCommonModel:SurfaceGridProperties.create_user_id.isCreatable" false),
  update_date          TIMESTAMP      OPTIONS( "OpenWorksCommonModel:SurfaceGridProperties.update_date.isUpdatable" false,UPDATABLE 'FALSE',
                                               "OpenWorksCommonModel:SurfaceGridProperties.update_date.isCreatable" false),
  update_user_id       VARCHAR(32)    OPTIONS ("OpenWorksCommonModel:SurfaceGridProperties.update_user_id.isUpdatable" false,UPDATABLE 'FALSE',
                                               "OpenWorksCommonModel:SurfaceGridProperties.update_user_id.isCreatable" false),
  alternate_uid    		   VARCHAR(4000)   OPTIONS ("OpenWorksCommonModel:SurfaceGridProperties.alternate_uid.isCreatable" false,
                                                "OpenWorksCommonModel:SurfaceGridProperties.alternate_uid.isUpdatable" false,
                                                 UPDATABLE 'FALSE'),


    CONSTRAINT SurfaceGridProperties_PK PRIMARY KEY (native_uid),

    CONSTRAINT SurfaceGridProperties_UK1 UNIQUE (geo_name, geo_type, map_data_set_name, attribute, data_source),

  CONSTRAINT FK_SurfaceGridProperties_crs
    FOREIGN KEY                    (crs)
        REFERENCES CartoReferenceSystem(name),

    CONSTRAINT FK_SurfaceGridProperties_data_source
        FOREIGN KEY (data_source)
        REFERENCES DataSource(name),

    CONSTRAINT FK_SurfaceGrid_parent_surface_grid_id
        FOREIGN KEY (parent_surface_grid_id)
        REFERENCES SurfaceGrid(native_uid)


)
OPTIONS (UPDATABLE 'TRUE',SurfaceGridProperties.IMPLEMENTED 'TRUE')
    AS

SELECT
        rd.grid_id AS native_uid,
       (SELECT grid_id FROM OpenWorks_SM.Rgrid R
        where R.data_domain IN ('TIME', 'DEPTH','TVDSS','SSTVD','TVD')
        AND rd.map_data_set_name LIKE R.map_data_set_name||'%'
        AND R.geo_name=rd.geo_name
        AND R.geo_type= rd.geo_type
        AND R.data_source = rd.data_source
        AND R.no_cols=rd.no_cols
        AND R.no_rows=rd.no_rows
        AND R.grid_id <> rd.grid_id LIMIT 1) AS parent_surface_grid_id,

        rd.map_data_set_name AS map_data_set_name,
        rd.geo_type AS geo_type,
        rd.geo_name AS geo_name,
        rd.attribute AS attribute,
        rd.data_source AS data_source,
        rd.geologic_feature AS geologic_feature,
        rd.fault_set_type AS fault_set_type,
        getDSDSCrs(OpenWorks_SM.CartoRefSys.name) AS crs,
        rd.data_domain AS data_domain,
        rd.z_domain_qualifier AS z_domain_qualifier,
        rd.x_min AS x_min,
        rd.x_max AS x_max,
        rd.y_min AS y_min,
        rd.y_max AS y_max,
        rd.grid_intvl_x AS grid_interval_x,
        rd.grid_intvl_y AS grid_interval_y,
        rd.no_cols AS num_cols,
        rd.no_rows AS num_rows,
        CONVERT(PARSE(SurfaceGridExtendedProperties.extended_properties, 'rotation_i', '0'), double) AS rotation_i,
        CONVERT(PARSE(SurfaceGridExtendedProperties.extended_properties, 'rotation_j', '0'), double) AS rotation_j,
        'rad' AS rotation_unit,
        CONVERT(PARSE(SurfaceGridExtendedProperties.extended_properties, 'rotation_origin_x', '0'), double) AS rotation_origin_x,
        CONVERT(PARSE(SurfaceGridExtendedProperties.extended_properties, 'rotation_origin_y', '0'), double) AS rotation_origin_y,
        rd.z_min AS data_min,
        rd.z_max AS data_max,
        rd.znon AS data_null_value,
        rd.data AS data_values,
        OpenWorks_SM.CartoRefSys.uom AS xy_unit,
        rd.z_min_dsdsunit AS z_unit,
        rd.unit_type_id AS z_unit_type,
        rd.remark AS remark,
        rd.create_date AS create_date,
        rd.create_user_id AS create_user_id,
        rd.update_date AS update_date,
        rd.update_user_id AS update_user_id,
        rd.native_uid AS alternate_uid
    FROM
        OpenWorks_SM.Rgrid AS rd, OpenWorks_SM.CartoRefSys ,SurfaceGridExtendedProperties

    WHERE
        rd.crs_id = OpenWorks_SM.CartoRefSys.id AND
        rd.grid_id=SurfaceGridExtendedProperties.grid_id AND
        rd.data_domain NOT IN ('TIME', 'DEPTH','TVDSS','SSTVD','TVD');



CREATE TRIGGER ON SurfaceGridProperties INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC
     DECLARE string VARIABLES.crs_errorMsg='ERROR: The given value for crs does not exist';
    DECLARE integer VARIABLES.grid_id = (SELECT * FROM (EXEC OpenWorks_SM.nextval('Rgrid')) AS SysGenID);
    DECLARE string VARIABLES.native_properties = composeRotationMatrix("NEW".num_rows, "NEW".num_cols, "NEW".rotation_i, "NEW".grid_interval_x, "NEW".grid_interval_y, "NEW".rotation_origin_x, "NEW".rotation_origin_y);
    DECLARE string VARIABLES.grid_type = PARSE(VARIABLES.native_properties, 'grid_type', 'Unrotated');
    DECLARE double VARIABLES.matrix11 = CONVERT(PARSE(VARIABLES.native_properties, 'matrix11', '0'), double);
    DECLARE double VARIABLES.matrix12 = CONVERT(PARSE(VARIABLES.native_properties, 'matrix12', '0'), double);
    DECLARE double VARIABLES.matrix21 = CONVERT(PARSE(VARIABLES.native_properties, 'matrix21', '0'), double);
    DECLARE double VARIABLES.matrix22 = CONVERT(PARSE(VARIABLES.native_properties, 'matrix22', '0'), double);

    DECLARE double VARIABLES.u_min = CONVERT(PARSE(VARIABLES.native_properties, 'u_min', '0'), double);
    DECLARE double VARIABLES.u_max = CONVERT(PARSE(VARIABLES.native_properties, 'u_max', '0'), double);
    DECLARE double VARIABLES.v_min = CONVERT(PARSE(VARIABLES.native_properties, 'v_min', '0'), double);
    DECLARE double VARIABLES.v_max = CONVERT(PARSE(VARIABLES.native_properties, 'v_max', '0'), double);

    DECLARE string VARIABLES.crs_id;
    IF("NEW".crs is NOT NULL)
    BEGIN
    VARIABLES.crs_id     = (SELECT id FROM OpenWorks_SM.CartoRefSys WHERE name = (SELECT * FROM (EXEC OpenWorks_SM.GetNativeCRS("NEW".crs, 'OW')) AS SysGenID));
    IF(VARIABLES.crs_id is NULL) ERROR VARIABLES.crs_errorMsg;
    END

    DECLARE string VARIABLES.grid_errorMsg='ERROR: Domain should not be TIME,DEPTH,TVDSS,SSTVD,TVD for property surface grid';
    IF("NEW".data_domain IN('TIME', 'DEPTH','TVDSS','SSTVD','TVD'))
    BEGIN
        ERROR VARIABLES.grid_errorMsg;
    END

    INSERT INTO OpenWorks_SM.Rgrid (grid_id,map_data_set_name, geo_type, geo_name, attribute, data_source, geologic_feature, fault_set_type, crs_id, data_domain, z_domain_qualifier, x_min, x_max, y_min, y_max, grid_intvl_x, grid_intvl_y, no_cols, no_rows, /*rotation_i, rotation_j, rotation_unit, rotation_origin_x, rotation_origin_y, */OpenWorks_SM.Rgrid.znon, OpenWorks_SM.Rgrid.data,  unit_desc,  unit_type_id, remark, matrix11, matrix12, matrix21, matrix22, u_min, u_max, v_min, v_max, z_min, z_max,z_max_dsdsunit,z_min_dsdsunit)
 VALUES (grid_id, SUBSTRING("NEW".map_data_set_name, 1, 24), "NEW".geo_type, "NEW".geo_name, "NEW".attribute, "NEW".data_source, "NEW".geologic_feature, "NEW".fault_set_type, crs_id, "NEW".data_domain, "NEW".z_domain_qualifier, "NEW".x_min, "NEW".x_max, "NEW".y_min, "NEW".y_max, "NEW".grid_interval_x, "NEW".grid_interval_y, "NEW".num_cols, "NEW".num_rows, /*"NEW".rotation_i, "NEW".rotation_j, "NEW".rotation_unit, "NEW".rotation_origin_x, "NEW".rotation_origin_y, */"NEW".data_null_value, "NEW".data_values, "NEW".z_unit, "NEW".z_unit_type, SUBSTRING("NEW".remark, 1, 200), VARIABLES.matrix11, VARIABLES.matrix12, VARIABLES.matrix21, VARIABLES.matrix22, VARIABLES.u_min, VARIABLES.u_max, VARIABLES.v_min, VARIABLES.v_max, "NEW".data_min, "NEW".data_max,"NEW".z_unit,"NEW".z_unit);
END;

CREATE TRIGGER ON SurfaceGridProperties INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC
  DECLARE string VARIABLES.crs_errorMsg='ERROR: The given value for crs does not exist';


    DECLARE string VARIABLES.crs_id;
