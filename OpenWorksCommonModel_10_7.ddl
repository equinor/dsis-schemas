CREATE VIEW Tape
(
  native_uid             VARCHAR(1024) OPTIONS  ("OpenWorksCommonModel:Tape.native_uid.isUpdatable" false,
                                                 "OpenWorksCommonModel:Tape.native_uid.isCreatable" false,
                                                  UPDATABLE 'FALSE'),
  name                   VARCHAR(4000) NOT NULL,
  parent_native_uid      VARCHAR(1024) NOT NULL,
  parent_name            VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:Tape.parent_name.isUpdatable" false,
                                                "OpenWorksCommonModel:Tape.parent_name.isCreatable" false,
                                                 UPDATABLE 'FALSE'),
  attribute_update       VARCHAR(4000),
  comment                VARCHAR(4000),
  creator                VARCHAR(4000),
  date_logged            VARCHAR(4000),
  date_stamp             VARCHAR(4000),
  decode_date            VARCHAR(4000),
  decode_status          VARCHAR(4000),
  density                INTEGER,
  description            VARCHAR(4000),
  dir_source_file_dir    VARCHAR(4000),
  ex_source_file_name    VARCHAR(4000),
  field                  VARCHAR(4000),
  file_name              VARCHAR(4000),
  file_size              INTEGER,
  folder                 VARCHAR(4000),
  format                 VARCHAR(4000),
  link_type              VARCHAR(4000),
  logging_contractor     VARCHAR(4000),
  operator               VARCHAR(4000),
  process_status         VARCHAR(4000),
  program_name           VARCHAR(4000),
  recording_contractor   VARCHAR(4000),
  recording_date         VARCHAR(4000),
  security_access        VARCHAR(4000),
  security_access_list   VARCHAR(4000),
  security_flag          VARCHAR(4000),
  security_grade         VARCHAR(4000),
  security_user_count    INTEGER,
  siz_source_file_name   INTEGER,
  size                   INTEGER,
  source                 VARCHAR(4000),
  source_file_dir        VARCHAR(4000),
  source_file_name       VARCHAR(4000),
  status                 VARCHAR(4000),
  sub_format             VARCHAR(4000),
  tape_file_count        INTEGER,
  type                   VARCHAR(4000),
  alternate_uid    		     VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:Tape.alternate_uid.isCreatable" false,
                                                "OpenWorksCommonModel:Tape.alternate_uid.isUpdatable" false,
                                                 UPDATABLE 'FALSE'),

  CONSTRAINT Tape_PK PRIMARY KEY (native_uid),

  CONSTRAINT Tape_UK1 UNIQUE (name, parent_native_uid)

)
OPTIONS (UPDATABLE 'FALSE' , Tape.IMPLEMENTED 'FALSE')
    AS
    SELECT
        null AS native_uid,
        null AS name,
        null AS parent_native_uid,
        null AS parent_name,
        null AS attribute_update,
        null AS comment,
        null AS creator,
        null AS date_logged,
        null AS date_stamp,
        null AS decode_date,
        null AS decode_status,
        null AS density,
        null AS description,
        null AS dir_source_file_dir,
        null AS ex_source_file_name,
        null AS field,
        null AS file_name,
        null AS file_size,
        null AS folder,
        null AS format,
        null AS link_type,
        null AS logging_contractor,
        null AS operator,
        null AS process_status,
        null AS program_name,
        null AS recording_contractor,
        null AS recording_date,
        null AS security_access,
        null AS security_access_list,
        null AS security_flag,
        null AS security_grade,
        null AS security_user_count,
        null AS siz_source_file_name,
        null AS size,
        null AS source,
        null AS source_file_dir,
        null AS source_file_name,
        null AS status,
        null AS sub_format,
        null AS tape_file_count,
        null AS type,
	    null AS alternate_uid
    FROM SYS.Tables
        WHERE 1 = 2;


