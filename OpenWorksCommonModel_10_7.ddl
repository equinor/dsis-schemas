/*
**********************************
* ENTITY: InterpretationProcess
**********************************
*/

CREATE VIEW InterpretationProcess
(
	native_uid            VARCHAR(12)        AUTO_INCREMENT OPTIONS ("OpenWorksCommonModel:InterpretationProcess.native_uid.isUpdatable" false,
                                                                    "OpenWorksCommonModel:InterpretationProcess.native_uid.isCreatable" false,UPDATABLE 'FALSE'),
    process_type            VARCHAR(20)        NOT NULL,
    process_name            VARCHAR(40)        NOT NULL,
    process_start_time        timestamp        NOT NULL,
    process_end_time        timestamp         NOT NULL,
    data_source                VARCHAR(5)        NOT NULL,
    process_application        VARCHAR(24),
    process_app_version        VARCHAR(12),
    containing_process_id    VARCHAR(12),
    seq_containing_proc        INTEGER,
    nchar_                    INTEGER,
    long_remark                clob,
    remark                    VARCHAR(200),
    create_date                timestamp      OPTIONS ("OpenWorksCommonModel:InterpretationProcess.create_date.isUpdatable" false,"OpenWorksCommonModel:InterpretationProcess.create_date.isCreatable" false,UPDATABLE 'FALSE'),
    create_user_id            VARCHAR(32)    OPTIONS ("OpenWorksCommonModel:InterpretationProcess.create_user_id.isUpdatable" false,"OpenWorksCommonModel:InterpretationProcess.create_user_id.isCreatable" false,UPDATABLE 'FALSE'),
    update_date                timestamp       OPTIONS ("OpenWorksCommonModel:InterpretationProcess.update_user_id.isUpdatable" false,"OpenWorksCommonModel:InterpretationProcess.update_user_id.isCreatable" false,UPDATABLE 'FALSE'),
    update_user_id            VARCHAR(32)    OPTIONS ("OpenWorksCommonModel:InterpretationProcess.update_date.isUpdatable" false,"OpenWorksCommonModel:InterpretationProcess.update_date.isCreatable" false,UPDATABLE 'FALSE'),
    alternate_uid    		      VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:InterpretationProcess.alternate_uid.isCreatable" false,
                                                 "OpenWorksCommonModel:InterpretationProcess.alternate_uid.isUpdatable" false,
                                                 UPDATABLE 'FALSE'),
    CONSTRAINT InterpretationProcess_PK PRIMARY KEY (native_uid),
    CONSTRAINT InterpretationProcess_UK1 UNIQUE (process_type,process_name,process_start_time,process_end_time,data_source),

    CONSTRAINT FK_InterpProcess_cont_proc_id
      FOREIGN KEY (containing_process_id)
      REFERENCES InterpretationProcess(native_uid)  ,

    CONSTRAINT FK_InterpProcess_DataSource_id
      FOREIGN KEY (data_source)
      REFERENCES DataSource(name)  ,

    CONSTRAINT FK_InterpProcess_process_type
      FOREIGN KEY (process_type)
      REFERENCES RProcessType(process_type)

)
OPTIONS (UPDATABLE 'TRUE', InterpretationProcess.IMPLEMENTED 'TRUE')
    AS
    SELECT
        interp_process_id          AS   native_uid ,
        process_type            AS   process_type ,
        process_name            AS   process_name ,
        process_start_time        AS   process_start_time ,
        process_end_time        AS   process_end_time ,
        data_source                AS   data_source ,
        process_application        AS   process_application ,
        process_app_version        AS   process_app_version ,
        containing_process_id    AS   containing_process_id ,
        seq_containing_proc        AS   seq_containing_proc ,
        "nchar"                    AS   nchar_ ,
        long_remark                AS   long_remark ,
        remark                    AS   remark ,
        create_date                AS   create_date ,
        create_user_id            AS   create_user_id ,
        update_date                AS   update_date ,
        update_user_id            AS   update_user_id,
	    native_uid                 AS   alternate_uid

    FROM
        OpenWorks_SM.InterpretationProcess;

Create Trigger on InterpretationProcess INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC

IF (new.long_remark is null)
    INSERT INTO OpenWorks_SM.InterpretationProcess
        (process_type,process_name,process_start_time,process_end_time,data_source,process_application,process_app_version,
        containing_process_id,seq_containing_proc,remark)
    VALUES
        ("NEW".process_type,"NEW".process_name,"NEW".process_start_time,"NEW".process_end_time,"NEW".data_source,"NEW".process_application,"NEW".process_app_version,
        "NEW".containing_process_id,"NEW".seq_containing_proc,"NEW".remark) ;
ELSE
    INSERT INTO OpenWorks_SM.InterpretationProcess
        (process_type,process_name,process_start_time,process_end_time,data_source,process_application,process_app_version,
        containing_process_id,seq_containing_proc,"nchar",long_remark,remark)
    VALUES
        ("NEW".process_type,"NEW".process_name,"NEW".process_start_time,"NEW".process_end_time,"NEW".data_source,"NEW".process_application,"NEW".process_app_version,
        "NEW".containing_process_id,"NEW".seq_containing_proc,LENGTH(CAST(new.long_remark AS string)),"NEW".long_remark, "NEW".remark) ;

END;

CREATE TRIGGER ON InterpretationProcess INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC

IF ( new.long_remark is null )
    UPDATE OpenWorks_SM.InterpretationProcess SET
    process_type = "NEW".process_type ,process_name=  "NEW".process_name, process_start_time = "NEW".process_start_time,process_end_time = "NEW".process_end_time,data_source = "NEW".data_source,process_application = "NEW".process_application,process_app_version  = "NEW".process_app_version,
    containing_process_id= "NEW".containing_process_id,seq_containing_proc= "NEW".seq_containing_proc,remark= "NEW".remark
    WHERE interp_process_id = "OLD".native_uid ;
ELSE
    UPDATE OpenWorks_SM.InterpretationProcess SET
    process_type = "NEW".process_type ,process_name=  "NEW".process_name, process_start_time = "NEW".process_start_time,process_end_time = "NEW".process_end_time,data_source = "NEW".data_source,process_application = "NEW".process_application,process_app_version  = "NEW".process_app_version,
    containing_process_id= "NEW".containing_process_id,seq_containing_proc= "NEW".seq_containing_proc,"nchar" = LENGTH(CAST(new.long_remark AS string)),long_remark="NEW".long_remark,remark= "NEW".remark
    WHERE interp_process_id = "OLD".native_uid ;

END;

CREATE TRIGGER ON InterpretationProcess INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC
    DELETE FROM OpenWorks_SM.InterpretationProcess WHERE interp_process_id = "OLD".native_uid  ;
END;




/*
**********************************
* ENTITY: InterpProcessInput
**********************************
*/

CREATE VIEW InterpProcessInput
(
	native_uid            VARCHAR(4000)     AUTO_INCREMENT  OPTIONS ("OpenWorksCommonModel:InterpProcessInput.native_uid.isUpdatable" false,
                                                                 "OpenWorksCommonModel:InterpProcessInput.native_uid.isCreatable" false, UPDATABLE 'FALSE'),
    interp_process_native_uid    VARCHAR(12)     NOT NULL  OPTIONS ("OpenWorksCommonModel:InterpProcessInput.interp_process_native_uid.isUpdatable" false,"OpenWorksCommonModel:InterpProcessInput.interp_process_native_uid.isCreatable" true),
    input_data_id        VARCHAR(12)             NOT NULL  OPTIONS ("OpenWorksCommonModel:InterpProcessInput.input_data_id.isUpdatable" false,"OpenWorksCommonModel:InterpProcessInput.input_data_id.isCreatable" true),
    input_data_type        VARCHAR(40)             NOT NULL  OPTIONS ("OpenWorksCommonModel:InterpProcessInput.input_data_type.isUpdatable" false,"OpenWorksCommonModel:InterpProcessInput.input_data_type.isCreatable" true),
    key1_name            VARCHAR(40)                       OPTIONS ("OpenWorksCommonModel:InterpProcessInput.key1_name.isUpdatable" false,"OpenWorksCommonModel:InterpProcessInput.key1_name.isCreatable" false,UPDATABLE 'FALSE'),
    key1_value            VARCHAR(256)                      OPTIONS ("OpenWorksCommonModel:InterpProcessInput.key1_value.isUpdatable" false,"OpenWorksCommonModel:InterpProcessInput.key1_value.isCreatable" false,UPDATABLE 'FALSE'),
    key2_name            VARCHAR(40)                       OPTIONS ("OpenWorksCommonModel:InterpProcessInput.key2_name.isUpdatable" false,"OpenWorksCommonModel:InterpProcessInput.key2_name.isCreatable" false,UPDATABLE 'FALSE'),
    key2_value            VARCHAR(256)                      OPTIONS ("OpenWorksCommonModel:InterpProcessInput.key2_value.isUpdatable" false,"OpenWorksCommonModel:InterpProcessInput.key2_value.isCreatable" false,UPDATABLE 'FALSE'),
    key3_name            VARCHAR(40)                       OPTIONS ("OpenWorksCommonModel:InterpProcessInput.key3_name.isUpdatable" false,"OpenWorksCommonModel:InterpProcessInput.key3_name.isCreatable" false,UPDATABLE 'FALSE'),
    key3_value            VARCHAR(256)                      OPTIONS ("OpenWorksCommonModel:InterpProcessInput.key3_value.isUpdatable" false,"OpenWorksCommonModel:InterpProcessInput.key3_value.isCreatable" false,UPDATABLE 'FALSE'),
    key4_name            VARCHAR(40)                       OPTIONS ("OpenWorksCommonModel:InterpProcessInput.key4_name.isUpdatable" false,"OpenWorksCommonModel:InterpProcessInput.key4_name.isCreatable" false,UPDATABLE 'FALSE'),
    key4_value            VARCHAR(256)                      OPTIONS ("OpenWorksCommonModel:InterpProcessInput.key4_value.isUpdatable" false,"OpenWorksCommonModel:InterpProcessInput.key4_value.isCreatable" false,UPDATABLE 'FALSE'),
    key5_name            VARCHAR(40)                       OPTIONS ("OpenWorksCommonModel:InterpProcessInput.key5_name.isUpdatable" false,"OpenWorksCommonModel:InterpProcessInput.key5_name.isCreatable" false,UPDATABLE 'FALSE'),
    key5_value            VARCHAR(256)                      OPTIONS ("OpenWorksCommonModel:InterpProcessInput.key5_value.isUpdatable" false,"OpenWorksCommonModel:InterpProcessInput.key5_value.isCreatable" false,UPDATABLE 'FALSE'),
    key6_name            VARCHAR(40)                       OPTIONS ("OpenWorksCommonModel:InterpProcessInput.key6_name.isUpdatable" false,"OpenWorksCommonModel:InterpProcessInput.key6_name.isCreatable" false,UPDATABLE 'FALSE'),
    key6_value            VARCHAR(256)                      OPTIONS ("OpenWorksCommonModel:InterpProcessInput.key6_value.isUpdatable" false,"OpenWorksCommonModel:InterpProcessInput.key6_value.isCreatable" false,UPDATABLE 'FALSE'),
    key7_name            VARCHAR(40)                       OPTIONS ("OpenWorksCommonModel:InterpProcessInput.key7_name.isUpdatable" false,"OpenWorksCommonModel:InterpProcessInput.key7_name.isCreatable" false,UPDATABLE 'FALSE'),
    key7_value            VARCHAR(256)                      OPTIONS ("OpenWorksCommonModel:InterpProcessInput.key7_value.isUpdatable" false,"OpenWorksCommonModel:InterpProcessInput.key7_value.isCreatable" false,UPDATABLE 'FALSE'),
    key8_name            VARCHAR(40)                       OPTIONS ("OpenWorksCommonModel:InterpProcessInput.key8_name.isUpdatable" false,"OpenWorksCommonModel:InterpProcessInput.key8_name.isCreatable" false,UPDATABLE 'FALSE'),
    key8_value            VARCHAR(256)                      OPTIONS ("OpenWorksCommonModel:InterpProcessInput.key8_value.isUpdatable" false,"OpenWorksCommonModel:InterpProcessInput.key8_value.isCreatable" false,UPDATABLE 'FALSE'),
    create_date            timestamp                         OPTIONS ("OpenWorksCommonModel:InterpProcessInput.create_date.isUpdatable" false,"OpenWorksCommonModel:InterpProcessInput.create_date.isCreatable" false,UPDATABLE 'FALSE'),
    create_user_id        VARCHAR(32)                       OPTIONS ("OpenWorksCommonModel:InterpProcessInput.create_user_id.isUpdatable" false,"OpenWorksCommonModel:InterpProcessInput.create_user_id.isCreatable" false,UPDATABLE 'FALSE'),
    update_date            timestamp                         OPTIONS ("OpenWorksCommonModel:InterpProcessInput.update_user_id.isUpdatable" false,"OpenWorksCommonModel:InterpProcessInput.update_user_id.isCreatable" false,UPDATABLE 'FALSE'),
    update_user_id        VARCHAR(32)                       OPTIONS ("OpenWorksCommonModel:InterpProcessInput.update_date.isUpdatable" false,"OpenWorksCommonModel:InterpProcessInput.update_date.isCreatable" false,UPDATABLE 'FALSE'),
    alternate_uid    		      VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:InterpProcessInput.alternate_uid.isCreatable" false,
                                                 "OpenWorksCommonModel:InterpProcessInput.alternate_uid.isUpdatable" false,
                                                 UPDATABLE 'FALSE'),


    CONSTRAINT InterpProcessInput_PK PRIMARY KEY (native_uid) ,
    CONSTRAINT InterpProcessInput_UK1 UNIQUE (interp_process_native_uid,input_data_id,input_data_type),

    CONSTRAINT FK_InterpProcessInput_interp_process_id
      FOREIGN KEY (interp_process_native_uid)
      REFERENCES InterpretationProcess(native_uid)      ,

    CONSTRAINT FK_InterpProcessInput_input_data_type
      FOREIGN KEY (input_data_type)
      REFERENCES ProcessDataType(data_type_name)

)
OPTIONS (UPDATABLE 'TRUE', InterpProcessInput.IMPLEMENTED 'TRUE')
    AS
    SELECT
        native_uid                AS  native_uid              ,
        interp_process_id        AS  interp_process_native_uid      ,
        input_data_id            AS  input_data_id          ,
        input_data_type            AS  input_data_type          ,
        key1_name            AS  key1_name              ,
        key1_value            AS  key1_value              ,
        key2_name            AS  key2_name              ,
        key2_value            AS  key2_value              ,
        key3_name            AS  key3_name              ,
        key3_value            AS  key3_value              ,
        key4_name            AS  key4_name              ,
        key4_value            AS  key4_value              ,
        key5_name            AS  key5_name              ,
        key5_value            AS  key5_value              ,
        key6_name            AS  key6_name              ,
        key6_value            AS  key6_value              ,
        key7_name            AS  key7_name              ,
        key7_value            AS  key7_value              ,
        key8_name            AS  key8_name              ,
        key8_value            AS  key8_value              ,
        create_date            AS  create_date              ,
        create_user_id        AS  create_user_id          ,
        update_date            AS  update_date              ,
        update_user_id        AS  update_user_id,
	    native_uid                AS  alternate_uid


    FROM
        OpenWorks_SM.InterpProcessInput;

Create Trigger on InterpProcessInput INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC
INSERT INTO OpenWorks_SM.InterpProcessInput
    (interp_process_id,input_data_id,input_data_type)
VALUES
