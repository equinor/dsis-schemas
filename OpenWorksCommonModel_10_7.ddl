CREATE VIEW ApplicationData2
(
  native_uid             VARCHAR(1024) AUTO_INCREMENT OPTIONS ("OpenWorksCommonModel:ApplicationData2.native_uid.isUpdatable" false,
                                                "OpenWorksCommonModel:ApplicationData2.native_uid.isCreatable" false,UPDATABLE 'FALSE'),
  application_name       VARCHAR(40) NOT NULL,
  data_category          VARCHAR(24) NOT NULL,
  data_set_name          VARCHAR(40) NOT NULL,
  data                   BLOB,
  remark                 VARCHAR(200),
  create_date            TIMESTAMP,
  create_user_id         VARCHAR(32),
  update_user_id         VARCHAR(32),
  update_date            TIMESTAMP,
  alternate_uid    		     VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:ApplicationData2.alternate_uid.isCreatable" false,
                                                "OpenWorksCommonModel:ApplicationData2.alternate_uid.isUpdatable" false,
                                                 UPDATABLE 'FALSE'),

  CONSTRAINT ApplicationData2_PK PRIMARY KEY (native_uid),
  CONSTRAINT ApplicationData2_UK1 UNIQUE (application_name, data_category, data_set_name)
)
OPTIONS (UPDATABLE 'TRUE' , ApplicationData2.IMPLEMENTED 'TRUE')
    AS
    SELECT
        native_uid AS native_uid,
        application_name AS application_name,
        data_category AS data_category,
        data_set_name AS data_set_name,
        application_data AS data,
        remark AS remark,
        create_date AS create_date,
        create_user_id AS create_user_id,
        update_user_id AS update_user_id,
        update_date AS update_date,
	    native_uid AS alternate_uid
    FROM OpenWorks_SM.ApplicationData;

Create Trigger on ApplicationData2 INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC
INSERT INTO OpenWorks_SM.ApplicationData
    (application_name, data_category, data_set_name, application_data, remark)
VALUES
    ("NEW".application_name, "NEW".data_category, "NEW".data_set_name, "NEW".data, "NEW".remark);
END;

CREATE TRIGGER ON ApplicationData2 INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC
  IF((CHANGING.data))
  BEGIN
    UPDATE OpenWorks_SM.ApplicationData SET application_data = "NEW".data, remark = "NEW".remark WHERE (application_name = "OLD".application_name) AND (data_category = "OLD".data_category) AND (data_set_name = "OLD".data_set_name);
  END ELSE
  BEGIN
    UPDATE OpenWorks_SM.ApplicationData SET remark = "NEW".remark WHERE (application_name = "OLD".application_name) AND (data_category = "OLD".data_category) AND (data_set_name = "OLD".data_set_name);
  END
END;

CREATE TRIGGER ON ApplicationData2 INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC
    DELETE FROM OpenWorks_SM.ApplicationData WHERE (application_name = "OLD".application_name) AND (data_category = "OLD".data_category) AND (data_set_name = "OLD".data_set_name);
END;

/*
**********************************
