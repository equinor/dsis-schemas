/*
 * Function to create a native_uid
 */
	CREATE VIRTUAL FUNCTION composeNativeUid(wellid String, coreid String, datasource String, aon integer, saon integer) returns String
	OPTIONS(JAVA_CLASS 'com.lgc.ow.commonmodel.udf.OWUDFFunctions', JAVA_METHOD 'composeNativeUid');
/*
 * Function to get crs name from blob
 */
    CREATE VIRTUAL FUNCTION getCrsNameFromBlob(crsBlob Blob) returns STRING
    OPTIONS(JAVA_CLASS 'com.lgc.ow.commonmodel.udf.ProtoBuffer', JAVA_METHOD 'getCrsNameFromBlob');
/*
**********************************
* ENTITY: DataSource
**********************************
*/
CREATE VIEW DataSource
(
    name                       VARCHAR(60)  NOT NULL,
    type                       VARCHAR(30)  NOT NULL,
	public_ind                 VARCHAR(1)   NOT NULL,
    remark                     VARCHAR(200) OPTIONS ("OpenWorksCommonModel:DataSource.remark.isImplemented" false, UPDATABLE 'FALSE'),
    create_date                TIMESTAMP,
    create_user_id             VARCHAR(32),
    update_date                TIMESTAMP,
    update_user_id             VARCHAR(32),

    CONSTRAINT DataSource_PK PRIMARY KEY (name)

)
OPTIONS (UPDATABLE 'FALSE', DataSource.IMPLEMENTED 'TRUE')
    AS
    SELECT
        id             AS name,
        type           AS type,
		public_ind     AS public_ind,
        name           AS remark,
        create_date    AS create_date,
        create_user_id AS create_user_id,
        update_date    AS update_date,
        update_user_id AS update_user_id
    FROM
	    OpenWorks_SM.DataSrc;

CREATE TRIGGER ON DataSource INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC

   INSERT INTO Openworks_SM.DataSrc(id,       name,       type, public_ind)
                            VALUES ("NEW".name, "NEW".remark, "NEW".type, 'Y');
END;

CREATE TRIGGER ON DataSource INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC

   Update Openworks_SM.DataSrc Set name="NEW".name,  type="NEW".type Where   id = "OLD".name;
END;

Create Trigger on DataSource INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC

	DELETE from OpenWorks_SM.DataSrc WHERE  id="OLD".name;

END;
/*
**********************************
* ENTITY: Company
**********************************
*/
CREATE VIEW Company
(
	native_uid                 VARCHAR(1024)    AUTO_INCREMENT OPTIONS ("OpenWorksCommonModel:Company.native_uid.isCreatable" false,
                                                                   "OpenWorksCommonModel:Company.native_uid.isUpdatable" false,UPDATABLE 'FALSE'),
    company_name               VARCHAR(60)  NOT NULL,
    company_abbrev             VARCHAR(30),
    company_code               VARCHAR(30),
    parent_company             VARCHAR(60),
    reference_value_source     VARCHAR(128),
    reference_value_status     VARCHAR(60),
    remark                     VARCHAR(200),
    create_date                TIMESTAMP,
    create_user_id             VARCHAR(32),
    update_date                TIMESTAMP,
    update_user_id             VARCHAR(32),
	alternate_uid    			       VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:Company.alternate_uid.isCreatable"  false,
                                                      "OpenWorksCommonModel:Company.alternate_uid.isUpdatable" false,
                                                      UPDATABLE 'FALSE'),

    CONSTRAINT Company_PK PRIMARY KEY (native_uid),

    CONSTRAINT Company_UK1 UNIQUE (company_name),

    CONSTRAINT FK_Company_parent_company
      FOREIGN KEY (parent_company)
      REFERENCES Company(company_name)

)
OPTIONS (UPDATABLE 'FALSE', Company.IMPLEMENTED 'TRUE')
    AS
    SELECT
		company_id AS native_uid,
        company_name AS company_name,
        company_abbrev AS company_abbrev,
        company_code AS company_code,
        parent_company AS parent_company,
        ref_value_source AS reference_value_source,
        ref_value_status AS reference_value_status,
        remark AS remark,
        create_date AS create_date,
        create_user_id AS create_user_id,
        update_date AS update_date,
        update_user_id AS update_user_id,
		native_uid AS alternate_uid
    FROM
        OpenWorks_SM.RCompany;



/*
**********************************
*     "Project"
**********************************
*/

CREATE VIEW Project
(
  project_name                     VARCHAR(20) NOT NULL,
  project_type                     VARCHAR(24),
  project_leader                   VARCHAR(30),
  accounting_code                  VARCHAR(24),
  measurement_system               VARCHAR(40),
  district                         VARCHAR(60),
  min_x                            DOUBLE      OPTIONS ("OpenWorksCommonModel:Project.min_x.unitField" 'xy_unit'),
  min_y                            DOUBLE      OPTIONS ("OpenWorksCommonModel:Project.min_y.unitField" 'xy_unit'),
  max_x                            DOUBLE      OPTIONS ("OpenWorksCommonModel:Project.max_x.unitField" 'xy_unit'),
  max_y                            DOUBLE      OPTIONS ("OpenWorksCommonModel:Project.max_y.unitField" 'xy_unit'),
  xy_unit                          VARCHAR(64),
  xy_crs                           VARCHAR(80),
  display_color                    INTEGER,
  map_crs                          VARCHAR(80),
  map_scale_factor                 FLOAT,
  surf_vert_datum_shift            FLOAT       OPTIONS ("OpenWorksCommonModel:Project.surf_vert_datum_shift.unitField" 'surf_vert_datum_shift_unit'),
  surf_vert_datum_shift_unit       VARCHAR(64) OPTIONS ("OpenWorksCommonModel:Project.surf_vert_datum_shift_unit.unitType" 'elevation'),
  last_access_date                 TIMESTAMP,
  last_access_user_id              VARCHAR(32),
  remark                           VARCHAR(200),
  spatial                          BLOB        OPTIONS ("OpenWorksCommonModel:Project.spatial.isSpatial" true,
                                                  "OpenWorksCommonModel:Project.spatial.isCreatable" false,
                                                  "OpenWorksCommonModel:Project.spatial.isUpdatable" false,
                                                  UPDATABLE 'FALSE',
                                                  "OpenWorksCommonModel:Project.spatial.isComplexType" true,
                                                  "OpenWorksCommonModel:Project.spatial.isComplexTypeArray" false,
                                                  "OpenWorksCommonModel:Project.spatial.elementType" 'POLYGON',
                                                  "OpenWorksCommonModel:Project.spatial.elementStruct" '[{"name":"linestring":"type":[{"name":"x","type":"double"},{"name":"y","type":"double"}]}]'),
  create_date                      TIMESTAMP,
  create_user_id                   VARCHAR(32),
  update_date                      TIMESTAMP,
  update_user_id                   VARCHAR(32),

      CONSTRAINT Project_PK PRIMARY KEY (project_name),

      CONSTRAINT FK_Project_xy_crs
        FOREIGN KEY                    (xy_crs)
        REFERENCES CartoReferenceSystem(name),

      CONSTRAINT FK_Project_map_crs
        FOREIGN KEY                    (map_crs)
        REFERENCES CartoReferenceSystem(name)
    )
    OPTIONS (UPDATABLE 'FALSE', Project.IMPLEMENTED 'TRUE')

   AS
 SELECT
    project_name,
    project_type,
    project_leader,
    acct_code as accounting_code,
    (Select name from OpenWorks_SM.MeasurementSystem where id= measurement_id) as measurement_system,
    district,
    min_x,
    min_y,
    max_x,
    max_y,
    COALESCE(min_x_dsdsunit,min_y_dsdsunit),
    getDSDSCrs((Select name from OpenWorks_SM.CartoRefSys where OpenWorks_SM.CartoRefSys.id=OpenWorks_SM.Project.xy_crs_id)) as xy_crs,
    display_color,
    getDSDSCrs((Select name from OpenWorks_SM.CartoRefSys where id=OpenWorks_SM.Project.map_crs_id)) as map_crs,
    map_scale_factor,
    surf_vert_datum_shift,
    surf_vert_datum_shift_dsdsunit,
    last_access_date,
    last_access_user_id,
    remark,
    spatial,
    create_date,
    create_user_id,
    update_date,
    update_user_id

 FROM OpenWorks_SM.Project;

/*
**********************************
*     "CartoReferenceSystem"
**********************************
*/

CREATE VIEW CartoReferenceSystem
(
  name                       VARCHAR(80)  NOT NULL,
  uom                        VARCHAR(12),
  type                       VARCHAR(40),
  geodetic_source            VARCHAR(40)  DEFAULT 'UNKNOWN',
  projection_type            VARCHAR(40)  DEFAULT 'UNKNOWN',
  basis_geographic_name      VARCHAR(80),
  shift_within_same_datum    VARCHAR(1),
  epsg_code                  INTEGER,
  num_datum_info             INTEGER,
  datum_info                 BLOB,
  num_datum_shift_options    INTEGER,
  datum_shift_options        BLOB,
  num_projection_options     INTEGER,
  projection_options         BLOB,
  num_transform_parameters   INTEGER,
  transform_parameters       BLOB,
  remark                     VARCHAR(200),
  CONSTRAINT CartoReferenceSystem_PK PRIMARY KEY (name),

  CONSTRAINT FK_CartoReferenceSystem_basis_geographic_name
    FOREIGN KEY     (basis_geographic_name)
    REFERENCES CartoReferenceSystem(name)
)
OPTIONS (UPDATABLE 'FALSE', CartoReferenceSystem.IMPLEMENTED 'TRUE')
    As
SELECT
  OpenWorks_SM.CartoRefSys.name,
  OpenWorks_SM.CartoRefSys.uom,
  OpenWorks_SM.CartoRefSys.type,
  OpenWorks_SM.CartoRefSys.geodetic_source,
  OpenWorks_SM.CartoRefSys.projection_type,
  crs2.name AS basis_geographic_name,
  OpenWorks_SM.CartoRefSys.shift_within_same_datum,
  OpenWorks_SM.CartoRefSys.epsg_code,
  OpenWorks_SM.CartoRefSys.num_datum_info,
  OpenWorks_SM.CartoRefSys.datum_info,
  OpenWorks_SM.CartoRefSys.num_datum_shift_options,
  OpenWorks_SM.CartoRefSys.datum_shift_options,
  OpenWorks_SM.CartoRefSys.num_projection_options,
  OpenWorks_SM.CartoRefSys.projection_options,
  OpenWorks_SM.CartoRefSys.num_transform_parameters,
  OpenWorks_SM.CartoRefSys.transform_parameters,
  OpenWorks_SM.CartoRefSys.remark
 FROM
OpenWorks_SM.CartoRefSys LEFT OUTER JOIN (select id,name from OpenWorks_SM.CartoRefSys)crs2 ON OpenWorks_SM.CartoRefSys.basis_geographic_id = crs2.id;

/*
**********************************
*     "Field"
**********************************
*/
CREATE VIEW Field
(
  native_uid               VARCHAR(128)  AUTO_INCREMENT
                                         OPTIONS ("OpenWorksCommonModel:Field.native_uid.isUpdatable" false,
                                                  "OpenWorksCommonModel:Field.native_uid.isCreatable" false,
                          UPDATABLE 'FALSE'),
  field_name               VARCHAR(60)  NOT NULL DEFAULT 'UNKNOWN',
  primary_reservoir        VARCHAR(40)  DEFAULT 'UNKNOWN',
  state_name               VARCHAR(20)  DEFAULT 'UNKNOWN',
  field_prospect_ind       VARCHAR(1)   DEFAULT 'F',
  multiple_reservoir_ind   VARCHAR(1),
  prospect_description     VARCHAR(400),
  nearest_discovery        VARCHAR(60)  DEFAULT 'UNKNOWN',
  producing_status         VARCHAR(40)  DEFAULT 'UNKNOWN',
  status                   VARCHAR(12)  DEFAULT 'UNKNOWN',
  project_name             VARCHAR(20)  DEFAULT 'UNKNOWN',
  discovery_basis          VARCHAR(24)  DEFAULT 'UNKNOWN',
  primary_fluid            VARCHAR(12)  DEFAULT 'UNKNOWN',
  operator_name            VARCHAR(40)  DEFAULT 'UNKNOWN',
  data_source              VARCHAR(5),
  field_code               VARCHAR(15),
  field_number             INTEGER,
  local_name               VARCHAR(30),
  planned_drill_year       TIMESTAMP,
  drilling_deadline        TIMESTAMP,
  drilling_probability     FLOAT,
  notional_well            VARCHAR(26),
  discovery_date           TIMESTAMP,
  discovery_well           VARCHAR(26),
  country_name             VARCHAR(25)  DEFAULT 'UNKNOWN',
  basin_name               VARCHAR(60)  DEFAULT 'UNKNOWN',
  play_name                VARCHAR(40)  DEFAULT 'UNKNOWN',
  trend                    VARCHAR(40),
  x_coordinate             DOUBLE       OPTIONS ("OpenWorksCommonModel:Field.x_coordinate.unitField" 'xy_unit'),
  y_coordinate             DOUBLE       OPTIONS ("OpenWorksCommonModel:Field.y_coordinate.unitField" 'xy_unit'),
  xy_unit                  VARCHAR(64),
  crs                      VARCHAR(80),
  distance_from_shore      FLOAT        OPTIONS ("OpenWorksCommonModel:Field.distance_from_shore.unitField" 'distance_from_shore_unit'),
  distance_from_shore_unit VARCHAR(64)  OPTIONS ("OpenWorksCommonModel:Field.distance_from_shore_unit.unitType"
                                                 'distance miles or km'),
  water_depth              FLOAT        OPTIONS ("OpenWorksCommonModel:Field.water_depth.unitField" 'water_depth_unit'),
  water_depth_unit         VARCHAR(64)  OPTIONS ("OpenWorksCommonModel:Field.water_depth_unit.unitType" 'elevation'),
  nearest_pipeline         VARCHAR(40),
  pipeline_distance        FLOAT        OPTIONS ("OpenWorksCommonModel:Field.pipeline_distance.unitField" 'pipeline_distance_unit'),
  pipeline_distance_unit   VARCHAR(64)  OPTIONS ("OpenWorksCommonModel:Field.pipeline_distance_unit.unitType" 'distance miles or km'),
  nearest_facility         VARCHAR(40),
  facility_distance        FLOAT        OPTIONS ("OpenWorksCommonModel:Field.facility_distance.unitField" 'facility_distance_unit'),
  facility_distance_unit   VARCHAR(64)  OPTIONS ("OpenWorksCommonModel:Field.facility_distance_unit.unitType" 'distance miles or km'),
  estimated_dev_cost       FLOAT,
  actual_dev_cost          FLOAT,
  on_off_shore             VARCHAR(3),
  currency                 VARCHAR(24)  DEFAULT 'UNKNOWN',
  remark                   VARCHAR(200),
  create_date              TIMESTAMP    OPTIONS ("OpenWorksCommonModel:Field.create_date.isUpdatable" false,
                                                 "OpenWorksCommonModel:Field.create_date.isCreatable" false,
                                                 UPDATABLE 'FALSE'),
  create_user_id           VARCHAR(32)  OPTIONS ("OpenWorksCommonModel:Field.create_user_id.isUpdatable" false,
                                                 "OpenWorksCommonModel:Field.create_user_id.isCreatable" false,
                                                 UPDATABLE 'FALSE'),
  update_user_id           VARCHAR(32)  OPTIONS ("OpenWorksCommonModel:Field.update_user_id.isUpdatable" false,
                                                 "OpenWorksCommonModel:Field.update_user_id.isCreatable" false,
                                                 UPDATABLE 'FALSE'),
  update_date              TIMESTAMP    OPTIONS ("OpenWorksCommonModel:Field.update_date.isUpdatable" false,
                                                 "OpenWorksCommonModel:Field.update_date.isCreatable" false,
                                                 UPDATABLE 'FALSE'),
  alternate_uid    			   VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:Field.alternate_uid.isCreatable" false,
												  "OpenWorksCommonModel:Field.alternate_uid.isUpdatable" false,
												  UPDATABLE 'FALSE'),

  CONSTRAINT Field_PK PRIMARY KEY (native_uid),

  CONSTRAINT Field_UK1 UNIQUE (field_name),

  CONSTRAINT FK_Field_notional_well
  FOREIGN KEY (notional_well)
  REFERENCES Wellbore(wellbore_uwi),

  CONSTRAINT FK_Field_crs
  FOREIGN KEY (crs)
  REFERENCES CartoReferenceSystem(name),

  CONSTRAINT FK_Field_project_name
  FOREIGN KEY (project_name)
  REFERENCES Project(project_name),

  CONSTRAINT FK_Field_nearest_discovery
  FOREIGN KEY (nearest_discovery)
  REFERENCES Field(field_name),

  CONSTRAINT FK_Field_discovery_well
  FOREIGN KEY (discovery_well)
  REFERENCES Wellbore(wellbore_uwi),

  CONSTRAINT FK_Field_data_source
  FOREIGN KEY (data_source)
  REFERENCES DataSource(name),

  CONSTRAINT FK_Field_operator_name
  FOREIGN KEY (operator_name)
  REFERENCES Company(company_name)
)
OPTIONS (UPDATABLE 'TRUE', Field.IMPLEMENTED 'TRUE')
AS

SELECT
 OpenWorks_SM.FieldPros.field_id,
 OpenWorks_SM.FieldPros.field_name,
 OpenWorks_SM.FieldPros.primary_reservoir,
 OpenWorks_SM.FieldPros.state,
 OpenWorks_SM.FieldPros.field_prospect_ind,
 OpenWorks_SM.FieldPros.multiple_reservoir_ind,
 OpenWorks_SM.FieldPros.prospect_description,
 OpenWorks_SM.FieldPros.nearest_discovery,
 OpenWorks_SM.FieldPros.producing_status,
 OpenWorks_SM.FieldPros.status,
 OpenWorks_SM.Project.project_name,
 OpenWorks_SM.FieldPros.discovery_basis,
 OpenWorks_SM.FieldPros.primary_fluid,
 OpenWorks_SM.FieldPros.operator_name,
 OpenWorks_SM.FieldPros.data_source,
 OpenWorks_SM.FieldPros.field_code,
 OpenWorks_SM.FieldPros.field_number,
 OpenWorks_SM.FieldPros.local_name,
 OpenWorks_SM.FieldPros.planned_drill_year,
 OpenWorks_SM.FieldPros.drilling_deadline,
 OpenWorks_SM.FieldPros.drilling_probability,
 T1.uwi AS  notional_well,
 OpenWorks_SM.FieldPros.discovery_date,
 T2.uwi AS discovery_well,
 OpenWorks_SM.FieldPros.country,
 OpenWorks_SM.FieldPros.basin,
 OpenWorks_SM.FieldPros.play_name,
 OpenWorks_SM.FieldPros.trend,
 OpenWorks_SM.FieldPros.orig_x_lon,
 OpenWorks_SM.FieldPros.orig_y_lat,
 getDSDSCrsUnit(OpenWorks_SM.CartoRefSys.name) as xy_unit,
 getDSDSCrs(OpenWorks_SM.CartoRefSys.name) as crs,
 OpenWorks_SM.FieldPros.distance_fm_shore,
 distance_fm_shore_dsdsunit,
 OpenWorks_SM.FieldPros.water_depth,
 OpenWorks_SM.FieldPros.water_depth_dsdsunit,
 OpenWorks_SM.FieldPros.nearest_pipeline,
 OpenWorks_SM.FieldPros.pipeline_distance,
 pipeline_distance_dsdsunit,
 OpenWorks_SM.FieldPros.nearest_facility,
 OpenWorks_SM.FieldPros.facility_distance,
 facility_distance_dsdsunit,
 OpenWorks_SM.FieldPros.estimated_dev_cost,
 OpenWorks_SM.FieldPros.actual_dev_cost,
 OpenWorks_SM.FieldPros.on_off_shore,
 OpenWorks_SM.FieldPros.currency,
 OpenWorks_SM.FieldPros.remark,
 OpenWorks_SM.FieldPros.create_date,
 OpenWorks_SM.FieldPros.create_user_id,
 OpenWorks_SM.FieldPros.update_user_id,
 OpenWorks_SM.FieldPros.update_date,
 OpenWorks_SM.FieldPros.native_uid
FROM
        ((OpenWorks_SM.FieldPros LEFT OUTER JOIN  /*+ optional */ Openworks_SM.WellEntire T1  ON OpenWorks_SM.FieldPros.notional_wellid = T1.wellid) LEFT OUTER JOIN /*+ optional */ Openworks_SM.WellEntire T2 ON OpenWorks_SM.FieldPros.discovery_wellid = T2.wellid) LEFT OUTER JOIN  Openworks_SM.CartoRefSys ON OpenWorks_SM.FieldPros.orig_crs_id=Openworks_SM.CartoRefSys.id,OpenWorks_SM.Project;

Create Trigger on FIELD INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC
DECLARE integer VARIABLES.field_id = (SELECT * FROM (EXEC OpenWorks_SM.nextval('FieldPros')) AS SysGenID);
DECLARE string  VARIABLES.crs_errorMsg = CONCAT (CONCAT('ERROR: The given crs value "',"NEW".crs),'" does not exist in OpenWorks or an equivalent mapping does not exist in DSDS');
DECLARE string  VARIABLES.notional_wellid_errorMsg  ='ERROR: The given notional_well value does not exist';
DECLARE string  VARIABLES.discovery_wellid_errorMsg ='ERROR: The given discovery_well value does not exist';
DECLARE string  VARIABLES.crs_id = null;
DECLARE string  VARIABLES.notional_well_id  = null;
DECLARE string  VARIABLES.discovery_well_id = null;
DECLARE string  field_pros_ind    = DECODESTRING(LOWER("NEW".field_prospect_ind),'f:F:p:P:field:F:prospect:P',':');
DECLARE string  multiple_resv_ind = DECODESTRING(LOWER("NEW".multiple_reservoir_ind),'y:Y:n:N:yes:Y:no:N',':');


    IF("NEW".crs IS NOT NULL)
    BEGIN
        VARIABLES.crs_id = (SELECT id FROM OpenWorks_SM.CartoRefSys WHERE name = (SELECT * FROM (EXEC OpenWorks_SM.GetNativeCRS("NEW".crs,'OW')) AS SysGenID));
            IF(VARIABLES.crs_id is NULL)
                ERROR VARIABLES.crs_errorMsg;
    END


    IF("NEW".notional_well IS NOT NULL)
    BEGIN
        VARIABLES.notional_well_id = (SELECT wellid FROM OpenWorks_SM.WellEntire WHERE uwi = SUBSTRING("NEW".notional_well, 1, 26));
    END

    IF("NEW".discovery_well IS NOT NULL)
    BEGIN
        VARIABLES.discovery_well_id = (SELECT wellid FROM OpenWorks_SM.WellEntire WHERE uwi = SUBSTRING("NEW".discovery_well, 1, 26));
    END


    INSERT INTO OpenWorks_SM.FieldPros (field_id,           field_name,       primary_reservoir,       state,            field_prospect_ind,       multiple_reservoir_ind,      prospect_description,       nearest_discovery,       producing_status,       status,       discovery_basis,       primary_fluid,       operator_name,       data_source,       field_code,       field_number,       local_name,       planned_drill_year,       drilling_deadline,       drilling_probability,       notional_wellid,            discovery_date,       discovery_wellid,            country,            basin,            play_name,       trend,       orig_x_lon,         orig_y_lat,         orig_crs_id,      distance_fm_shore,         distance_fm_shore_dsdsunit,     water_depth,       water_depth_dsdsunit,   nearest_pipeline,       pipeline_distance,       pipeline_distance_dsdsunit,   nearest_facility,       facility_distance,       facility_distance_dsdsunit,   estimated_dev_cost,       actual_dev_cost,       on_off_shore,       remark,       currency)
                                VALUES (VARIABLES.field_id, "NEW".field_name, "NEW".primary_reservoir, "NEW".state_name, VARIABLES.field_pros_ind, VARIABLES.multiple_resv_ind, "NEW".prospect_description, "NEW".nearest_discovery, "NEW".producing_status, "NEW".status, "NEW".discovery_basis, "NEW".primary_fluid, "NEW".operator_name, "NEW".data_source, "NEW".field_code, "NEW".field_number, "NEW".local_name, "NEW".planned_drill_year, "NEW".drilling_deadline, "NEW".drilling_probability, VARIABLES.notional_well_id, "NEW".discovery_date, VARIABLES.discovery_well_id, "NEW".country_name, "NEW".basin_name, "NEW".play_name, "NEW".trend, "NEW".x_coordinate, "NEW".y_coordinate, VARIABLES.crs_id, "NEW".distance_from_shore, "NEW".distance_from_shore_unit, "NEW".water_depth, "NEW".water_depth_unit, "NEW".nearest_pipeline, "NEW".pipeline_distance, "NEW".pipeline_distance_unit, "NEW".nearest_facility, "NEW".facility_distance, "NEW".facility_distance_unit, "NEW".estimated_dev_cost, "NEW".actual_dev_cost, "NEW".on_off_shore, "NEW".remark, "NEW".currency);
END;


Create Trigger on FIELD INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC
DECLARE string VARIABLES.crs_errorMsg= CONCAT (CONCAT('ERROR: The given crs value "',"NEW".crs),'" does not exist in OpenWorks or an equivalent mapping does not exist in DSDS');
DECLARE string VARIABLES.notional_wellid_errorMsg='ERROR: The given notional_well value does not exist';
DECLARE string VARIABLES.discovery_wellid_errorMsg='ERROR: The given discovery_well value does not exist';
DECLARE string VARIABLES.crs_id = null;
DECLARE string VARIABLES.notional_well_id  = null;
DECLARE string VARIABLES.discovery_well_id = null;
DECLARE string field_pros_ind = DECODESTRING(LOWER("NEW".field_prospect_ind),'f:F:p:P:field:F:prospect:P',':');
DECLARE string multiple_resv_ind = DECODESTRING(LOWER("NEW".multiple_reservoir_ind),'y:Y:n:N:yes:Y:no:N',':');


    IF("NEW".crs IS NOT NULL)
    BEGIN
        VARIABLES.crs_id = (SELECT id FROM OpenWorks_SM.CartoRefSys WHERE name = (SELECT * FROM (EXEC OpenWorks_SM.GetNativeCRS("NEW".crs,'OW')) AS SysGenID));
            IF(VARIABLES.crs_id is NULL)
                ERROR VARIABLES.crs_errorMsg;
    END


    IF("NEW".notional_well IS NOT NULL)
    BEGIN
        VARIABLES.notional_well_id = (SELECT wellid FROM OpenWorks_SM.WellEntire WHERE uwi = SUBSTRING("NEW".notional_well, 1, 26));
    END

    IF("NEW".discovery_well IS NOT NULL)
    BEGIN
        VARIABLES.discovery_well_id = (SELECT wellid FROM OpenWorks_SM.WellEntire WHERE uwi = SUBSTRING("NEW".discovery_well, 1, 26));
    END

    UPDATE OpenWorks_SM.FieldPros SET
    primary_reservoir="NEW".primary_reservoir,state="NEW".state_name,field_prospect_ind=VARIABLES.field_pros_ind,multiple_reservoir_ind=VARIABLES.multiple_resv_ind,prospect_description="NEW".prospect_description,
nearest_discovery="NEW".nearest_discovery,producing_status=NVL("NEW".producing_status,'UNKNOWN'),status="NEW".status,discovery_basis="NEW".discovery_basis,primary_fluid="NEW".primary_fluid,operator_name="NEW".operator_name,
data_source="NEW".data_source,field_code="NEW".field_code,field_number="NEW".field_number,local_name="NEW".local_name,planned_drill_year="NEW".planned_drill_year,drilling_deadline="NEW".drilling_deadline,
drilling_probability="NEW".drilling_probability,notional_wellid= VARIABLES.notional_well_id, discovery_date="NEW".discovery_date,discovery_wellid=VARIABLES.discovery_well_id,country="NEW".country_name,
basin="NEW".basin_name,play_name=NVL("NEW".play_name,'UNKNOWN'),trend="NEW".trend,orig_x_lon="NEW".x_coordinate,orig_y_lat="NEW".y_coordinate,orig_crs_id=VARIABLES.crs_id,distance_fm_shore="NEW".distance_from_shore,
distance_fm_shore_dsdsunit="NEW".distance_from_shore_unit,water_depth="NEW".water_depth,water_depth_dsdsunit="NEW".water_depth_unit,nearest_pipeline="NEW".nearest_pipeline,pipeline_distance="NEW".pipeline_distance,
pipeline_distance_dsdsunit="NEW".pipeline_distance_unit,nearest_facility="NEW".nearest_facility,facility_distance="NEW".facility_distance,facility_distance_dsdsunit="NEW".facility_distance_unit,
estimated_dev_cost="NEW".estimated_dev_cost,actual_dev_cost="NEW".actual_dev_cost,on_off_shore="NEW".on_off_shore,remark="NEW".remark,currency= "NEW".currency
WHERE  OpenWorks_SM.FieldPros.field_name="OLD".field_name;

END;


Create Trigger on FIELD INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC
DELETE from OpenWorks_SM.FieldPros WHERE  OpenWorks_SM.FieldPros.field_name="OLD".field_name;

END;

/*
**********************************
*     "Well"
**********************************
*/
CREATE VIEW Well
(
  native_uid               VARCHAR(1024) AUTO_INCREMENT
                                         OPTIONS ("OpenWorksCommonModel:Well.native_uid.isUpdatable" false,
                                                  "OpenWorksCommonModel:Well.native_uid.isCreatable" false,
                                                  UPDATABLE 'FALSE'),
  well_uwi                 VARCHAR(26)   NOT NULL,
  uwi_type                 VARCHAR(10),
  well_name                VARCHAR(80),
  alternate_well_name      VARCHAR(100)  OPTIONS ("OpenWorksCommonModel:Well.alternate_well_name.isCreatable"  false,
                                                  "OpenWorksCommonModel:Well.alternate_well_name.isUpdatable" false,
                                                  UPDATABLE 'FALSE'),
  well_geometry_type       VARCHAR(20)   OPTIONS ("OpenWorksCommonModel:Well.well_geometry_type.isCreatable"  false,
                                                  "OpenWorksCommonModel:Well.well_geometry_type.isUpdatable" false,
                                                  UPDATABLE 'FALSE'),
  basin_name               VARCHAR(60)   DEFAULT 'UNKNOWN',
  field_native_uid         VARCHAR(1024),
  field_name               VARCHAR(60)   OPTIONS ("OpenWorksCommonModel:Well.field_name.isUpdatable" false,
                                                  "OpenWorksCommonModel:Well.field_name.isCreatable" false,
                                                  UPDATABLE 'FALSE'),
  county_name              VARCHAR(25)   DEFAULT 'UNKNOWN',
  country_name             VARCHAR(25)   DEFAULT 'UNKNOWN',
  current_operator         VARCHAR(40)   DEFAULT 'UNKNOWN',
  spud_date                DATE          OPTIONS ("OpenWorksCommonModel:Well.spud_date.isCreatable"  false,
                                                  "OpenWorksCommonModel:Well.spud_date.isUpdatable" false,
                                                  UPDATABLE 'FALSE'),
  data_source              VARCHAR(5),
  governmental_area        VARCHAR(15),
  ground_elevation         FLOAT         OPTIONS ("OpenWorksCommonModel:Well.ground_elevation.unitField" 'ground_elevation_unit'),
  ground_elevation_unit    VARCHAR(64)   OPTIONS ("OpenWorksCommonModel:Well.ground_elevation_unit.unitType" 'elevation'),
  on_off_shore             VARCHAR(3),
  x_coordinate             DOUBLE        OPTIONS ("OpenWorksCommonModel:Well.x_coordinate.unitField" 'xy_unit'),
  y_coordinate             DOUBLE        OPTIONS ("OpenWorksCommonModel:Well.y_coordinate.unitField" 'xy_unit'),
  xy_unit                  VARCHAR(64)   OPTIONS ("OpenWorksCommonModel:Well.xy_unit.isCreatable" false,
                                                  "OpenWorksCommonModel:Well.xy_unit.isUpdatable" false,
                                                  UPDATABLE 'FALSE'),
  crs                      VARCHAR(80),
  platform_native_uid      VARCHAR(1024),
  platform_code            VARCHAR(20)   OPTIONS("OpenWorksCommonModel:Well.platform_code.isUpdatable" false,
                                                 "OpenWorksCommonModel:Well.platform_code.isCreatable" false,
                                                 UPDATABLE 'FALSE'),
  platform_slot_no         VARCHAR(12),
  state_name               VARCHAR(20)   DEFAULT 'UNKNOWN',
  survey_location_type     VARCHAR(12),
  water_depth              FLOAT         OPTIONS ("OpenWorksCommonModel:Well.water_depth.unitField" 'water_depth_unit'),
  water_depth_unit         VARCHAR(64)   OPTIONS ("OpenWorksCommonModel:Well.water_depth_unit.unitType" 'elevation'),
  well_net_interest        FLOAT         OPTIONS ("OpenWorksCommonModel:Well.well_net_interest.unitField" 'well_net_interest_unit'),
  well_net_interest_unit   VARCHAR(64)   OPTIONS ("OpenWorksCommonModel:Well.well_net_interest_unit.unitType" 'percent'),
  surface_location_point   BLOB          OPTIONS ("OpenWorksCommonModel:Well.surface_location_point.isSpatial" true,
                                                  "OpenWorksCommonModel:Well.surface_location_point.isCreatable" false,
                                                  "OpenWorksCommonModel:Well.surface_location_point.isUpdatable" false,
                                                  UPDATABLE 'FALSE',
                                                  "OpenWorksCommonModel:Well.surface_location_point.isComplexType" true,
                                                  "OpenWorksCommonModel:Well.surface_location_point.isComplexTypeArray" false,
                                                  "OpenWorksCommonModel:Well.surface_location_point.elementType" 'POINT',
                                                  "OpenWorksCommonModel:Well.surface_location_point.elementStruct" '[{"name":"x","type":"double"},{"name":"y","type":"double"}]'),
  remark                  VARCHAR(200),
  create_date             TIMESTAMP      OPTIONS ("OpenWorksCommonModel:Well.create_date.isUpdatable" false,
                                                  "OpenWorksCommonModel:Well.create_date.isCreatable" false,
                                                  UPDATABLE 'FALSE'),
  create_user_id          VARCHAR(32)    OPTIONS ("OpenWorksCommonModel:Well.create_user_id.isUpdatable" false,
                                                  "OpenWorksCommonModel:Well.create_user_id.isCreatable" false,
                                                  UPDATABLE 'FALSE'),
  update_user_id          VARCHAR(32)    OPTIONS ("OpenWorksCommonModel:Well.update_user_id.isUpdatable" false,
                                                  "OpenWorksCommonModel:Well.update_user_id.isCreatable" false,
                                                  UPDATABLE 'FALSE'),
  update_date             TIMESTAMP      OPTIONS ("OpenWorksCommonModel:Well.update_date.isUpdatable" false,
                                                  "OpenWorksCommonModel:Well.update_date.isCreatable" false,
                                                  UPDATABLE 'FALSE'),
  alternate_uid    			  VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:Well.alternate_uid.isCreatable" false,
                                                 "OpenWorksCommonModel:Well.alternate_uid.isUpdatable" false,
                                                 UPDATABLE 'FALSE'),

  CONSTRAINT Well_PK PRIMARY KEY (native_uid),
  CONSTRAINT Well_UK1 UNIQUE (well_uwi),

  CONSTRAINT FK_Well_field_native_uid
  FOREIGN KEY (field_native_uid)
  REFERENCES Field(native_uid),

  CONSTRAINT FK_Well_crs
  FOREIGN KEY (crs)
  REFERENCES CartoReferenceSystem(name),

  CONSTRAINT FK_Well_data_source
  FOREIGN KEY (data_source)
  REFERENCES DataSource(name),

  CONSTRAINT FK_Well_current_operator
  FOREIGN KEY (current_operator)
  REFERENCES Company(company_name),

  CONSTRAINT FK_Well_platform_native_uid
  FOREIGN KEY(platform_native_uid)
  REFERENCES Platform(native_uid)

)
OPTIONS (UPDATABLE 'TRUE', Well.IMPLEMENTED 'TRUE')
    AS
SELECT
    OpenWorks_SM.WellLocation.well_location_id,
    OpenWorks_SM.WellLocation.well_location_uwi AS well_uwi,
    OpenWorks_SM.WellLocation.well_uwi_type,
    OpenWorks_SM.WellLocation.well_location_name AS well_name,
    null AS alternate_well_name,
    DECODESTRING(OpenWorks_SM.WellLocation.well_geom_type,'SIMPLE:Simple:COMPLEX:Complex',':'),
    OpenWorks_SM.WellLocation.basin AS basin_name,
    f.field_id AS field_native_uid,
    f.field_name AS field_name,
    OpenWorks_SM.WellLocation.county,
    OpenWorks_SM.WellLocation.country,
    OpenWorks_SM.WellLocation.current_operator,
    null AS spud_date,
    OpenWorks_SM.WellLocation.data_source,
    OpenWorks_SM.WellLocation.govern_area,
    OpenWorks_SM.WellLocation.ground_elev,
    OpenWorks_SM.WellLocation.ground_elev_dsdsunit,
    OpenWorks_SM.WellLocation.on_off_shore,
    OpenWorks_SM.WellLocation.orig_x_lon AS x_coordinate,
    OpenWorks_SM.WellLocation.orig_y_lat AS y_coordinate,
    getDSDSCrsUnit(OpenWorks_SM.CartoRefSys.name) AS xy_unit,
    getDSDSCrs(OpenWorks_SM.CartoRefSys.name) AS crs,
    CONVERT(p.platform_code,VARCHAR(1024)),
    OpenWorks_SM.WellLocation.platform_code,
    OpenWorks_SM.WellLocation.platform_slot_no,
    OpenWorks_SM.WellLocation.state,
    OpenWorks_SM.WellLocation.survey_loc_type,
    OpenWorks_SM.WellLocation.water_depth,
    OpenWorks_SM.WellLocation.water_depth_dsdsunit AS water_depth_unit,
    OpenWorks_SM.WellLocation.well_net_int,
    OpenWorks_SM.WellLocation.well_net_int_dsdsunit,
    OpenWorks_SM.WellLocation.spatial AS surface_location_point,
    OpenWorks_SM.WellLocation.remark,
    OpenWorks_SM.WellLocation.create_date,
    OpenWorks_SM.WellLocation.create_user_id,
    OpenWorks_SM.WellLocation.update_user_id,
    OpenWorks_SM.WellLocation.update_date,
	OpenWorks_SM.WellLocation.native_uid
FROM
    (OpenWorks_SM.WellLocation LEFT OUTER JOIN /*+ optional */ ((Select distinct well_location_id,field from OpenWorks_SM.WellEntire) AS BH) ON BH.well_location_id=OpenWorks_SM.WellLocation.well_location_id) LEFT OUTER JOIN /*+ optional */ OpenWorks_SM.CartoRefSys ON orig_crs_id = id
    LEFT OUTER JOIN /*+ optional */ OpenWorks_SM.FieldPros f on BH.field = f.field_name
    LEFT OUTER JOIN/*+ optional */  OpenWorks_SM.PlatformInfo p on OpenWorks_SM.WellLocation.platform_code = p.platform_code;


CREATE TRIGGER ON Well INSTEAD OF INSERT AS
    FOR EACH ROW
BEGIN ATOMIC
    DECLARE integer VARIABLES.well_location_id = (SELECT * FROM (EXEC OpenWorks_SM.nextval('WellLocation')) AS SysGenID);
    DECLARE string VARIABLES.crs_id = null;
    DECLARE string VARIABLES.crs = "NEW".crs;
    DECLARE string VARIABLES.crs_errorMsg= CONCAT (CONCAT('ERROR: The given crs value "',"NEW".crs),'" does not exist in OpenWorks or an equivalent mapping does not exist in DSDS');

    IF("NEW".crs = '')
    BEGIN
    	VARIABLES.crs = null;
    END
    IF(VARIABLES.crs IS NOT NULL)
    BEGIN
        crs_id = (SELECT id FROM OpenWorks_SM.CartoRefSys WHERE name = (SELECT * FROM (EXEC OpenWorks_SM.GetNativeCRS(VARIABLES.crs,'OW')) AS SysGenID));
        IF (crs_id is NULL)
          ERROR VARIABLES.crs_errorMsg;
    END

    DECLARE string VARIABLES.platform_code;
    IF("NEW".platform_native_uid IS NOT NULL)
    BEGIN
       VARIABLES.platform_code = (SELECT platform_code from OpenWorks_SM.PlatformInfo where platform_code = "NEW".platform_native_uid);
    END

    INSERT INTO OpenWorks_SM.WellLocation (well_location_id,           well_location_uwi,                well_uwi_type,                    well_location_name,               basin,                              county,                              country,                              current_operator,                         data_source,                        govern_area,                               ground_elev,            ground_elev_dsdsunit,        on_off_shore,                        platform_code,                             platform_slot_no,                         state,                              orig_x_lon,         orig_y_lat,         orig_crs_id,      survey_loc_type,                              water_depth,        water_depth_dsdsunit,  well_net_int,            well_net_int_dsdsunit,        remark)
                                   VALUES (VARIABLES.well_location_id, SUBSTRING("NEW".well_uwi, 1, 26), SUBSTRING("NEW".uwi_type, 1, 10), SUBSTRING("NEW".well_name, 1,80), SUBSTRING("NEW".basin_name, 1, 60), SUBSTRING("NEW".county_name, 1, 25), SUBSTRING("NEW".country_name, 1, 25), SUBSTRING("NEW".current_operator, 1, 40), SUBSTRING("NEW".data_source, 1, 5), SUBSTRING("NEW".governmental_area, 1, 15), "NEW".ground_elevation, "NEW".ground_elevation_unit, SUBSTRING("NEW".on_off_shore, 1, 3), SUBSTRING(VARIABLES.platform_code, 1, 20), SUBSTRING("NEW".platform_slot_no, 1, 12), SUBSTRING("NEW".state_name, 1, 20), "NEW".x_coordinate, "NEW".y_coordinate, VARIABLES.crs_id, SUBSTRING("NEW".survey_location_type, 1, 12), "NEW".water_depth, "NEW".water_depth_unit, "NEW".well_net_interest, "NEW".well_net_interest_unit, SUBSTRING("NEW".remark,1,200));
END;

CREATE TRIGGER ON Well  INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC
    BEGIN
        DECLARE string VARIABLES.crs_id = null;
        DECLARE string VARIABLES.crs = "NEW".crs;
        DECLARE string VARIABLES.crs_errorMsg= CONCAT (CONCAT('ERROR: The given crs value "',"NEW".crs),'" does not exist in OpenWorks or an equivalent mapping does not exist in DSDS');
        IF("NEW".crs = '')
        BEGIN
          VARIABLES.crs = null;
        END
        IF(VARIABLES.crs IS NOT NULL)
        BEGIN
            crs_id = (SELECT id FROM OpenWorks_SM.CartoRefSys WHERE name = (SELECT * FROM (EXEC OpenWorks_SM.GetNativeCRS(VARIABLES.crs,'OW')) AS SysGenID));
                IF (crs_id is NULL)
                    ERROR VARIABLES.crs_errorMsg;
        END

        DECLARE string VARIABLES.platform_code;
        IF("NEW".platform_native_uid IS NOT NULL)
        BEGIN
           VARIABLES.platform_code = (SELECT platform_code from OpenWorks_SM.PlatformInfo where platform_code = "NEW".platform_native_uid);
        END

        UPDATE OpenWorks_SM.WellLocation SET well_uwi_type = SUBSTRING("NEW".uwi_type, 1, 10), well_location_name = SUBSTRING("NEW".well_name, 1, 80),basin = SUBSTRING(NVL("NEW".basin_name, 'UNKNOWN'), 1, 60), county = SUBSTRING(NVL("NEW".county_name, 'UNKNOWN'), 1, 25), country = SUBSTRING(NVL("NEW".country_name, 'UNKNOWN'), 1, 25), current_operator = SUBSTRING(NVL("NEW".current_operator, 'UNKNOWN'), 1, 40), data_source = SUBSTRING("NEW".data_source, 1, 5), govern_area = SUBSTRING("NEW".governmental_area, 1, 15), ground_elev = "NEW".ground_elevation, ground_elev_dsdsunit = "NEW".ground_elevation_unit, on_off_shore = SUBSTRING("NEW".on_off_shore, 1, 3), platform_code = SUBSTRING(VARIABLES.platform_code, 1, 20), platform_slot_no = SUBSTRING("NEW".platform_slot_no, 1, 12), state = SUBSTRING(NVL("NEW".state_name, 'UNKNOWN'), 1, 20), orig_x_lon = "NEW".x_coordinate, orig_y_lat = "NEW".y_coordinate, orig_crs_id = VARIABLES.crs_id, survey_loc_type = SUBSTRING("NEW".survey_location_type, 1, 12), water_depth = "NEW".water_depth, water_depth_dsdsunit = "NEW".water_depth_unit, well_net_int = "NEW".well_net_interest, well_net_int_dsdsunit = "NEW".well_net_interest_unit, remark = SUBSTRING("NEW".remark,1,200) WHERE well_location_id = "OLD".native_uid;
    END
END;

CREATE TRIGGER ON Well INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC
    DELETE FROM OpenWorks_SM.WellLocation WHERE well_location_id = "OLD".native_uid;
END;
/*
***************************************
* ENTITY: WellElevationInfo
***************************************
*/
CREATE VIEW WellElevationInfo
(
	native_uid          VARCHAR(1024)   AUTO_INCREMENT OPTIONS("OpenWorksCommonModel:WellElevationInfo.native_uid.isUpdatable" false,
                                                "OpenWorksCommonModel:WellElevationInfo.native_uid.isCreatable" false,
                                                UPDATABLE 'FALSE'),
    well_native_uid VARCHAR(1024)   NOT NULL,
    well_uwi        VARCHAR(26)     OPTIONS("OpenWorksCommonModel:WellElevationInfo.wellbore_uwi.isUpdatable" false,
                                                "OpenWorksCommonModel:WellElevationInfo.wellbore_uwi.isCreatable" false,
                                                UPDATABLE 'FALSE'),
    elevation_reference VARCHAR(60),
    data_source         VARCHAR(60),
    rig_sequence_no     INTEGER,
    elevation_value     FLOAT               OPTIONS("OpenWorksCommonModel:WellElevationInfo.elevation_value.unitField" 'elevation_unit'),
    elevation_unit      VARCHAR(64)         OPTIONS("OpenWorksCommonModel:WellElevationInfo.elevation_unit.unitType" 'elevation'),
    remark              VARCHAR(60),
    create_date         TIMESTAMP,
    create_user_id      VARCHAR(30),
    update_date         TIMESTAMP,
    update_user_id      VARCHAR(30),
    alternate_uid    		    VARCHAR(4000)  OPTIONS ("OpenWorksCommonModel:WellElevationInfo.alternate_uid.isCreatable" false,
                                                "OpenWorksCommonModel:WellElevationInfo.alternate_uid.isUpdatable" false,
                                                 UPDATABLE 'FALSE'),

    CONSTRAINT WellElevationInfo_PK PRIMARY KEY (native_uid),

    CONSTRAINT WellElevationInfo_UK1 UNIQUE (well_native_uid, elevation_reference),

    CONSTRAINT FK_WellElevationInfo_well_native_uid
        FOREIGN KEY        (well_native_uid)
        REFERENCES Well(native_uid),

    CONSTRAINT FK_WellElevationInfo_data_source
        FOREIGN KEY (data_source)
        REFERENCES DataSource(name)

)
OPTIONS (UPDATABLE 'FALSE', WellElevationInfo.IMPLEMENTED 'FALSE')
    AS
   SELECT
        null AS native_uid,
        null AS well_native_uid,
        null AS well_uwi,
        null AS elevation_reference,
        null AS data_source,
        null AS rig_sequence_no,
        null AS elevation_value,
        null AS elevation_unit,
        null AS remark,
        null AS create_date,
        null AS create_user_id,
        null AS update_date,
        null AS update_user_id,
		null AS alternate_uid
    FROM SYS.Tables
        WHERE 1 = 2;
/*
**********************************
*    "WellNarrativeLocation"
**********************************
*/

CREATE VIEW WellNarrativeLocation
(
  native_uid     VARCHAR(1024)  AUTO_INCREMENT
                                OPTIONS("OpenWorksCommonModel:WellNarrativeLocation.native_uid.isUpdatable" false,
                                        "OpenWorksCommonModel:WellNarrativeLocation.native_uid.isCreatable" false,
                                        UPDATABLE 'FALSE'),
  well_native_uid VARCHAR(1024) NOT NULL,
  well_uwi       VARCHAR(26)    OPTIONS("OpenWorksCommonModel:WellNarrativeLocation.well_uwi.isUpdatable" false,
                                        "OpenWorksCommonModel:WellNarrativeLocation.well_uwi.isCreatable" false,
                                        UPDATABLE 'FALSE'),
  sequence_no    INTEGER        DEFAULT '1',
  data_source    VARCHAR(5),
  location       VARCHAR(60),
  remark         VARCHAR(200),
  create_date    TIMESTAMP      OPTIONS ("OpenWorksCommonModel:WellNarrativeLocation.create_date.isUpdatable" false,
                                         "OpenWorksCommonModel:WellNarrativeLocation.create_date.isCreatable" false,
                                         UPDATABLE 'FALSE'),
  create_user_id VARCHAR(32)    OPTIONS ("OpenWorksCommonModel:WellNarrativeLocation.create_user_id.isUpdatable" false,
                                         "OpenWorksCommonModel:WellNarrativeLocation.create_user_id.isCreatable" false,
                                         UPDATABLE 'FALSE'),
  update_date    TIMESTAMP      OPTIONS ("OpenWorksCommonModel:WellNarrativeLocation.update_date.isUpdatable" false,
                                         "OpenWorksCommonModel:WellNarrativeLocation.update_date.isCreatable" false,
                                         UPDATABLE 'FALSE'),
  update_user_id VARCHAR(32)    OPTIONS ("OpenWorksCommonModel:WellNarrativeLocation.update_user_id.isUpdatable" false,
                                         "OpenWorksCommonModel:WellNarrativeLocation.update_user_id.isCreatable" false,
                                         UPDATABLE 'FALSE'),
  alternate_uid         VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:WellNarrativeLocation.alternate_uid.isCreatable" false,
                                         "OpenWorksCommonModel:WellNarrativeLocation.alternate_uid.isUpdatable" false,
                                          UPDATABLE 'FALSE'),

  CONSTRAINT WellNarrativeLocation_PK PRIMARY KEY (native_uid),

  CONSTRAINT WellNarrativeLocation_UK1 UNIQUE (well_native_uid, sequence_no),

  CONSTRAINT FK_WellNarrativeLocation_well_native_uid
      FOREIGN KEY    (well_native_uid)
      REFERENCES Well(native_uid),

  CONSTRAINT FK_WellNarrativeLocation_data_source
      FOREIGN KEY          (data_source)
      REFERENCES DataSource(name)

)
OPTIONS (UPDATABLE 'TRUE', WellNarrativeLocation.IMPLEMENTED 'TRUE')
AS
select
 Openworks_SM.NarrativeSurfaceLocation.native_uid,
 openworks_SM.welllocation.well_location_id,
 Openworks_SM.welllocation.well_location_uwi as well_uwi,
 seq_no as sequence_no,
 Openworks_SM.NarrativeSurfaceLocation.data_source as data_source,
 narrative_loc as location,
 Openworks_SM.NarrativeSurfaceLocation.remark,
 Openworks_SM.NarrativeSurfaceLocation.create_date,
 Openworks_SM.NarrativeSurfaceLocation.create_user_id,
 Openworks_SM.NarrativeSurfaceLocation.update_date,
 Openworks_SM.NarrativeSurfaceLocation.update_user_id,
 Openworks_SM.NarrativeSurfaceLocation.native_uid
 from
 Openworks_SM.NarrativeSurfaceLocation, openworks_SM.welllocation
 where Openworks_SM.NarrativeSurfaceLocation.well_location_id = openworks_SM.welllocation.well_location_id;

CREATE TRIGGER ON WellNarrativeLocation INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC

   DECLARE string VARIABLES.well_uwi_errorMsg='ERROR: The given well_native_uid ' || "NEW".well_native_uid || ' does not exist in Openworks';
   DECLARE string VARIABLES.well_location_id = (SELECT well_location_id FROM OpenWorks_SM.WellLocation WHERE well_location_id = "NEW".well_native_uid);
   IF(VARIABLES.well_location_id is NULL)
      ERROR VARIABLES.well_uwi_errorMsg;

   INSERT INTO Openworks_SM.NarrativeSurfaceLocation (well_location_id,           seq_no,            data_source,       narrative_loc,  remark)
                                              VALUES (VARIABLES.well_location_id, "NEW".sequence_no, "NEW".data_source, "NEW".location, "NEW".remark);
END;


CREATE TRIGGER ON WellNarrativeLocation INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC
  UPDATE OpenWorks_SM.NarrativeSurfaceLocation SET narrative_loc = "NEW".location, data_source="NEW".data_source, remark = "NEW".remark WHERE native_uid = "OLD".native_uid;
END;

CREATE TRIGGER ON WellNarrativeLocation INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC
  DELETE FROM  OpenWorks_SM.NarrativeSurfaceLocation WHERE native_uid = "OLD".native_uid;
END;

/*
**********************************
*    "WellCongressSurfaceLocation"
**********************************
*/

CREATE VIEW WellCongressSurfaceLocation
(
  native_uid          VARCHAR(1024)   OPTIONS ("OpenWorksCommonModel:WellCongressSurfaceLocation.native_uid.isUpdatable" false,
                                               "OpenWorksCommonModel:WellCongressSurfaceLocation.native_uid.isCreatable" false,
                                               UPDATABLE 'FALSE'),
  well_native_uid      VARCHAR(1024)  NOT NULL,
  well_uwi             VARCHAR(26)    OPTIONS ("OpenWorksCommonModel:WellCongressSurfaceLocation.well_uwi.isUpdatable" false,
                                               "OpenWorksCommonModel:WellCongressSurfaceLocation.well_uwi.isCreatable" false,
                                               UPDATABLE 'FALSE'),
  data_source          VARCHAR(5),
  meridian_code        INTEGER,
  meridian_name        VARCHAR(17),
  township             VARCHAR(6),
  township_direction   VARCHAR(1),
  range_no             VARCHAR(6),
  range_direction      VARCHAR(1),
  section              VARCHAR(8),
  lot                  VARCHAR(8),
  measured_reference   VARCHAR(12),
  spot                 VARCHAR(25),
  ns_footage           FLOAT          OPTIONS ("OpenWorksCommonModel:WellCongressSurfaceLocation.ns_footage.unitField" 'ns_footage_unit'),
  ns_footage_unit      VARCHAR(64)    OPTIONS ("OpenWorksCommonModel:WellCongressSurfaceLocation.ns_footage_unit.unitType" 'distance ft or m'),
  ns_direction         VARCHAR(4),
  ew_footage           FLOAT          OPTIONS ("OpenWorksCommonModel:WellCongressSurfaceLocation.ew_footage.unitField" 'ew_footage_unit'),
  ew_footage_unit      VARCHAR(64)    OPTIONS ("OpenWorksCommonModel:WellCongressSurfaceLocation.ew_footage_unit.unitType" 'distance ft or m'),
  ew_direction         VARCHAR(4),

  remark               VARCHAR(200),

  create_date          TIMESTAMP      OPTIONS ("OpenWorksCommonModel:WellCongressSurfaceLocation.create_date.isUpdatable" false,
                                               "OpenWorksCommonModel:WellCongressSurfaceLocation.create_date.isCreatable" false,
                                               UPDATABLE 'FALSE'),
  create_user_id       VARCHAR(32)    OPTIONS ("OpenWorksCommonModel:WellCongressSurfaceLocation.create_user_id.isUpdatable" false,
                                               "OpenWorksCommonModel:WellCongressSurfaceLocation.create_user_id.isCreatable" false,
                                               UPDATABLE 'FALSE'),
  update_date          TIMESTAMP      OPTIONS ("OpenWorksCommonModel:WellCongressSurfaceLocation.update_date.isUpdatable" false,
                                               "OpenWorksCommonModel:WellCongressSurfaceLocation.update_date.isCreatable" false,
                                               UPDATABLE 'FALSE'),
  update_user_id       VARCHAR(32)    OPTIONS ("OpenWorksCommonModel:WellCongressSurfaceLocation.update_user_id.isUpdatable" false,
                                               "OpenWorksCommonModel:WellCongressSurfaceLocation.update_user_id.isCreatable" false,
                                               UPDATABLE 'FALSE'),
  alternate_uid    		    VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:WellCongressSurfaceLocation.alternate_uid.isCreatable" false,
                                               "OpenWorksCommonModel:WellCongressSurfaceLocation.alternate_uid.isUpdatable" false,
                                                UPDATABLE 'FALSE'),

  CONSTRAINT WellCongressSurfaceLocation_PK PRIMARY KEY (native_uid),

  CONSTRAINT WellCongressSurfaceLocation_UK1 UNIQUE (well_native_uid),

  CONSTRAINT FK_WellCongressSurfaceLocation_well_native_uid
      FOREIGN KEY    (well_native_uid)
      REFERENCES Well(native_uid),

  CONSTRAINT FK_WellCongressSurfaceLocation_data_source
      FOREIGN KEY          (data_source)
      REFERENCES DataSource(name)

)
OPTIONS (UPDATABLE 'TRUE', WellCongressSurfaceLocation.IMPLEMENTED 'TRUE')
AS
SELECT
 OpenWorks_SM.CongressSurfaceLocation.well_location_id,
 OpenWorks_SM.WellLocation.well_location_id,
 Openworks_SM.welllocation.well_location_uwi as well_uwi,
 Openworks_SM.CongressSurfaceLocation.data_source,
 mer_code as meridian_code,
 mer_name as meridian_name,
 twp_no as township,
 twp_dir as township_direction,
 rge_no as  range_no,
 rge_dir as range_direction,
 sec as  section,
 lot,
 meas_ref as measured_reference,
 spot,
 ns_ftg as ns_footage,
 ns_ftg_dsdsunit as  ns_footage_unit,
 ns_dir as ns_direction,
 ew_ftg as ew_footage,
 ew_ftg_dsdsunit as ew_footage_unit,
 ew_dir as ew_direction,
 Openworks_SM.CongressSurfaceLocation.remark,
 Openworks_SM.CongressSurfaceLocation.create_date,
 Openworks_SM.CongressSurfaceLocation.create_user_id,
 Openworks_SM.CongressSurfaceLocation.update_date,
 Openworks_SM.CongressSurfaceLocation.update_user_id,
 OpenWorks_SM.CongressSurfaceLocation.native_uid
FROM
 Openworks_SM.CongressSurfaceLocation, openworks_SM.welllocation
WHERE
 Openworks_SM.CongressSurfaceLocation.well_location_id = openworks_SM.welllocation.well_location_id;



CREATE TRIGGER ON WellCongressSurfaceLocation INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC

   DECLARE string VARIABLES.well_uwi_errorMsg='ERROR: The given well_native_uid ' || "NEW".well_native_uid || ' does not exist in Openworks';
   DECLARE string VARIABLES.well_location_id = (SELECT well_location_id FROM OpenWorks_SM.WellLocation WHERE well_location_id = "NEW".well_native_uid);
   IF(VARIABLES.well_location_id is NULL)
      ERROR VARIABLES.well_uwi_errorMsg;

   INSERT INTO Openworks_SM.CongressSurfaceLocation (well_location_id,           data_source,                      mer_code,             mer_name,            twp_no,                        twp_dir,                  rge_no,                        rge_dir,               sec,                          lot,       meas_ref,                 spot,       ns_ftg,           ns_dir,             ew_ftg,           ew_dir,             remark,       ns_ftg_dsdsunit,       ew_ftg_dsdsunit)
                                             VALUES (VARIABLES.well_location_id, SUBSTRING("NEW".data_source,1,5), "NEW".meridian_code,  "NEW".meridian_name, SUBSTRING("NEW".township,1,6), "NEW".township_direction, SUBSTRING("NEW".range_no,1,6), "NEW".range_direction, SUBSTRING("NEW".section,1,8), "NEW".lot, "NEW".measured_reference, "NEW".spot, "NEW".ns_footage, "NEW".ns_direction, "NEW".ew_footage, "NEW".ew_direction, "NEW".remark, "NEW".ns_footage_unit, "NEW".ew_footage_unit);
END;


CREATE TRIGGER ON WellCongressSurfaceLocation INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC
   UPDATE Openworks_SM.CongressSurfaceLocation SET data_source = SUBSTRING("NEW".data_source,1,5), mer_code = "NEW".meridian_code, mer_name = "NEW".meridian_name, twp_no =  SUBSTRING("NEW".township,1,6), twp_dir = "NEW".township_direction, rge_no = SUBSTRING("NEW".range_no,1,6), rge_dir = "NEW".range_direction, sec = SUBSTRING("NEW".section,1,8), lot = "NEW".lot,  meas_ref = "NEW".measured_reference, spot =  "NEW".spot, ns_ftg = "NEW".ns_footage, ns_dir = "NEW".ns_direction, ew_ftg = "NEW".ew_footage, ew_dir = "NEW".ew_direction,  remark = "NEW".remark, ns_ftg_dsdsunit = "NEW".ns_footage_unit, ew_ftg_dsdsunit = "NEW".ew_footage_unit where well_location_id = "OLD".native_uid;
END;

CREATE TRIGGER ON WellCongressSurfaceLocation INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC
  DELETE FROM OpenWorks_SM.CongressSurfaceLocation WHERE well_location_id = "OLD".native_uid;
END;



/*
**********************************
*     "WellBore"
**********************************
*/
CREATE VIEW Wellbore
(
  native_uid                VARCHAR(1024)  AUTO_INCREMENT
                                           OPTIONS ("OpenWorksCommonModel:Wellbore.native_uid.isUpdatable" false,
                                                    "OpenWorksCommonModel:Wellbore.native_uid.isCreatable" false,
                                                    UPDATABLE 'FALSE'),
  well_native_uid           VARCHAR(1024)  NOT NULL,
  wellbore_uwi              VARCHAR(26)    NOT NULL,
  uwi_type                  VARCHAR(10),
  wellbore_name             VARCHAR(40),
  alternate_wellbore_name   VARCHAR(80),
  well_operator             VARCHAR(40)    DEFAULT 'UNKNOWN',
  wellbore_number           VARCHAR(10),
  x_coordinate              DOUBLE         OPTIONS ("OpenWorksCommonModel:Wellbore.x_coordinate.unitField" 'xy_unit'),
  y_coordinate              DOUBLE         OPTIONS ("OpenWorksCommonModel:Wellbore.y_coordinate.unitField" 'xy_unit'),
  xy_unit                   VARCHAR(64)    OPTIONS ("OpenWorksCommonModel:Wellbore.xy_unit.isUpdatable" false,
                                                    "OpenWorksCommonModel:Wellbore.xy_unit.isCreatable" false,
                                                    UPDATABLE 'FALSE'),
  crs                       VARCHAR(80),
  bh_x_coordinate           DOUBLE         OPTIONS ("OpenWorksCommonModel:Wellbore.bh_x_coordinate.unitField" 'bh_xy_unit'),
  bh_y_coordinate           DOUBLE         OPTIONS ("OpenWorksCommonModel:Wellbore.bh_y_coordinate.unitField" 'bh_xy_unit'),
  bh_xy_unit                VARCHAR(64),
  bh_crs                    VARCHAR(80),
  elevation_type            VARCHAR(2)     DEFAULT 'NA',
  elevation                 FLOAT          OPTIONS ("OpenWorksCommonModel:Wellbore.elevation.unitField" 'elevation_unit'),
  elevation_unit            VARCHAR(64)    OPTIONS ("OpenWorksCommonModel:Wellbore.elevation_unit.unitType" 'elevation'),
  total_depth               FLOAT          OPTIONS ("OpenWorksCommonModel:Wellbore.total_depth.unitField" 'total_depth_unit'),
  total_depth_unit          VARCHAR(64)    OPTIONS ("OpenWorksCommonModel:Wellbore.total_depth_unit.unitType" 'depth measure'),
  plugged_back_md           FLOAT          OPTIONS ("OpenWorksCommonModel:Wellbore.plugged_back_md.unitField" 'plugged_back_md_unit'),
  plugged_back_md_unit      VARCHAR(64)    OPTIONS ("OpenWorksCommonModel:Wellbore.plugged_back_md_unit.unitType" 'depth measure'),
  field_native_uid          VARCHAR(1024),
  field_name                VARCHAR(60)    OPTIONS ("OpenWorksCommonModel:Wellbore.field_name.isUpdatable" false,
                                                    "OpenWorksCommonModel:Wellbore.field_name.isCreatable" false,
                                                    UPDATABLE 'FALSE'),
  initial_class             VARCHAR(40)    DEFAULT 'UNKNOWN',
  initial_status            VARCHAR(40)    DEFAULT 'UNKNOWN',
  current_class             VARCHAR(40)    DEFAULT 'UNKNOWN',
  current_status            VARCHAR(40)    DEFAULT 'UNKNOWN',
  current_status_date       DATE,
  symbol                    INTEGER        OPTIONS("OpenWorksCommonModel:Wellbore.symbol.isUpdatable" false,
                                                   "OpenWorksCommonModel:Wellbore.symbol.isCreatable" false,
                                                   UPDATABLE 'FALSE'),
  data_source               VARCHAR(5),
  plot_name                 VARCHAR(20),
  survey_location_type      VARCHAR(12),
  permit_no                 VARCHAR(10),
  permit_date               DATE,
  date_data_released        DATE,
  authorization_no          VARCHAR(20),
  internal_drilling_cost    FLOAT,
  total_drilling_cost       FLOAT,
  borehole_type             VARCHAR(10),
  trajectory_shape           VARCHAR(20)   DEFAULT 'UNKNOWN',
  farm_out                  VARCHAR(1),
  security_on_off_flag      VARCHAR(3),
  restricted_data_ind       VARCHAR(1)     DEFAULT 'N',
  data_acquisition_company  VARCHAR(40)    DEFAULT 'UNKNOWN',
  data_acquisition_type     VARCHAR(12)    DEFAULT 'UNKNOWN',
  currency                  VARCHAR(24)    DEFAULT 'UNKNOWN',
  well_uwi                  VARCHAR(26)    OPTIONS("OpenWorksCommonModel:Wellbore.well_uwi.isUpdatable" false,
                                                   "OpenWorksCommonModel:Wellbore.well_uwi.isCreatable" false,
                           UPDATABLE 'FALSE'),
  parent_wellbore_native_uid VARCHAR(1024),
  parent_wellbore_uwi       VARCHAR(26)    OPTIONS ("OpenWorksCommonModel:Wellbore.parent_wellbore_uwi.isUpdatable" false,
                                                    "OpenWorksCommonModel:Wellbore.parent_wellbore_uwi.isCreatable" false,
                                                    UPDATABLE 'FALSE'),
  borehole_no               INTEGER,
  water_depth               FLOAT          OPTIONS ("OpenWorksCommonModel:Wellbore.water_depth.unitField" 'water_depth_unit'),
  water_depth_unit          VARCHAR(64)    OPTIONS ("OpenWorksCommonModel:Wellbore.water_depth_unit.unitType" 'elevation'),
  water_depth_datum         VARCHAR(12),
  kick_off_depth            FLOAT          OPTIONS ("OpenWorksCommonModel:Wellbore.kick_off_depth.unitField" 'kick_off_depth_unit'),
  kick_off_depth_unit       VARCHAR(64)    OPTIONS ("OpenWorksCommonModel:Wellbore.kick_off_depth_unit.unitType" 'depth measure'),
  kick_off_tvd             FLOAT            OPTIONS ("OpenWorksCommonModel:Wellbore.kick_off_tvd.unitField" 'kick_off_tvd_unit'),
  kick_off_tvd_unit        VARCHAR(64)      OPTIONS ("OpenWorksCommonModel:Wellbore.kick_off_tvd_unit.unitType" 'depth measure'),
  formation_at_td            VARCHAR(40)   DEFAULT 'UNKNOWN',
  well_geometry_desc        VARCHAR(40),
  user_def1                 VARCHAR(24),
  user_def2                 VARCHAR(24),
  alternate_wellbore_uwi    VARCHAR(26),
  spud_date                 DATE,
  completion_date           DATE,
  ground_elevation          FLOAT          OPTIONS ("OpenWorksCommonModel:Wellbore.ground_elevation.unitField" 'ground_elevation_unit'),
  ground_elevation_unit     VARCHAR(64)    OPTIONS ("OpenWorksCommonModel:Wellbore.ground_elevation_unit.unitType" 'elevation'),
  drilling_operator         VARCHAR(40)    DEFAULT 'UNKNOWN',
  authorized_md           FLOAT            OPTIONS ("OpenWorksCommonModel:Wellbore.authorized_md.unitField" 'authorized_md_unit'),
  authorized_tvd          FLOAT            OPTIONS ("OpenWorksCommonModel:Wellbore.authorized_tvd.unitField" 'authorized_tvd_unit'),
  authorized_md_unit      VARCHAR(64)      OPTIONS ("OpenWorksCommonModel:Wellbore.authorized_md_unit.unitType" 'depth measure'),
  authorized_tvd_unit      VARCHAR(64)      OPTIONS ("OpenWorksCommonModel:Wellbore.authorized_tvd_unit.unitType" 'depth measure'),
  bh_location_point         BLOB           OPTIONS ("OpenWorksCommonModel:Wellbore.bh_location_point.isSpatial"           true,
                                                    "OpenWorksCommonModel:Wellbore.bh_location_point.isCreatable"         false,
                                                    UPDATABLE 'FALSE',
                                                    "OpenWorksCommonModel:Wellbore.bh_location_point.isUpdatable"         false,
                                                    "OpenWorksCommonModel:Wellbore.bh_location_point.isComplexType"       true,
                                                    "OpenWorksCommonModel:Wellbore.bh_location_point.isComplexTypeArray"  false,
                                                    "OpenWorksCommonModel:Wellbore.bh_location_point.elementType"        'POINT',
                                                    "OpenWorksCommonModel:Wellbore.bh_location_point.elementStruct"      '[{"name":"x","type":"double"},{"name":"y","type":"double"}]'),
  remark                   VARCHAR(200),
  create_date              TIMESTAMP       OPTIONS("OpenWorksCommonModel:Wellbore.create_date.isUpdatable" false,
                                                   "OpenWorksCommonModel:Wellbore.create_date.isCreatable" false,
                                                   UPDATABLE 'FALSE'),
  create_user_id           VARCHAR(32)     OPTIONS("OpenWorksCommonModel:Wellbore.create_user_id.isUpdatable" false,
                                                   "OpenWorksCommonModel:Wellbore.create_user_id.isCreatable" false,
                                                   UPDATABLE 'FALSE'),
  update_date              TIMESTAMP       OPTIONS("OpenWorksCommonModel:Wellbore.update_date.isUpdatable" false,
                                                   "OpenWorksCommonModel:Wellbore.update_date.isCreatable" false,
                                                   UPDATABLE 'FALSE'),
  update_user_id           VARCHAR(32)     OPTIONS("OpenWorksCommonModel:Wellbore.update_user_id.isUpdatable" false,
                                                   "OpenWorksCommonModel:Wellbore.update_user_id.isCreatable" false,
                                                   UPDATABLE 'FALSE'),
  alternate_uid 		    VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:Wellbore.alternate_uid.isCreatable"  false,
                                                   "OpenWorksCommonModel:Wellbore.alternate_uid.isUpdatable" false,
                                                   UPDATABLE 'FALSE'),

    CONSTRAINT Wellbore_PK PRIMARY KEY (native_uid),

    CONSTRAINT Wellbore_UK1 UNIQUE (wellbore_uwi),

    CONSTRAINT FK_Wellbore_well_native_uid
    FOREIGN KEY    (well_native_uid)
    REFERENCES Well(native_uid),

    CONSTRAINT FK_Wellbore_field_native_uid
    FOREIGN KEY (field_native_uid)
    REFERENCES Field(native_uid),

    CONSTRAINT FK_Wellbore_parent_wellbore_native_uid
    FOREIGN KEY(parent_wellbore_native_uid)
    REFERENCES Wellbore(native_uid),

    CONSTRAINT FK_Wellbore_bh_crs
    FOREIGN KEY (bh_crs)
    REFERENCES CartoReferenceSystem(name),

    CONSTRAINT FK_Wellbore_crs
    FOREIGN KEY (crs)
    REFERENCES CartoReferenceSystem(name),

    CONSTRAINT FK_Wellbore_data_source
    FOREIGN KEY (data_source)
    REFERENCES DataSource(name),

    CONSTRAINT FK_Wellbore_well_operator
    FOREIGN KEY (well_operator)
    REFERENCES Company(company_name),

    CONSTRAINT FK_Wellbore_data_acquisition_company
    FOREIGN KEY (data_acquisition_company)
    REFERENCES Company(company_name),

    CONSTRAINT FK_Wellbore_drilling_operator
    FOREIGN KEY (drilling_operator)
    REFERENCES Company(company_name)

)
OPTIONS (UPDATABLE 'TRUE', Wellbore.IMPLEMENTED 'TRUE')
AS

SELECT
 wellid AS native_uid,
 well_location_id AS well_native_uid,
 uwi AS wellbore_uwi,
 well_uwi_type AS uwi_type,
 common_well_name  AS wellbore_name,
 well_name AS alternate_wellbore_name,
 well_operator,
 well_number AS wellbore_number,
 OpenWorks_SM.WellEntire.orig_x_lon AS x_coordinate,
 OpenWorks_SM.WellEntire.orig_y_lat AS y_coordinate,
 getDSDSCrsUnit(OpenWorks_SM.CartoRefSys.name) AS xy_unit,
 getDSDSCrs(OpenWorks_SM.CartoRefSys.name) AS crs,
 OpenWorks_SM.WellEntire.orig_bh_x_lon AS bh_x_coordinate,
 OpenWorks_SM.WellEntire.orig_bh_y_lat AS bh_y_coordinate,
 getDSDSCrsUnit(BHCRS.name) AS bh_xy_unit,
 getDSDSCrs(BHCRS.name) AS bh_crs,
 elev_type AS elevation_type,
 elevation AS elevation,
 elevation_dsdsunit AS elevation_unit,
 total_depth,
 total_depth_dsdsunit AS total_depth_unit,
 plugged_back_td,
 plugged_back_td_dsdsunit AS plugged_back_md_unit,
 f.field_id AS  field_native_uid,
 field AS field_name,
 initial_class,
 initial_status,
 current_class,
 current_status,
 convert(current_status_date, date) AS current_status_date,
 symbol,
 OpenWorks_SM.WellEntire.data_source,
 plot_name,
 survey_loc_type AS survey_location_type,
 permit_no,
 convert(permit_dte, date) AS permit_date,
 convert(comp_data_release_date, date) AS date_data_released,
 authorization_no,
 internal_drilling_cost,
 total_drilling_cost,
 borehole_type,
 trajectory_shape,
 farm_out,
 security_on_off_flg AS security_on_off_flag,
 restricted_data_ind,
 data_acq_company,
 data_acquisition_type,
 OpenWorks_SM.WellEntire.currency,
 well_location_uwi,
 parent_wellpath_id AS parent_wellbore_native_uid,
 parent_wellpath_uwi,
 borehole_no,
 OpenWorks_SM.WellEntire.water_depth,
 OpenWorks_SM.WellEntire.water_depth_dsdsunit,
 water_depth_datum,
 kick_off_depth,
 kick_off_depth_dsdsunit,
 null AS kick_off_tvd,
 null AS kick_off_tvd_unit,
 fm_at_td,
 well_geom_desc,
 user_def1,
 user_def2,
 alternate_uwi,
 convert(spud_date, date) AS spud_date,
 convert(completion_date, date) AS completion_date,
 ground_elev,
 ground_elev_dsdsunit,
 drilling_operator,
 null AS authorized_md,
 null AS authorized_tvd,
 null AS authorized_md_unit,
 null AS authorized_tvd_unit,
 bh_location_point as bh_location_point,
 OpenWorks_SM.WellEntire.remark,
 OpenWorks_SM.WellEntire.create_date,
 OpenWorks_SM.WellEntire.create_user_id,
 OpenWorks_SM.WellEntire.update_date,
 OpenWorks_SM.WellEntire.update_user_id,
 OpenWorks_SM.WellEntire.native_uid AS alternate_uid
    FROM
    (OpenWorks_SM.WellEntire LEFT OUTER JOIN /*+ optional */ OpenWorks_SM.CartoRefSys ON orig_crs_id = id) LEFT OUTER JOIN /*+ optional */  OpenWorks_SM.CartoRefSys BHCRS ON orig_bh_crs_id = BHCRS.id
    LEFT OUTER JOIN /*+ optional */  OpenWorks_SM.FieldPros f on OpenWorks_SM.WellEntire.field = f.field_name;



Create Trigger on Wellbore INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC
    DECLARE string VARIABLES.crs_errorMsg= CONCAT (CONCAT('ERROR: The given crs value "',"NEW".crs),'" does not exist in OpenWorks or an equivalent mapping does not exist in DSDS');
    DECLARE string VARIABLES.bh_crs_errorMsg=CONCAT (CONCAT('ERROR: The given bh_crs value "',"NEW".bh_crs),'" does not exist in OpenWorks or an equivalent mapping does not exist in DSDS');
    DECLARE string VARIABLES.parent_wellbore_errorMsg='ERROR: The given parent_wellbore_native_uid value does not exist';
    DECLARE integer VARIABLES.well_id = (SELECT * FROM (EXEC OpenWorks_SM.nextval('WellEntire')) AS SysGenID);
    /* If an empty string is passed for well_uwi , a row is inserted in the OpenWorks_SM.WellLocation. The wellbore_uwi value is passed as the well_uwi. So no validation required for well_location_id */
    DECLARE string VARIABLES.well_location_id = "NEW".well_native_uid;
    DECLARE string VARIABLES.parent_wellpath_id;
    DECLARE string VARIABLES.crs_id = null;
    DECLARE string VARIABLES.bh_crs_id = null;
    DECLARE string VARIABLES.well_operator;

    DECLARE string VARIABLES.farm_out_flag=DECODESTRING(LOWER("NEW".farm_out),'true:Y:false:N',':');
    DECLARE string VARIABLES.res_data_ind = DECODESTRING(LOWER("NEW".restricted_data_ind),'true:Y:false:N:n:N:y:Y:null:N',':');
    DECLARE string VARIABLES.elevation_type = DECODESTRING("NEW".elevation_type,'kb,KB,gl,GL,df,DF,cf,CF');

    DECLARE string VARIABLES.parent_wellpath_uwi = (SELECT uwi from OpenWorks_SM.WellEntire where  wellid = "NEW".parent_wellbore_native_uid);

    DECLARE string VARIABLES.field_name = (SELECT field_name from OpenWorks_SM.FieldPros where OpenWorks_SM.FieldPros.field_id = "NEW".field_native_uid);

    IF(VARIABLES.parent_wellpath_uwi IS NOT NULL)
    BEGIN
        VARIABLES.parent_wellpath_id = (SELECT wellid FROM OpenWorks_SM.WellEntire WHERE uwi = SUBSTRING(VARIABLES.parent_wellpath_uwi, 1, 26));
            IF(VARIABLES.parent_wellpath_id is NULL)
                ERROR VARIABLES.parent_wellbore_errorMsg;
    END
    DECLARE string VARIABLES.crs = "NEW".crs;
    IF("NEW".crs = '')
    BEGIN
      VARIABLES.crs = null;
    END
    IF(VARIABLES.crs IS NOT NULL)
    BEGIN
        VARIABLES.crs_id = (SELECT id FROM OpenWorks_SM.CartoRefSys WHERE name = (SELECT * FROM (EXEC OpenWorks_SM.GetNativeCRS(VARIABLES.crs,'OW')) AS SysGenID));
            IF(VARIABLES.crs_id is NULL)
                ERROR VARIABLES.crs_errorMsg;
    END
    IF("NEW".bh_crs IS NOT NULL)
    BEGIN
        VARIABLES.bh_crs_id = (SELECT id FROM OpenWorks_SM.CartoRefSys WHERE name = (SELECT * FROM (EXEC OpenWorks_SM.GetNativeCRS("NEW".bh_crs,'OW')) AS SysGenID));
            IF(VARIABLES.bh_crs_id is NULL)
                ERROR VARIABLES.bh_crs_errorMsg;
    END

    IF(LENGTH(TRIM("NEW".well_operator))>0)
    BEGIN
        VARIABLES.well_operator = "NEW".well_operator;
    END
    ELSE
    BEGIN
        VARIABLES.well_operator = 'UNKNOWN';
    END

    IF("NEW".x_coordinate IS NULL OR "NEW".y_coordinate IS NULL OR VARIABLES.crs_id IS NULL)
    BEGIN
        INSERT INTO OpenWorks_SM.WellEntire (wellid,  uwi,                                  well_uwi_type,  common_well_name,                      well_operator,                                             well_name,                                       well_number,           orig_bh_x_lon,         orig_bh_y_lat,          orig_bh_crs_id, elev_type,                elevation,       total_depth,       plugged_back_td,       field,                                                  initial_class,                         initial_status,                         current_class,                         current_status,                         current_status_date,                           data_source,                         plot_name,                         survey_loc_type,                              permit_no,                         permit_dte,                            comp_data_release_date,                       authorization_no,                         internal_drilling_cost,       total_drilling_cost,       borehole_type,                                        farm_out,                security_on_off_flg,                         restricted_data_ind,    data_acq_company,                                 data_acquisition_type,                         currency,       well_location_id, well_location_uwi,                parent_wellpath_id,                             parent_wellpath_uwi,                             borehole_no,       water_depth,       water_depth_dsdsunit,   kick_off_depth,       kick_off_depth_dsdsunit,   remark,                          total_depth_dsdsunit,   plugged_back_td_dsdsunit,   elevation_dsdsunit,   fm_at_td,              well_geom_desc,                             user_def1,                         user_def2,                         alternate_uwi,                spud_date,                           completion_date,                           ground_elev,            ground_elev_dsdsunit,        water_depth_datum,       drilling_operator,                         trajectory_shape)
                                     VALUES (well_id, SUBSTRING("NEW".wellbore_uwi, 1, 26), "NEW".uwi_type, SUBSTRING("NEW".wellbore_name, 1, 80), SUBSTRING(NVL(VARIABLES.well_operator, 'UNKNOWN'), 1, 40), SUBSTRING("NEW".alternate_wellbore_name, 1, 40), "NEW".wellbore_number, "NEW".bh_x_coordinate, "NEW".bh_y_coordinate,      bh_crs_id,      VARIABLES.elevation_type, "NEW".elevation, "NEW".total_depth, "NEW".plugged_back_md, SUBSTRING(NVL(VARIABLES.field_name, 'UNKNOWN'), 1, 60), SUBSTRING("NEW".initial_class, 1, 40), SUBSTRING("NEW".initial_status, 1, 40), SUBSTRING("NEW".current_class, 1, 40), SUBSTRING("NEW".current_status, 1, 40), convert("NEW".current_status_date, timestamp), SUBSTRING("NEW".data_source, 1, 5),  SUBSTRING("NEW".plot_name, 1, 20), SUBSTRING("NEW".survey_location_type, 1, 12), SUBSTRING("NEW".permit_no, 1, 10), convert("NEW".permit_date, timestamp), convert("NEW".date_data_released, timestamp), SUBSTRING("NEW".authorization_no, 1, 20), "NEW".internal_drilling_cost, "NEW".total_drilling_cost, SUBSTRING(NVL("NEW".borehole_type,'UNKNOWN'), 1, 10), VARIABLES.farm_out_flag, SUBSTRING("NEW".security_on_off_flag, 1, 3), VARIABLES.res_data_ind, SUBSTRING("NEW".data_acquisition_company, 1, 40), SUBSTRING("NEW".data_acquisition_type, 1, 12), "NEW".currency, well_location_id, SUBSTRING("NEW".well_uwi, 1, 26), convert(VARIABLES.parent_wellpath_id, integer), SUBSTRING(VARIABLES.parent_wellpath_uwi, 1, 26), "NEW".borehole_no, "NEW".water_depth, "NEW".water_depth_unit, "NEW".kick_off_depth, "NEW".kick_off_depth_unit, SUBSTRING("NEW".remark, 1, 200), "NEW".total_depth_unit, "NEW".plugged_back_md_unit, "NEW".elevation_unit, "NEW".formation_at_td, SUBSTRING("NEW".well_geometry_desc, 1, 40), SUBSTRING("NEW".user_def1, 1, 24), SUBSTRING("NEW".user_def2, 1, 24), "NEW".alternate_wellbore_uwi, convert("NEW".spud_date, timestamp), convert("NEW".completion_date, timestamp), "NEW".ground_elevation, "NEW".ground_elevation_unit, "NEW".water_depth_datum, SUBSTRING("NEW".drilling_operator, 1, 40), SUBSTRING("NEW".trajectory_shape,1,20));
    END
    ELSE
    BEGIN
        INSERT INTO OpenWorks_SM.WellEntire (wellid,  uwi,                                  well_uwi_type,  common_well_name,                      well_operator,                                             well_name,                                       well_number,           orig_x_lon,         orig_y_lat,         orig_bh_x_lon,         orig_bh_y_lat,         orig_crs_id, orig_bh_crs_id, elev_type,                elevation,       total_depth,       plugged_back_td,       field,                                                  initial_class,                         initial_status,                         current_class,                         current_status,                         current_status_date,                           data_source,                         plot_name,                         survey_loc_type,                              permit_no,                         permit_dte,                            comp_data_release_date,                       authorization_no,                         internal_drilling_cost,       total_drilling_cost,       borehole_type,                                        farm_out,                security_on_off_flg,                         restricted_data_ind,    data_acq_company,                                 data_acquisition_type,                         currency,       well_location_id, well_location_uwi,                parent_wellpath_id,                             parent_wellpath_uwi,                             borehole_no,       water_depth,       water_depth_dsdsunit,   kick_off_depth,       kick_off_depth_dsdsunit,   remark,                          total_depth_dsdsunit,   plugged_back_td_dsdsunit,   elevation_dsdsunit,   fm_at_td,              well_geom_desc,                             user_def1,                         user_def2,                         alternate_uwi,                spud_date,                           completion_date,                           ground_elev,            ground_elev_dsdsunit,        water_depth_datum,       drilling_operator,                         trajectory_shape)
                                     VALUES (well_id, SUBSTRING("NEW".wellbore_uwi, 1, 26), "NEW".uwi_type, SUBSTRING("NEW".wellbore_name, 1, 80), SUBSTRING(NVL(VARIABLES.well_operator, 'UNKNOWN'), 1, 40), SUBSTRING("NEW".alternate_wellbore_name, 1, 40), "NEW".wellbore_number, "NEW".x_coordinate, "NEW".y_coordinate, "NEW".bh_x_coordinate, "NEW".bh_y_coordinate, crs_id,      bh_crs_id,      VARIABLES.elevation_type, "NEW".elevation, "NEW".total_depth, "NEW".plugged_back_md, SUBSTRING(NVL(VARIABLES.field_name, 'UNKNOWN'), 1, 60), SUBSTRING("NEW".initial_class, 1, 40), SUBSTRING("NEW".initial_status, 1, 40), SUBSTRING("NEW".current_class, 1, 40), SUBSTRING("NEW".current_status, 1, 40), convert("NEW".current_status_date, timestamp), SUBSTRING("NEW".data_source, 1, 5),  SUBSTRING("NEW".plot_name, 1, 20), SUBSTRING("NEW".survey_location_type, 1, 12), SUBSTRING("NEW".permit_no, 1, 10), convert("NEW".permit_date, timestamp), convert("NEW".date_data_released, timestamp), SUBSTRING("NEW".authorization_no, 1, 20), "NEW".internal_drilling_cost, "NEW".total_drilling_cost, SUBSTRING(NVL("NEW".borehole_type,'UNKNOWN'), 1, 10), VARIABLES.farm_out_flag, SUBSTRING("NEW".security_on_off_flag, 1, 3), VARIABLES.res_data_ind, SUBSTRING("NEW".data_acquisition_company, 1, 40), SUBSTRING("NEW".data_acquisition_type, 1, 12), "NEW".currency, well_location_id, SUBSTRING("NEW".well_uwi, 1, 26), convert(VARIABLES.parent_wellpath_id, integer), SUBSTRING(VARIABLES.parent_wellpath_uwi, 1, 26), "NEW".borehole_no, "NEW".water_depth, "NEW".water_depth_unit, "NEW".kick_off_depth, "NEW".kick_off_depth_unit, SUBSTRING("NEW".remark, 1, 200), "NEW".total_depth_unit, "NEW".plugged_back_md_unit, "NEW".elevation_unit, "NEW".formation_at_td, SUBSTRING("NEW".well_geometry_desc, 1, 40), SUBSTRING("NEW".user_def1, 1, 24), SUBSTRING("NEW".user_def2, 1, 24), "NEW".alternate_wellbore_uwi, convert("NEW".spud_date, timestamp), convert("NEW".completion_date, timestamp), "NEW".ground_elevation, "NEW".ground_elevation_unit, "NEW".water_depth_datum, SUBSTRING("NEW".drilling_operator, 1, 40), SUBSTRING("NEW".trajectory_shape,1,20));
    END
END;



Create Trigger on Wellbore INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC
    DECLARE string VARIABLES.crs_errorMsg= CONCAT (CONCAT('ERROR: The given crs value "',"NEW".crs),'" does not exist in OpenWorks or an equivalent mapping does not exist in DSDS');
    DECLARE string VARIABLES.bh_crs_errorMsg=CONCAT (CONCAT('ERROR: The given bh_crs value "',"NEW".bh_crs),'" does not exist in OpenWorks or an equivalent mapping does not exist in DSDS');
    DECLARE string VARIABLES.well_location_id;
    DECLARE string VARIABLES.bh_crs_id = null;
    DECLARE string VARIABLES.crs_id= null;
    DECLARE string VARIABLES.well_operator;


    DECLARE string VARIABLES.farm_out_flag=DECODESTRING(LOWER("NEW".farm_out),'true:Y:false:N',':');
    DECLARE string VARIABLES.res_data_ind = DECODESTRING(LOWER("NEW".restricted_data_ind),'true:Y:false:N:n:N:y:Y:null:N',':');
    DECLARE string VARIABLES.elevation_type = DECODESTRING("NEW".elevation_type,'kb,KB,gl,GL,df,DF,cf,CF');


    DECLARE string VARIABLES.parent_wellpath_uwi = (SELECT uwi from OpenWorks_SM.WellEntire where  wellid = "NEW".parent_wellbore_native_uid);

    DECLARE string VARIABLES.field_name = (SELECT field_name from OpenWorks_SM.FieldPros where OpenWorks_SM.FieldPros.field_id = "NEW".field_native_uid);
    DECLARE string VARIABLES.setFields = ' ';

    DECLARE string VARIABLES.crs = "NEW".crs;
    IF("NEW".crs = '')
    BEGIN
        VARIABLES.crs = null;
    END
    IF(VARIABLES.crs IS NOT NULL)
    BEGIN
        VARIABLES.crs_id = (SELECT id FROM OpenWorks_SM.CartoRefSys WHERE name = (SELECT * FROM (EXEC OpenWorks_SM.GetNativeCRS(VARIABLES.crs,'OW')) AS SysGenID));
            IF(VARIABLES.crs_id is NULL)
                ERROR VARIABLES.crs_errorMsg;
    END
    IF("NEW".bh_crs IS NOT NULL)
    BEGIN
        VARIABLES.bh_crs_id = (SELECT id FROM OpenWorks_SM.CartoRefSys WHERE name = (SELECT * FROM (EXEC OpenWorks_SM.GetNativeCRS("NEW".bh_crs,'OW')) AS SysGenID));
            IF(VARIABLES.bh_crs_id is NULL)
                ERROR VARIABLES.bh_crs_errorMsg;
    END

    IF(LENGTH(TRIM("NEW".well_operator))>0)
    BEGIN
        VARIABLES.well_operator = "NEW".well_operator;
    END
    ELSE
    BEGIN
        VARIABLES.well_operator = 'UNKNOWN';
    END


    IF(NOT ("NEW".completion_date IS NULL AND "OLD".completion_date IS NULL))
    BEGIN
      VARIABLES.setFields = ', completion_date = convert("NEW".completion_date, timestamp) ';
    END

    IF(NOT ("NEW".spud_date IS NULL AND "OLD".spud_date IS NULL))
    BEGIN
      VARIABLES.setFields = VARIABLES.setFields || ', spud_date = convert("NEW".spud_date, timestamp) ';
    END

    EXECUTE IMMEDIATE 'UPDATE OpenWorks_SM.WellEntire SET well_uwi_type = "NEW".uwi_type, common_well_name = SUBSTRING("NEW".wellbore_name, 1, 80), well_operator = SUBSTRING(NVL(VARIABLES.well_operator, ''UNKNOWN''), 1, 40), well_name = SUBSTRING("NEW".alternate_wellbore_name, 1, 40), well_number = "NEW".wellbore_number, elev_type = VARIABLES.elevation_type, elevation = "NEW".elevation, total_depth = "NEW".total_depth, plugged_back_td = "NEW".plugged_back_md, field = SUBSTRING(NVL(VARIABLES.field_name, ''UNKNOWN''), 1, 60), initial_class = SUBSTRING(NVL("NEW".initial_class,''UNKNOWN''), 1, 40), initial_status = SUBSTRING(NVL("NEW".initial_status,''UNKNOWN''), 1, 40), current_class = SUBSTRING(NVL("NEW".current_class,''UNKNOWN''), 1, 40), current_status = SUBSTRING(NVL("NEW".current_status,''UNKNOWN''), 1, 40), current_status_date = convert("NEW".current_status_date, timestamp),data_source = SUBSTRING("NEW".data_source, 1, 5), plot_name = "NEW".plot_name, survey_loc_type = SUBSTRING("NEW".survey_location_type, 1, 12), permit_no = SUBSTRING("NEW".permit_no, 1, 10), permit_dte = convert("NEW".permit_date, timestamp), comp_data_release_date = convert("NEW".date_data_released, timestamp), authorization_no = "NEW".authorization_no, internal_drilling_cost = "NEW".internal_drilling_cost, total_drilling_cost = "NEW".total_drilling_cost, borehole_type = SUBSTRING(NVL("NEW".borehole_type,''UNKNOWN''), 1, 10), farm_out =  VARIABLES.farm_out_flag, security_on_off_flg = SUBSTRING("NEW".security_on_off_flag, 1, 3), restricted_data_ind = VARIABLES.res_data_ind, data_acq_company = SUBSTRING("NEW".data_acquisition_company, 1, 40), data_acquisition_type = SUBSTRING("NEW".data_acquisition_type, 1, 12), currency = "NEW".currency, well_location_id = "NEW".well_native_uid, well_location_uwi = SUBSTRING("NEW".well_uwi, 1, 26), parent_wellpath_id = "NEW".parent_wellbore_native_uid, parent_wellpath_uwi = SUBSTRING(VARIABLES.parent_wellpath_uwi, 1, 26), borehole_no = "NEW".borehole_no, water_depth = "NEW".water_depth, water_depth_dsdsunit = "NEW".water_depth_unit, kick_off_depth = "NEW".kick_off_depth, kick_off_depth_dsdsunit = "NEW".kick_off_depth_unit, remark = SUBSTRING("NEW".remark,1,200), total_depth_dsdsunit = "NEW".total_depth_unit, plugged_back_td_dsdsunit = "NEW".plugged_back_md_unit, elevation_dsdsunit = "NEW".elevation_unit,fm_at_td = NVL("NEW".formation_at_td,''UNKNOWN''),  well_geom_desc = SUBSTRING("NEW".well_geometry_desc, 1, 40), user_def1 = SUBSTRING("NEW".user_def1, 1, 24), user_def2 = SUBSTRING("NEW".user_def2, 1, 24), alternate_uwi = "NEW".alternate_wellbore_uwi, ground_elev = "NEW".ground_elevation, ground_elev_dsdsunit = "NEW".ground_elevation_unit, water_depth_datum = "NEW".water_depth_datum, drilling_operator = SUBSTRING("NEW".drilling_operator, 1, 41), trajectory_shape = SUBSTRING(NVL("NEW".trajectory_shape,''UNKNOWN''),1,20), orig_crs_id =VARIABLES.crs_id, orig_bh_crs_id=VARIABLES.bh_crs_id,        orig_x_lon = "NEW".x_coordinate, orig_y_lat = "NEW".y_coordinate , orig_bh_x_lon = "NEW".bh_x_coordinate, orig_bh_y_lat = "NEW".bh_y_coordinate ' || VARIABLES.setFields || ' WHERE wellid = "OLD".native_uid';

END;

CREATE TRIGGER ON Wellbore INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC
    DELETE FROM OpenWorks_SM.WellEntire WHERE wellid = "OLD".native_uid;
END;



/*
**********************************
*    "WellboreElevationInfo"
**********************************
*/

CREATE VIEW WellboreElevationInfo
(
  native_uid          VARCHAR(1024)   AUTO_INCREMENT
                                      OPTIONS("OpenWorksCommonModel:WellboreElevationInfo.native_uid.isUpdatable" false,
                                              "OpenWorksCommonModel:WellboreElevationInfo.native_uid.isCreatable" false,
                                              UPDATABLE 'FALSE'),
  wellbore_native_uid VARCHAR(1024)   NOT NULL,
  wellbore_uwi        VARCHAR(26)     OPTIONS("OpenWorksCommonModel:WellboreElevationInfo.wellbore_uwi.isUpdatable" false,
                                              "OpenWorksCommonModel:WellboreElevationInfo.wellbore_uwi.isCreatable" false,
                                              UPDATABLE 'FALSE'),
  elevation_reference VARCHAR(2),
  data_source         VARCHAR(5),
  rig_sequence_no     INTEGER,
  elevation_value     FLOAT           OPTIONS("OpenWorksCommonModel:WellboreElevationInfo.elevation_value.unitField" 'elevation_unit'),
  elevation_unit      VARCHAR(12)     OPTIONS("OpenWorksCommonModel:WellboreElevationInfo.elevation_unit.unitType" 'elevation'),
  remark              VARCHAR(200),

  create_date         TIMESTAMP       OPTIONS ("OpenWorksCommonModel:WellboreElevationInfo.create_date.isUpdatable" false,
                                               "OpenWorksCommonModel:WellboreElevationInfo.create_date.isCreatable" false,
                                               UPDATABLE 'FALSE'),
  create_user_id      VARCHAR(32)     OPTIONS ("OpenWorksCommonModel:WellboreElevationInfo.create_user_id.isUpdatable" false,
                                               "OpenWorksCommonModel:WellboreElevationInfo.create_user_id.isCreatable" false,
                                               UPDATABLE 'FALSE'),
  update_date         TIMESTAMP       OPTIONS ("OpenWorksCommonModel:WellboreElevationInfo.update_date.isUpdatable" false,
                                               "OpenWorksCommonModel:WellboreElevationInfo.update_date.isCreatable" false,
                                               UPDATABLE 'FALSE'),
  update_user_id      VARCHAR(32)     OPTIONS ("OpenWorksCommonModel:WellboreElevationInfo.update_user_id.isUpdatable" false,
                                               "OpenWorksCommonModel:WellboreElevationInfo.update_user_id.isCreatable" false,
                                               UPDATABLE 'FALSE'),
  alternate_uid    		  VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:WellboreElevationInfo.alternate_uid.isCreatable" false,
                                             "OpenWorksCommonModel:WellboreElevationInfo.alternate_uid.isUpdatable" false,
                                             UPDATABLE 'FALSE'),

  CONSTRAINT WellboreElevationInfo_PK PRIMARY KEY (native_uid),

  CONSTRAINT WellboreElevationInfo_UK1 UNIQUE (wellbore_native_uid, elevation_reference),

  CONSTRAINT FK_WellboreElevationInfo_wellbore_native_uid
      FOREIGN KEY        (wellbore_native_uid)
      REFERENCES Wellbore(native_uid),

  CONSTRAINT FK_WellboreElevationInfo_data_source
      FOREIGN KEY (data_source)
      REFERENCES DataSource(name)

)
OPTIONS (UPDATABLE 'TRUE', WellboreElevationInfo.IMPLEMENTED 'TRUE')
AS
select
 Openworks_SM.ElevInfo.native_uid as native_uid,
 openworks_SM.wellentire.wellid as wellbore_native_uid,
 Openworks_SM.wellentire.uwi as wellbore_uwi,
 elev_ref as elevation_reference,
 Openworks_SM.ElevInfo.data_source as data_source,
 rig_seq_no,
 elev_value as elevation_value,
 elev_value_dsdsunit as elevation_unit,
 Openworks_SM.ElevInfo.remark,
 Openworks_SM.ElevInfo.create_date,
 Openworks_SM.ElevInfo.create_user_id,
 Openworks_SM.ElevInfo.update_date,
 Openworks_SM.ElevInfo.update_user_id,
 Openworks_SM.ElevInfo.native_uid as alternate_uid
 from
 Openworks_SM.ElevInfo, openworks_SM.wellentire
 where Openworks_SM.ElevInfo.wellid = openworks_SM.wellentire.wellid;



CREATE TRIGGER ON WellboreElevationInfo INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC

  DECLARE string VARIABLES.wellbore_uwi_errorMsg='ERROR: The given wellbore_native_uid "' ||"NEW".wellbore_native_uid || '" does not exist in OpenWorks';
  DECLARE string VARIABLES.elevreflength_errorMsg='ERROR: The length of the elevation reference "' ||"NEW".elevation_reference || '" cannot be more than 2 characters. Possible values or KB/GL/DF/RT etc';
  DECLARE string VARIABLES.wellid = (SELECT wellid FROM OpenWorks_SM.WellEntire WHERE wellid = "NEW".wellbore_native_uid);

  IF(VARIABLES.wellid IS NULL)
  BEGIN
    ERROR VARIABLES.wellbore_uwi_errorMsg;
  END

  IF(LENGTH("NEW".elevation_reference) > 2)
  BEGIN
    ERROR VARIABLES.elevreflength_errorMsg;
  END

  DECLARE string VARIABLES.elevref = (SELECT elev_ref FROM OpenWorks_SM.ElevInfo WHERE wellid = VARIABLES.wellid and elev_ref = "NEW".elevation_reference);

  IF(VARIABLES.elevref IS NULL)
    INSERT INTO Openworks_SM.ElevInfo (wellid,           elev_ref,                  data_source,       rig_seq_no,            elev_value,            remark,       elev_value_dsdsunit)
                               VALUES (VARIABLES.wellid, "NEW".elevation_reference, "NEW".data_source, "NEW".rig_sequence_no, "NEW".elevation_value, "NEW".remark, "NEW".elevation_unit);
  ELSE
    UPDATE Openworks_SM.ElevInfo set data_source = "NEW".data_source, rig_seq_no = "NEW".rig_sequence_no, elev_value = "NEW".elevation_value, remark = "NEW".remark, elev_value_dsdsunit = "NEW".elevation_unit where wellid = VARIABLES.wellid and elev_ref = "NEW".elevation_reference;
END;


CREATE TRIGGER ON WellboreElevationInfo INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC
   DECLARE string VARIABLES.wellbore_uwi_errorMsg='ERROR: The given wellbore_native_uid "' ||"NEW".wellbore_native_uid || '" does not exist in OpenWorks';
   DECLARE string VARIABLES.elevreflength_errorMsg='ERROR: The length of the elevation reference "' ||"NEW".elevation_reference || '" cannot be more than 2 characters. Possible values or KB/GL/DF/RT etc';
  DECLARE string VARIABLES.wellid = (SELECT wellid FROM OpenWorks_SM.WellEntire WHERE wellid = "NEW".wellbore_native_uid);

  IF(VARIABLES.wellid IS NULL)
  BEGIN
    ERROR VARIABLES.wellbore_uwi_errorMsg;
  END

   IF(LENGTH("NEW".elevation_reference) > 2)
   BEGIN
     ERROR VARIABLES.elevreflength_errorMsg;
   END

  DECLARE string VARIABLES.elevref = (SELECT elev_ref FROM OpenWorks_SM.ElevInfo WHERE wellid = VARIABLES.wellid and elev_ref = "NEW".elevation_reference);

   IF(VARIABLES.elevref IS NULL)
     INSERT INTO Openworks_SM.ElevInfo (wellid,           elev_ref,                  data_source,       rig_seq_no,            elev_value,            remark,       elev_value_dsdsunit)
                                VALUES (VARIABLES.wellid, "NEW".elevation_reference, "NEW".data_source, "NEW".rig_sequence_no, "NEW".elevation_value, "NEW".remark, "NEW".elevation_unit);
   ELSE
    UPDATE Openworks_SM.ElevInfo set data_source = "NEW".data_source, rig_seq_no = "NEW".rig_sequence_no, elev_value = "NEW".elevation_value, remark = "NEW".remark, elev_value_dsdsunit = "NEW".elevation_unit where wellid = VARIABLES.wellid and elev_ref = "NEW".elevation_reference;
END;

CREATE TRIGGER ON WellboreElevationInfo INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC
  DELETE FROM  OpenWorks_SM.ElevInfo  where native_uid = "OLD".native_uid;
END;

/*
**********************************
*     "Directional Survey "
**********************************
*/

CREATE VIEW DirectionalSurvey
(
  native_uid                    VARCHAR(1024)  AUTO_INCREMENT OPTIONS("OpenWorksCommonModel:DirectionalSurvey.native_uid.isUpdatable" false,
                                                   "OpenWorksCommonModel:DirectionalSurvey.native_uid.isCreatable" false,
                                                    UPDATABLE 'FALSE'),
  wellbore_native_uid           VARCHAR(1024)  NOT NULL,
  survey_name                   VARCHAR(50)    NOT NULL,
  wellbore_uwi                  VARCHAR(26)    OPTIONS("OpenWorksCommonModel:DirectionalSurvey.wellbore_uwi.isUpdatable" false,
                                                       "OpenWorksCommonModel:DirectionalSurvey.wellbore_uwi.isCreatable" false,
                                                       UPDATABLE 'FALSE'),
  data_source                   VARCHAR(5),
  company                       VARCHAR(40)    DEFAULT 'UNKNOWN',
  preferred_survey_ind          VARCHAR(1)     DEFAULT 'N',
  compute_xyz_ind               VARCHAR(1)     DEFAULT 'Y',
  survey_description            VARCHAR(1024),
  survey_engineer               VARCHAR(60),
  survey_date                   DATE,
  end_date                      DATE,
  survey_method                 VARCHAR(30),
  survey_tool                   VARCHAR(40)    DEFAULT 'UNKNOWN',
  survey_calc_method            VARCHAR(20)    NOT NULL DEFAULT 'Minimum Curvature' ,
  single_multi_shot             VARCHAR(12),
  survey_conf_factor            VARCHAR(1),
  north_reference               VARCHAR(12)    NOT NULL,
  reference_elevation           FLOAT          OPTIONS ("OpenWorksCommonModel:DirectionalSurvey.reference_elevation.unitField" 'reference_elevation_unit'),
  reference_elevation_unit      VARCHAR(64)    OPTIONS ("OpenWorksCommonModel:DirectionalSurvey.reference_elevation_unit.unitType" 'elevation'),
  resample_distance             FLOAT          OPTIONS ("OpenWorksCommonModel:DirectionalSurvey.resample_distance.unitField" 'resample_distance_unit'),
  resample_distance_unit        VARCHAR(64)    OPTIONS ("OpenWorksCommonModel:DirectionalSurvey.resample_distance_unit.unitType" 'depth measure'),
  scale_type                    VARCHAR(12),
  convergence_angle             FLOAT          OPTIONS ("OpenWorksCommonModel:DirectionalSurvey.convergence_angle.unitField" 'convergence_angle_unit'),
  convergence_angle_unit        VARCHAR(64)    OPTIONS ("OpenWorksCommonModel:DirectionalSurvey.convergence_angle_unit.unitType" 'angular distance'),
  tie_pt_md                     FLOAT          OPTIONS ("OpenWorksCommonModel:DirectionalSurvey.tie_pt_md.unitField" 'tie_pt_md_unit'),
  tie_pt_md_unit                VARCHAR(64)    OPTIONS ("OpenWorksCommonModel:DirectionalSurvey.tie_pt_md_unit.unitType" 'depth measure'),
  tie_pt_tvd                    FLOAT          OPTIONS ("OpenWorksCommonModel:DirectionalSurvey.tie_pt_tvd.unitField" 'tie_pt_tvd_unit'),
  tie_pt_tvd_unit               VARCHAR(64)    OPTIONS ("OpenWorksCommonModel:DirectionalSurvey.tie_pt_tvd_unit.unitType" 'depth measure'),
  tie_pt_x_offset               FLOAT          OPTIONS ("OpenWorksCommonModel:DirectionalSurvey.tie_pt_x_offset.unitField" 'tie_pt_xy_offset_unit'),
  tie_pt_y_offset               FLOAT          OPTIONS ("OpenWorksCommonModel:DirectionalSurvey.tie_pt_y_offset.unitField" 'tie_pt_xy_offset_unit'),
  tie_pt_xy_offset_unit         VARCHAR(64)    OPTIONS ("OpenWorksCommonModel:DirectionalSurvey.tie_pt_xy_offset_unit.unitType" 'distance ft or m'),
  tie_pt_initial_azimuth        FLOAT          OPTIONS ("OpenWorksCommonModel:DirectionalSurvey.tie_pt_initial_azimuth.unitField" 'tie_pt_initial_azimuth_unit'),
  tie_pt_initial_azimuth_unit   VARCHAR(64)    OPTIONS ("OpenWorksCommonModel:DirectionalSurvey.tie_pt_initial_azimuth_unit.unitType" 'angular distance'),
  tie_pt_initial_angle          FLOAT          OPTIONS ("OpenWorksCommonModel:DirectionalSurvey.tie_pt_initial_angle.unitField" 'tie_pt_initial_angle_unit'),
  tie_pt_initial_angle_unit     VARCHAR(64)    OPTIONS ("OpenWorksCommonModel:DirectionalSurvey.tie_pt_initial_angle_unit.unitType" 'angular distance'),
  crs                           VARCHAR(128),
  npts                          INTEGER        NOT NULL DEFAULT '0' ,
  data                          BLOB           NOT NULL
                                               OPTIONS ("OpenWorksCommonModel:DirectionalSurvey.data.isComplexType" true,
                                                        "OpenWorksCommonModel:DirectionalSurvey.data.isComplexTypeArray" true,
                                                        "OpenWorksCommonModel:DirectionalSurvey.data.elementType" 'DirectionalSurveyData',
                                                        "OpenWorksCommonModel:DirectionalSurvey.data.elementStruct" '[{"name":"md","type":"float[]"},{"name":"tvd","type":"float[]"},{"name":"azimuth","type":"float[]"},{"name":"inclination","type":"float[]"},{"name":"x_offset","type":"float[]"},{"name":"y_offset","type":"float[]"},{"name":"x_bias","type":"float[]"},{"name":"y_bias","type":"float[]"},{"name":"z_bias", "type":"float[]"}, {"name":"covariant_xx","type":"float[]"}, {"name":"covariant_xy","type":"float[]"}, {"name":"covariant_xz","type":"float[]"}, {"name":"covariant_yy","type":"float[]"}, {"name":"covariant_yz","type":"float[]"}, {"name":"covariant_zz","type":"float[]"}]',
                                                        "OpenWorksCommonModel:DirectionalSurvey.data.elementMetadata"    '[{"name":"md", "unitField":"md_unit"}, {"name":"tvd", "unitField":"tvd_unit"}, {"name":"azimuth", "unitField":"azimuth_unit"}, {"name":"inclination", "unitField":"inclination_unit"}, {"name":"x_offset", "unitField":"xy_offset_unit"}, {"name":"y_offset", "unitField":"xy_offset_unit"}, {"name":"x_bias", "unitField":"x_bias_unit"}, {"name":"y_bias", "unitField":"y_bias_unit"}, {"name":"z_bias", "unitField":"z_bias_unit"},  {"name":"covariant_xx", "unitField":"covariant_unit"},  {"name":"covariant_xy", "unitField":"covariant_unit"},  {"name":"covariant_xz", "unitField":"covariant_unit"},  {"name":"covariant_yy", "unitField":"covariant_unit"},  {"name":"covariant_yz", "unitField":"covariant_unit"},  {"name":"covariant_zz", "unitField":"covariant_unit"}]'),
  md_unit                       VARCHAR(64)    NOT NULL
                                               OPTIONS ("OpenWorksCommonModel:DirectionalSurvey.md_unit.unitType" 'depth measure'),
  inclination_unit              VARCHAR(64)    NOT NULL
                                               OPTIONS ("OpenWorksCommonModel:DirectionalSurvey.inclination_unit.unitType" 'angular distance'),
  azimuth_unit                  VARCHAR(64)    NOT NULL
                                               OPTIONS ("OpenWorksCommonModel:DirectionalSurvey.azimuth_unit.unitType" 'angular distance'),
  tvd_unit                      VARCHAR(64)    OPTIONS ("OpenWorksCommonModel:DirectionalSurvey.tvd_unit.unitType" 'depth measure'),
  xy_offset_unit                VARCHAR(64)    OPTIONS ("OpenWorksCommonModel:DirectionalSurvey.xy_offset_unit.unitType" 'distance ft or m'),
  x_bias_unit                   VARCHAR(64)    OPTIONS ("OpenWorksCommonModel:DirectionalSurvey.x_bias_unit.unitType" 'distance ft or m'),
  y_bias_unit                   VARCHAR(64)    OPTIONS ("OpenWorksCommonModel:DirectionalSurvey.y_bias_unit.unitType" 'distance ft or m'),
  z_bias_unit                   VARCHAR(64)    OPTIONS ("OpenWorksCommonModel:DirectionalSurvey.z_bias_unit.unitType" 'distance ft or m'),
  covariant_unit               	VARCHAR(64)    OPTIONS ("OpenWorksCommonModel:DirectionalSurvey.covariant_unit.unitType" 'area'),
  remark                       	VARCHAR(200),
  tie_on_survey_native_uid      VARCHAR(1024)  OPTIONS("OpenWorksCommonModel:DirectionalSurvey.tie_on_survey_native_uid.isUpdatable" false,
                                                       "OpenWorksCommonModel:DirectionalSurvey.tie_on_survey_native_uid.isCreatable" false,
													   "OpenWorksCommonModel:DirectionalSurvey.tie_on_survey_native_uid.isImplemented" false,
                                                       UPDATABLE 'FALSE'),
  tie_on_wellbore_native_uid    VARCHAR(1024)  OPTIONS("OpenWorksCommonModel:DirectionalSurvey.tie_on_wellbore_native_uid.isUpdatable" false,
                                                       "OpenWorksCommonModel:DirectionalSurvey.tie_on_wellbore_native_uid.isCreatable" false,
													   "OpenWorksCommonModel:DirectionalSurvey.tie_on_wellbore_native_uid.isImplemented" false,
                                                       UPDATABLE 'FALSE'),
  create_date                   TIMESTAMP      OPTIONS("OpenWorksCommonModel:DirectionalSurvey.create_date.isUpdatable" false,
                                                       "OpenWorksCommonModel:DirectionalSurvey.create_date.isCreatable" false,
                                                       UPDATABLE 'FALSE'),
  create_user_id                VARCHAR(32)    OPTIONS("OpenWorksCommonModel:DirectionalSurvey.create_user_id.isUpdatable" false,
                                                       "OpenWorksCommonModel:DirectionalSurvey.create_user_id.isCreatable" false,
                                                       UPDATABLE 'FALSE'),
  update_date                   TIMESTAMP      OPTIONS("OpenWorksCommonModel:DirectionalSurvey.update_date.isUpdatable" false,
                                                       "OpenWorksCommonModel:DirectionalSurvey.update_date.isCreatable" false,
                                                       UPDATABLE 'FALSE'),
  update_user_id                VARCHAR(32)    OPTIONS("OpenWorksCommonModel:DirectionalSurvey.update_user_id.isUpdatable" false,
                                                       "OpenWorksCommonModel:DirectionalSurvey.update_user_id.isCreatable" false,
                                                       UPDATABLE 'FALSE'),
  alternate_uid    			        VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:DirectionalSurvey.alternate_uid.isCreatable" false,
                                                       "OpenWorksCommonModel:DirectionalSurvey.alternate_uid.isUpdatable" false,
                                                        UPDATABLE 'FALSE'),

   CONSTRAINT DirectionalSurvey_PK PRIMARY KEY (native_uid),
   CONSTRAINT DirectionalSurvey_UK1 UNIQUE (wellbore_native_uid,survey_name),

   CONSTRAINT FK_DirectionalSurvey_wellbore_native_uid
     FOREIGN KEY (wellbore_native_uid)
     REFERENCES Wellbore(native_uid),

    CONSTRAINT FK_DirectionalSurvey_data_source
        FOREIGN KEY (data_source)
        REFERENCES DataSource(name),

    CONSTRAINT FK_DirectionalSurvey_company
        FOREIGN KEY (company)
        REFERENCES Company(company_name)

)
OPTIONS (UPDATABLE 'TRUE',DirectionalSurvey.IMPLEMENTED 'TRUE')
AS
SELECT
 OpenWorks_SM.DirSurvey.native_uid AS native_uid,
 wb.wellid AS wellbore_native_uid,
 survey_name,
 wb.uwi AS wellbore_uwi,
 OpenWorks_SM.DirSurvey.data_source,
 company,
 preferred_survey_ind,
 compute_xyz_ind,
null AS survey_description,
null AS survey_engineer,
convert(survey_date, date) AS survey_date,
convert(survey_date, date) AS end_date,

 survey_method,
 survey_tool,
 survey_calc_mthd,
 single_multi_shot,
 survey_conf_fact,
 north_reference,
 COALESCE(reference_elevation, wb.elevation) AS reference_elevation,
 COALESCE(reference_elevation_dsdsunit, wb.elevation_dsdsunit) AS reference_elevation_unit,
 resample_distance AS resample_distance,
 resample_distance_dsdsunit AS resample_distance_unit,
 scale_type AS scale_type,
 convergence_angle,
 convergence_angle_dsdsunit,
 tie_pt_md,
 tie_pt_md_dsdsunit ,
 tie_pt_tvd,
 tie_pt_tvd_dsdsunit,
 tie_pt_x_offset,
 tie_pt_y_offset,
 COALESCE(tie_pt_x_offset_dsdsunit,tie_pt_y_offset_dsdsunit),
 tie_pt_initial_azimuth,
 tie_pt_initial_azimuth_dsdsunit,
 tie_pt_initial_angle,
 tie_pt_initial_angle_dsdsunit,
 getDSDSCrs(OpenWorks_SM.CartoRefSys.name) as crs,
 npts,
 combineBlobs(fetchNRenameBlob(depth,'depth','md',''), inclination, azimuth,fetchNRenameBlob(true_vert_depth,'true_vert_depth','tvd',''), x_offset, y_offset, x_bias, y_bias, z_bias,covariant_xx,covariant_xy,covariant_xz,covariant_yy,covariant_yz,covariant_zz) AS data,
 depth_dsdsunit AS md_unit,
 inclination_dsdsunit,
 azimuth_dsdsunit,
 true_vert_depth_dsdsunit AS tvd_unit,
COALESCE(x_offset_dsdsunit,y_offset_dsdsunit),
 x_bias_dsdsunit AS x_bias_unit,
 y_bias_dsdsunit AS y_bias_unit,
 z_bias_dsdsunit AS z_bias_unit,
 COALESCE(covariant_xx_dsdsunit,covariant_yy_dsdsunit,covariant_zz_dsdsunit),
 OpenWorks_SM.DirSurvey.remark,
 null as tie_on_survey_native_uid,
 null as tie_on_wellbore_native_uid ,
 OpenWorks_SM.DirSurvey.create_date,
 OpenWorks_SM.DirSurvey.create_user_id,
 OpenWorks_SM.DirSurvey.update_date,
 OpenWorks_SM.DirSurvey.update_user_id,
 OpenWorks_SM.DirSurvey.native_uid

 FROM
     (OpenWorks_SM.DirSurvey LEFT OUTER JOIN /*+ optional */ OpenWorks_SM.CartoRefSys ON original_crs_id = id),/*+ optional */ OpenWorks_SM.WellEntire wb
 WHERE
    OpenWorks_SM.DirSurvey.wellid = wb.wellid;


CREATE TRIGGER ON DirectionalSurvey INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC

    DECLARE string VARIABLES.crs_errorMsg=CONCAT (CONCAT('ERROR: The given crs value "',"NEW".crs),'" does not exist in OpenWorks or an equivalent mapping does not exist in DSDS');
    DECLARE string VARIABLES.MSG_NO_WELLBORE=CONCAT (CONCAT('ERROR: The given wellbore_native_uid "',"NEW".wellbore_native_uid),'" does not exist in OpenWorks');
    DECLARE string VARIABLES.crs_id= null;

    DECLARE string VARIABLES.wellid = "NEW".wellbore_native_uid;
    DECLARE string VARIABLES.interpreter_id = SUBSTRING("NEW".data_source, 1, 5);
    DECLARE string VARIABLES.interpreter_name = SUBSTRING("NEW".data_source, 1, 32);

    IF(VARIABLES.wellid IS NULL)
    BEGIN
        ERROR VARIABLES.MSG_NO_WELLBORE;
    END

    IF("NEW".crs IS NOT NULL)
    BEGIN
        VARIABLES.crs_id = (SELECT id FROM OpenWorks_SM.CartoRefSys WHERE name = (SELECT * FROM (EXEC OpenWorks_SM.GetNativeCRS("NEW".crs,'OW')) AS SysGenID));
        IF(VARIABLES.crs_id is NULL)
            ERROR VARIABLES.crs_errorMsg;
    END

    IF(VARIABLES.interpreter_id IS NOT NULL)
    BEGIN
        DECLARE string VARIABLES.interpreter_id_existing = null;
        VARIABLES.interpreter_id_existing = SELECT id FROM OpenWorks_SM.DataSrc WHERE id = VARIABLES.interpreter_id;
        IF(VARIABLES.interpreter_id_existing is NULL)
            BEGIN
                insert into OpenWorks_SM.DataSrc(id, name, public_ind) VALUES ( VARIABLES.interpreter_id, VARIABLES.interpreter_name, 'Y');
            END
    END

    INSERT INTO OpenWorks_SM.DirSurvey (wellid, survey_name,                         data_source,                        company,                         preferred_survey_ind,                        compute_xyz_ind,                        survey_date,       survey_method,                         survey_tool,                         survey_calc_mthd,                           single_multi_shot,                         survey_conf_fact,                          north_reference,                                      reference_elevation,       reference_elevation_dsdsunit,   resample_distance,       resample_distance_dsdsunit,   scale_type,       convergence_angle,       tie_pt_md,       tie_pt_tvd,       tie_pt_x_offset,       tie_pt_y_offset,       tie_pt_initial_azimuth,       tie_pt_initial_angle,       tie_pt_md_dsdsunit,   tie_pt_tvd_dsdsunit,   tie_pt_x_offset_dsdsunit,    tie_pt_y_offset_dsdsunit,    tie_pt_initial_azimuth_dsdsunit,   tie_pt_initial_angle_dsdsunit,   npts,       depth,                                         inclination,                          azimuth,                          true_vert_depth,                                          x_offset,                          y_offset,                          x_bias,                          y_bias,                          z_bias,    covariant_xx, covariant_xy, covariant_xz, covariant_yy, covariant_yz, covariant_zz,                      x_bias_dsdsunit,   x_offset_dsdsunit,    y_bias_dsdsunit,   y_offset_dsdsunit,    z_bias_dsdsunit,   azimuth_dsdsunit,   convergence_angle_dsdsunit,   inclination_dsdsunit,   depth_dsdsunit, true_vert_depth_dsdsunit, covariant_xx_dsdsunit, covariant_xy_dsdsunit, covariant_xz_dsdsunit, covariant_yy_dsdsunit, covariant_yz_dsdsunit, covariant_zz_dsdsunit, remark,                          original_crs_id)
                                VALUES (wellid, SUBSTRING("NEW".survey_name, 1, 50), VARIABLES.interpreter_id, SUBSTRING("NEW".company, 1, 40), SUBSTRING("NEW".preferred_survey_ind, 1, 1), SUBSTRING("NEW".compute_xyz_ind, 1, 1), "NEW".survey_date, SUBSTRING("NEW".survey_method, 1, 30), SUBSTRING("NEW".survey_tool, 1, 40), SUBSTRING("NEW".survey_calc_method, 1, 20), SUBSTRING("NEW".single_multi_shot, 1, 12), SUBSTRING("NEW".survey_conf_factor, 1, 1), SUBSTRING(NVL("NEW".north_reference, 'TRUE'), 1, 12), "NEW".reference_elevation, "NEW".reference_elevation_unit, "NEW".resample_distance, "NEW".resample_distance_unit, "NEW".scale_type, "NEW".convergence_angle, "NEW".tie_pt_md, "NEW".tie_pt_tvd, "NEW".tie_pt_x_offset, "NEW".tie_pt_y_offset, "NEW".tie_pt_initial_azimuth, "NEW".tie_pt_initial_angle, "NEW".tie_pt_md_unit, "NEW".tie_pt_tvd_unit, "NEW".tie_pt_xy_offset_unit, "NEW".tie_pt_xy_offset_unit, "NEW".tie_pt_initial_azimuth_unit, "NEW".tie_pt_initial_angle_unit, "NEW".npts, fetchNRenameBlob("NEW".data, 'md','depth',''), fetchBlob("NEW".data, 'inclination'), fetchBlob("NEW".data, 'azimuth'), fetchNRenameBlob("NEW".data, 'tvd','true_vert_depth',''), fetchBlob("NEW".data, 'x_offset'), fetchBlob("NEW".data, 'y_offset'), fetchBlob("NEW".data, 'x_bias'), fetchBlob("NEW".data, 'y_bias'), fetchBlob("NEW".data, 'z_bias'), fetchBlob("NEW".data, 'covariant_xx'), fetchBlob("NEW".data, 'covariant_xy'), fetchBlob("NEW".data, 'covariant_xz'),fetchBlob("NEW".data, 'covariant_yy'),fetchBlob("NEW".data, 'covariant_yz'),fetchBlob("NEW".data, 'covariant_zz'), "NEW".x_bias_unit, "NEW".xy_offset_unit, "NEW".y_bias_unit, "NEW".xy_offset_unit, "NEW".z_bias_unit, "NEW".azimuth_unit, "NEW".convergence_angle_unit, "NEW".inclination_unit, "NEW".md_unit,  "NEW".tvd_unit, "NEW".covariant_unit,"NEW".covariant_unit,"NEW".covariant_unit,"NEW".covariant_unit,"NEW".covariant_unit,"NEW".covariant_unit,           SUBSTRING("NEW".remark, 1, 200), VARIABLES.crs_id);
END;





CREATE TRIGGER ON DirectionalSurvey INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC

    DECLARE string VARIABLES.crs_errorMsg=CONCAT (CONCAT('ERROR: The given crs value "',"NEW".crs),'" does not exist in OpenWorks or an equivalent mapping does not exist in DSDS');
    DECLARE string VARIABLES.crs_id= null;

    DECLARE string VARIABLES.wellid = "OLD".wellbore_native_uid;


    IF("NEW".crs IS NOT NULL)
    BEGIN
        VARIABLES.crs_id = (SELECT id FROM OpenWorks_SM.CartoRefSys WHERE name = (SELECT * FROM (EXEC OpenWorks_SM.GetNativeCRS("NEW".crs,'OW')) AS SysGenID));
        IF(VARIABLES.crs_id is NULL)
            ERROR VARIABLES.crs_errorMsg;
    END

    UPDATE OpenWorks_SM.DirSurvey SET data_source = SUBSTRING("NEW".data_source, 1, 5), company = SUBSTRING(NVL("NEW".company, 'UNKNOWN'), 1, 40), preferred_survey_ind = SUBSTRING(NVL("NEW".preferred_survey_ind, 'N'), 1, 1), compute_xyz_ind = SUBSTRING(NVL("NEW".compute_xyz_ind, 'Y'), 1, 1), survey_date = "NEW".survey_date, survey_method = SUBSTRING("NEW".survey_method, 1, 30), survey_tool = SUBSTRING(NVL("NEW".survey_tool, 'UNKNOWN'), 1, 40), survey_calc_mthd = SUBSTRING(NVL("NEW".survey_calc_method, 'Minimum Curvature'), 1, 20), single_multi_shot = SUBSTRING("NEW".single_multi_shot, 1, 12), survey_conf_fact = SUBSTRING("NEW".survey_conf_factor, 1, 1), north_reference = SUBSTRING(NVL("NEW".north_reference, 'True'), 1, 12), reference_elevation = "NEW".reference_elevation, reference_elevation_dsdsunit = "NEW".reference_elevation_unit, resample_distance = "NEW".resample_distance, resample_distance_dsdsunit = "NEW".resample_distance_unit, scale_type = "NEW".scale_type, convergence_angle = "NEW".convergence_angle, tie_pt_md = "NEW".tie_pt_md, tie_pt_tvd = "NEW".tie_pt_tvd, tie_pt_x_offset = "NEW".tie_pt_x_offset, tie_pt_y_offset = "NEW".tie_pt_y_offset, tie_pt_initial_azimuth = "NEW".tie_pt_initial_azimuth, tie_pt_initial_angle = "NEW".tie_pt_initial_angle, tie_pt_md_dsdsunit = "NEW".tie_pt_md_unit, tie_pt_tvd_dsdsunit = "NEW".tie_pt_tvd_unit, tie_pt_x_offset_dsdsunit = "NEW".tie_pt_xy_offset_unit, tie_pt_y_offset_dsdsunit = "NEW".tie_pt_xy_offset_unit, tie_pt_initial_azimuth_dsdsunit = "NEW".tie_pt_initial_azimuth_unit, tie_pt_initial_angle_dsdsunit = "NEW".tie_pt_initial_angle_unit, npts = "NEW".npts, depth = fetchNRenameBlob("NEW".data, 'md','depth',''), inclination = fetchBlob("NEW".data, 'inclination'), azimuth = fetchBlob("NEW".data, 'azimuth'), true_vert_depth = fillArrayBlobIfNull(fetchNRenameBlob("NEW".data, 'tvd','true_vert_depth',''),"NEW".npts), x_offset = fillArrayBlobIfNull(fetchBlob("NEW".data, 'x_offset'),"NEW".npts), y_offset = fillArrayBlobIfNull(fetchBlob("NEW".data, 'y_offset'),"NEW".npts), x_bias = fetchBlob("NEW".data, 'x_bias'), y_bias = fetchBlob("NEW".data, 'y_bias'), z_bias = fetchBlob("NEW".data, 'z_bias'), covariant_xx = fetchBlob("NEW".data, 'covariant_xx'), covariant_xy = fetchBlob("NEW".data, 'covariant_xy'), covariant_xz = fetchBlob("NEW".data, 'covariant_xz'), covariant_yy = fetchBlob("NEW".data, 'covariant_yy'), covariant_yz = fetchBlob("NEW".data, 'covariant_yz'), covariant_zz = fetchBlob("NEW".data, 'covariant_zz'), x_bias_dsdsunit = "NEW".x_bias_unit, x_offset_dsdsunit = "NEW".xy_offset_unit, y_bias_dsdsunit = "NEW".y_bias_unit, y_offset_dsdsunit = "NEW".xy_offset_unit, z_bias_dsdsunit = "NEW".z_bias_unit, azimuth_dsdsunit = "NEW".azimuth_unit, convergence_angle_dsdsunit = "NEW".convergence_angle_unit, inclination_dsdsunit = "NEW".inclination_unit, depth_dsdsunit = "NEW".md_unit, true_vert_depth_dsdsunit = "NEW".tvd_unit, covariant_xx_dsdsunit = "NEW".covariant_unit, covariant_xy_dsdsunit = "NEW".covariant_unit, covariant_xz_dsdsunit = "NEW".covariant_unit, covariant_yy_dsdsunit = "NEW".covariant_unit, covariant_yz_dsdsunit = "NEW".covariant_unit, covariant_zz_dsdsunit = "NEW".covariant_unit, remark = SUBSTRING("NEW".remark, 1, 200),original_crs_id = VARIABLES.crs_id  WHERE native_uid = "OLD".native_uid;
END;


CREATE TRIGGER ON DirectionalSurvey INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC

    DELETE FROM OpenWorks_SM.DirSurvey WHERE native_uid = "OLD".native_uid;
END;


/*
**********************************
*     "Survey Program"
**********************************
*/

CREATE VIEW SurveyProgram
(
  native_uid                   VARCHAR(1024)  AUTO_INCREMENT
                                              OPTIONS("OpenWorksCommonModel:SurveyProgram.native_uid.isUpdatable" false,
                                                      "OpenWorksCommonModel:SurveyProgram.native_uid.isCreatable" false,
                                                       UPDATABLE 'FALSE'),
  directionalsurvey_native_uid  VARCHAR(1024) NOT NULL,
  wellbore_uwi                  VARCHAR(26)   OPTIONS("OpenWorksCommonModel:SurveyProgram.wellbore_uwi.isUpdatable" false,
                                                      "OpenWorksCommonModel:SurveyProgram.wellbore_uwi.isCreatable" false,
                                                       UPDATABLE 'FALSE'),
  wellbore_native_uid            VARCHAR(1024)   OPTIONS("OpenWorksCommonModel:SurveyProgram.wellbore_native_uid.isUpdatable" false,
                                                      "OpenWorksCommonModel:SurveyProgram.wellbore_native_uid.isCreatable" false,
                                                       UPDATABLE 'FALSE'),
  survey_name                   VARCHAR(50),
  sequence_no                   INTEGER       NOT NULL,
  tool_name                     VARCHAR(40),
  top_depth                     FLOAT         OPTIONS("OpenWorksCommonModel:SurveyProgram.top_depth.unitField" 'depth_unit'),
  base_depth                    FLOAT         OPTIONS("OpenWorksCommonModel:SurveyProgram.base_depth.unitField" 'depth_unit'),
  depth_unit                    VARCHAR(64)   OPTIONS("OpenWorksCommonModel:SurveyProgram.depth_unit.unitType" 'depth measure'),
  remark                        VARCHAR(200),
  create_date                   TIMESTAMP     OPTIONS("OpenWorksCommonModel:SurveyProgram.create_date.isUpdatable" false,
                                                      "OpenWorksCommonModel:SurveyProgram.create_date.isCreatable" false,
                                                       UPDATABLE 'FALSE'),
  create_user_id                VARCHAR(32)   OPTIONS("OpenWorksCommonModel:SurveyProgram.create_user_id.isUpdatable" false,
                                                      "OpenWorksCommonModel:SurveyProgram.create_user_id.isCreatable" false,
                                                       UPDATABLE 'FALSE'),
  update_date                   TIMESTAMP     OPTIONS("OpenWorksCommonModel:SurveyProgram.update_date.isUpdatable" false,
                                                      "OpenWorksCommonModel:SurveyProgram.update_date.isCreatable" false,
                                                       UPDATABLE 'FALSE'),
  update_user_id                VARCHAR(32)   OPTIONS("OpenWorksCommonModel:SurveyProgram.update_user_id.isUpdatable" false,
                                                      "OpenWorksCommonModel:SurveyProgram.update_user_id.isCreatable" false,
                                                       UPDATABLE 'FALSE'),
  alternate_uid    		           VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:SurveyProgram.alternate_uid.isCreatable" false,
                                                      "OpenWorksCommonModel:SurveyProgram.alternate_uid.isUpdatable" false,
                                                       UPDATABLE 'FALSE'),

    CONSTRAINT SurveyProgram_PK PRIMARY KEY (native_uid),

    CONSTRAINT SurveyProgram__UK1 UNIQUE (directionalsurvey_native_uid, sequence_no),

    CONSTRAINT FK_SurveyProgram_directionalsurvey_native_uid
        FOREIGN KEY                 (directionalsurvey_native_uid)
        REFERENCES DirectionalSurvey(native_uid)

)
OPTIONS (UPDATABLE 'TRUE',SurveyProgram.IMPLEMENTED 'TRUE')
AS
SELECT
 SH.native_uid AS native_uid,
 DS.native_uid AS directionalsurvey_native_uid,
 WB.uwi AS wellbore_uwi,
 SH.DEFN_WELLID AS wellbore_native_uid,
 DS.survey_name,
 cast(SH.history_obs_no AS integer) as sequence_no,
 SH.tool_name,
 SH.top_depth,
 SH.base_depth,
 SH.top_depth_dsdsunit as depth_unit,
 SH.remark,
 SH.create_date,
 SH.create_user_id,
 SH.update_date,
 SH.update_user_id,
 SH.native_uid AS alternate_uid

 FROM
    OpenWorks_SM.SurveyHistory SH INNER JOIN OpenWorks_SM.DirSurvey DS ON SH.DEFN_WELLID = DS.WELLID AND  SH.DEFN_SURVEY_NAME = DS.SURVEY_NAME
    INNER JOIN OpenWorks_SM.WellEntire WB ON DS.WELLID = WB.WELLID;


CREATE TRIGGER ON SurveyProgram INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC

    DECLARE string VARIABLES.MSG_NO_WELLBORE=CONCAT (CONCAT('ERROR: The given directionalsurvey_native_uid "',"NEW".directionalsurvey_native_uid),'" does not exist in OpenWorks');
    DECLARE string VARIABLES.wellid = null;
    DECLARE string VARIABLES.survey_name = null;

    INSERT INTO #TmpTbl (#TmpTbl.wellid, #TmpTbl.survey_name) SELECT wellid,survey_name FROM OpenWorks_SM.DirSurvey where native_uid = "NEW".directionalsurvey_native_uid;

    VARIABLES.wellid = (select #TmpTbl.wellid from #TmpTbl);
    VARIABLES.survey_name = (select #TmpTbl.survey_name from #TmpTbl);

    IF(VARIABLES.wellid IS NULL OR VARIABLES.survey_name IS NULL)
    BEGIN
        ERROR VARIABLES.MSG_NO_WELLBORE;
    END


    DECLARE integer surveyProgramCount = (SELECT count(*) FROM OpenWorks_SM.SurveyHistory WHERE DEFN_WELLID = VARIABLES.wellid  and history_obs_no = "NEW".sequence_no);
    IF(VARIABLES.surveyProgramCount > 0)
    BEGIN
        DELETE FROM OpenWorks_SM.SurveyHistory WHERE DEFN_WELLID = VARIABLES.wellid  and history_obs_no = "NEW".sequence_no;
    END

    INSERT INTO OpenWorks_SM.SurveyHistory (DEFN_WELLID,      DEFN_SURVEY_NAME,      history_obs_no,    source_wellid,    source_SURVEY_NAME,                  tool_name,       top_depth,       base_depth,       top_depth_dsdsunit, base_depth_dsdsunit, remark)
                                    VALUES (VARIABLES.wellid, VARIABLES.survey_name, "NEW".sequence_no, VARIABLES.wellid, SUBSTRING("NEW".survey_name, 1, 50), "NEW".tool_name, "NEW".top_depth, "NEW".base_depth, "NEW".depth_unit, "NEW".depth_unit,     SUBSTRING("NEW".remark, 1, 200));
END;


CREATE TRIGGER ON SurveyProgram INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC
      UPDATE OpenWorks_SM.SurveyHistory set  tool_name = "NEW".tool_name , top_depth = "NEW".top_depth, base_depth = "NEW".base_depth, top_depth_dsdsunit = "NEW".depth_unit, base_depth_dsdsunit = "NEW".depth_unit, remark = SUBSTRING("NEW".remark, 1, 200) where native_uid="OLD".native_uid;
END;


CREATE TRIGGER ON SurveyProgram INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC
    DELETE FROM OpenWorks_SM.SurveyHistory WHERE native_uid="OLD".native_uid;
END;


/*
**********************************
*    "PositionLog"
**********************************
*/

CREATE VIEW PositionLog
(
  native_uid           VARCHAR(1024)  AUTO_INCREMENT
                                      OPTIONS("OpenWorksCommonModel:PositionLog.native_uid.isUpdatable" false,
                                              "OpenWorksCommonModel:PositionLog.native_uid.isCreatable" false,
                                              UPDATABLE 'FALSE'),
  wellbore_native_uid  VARCHAR(1024)  NOT NULL,
  wellbore_uwi         VARCHAR(26)    OPTIONS("OpenWorksCommonModel:PositionLog.wellbore_uwi.isUpdatable" false,
                                              "OpenWorksCommonModel:PositionLog.wellbore_uwi.isCreatable" false,
                                              UPDATABLE 'FALSE'),
  survey_name          VARCHAR(50),
  survey_calc_method   VARCHAR(20),
  bh_x_offset          FLOAT          OPTIONS ("OpenWorksCommonModel:PositionLog.bh_x_offset.unitField" 'bh_xy_offset_unit',
                                               "OpenWorksCommonModel:PositionLog.bh_x_offset.isUpdatable" false,
                                               "OpenWorksCommonModel:PositionLog.bh_x_offset.isCreatable" false,
                                               UPDATABLE 'FALSE'),
  bh_y_offset          FLOAT          OPTIONS ("OpenWorksCommonModel:PositionLog.bh_y_offset.unitField" 'bh_xy_offset_unit',
                                               "OpenWorksCommonModel:PositionLog.bh_y_offset.isUpdatable" false,
                                               "OpenWorksCommonModel:PositionLog.bh_y_offset.isCreatable" false,
                                               UPDATABLE 'FALSE'),
  bh_xy_offset_unit    VARCHAR(64)    OPTIONS("OpenWorksCommonModel:PositionLog.bh_xy_offset_unit.unitType" 'linear distance'),
  bh_z                 FLOAT
                                      OPTIONS ("OpenWorksCommonModel:PositionLog.bh_z.unitField" 'bh_z_unit'),
  bh_z_unit            VARCHAR(64)    OPTIONS("OpenWorksCommonModel:PositionLog.bh_z_unit.unitType" 'time depth measure'),
  bh_md                FLOAT          OPTIONS ("OpenWorksCommonModel:PositionLog.bh_md.unitField" 'bh_md_unit',
                                               "OpenWorksCommonModel:PositionLog.bh_md.isUpdatable" false,
                                               "OpenWorksCommonModel:PositionLog.bh_md.isCreatable" false,
                                               UPDATABLE 'FALSE'),
  bh_md_unit           VARCHAR(64)    OPTIONS ("OpenWorksCommonModel:PositionLog.bh_md_unit.unitType" 'depth measure'),
  time_depth_ind       INTEGER        DEFAULT '1',
  data_source          VARCHAR(5),
  crs                  VARCHAR(80),
  npts                 INTEGER        NOT NULL   DEFAULT '0' ,
  data                 BLOB           NOT NULL
                                      OPTIONS ("OpenWorksCommonModel:PositionLog.data.isComplexType" true,
                                               "OpenWorksCommonModel:PositionLog.data.isComplexTypeArray" true,
                                               "OpenWorksCommonModel:PositionLog.data.elementType" 'PositionLogData',
                                               "OpenWorksCommonModel:PositionLog.data.elementStruct"      '[{"name":"md", "type":"float[]"},          {"name":"tvd", "type":"float[]"},           {"name":"x_offset", "type":"float[]"},                 {"name":"y_offset","type":"float[]"}]',
                                               "OpenWorksCommonModel:PositionLog.data.elementMetadata"    '[{"name":"md", "unitField":"md_unit"}, {"name":"tvd", "unitField":"tvd_unit"}, {"name":"x_offset", "unitField":"xy_offset_unit"}, {"name":"y_offset", "unitField":"xy_offset_unit"}]'),
  md_unit              VARCHAR(64)    NOT NULL
                                      OPTIONS ("OpenWorksCommonModel:PositionLog.md_unit.unitType" 'elevation'),
  tvd_unit             VARCHAR(64)    NOT NULL
                                      OPTIONS ("OpenWorksCommonModel:PositionLog.tvd_unit.unitType" 'time depth measure'),
  xy_offset_unit       VARCHAR(64)    NOT NULL OPTIONS ("OpenWorksCommonModel:PositionLog.xy_offset_unit.unitType" 'linear distance'),
  remark               VARCHAR(200),
  create_date          TIMESTAMP      OPTIONS("OpenWorksCommonModel:PositionLog.create_date.isUpdatable" false,
                                               "OpenWorksCommonModel:PositionLog.create_date.isCreatable" false,
                                               UPDATABLE 'FALSE'),
  create_user_id       VARCHAR(32)    OPTIONS("OpenWorksCommonModel:PositionLog.create_user_id.isUpdatable" false,
                                               "OpenWorksCommonModel:PositionLog.create_user_id.isCreatable" false,
                                               UPDATABLE 'FALSE'),
  update_date          TIMESTAMP      OPTIONS("OpenWorksCommonModel:PositionLog.update_date.isUpdatable" false,
                                               "OpenWorksCommonModel:PositionLog.update_date.isCreatable" false,
                                               UPDATABLE 'FALSE'),
  update_user_id       VARCHAR(32)    OPTIONS("OpenWorksCommonModel:PositionLog.update_user_id.isUpdatable" false,
                                               "OpenWorksCommonModel:PositionLog.update_user_id.isCreatable" false,
                                               UPDATABLE 'FALSE'),
   alternate_uid    		   VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:PositionLog.alternate_uid.isCreatable" false,
                                              "OpenWorksCommonModel:PositionLog.alternate_uid.isUpdatable" false,
                                               UPDATABLE 'FALSE'),

   CONSTRAINT PosLog_PK PRIMARY KEY (native_uid),

   CONSTRAINT PosLog_UK1 UNIQUE (wellbore_native_uid),

   CONSTRAINT FK_PosLog_wellbore_native_uid
        FOREIGN KEY (wellbore_native_uid)
        REFERENCES Wellbore(native_uid),

   CONSTRAINT FK_PosLog_survey_name_wellbore_native_uid
        FOREIGN KEY (wellbore_native_uid,survey_name)
        REFERENCES DirectionalSurvey(wellbore_native_uid,survey_name),

   CONSTRAINT FK_PositionLog_data_source
        FOREIGN KEY (data_source)
        REFERENCES DataSource(name)

)
OPTIONS (UPDATABLE 'TRUE',PositionLog.IMPLEMENTED 'TRUE')

AS
SELECT
 OpenWorks_SM.PosLog.wellid AS native_uid,
 OpenWorks_SM.PosLog.wellid AS wellbore_native_uid,
 uwi AS wellbore_uwi,
 survey_name,
 DECODESTRING(survey_calc_method,'null:Unknown',':'),
 bh_x_off,
 bh_y_off,
 bh_x_off_dsdsunit,
 bh_z,
 bh_md_dsdsunit AS bh_z_dsdsunit,
 bh_md,
 bh_md_dsdsunit,
 time_depth_ind,
 OpenWorks_SM.PosLog.data_source,
 (Select getDSDSCrs(name) from OpenWorks_SM.CartoRefSys,OpenWorks_SM.Project where OpenWorks_SM.CartoRefSys.id = OpenWorks_SM.Project.xy_crs_id) as crs,
 npts,
 combineBlobs(fetchNRenameBlob(z,'z','tvd',''), md, fetchNRenameBlob(x_off,'x_off','x_offset',''), fetchNRenameBlob(y_off,'y_off','y_offset','')) AS data,
 md_dsdsunit AS md_unit,
 md_dsdsunit AS tvd_unit,
 x_off_dsdsunit,
 OpenWorks_SM.PosLog.remark,
 OpenWorks_SM.PosLog.create_date,
 OpenWorks_SM.PosLog.create_user_id,
 OpenWorks_SM.PosLog.update_date,
 OpenWorks_SM.PosLog.update_user_id,
 OpenWorks_SM.PosLog.native_uid AS alternate_uid
    FROM
         OpenWorks_SM.PosLog, OpenWorks_SM.WellEntire
    WHERE
        OpenWorks_SM.PosLog.wellid = OpenWorks_SM.WellEntire.wellid;



CREATE TRIGGER ON PositionLog INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC

    DECLARE string VARIABLES.MSG_NO_WELLBORE=CONCAT (CONCAT('ERROR: The given wellbore_uwi "',"NEW".wellbore_uwi),'" does not exist in OpenWorks');
    DECLARE string VARIABLES.err1 = 'X_Offset/Y_Offset value(s) not provided in PositionLog Insert';
    DECLARE string VARIABLES.err2 = 'There are no Surface X and Y coordinates for the Well. PositionLog creation failed';

    DECLARE string VARIABLES.wellid = "NEW".wellbore_native_uid;

    IF(VARIABLES.wellid IS NULL)
    BEGIN
        ERROR VARIABLES.MSG_NO_WELLBORE;
    END


    INSERT INTO #TmpTbl (#TmpTbl.surfaceX, #TmpTbl.surfaceY, #TmpTbl.surfaceUnits) select x_coordinate,y_coordinate,x_coordinate_dsdsunit from OpenWorks_SM.WellEntire where wellid = VARIABLES.wellid;

    DECLARE double VARIABLES.surfaceX = (select #TmpTbl.surfaceX from #TmpTbl);
    DECLARE double VARIABLES.surfaceY = (select #TmpTbl.surfaceY from #TmpTbl);
    DECLARE string VARIABLES.surfaceUnits = (select #TmpTbl.surfaceUnits from #TmpTbl);

    DECLARE string VARIABLES.targetCRS = (Select name from OpenWorks_SM.CartoRefSys,OpenWorks_SM.Project where OpenWorks_SM.CartoRefSys.id = OpenWorks_SM.Project.xy_crs_id);


    DECLARE string VARIABLES.survey_name = null;

    IF("NEW".survey_name IS NOT NULL)
    BEGIN
        VARIABLES.survey_name =(Select survey_name from OpenWorks_SM.DirSurvey where survey_name = "NEW".survey_name and wellid = VARIABLES.wellid);
    END

    IF((VARIABLES.surfaceX IS NULL) OR (VARIABLES.surfaceY IS NULL))
        ERROR VARIABLES.err2;

    DECLARE blob VARIABLES.posLog = "NEW".data;
    DECLARE blob VARIABLES.x_offset;
    DECLARE blob VARIABLES.y_offset;

    IF("NEW".crs <> VARIABLES.targetCRS)
    BEGIN
        VARIABLES.posLog = convertPosLogToTargetCRS("NEW".crs,VARIABLES.targetCRS,"NEW".xy_offset_unit,VARIABLES.posLog,VARIABLES.surfaceX,VARIABLES.surfaceY,VARIABLES.surfaceUnits);

        VARIABLES.x_offset = fetchNRenameBlob(VARIABLES.posLog,'x_offset','x_off','');
        VARIABLES.y_offset = fetchNRenameBlob(VARIABLES.posLog,'y_offset','y_off','');
        VARIABLES.surfaceUnits = Select uom from OpenWorks_SM.CartoRefSys,OpenWorks_SM.Project where OpenWorks_SM.CartoRefSys.id = OpenWorks_SM.Project.xy_crs_id;
    END
    ELSE
    BEGIN
        VARIABLES.x_offset = fetchNRenameBlob(VARIABLES.posLog,'x_offset','x_off','');
        VARIABLES.y_offset = fetchNRenameBlob(VARIABLES.posLog,'y_offset','y_off','');
        VARIABLES.surfaceUnits = "NEW".xy_offset_unit;
    END

    IF((VARIABLES.x_offset IS NULL) OR (VARIABLES.y_offset IS NULL))
        ERROR VARIABLES.err1;

    INSERT INTO OpenWorks_SM.PosLog (wellid, survey_name,           survey_calc_method,                                                          bh_z,       bh_z_dsdsunit,                            time_depth_ind,       data_source,                        npts,       z,                                         z_dsdsunit,                       md,                          md_dsdsunit,                     x_off,              x_off_dsdsunit,         y_off,              y_off_dsdsunit,         remark)
                             VALUES (wellid, VARIABLES.survey_name, DECODESTRING(SUBSTRING("NEW".survey_calc_method, 1, 20),'null:Unknown',':'), "NEW".bh_z, COALESCE("NEW".bh_z_unit,"NEW".tvd_unit), "NEW".time_depth_ind, SUBSTRING("NEW".data_source, 1, 5), "NEW".npts, fetchNRenameBlob("NEW".data,'tvd','z',''), SUBSTRING("NEW".tvd_unit, 1, 64), fetchBlob("NEW".data, 'md'), SUBSTRING("NEW".md_unit, 1, 64), VARIABLES.x_offset, VARIABLES.surfaceUnits, VARIABLES.y_offset, VARIABLES.surfaceUnits, SUBSTRING("NEW".remark, 1, 200));

END;

CREATE TRIGGER ON PositionLog INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC
    DECLARE string VARIABLES.wellid = "OLD".wellbore_native_uid;
    DECLARE string VARIABLES.survey_calc_method=DECODESTRING(SUBSTRING("NEW".survey_calc_method, 1, 20),'null:Unknown',':');
    DECLARE string VARIABLES.err = 'X_Offset/Y_Offset value(s) not provided in PositionLog Update';
    DECLARE string VARIABLES.err2 = 'There are no Surface X and Y coordinates for the Well. PositionLog creation failed';

    INSERT INTO #TmpTbl (#TmpTbl.surfaceX, #TmpTbl.surfaceY, #TmpTbl.surfaceUnits) select x_coordinate,y_coordinate,x_coordinate_dsdsunit from OpenWorks_SM.WellEntire where wellid = VARIABLES.wellid;

    DECLARE double VARIABLES.surfaceX = (select #TmpTbl.surfaceX from #TmpTbl);
    DECLARE double VARIABLES.surfaceY = (select #TmpTbl.surfaceY from #TmpTbl);
    DECLARE string VARIABLES.surfaceUnits = (select #TmpTbl.surfaceUnits from #TmpTbl);

    DECLARE string VARIABLES.targetCRS = (Select name from OpenWorks_SM.CartoRefSys,OpenWorks_SM.Project where OpenWorks_SM.CartoRefSys.id = OpenWorks_SM.Project.xy_crs_id);

    DECLARE string VARIABLES.survey_name = null;

    IF("NEW".survey_name IS NOT NULL)
    BEGIN
        VARIABLES.survey_name =(Select survey_name from OpenWorks_SM.DirSurvey where survey_name = "NEW".survey_name and wellid = VARIABLES.wellid);
    END

    IF((VARIABLES.surfaceX IS NULL) OR (VARIABLES.surfaceY IS NULL))
        ERROR VARIABLES.err2;

    DECLARE blob VARIABLES.posLog = "NEW".data;
    DECLARE blob VARIABLES.x_offset;
    DECLARE blob VARIABLES.y_offset;

     IF("NEW".crs <> VARIABLES.targetCRS)
        BEGIN
            VARIABLES.posLog = convertPosLogToTargetCRS("NEW".crs,VARIABLES.targetCRS,"NEW".xy_offset_unit,VARIABLES.posLog,VARIABLES.surfaceX,VARIABLES.surfaceY,VARIABLES.surfaceUnits);

            VARIABLES.x_offset = fetchNRenameBlob(VARIABLES.posLog,'x_offset','x_off','');
            VARIABLES.y_offset = fetchNRenameBlob(VARIABLES.posLog,'y_offset','y_off','');
        VARIABLES.surfaceUnits = Select uom from OpenWorks_SM.CartoRefSys,OpenWorks_SM.Project where OpenWorks_SM.CartoRefSys.id = OpenWorks_SM.Project.xy_crs_id;
        END
        ELSE
        BEGIN
            VARIABLES.x_offset = fetchNRenameBlob(VARIABLES.posLog,'x_offset','x_off','');
            VARIABLES.y_offset = fetchNRenameBlob(VARIABLES.posLog,'y_offset','y_off','');
            VARIABLES.surfaceUnits = "NEW".xy_offset_unit;
    END

    IF((VARIABLES.x_offset IS NULL) OR (VARIABLES.y_offset IS NULL))
        ERROR VARIABLES.err;

    UPDATE OpenWorks_SM.PosLog SET survey_name=VARIABLES.survey_name,survey_calc_method = VARIABLES.survey_calc_method, bh_z = "NEW".bh_z, bh_z_dsdsunit = COALESCE("NEW".bh_z_unit,"NEW".tvd_unit), time_depth_ind = "NEW".time_depth_ind, data_source = SUBSTRING("NEW".data_source, 1, 5), npts = "NEW".npts, z = fetchNRenameBlob("NEW".data,'tvd','z',''), z_dsdsunit = SUBSTRING("NEW".tvd_unit, 1, 64), md = fetchBlob("NEW".data, 'md'), md_dsdsunit = SUBSTRING("NEW".md_unit, 1, 64), x_off = VARIABLES.x_offset , x_off_dsdsunit = SUBSTRING(VARIABLES.surfaceUnits, 1, 64), y_off = VARIABLES.y_offset, y_off_dsdsunit = SUBSTRING(VARIABLES.surfaceUnits, 1, 64), remark = SUBSTRING("NEW".remark, 1, 200) WHERE (wellid = "OLD".native_uid);
END;

CREATE TRIGGER ON PositionLog INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC
    DELETE FROM OpenWorks_SM.PosLog WHERE OpenWorks_SM.PosLog.wellid = "OLD".native_uid;
END;

/*
**********************************
*     "TimeDepthtable"
**********************************
*/

CREATE VIEW TimeDepthTable
(
  native_uid           VARCHAR(1024) AUTO_INCREMENT
                                     OPTIONS ("OpenWorksCommonModel:TimeDepthTable.native_uid.isUpdatable" false,
                                              "OpenWorksCommonModel:TimeDepthTable.native_uid.isCreatable" false,
                                              UPDATABLE 'FALSE'),
  wellbore_native_uid  VARCHAR(1024) NOT NULL,
  td_name              VARCHAR(50)   NOT NULL,
  wellbore_uwi         VARCHAR(26)   OPTIONS ("OpenWorksCommonModel:TimeDepthTable.wellbore_uwi.isUpdatable" false,
                                              "OpenWorksCommonModel:TimeDepthTable.wellbore_uwi.isCreatable" false,
                                              UPDATABLE 'FALSE'),
  shift_value          FLOAT         DEFAULT '0.0'
                                     OPTIONS ("OpenWorksCommonModel:TimeDepthTable.shift_value.unitField" 'shift_value_unit'),
  shift_value_unit     VARCHAR(64)   OPTIONS ("OpenWorksCommonModel:TimeDepthTable.shift_value_unit.unitType" 'time depth measure'),
  datum                FLOAT         NOT NULL
                                     OPTIONS ("OpenWorksCommonModel:TimeDepthTable.datum.unitField" 'depth_datum_unit'),
  depth_datum_unit     VARCHAR(64)   OPTIONS ("OpenWorksCommonModel:TimeDepthTable.depth_datum_unit.unitType" 'elevation'),
  data_source          VARCHAR(5),
  checkshot_flag       INTEGER       DEFAULT '0',
  contractor           VARCHAR(40)   DEFAULT 'UNKNOWN',
  survey_type          VARCHAR(12),
  survey_direction     VARCHAR(12),
  survey_source        VARCHAR(12),
  source_depth         FLOAT         OPTIONS ("OpenWorksCommonModel:TimeDepthTable.source_depth.unitField" 'source_depth_unit'),
  source_depth_unit    VARCHAR(64)   OPTIONS ("OpenWorksCommonModel:TimeDepthTable.source_depth_unit.unitType" 'depth measure'),
  source_offset        FLOAT         OPTIONS ("OpenWorksCommonModel:TimeDepthTable.source_offset.unitField" 'source_offset_unit'),
  source_offset_unit   VARCHAR(64)   OPTIONS ("OpenWorksCommonModel:TimeDepthTable.source_offset_unit.unitType" 'distance ft or m'),
  source_x_coordinate  DOUBLE        OPTIONS ("OpenWorksCommonModel:TimeDepthTable.source_x_coordinate.unitField" 'source_xy_unit'),
  source_y_coordinate  DOUBLE        OPTIONS ("OpenWorksCommonModel:TimeDepthTable.source_y_coordinate.unitField" 'source_xy_unit'),
  source_xy_unit       VARCHAR(64),
  source_crs           VARCHAR(80),
  corrected_ind        VARCHAR(3),
  npts                 INTEGER       NOT NULL DEFAULT '0',
  depth_mode           VARCHAR(12)   DEFAULT 'TVDBTDD',
  data                 BLOB          NOT NULL
                                     OPTIONS ("OpenWorksCommonModel:TimeDepthTable.data.isComplexType" true,
                                              "OpenWorksCommonModel:TimeDepthTable.data.isComplexTypeArray" true,
                                              "OpenWorksCommonModel:TimeDepthTable.data.elementType" 'TimeDepthTableData',
                                              "OpenWorksCommonModel:TimeDepthTable.data.elementStruct"      '[{"name":"md", "type":"float[]"},          {"name":"time", "type":"float[]"},            {"name":"depth","type":"float[]"},              {"name":"x_offset", "type":"float[]"},          {"name":"y_offset", "type":"float[]"}]',
                                              "OpenWorksCommonModel:TimeDepthTable.data.elementMetadata"    '[{"name":"md", "unitField":"md_unit"}, {"name":"time", "unitField":"time_unit"}, {"name":"depth", "unitField":"depth_unit"}, {"name":"x_offset", "unitField":"xy_unit"}, {"name":"y_offset", "unitField":"xy_unit"}]'),
  depth_unit           VARCHAR(64)   NOT NULL
                                     OPTIONS ("OpenWorksCommonModel:TimeDepthTable.depth_unit.unitType" 'depth measure'),
  md_unit              VARCHAR(64)   OPTIONS ("OpenWorksCommonModel:TimeDepthTable.md_unit.unitType" 'depth measure'),
  xy_unit              VARCHAR(64),
  time_unit            VARCHAR(64)   NOT NULL
                                     OPTIONS ("OpenWorksCommonModel:TimeDepthTable.time_unit.unitType" 'seismic time'),
  user_def_1           VARCHAR(20),
  user_def_num_1       INTEGER,
  user_def_num_2       INTEGER,
  remark               VARCHAR(200),
  create_date          TIMESTAMP     OPTIONS ("OpenWorksCommonModel:TimeDepthTable.create_date.isUpdatable" false,
                                              "OpenWorksCommonModel:TimeDepthTable.create_date.isCreatable" false,
                                              UPDATABLE 'FALSE'),
  create_user_id       VARCHAR(32)   OPTIONS ("OpenWorksCommonModel:TimeDepthTable.create_user_id.isUpdatable" false,
                                              "OpenWorksCommonModel:TimeDepthTable.create_user_id.isCreatable" false,
                                              UPDATABLE 'FALSE'),
  update_date          TIMESTAMP     OPTIONS ("OpenWorksCommonModel:TimeDepthTable.update_date.isUpdatable" false,
                                              "OpenWorksCommonModel:TimeDepthTable.update_date.isCreatable" false,
                                              UPDATABLE 'FALSE'),
  update_user_id       VARCHAR(32)   OPTIONS ("OpenWorksCommonModel:TimeDepthTable.update_user_id.isUpdatable" false,
                                              "OpenWorksCommonModel:TimeDepthTable.update_user_id.isCreatable" false,
                                              UPDATABLE 'FALSE'),
  alternate_uid    		   VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:TimeDepthTable.alternate_uid.isCreatable" false,
                                              "OpenWorksCommonModel:TimeDepthTable.alternate_uid.isUpdatable" false,
                                               UPDATABLE 'FALSE'),

  CONSTRAINT TimeDepthTable_PK PRIMARY KEY (native_uid),

  CONSTRAINT TimeDepthTable_UK1 UNIQUE (wellbore_native_uid,td_name),

  CONSTRAINT FK_TimeDepthTable_wellbore_native_uid
       FOREIGN KEY (wellbore_native_uid)
       REFERENCES Wellbore(native_uid),

     CONSTRAINT FK_TimeDepthTable_data_source
        FOREIGN KEY (data_source)
        REFERENCES DataSource(name),

    CONSTRAINT FK_TimeDepthTable_contractor
        FOREIGN KEY (contractor)
        REFERENCES Company(company_name)

)
OPTIONS (UPDATABLE 'TRUE',TimeDepthTable.IMPLEMENTED 'TRUE')
  As
SELECT
 time_depth_id AS native_uid,
 OpenWorks_SM.TimeDepthTable.wellid AS wellbore_native_uid,
 td_name,
 uwi AS wellbore_uwi,
 shift_value,
 shift_value_dsdsunit AS shift_value_unit,
 datum,
 datum_dsdsunit AS depth_datum_unit,
 OpenWorks_SM.TimeDepthTable.data_source,
 checkshot_flag,
 contractor,
 survey_type,
 survey_direction,
 survey_source,
 source_depth,
 source_depth_dsdsunit AS source_depth_unit,
 source_offset,
 source_offset_dsdsunit AS source_offset_unit,
 source_orig_x_lon AS source_x_coordinate,
 source_orig_y_lat AS source_y_coordinate,
 coalesce(source_orig_x_lon_dsdsunit,source_orig_y_lat_dsdsunit) AS source_xy_unit,
 getDSDSCrs(OpenWorks_SM.CartoRefSys.name) AS source_crs,
 corrected_ind,
 npts,
 depth_mode,
 combineBlobs(depth, md, fetchNRenameBlob(x,'x','x_offset',''), fetchNRenameBlob(y,'y','y_offset',''), "time") AS data,
 depth_dsdsunit AS depth_unit,
 md_dsdsunit AS md_unit,
 x_dsdsunit AS xy_unit,
 time_dsdsunit AS time_unit,
 user_def_1,
 user_def_num_1,
 user_def_num_2,
 OpenWorks_SM.TimeDepthTable.remark,
 OpenWorks_SM.TimeDepthTable.create_date,
 OpenWorks_SM.TimeDepthTable.create_user_id,
 OpenWorks_SM.TimeDepthTable.update_date,
 OpenWorks_SM.TimeDepthTable.update_user_id,
 OpenWorks_SM.TimeDepthTable.native_uid AS alternate_uid
 FROM
    (OpenWorks_SM.TimeDepthTable LEFT OUTER JOIN OpenWorks_SM.CartoRefSys ON orig_crs_id = id),OpenWorks_SM.WellEntire
 WHERE
    OpenWorks_SM.TimeDepthTable.wellid = OpenWorks_SM.WellEntire.wellid;


CREATE TRIGGER ON TimeDepthTable INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC

    DECLARE string VARIABLES.crs_errorMsg=CONCAT (CONCAT('ERROR: The given crs value "',"NEW".source_crs),'" does not exist in OpenWorks or an equivalent mapping does not exist in DSDS');
     DECLARE string VARIABLES.crs_id= null;

     IF("NEW".source_crs IS NOT NULL)
     BEGIN
         VARIABLES.crs_id = (SELECT id FROM OpenWorks_SM.CartoRefSys WHERE name = (SELECT * FROM (EXEC OpenWorks_SM.GetNativeCRS("NEW".source_crs,'OW')) AS SysGenID));
         IF(VARIABLES.crs_id is NULL)
             ERROR VARIABLES.crs_errorMsg;
     END

    DECLARE string VARIABLES.MSG_NO_WELLBORE=CONCAT (CONCAT('ERROR: The given wellbore_native_uid "',"NEW".wellbore_native_uid),'" does not exist in OpenWorks');

    DECLARE integer VARIABLES.time_depth_id = (SELECT * FROM (EXEC OpenWorks_SM.nextval('TimeDepthTable')) AS SysGenID);
    DECLARE string VARIABLES.wellid = "NEW".wellbore_native_uid;

    IF(VARIABLES.wellid IS NULL)
    BEGIN
        ERROR VARIABLES.MSG_NO_WELLBORE;
    END

    DECLARE integer VARIABLES.timeDepthNumPoints=fetchBlobElementSize("NEW".data,'time');
    DECLARE string VARIABLES.err_noDepthData = 'No data found in depth or md blob.';
    DECLARE string VARIABLES.depthMode = UPPER("NEW".depth_mode);       -- initialize with incoming mode
    DECLARE blob VARIABLES.depthData;
    DECLARE blob VARIABLES.mdData;
    VARIABLES.depthData=fetchBlob("NEW".data, 'depth');
    IF( VARIABLES.depthData IS NULL)
    BEGIN
        VARIABLES.depthData=fetchBlob("NEW".data, 'md');
        IF(VARIABLES.depthData IS NULL)                                 -- mode does not matter; both tvd and md data is null, throw error.
            ERROR VARIABLES.err_noDepthData;
        ELSE
            VARIABLES.depthMode='MD';                                   -- if tvd is null, but md is available, change mode to MD regardless of incoming mode
    END
    ELSE
    BEGIN
        IF (VARIABLES.depthMode='MD')                                   -- if mode is TVDBTDD, then VARIABLES.depthData has already been set with tvd
        BEGIN
            VARIABLES.mdData = fetchBlob("NEW".data, 'md');
            IF (VARIABLES.mdData IS NOT NULL)                           -- if mode is MD, then set VARIABLES.depthData with md
                VARIABLES.depthData = VARIABLES.mdData;
            ELSE                                                        -- if mode is MD, but md is not available, then change mode to 'TVDBTDD' and use VARIABLES.depthData initialized with tvd
                VARIABLES.depthMode = 'TVDBTDD';
        END
    END

    INSERT INTO OpenWorks_SM.TimeDepthTable (time_depth_id, wellid, td_name,                         shift_value,               shift_value_dsdsunit,   datum,               datum_dsdsunit,         data_source,                        checkshot_flag,               contractor,                         survey_type,                         survey_direction,                         survey_source,                         source_depth,       source_depth_dsdsunit,   source_offset,       source_offset_dsdsunit,   corrected_ind,                        npts,                         depth_mode, depth,               depth_dsdsunit,   "time",                        time_dsdsunit,   remark,                          user_def_1,                         user_def_num_1,       user_def_num_2,       source_orig_x_lon,         source_orig_y_lat,         orig_crs_id)
                                     VALUES (time_depth_id, wellid, SUBSTRING("NEW".td_name, 1, 50), NVL("NEW".shift_value, 0), "NEW".shift_value_unit, NVL("NEW".datum, 0), "NEW".depth_datum_unit, SUBSTRING("NEW".data_source, 1, 5), NVL("NEW".checkshot_flag, 0), SUBSTRING("NEW".contractor, 1, 40), SUBSTRING("NEW".survey_type, 1, 12), SUBSTRING("NEW".survey_direction, 1, 12), SUBSTRING("NEW".survey_source, 1, 12), "NEW".source_depth, "NEW".source_depth_unit, "NEW".source_offset, "NEW".source_offset_unit, SUBSTRING("NEW".corrected_ind, 1, 3), VARIABLES.timeDepthNumPoints, 'TVDBTDD',  VARIABLES.depthData, "NEW".depth_unit, fetchBlob("NEW".data, 'time'), "NEW".time_unit, SUBSTRING("NEW".remark, 1, 200), SUBSTRING("NEW".user_def_1, 1, 20), "NEW".user_def_num_1, "NEW".user_def_num_2, "NEW".source_x_coordinate, "NEW".source_y_coordinate, VARIABLES.crs_id);
    IF(VARIABLES.depthMode='MD')
    BEGIN
        UPDATE OpenWorks_SM.TimeDepthTable SET depth_mode = 'MD' WHERE (wellid = VARIABLES.wellid) AND (td_name = "NEW".td_name);
    END
END;

CREATE TRIGGER ON TimeDepthTable INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC

     DECLARE string VARIABLES.crs_errorMsg=CONCAT (CONCAT('ERROR: The given crs value "',"NEW".source_crs),'" does not exist in OpenWorks or an equivalent mapping does not exist in DSDS');
     DECLARE string VARIABLES.crs_id= null;

     IF("NEW".source_crs IS NOT NULL)
     BEGIN
         VARIABLES.crs_id = (SELECT id FROM OpenWorks_SM.CartoRefSys WHERE name = (SELECT * FROM (EXEC OpenWorks_SM.GetNativeCRS("NEW".source_crs,'OW')) AS SysGenID));
         IF(VARIABLES.crs_id is NULL)
             ERROR VARIABLES.crs_errorMsg;
     END

    DECLARE string VARIABLES.wellid = "OLD".wellbore_native_uid;
    DECLARE string VARIABLES.err_noDepthData = 'No data found in depth or md blob.';
    DECLARE blob VARIABLES.depthData;
    DECLARE string VARIABLES.depthMode="NEW".depth_mode;
    DECLARE integer VARIABLES.timeDepthNumPoints=fetchBlobElementSize("NEW".data,'time');

    UPDATE OpenWorks_SM.TimeDepthTable SET shift_value = NVL("NEW".shift_value, 0), shift_value_dsdsunit = "NEW".shift_value_unit, datum = NVL("NEW".datum, 0), datum_dsdsunit = "NEW".depth_datum_unit, data_source = SUBSTRING("NEW".data_source, 1, 5), checkshot_flag = NVL("NEW".checkshot_flag, 0), contractor = SUBSTRING("NEW".contractor, 1, 40), survey_type = SUBSTRING("NEW".survey_type, 1, 12), survey_direction = SUBSTRING("NEW".survey_direction, 1, 12), survey_source = SUBSTRING("NEW".survey_source, 1, 12), source_depth = "NEW".source_depth, source_depth_dsdsunit = "NEW".source_depth_unit, source_offset = "NEW".source_offset, source_offset_dsdsunit = "NEW".source_offset_unit, corrected_ind = SUBSTRING("NEW".corrected_ind, 1, 3), depth_mode = VARIABLES.depthMode, remark = SUBSTRING("NEW".remark, 1, 200), user_def_1 = SUBSTRING("NEW".user_def_1, 1, 20), user_def_num_1 = "NEW".user_def_num_1, user_def_num_2 = "NEW".user_def_num_2, source_orig_x_lon = "NEW".source_x_coordinate, source_orig_y_lat = "NEW".source_y_coordinate, orig_crs_id = VARIABLES.crs_id WHERE time_depth_id = "OLD".native_uid;
    IF(CHANGING.data)
    BEGIN
        VARIABLES.depthData=fetchBlob("NEW".data, 'depth');
        IF( VARIABLES.depthData IS NULL)
        BEGIN
            VARIABLES.depthData=fetchBlob("NEW".data, 'md');
            IF(VARIABLES.depthData IS NULL)
                ERROR VARIABLES.err_noDepthData;
            ELSE
                VARIABLES.depthMode='MD';
        END
        UPDATE OpenWorks_SM.TimeDepthTable SET  npts =VARIABLES.timeDepthNumPoints, depth = VARIABLES.depthData, depth_dsdsunit = "NEW".depth_unit, "time" = fetchBlob("NEW".data, 'time'), time_dsdsunit = "NEW".time_unit WHERE time_depth_id = "OLD".native_uid;
    END

END;

CREATE TRIGGER ON TimeDepthTable INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC

    /*DECLARE string VARIABLES.wellid = "OLD".wellbore_native_uid;*/
    DELETE FROM Openworks_SM.TimeDepthTable WHERE time_depth_id = "OLD".native_uid;
END;

/*
**********************************
*     "PreferredTDCurve"
**********************************
*/

CREATE VIEW PreferredTDCurve
(
  native_uid           VARCHAR(1024)  AUTO_INCREMENT
                                      OPTIONS ("OpenWorksCommonModel:PreferredTDCurve.native_uid.isUpdatable" false,
                                               "OpenWorksCommonModel:PreferredTDCurve.native_uid.isCreatable" false,
                                               UPDATABLE 'FALSE'),
  wellbore_native_uid  VARCHAR(1024)  NOT NULL,
  wellbore_uwi           VARCHAR(26)  OPTIONS ("OpenWorksCommonModel:PreferredTDCurve.wellbore_uwi.isUpdatable" false,
                                               "OpenWorksCommonModel:PreferredTDCurve.wellbore_uwi.isCreatable" false,
                                               UPDATABLE 'FALSE'),
  td_name                VARCHAR(50)  NOT NULL,
  data_source            VARCHAR(5)   NOT NULL,
  time_priority          VARCHAR(12),
  depth_priority         VARCHAR(12),
  original_data_source   VARCHAR(5),
  remark                 VARCHAR(200),
  create_date            TIMESTAMP    OPTIONS ("OpenWorksCommonModel:PreferredTDCurve.create_date.isUpdatable" false,
                                              "OpenWorksCommonModel:PreferredTDCurve.create_date.isCreatable" false,
                                               UPDATABLE 'FALSE'),
  create_user_id         VARCHAR(32)  OPTIONS ("OpenWorksCommonModel:PreferredTDCurve.create_user_id.isUpdatable" false,
                                              "OpenWorksCommonModel:PreferredTDCurve.create_user_id.isCreatable" false,
                                               UPDATABLE 'FALSE'),
  update_date            TIMESTAMP    OPTIONS ("OpenWorksCommonModel:PreferredTDCurve.update_date.isUpdatable" false,
                                              "OpenWorksCommonModel:PreferredTDCurve.update_date.isCreatable" false,
                                               UPDATABLE 'FALSE'),
  update_user_id         VARCHAR(32)  OPTIONS ("OpenWorksCommonModel:PreferredTDCurve.update_user_id.isUpdatable" false,
                                              "OpenWorksCommonModel:PreferredTDCurve.update_user_id.isCreatable" false,
                                               UPDATABLE 'FALSE'),
  alternate_uid  		    VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:PreferredTDCurve.alternate_uid.isCreatable" false,
                                               "OpenWorksCommonModel:PreferredTDCurve.alternate_uid.isUpdatable" false,
                                                UPDATABLE 'FALSE'),


  CONSTRAINT PreferredTDCurve_PK PRIMARY KEY (native_uid),

  CONSTRAINT PreferredTDCurve_UK1 UNIQUE (wellbore_native_uid,data_source),

  CONSTRAINT FK_PreferredTDCurve_wellbore_native_uid_td_name
      FOREIGN KEY (wellbore_native_uid,td_name)
      REFERENCES TimeDepthTable(wellbore_native_uid,td_name),

  CONSTRAINT FK_PreferredTDCurve_wellbore_native_uid
      FOREIGN KEY (wellbore_native_uid)
      REFERENCES Wellbore(native_uid),

    CONSTRAINT FK_PreferredTDCurve_data_source
        FOREIGN KEY (data_source)
        REFERENCES DataSource(name),

    CONSTRAINT FK_PreferredTDCurve_original_data_source
        FOREIGN KEY (original_data_source)
        REFERENCES DataSource(name)

)
OPTIONS (UPDATABLE 'TRUE', PreferredTDCurve.IMPLEMENTED 'TRUE')
    AS
    SELECT
        Openworks_SM.PreferredTDCurve.native_uid AS native_uid,
        OpenWorks_SM.WellEntire.wellid AS wellbore_native_uid,
        OpenWorks_SM.WellEntire.uwi,
        OpenWorks_SM.TimeDepthTable.td_name,
        Openworks_SM.PreferredTDCurve.data_source,
        Openworks_SM.PreferredTDCurve.time_priority,
        Openworks_SM.PreferredTDCurve.depth_priority,
        Openworks_SM.PreferredTDCurve.original_data_source,
        Openworks_SM.PreferredTDCurve.remark,
        Openworks_SM.PreferredTDCurve.create_date,
        Openworks_SM.PreferredTDCurve.create_user_id,
        Openworks_SM.PreferredTDCurve.update_date,
        Openworks_SM.PreferredTDCurve.update_user_id,
	    Openworks_SM.PreferredTDCurve.native_uid AS alternate_uid
        FROM ((Openworks_SM.PreferredTDCurve LEFT OUTER JOIN OpenWorks_SM.WellEntire ON Openworks_SM.PreferredTDCurve.wellid=OpenWorks_SM.WellEntire.wellid) LEFT OUTER JOIN OpenWorks_SM.TimeDepthTable ON Openworks_SM.PreferredTDCurve.time_depth_id=OpenWorks_SM.TimeDepthTable.time_depth_id);

CREATE TRIGGER ON PreferredTDCurve INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC

    DECLARE string VARIABLES.MSG_NO_WELLBORE=CONCAT (CONCAT('ERROR: The given wellbore_native_uid "',"NEW".wellbore_native_uid),'" does not exist in OpenWorks');
    DECLARE string VARIABLES.time_depth_id_errorMsg='ERROR: The TimeDepth curve for given values for (wellbore_uwi,td_name) does not exist';
    DECLARE string VARIABLES.wellid = "NEW".wellbore_native_uid;

    IF(VARIABLES.wellid IS NULL)
    BEGIN
        ERROR VARIABLES.MSG_NO_WELLBORE;
    END

    DECLARE integer VARIABLES.time_depth_id = (SELECT CONVERT(time_depth_id,integer) FROM OpenWorks_SM.TimeDepthTable WHERE (wellid = VARIABLES.wellid) AND (td_name = "NEW".td_name));

    IF (VARIABLES.time_depth_id IS NULL) ERROR VARIABLES.time_depth_id_errorMsg;

    INSERT INTO Openworks_SM.PreferredTDCurve(wellid,           data_source,       time_depth_id,           time_priority,       depth_priority,       original_data_source,       remark)
                                      VALUES (VARIABLES.wellid, "NEW".data_source, VARIABLES.time_depth_id, "NEW".time_priority, "NEW".depth_priority, "NEW".original_data_source, "NEW".remark);
END;

CREATE TRIGGER ON PreferredTDCurve INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC

    DECLARE string VARIABLES.time_depth_id_errorMsg='ERROR: The TimeDepth curve for given values for (wellbore_native_uid,td_name) does not exist';
    DECLARE string VARIABLES.wellid = "OLD".wellbore_native_uid;
    DECLARE string VARIABLES.time_depth_id;
    IF("NEW".td_name is NOT NULL)
    BEGIN
    VARIABLES.time_depth_id=(SELECT time_depth_id FROM OpenWorks_SM.TimeDepthTable WHERE (wellid = VARIABLES.wellid) AND (td_name = "NEW".td_name));
    IF (VARIABLES.time_depth_id IS NULL) ERROR VARIABLES.time_depth_id_errorMsg;
    END
    UPDATE Openworks_SM.PreferredTDCurve SET time_depth_id=VARIABLES.time_depth_id,time_priority="NEW".time_priority,depth_priority="NEW".depth_priority,original_data_source="NEW".original_data_source,remark=
    "NEW".remark WHERE native_uid="OLD".native_uid;

    END;

CREATE TRIGGER ON PreferredTDCurve INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC

   DELETE FROM Openworks_SM.PreferredTDCurve WHERE native_uid = "OLD".native_uid;
END;

/*
**********************************
*     "SyntheticSeismic"
**********************************
*/

CREATE VIEW SyntheticSeismic
(
  native_uid                     VARCHAR(1024)  AUTO_INCREMENT
                                                OPTIONS ("OpenWorksCommonModel:SyntheticSeismic.native_uid.isUpdatable" false,
                                                         "OpenWorksCommonModel:SyntheticSeismic.native_uid.isCreatable" false,
                                                         UPDATABLE 'FALSE'),
  wellbore_native_uid            VARCHAR(1024)  NOT NULL,
  synthetic_name                 VARCHAR(24)    NOT NULL,
  wellbore_uwi                   VARCHAR(26)    OPTIONS ("OpenWorksCommonModel:SyntheticSeismic.wellbore_uwi.isUpdatable" false,
                                                         "OpenWorksCommonModel:SyntheticSeismic.wellbore_uwi.isCreatable" false,
                                                         UPDATABLE 'FALSE'),
  density_curve_id               VARCHAR(1024),
  synthetic_type_name            VARCHAR(40)    DEFAULT 'UNKNOWN',
  shearsonic_curve_id            VARCHAR(1024),
  sonic_curve_id                 VARCHAR(1024),
  time_depth_id                  VARCHAR(1024),
  wavelet_native_uid             VARCHAR(1024),
  wavelet_name                   VARCHAR(40)    OPTIONS("OpenWorksCommonModel:SyntheticSeismic.wavelet_name.isUpdatable" false,
                                                        "OpenWorksCommonModel:SyntheticSeismic.wavelet_name.isCreatable" false,
                                                        UPDATABLE 'FALSE'),
  offset_type                    VARCHAR(40)    DEFAULT 'OFFSET',
  offset_value                   FLOAT          OPTIONS ("OpenWorksCommonModel:SyntheticSeismic.offset_value.unitField" 'offset_value_unit'),
  offset_value_unit              VARCHAR(64)    OPTIONS ("OpenWorksCommonModel:SyntheticSeismic.offset_value_unit.unitTypeAttribute" 'offset_unit_type'),
  offset_unit_type               INTEGER,
  start_time                     FLOAT          NOT NULL
                                                OPTIONS ("OpenWorksCommonModel:SyntheticSeismic.start_time.unitField" 'time_unit'),
  end_time                       FLOAT          NOT NULL
                                                OPTIONS ("OpenWorksCommonModel:SyntheticSeismic.end_time.unitField" 'time_unit'),
  time_unit                      VARCHAR(64)    NOT NULL
                                                OPTIONS ("OpenWorksCommonModel:SyntheticSeismic.time_unit.unitType" 'seismic time'),
  sample_interval                FLOAT          NOT NULL
                                                OPTIONS ("OpenWorksCommonModel:SyntheticSeismic.sample_interval.unitField" 'sample_interval_unit'),
  sample_interval_unit           VARCHAR(64)    NOT NULL
                                                OPTIONS ("OpenWorksCommonModel:SyntheticSeismic.sample_interval_unit.unitType" 'seismic time'),
  data_source                    VARCHAR(5),
  npts                           INTEGER        NOT NULL,
  amplitude                      BLOB           NOT NULL
                                                OPTIONS ("OpenWorksCommonModel:SyntheticSeismic.amplitude.elementType" 'arrayfloat',
                                                         "OpenWorksCommonModel:SyntheticSeismic.amplitude.isPrimitiveArray" true,
                                                         "OpenWorksCommonModel:SyntheticSeismic.amplitude.unitField" 'amplitude_unit'),
  amplitude_unit                 VARCHAR(64)    NOT NULL
                                                OPTIONS ("OpenWorksCommonModel:SyntheticSeismic.amplitude_unit.unitType" 'amplitude'),
  remark                         VARCHAR(200),
  create_date                    TIMESTAMP      OPTIONS("OpenWorksCommonModel:SyntheticSeismic.create_date.isUpdatable" false,
                                                        "OpenWorksCommonModel:SyntheticSeismic.create_date.isCreatable" false,
                                                        UPDATABLE 'FALSE'),
  create_user_id                 VARCHAR(32)    OPTIONS("OpenWorksCommonModel:SyntheticSeismic.create_user_id.isUpdatable" false,
                                                        "OpenWorksCommonModel:SyntheticSeismic.create_user_id.isCreatable" false,
                                                        UPDATABLE 'FALSE'),
  update_date                    TIMESTAMP      OPTIONS("OpenWorksCommonModel:SyntheticSeismic.update_date.isUpdatable" false,
                                                        "OpenWorksCommonModel:SyntheticSeismic.update_date.isCreatable" false,
                                                        UPDATABLE 'FALSE'),
  update_user_id                 VARCHAR(32)    OPTIONS("OpenWorksCommonModel:SyntheticSeismic.update_user_id.isUpdatable" false,
                                                        "OpenWorksCommonModel:SyntheticSeismic.update_user_id.isCreatable" false,
                                                        UPDATABLE 'FALSE'),
  alternate_uid    		             VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:SyntheticSeismic.alternate_uid.isCreatable" false,
                                                        "OpenWorksCommonModel:SyntheticSeismic.alternate_uid.isUpdatable" false,
                                                         UPDATABLE 'FALSE'),


 CONSTRAINT SyntheticSeismic_PK PRIMARY KEY (native_uid),

    CONSTRAINT SyntheticSeismic_UK1 UNIQUE (wellbore_native_uid, synthetic_name),

    CONSTRAINT FK_SyntheticSeismic_wellbore_native_uid
        FOREIGN KEY (wellbore_native_uid)
        REFERENCES Wellbore(native_uid),

    CONSTRAINT FK_SyntheticSeismic_density_curve_id
        FOREIGN KEY (density_curve_id)
        REFERENCES LogCurve(native_uid),

    CONSTRAINT FK_SyntheticSeismic_shearsonic_curve_id
        FOREIGN KEY (shearsonic_curve_id)
        REFERENCES LogCurve(native_uid),

    CONSTRAINT FK_SyntheticSeismic_sonic_curve_id
        FOREIGN KEY (sonic_curve_id)
        REFERENCES LogCurve(native_uid),

    CONSTRAINT FK_SyntheticSeismic_time_depth_id
        FOREIGN KEY (time_depth_id)
        REFERENCES TimeDepthTable(native_uid),

    CONSTRAINT FK_SyntheticSeismic_wavelet_native_uid
        FOREIGN KEY       (wavelet_native_uid)
        REFERENCES Wavelet(native_uid),

    CONSTRAINT FK_SyntheticSeismic_data_source
        FOREIGN KEY (data_source)
        REFERENCES DataSource(name)

)
OPTIONS (UPDATABLE 'TRUE', SyntheticSeismic.IMPLEMENTED 'TRUE')
AS
SELECT
 synthetic_id AS native_uid,
 Openworks_SM.wellentire.wellid AS wellbore_native_uid,
 synthetic_name,
 uwi AS wellbore_uwi,
 density_curve_id as density_curve_id,
 synthetic_type_nm,
 shear_sonic_curve_id as shear_sonic_curve_id,
 sonic_curve_id as sonic_curve_id,
 time_depth_table_id as time_depth_id,
 Openworks_SM.wavelet.wavelet_id,
 wavelet_name,
 offset_type,
 offset_value,
 offset_value_dsdsunit AS offset_value_unit,
 null,
 start_time,
 end_time,
 coalesce(start_time_dsdsunit,end_time_dsdsunit) AS time_unit,
 OpenWorks_SM.SynthSeis.sample_interval,
 OpenWorks_SM.SynthSeis.sample_interval_dsdsunit AS sample_interval_unit,
 OpenWorks_SM.SynthSeis.data_source,
 npts,
 amplitude,
 amplitude_dsdsunit AS amplitude_unit,
 OpenWorks_SM.SynthSeis.remark,
 OpenWorks_SM.SynthSeis.create_date,
 OpenWorks_SM.SynthSeis.create_user_id,
 OpenWorks_SM.SynthSeis.update_date,
 OpenWorks_SM.SynthSeis.update_user_id,
 OpenWorks_SM.SynthSeis.native_uid AS alternate_uid
    FROM
        /*+ MAKEDEP */ OpenWorks_SM.SynthSeis LEFT OUTER JOIN Openworks_SM.wavelet ON OpenWorks_SM.SynthSeis.wavelet_id = Openworks_SM.wavelet.wavelet_id, Openworks_SM.wellentire
    WHERE
        OpenWorks_SM.SynthSeis.wellid = Openworks_SM.wellentire.wellid;

CREATE TRIGGER ON SyntheticSeismic INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC
    DECLARE string VARIABLES.MSG_NO_WELLBORE=CONCAT (CONCAT('ERROR: The given wellbore_native_uid "',"NEW".wellbore_native_uid),'" does not exist in OpenWorks');
    DECLARE string VARIABLES.time_depth_id_errorMsg=CONCAT (CONCAT('ERROR: The given time_depth_id "',"NEW".time_depth_id),'" does not exist in OpenWorks Time Depth Table');
    DECLARE integer VARIABLES.synthetic_id;
    DECLARE string VARIABLES.wellid;
    DECLARE string VARIABLES.time_depth_id;
    DECLARE string VARIABLES.wavelet_id;
    DECLARE string VARIABLES.density_id;
    DECLARE string VARIABLES.sonic_id;
    DECLARE string VARIABLES.shearsonic_id;

    VARIABLES.synthetic_id = (SELECT * FROM (EXEC OpenWorks_SM.nextval('SynthSeis')) AS SysGenID);
    VARIABLES.wellid  = "NEW".wellbore_native_uid;

    IF(VARIABLES.wellid IS NULL)
    BEGIN
        ERROR VARIABLES.MSG_NO_WELLBORE;
    END

    IF("NEW".time_depth_id IS NOT NULL)
    BEGIN
        VARIABLES.time_depth_id    = (SELECT time_depth_id FROM OpenWorks_SM.TimeDepthTable WHERE time_depth_id = "NEW".time_depth_id);
        IF(VARIABLES.time_depth_id is NULL) ERROR VARIABLES.time_depth_id_errorMsg;
    END
    IF("NEW".wavelet_native_uid IS NOT NULL)
    BEGIN
        VARIABLES.wavelet_id = (SELECT wavelet_id FROM OpenWorks_SM.Wavelet WHERE wavelet_id = "NEW".wavelet_native_uid);
    END

    IF("NEW".density_curve_id IS NOT NULL)
    BEGIN
            VARIABLES.density_id    = (SELECT log_curve_id FROM OpenWorks_SM.LogCurve WHERE log_curve_id = "NEW".density_curve_id);
    END

    IF("NEW".shearsonic_curve_id IS NOT NULL)
    BEGIN
            VARIABLES.shearsonic_id    = (SELECT log_curve_id FROM OpenWorks_SM.LogCurve WHERE log_curve_id = "NEW".shearsonic_curve_id);
    END

    IF("NEW".sonic_curve_id IS NOT NULL)
    BEGIN
            VARIABLES.sonic_id    = (SELECT log_curve_id FROM OpenWorks_SM.LogCurve WHERE log_curve_id = "NEW".sonic_curve_id);
    END

    INSERT INTO OpenWorks_SM.SynthSeis (synthetic_id,           Synthetic_name,                       wellid,           density_curve_id,     synthetic_type_nm,                         sonic_curve_id,     shear_sonic_curve_id,    time_depth_table_id,     wavelet_id,           offset_type,                       offset_value,       offset_value_dsdsunit,         start_time,       start_time_dsdsunit, end_time,       end_time_dsdsunit, sample_interval,       sample_interval_dsdsunit,   data_source,                      remark,                        npts,       amplitude,       amplitude_dsdsunit)
                                VALUES (VARIABLES.synthetic_id, SUBSTRING("NEW".Synthetic_name,1,24), VARIABLES.wellid, VARIABLES.density_id, SUBSTRING("NEW".synthetic_type_name,1,40), VARIABLES.sonic_id, VARIABLES.shearsonic_id, VARIABLES.time_depth_id, VARIABLES.wavelet_id, SUBSTRING("NEW".offset_type,1,40), "NEW".offset_value, "NEW".offset_value_unit, "NEW".start_time, "NEW".time_unit,     "NEW".end_time, "NEW".time_unit,   "NEW".sample_interval, "NEW".sample_interval_unit, SUBSTRING("NEW".data_source,1,5), SUBSTRING("NEW".remark,1,200), "NEW".npts, "NEW".amplitude, "NEW".amplitude_unit);
END;

CREATE TRIGGER ON SyntheticSeismic INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC

    DECLARE string VARIABLES.time_depth_id_errorMsg=CONCAT (CONCAT('ERROR: The given time_depth_id "',"NEW".time_depth_id),'" does not exist in OpenWorks Time Depth Table');
    DECLARE string VARIABLES.wavelet_id_errorMsg='ERROR: The given value for wavelet_name does not exist.';
    DECLARE string VARIABLES.density_id_errorMsg=CONCAT (CONCAT('ERROR: The given density_curve_id "',"NEW".density_curve_id),'" does not exist in OpenWorks LogCurve Table');
    DECLARE string VARIABLES.sonic_id_errorMsg=CONCAT (CONCAT('ERROR: The given sonic_curve_id "',"NEW".sonic_curve_id),'" does not exist in OpenWorks LogCurve Table');
    DECLARE string VARIABLES.shearsonic_id_errorMsg=CONCAT (CONCAT('ERROR: The given shearsonic_curve_id "',"NEW".shearsonic_curve_id),'" does not exist in OpenWorks LogCurve Table');

    DECLARE string VARIABLES.wellid = (SELECT wellid FROM OpenWorks_SM.WellEntire WHERE uwi = "OLD".wellbore_uwi);
    DECLARE string VARIABLES.synthetic_id = (SELECT synthetic_id FROM OpenWorks_SM.SynthSeis WHERE Synthetic_name = SUBSTRING("OLD".Synthetic_name,1,24) and wellid = VARIABLES.wellid);

    DECLARE string VARIABLES.time_depth_id;
    DECLARE string VARIABLES.wavelet_id;
    DECLARE string VARIABLES.density_id;
    DECLARE string VARIABLES.sonic_id;
    DECLARE string VARIABLES.shearsonic_id;


    VARIABLES.wellid  = CONVERT("OLD".wellbore_native_uid,integer);

    IF("NEW".time_depth_id IS NOT NULL)
    BEGIN
        VARIABLES.time_depth_id    = (SELECT time_depth_id FROM OpenWorks_SM.TimeDepthTable WHERE time_depth_id = "NEW".time_depth_id);
		IF(VARIABLES.time_depth_id is NULL) ERROR VARIABLES.time_depth_id_errorMsg;

    END
    IF("NEW".wavelet_native_uid IS NOT NULL)
    BEGIN
        VARIABLES.wavelet_id = (SELECT wavelet_id FROM OpenWorks_SM.Wavelet WHERE wavelet_id = "NEW".wavelet_native_uid);

    END

    IF("NEW".density_curve_id IS NOT NULL)
    BEGIN
            VARIABLES.density_id    = (SELECT log_curve_id FROM OpenWorks_SM.LogCurve WHERE log_curve_id = "NEW".density_curve_id);

    END

    IF("NEW".shearsonic_curve_id IS NOT NULL)
    BEGIN
            VARIABLES.shearsonic_id    = (SELECT log_curve_id FROM OpenWorks_SM.LogCurve WHERE log_curve_id = "NEW".shearsonic_curve_id);

    END

    IF("NEW".sonic_curve_id IS NOT NULL)
    BEGIN
            VARIABLES.sonic_id    = (SELECT log_curve_id FROM OpenWorks_SM.LogCurve WHERE log_curve_id = "NEW".sonic_curve_id);

    END


    UPDATE OpenWorks_SM.SynthSeis set density_curve_id = VARIABLES.density_id, synthetic_type_nm = SUBSTRING("NEW".synthetic_type_name,1,40), sonic_curve_id = VARIABLES.sonic_id, shear_sonic_curve_id =  VARIABLES.shearsonic_id, time_depth_table_id = VARIABLES.time_depth_id, wavelet_id = VARIABLES.wavelet_id, offset_type = SUBSTRING("NEW".offset_type,1,40), offset_value = "NEW".offset_value, offset_value_dsdsunit = "NEW".offset_value_unit,   start_time = "NEW".start_time, start_time_dsdsunit = "NEW".time_unit, end_time = "NEW".end_time, end_time_dsdsunit = "NEW".time_unit,  sample_interval = "NEW".sample_interval, sample_interval_dsdsunit = "NEW".sample_interval_unit, data_source = SUBSTRING("NEW".data_source,1,5), remark = SUBSTRING("NEW".remark,1,200), npts = "NEW".npts, amplitude = "NEW".amplitude,  amplitude_dsdsunit = "NEW".amplitude_unit where synthetic_id = "OLD".native_uid;
END;


CREATE TRIGGER ON SyntheticSeismic INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC
    DELETE FROM OpenWorks_SM.SynthSeis WHERE synthetic_id = "OLD".native_uid;
END;

/*
**********************************
*     "Wavelet"
**********************************
*/

CREATE VIEW Wavelet
(
  native_uid                 VARCHAR(128) AUTO_INCREMENT
                                          OPTIONS("OpenWorksCommonModel:Wavelet.native_uid.isUpdatable" false,
                                                  "OpenWorksCommonModel:Wavelet.native_uid.isCreatable" false,
                                                  UPDATABLE 'FALSE'),
  wavelet_name               VARCHAR(40)  NOT NULL,
  data_source                VARCHAR(5),
  program_source             VARCHAR(25),
  total_samples              INTEGER      NOT NULL,
  sample_interval            DOUBLE       OPTIONS ("OpenWorksCommonModel:Wavelet.sample_interval.unitField" 'sample_interval_unit'),
  sample_interval_unit       VARCHAR(64)  OPTIONS ("OpenWorksCommonModel:Wavelet.sample_interval_unit.unitType" 'seismic time'),
  time_zero_sample           FLOAT,
  dominant_period            FLOAT        OPTIONS ("OpenWorksCommonModel:Wavelet.dominant_period.unitField" 'dominant_period_unit'),
  dominant_period_unit       VARCHAR(64)  OPTIONS ("OpenWorksCommonModel:Wavelet.dominant_period_unit.unitType" 'seismic time'),
  dominant_wavelength        FLOAT        OPTIONS ("OpenWorksCommonModel:Wavelet.dominant_wavelength.unitField" 'dominant_wavelength_unit'),
  dominant_wavelength_unit   VARCHAR(64)  OPTIONS ("OpenWorksCommonModel:Wavelet.dominant_wavelength_unit.unitType" 'wave length'),
  high_cut                   FLOAT        OPTIONS ("OpenWorksCommonModel:Wavelet.high_cut.unitField" 'high_cut_unit'),
  high_cut_unit              VARCHAR(64)  OPTIONS ("OpenWorksCommonModel:Wavelet.high_cut_unit.unitType" 'frequency'),
  high_cut_rate              FLOAT        OPTIONS ("OpenWorksCommonModel:Wavelet.high_cut_rate.unitField" 'high_cut_rate_unit'),
  high_cut_rate_unit         VARCHAR(64)  OPTIONS ("OpenWorksCommonModel:Wavelet.high_cut_rate_unit.unitType" 'loudness per octave'),
  low_cut                    FLOAT        OPTIONS ("OpenWorksCommonModel:Wavelet.low_cut.unitField" 'low_cut_unit'),
  low_cut_unit               VARCHAR(64)  OPTIONS ("OpenWorksCommonModel:Wavelet.low_cut_unit.unitType" 'frequency'),
  low_cut_rate               FLOAT        OPTIONS ("OpenWorksCommonModel:Wavelet.low_cut_rate.unitField" 'low_cut_rate_unit'),
  low_cut_rate_unit          VARCHAR(64)  OPTIONS ("OpenWorksCommonModel:Wavelet.low_cut_rate_unit.unitType" 'loudness per octave'),
  peak_amplitude             FLOAT        OPTIONS ("OpenWorksCommonModel:Wavelet.peak_amplitude.unitField" 'peak_amplitude_unit'),
  peak_amplitude_unit        VARCHAR(64)  OPTIONS ("OpenWorksCommonModel:Wavelet.peak_amplitude_unit.unitType" 'amplitude'),
  peak_frequency             FLOAT        OPTIONS ("OpenWorksCommonModel:Wavelet.peak_frequency.unitField" 'peak_frequency_unit'),
  peak_frequency_unit        VARCHAR(64)  OPTIONS ("OpenWorksCommonModel:Wavelet.peak_frequency_unit.unitType" 'frequency'),
  wavelet_filter_algorithm   VARCHAR(40)  DEFAULT 'UNKNOWN',
  wavelet_filter_kind        VARCHAR(40)  DEFAULT 'UNKNOWN',
  amplitude                  BLOB         NOT NULL
                                          OPTIONS ("OpenWorksCommonModel:Wavelet.amplitude.elementType" 'arrayfloat',
                                                   "OpenWorksCommonModel:Wavelet.amplitude.isPrimitiveArray" true,
                                                   "OpenWorksCommonModel:Wavelet.amplitude.unitField"    'amplitude_unit'),
  amplitude_unit             VARCHAR(64)  NOT NULL   OPTIONS ("OpenWorksCommonModel:Wavelet.amplitude_unit.unitType" 'frequency'),
  remark                     VARCHAR(200),
 create_date                 TIMESTAMP    OPTIONS("OpenWorksCommonModel:Wavelet.create_date.isUpdatable" false,
                                                  "OpenWorksCommonModel:Wavelet.create_date.isCreatable" false,UPDATABLE 'FALSE'),
  create_user_id             VARCHAR(32)  OPTIONS("OpenWorksCommonModel:Wavelet.create_user_id.isUpdatable" false,
                                                  "OpenWorksCommonModel:Wavelet.create_user_id.isCreatable" false,UPDATABLE 'FALSE'),
  update_date                TIMESTAMP    OPTIONS("OpenWorksCommonModel:Wavelet.update_date.isUpdatable" false,
                                                  "OpenWorksCommonModel:Wavelet.update_date.isCreatable" false,UPDATABLE 'FALSE'),
  update_user_id             VARCHAR(32)  OPTIONS("OpenWorksCommonModel:Wavelet.update_user_id.isUpdatable" false,
                                                  "OpenWorksCommonModel:Wavelet.update_user_id.isCreatable" false,UPDATABLE 'FALSE'),
  alternate_uid    		         VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:Wavelet.alternate_uid.isCreatable" false,
                                                    "OpenWorksCommonModel:Wavelet.alternate_uid.isUpdatable" false,
                                                    UPDATABLE 'FALSE'),

  CONSTRAINT Wavelet_PK PRIMARY KEY(native_uid),

  CONSTRAINT Wavelet_UK1 UNIQUE (wavelet_name),

  CONSTRAINT FK_Wavelet_data_source
      FOREIGN KEY          (data_source)
      REFERENCES DataSource(name)

)
OPTIONS (UPDATABLE 'TRUE',Wavelet.IMPLEMENTED 'TRUE')

AS
SELECT
 wavelet_id,
 wavelet_name,
 data_source,
 program_source,
 total_samples,
 sample_interval,
 sample_interval_dsdsunit AS sample_interval_unit,
 time_zero_sample,
 dominant_period,
 dominant_period_dsdsunit AS dominant_period_unit,
 dominant_wavelength,
 dominant_wavelength_dsdsunit AS dominant_wavelength_unit,
 high_cut,
 high_cut_dsdsunit AS high_cut_unit,
 high_cut_rate,
 high_cut_rate_dsdsunit AS high_cut_rate_unit,
 low_cut,
 low_cut_dsdsunit AS low_cut_unit,
 low_cut_rate,
 low_cut_rate_dsdsunit AS low_cut_rate_unit,
 peak_amplitude,
 peak_amplitude_dsdsunit AS peak_amplitude_unit,
 peak_frequency,
 peak_frequency_dsdsunit AS peak_frequency_unit,
 wavelet_filter_algorithm,
 wavelet_filter_kind,
 fetchNRenameBlob("values",'values','amplitude','') AS amplitude,
 values_dsdsunit AS amplitude_unit,
 remark,
 create_date,
 create_user_id,
 update_date,
 update_user_id,
 native_uid
FROM
 Openworks_SM.wavelet;

CREATE TRIGGER ON Wavelet INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC
    DECLARE integer VARIABLES.wavelet_id = (SELECT * FROM (EXEC OpenWorks_SM.nextval('Wavelet')) AS SysGenID);
    INSERT INTO OpenWorks_SM.Wavelet (wavelet_id,           wavelet_name,                         data_source,                        program_source,                         total_samples,       sample_interval,       sample_interval_dsdsunit,   time_zero_sample,       dominant_period,       dominant_period_dsdsunit,   dominant_wavelength,       dominant_wavelength_dsdsunit,   high_cut,       high_cut_dsdsunit,    high_cut_rate,      high_cut_rate_dsdsunit,    low_cut,      low_cut_dsdsunit,   low_cut_rate,       low_cut_rate_dsdsunit,    peak_amplitude,       peak_amplitude_dsdsunit,   peak_frequency,       peak_frequency_dsdsunit,  wavelet_filter_algorithm,                         wavelet_filter_kind,                         remark,                          "values",                                                   values_dsdsunit)
                              VALUES (VARIABLES.wavelet_id, SUBSTRING("NEW".wavelet_name, 1, 40), SUBSTRING("NEW".data_source, 1, 5), SUBSTRING("NEW".program_source, 1, 25), "NEW".total_samples, "NEW".sample_interval, "NEW".sample_interval_unit, "NEW".time_zero_sample, "NEW".dominant_period, "NEW".dominant_period_unit, "NEW".dominant_wavelength, "NEW".dominant_wavelength_unit, "NEW".high_cut, "NEW".high_cut_unit, "NEW".high_cut_rate, "NEW".high_cut_rate_unit, "NEW".low_cut, "NEW".low_cut_unit, "NEW".low_cut_rate, "NEW".low_cut_rate_unit, "NEW".peak_amplitude, "NEW".peak_amplitude_unit, "NEW".peak_frequency, "NEW".peak_frequency_unit, SUBSTRING("NEW".wavelet_filter_algorithm, 1, 40), SUBSTRING("NEW".wavelet_filter_kind, 1, 40), SUBSTRING("NEW".remark, 1, 200), fetchNRenameBlob("NEW".amplitude, 'amplitude','values',''), "NEW".amplitude_unit);
END;

CREATE TRIGGER ON Wavelet INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC
    UPDATE OpenWorks_SM.Wavelet SET data_source = SUBSTRING("NEW".data_source, 1, 5), program_source = SUBSTRING("NEW".program_source, 1, 25), total_samples = "NEW".total_samples, sample_interval = "NEW".sample_interval, sample_interval_dsdsunit = "NEW".sample_interval_unit, time_zero_sample = "NEW".time_zero_sample, dominant_period = "NEW".dominant_period, dominant_period_dsdsunit = "NEW".dominant_period_unit, dominant_wavelength = "NEW".dominant_wavelength, dominant_wavelength_dsdsunit = "NEW".dominant_wavelength_unit, high_cut = "NEW".high_cut, high_cut_dsdsunit = "NEW".high_cut_unit, high_cut_rate = "NEW".high_cut_rate, high_cut_rate_dsdsunit = "NEW".high_cut_rate_unit, low_cut = "NEW".low_cut, low_cut_dsdsunit = "NEW".low_cut_unit, low_cut_rate = "NEW".low_cut_rate, low_cut_rate_dsdsunit = "NEW".low_cut_rate_unit, peak_amplitude = "NEW".peak_amplitude, peak_amplitude_dsdsunit = "NEW".peak_amplitude_unit, peak_frequency = "NEW".peak_frequency, peak_frequency_dsdsunit = "NEW".peak_frequency_unit, wavelet_filter_algorithm = SUBSTRING("NEW".wavelet_filter_algorithm, 1, 40), wavelet_filter_kind = SUBSTRING("NEW".wavelet_filter_kind, 1, 40), remark = SUBSTRING("NEW".remark, 1, 200), "values" = fetchNRenameBlob("NEW".amplitude, 'amplitude','values',''),values_dsdsunit = "NEW".amplitude_unit WHERE wavelet_name = SUBSTRING("OLD".wavelet_name, 1, 40);
END;

CREATE TRIGGER ON Wavelet INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC
    DELETE FROM OpenWorks_SM.Wavelet WHERE wavelet_name = SUBSTRING("OLD".wavelet_name, 1, 40);

END;

/*
**********************************
* "RefPickSurfaceName"
**********************************
*/
CREATE VIEW RefPickSurfaceName
(
  pick_surf_name               VARCHAR(40) NOT NULL,
  pick_surf_abbrev             VARCHAR(20),
  pick_surf_alias              VARCHAR(40),
  status                       VARCHAR(19),
  source                       VARCHAR(39),
  remark                       VARCHAR(200),
  create_date                  TIMESTAMP,
  create_user_id               VARCHAR(32),
  update_date                  TIMESTAMP,
  update_user_id               VARCHAR(32),

  CONSTRAINT RefPickSurfaceName_PK PRIMARY KEY (pick_surf_name)

)
OPTIONS (UPDATABLE 'TRUE', RefPickSurfaceName.IMPLEMENTED 'TRUE')
    AS
    SELECT
        pick_surf_name AS pick_surf_name,
        pick_surf_abbrev AS pick_surf_abbrev,
        pick_surf_alias AS pick_surf_alias,
        ref_value_status AS status,
        ref_value_source AS source,
        remark AS remark,
        create_date AS create_date,
        create_user_id AS create_user_id,
        update_date AS update_date,
        update_user_id AS update_user_id

        FROM Openworks_SM.VcPickSurfName;

CREATE TRIGGER ON RefPickSurfaceName INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC
Insert into Openworks_SM.VcPickSurfName(pick_surf_name,       pick_surf_abbrev,       pick_surf_alias,        remark,      ref_value_status,  ref_value_source )
                                VALUES ("NEW".pick_surf_name, "NEW".pick_surf_abbrev, "NEW".pick_surf_alias, "NEW".remark, "NEW".status,      "NEW".source );
END;


CREATE TRIGGER ON RefPickSurfaceName INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC
Update Openworks_SM.VcPickSurfName Set    pick_surf_abbrev="NEW".pick_surf_abbrev, pick_surf_alias="NEW".pick_surf_alias,  remark="NEW".remark, ref_value_status="NEW".status, ref_value_source="NEW".source
Where   pick_surf_name="OLD".pick_surf_name ;

END;

CREATE TRIGGER ON RefPickSurfaceName INSTEAD OF Delete AS
FOR EACH ROW
BEGIN ATOMIC
Delete from Openworks_SM.VcPickSurfName    Where pick_surf_name="OLD".pick_surf_name ;
END;



/*
**********************************
*     "Pick"
**********************************
*/
CREATE VIEW Pick
(
  native_uid                   VARCHAR(1024) AUTO_INCREMENT
                                             OPTIONS("OpenWorksCommonModel:Pick.native_uid.isUpdatable" false,
                                                     "OpenWorksCommonModel:Pick.native_uid.isCreatable" false,
                                                     UPDATABLE 'FALSE'),
  wellbore_native_uid          VARCHAR(1024) NOT NULL,
  pick_name                    VARCHAR(40)   NOT NULL DEFAULT 'UNKNOWN',
  pick_by                      VARCHAR(5)    NOT NULL,
  pick_obs_no                  INTEGER       NOT NULL DEFAULT '1',
  platform_native_uid          VARCHAR(1024),
  platform_code                VARCHAR(20)   OPTIONS("OpenWorksCommonModel:Pick.platform_code.isUpdatable" false, 
                                                 "OpenWorksCommonModel:Pick.platform_code.isCreatable" false, 
                                                 UPDATABLE 'FALSE'),
  wellbore_uwi                 VARCHAR(26)   OPTIONS ("OpenWorksCommonModel:Pick.wellbore_uwi.isUpdatable" false,
                                                      "OpenWorksCommonModel:Pick.wellbore_uwi.isCreatable" false,
                                                      UPDATABLE 'FALSE'),

  pick_depth                   FLOAT         OPTIONS ("OpenWorksCommonModel:Pick.pick_depth.unitField" 'pick_depth_unit'),
  pick_depth_unit              VARCHAR(64)   OPTIONS ("OpenWorksCommonModel:Pick.pick_depth_unit.unitType" 'depth measure'),
  min_depth                    FLOAT         OPTIONS ("OpenWorksCommonModel:Pick.min_depth.unitField" 'min_depth_unit'),
  min_depth_unit               VARCHAR(64)   OPTIONS ("OpenWorksCommonModel:Pick.min_depth_unit.unitType" 'depth measure'),
  max_depth                    FLOAT         OPTIONS ("OpenWorksCommonModel:Pick.max_depth.unitField" 'max_depth_unit'),
  max_depth_unit               VARCHAR(64)   OPTIONS ("OpenWorksCommonModel:Pick.max_depth_unit.unitType" 'depth measure'),
  geologic_feature             VARCHAR(4000) DEFAULT 'UNKNOWN',
  pick_date                    TIMESTAMP,
  alias                        VARCHAR(40)   OPTIONS ("OpenWorksCommonModel:Pick.alias.isUpdatable" false,
                                                      "OpenWorksCommonModel:Pick.alias.isCreatable" false,
                                                      UPDATABLE 'FALSE'),
  pick_kind                    VARCHAR(40),
  pick_qualifier               VARCHAR(3),
  pick_confidence_factor       VARCHAR(1),
  pick_correlation_confidence  VARCHAR(1),
  pick_source                  VARCHAR(15),
  dip_angle                    FLOAT         OPTIONS ("OpenWorksCommonModel:Pick.dip_angle.unitField" 'dip_angle_unit'),
  dip_angle_unit               VARCHAR(64)   OPTIONS ("OpenWorksCommonModel:Pick.dip_angle_unit.unitType" 'angular distance'),
  dip_azimuth                  FLOAT         OPTIONS ("OpenWorksCommonModel:Pick.dip_azimuth.unitField" 'dip_azimuth_unit'),
  dip_azimuth_unit             VARCHAR(64)   OPTIONS ("OpenWorksCommonModel:Pick.dip_azimuth_unit.unitType" 'angular distance'),
  time_dist_flag               VARCHAR(1),
  user_def_1                   VARCHAR(24),
  user_def_2                   VARCHAR(24),
  user_def_3                   VARCHAR(24),
  user_def_4                   VARCHAR(24),
  user_def_5                   VARCHAR(24),
  user_def_num_1               FLOAT,
  user_def_num_2               FLOAT,
  user_def_num_3               FLOAT,
  original_data_source         VARCHAR(5),
  remark                       VARCHAR(200),
  create_date                  TIMESTAMP     OPTIONS ("OpenWorksCommonModel:Pick.create_date.isUpdatable" false,
                                                      "OpenWorksCommonModel:Pick.create_date.isCreatable" false,
                                                      UPDATABLE 'FALSE'),
  create_user_id               VARCHAR(32)   OPTIONS ("OpenWorksCommonModel:Pick.create_user_id.isUpdatable" false,
                                                      "OpenWorksCommonModel:Pick.create_user_id.isCreatable" false,
                                                      UPDATABLE 'FALSE'),
  update_date                  TIMESTAMP     OPTIONS ("OpenWorksCommonModel:Pick.update_date.isUpdatable" false,
                                                      "OpenWorksCommonModel:Pick.update_date.isCreatable" false,
                                                      UPDATABLE 'FALSE'),
  update_user_id               VARCHAR(32)   OPTIONS ("OpenWorksCommonModel:Pick.update_user_id.isUpdatable" false,
                                                      "OpenWorksCommonModel:Pick.update_user_id.isCreatable" false,
                                                      UPDATABLE 'FALSE'),
  alternate_uid    		           VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:Pick.alternate_uid.isCreatable" false,
                                                      "OpenWorksCommonModel:Pick.alternate_uid.isUpdatable" false,
                                                      UPDATABLE 'FALSE'),


 CONSTRAINT Pick_PK PRIMARY KEY (native_uid),

    CONSTRAINT Pick_UK1 UNIQUE (wellbore_native_uid,pick_name, pick_by, pick_obs_no),

    CONSTRAINT FK_Pick_wellbore_native_uid
        FOREIGN KEY (wellbore_native_uid)
        REFERENCES Wellbore(native_uid),

    CONSTRAINT FK_Pick_pick_name
        FOREIGN KEY (pick_name)
        REFERENCES RefPickSurfaceName(pick_surf_name),

    CONSTRAINT FK_Pick_pick_by
        FOREIGN KEY (pick_by)
        REFERENCES DataSource(name),

    CONSTRAINT FK_Pick_original_data_source
        FOREIGN KEY (original_data_source)
        REFERENCES DataSource(name),

    CONSTRAINT FK_Pick_platform_native_uid
       FOREIGN KEY(platform_native_uid)
       REFERENCES Platform(native_uid)


)
OPTIONS (UPDATABLE 'TRUE',Pick.IMPLEMENTED 'TRUE')
AS
 SELECT
 OpenWorks_SM.Pick.native_uid AS native_uid,
 OpenWorks_SM.WellEntire.wellid AS wellbore_native_uid,
 pick_name,
 pick_by,
 pick_obs_no,
 CONVERT(OpenWorks_SM.PlatformInfo.platform_code,VARCHAR(1024)),
 OpenWorks_SM.WellLocation.platform_code,
 uwi AS wellbore_uwi,
 pick_depth,
 pick_depth_dsdsunit AS pick_depth_unit,
 min_depth,
 min_depth_dsdsunit AS min_depth_unit,
 max_depth,
 max_depth_dsdsunit AS max_depth_unit,
 geologic_feature,
 pick_date,
 alias,
 pick_kind,
 pick_qual AS pick_qualifier,
  DECODESTRING(pick_conf_fact,'E:Excellent:G:Good:F:Fair:P:Poor:null:None',':') AS pick_confidence_factor,
 pick_corr_conf AS pick_correlation_confidence,
 pick_source,
 dip_angle,
 dip_angle_dsdsunit AS dip_angle_unit,
 dip_azimuth,
 dip_azimuth_dsdsunit AS dip_azimuth_unit,
 time_dist_flag,
 user_def_1,
 user_def_2,
 user_def_3,
 user_def_4,
 user_def_5,
 user_def_num_1,
 user_def_num_2,
 user_def_num_3,
 original_data_source,
 OpenWorks_SM.Pick.remark,
 OpenWorks_SM.Pick.create_date,
 OpenWorks_SM.Pick.create_user_id,
 OpenWorks_SM.Pick.update_date,
 OpenWorks_SM.Pick.update_user_id,
 OpenWorks_SM.Pick.native_uid AS alternate_uid
    FROM
         OpenWorks_SM.Pick 
		 INNER JOIN OpenWorks_SM.WellEntire
		 on OpenWorks_SM.Pick.wellid = OpenWorks_SM.WellEntire.wellid
		 LEFT OUTER JOIN OpenWorks_SM.WellLocation
		 on OpenWorks_SM.WellEntire.well_location_id = OpenWorks_SM.WellLocation.well_location_id
		 LEFT OUTER JOIN OpenWorks_SM.PlatformInfo
		 on OpenWorks_SM.WellLocation.platform_code=OpenWorks_SM.PlatformInfo.platform_code;


Create Trigger on Pick INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC

    DECLARE string VARIABLES.MSG_NO_WELLBORE=CONCAT (CONCAT('ERROR: The given wellbore_native_uid "',"NEW".wellbore_native_uid),'" does not exist in OpenWorks');
    DECLARE string VARIABLES.wellid = "NEW".wellbore_native_uid;

    IF(VARIABLES.wellid IS NULL)
    BEGIN
        ERROR VARIABLES.MSG_NO_WELLBORE;
    END

    INSERT INTO OpenWorks_SM.Pick (OpenWorks_SM.Pick.wellid, OpenWorks_SM.Pick.pick_name, OpenWorks_SM.Pick.pick_by, OpenWorks_SM.Pick.pick_obs_no, OpenWorks_SM.Pick.pick_depth, OpenWorks_SM.Pick.min_depth, OpenWorks_SM.Pick.max_depth, OpenWorks_SM.Pick.geologic_feature,       OpenWorks_SM.Pick.pick_date, OpenWorks_SM.Pick.pick_kind,       OpenWorks_SM.Pick.pick_qual,           OpenWorks_SM.Pick.pick_conf_fact,                                                            OpenWorks_SM.Pick.pick_corr_conf,                   OpenWorks_SM.Pick.pick_source,       OpenWorks_SM.Pick.dip_angle, OpenWorks_SM.Pick.dip_azimuth, OpenWorks_SM.Pick.time_dist_flag,      OpenWorks_SM.Pick.user_def_1,       OpenWorks_SM.Pick.user_def_2,       OpenWorks_SM.Pick.user_def_3,       OpenWorks_SM.Pick.user_def_4,       OpenWorks_SM.Pick.user_def_5,       OpenWorks_SM.Pick.user_def_num_1, OpenWorks_SM.Pick.user_def_num_2, OpenWorks_SM.Pick.user_def_num_3, OpenWorks_SM.Pick.pick_depth_dsdsunit, OpenWorks_SM.Pick.min_depth_dsdsunit, OpenWorks_SM.Pick.max_depth_dsdsunit, OpenWorks_SM.Pick.dip_angle_dsdsunit, OpenWorks_SM.Pick.dip_azimuth_dsdsunit, OpenWorks_SM.Pick.remark,        OpenWorks_SM.Pick.original_data_source)
                           VALUES (VARIABLES.wellid,         "NEW".pick_name,             "NEW".pick_by,             "NEW".pick_obs_no,             "NEW".pick_depth,             "NEW".min_depth,             "NEW".max_depth,             SUBSTRING("NEW".geologic_feature, 1, 40), "NEW".pick_date,             SUBSTRING("NEW".pick_kind, 1, 40), SUBSTRING("NEW".pick_qualifier, 1, 3), DECODESTRING("NEW".pick_confidence_factor,'Excellent:E:Good:G:Fair:F:Poor:P:None:null',':'), SUBSTRING("NEW".pick_correlation_confidence, 1, 1), SUBSTRING("NEW".pick_source, 1, 15), "NEW".dip_angle,             "NEW".dip_azimuth,             SUBSTRING("NEW".time_dist_flag, 1, 1), SUBSTRING("NEW".user_def_1, 1, 24), SUBSTRING("NEW".user_def_2, 1, 24), SUBSTRING("NEW".user_def_3, 1, 24), SUBSTRING("NEW".user_def_4, 1, 24), SUBSTRING("NEW".user_def_5, 1, 24), "NEW".user_def_num_1,             "NEW".user_def_num_2,             "NEW".user_def_num_3,             "NEW".pick_depth_unit,                 "NEW".min_depth_unit,                 "NEW".max_depth_unit,                 "NEW".dip_angle_unit,                 "NEW".dip_azimuth_unit,                 SUBSTRING("NEW".remark, 1, 200), SUBSTRING("NEW".original_data_source, 1, 5));
END;


Create Trigger on Pick INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC
DECLARE string VARIABLES.pick_conf_fact=DECODESTRING("NEW".pick_confidence_factor,'Excellent:E:Good:G:Fair:F:Poor:P:None:null',':');
    DECLARE string VARIABLES.wellid = "OLD".wellbore_native_uid;
    UPDATE OpenWorks_SM.Pick SET pick_depth = "NEW".pick_depth, min_depth = "NEW".min_depth, max_depth = "NEW".max_depth, geologic_feature = SUBSTRING(NVL("NEW".geologic_feature, 'UNKNOWN'), 1, 40), pick_date = "NEW".pick_date, pick_kind = SUBSTRING("NEW".pick_kind, 1, 40), pick_qual = SUBSTRING("NEW".pick_qualifier, 1, 3), pick_conf_fact = VARIABLES.pick_conf_fact, pick_corr_conf = SUBSTRING("NEW".pick_correlation_confidence, 1, 1), pick_source = SUBSTRING("NEW".pick_source, 1, 15), dip_angle = "NEW".dip_angle, dip_azimuth = "NEW".dip_azimuth, time_dist_flag = SUBSTRING("NEW".time_dist_flag, 1, 1),  user_def_1 = SUBSTRING("NEW".user_def_1, 1, 24), user_def_2 = SUBSTRING("NEW".user_def_2, 1, 24), user_def_3 = SUBSTRING("NEW".user_def_3, 1, 24), user_def_4 = SUBSTRING("NEW".user_def_4, 1, 24), user_def_5 = SUBSTRING("NEW".user_def_5, 1, 24), user_def_num_1 = "NEW".user_def_num_1, user_def_num_2 = "NEW".user_def_num_2, user_def_num_3 = "NEW".user_def_num_3, pick_depth_dsdsunit = "NEW".pick_depth_unit, min_depth_dsdsunit = "NEW".min_depth_unit, max_depth_dsdsunit = "NEW".max_depth_unit, dip_angle_dsdsunit = "NEW".dip_angle_unit, dip_azimuth_dsdsunit = "NEW".dip_azimuth_unit, remark = SUBSTRING("NEW".remark, 1, 200), original_data_source = SUBSTRING("NEW".original_data_source, 1, 5) WHERE OpenWorks_SM.Pick.native_uid = "OLD".native_uid;
END;

Create Trigger on Pick INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC
    DELETE FROM OpenWorks_SM.Pick WHERE native_uid = "OLD".native_uid;
END;

/*
**********************************
* "RefLoggingService"
**********************************
*/
CREATE VIEW RefLoggingService
(
  service_name               VARCHAR(60) NOT NULL,
  company                    VARCHAR(128),
  company_service_name       VARCHAR(60),
  data_source                VARCHAR(128),
  service_code               VARCHAR(24),
  service_name_alias         VARCHAR(60),
  service_description        VARCHAR(128),
  reference_value_source     VARCHAR(128),
  reference_value_status     VARCHAR(60),
  remark                     VARCHAR(200),
  create_date                TIMESTAMP,
  create_user_id             VARCHAR(32),
  update_date                TIMESTAMP,
  update_user_id             VARCHAR(32),

    CONSTRAINT RefLoggingService_PK PRIMARY KEY (service_name),

    CONSTRAINT FK_RefLoggingService_data_source
        FOREIGN KEY (data_source)
        REFERENCES DataSource(name),

    CONSTRAINT FK_RefLoggingService_company
        FOREIGN KEY (company)
        REFERENCES Company(company_name)

)
OPTIONS (UPDATABLE 'TRUE',RefLoggingService.IMPLEMENTED 'TRUE')
    AS
    SELECT
        service_name AS service_name,
        company AS company,
        company_service_name AS company_service_name,
        data_source AS data_source,
        service_code AS service_code,
        service_name_alias AS service_name_alias,
        service_desc AS service_description,
        ref_value_source AS reference_value_source,
        ref_value_status AS reference_value_status,
        remark AS remark,
        create_date AS create_date,
        create_user_id AS create_user_id,
        update_date AS update_date,
        update_user_id AS update_user_id

        FROM OpenWorks_SM.RLoggingService;

CREATE TRIGGER ON RefLoggingService INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC
DECLARE integer VARIABLES.log_service_id = (SELECT * FROM (EXEC OpenWorks_SM.nextval('RLoggingService')) AS SysGenID);
INSERT into OpenWorks_SM.RLoggingService(service_name,       log_service_id,            company,      company_service_name,       data_source,       service_code,       service_name_alias,       service_desc,              ref_value_source,             ref_value_status,             remark)
                                 values ("NEW".service_name, VARIABLES.log_service_id, "NEW".company, "NEW".company_service_name, "NEW".data_source, "NEW".service_code, "NEW".service_name_alias, "NEW".service_description, "NEW".reference_value_source, "NEW".reference_value_status, "NEW".remark);


END;

CREATE TRIGGER ON RefLoggingService INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC

UPDATE OpenWorks_SM.RLoggingService set service_name="NEW".service_name,company="NEW".company,company_service_name="NEW".company_service_name,data_source="NEW".data_source,service_code="NEW".service_code,service_name_alias="NEW".service_name_alias,service_desc="NEW".service_description,ref_value_source="NEW".reference_value_source,ref_value_status="NEW".reference_value_status,remark="NEW".remark
where service_name="OLD".service_name;

END;


CREATE TRIGGER ON RefLoggingService INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC

DELETE from OpenWorks_SM.RLoggingService where service_name="OLD".service_name;
END;


/*
**********************************
*     "WellLog"
**********************************
*/

CREATE VIEW WellLog
(
  native_uid                 VARCHAR(1024) AUTO_INCREMENT
                                           OPTIONS ("OpenWorksCommonModel:WellLog.native_uid.isUpdatable" false,
                                                    "OpenWorksCommonModel:WellLog.native_uid.isCreatable" false,
                                                    UPDATABLE 'FALSE'),
  wellbore_native_uid        VARCHAR(1024) NOT NULL,
  log_name                   VARCHAR(30)   NOT NULL,
  log_run_no                 INTEGER NOT   NULL,
  log_pass_id                VARCHAR(4)    NOT NULL,
  log_version                INTEGER       OPTIONS ("OpenWorksCommonModel:WellLog.log_version.isImplemented" false,
                                                    UPDATABLE 'FALSE'),
  wellbore_uwi               VARCHAR(26)   OPTIONS ("OpenWorksCommonModel:WellLog.wellbore_uwi.isUpdatable" false,
                                                    "OpenWorksCommonModel:WellLog.wellbore_uwi.isCreatable" false,
                                                    UPDATABLE 'FALSE'),
  logging_job_no             INTEGER       DEFAULT '1',
  log_description            VARCHAR(255)  OPTIONS("OpenWorksCommonModel:WellLog.log_description.isImplemented" false,
                                                                                    UPDATABLE 'FALSE'),
  logging_company            VARCHAR(41),
  log_elevation_reference    VARCHAR(2),
  drillers_reference         VARCHAR(2),
  log_elevation              FLOAT         OPTIONS ("OpenWorksCommonModel:WellLog.log_elevation.unitField" 'log_elevation_unit'),
  log_elevation_unit          VARCHAR(64)  OPTIONS ("OpenWorksCommonModel:WellLog.log_elevation_unit.unitType" 'elevation'),
  acquisition_run_no         VARCHAR(12),
  log_run_date               DATE,
  log_on_bot_time            DATE,
  max_rec_temp               FLOAT         OPTIONS ("OpenWorksCommonModel:WellLog.max_rec_temp.unitField" 'max_rec_temp_unit'),
  max_rec_temp_unit          VARCHAR(64)   OPTIONS ("OpenWorksCommonModel:WellLog.max_rec_temp_unit.unitType" 'temperature'),
  data_source                VARCHAR(5),

  total_cost                 FLOAT,
  currency                   VARCHAR(24),
  log_pass_type              VARCHAR(24),
  index_min                  FLOAT         OPTIONS ("OpenWorksCommonModel:WellLog.index_min.unitField" 'index_min_unit'),
  index_min_unit             VARCHAR(64)   OPTIONS ("OpenWorksCommonModel:WellLog.index_min_unit.unitType" 'time depth measure'),
  index_max                  FLOAT         OPTIONS ("OpenWorksCommonModel:WellLog.index_max.unitField" 'index_max_unit'),
  index_max_unit             VARCHAR(64)   OPTIONS ("OpenWorksCommonModel:WellLog.index_max_unit.unitType" 'time depth measure'),
  index_type                 VARCHAR(64),
  pass_start_time            DATE,
  pass_stop_time             DATE,
  pass_direction             VARCHAR(2),
  log_speed                  FLOAT         OPTIONS ("OpenWorksCommonModel:WellLog.log_speed.unitField" 'log_speed_unit'),
  log_speed_unit             VARCHAR(64)   OPTIONS ("OpenWorksCommonModel:WellLog.log_speed_unit.unitType" 'velocity logging'),
  measurement_density        FLOAT         OPTIONS ("OpenWorksCommonModel:WellLog.measurement_density.unitField" 'measurement_density_unit'),
  measurement_density_unit   VARCHAR(64)   OPTIONS ("OpenWorksCommonModel:WellLog.measurement_density_unit.unitType" 'per length'),
  remark                     VARCHAR(200),
  data                         BLOB        OPTIONS (  "OpenWorksCommonModel:WellLog.data.isMedia" 'true',
                                                      "OpenWorksCommonModel:WellLog.data.mediaContentType" 'application/octet-stream',
                                "OpenWorksCommonModel:WellLog.data.elementStruct"      '[{"name":"depths","type":"double[]"}, {"name":"values","type":"float[]"}]',
                                                      "OpenWorksCommonModel:WellLog.data.elementMetadata"  '[{"name":"depths", "unitField":"index_unit"}, {"name":"values", "unitField":"curve_unit"}]'),
  create_date                TIMESTAMP,
  create_user_id             VARCHAR(32),
  update_date                TIMESTAMP,
  update_user_id             VARCHAR(32),
  alternate_uid    		         VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:WellLog.alternate_uid.isCreatable" false,
                                                    "OpenWorksCommonModel:WellLog.alternate_uid.isUpdatable" false,
                                                     UPDATABLE 'FALSE'),



    CONSTRAINT WellLog_PK PRIMARY KEY (native_uid),

    CONSTRAINT WellLog_UK1 UNIQUE (wellbore_native_uid, log_name, log_run_no, log_pass_id),

    CONSTRAINT FK_WellLog_wellbore_native_uid
        FOREIGN KEY (wellbore_native_uid)
        REFERENCES Wellbore(native_uid),

    CONSTRAINT FK_WellLog_log_name
        FOREIGN KEY (log_name)
        REFERENCES RefLoggingService(service_name),

    CONSTRAINT FK_WellLog_data_source
        FOREIGN KEY (data_source)
        REFERENCES DataSource(name)

)
OPTIONS (UPDATABLE 'TRUE',WellLog.IMPLEMENTED 'TRUE')
  As
SELECT
 LoggingToolPass.native_uid AS native_uid,
 OpenWorks_SM.LoggingToolStringDescent.wellid AS wellbore_native_uid,
 OpenWorks_SM.LoggingToolPass.log_name AS log_name,
 cast(OpenWorks_SM.LoggingToolPass.log_run_no AS integer),
 log_pass_id AS log_pass_id,
 null,
 uwi AS wellbore_uwi,
 OpenWorks_SM.LoggingJob.logging_job_no,
 null AS log_description,
 OpenWorks_SM.LoggingJob.company AS logging_company,
 OpenWorks_SM.LoggingJob.datum_type as log_elevation_reference,
 OpenWorks_SM.LoggingJob.drillers_datum_type as drillers_reference,
 OpenWorks_SM.LoggingJob.elevation as log_elevation,
 OpenWorks_SM.LoggingJob.elevation_dsdsunit as log_elevation_unit,
 acquisition_run_no,
 convert(log_run_date, date) AS log_run_date,
 convert(log_on_bot_time, date) AS log_on_bot_time,
 max_rec_temp,
 max_rec_temp_dsdsunit AS max_rec_temp_unit,
 OpenWorks_SM.LoggingToolStringDescent.data_source AS data_source,
 OpenWorks_SM.LoggingToolStringDescent.total_cost,
 OpenWorks_SM.LoggingToolStringDescent.currency AS currency,
 log_pass_type,
 OpenWorks_SM.LoggingToolPass.top_depth AS index_min,
 OpenWorks_SM.LoggingToolPass.top_depth_dsdsunit AS index_min_unit,
 OpenWorks_SM.LoggingToolPass.base_depth AS index_max,
 OpenWorks_SM.LoggingToolPass.base_depth_dsdsunit AS index_max_unit,
 'DEPTH' AS index_type,
 convert(pass_start_time, date) AS pass_start_time,
 convert(pass_stop_time, date) AS pass_stop_time,
 pass_direction,
 log_speed,
 log_speed_dsdsunit AS log_speed_unit,
 measurement_density,
 measurement_density_dsdsunit AS measurement_density_unit,
 OpenWorks_SM.LoggingToolPass.remark AS remark,
 OpenWorks_SM.LoggingToolPass.data AS data,
 OpenWorks_SM.LoggingToolPass.create_date AS create_date,
 OpenWorks_SM.LoggingToolPass.create_user_id AS create_user_id,
 OpenWorks_SM.LoggingToolPass.update_date AS update_date,
 OpenWorks_SM.LoggingToolPass.update_user_id AS update_user_id,
 LoggingToolPass.native_uid AS alternate_uid
FROM
 OpenWorks_SM.LoggingToolPass, /*+ optional */
 OpenWorks_SM.LoggingToolStringDescent     LEFT OUTER JOIN /*+ optional */ Openworks_SM.LoggingJob ON  OpenWorks_SM.LoggingToolStringDescent.logging_job_no = Openworks_SM.LoggingJob.logging_job_no and OpenWorks_SM.LoggingToolStringDescent.wellid = Openworks_SM.LoggingJob.wellid,
 /*+ optional */ OpenWorks_SM.WellEntire
WHERE
(OpenWorks_SM.LoggingToolPass.wellid = OpenWorks_SM.LoggingToolStringDescent.wellid) AND (OpenWorks_SM.LoggingToolPass.log_run_no = OpenWorks_SM.LoggingToolStringDescent.log_run_no) AND (OpenWorks_SM.LoggingToolPass.log_name = OpenWorks_SM.LoggingToolStringDescent.log_name) AND (OpenWorks_SM.LoggingToolStringDescent.wellid = OpenWorks_SM.WellEntire.wellid);



Create Trigger on WellLog INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC

  DECLARE string VARIABLES.MSG_NO_WELLBORE='ERROR: The given wellbore_native_uid "' || "NEW".wellbore_native_uid ||'" does not exist in OpenWorks';
  DECLARE string VARIABLES.logelevlength_errorMsg='ERROR: The length of the log_elevation_reference "' ||"NEW".log_elevation_reference || '" cannot be more than 2 characters. Possible values or KB/GL/DF/RT etc';
  DECLARE string VARIABLES.drillelevlength_errorMsg='ERROR: The length of the drillers_reference "' ||"NEW".drillers_reference || '" cannot be more than 2 characters. Possible values or KB/GL/DF/RT etc';


  IF(LENGTH("NEW".log_elevation_reference) > 2)
  BEGIN
    ERROR VARIABLES.logelevlength_errorMsg;
  END

  IF(LENGTH("NEW".drillers_reference) > 2)
  BEGIN
      ERROR VARIABLES.drillelevlength_errorMsg;
  END

  DECLARE string VARIABLES.wellid = "NEW".wellbore_native_uid;

  IF(VARIABLES.wellid IS NULL)
  BEGIN
      ERROR VARIABLES.MSG_NO_WELLBORE;
  END

  DECLARE string VARIABLES.index_min_unit = "NEW".index_min_unit;
  IF(VARIABLES.index_min_unit IS NOT NULL)
  BEGIN
      IF(UPPER(VARIABLES.index_min_unit) = 'F' )
      BEGIN
          VARIABLES.index_min_unit = 'feet';
      END
  END

  DECLARE string VARIABLES.index_max_unit = "NEW".index_max_unit;
  IF(VARIABLES.index_max_unit IS NOT NULL)
  BEGIN
      IF(UPPER(VARIABLES.index_max_unit) = 'F' )
      BEGIN
          VARIABLES.index_max_unit = 'feet';
      END
  END


  DECLARE integer VARIABLES.loggingjobno = (SELECT logging_job_no FROM OpenWorks_SM.LoggingJob WHERE wellid = VARIABLES.wellid and logging_job_no = "NEW".logging_job_no);
  IF ((VARIABLES.loggingjobno IS NULL) AND ("NEW".logging_job_no IS NOT NULL))
  BEGIN
    INSERT INTO OpenWorks_SM.LoggingJob (wellid, logging_job_no,       datum_type,                    drillers_datum_type,      elevation,            elevation_dsdsunit,      data_source,                        currency,                         remark)
                                 VALUES (wellid, "NEW".logging_job_no, "NEW".log_elevation_reference, "NEW".drillers_reference, "NEW".log_elevation, "NEW".log_elevation_unit, SUBSTRING("NEW".data_source, 1, 5), SUBSTRING("NEW".currency, 1, 24), SUBSTRING("NEW".remark, 1, 200));
  END
  ELSE
  BEGIN
    IF("NEW".logging_job_no IS NOT NULL)
    BEGIN
      UPDATE OpenWorks_SM.LoggingJob set datum_type = "NEW".log_elevation_reference, drillers_datum_type = "NEW".drillers_reference, elevation = "NEW".log_elevation, elevation_dsdsunit = "NEW".log_elevation_unit, data_source = SUBSTRING("NEW".data_source, 1, 5), remark = SUBSTRING("NEW".remark, 1, 200) where  wellid = VARIABLES.wellid  and logging_job_no = "NEW".logging_job_no;
    END
  END


  DECLARE integer VARIABLES.runCount = (select count(1) from OpenWorks_SM.LoggingToolStringDescent where wellid = VARIABLES.wellid AND log_name = "new".log_name AND log_run_no = "new".log_run_no);

  IF(VARIABLES.runCount < 1)
  BEGIN
    INSERT INTO OpenWorks_SM.LoggingToolStringDescent (wellid, log_run_no,       log_name,                         logging_job_no,       acquisition_run_no,                         top_depth,       top_depth_dsdsunit,                         base_depth,       base_depth_dsdsunit,                     log_run_date,       log_on_bot_time,       max_rec_temp,       max_rec_temp_dsdsunit,                      data_source,                       total_cost,       currency,                                       remark)
                                               VALUES (wellid, "NEW".log_run_no, SUBSTRING("NEW".log_name, 1, 30), "NEW".logging_job_no, SUBSTRING("NEW".acquisition_run_no, 1, 12), "NEW".index_min, SUBSTRING(VARIABLES.index_min_unit, 1, 64), "NEW".index_max, SUBSTRING(VARIABLES.index_max_unit, 1, 64), "NEW".log_run_date, "NEW".log_on_bot_time, "NEW".max_rec_temp, SUBSTRING("NEW".max_rec_temp_unit, 1, 64), SUBSTRING("NEW".data_source, 1, 5), "NEW".total_cost, SUBSTRING(NVL("NEW".currency,'UNKNOWN'),1, 24), SUBSTRING("NEW".remark, 1, 200));
  END
  ELSE
  BEGIN
    UPDATE OpenWorks_SM.LoggingToolStringDescent SET logging_job_no = "NEW".logging_job_no, acquisition_run_no = SUBSTRING("NEW".acquisition_run_no, 1, 12), log_run_date = "NEW".log_run_date, log_on_bot_time = "NEW".log_on_bot_time, max_rec_temp = "NEW".max_rec_temp, max_rec_temp_dsdsunit = SUBSTRING("NEW".max_rec_temp_unit, 1, 64), data_source = SUBSTRING("NEW".data_source, 1, 5), total_cost = "NEW".total_cost, currency = SUBSTRING(NVL("NEW".currency,'UNKNOWN'),1, 24), top_depth = "NEW".index_min, base_depth = "NEW".index_max, top_depth_dsdsunit = SUBSTRING(VARIABLES.index_min_unit, 1, 64), base_depth_dsdsunit = SUBSTRING(VARIABLES.index_max_unit, 1, 64), remark = SUBSTRING("NEW".remark, 1, 200) WHERE (wellid = VARIABLES.wellid) AND (log_name = "new".log_name) AND (log_run_no = "new".log_run_no);
  END

  INSERT INTO OpenWorks_SM.LoggingToolPass (wellid, log_run_no,       log_name,                         log_pass_id,                        log_pass_type,                         top_depth,       top_depth_dsdsunit,                         base_depth,       base_depth_dsdsunit,                    pass_start_time,       pass_stop_time,       pass_direction,                         log_speed,       log_speed_dsdsunit,                    measurement_density,       measurement_density_dsdsunit,                      remark, data)
                                    VALUES (wellid, "NEW".log_run_no, SUBSTRING("NEW".log_name, 1, 30), SUBSTRING("NEW".log_pass_id, 1, 4), SUBSTRING("NEW".log_pass_type, 1, 24), "NEW".index_min, SUBSTRING(VARIABLES.index_min_unit, 1, 64), "NEW".index_max, SUBSTRING(VARIABLES.index_max_unit, 1, 64), "NEW".pass_start_time, "NEW".pass_stop_time, SUBSTRING("NEW".pass_direction, 1, 2), "NEW".log_speed, SUBSTRING("NEW".log_speed_unit, 1, 64), "NEW".measurement_density, SUBSTRING("NEW".measurement_density_unit, 1, 64), SUBSTRING("NEW".remark, 1, 200), "NEW".data);
END;

Create Trigger on WellLog INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC

  DECLARE string VARIABLES.logelevlength_errorMsg='ERROR: The length of the log_elevation_reference "' ||"NEW".log_elevation_reference || '" cannot be more than 2 characters. Possible values or KB/GL/DF/RT etc';
  DECLARE string VARIABLES.drillelevlength_errorMsg='ERROR: The length of the drillers_reference "' ||"NEW".drillers_reference || '" cannot be more than 2 characters. Possible values or KB/GL/DF/RT etc';

  IF(LENGTH("NEW".log_elevation_reference) > 2)
  BEGIN
    ERROR VARIABLES.logelevlength_errorMsg;
  END

  IF(LENGTH("NEW".drillers_reference) > 2)
  BEGIN
      ERROR VARIABLES.drillelevlength_errorMsg;
  END

  DECLARE string VARIABLES.wellid = "OLD".wellbore_native_uid;

  DECLARE integer VARIABLES.loggingjobno = (SELECT logging_job_no FROM OpenWorks_SM.LoggingJob WHERE wellid = VARIABLES.wellid  and logging_job_no = "NEW".logging_job_no);

  DECLARE string VARIABLES.index_min_unit = "NEW".index_min_unit;
  IF(VARIABLES.index_min_unit IS NOT NULL)
  BEGIN
      IF(UPPER(VARIABLES.index_min_unit) = 'F' )
      BEGIN
          VARIABLES.index_min_unit = 'feet';
      END
  END

  DECLARE string VARIABLES.index_max_unit = "NEW".index_max_unit;
  IF(VARIABLES.index_max_unit IS NOT NULL)
  BEGIN
      IF(UPPER(VARIABLES.index_max_unit) = 'F' )
      BEGIN
          VARIABLES.index_max_unit = 'feet';
      END
  END

 IF ((VARIABLES.loggingjobno IS NULL) AND ("NEW".logging_job_no IS NOT NULL))
  BEGIN
    INSERT INTO OpenWorks_SM.LoggingJob (wellid, logging_job_no,       datum_type,                    drillers_datum_type,      elevation,           elevation_dsdsunit,       data_source,                         currency,                         remark)
                                 VALUES (wellid, "NEW".logging_job_no, "NEW".log_elevation_reference, "NEW".drillers_reference, "NEW".log_elevation, "NEW".log_elevation_unit, SUBSTRING("NEW".data_source, 1, 5), SUBSTRING("NEW".currency, 1, 24), SUBSTRING("NEW".remark, 1, 200));
  END
  ELSE
   BEGIN
     IF("NEW".logging_job_no IS NOT NULL)
    BEGIN
      UPDATE OpenWorks_SM.LoggingJob set datum_type = "NEW".log_elevation_reference, drillers_datum_type = "NEW".drillers_reference, elevation = "NEW".log_elevation, elevation_dsdsunit = "NEW".log_elevation_unit, data_source = SUBSTRING("NEW".data_source, 1, 5), remark = SUBSTRING("NEW".remark, 1, 200) where  wellid = VARIABLES.wellid  and logging_job_no = "NEW".logging_job_no;
    END
  END

  BEGIN
    UPDATE OpenWorks_SM.LoggingToolPass SET log_pass_type = NVL(SUBSTRING("NEW".log_pass_type, 1, 24), 'UNKNOWN'), top_depth = "NEW".index_min, top_depth_dsdsunit = SUBSTRING(VARIABLES.index_min_unit, 1, 64), base_depth = "NEW".index_max, base_depth_dsdsunit = SUBSTRING(VARIABLES.index_max_unit, 1, 64), pass_start_time = "NEW".pass_start_time, pass_stop_time = "NEW".pass_stop_time, pass_direction = SUBSTRING("NEW".pass_direction, 1, 2), log_speed = "NEW".log_speed, log_speed_dsdsunit = SUBSTRING("NEW".log_speed_unit, 1, 64), measurement_density = "NEW".measurement_density, measurement_density_dsdsunit = SUBSTRING("NEW".measurement_density_unit, 1, 64), remark = SUBSTRING("NEW".remark, 1, 200), data = "NEW".data WHERE (wellid = VARIABLES.wellid) AND (log_name = "OLD".log_name) AND (log_run_no = "OLD".log_run_no) AND (log_pass_id = "OLD".log_pass_id);
    UPDATE OpenWorks_SM.LoggingToolStringDescent SET logging_job_no = "NEW".logging_job_no, acquisition_run_no = SUBSTRING("NEW".acquisition_run_no, 1, 12), log_run_date = "NEW".log_run_date, log_on_bot_time = "NEW".log_on_bot_time, max_rec_temp = "NEW".max_rec_temp, max_rec_temp_dsdsunit = SUBSTRING("NEW".max_rec_temp_unit, 1, 64), data_source = SUBSTRING("NEW".data_source, 1, 5), total_cost = "NEW".total_cost, currency = SUBSTRING(NVL("NEW".currency,'UNKNOWN'),1, 24), top_depth = "NEW".index_min, base_depth = "NEW".index_max, top_depth_dsdsunit = SUBSTRING(VARIABLES.index_min_unit, 1, 64), base_depth_dsdsunit = SUBSTRING(VARIABLES.index_max_unit, 1, 64), remark = SUBSTRING("NEW".remark, 1, 200) WHERE (wellid = VARIABLES.wellid) AND (log_name = "OLD".log_name) AND (log_run_no = "OLD".log_run_no);
  END
END;

Create Trigger on WellLog INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC
    DECLARE string VARIABLES.wellid;
    VARIABLES.wellid = "OLD".wellbore_native_uid;
    DELETE FROM OpenWorks_SM.LoggingToolPass WHERE (OpenWorks_SM.LoggingToolPass.wellid = VARIABLES.wellid) AND (OpenWorks_SM.LoggingToolPass.log_run_no = "OLD".log_run_no) AND (OpenWorks_SM.LoggingToolPass.log_name = "OLD".log_name) AND (OpenWorks_SM.LoggingToolPass.log_pass_id = "OLD".log_pass_id);
    IF("OLD".logging_job_no IS NOT NULL)
    BEGIN
        DELETE FROM OpenWorks_SM.LoggingToolStringDescent WHERE (OpenWorks_SM.LoggingToolStringDescent.wellid = VARIABLES.wellid) AND (OpenWorks_SM.LoggingToolStringDescent.log_run_no = "OLD".log_run_no) AND (OpenWorks_SM.LoggingToolStringDescent.log_name = "OLD".log_name) AND (OpenWorks_SM.LoggingToolStringDescent.logging_job_no = "OLD".logging_job_no);

        DECLARE integer VARIABLES.jobCount = select count(*) from OpenWorks_SM.LoggingToolStringDescent WHERE (OpenWorks_SM.LoggingToolStringDescent.wellid = VARIABLES.wellid) AND (OpenWorks_SM.LoggingToolStringDescent.logging_job_no = "OLD".logging_job_no);
        IF(VARIABLES.jobCount = 1)
        BEGIN
          DELETE FROM OpenWorks_SM.LoggingJob WHERE (OpenWorks_SM.LoggingJob.wellid = VARIABLES.wellid) AND (OpenWorks_SM.LoggingJob.logging_job_no = "OLD".logging_job_no);
        END
    END
    IF("OLD".logging_job_no IS NULL)
    BEGIN
        DELETE FROM OpenWorks_SM.LoggingToolStringDescent WHERE (OpenWorks_SM.LoggingToolStringDescent.wellid = VARIABLES.wellid) AND (OpenWorks_SM.LoggingToolStringDescent.log_run_no = "OLD".log_run_no) AND (OpenWorks_SM.LoggingToolStringDescent.log_name = "OLD".log_name) AND (OpenWorks_SM.LoggingToolStringDescent.logging_job_no IS NULL);
    END
END;

/*
**********************************
*  "RefLogCurveName"
**********************************
*/
CREATE VIEW RefLogCurveName
(
    log_curve_name              VARCHAR(25) NOT NULL,
    unit_type                   VARCHAR(64),
    curve_type                  VARCHAR(25),
    api_code                    VARCHAR(12),
    reference_value_source      VARCHAR(40),
    reference_value_status      VARCHAR(20),
    remark                      VARCHAR(200),
    create_date                 TIMESTAMP,
    create_user_id              VARCHAR(32),
    update_date                 TIMESTAMP,
    update_user_id              VARCHAR(32),

    CONSTRAINT RefLogCurveName_PK PRIMARY KEY (log_curve_name)

)
    OPTIONS (UPDATABLE 'TRUE', RefLogCurveName.IMPLEMENTED 'TRUE')
    AS
    SELECT
        log_crv_name AS log_curve_name,
        unit_type_id AS unit_type,
        curve_type AS curve_type,
        api_code AS api_code,
        ref_value_source AS reference_value_source,
        ref_value_status AS reference_value_status,
        remark AS remark,
        create_date AS create_date,
        create_user_id AS create_user_id,
        update_date AS update_date,
        update_user_id AS update_user_id

        FROM Openworks_SM.VcLogCrvName;

CREATE TRIGGER ON RefLogCurveName INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC
DECLARE integer VARIABLES.log_crv_name_id = (SELECT * FROM (EXEC OpenWorks_SM.nextval('VcLogCrvName')) AS SysGenID);
INSERT into Openworks_SM.VcLogCrvName(log_crv_name,         log_crv_name_id,           unit_type_id,                   curve_type,       api_code,       ref_value_source,             ref_value_status,             remark)
                               values("NEW".log_curve_name, VARIABLES.log_crv_name_id, NVL("NEW".unit_type,'UNKNOWN'), "NEW".curve_type, "NEW".api_code, "NEW".reference_value_source, "NEW".reference_value_status, "NEW".remark);

END;

CREATE TRIGGER ON RefLogCurveName INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC

UPDATE Openworks_SM.VcLogCrvName set unit_type_id=NVL("NEW".unit_type,'UNKNOWN'),curve_type="NEW".curve_type,api_code="NEW".api_code,ref_value_source="NEW".reference_value_source,ref_value_status="NEW".reference_value_status,remark="NEW".remark where log_crv_name="OLD".log_curve_name;
END;


CREATE TRIGGER ON RefLogCurveName INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC
DELETE FROM Openworks_SM.VcLogCrvName where log_crv_name="OLD".log_curve_name;

END;


/*
**********************************
* ENTITY: LoggingParameter
**********************************
*/
CREATE VIEW LoggingParameter
(
	native_uid                 VARCHAR(1024)            AUTO_INCREMENT
                                                         OPTIONS("OpenWorksCommonModel:LoggingParameter.native_uid.isUpdatable" false,
                                                                "OpenWorksCommonModel:LoggingParameter.native_uid.isCreatable" false,
                                                                UPDATABLE 'FALSE'),
    welllog_native_uid         VARCHAR(1024) NOT NULL,
    parameter_name             VARCHAR(60)   NOT NULL,
    numeric_value              FLOAT                    OPTIONS("OpenWorksCommonModel:LoggingParameter.numeric_value.unitField" 'parameter_unit'),
    string_value               VARCHAR(60),
    parameter_unit             VARCHAR(60)              OPTIONS("OpenWorksCommonModel:LoggingParameter.parameter_unit.unitTypeAttribute" 'parameter_unit_type'),
    parameter_unit_type        VARCHAR(60),
    parameter_type             VARCHAR(60),
    data_source                VARCHAR(60),
    remark                     VARCHAR(4000),
    create_date                TIMESTAMP,
    create_user_id             VARCHAR(4000),
    update_date                TIMESTAMP,
    update_user_id             VARCHAR(4000),
    alternate_uid    		           VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:LoggingParameter.alternate_uid.isCreatable" false,
                                                      "OpenWorksCommonModel:LoggingParameter.alternate_uid.isUpdatable" false,
                                                      UPDATABLE 'FALSE'),


    CONSTRAINT LoggingParameter_PK PRIMARY KEY (native_uid),

    CONSTRAINT LoggingParameter_UK1 UNIQUE (welllog_native_uid, parameter_name),

    CONSTRAINT FK_LoggingParameter_welllog_native_uid
        FOREIGN KEY       (welllog_native_uid)
        REFERENCES WellLog(native_uid),

    CONSTRAINT FK_WellLog_data_source
        FOREIGN KEY          (data_source)
        REFERENCES DataSource(name)
)
OPTIONS (UPDATABLE 'TRUE', LoggingParameter.IMPLEMENTED 'TRUE')
    AS
    SELECT
        OpenWorks_SM.PetrophysicalParmValue.petro_parm_id AS native_uid,
        OpenWorks_SM.LoggingToolPass.native_uid AS welllog_native_uid,
        OpenWorks_SM.PetrophysicalParmValue.petro_parm_name AS parameter_name,
        OpenWorks_SM.PetrophysicalParmValue.numeric_value AS numeric_value,
        OpenWorks_SM.PetrophysicalParmValue.char_value AS string_value,
        OpenWorks_SM.PetrophysicalParmValue.numeric_value_dsdsunit AS parameter_unit,
        OpenWorks_SM.PetrophysicalParmValue.unit_type_id AS parameter_unit_type,
        null AS parameter_type,
        OpenWorks_SM.PetrophysicalParmValue.data_source AS data_source,
        OpenWorks_SM.PetrophysicalParmValue.remark AS remark,
        OpenWorks_SM.PetrophysicalParmValue.create_date AS create_date,
        OpenWorks_SM.PetrophysicalParmValue.create_user_id AS create_user_id,
        OpenWorks_SM.PetrophysicalParmValue.update_date AS update_date,
        OpenWorks_SM.PetrophysicalParmValue.update_user_id AS update_user_id,
		OpenWorks_SM.PetrophysicalParmValue.native_uid AS alternate_uid

    FROM OpenWorks_SM.PetrophysicalParmValue , OpenWorks_SM.LoggingToolPass where (OpenWorks_SM.LoggingToolPass.wellid=OpenWorks_SM.PetrophysicalParmValue.wellid)
         and (OpenWorks_SM.LoggingToolPass.log_run_no=OpenWorks_SM.PetrophysicalParmValue.log_run_no) and (OpenWorks_SM.LoggingToolPass.log_name=OpenWorks_SM.PetrophysicalParmValue.log_name)
         and (OpenWorks_SM.LoggingToolPass.log_pass_id=OpenWorks_SM.PetrophysicalParmValue.log_pass_id) and OpenWorks_SM.PetrophysicalParmValue.log_crv_name='UNKNOWN'
         and OpenWorks_SM.PetrophysicalParmValue.strat_unit_name='UNKNOWN' and OpenWorks_SM.PetrophysicalParmValue.column_name='UNKNOWN'
         and OpenWorks_SM.PetrophysicalParmValue.top_depth=0 and OpenWorks_SM.PetrophysicalParmValue.base_depth=0;

CREATE TRIGGER ON LoggingParameter INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC
    DECLARE string VARIABLES.wellid = getJSONElementValue("NEW".welllog_native_uid,'wellid');
    DECLARE integer VARIABLES.log_run_no = CONVERT(getJSONElementValue("NEW".welllog_native_uid,'log_run_no'),Integer);
    DECLARE string VARIABLES.log_name = getJSONElementValue("NEW".welllog_native_uid,'log_name');
    DECLARE string VARIABLES.log_pass_id = getJSONElementValue("NEW".welllog_native_uid,'log_pass_id');

    INSERT INTO OpenWorks_SM.PetrophysicalParmValue (petro_parm_name,      numeric_value,       char_value,         numeric_value_dsdsunit, data_source ,                        remark,                          wellid,           log_name,           log_run_no,            log_pass_id,          top_depth_dsdsunit, base_depth_dsdsunit)
                                             VALUES ("NEW".parameter_name, "NEW".numeric_value, "NEW".string_value, "NEW".parameter_unit,   SUBSTRING("NEW".data_source, 1, 5) , SUBSTRING("NEW".remark, 1, 200), VARIABLES.wellid, VARIABLES.log_name, VARIABLES.log_run_no, VARIABLES.log_pass_id, 'feet',             'feet');
END;

CREATE TRIGGER ON LoggingParameter INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC
    DECLARE string VARIABLES.wellid = getJSONElementValue("OLD".welllog_native_uid,'wellid');
    DECLARE integer VARIABLES.log_run_no = CONVERT(getJSONElementValue("OLD".welllog_native_uid,'log_run_no'),Integer);
    DECLARE string VARIABLES.log_name = getJSONElementValue("OLD".welllog_native_uid,'log_name');
    DECLARE string VARIABLES.log_pass_id = getJSONElementValue("OLD".welllog_native_uid,'log_pass_id');

    DECLARE integer VARIABLES.param_count = (SELECT count(petro_parm_name) FROM OpenWorks_SM.PetrophysicalParmValue WHERE wellid = VARIABLES.wellid and log_run_no = VARIABLES.log_run_no and log_name=VARIABLES.log_name and log_pass_id=VARIABLES.log_pass_id and petro_parm_name="OLD".parameter_name);

    IF(VARIABLES.param_count = 0)
    BEGIN
    INSERT INTO OpenWorks_SM.PetrophysicalParmValue (petro_parm_name,      numeric_value,       char_value,         numeric_value_dsdsunit, data_source ,                        remark,                          wellid,           log_name,           log_run_no,            log_pass_id,          top_depth_dsdsunit, base_depth_dsdsunit)
                                             VALUES ("NEW".parameter_name, "NEW".numeric_value, "NEW".string_value, "NEW".parameter_unit,   SUBSTRING("NEW".data_source, 1, 5) , SUBSTRING("NEW".remark, 1, 200), VARIABLES.wellid, VARIABLES.log_name, VARIABLES.log_run_no, VARIABLES.log_pass_id, 'feet',             'feet');
    END

    ELSE
    BEGIN
        UPDATE OpenWorks_SM.PetrophysicalParmValue SET numeric_value="NEW".numeric_value, numeric_value_dsdsunit="NEW".parameter_unit, char_value="NEW".string_value, data_source=SUBSTRING("NEW".data_source, 1, 5), remark=SUBSTRING("NEW".remark, 1, 200) WHERE wellid = VARIABLES.wellid and log_run_no = VARIABLES.log_run_no and log_name=VARIABLES.log_name and log_pass_id=VARIABLES.log_pass_id and petro_parm_name="OLD".parameter_name;
    END
END;


CREATE TRIGGER ON LoggingParameter INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC
    DELETE FROM OpenWorks_SM.PetrophysicalParmValue WHERE petro_parm_id = "OLD".native_uid;
END;

/*
**********************************
*     "LogCurve"
**********************************
*/
CREATE VIEW LogCurve
(
  native_uid                   VARCHAR(1024) AUTO_INCREMENT OPTIONS("OpenWorksCommonModel:LogCurve.native_uid.isUpdatable" false,
                                                    "OpenWorksCommonModel:LogCurve.native_uid.isCreatable" false,UPDATABLE 'FALSE'),
  welllog_native_uid             VARCHAR(1024) NOT NULL,

  log_curve_name               VARCHAR(25)   NOT NULL,
  log_curve_version            INTEGER       NOT NULL AUTO_INCREMENT,
  wellbore_uwi                 VARCHAR(26)   OPTIONS("OpenWorksCommonModel:LogCurve.wellbore_uwi.isUpdatable" false,
                                                    "OpenWorksCommonModel:LogCurve.wellbore_uwi.isCreatable" false,UPDATABLE 'FALSE'),
  log_name                     VARCHAR(30)   OPTIONS("OpenWorksCommonModel:LogCurve.log_name.isUpdatable" false,
                                                    "OpenWorksCommonModel:LogCurve.log_name.isCreatable" false,UPDATABLE 'FALSE'),
  log_pass_id                  VARCHAR(4)    OPTIONS("OpenWorksCommonModel:LogCurve.log_pass_id.isUpdatable" false,
                                                    "OpenWorksCommonModel:LogCurve.log_pass_id.isCreatable" false,UPDATABLE 'FALSE'),
  log_run_no                   INTEGER       OPTIONS("OpenWorksCommonModel:LogCurve.log_run_no.isUpdatable" false,
                                                    "OpenWorksCommonModel:LogCurve.log_run_no.isCreatable" false,UPDATABLE 'FALSE'),
  logging_job_no               INTEGER,
  tool_code                    VARCHAR(12)   DEFAULT 'UNKNOWN',
  tool_position_seq_no         INTEGER,
  data_source                  VARCHAR(5),
  original_data_source         VARCHAR(5),
  index_min                    DOUBLE        OPTIONS("OpenWorksCommonModel:LogCurve.index_min.unitField" 'index_unit'),
  index_max                    DOUBLE        OPTIONS("OpenWorksCommonModel:LogCurve.index_max.unitField" 'index_unit'),
  index_increment              DOUBLE        OPTIONS("OpenWorksCommonModel:LogCurve.index_increment.unitField" 'index_unit'),
  total_samples                INTEGER       NOT NULL DEFAULT '0',
  index_unit                   VARCHAR(64)   NOT NULL OPTIONS("OpenWorksCommonModel:LogCurve.index_unit.unitType" 'depth measure'),
  number_of_dimensions         INTEGER,
  second_dimension_pts         INTEGER,
  third_dimension_pts          INTEGER,
  sample_type                  VARCHAR(4000),   /* SINGLE, MULTI, TEXT */
  min_curve_value              DOUBLE        OPTIONS ("OpenWorksCommonModel:LogCurve.min_curve_value.unitField" 'curve_unit'),
  max_curve_value              DOUBLE        OPTIONS ("OpenWorksCommonModel:LogCurve.max_curve_value.unitField" 'curve_unit'),
  no_data_value                DOUBLE,
  curve_alias                  VARCHAR(25),
  data                         BLOB          NOT NULL
                                             OPTIONS ("OpenWorksCommonModel:LogCurve.data.isMedia" 'true',
                                                     "OpenWorksCommonModel:LogCurve.data.mediaContentType" 'application/octet-stream',
                                                     "OpenWorksCommonModel:LogCurve.data.elementStruct"      '[{"name":"depths","type":"double[]"}, {"name":"values","type":"float[]"}]',
                                                      "OpenWorksCommonModel:LogCurve.data.elementMetadata"  '[{"name":"depths", "unitField":"index_unit"}, {"name":"values", "unitField":"curve_unit"}]'),
  curve_unit                   VARCHAR(64)   NOT NULL DEFAULT ' ' OPTIONS ("OpenWorksCommonModel:LogCurve.curve_unit.unitTypeAttribute" 'curve_unit_type'),
  curve_unit_desc              VARCHAR(4000),
  curve_unit_type              VARCHAR(4000),
  log_quality                  INTEGER,
  api_code                     VARCHAR(12)   DEFAULT 'UNKNOWN',
  storage_data_type            VARCHAR(16)   DEFAULT 'FLOAT32',
  char_data_ind                VARCHAR(1)    DEFAULT 'N',
  value_storage_direction      VARCHAR(11)   DEFAULT 'TOP DOWN',
  resampling_scheme            VARCHAR(20)   DEFAULT 'CONTINUOUS',
  remark                       VARCHAR(200),
  curve_description            VARCHAR(4000),
  create_date                  TIMESTAMP     OPTIONS ("OpenWorksCommonModel:LogCurve.create_date.isUpdatable" false,
                                                      "OpenWorksCommonModel:LogCurve.create_date.isCreatable" false,UPDATABLE 'FALSE'),
  create_user_id               VARCHAR(32)   OPTIONS ("OpenWorksCommonModel:LogCurve.create_user_id.isUpdatable" false,
                                                      "OpenWorksCommonModel:LogCurve.create_user_id.isCreatable" false,UPDATABLE 'FALSE'),
  creation_routine             VARCHAR(10)   DEFAULT 'UNKNOWN',
  update_date                  TIMESTAMP     OPTIONS("OpenWorksCommonModel:LogCurve.update_date.isUpdatable" false,
                                                     "OpenWorksCommonModel:LogCurve.update_date.isCreatable" false,UPDATABLE 'FALSE'),
  update_user_id               VARCHAR(32)   OPTIONS ("OpenWorksCommonModel:LogCurve.update_user_id.isUpdatable" false,
                                                      "OpenWorksCommonModel:LogCurve.update_user_id.isCreatable" false,
                                                       UPDATABLE 'FALSE'),
  update_routine               VARCHAR(10)   DEFAULT 'UNKNOWN',
  alternate_uid    			       VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:LogCurve.alternate_uid.isCreatable" false,
                                                      "OpenWorksCommonModel:LogCurve.alternate_uid.isUpdatable" false,
                                                      UPDATABLE 'FALSE'),


   CONSTRAINT LogCurve_PK PRIMARY KEY (native_uid),

    CONSTRAINT LogCurve_UK1 UNIQUE (welllog_native_uid,log_curve_name, log_curve_version),

    CONSTRAINT FK_LogCurve_welllog_native_uid
         FOREIGN KEY (welllog_native_uid)
         REFERENCES WellLog(native_uid),

    CONSTRAINT FK_LogCurve_log_curve_name
        FOREIGN KEY               (log_curve_name)
        REFERENCES RefLogCurveName(log_curve_name),

    CONSTRAINT FK_LogCurve_data_source
        FOREIGN KEY (data_source)
        REFERENCES DataSource(name),

    CONSTRAINT FK_LogCurve_original_data_source
        FOREIGN KEY (original_data_source)
        REFERENCES DataSource(name)

)
OPTIONS (UPDATABLE 'TRUE',LogCurve.IMPLEMENTED 'TRUE')
AS
SELECT
    OpenWorks_SM.LogCurveStructured.log_curve_id AS native_uid,
    parent_native_uid AS welllog_native_uid,
    log_crv_name AS log_curve_name,
    log_crv_version AS log_curve_version,
    uwi AS wellbore_uwi,
    log_name AS log_name,
    log_pass_id AS log_pass_id,
    log_run_no AS log_run_no,
    logging_job_no AS logging_job_no,
    tool_code AS tool_code,
    tool_position_seq_no AS tool_position_seq_no,
    OpenWorks_SM.LogCurveStructured.data_source AS data_source,
    original_data_source AS original_data_source,
    top_depth AS  index_min,
    base_depth AS index_max,
    crv_increm AS index_increment,
    total_samples AS total_samples,
    coalesce(top_depth_dsdsunit,base_depth_dsdsunit) AS index_unit,
    number_of_dimensions,
    CASE storage_data_type WHEN 'SAMPLEBLOCK' THEN OpenWorks_SM.LogCurveStruct.second_dimension_npts ELSE OpenWorks_SM.LogCurveStructured.second_dimension_npts END as second_dimension_pts,
    CASE storage_data_type WHEN 'SAMPLEBLOCK' THEN OpenWorks_SM.LogCurveStruct.third_dimension_npts ELSE OpenWorks_SM.LogCurveStructured.third_dimension_npts END as third_dimension_pts,
    CASE storage_data_type WHEN 'SAMPLEBLOCK' THEN OpenWorks_SM.LogCurveStruct.sample_type ELSE DECODESTRING(number_of_dimensions,'1:VALUE:2:FIXEDLIST1D:3:FIXEDLIST2D',':') END AS sample_type,
    min_value AS min_curve_value,
    max_value AS max_curve_value,
    storage_znon AS no_data_value,
    log_crv_alias AS curve_alias,
    data AS data ,
    coalesce(min_value_dsdsunit, max_value_dsdsunit) AS  curve_unit,
    log_crv_unit_meas AS curve_unit_desc,
    unit_type_id AS curve_unit_type,
    log_quality AS log_quality,
    api_code AS api_code,
    CASE storage_data_type WHEN 'SAMPLEBLOCK' THEN OpenWorks_SM.LogCurveStruct.data_type ELSE storage_data_type END AS storage_data_type,
    char_data_ind AS char_data_ind,
    value_storage_direction AS value_storage_direction,
    resampling_scheme AS resampling_scheme,
    OpenWorks_SM.LogCurveStructured.remark AS remark,
    unit_type_id AS curve_description,
    OpenWorks_SM.LogCurveStructured.create_date AS create_date,
    OpenWorks_SM.LogCurveStructured.create_user_id AS create_user_id,
    creation_routine as creation_routine,
    OpenWorks_SM.LogCurveStructured.update_date AS update_date,
    OpenWorks_SM.LogCurveStructured.update_user_id AS update_user_id,
    update_routine AS update_routine,
    OpenWorks_SM.LogCurveStructured.native_uid
    FROM
         OpenWorks_SM.LogCurveStructured LEFT OUTER JOIN /*+ optional */ OpenWorks_SM.LogCurveStruct ON OpenWorks_SM.LogCurveStructured.log_curve_id = OpenWorks_SM.LogCurveStruct.log_curve_id,
         /*+ optional */ OpenWorks_SM.WellEntire
    WHERE
        OpenWorks_SM.LogCurveStructured.wellid = OpenWorks_SM.WellEntire.wellid;

Create Trigger on LogCurve INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC

    DECLARE string VARIABLES.MSG_NO_WELLBORE=CONCAT (CONCAT('ERROR: The given welllog_native_uid "',"NEW".welllog_native_uid),'" does not exist in WellLog entity');

     DECLARE string VARIABLES.well_id = null;
     DECLARE string VARIABLES.log_pass_id = null;
     DECLARE string VARIABLES.log_name = null;
     DECLARE integer VARIABLES.log_run_no = null;
     DECLARE integer VARIABLES.log_curve_version = null;

     INSERT INTO #TmpTbl (#TmpTbl.wellid,#TmpTbl.log_name,#TmpTbl.log_run_no,#TmpTbl.log_pass_id) SELECT wellid,log_name,log_run_no,log_pass_id FROM OpenWorks_SM.LoggingToolPass where native_uid = "NEW".welllog_native_uid;

     VARIABLES.well_id = (select #TmpTbl.wellid from #TmpTbl);
     VARIABLES.log_name = (select #TmpTbl.log_name from #TmpTbl);
     VARIABLES.log_run_no = (select #TmpTbl.log_run_no from #TmpTbl);
     VARIABLES.log_pass_id = (select #TmpTbl.log_pass_id from #TmpTbl);



     VARIABLES.log_curve_version=select max(log_crv_version) from openworks_SM.logcurvestructured where log_crv_name = "NEW".log_curve_name and wellid=VARIABLES.well_id and log_name=VARIABLES.log_name and log_pass_id = VARIABLES.log_pass_id and log_run_no =  VARIABLES.log_run_no;

     IF(VARIABLES.log_curve_version IS NULL)
     BEGIN
         VARIABLES.log_curve_version = 1;
     END
     ELSE
     BEGIN
        VARIABLES.log_curve_version = VARIABLES.log_curve_version + 1;
     END

    IF ((VARIABLES.well_id IS NULL) OR (VARIABLES.log_name IS NULL)  OR (VARIABLES.log_run_no IS NULL)  OR (VARIABLES.log_pass_id IS NULL))
    BEGIN
        ERROR VARIABLES.MSG_NO_WELLBORE;
    END

    DECLARE string  VARIABLES.curve_unit="NEW".curve_unit;
    DECLARE string  VARIABLES.curve_unit_type="NEW".curve_unit_type;
    DECLARE string VARIABLES.char_data_ind = DECODESTRING(LOWER("NEW".char_data_ind),'true:Y:false:N',':');
    DECLARE string VARIABLES.trace_storage_type = 'INTERNAL';

    IF("NEW".curve_unit IS NOT NULL)
    BEGIN
        IF(LENGTH(TRIM("NEW".curve_unit))<=0)
        BEGIN
            VARIABLES.curve_unit = NULL;
        END
    END

    IF ("NEW".curve_unit_type = '')
		VARIABLES.curve_unit_type = 'UNKNOWN';
	ELSE
	    VARIABLES.curve_unit_type = getDataSourceUnitType(VARIABLES.curve_unit_type,'OW');

    Declare string VARIABLES.Check_RefLogCurveName = SELECT log_curve_name FROM RefLogCurveName where log_curve_name = "NEW".log_curve_name;

    IF(VARIABLES.Check_RefLogCurveName IS NULL)
    BEGIN
    insert into RefLogCurveName(log_curve_name,unit_type)values("NEW".log_curve_name,VARIABLES.curve_unit_type);
    END

    DECLARE integer VARIABLES.logcurve_id = (SELECT * FROM (EXEC OpenWorks_SM.nextval('LogCurveStructured')) AS SysGenID);
	
    INSERT INTO OpenWorks_SM.LogCurveStructured (wellid,            log_curve_id, log_crv_name,         log_crv_version,         log_name,           log_pass_id,                log_run_no,       logging_job_no,       tool_code,       tool_position_seq_no,       data_source,       original_data_source,       top_depth,       base_depth,       crv_increm,            total_samples,       top_depth_dsdsunit, base_depth_dsdsunit, storage_depth_mode, min_value,             max_value,             storage_znon, znon,                data,       min_value_dsdsunit,   max_value_dsdsunit,   log_crv_unit_meas,     unit_type_id,          log_quality,       api_code,       trace_storage_type,           storage_data_type,       char_data_ind,           value_storage_direction,       start_framework_sample_no,       end_framework_sample_no,       resampling_scheme,       remark,                       creation_routine,                                         update_routine,                       number_of_dimensions, second_dimension_npts, third_dimension_npts)
    values                                      (VARIABLES.well_id, VARIABLES.logcurve_id, "NEW".log_curve_name, VARIABLES.log_curve_version, VARIABLES.log_name, VARIABLES.log_pass_id,  VARIABLES.log_run_no, "NEW".logging_job_no, "NEW".tool_code, "NEW".tool_position_seq_no, "NEW".data_source, "NEW".original_data_source, "NEW".index_min, "NEW".index_max, "NEW".index_increment, "NEW".total_samples, "NEW".index_unit,    "NEW".index_unit,    4,                  "NEW".min_curve_value, "NEW".max_curve_value, "NEW".no_data_value, "NEW".no_data_value, "NEW".data, VARIABLES.curve_unit, VARIABLES.curve_unit, "NEW".curve_unit_desc, VARIABLES.curve_unit_type, "NEW".log_quality, "NEW".api_code, VARIABLES.trace_storage_type, "NEW".storage_data_type, VARIABLES.char_data_ind, "NEW".value_storage_direction, 0,                               1, "NEW".resampling_scheme, SUBSTRING("NEW".remark,1,200), SUBSTRING(NVL("NEW".creation_routine, 'UNKNOWN'), 1, 10), SUBSTRING("NEW".update_routine,1,10), 1,                    1,                     1);

END;

Create Trigger on LogCurve INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC

     DECLARE string  VARIABLES.curve_unit="NEW".curve_unit;
	 DECLARE string  VARIABLES.curve_unit_type="NEW".curve_unit_type;
     DECLARE string  VARIABLES.curve_unit_desc="NEW".curve_unit_desc;
     DECLARE string  VARIABLES.remark=' '; /*Empty String - Temporary fix. Otherwise the gdi Update always updates log curve version 1 */
     DECLARE string VARIABLES.char_data_ind = DECODESTRING("NEW".char_data_ind,'true:Y:false:N',':');
     IF("NEW".curve_unit IS NOT NULL)
     BEGIN
        IF(LENGTH(TRIM("NEW".curve_unit))<=0)
        BEGIN
            VARIABLES.curve_unit = NULL;
        END
     END
	IF ("NEW".curve_unit_type = '')
	BEGIN
		VARIABLES.curve_unit_type = 'UNKNOWN';
	END

     IF ((VARIABLES.curve_unit_desc IS NULL) OR(LENGTH(TRIM("NEW".curve_unit_desc))<=0))
     BEGIN
       VARIABLES.curve_unit_desc = VARIABLES.curve_unit;
     END

     IF("NEW".remark IS NOT NULL)
     BEGIN
            VARIABLES.remark = "NEW".remark;
    END
    Declare string VARIABLES.storageUnits = SELECT storage_depth_units FROM OPENWORKS_SM.LogCurveStructured where log_curve_id = "OLD".native_uid;/*Updating the Storage units are important otherwise, gdi reasssigns the storage units to default*/
    Declare string VARIABLES.old_native_uid = SELECT log_curve_id FROM OPENWORKS_SM.LogCurveStructured where log_curve_id = "OLD".native_uid;
    DECLARE string VARIABLES.old_well_id = SELECT wellid FROM OpenWorks_SM.LogCurveStructured where log_curve_id = "OLD".native_uid;
    Declare string VARIABLES.append_mode = SELECT CAST((select getSessionVariable('log_append_mode')) as String);

	IF((VARIABLES.storageUnits = 890) OR (VARIABLES.storageUnits = 348)) /*don't set the storage_units for time based logs, gdi doesn't support it.only log api supports*/
    BEGIN
        UPDATE OPENWORKS_SM.LogCurveStructured set  logging_job_no = "NEW".logging_job_no, tool_code =  "NEW".tool_code, tool_position_seq_no = "NEW".tool_position_seq_no, data_source = "NEW".data_source, original_data_source = "NEW".original_data_source, storage_znon = "NEW".no_data_value,  znon = "NEW".no_data_value, log_crv_unit_meas = VARIABLES.curve_unit_desc, unit_type_id = VARIABLES.curve_unit_type, log_quality = "NEW".log_quality, api_code = "NEW".api_code,char_data_ind = NVL(VARIABLES.char_data_ind,'N'), value_storage_direction = "NEW".value_storage_direction, resampling_scheme = "NEW".resampling_scheme, remark = SUBSTRING(VARIABLES.remark,1,200), creation_routine = SUBSTRING(NVL("NEW".creation_routine, 'UNKNOWN'), 1, 10), update_routine = SUBSTRING("NEW".update_routine,1,10) where log_curve_id = "OLD".native_uid;
    END
    ELSE
    BEGIN
        UPDATE OPENWORKS_SM.LogCurveStructured set storage_depth_units=VARIABLES.storageUnits, logging_job_no = "NEW".logging_job_no, tool_code =  "NEW".tool_code, tool_position_seq_no = "NEW".tool_position_seq_no, data_source = "NEW".data_source, original_data_source = "NEW".original_data_source, storage_znon = "NEW".no_data_value,  znon = "NEW".no_data_value, log_crv_unit_meas = VARIABLES.curve_unit_desc, unit_type_id = VARIABLES.curve_unit_type, log_quality = "NEW".log_quality, api_code = "NEW".api_code,char_data_ind = NVL(VARIABLES.char_data_ind,'N'), value_storage_direction = "NEW".value_storage_direction, resampling_scheme = "NEW".resampling_scheme, remark = SUBSTRING(VARIABLES.remark,1,200), creation_routine = SUBSTRING(NVL("NEW".creation_routine, 'UNKNOWN'), 1, 10), update_routine = SUBSTRING("NEW".update_routine,1,10) where log_curve_id = "OLD".native_uid;
    END

    IF("OLD".curve_unit <> "NEW".curve_unit)
    BEGIN
        IF((VARIABLES.storageUnits = 890) OR (VARIABLES.storageUnits = 348)) /*don't set the storage_units for time based logs, gdi doesn't support it.only log api supports*/
        BEGIN
            UPDATE OPENWORKS_SM.LogCurveStructured set min_value_dsdsunit =VARIABLES.curve_unit, max_value_dsdsunit = VARIABLES.curve_unit,log_crv_unit_meas = VARIABLES.curve_unit_desc,storage_znon = "NEW".no_data_value,  znon = "NEW".no_data_value where log_curve_id = "OLD".native_uid;
        END
        ELSE
        BEGIN
            UPDATE OPENWORKS_SM.LogCurveStructured set storage_depth_units=VARIABLES.storageUnits, min_value_dsdsunit =VARIABLES.curve_unit, max_value_dsdsunit = VARIABLES.curve_unit,log_crv_unit_meas = VARIABLES.curve_unit_desc,storage_znon = "NEW".no_data_value,  znon = "NEW".no_data_value where log_curve_id = "OLD".native_uid;
        END
    END

    IF(CHANGING.data)
    BEGIN
	    IF(VARIABLES.append_mode = 'true')
        BEGIN
        UPDATE OPENWORKS_SM.LogCurveStructured set data = "NEW".data,top_depth = "NEW".index_min, base_depth = "NEW".index_max, crv_increm = "NEW".index_increment,total_samples = "NEW".total_samples,top_depth_dsdsunit = "NEW".index_unit, base_depth_dsdsunit = "NEW".index_unit, min_value_dsdsunit =VARIABLES.curve_unit, max_value_dsdsunit = VARIABLES.curve_unit where log_curve_id = "OLD".native_uid;
        END
        ELSE
        BEGIN
            DELETE  from OPENWORKS_SM.LogCurveStructured where log_curve_id = "OLD".native_uid;

	    INSERT INTO OpenWorks_SM.LogCurveStructured (wellid,            log_curve_id, log_crv_name,         log_crv_version,         log_name,           log_pass_id,                log_run_no,       logging_job_no,       tool_code,       tool_position_seq_no,       data_source,       original_data_source,       top_depth,       base_depth,       crv_increm,            total_samples,       top_depth_dsdsunit, base_depth_dsdsunit, storage_depth_mode, min_value,             max_value,             storage_znon, znon,                data,storage_depth_units,       min_value_dsdsunit,   max_value_dsdsunit,   log_crv_unit_meas,     unit_type_id,          log_quality,       api_code,       trace_storage_type,           storage_data_type,       char_data_ind,           value_storage_direction,       start_framework_sample_no,       end_framework_sample_no,       resampling_scheme,       remark,                       creation_routine,                                         update_routine,                       number_of_dimensions, second_dimension_npts, third_dimension_npts)
        values                                      (VARIABLES.old_well_id, VARIABLES.old_native_uid,           "OLD".log_curve_name, "OLD".log_curve_version, "OLD".log_name, "OLD".log_pass_id,  "OLD".log_run_no, "NEW".logging_job_no, "NEW".tool_code, "NEW".tool_position_seq_no, "NEW".data_source, "NEW".original_data_source, "NEW".index_min, "NEW".index_max, "NEW".index_increment, "NEW".total_samples, "NEW".index_unit,    "NEW".index_unit,    4,                  "NEW".min_curve_value, "NEW".max_curve_value, "NEW".no_data_value, "NEW".no_data_value, "NEW".data,VARIABLES.storageUnits, VARIABLES.curve_unit, VARIABLES.curve_unit, VARIABLES.curve_unit_desc, VARIABLES.curve_unit_type, "NEW".log_quality, "NEW".api_code, 'INTERNAL', "NEW".storage_data_type, NVL(VARIABLES.char_data_ind,'N'), "NEW".value_storage_direction, 0,                               1, "NEW".resampling_scheme, SUBSTRING("NEW".remark,1,200), SUBSTRING(NVL("NEW".creation_routine, 'UNKNOWN'), 1, 10), SUBSTRING("NEW".update_routine,1,10), 1,                    1,                     1);
        END
    END
END;

Create Trigger on LogCurve INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC

    DELETE FROM OpenWorks_SM.LogCurveStructured where log_curve_id = "OLD".native_uid;

END;


/*
**********************************
* ENTITY: RefCoreProperty
**********************************
*/

CREATE VIEW RefCoreProperty
(
    core_property               VARCHAR(20) NOT NULL,
    unit_type                   VARCHAR(64),
    core_property_name          VARCHAR(40),
    remark                      VARCHAR(200),
    ref_value_source            VARCHAR(40),
    ref_value_status            VARCHAR(20),
    create_date                 TIMESTAMP,
    create_user_id              VARCHAR(32),
    update_date                 TIMESTAMP,
    update_user_id              VARCHAR(32),

    CONSTRAINT RefCoreProperty_PK PRIMARY KEY (core_property)
)
    OPTIONS (UPDATABLE 'TRUE', RefCoreProperty.IMPLEMENTED 'TRUE')
    AS
    SELECT
        core_property      AS core_property,
        unit_type_id       AS unit_type,
        core_property_name AS core_property_name,
        remark             AS remark,
        ref_value_source   AS ref_value_source,
        ref_value_status   AS ref_value_status,
        create_date        AS create_date,
        create_user_id     AS create_user_id,
        update_date        AS update_date,
        update_user_id     AS update_user_id

    FROM Openworks_SM.RCoreProperty;

CREATE TRIGGER ON RefCoreProperty INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC
Insert into Openworks_SM.RCoreProperty(core_property,       unit_type_id,                   core_property_name,        remark,       ref_value_status,       ref_value_source )
                                VALUES("NEW".core_property, NVL("NEW".unit_type,'UNKNOWN'), "NEW".core_property_name,  "NEW".remark, "NEW".ref_value_status, "NEW".ref_value_source );
END;


CREATE TRIGGER ON RefCoreProperty INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC
Update Openworks_SM.RCoreProperty Set    unit_type_id=NVL("NEW".unit_type,'UNKNOWN'), core_property_name="NEW".core_property_name,  remark="NEW".remark, ref_value_status="NEW".ref_value_status, ref_value_source="NEW".ref_value_source
Where   core_property="OLD".core_property ;

END;

CREATE TRIGGER ON RefCoreProperty INSTEAD OF Delete AS
FOR EACH ROW
BEGIN ATOMIC
Delete from Openworks_SM.RCoreProperty    Where core_property="OLD".core_property ;
END;

