CREATE VIEW Zonation
(
   native_uid              VARCHAR(1024)   OPTIONS("OpenWorksCommonModel:Zonation.native_uid.isUpdatable" false,
                                                    "OpenWorksCommonModel:Zonation.native_uid.isCreatable" false,
                                                    UPDATABLE 'FALSE'),
  name                   VARCHAR(4000) NOT NULL,
  zonation_type          VARCHAR(4000) NOT NULL,
  zonation_version       INTEGER       NOT NULL,
    wellbore_native_uid     VARCHAR(1024) NOT NULL,
    wellbore_uwi            VARCHAR(4000)   OPTIONS("OpenWorksCommonModel:Zonation.wellbore_uwi.isUpdatable" false,
                                                    "OpenWorksCommonModel:Zonation.wellbore_uwi.isCreatable" false,
                                                    UPDATABLE 'FALSE'),
  attribute_update       VARCHAR(4000),
  comment                VARCHAR(4000),
  creator                VARCHAR(4000),
  date_stamp             VARCHAR(4000),
  depth_reference        VARCHAR(4000),
  file_name              VARCHAR(4000),
  file_size              INTEGER,
  folder                 VARCHAR(4000),
  hierarchy_child        VARCHAR(4000),
  hierarchy_childpath    VARCHAR(4000),
  hierarchy_parent       VARCHAR(4000),
  hierarchy_parentpath   VARCHAR(4000),
  link_type              VARCHAR(4000),
  program_name           VARCHAR(4000),
  recall_zonation_id     VARCHAR(4000),
  security_access_list   VARCHAR(4000),
  security_flag          VARCHAR(4000),
  security_grade         VARCHAR(4000),
  security_user_count    INTEGER,
  zone_contiguity        VARCHAR(4000),
  alternate_uid    		     VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:Zonation.alternate_uid.isCreatable" false,
                                                "OpenWorksCommonModel:Zonation.alternate_uid.isUpdatable" false,
                                                 UPDATABLE 'FALSE'),

    CONSTRAINT Zonation_PK PRIMARY KEY (native_uid),

    CONSTRAINT Zonation_UK1 UNIQUE (wellbore_native_uid, name, zonation_type, zonation_version),

    CONSTRAINT FK_Zonation_wellbore_native_uid
        FOREIGN KEY        (wellbore_native_uid)
        REFERENCES Wellbore(native_uid)

)
OPTIONS (UPDATABLE 'FALSE', Zonation.IMPLEMENTED 'FALSE')
    AS
    SELECT
        null AS native_uid,
        null AS name,
        null AS zonation_type,
        null AS zonation_version,
        null AS wellbore_native_uid,
        null AS wellbore_uwi,
        null AS attribute_update,
        null AS comment,
        null AS creator,
        null AS date_stamp,
        null AS depth_reference,
        null AS file_name,
        null AS file_size,
        null AS folder,
        null AS hierarchy_child,
        null AS hierarchy_childpath,
        null AS hierarchy_parent,
        null AS hierarchy_parentpath,
        null AS link_type,
        null AS program_name,
        null AS recall_zonation_id,
        null AS security_access_list,
        null AS security_flag,
        null AS security_grade,
        null AS security_user_count,
        null AS zone_contiguity,
	    null AS alternate_uid
    FROM SYS.Tables
    WHERE 1 = 2;


/*
**********************************
*     "Zone"
**********************************
*/

CREATE VIEW Zone
(
	native_uid          VARCHAR(1024)   OPTIONS("OpenWorksCommonModel:Zone.native_uid.isUpdatable" false,
                                                "OpenWorksCommonModel:Zone.native_uid.isCreatable" false,
                                                UPDATABLE 'FALSE'),
    wellbore_native_uid VARCHAR(1024) NOT NULL,
    zonation_native_uid VARCHAR(1024) NOT NULL DEFAULT '1',
    wellbore_uwi        VARCHAR(4000) NOT NULL  OPTIONS("OpenWorksCommonModel:Zone.wellbore_uwi.isUpdatable" false,
                                                "OpenWorksCommonModel:Zone.wellbore_uwi.isCreatable" false,
                                                UPDATABLE 'FALSE'),
    name               VARCHAR(4000) NOT NULL,
    data_source        VARCHAR(5) NOT NULL,
    zone_version       INTEGER       NOT NULL DEFAULT '1',
    zonation_name      VARCHAR(4000) NOT NULL DEFAULT 'UNKNOWN'    OPTIONS("OpenWorksCommonModel:Zone.zonation_name.isUpdatable" false,
                                                "OpenWorksCommonModel:Zone.zonation_name.isCreatable" false,
                                                UPDATABLE 'FALSE'),
    zonation_type      VARCHAR(4000) NOT NULL DEFAULT 'UNKNOWN'   OPTIONS("OpenWorksCommonModel:Zone.zonation_type.isUpdatable" false,
                                                "OpenWorksCommonModel:Zone.zonation_type.isCreatable" false,
                                                UPDATABLE 'FALSE'),
    zonation_version   INTEGER      NOT NULL DEFAULT '1'    OPTIONS("OpenWorksCommonModel:Zone.zonation_version.isUpdatable" false,
                                                "OpenWorksCommonModel:Zone.zonation_version.isCreatable" false,
                                                UPDATABLE 'FALSE'),

  attribute_update   VARCHAR(4000),
  bottom_depth       FLOAT,
  bulk_data          VARCHAR(4000),
  bulk_data_status   VARCHAR(4000),
  comment            VARCHAR(4000),
  creator            VARCHAR(4000),
  data_status        VARCHAR(4000),
  data_update        VARCHAR(4000),
  date_stamp         VARCHAR(4000),
  depth_reference    VARCHAR(4000),
  depth_units        VARCHAR(4000),
  file_name          VARCHAR(4000),
  file_size          INTEGER,
  link_type          VARCHAR(4000),
  program_name       VARCHAR(4000),
  top_depth          FLOAT,
    alternate_uid    		    VARCHAR(4000)   OPTIONS ("OpenWorksCommonModel:Zone.alternate_uid.isCreatable" false,
                                                 "OpenWorksCommonModel:Zone.alternate_uid.isUpdatable" false,
                                                  UPDATABLE 'FALSE'),

    CONSTRAINT Zone_PK PRIMARY KEY (native_uid),

    CONSTRAINT Zone_UK1 UNIQUE (wellbore_native_uid, zonation_native_uid, name, zone_version),

    CONSTRAINT FK_Zone_zonation_native_uid
        FOREIGN KEY        (zonation_native_uid)
        REFERENCES Zonation(native_uid)

)
OPTIONS (UPDATABLE 'FALSE', Zone.IMPLEMENTED 'TRUE')
    AS
    SELECT
        OpenWorks_SM.StratUnitSummary.native_uid as native_uid,
        openworks_SM.wellentire.wellid AS wellbore_native_uid,
        '1' AS zonation_native_uid,
        OpenWorks_SM.WellEntire.uwi AS wellbore_uwi,
        OpenWorks_SM.VcStratUnitName.strat_unit_name AS name,
        OpenWorks_SM.StratUnitSummary.data_source AS data_source,
        1,
        'UNKNOWN',
        'UNKNOWN',
        1,
        null AS attribute_update,
        OpenWorks_SM.StratUnitSummary.computed_base_md AS bottom_depth,
        null AS bulk_data,
        null AS bulk_data_status,
        null AS comment,
        null AS creator,
        null AS data_status,
        null AS data_update,
        null AS date_stamp,
        null AS depth_reference,
        null AS depth_units,
        null AS file_name,
        null AS file_size,
        null AS link_type,
        null AS program_name,
        OpenWorks_SM.StratUnitSummary.computed_top_md AS top_depth,
	    OpenWorks_SM.StratUnitSummary.native_uid as alternate_uid

    FROM
    OpenWorks_SM.WellEntire,
        OpenWorks_SM.StratUnitSummary,
        OpenWorks_SM.VcStratUnitName

    WHERE
        OpenWorks_SM.WellEntire.wellid = OpenWorks_SM.StratUnitSummary.WELLID AND
        OpenWorks_SM.StratUnitSummary.strat_unit = OpenWorks_SM.VcStratUnitName.strat_unit_name AND
        OpenWorks_SM.VcStratUnitName.strat_unit_name NOT IN ( 'ZoneManager' , '9999') AND
        (OpenWorks_SM.StratUnitSummary.computed_top_md > 0.0 OR OpenWorks_SM.StratUnitSummary.computed_base_md > 0.0);


/*
**********************************
* ENTITY: ZonalParameter
**********************************
*/
CREATE VIEW ZonalParameter
(
	native_uid     VARCHAR(1024)    OPTIONS("OpenWorksCommonModel:ZonalParameter.native_uid.isUpdatable" false,
                                            "OpenWorksCommonModel:ZonalParameter.native_uid.isCreatable" false,
                                            UPDATABLE 'FALSE'),
    zone_native_uid VARCHAR(1024) NOT NULL,
    wellbore_uwi    VARCHAR(4000)   OPTIONS("OpenWorksCommonModel:ZonalParameter.wellbore_uwi.isUpdatable" false,
                                            "OpenWorksCommonModel:ZonalParameter.wellbore_uwi.isCreatable" false,
                                            UPDATABLE 'FALSE'),
    zone_name       VARCHAR(4000)   OPTIONS("OpenWorksCommonModel:ZonalParameter.zone_name.isUpdatable" false,
                                            "OpenWorksCommonModel:ZonalParameter.zone_name.isCreatable" false,
                                            UPDATABLE 'FALSE'),
    zone_version    VARCHAR(4000)   OPTIONS("OpenWorksCommonModel:ZonalParameter.zone_version.isUpdatable" false,
                                            "OpenWorksCommonModel:ZonalParameter.zone_version.isCreatable" false,
                                            UPDATABLE 'FALSE'),
  name           VARCHAR(4000) NOT NULL,
  recall_value   VARCHAR(4000),
  units          VARCHAR(4000),
    alternate_uid    	   VARCHAR(4000)    OPTIONS ("OpenWorksCommonModel:ZonalParameter.alternate_uid.isCreatable" false,
                                             "OpenWorksCommonModel:ZonalParameter.alternate_uid.isUpdatable" false,
                                              UPDATABLE 'FALSE'),

    CONSTRAINT ZonalParameter_PK PRIMARY KEY (native_uid),

    CONSTRAINT ZonalParameter_UK1 UNIQUE (zone_native_uid, name),

    CONSTRAINT FK_ZonalParameter_zone_native_uid
        FOREIGN KEY    (zone_native_uid)
        REFERENCES Zone(native_uid)

)
OPTIONS (UPDATABLE 'FALSE', ZonalParameter.IMPLEMENTED 'FALSE')
    AS
    SELECT
        null AS native_uid,
        null AS zone_native_uid,
        null AS wellbore_uwi,
        null AS zone_name,
        null AS zone_version,
        null AS name,
        null AS recall_value,
        null AS units,
	    null AS alternate_uid
    FROM SYS.Tables
        WHERE 1 = 2;


/*
**********************************
* ENTITY: ZonationFile
**********************************
*/

CREATE VIEW ZonationFile
(
	native_uid              VARCHAR(1024)   OPTIONS("OpenWorksCommonModel:ZonationFile.native_uid.isUpdatable" false,
                                                    "OpenWorksCommonModel:ZonationFile.native_uid.isCreatable" false,
                                                    UPDATABLE 'FALSE'),
    zonation_native_uid     VARCHAR(1024) NOT NULL,
    wellbore_uwi            VARCHAR(4000)   OPTIONS("OpenWorksCommonModel:ZonationFile.wellbore_uwi.isUpdatable" false,
                                                    "OpenWorksCommonModel:ZonationFile.wellbore_uwi.isCreatable" false,
                                                    UPDATABLE 'FALSE'),
    name                   VARCHAR(4000) NOT NULL,
    zonation_file_type     VARCHAR(4000) NOT NULL,
    zonation_file_version  INTEGER       NOT NULL,
    zonation_file_format   VARCHAR(4000) NOT NULL,
    zonation_name          VARCHAR(4000)    OPTIONS("OpenWorksCommonModel:ZonationFile.zonation_name.isUpdatable" false,
                                                    "OpenWorksCommonModel:ZonationFile.zonation_name.isCreatable" false,
                                                    UPDATABLE 'FALSE'),
    zonation_type          VARCHAR(4000)    OPTIONS("OpenWorksCommonModel:ZonationFile.zonation_type.isUpdatable" false,
                                                    "OpenWorksCommonModel:ZonationFile.zonation_type.isCreatable" false,
                                                    UPDATABLE 'FALSE'),
    zonation_version       INTEGER          OPTIONS("OpenWorksCommonModel:ZonationFile.zonation_version.isUpdatable" false,
                                                    "OpenWorksCommonModel:ZonationFile.zonation_version.isCreatable" false,
                                                    UPDATABLE 'FALSE'),
    attribute_update       VARCHAR(4000),
    comment                VARCHAR(4000),
    creator                VARCHAR(4000),
    date_stamp             VARCHAR(4000),
    description            VARCHAR(4000),
    dir_directory          VARCHAR(4000),
    directory              VARCHAR(4000),
    ex_file                VARCHAR(4000),
    file                   VARCHAR(4000),
    link_type              VARCHAR(4000),
    process_status         VARCHAR(4000),
    program_name           VARCHAR(4000),
    siz_file               INTEGER,
    sub_format             VARCHAR(4000),
    file_stream            BLOB             OPTIONS("OpenWorksCommonModel:ZonationFile.file_stream.isMedia"          true,
                                                    "OpenWorksCommonModel:ZonationFile.file_stream.mediaContentType" 'application/octet-stream'),
    alternate_uid    		        VARCHAR(4000)   OPTIONS ("OpenWorksCommonModel:ZonationFile.alternate_uid.isCreatable" false,
                                                     "OpenWorksCommonModel:ZonationFile.alternate_uid.isUpdatable" false,
                                                     UPDATABLE 'FALSE'),

    CONSTRAINT ZonationFile_PK PRIMARY KEY (native_uid),

    CONSTRAINT ZonationFile_UK1 UNIQUE (zonation_native_uid, name, zonation_file_type, zonation_file_version, zonation_file_format),

    CONSTRAINT FK_ZonationFile_zonation_native_uid
        FOREIGN KEY        (zonation_native_uid)
        REFERENCES Zonation(native_uid)

)
OPTIONS (UPDATABLE 'FALSE', ZonationFile.IMPLEMENTED 'FALSE')
    AS
    SELECT
        null AS native_uid,
        null AS zonation_native_uid,
        null AS wellbore_uwi,
        null AS name,
        null AS zonation_file_type,
        null AS zonation_file_version,
        null AS zonation_file_format,
        null AS zonation_name,
        null AS zonation_type,
        null AS zonation_version,
        null AS attribute_update,
        null AS comment,
        null AS creator,
        null AS date_stamp,
        null AS description,
        null AS dir_directory,
        null AS directory,
        null AS ex_file,
        null AS file,
        null AS link_type,
        null AS process_status,
        null AS program_name,
        null AS siz_file,
        null AS sub_format,
        null AS file_stream,
	    null AS alternate_uid
    FROM SYS.Tables
        WHERE 1 = 2;

/*
**********************************
*     "Application Data"
**********************************
*/

CREATE VIEW ApplicationData
(
  native_uid             VARCHAR(1024) AUTO_INCREMENT OPTIONS ("OpenWorksCommonModel:ApplicationData.native_uid.isUpdatable" false,
                                                "OpenWorksCommonModel:ApplicationData.native_uid.isCreatable" false,UPDATABLE 'FALSE'),
  application_name       VARCHAR(40) NOT NULL,
  data_category          VARCHAR(24) NOT NULL,
  data_set_name          VARCHAR(40) NOT NULL,
  data                   BLOB OPTIONS ("OpenWorksCommonModel:ApplicationData.data.isMedia" 'true',
                              "OpenWorksCommonModel:ApplicationData.data.mediaContentType" 'application/octet-stream'),
  remark                 VARCHAR(200),
  create_date            TIMESTAMP,
  create_user_id         VARCHAR(32),
  update_user_id         VARCHAR(32),
  update_date            TIMESTAMP,
  alternate_uid    		     VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:ApplicationData.alternate_uid.isCreatable" false,
                                                "OpenWorksCommonModel:ApplicationData.alternate_uid.isUpdatable" false,
                                                 UPDATABLE 'FALSE'),

  CONSTRAINT ApplicationData_PK PRIMARY KEY (native_uid),
  CONSTRAINT ApplicationData_UK1 UNIQUE (application_name, data_category, data_set_name)
)
OPTIONS (UPDATABLE 'TRUE' , ApplicationData.IMPLEMENTED 'TRUE')
    AS
    SELECT
        native_uid AS native_uid,
        application_name AS application_name,
        data_category AS data_category,
        data_set_name AS data_set_name,
        data AS data,
        remark AS remark,
        create_date AS create_date,
        create_user_id AS create_user_id,
        update_user_id AS update_user_id,
        update_date AS update_date,

	    native_uid AS alternate_uid
    FROM OpenWorks_SM.ApplicationData;

Create Trigger on ApplicationData INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC
INSERT INTO OpenWorks_SM.ApplicationData
    (application_name, data_category, data_set_name, data, remark)
VALUES
    ("NEW".application_name, "NEW".data_category, "NEW".data_set_name, "NEW".data, "NEW".remark);
END;

CREATE TRIGGER ON ApplicationData INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC

  IF((CHANGING.data))
  BEGIN
    UPDATE OpenWorks_SM.ApplicationData SET data = "NEW".data, remark = "NEW".remark WHERE (application_name = "OLD".application_name) AND (data_category = "OLD".data_category) AND (data_set_name = "OLD".data_set_name);
  END ELSE
  BEGIN
    UPDATE OpenWorks_SM.ApplicationData SET remark = "NEW".remark WHERE (application_name = "OLD".application_name) AND (data_category = "OLD".data_category) AND (data_set_name = "OLD".data_set_name);
  END
END;

CREATE TRIGGER ON ApplicationData INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC
    DELETE FROM OpenWorks_SM.ApplicationData WHERE (application_name = "OLD".application_name) AND (data_category = "OLD".data_category) AND (data_set_name = "OLD".data_set_name);
END;

/*
**********************************
*     "Application Data2"
