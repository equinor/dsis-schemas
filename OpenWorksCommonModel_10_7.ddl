/*
**********************************
* ENTITY: InterpProcessParm
**********************************
*/

CREATE VIEW InterpProcessParm
(
	native_uid                VARCHAR(12)         AUTO_INCREMENT OPTIONS ("OpenWorksCommonModel:InterpProcessParm.native_uid.isUpdatable" false,
                                                                        "OpenWorksCommonModel:InterpProcessParm.native_uid.isCreatable" false,UPDATABLE 'FALSE'),
    interp_process_native_uid     VARCHAR(12)        NOT NULL,
    parm_name                VARCHAR(40)            NOT NULL,
    parm_type                VARCHAR(20),
    numeric_value            DOUBLE,
    numeric_value_dsdsunit    VARCHAR(64),
    string_value            VARCHAR(80),
    containing_parm_id        VARCHAR(12),
    seq_in_containing_parm    INTEGER,
    data_source                VARCHAR(5),
    remark                    VARCHAR(200),
    nchar_                    INTEGER,
    process_parm            CLOB,
    create_date                timestamp     OPTIONS ("OpenWorksCommonModel:InterpProcessParm.create_date.isUpdatable" false,"OpenWorksCommonModel:InterpProcessParm.create_date.isCreatable" false,UPDATABLE 'FALSE'),
    create_user_id            VARCHAR(32)   OPTIONS ("OpenWorksCommonModel:InterpProcessParm.create_user_id.isUpdatable" false,"OpenWorksCommonModel:InterpProcessParm.create_user_id.isCreatable" false,UPDATABLE 'FALSE'),
    update_date                timestamp     OPTIONS ("OpenWorksCommonModel:InterpProcessParm.update_user_id.isUpdatable" false,"OpenWorksCommonModel:InterpProcessParm.update_user_id.isCreatable" false,UPDATABLE 'FALSE'),
    update_user_id            VARCHAR(32)   OPTIONS ("OpenWorksCommonModel:InterpProcessParm.update_date.isUpdatable" false,"OpenWorksCommonModel:InterpProcessParm.update_date.isCreatable" false,UPDATABLE 'FALSE'),
    alternate_uid    		          VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:InterpProcessParm.alternate_uid.isCreatable" false,
                                                     "OpenWorksCommonModel:InterpProcessParm.alternate_uid.isUpdatable" false,
                                                      UPDATABLE 'FALSE'),

    CONSTRAINT InterpProcessParam_PK PRIMARY KEY (native_uid)  ,
    CONSTRAINT InterpProcessParam_UK1 UNIQUE (interp_process_native_uid,parm_name)  ,

    CONSTRAINT FK_InterpProcessParm_interp_process_id
      FOREIGN KEY (interp_process_native_uid)
      REFERENCES InterpretationProcess(native_uid)  ,

    CONSTRAINT FK_InterpProcessParm_containing_parm_id
      FOREIGN KEY (containing_parm_id)
      REFERENCES InterpProcessParm(native_uid) ,

    CONSTRAINT FK_InterpProcessParm_DataSource_id
      FOREIGN KEY (data_source)
      REFERENCES DataSource(name)  ,

    CONSTRAINT FK_InterpProcessParm_parm_name
      FOREIGN KEY (parm_name)
      REFERENCES RProcessParm(parm_name)


)
OPTIONS (UPDATABLE 'TRUE', InterpProcessParm.IMPLEMENTED 'TRUE')
    AS
    SELECT
        interp_process_parm_id        AS  native_uid                         ,
        interp_process_id            AS  interp_process_native_uid                 ,
        parm_name                    AS  parm_name                         ,
        parm_type                    AS  parm_type                         ,
        numeric_value                AS  numeric_value                     ,
        numeric_value_dsdsunit        AS  numeric_value_dsdsunit             ,
        string_value                AS  string_value                     ,
        containing_parm_id            AS  containing_parm_id                 ,
        seq_in_containing_parm        AS  seq_in_containing_parm             ,
        data_source                    AS  data_source                         ,
        remark                        AS  remark                             ,
        "nchar"                        AS  nchar_                              ,
        process_parm                AS  process_parm                     ,
        create_date                    AS  create_date                         ,
        create_user_id                AS  create_user_id                     ,
        update_date                    AS  update_date                         ,
        update_user_id                AS  update_user_id,
	    native_uid                    AS  alternate_uid


    FROM
        OpenWorks_SM.InterpProcessParm;

Create Trigger on InterpProcessParm INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC
INSERT INTO OpenWorks_SM.InterpProcessParm
    ( interp_process_id,parm_name,parm_type,numeric_value,string_value,containing_parm_id,seq_in_containing_parm,data_source,remark,"nchar",process_parm)
VALUES
    ("NEW".interp_process_native_uid,"NEW".parm_name,"NEW".parm_type,"NEW".numeric_value,"NEW".string_value,"NEW".containing_parm_id,"NEW".seq_in_containing_parm,"NEW".data_source,"NEW".remark,"NEW".nchar_,"NEW".process_parm);
END;

CREATE TRIGGER ON InterpProcessParm INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC
    UPDATE OpenWorks_SM.InterpProcessParm SET
    interp_process_id="NEW".interp_process_native_uid,parm_name="NEW".parm_name,parm_type="NEW".parm_type,numeric_value="NEW".numeric_value,string_value="NEW".string_value,containing_parm_id="NEW".containing_parm_id,seq_in_containing_parm="NEW".seq_in_containing_parm,data_source="NEW".data_source,remark="NEW".remark,"nchar"="NEW".nchar_,process_parm="NEW".process_parm
    WHERE interp_process_parm_id = "OLD".native_uid;
END;

CREATE TRIGGER ON InterpProcessParm INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC
    DELETE FROM OpenWorks_SM.InterpProcessParm WHERE interp_process_parm_id = "OLD".native_uid;
END;


/*
**********************************
*     "INoteSummary"
**********************************
*/
CREATE VIEW INoteSummary
(

    native_uid                  VARCHAR(1024) 	    OPTIONS("OpenWorksCommonModel:INoteSummary.native_uid.isUpdatable" false,
                                                            "OpenWorksCommonModel:INoteSummary.native_uid.isCreatable" false, UPDATABLE 'FALSE'),
    inote_title                 VARCHAR(40)         NOT NULL,
    instance_no                 INTEGER             NOT NULL DEFAULT '1',
    inote_category_id           VARCHAR(12)         NOT NULL,
    inote_category_name         VARCHAR(40)         OPTIONS("OpenWorksCommonModel:INoteSummary.inote_category_name.isUpdatable" false,
                                                            "OpenWorksCommonModel:INoteSummary.inote_category_name.isCreatable" false, UPDATABLE 'FALSE'),
    parent_category_name        VARCHAR(40)         OPTIONS("OpenWorksCommonModel:INoteSummary.parent_category_name.isUpdatable" false,
                                                            "OpenWorksCommonModel:INoteSummary.parent_category_name.isCreatable" false, UPDATABLE 'FALSE'),
    data_source                 VARCHAR(5),
    related_obj_type            VARCHAR(40),
    related_obj_id              VARCHAR(1024),
    effective_date              TIMESTAMP,
    min_geologic_age            FLOAT,
    max_geologic_age            FLOAT,
    orig_crs                    VARCHAR(80),
    orig_x_lon                  DOUBLE              OPTIONS ("OpenWorksCommonModel:INoteSummary.orig_x_lon.unitField" 'orig_xy_lonlat_unit'),
    orig_y_lat                  DOUBLE              OPTIONS ("OpenWorksCommonModel:INoteSummary.orig_y_lat.unitField" 'orig_xy_lonlat_unit'),
    orig_xy_lonlat_unit         VARCHAR(64)         OPTIONS ("OpenWorksCommonModel:INoteSummary.orig_xy_lonlat_unit.unitType" 'original coordinate'),
    project_x                   DOUBLE              OPTIONS ("OpenWorksCommonModel:INoteSummary.project_x.unitField" 'project_xy_unit'),
    project_y                   DOUBLE              OPTIONS ("OpenWorksCommonModel:INoteSummary.project_y.unitField" 'project_xy_unit'),
    project_xy_unit             VARCHAR(64)        OPTIONS ("OpenWorksCommonModel:INoteSummary.project_xy_unit.unitType" 'project coordinate'),
    z_value                     FLOAT               OPTIONS ("OpenWorksCommonModel:INoteSummary.z_value.unitField" 'z_value_unit'),
    z_value_unit                VARCHAR(64)         OPTIONS ("OpenWorksCommonModel:INoteSummary.z_value_unit.unitType" 'time depth measure'),
    z_domain                    VARCHAR(12),
    z_domain_qualifier          VARCHAR(24),
    z_datum                     FLOAT               OPTIONS ("OpenWorksCommonModel:INoteSummary.z_datum.unitField" 'z_datum_unit'),
    z_datum_unit                VARCHAR(64)         OPTIONS ("OpenWorksCommonModel:INoteSummary.z_datum_unit.unitType" 'elevation'),
    storage_datum               FLOAT               OPTIONS ("OpenWorksCommonModel:INoteSummary.storage_datum.unitField" 'storage_datum_unit'),
    storage_datum_unit          VARCHAR(64)         OPTIONS ("OpenWorksCommonModel:INoteSummary.storage_datum_unit.unitType" 'elevation'),
    markup_ncoord               INTEGER,
    markup_coord                BLOB                OPTIONS ("OpenWorksCommonModel:INoteSummary.markup_coord.unitField" 'markup_coord_unit'),
    markup_coord_unit           VARCHAR(64),
    markup_detail_nbyte         INTEGER,
    markup_detail               CLOB,
    x_offset                    DOUBLE              OPTIONS ("OpenWorksCommonModel:INoteSummary.x_offset.unitField" 'xy_offset_unit'),
    y_offset                    DOUBLE              OPTIONS ("OpenWorksCommonModel:INoteSummary.y_offset.unitField" 'xy_offset_unit'),
    xy_offset_unit              VARCHAR(64)         OPTIONS ("OpenWorksCommonModel:INoteSummary.xy_offset_unit.unitType" 'linear distance'),
    z_offset                    DOUBLE              OPTIONS ("OpenWorksCommonModel:INoteSummary.z_offset.unitField" 'z_offset_unit'),
    z_offset_unit               VARCHAR(64)         OPTIONS ("OpenWorksCommonModel:INoteSummary.z_offset_unit.unitType" 'time depth measure'),
    text_nchar                  INTEGER             OPTIONS("OpenWorksCommonModel:INoteSummary.text_nchar.isUpdatable" false,
                                                            "OpenWorksCommonModel:INoteSummary.text_nchar.isCreatable" false, UPDATABLE 'FALSE'),
    text                        CLOB,
    box_height                  FLOAT,
    box_width                   FLOAT,
    box_outline                 VARCHAR(1),
    box_outline_color           INTEGER,
    box_opacity                 FLOAT,
    box_background_color        INTEGER,
    box_border_width            INTEGER,
    box_foreground_color        INTEGER,
    local_box                   VARCHAR(1),
    marker_size                 INTEGER,
    symbol_type                 VARCHAR(12),
    ow_well_symbol_code         INTEGER             OPTIONS ("OpenWorksCommonModel:INoteSummary.ow_well_symbol_code.isUpdatable" false,
                                                             "OpenWorksCommonModel:INoteSummary.ow_well_symbol_code.isCreatable" false, UPDATABLE 'FALSE'),
    symbol_id                   VARCHAR(12),
    create_user_id              VARCHAR(32)         OPTIONS ("OpenWorksCommonModel:INoteSummary.create_user_id.isUpdatable" false,
                                                             "OpenWorksCommonModel:INoteSummary.create_user_id.isCreatable" false, UPDATABLE 'FALSE'),
    create_date                 TIMESTAMP           OPTIONS ("OpenWorksCommonModel:INoteSummary.create_date.isUpdatable" false,
                                                             "OpenWorksCommonModel:INoteSummary.create_date.isCreatable" false, UPDATABLE 'FALSE'),
    update_user_id              VARCHAR(32)         OPTIONS ("OpenWorksCommonModel:INoteSummary.update_user_id.isUpdatable" false,
                                                             "OpenWorksCommonModel:INoteSummary.update_user_id.isCreatable" false, UPDATABLE 'FALSE'),
    update_date                 TIMESTAMP           OPTIONS ("OpenWorksCommonModel:INoteSummary.update_date.isUpdatable" false,
                                                             "OpenWorksCommonModel:INoteSummary.update_date.isCreatable" false, UPDATABLE 'FALSE'),
    alternate_uid    		        VARCHAR(4000)       OPTIONS ("OpenWorksCommonModel:INoteSummary.alternate_uid.isCreatable" false,
                                                             "OpenWorksCommonModel:INoteSummary.alternate_uid.isUpdatable" false,
                                                             UPDATABLE 'FALSE'),
    CONSTRAINT INoteSummary_PK PRIMARY KEY (native_uid),

    CONSTRAINT FK_INoteSummary_data_source
    FOREIGN KEY (data_source)
    REFERENCES DataSource(name),

    CONSTRAINT FK_INoteSummary_orig_crs
    FOREIGN KEY                    (orig_crs)
    REFERENCES CartoReferenceSystem(name)

) OPTIONS(UPDATABLE 'TRUE',INoteSummary.IMPLEMENTED 'TRUE')
AS
SELECT
    inote_id as native_uid,
    inote_title,
    instance_no,
    inote_category_id,
    inote_category_name,
    parent_category_name,
    data_source,
    related_obj_type,
    related_obj_id,
    effective_date,
    min_geologic_age,
    max_geologic_age,
    getDSDSCrs(OpenWorks_SM.CartoRefSys.name) as orig_crs,
    orig_x_lon,
    orig_y_lat,
    orig_y_lat_dsdsunit         AS orig_xy_lonlat_unit,
    project_x,
    project_y,
    project_y_dsdsunit          AS project_xy_unit,
    z_value,
    z_value_dsdsunit            AS z_value_unit,
    z_domain,
    z_domain_qualifier,
    z_datum,
    z_datum_dsdsunit            AS z_datum_unit,
    storage_datum,
    storage_datum_dsdsunit      AS storage_datum_unit,
    markup_ncoord,
    markup_coord,
    markup_coord_dsdsunit       AS markup_coord_unit,
    markup_detail_nbyte,
    markup_detail,
    x_offset,
    y_offset,
    x_offset_dsdsunit AS xy_offset_unit,
    z_offset,
    z_offset_dsdsunit AS z_offset_unit,
    text_nchar,
    text,
    box_height,
    box_width,
    box_outline,
    box_outline_color,
    box_opacity,
    box_background_color,
    box_border_width,
    box_foreground_color,
    local_box,
    marker_size,
    symbol_type,
    ow_well_symbol_code,
    symbol_id,
    OpenWorks_SM.INoteSummary.create_user_id,
    OpenWorks_SM.INoteSummary.create_date,
    OpenWorks_SM.INoteSummary.update_user_id,
    OpenWorks_SM.INoteSummary.update_date,
    OpenWorks_SM.INoteSummary.native_uid as alternate_uid
	FROM
        OpenWorks_SM.INoteSummary LEFT OUTER JOIN /*+ optional */ OpenWorks_SM.CartoRefSys ON orig_crs_id = id;


CREATE TRIGGER ON INoteSummary INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC

    DECLARE string VARIABLES.crs_errorMsg= CONCAT (CONCAT('ERROR: The given crs value "',"NEW".orig_crs),'" does not exist in OpenWorks or an equivalent mapping does not exist in DSDS');
    DECLARE string VARIABLES.orig_crs_id;
    IF("NEW".orig_crs IS NOT NULL)
    BEGIN
        VARIABLES.orig_crs_id = (SELECT id FROM OpenWorks_SM.CartoRefSys WHERE name = (SELECT * FROM (EXEC OpenWorks_SM.GetNativeCRS("NEW".orig_crs,'OW')) AS SysGenID));
            IF(VARIABLES.orig_crs_id is NULL)
                ERROR VARIABLES.crs_errorMsg;
    END

    DECLARE integer VARIABLES.inote_id    = (SELECT * FROM (EXEC OpenWorks_SM.nextval('INoteSummary')) AS SysGenID);
    DECLARE integer VARIABLES.text_size   = LENGTH(NVL(CAST("NEW".text AS string),''));

    INSERT INTO OpenWorks_SM.INoteSummary
           (inote_id,           inote_title,       instance_no,       inote_category_id,       data_source,                        related_obj_type,       related_obj_id,       effective_date,       min_geologic_age,       max_geologic_age,       orig_crs_id,           orig_x_lon,       orig_y_lat,       project_x,       project_y,       z_value,       z_value_dsdsunit,   z_domain,       z_domain_qualifier,       z_datum,       z_datum_dsdsunit,   storage_datum,       storage_datum_dsdsunit,   markup_ncoord,       markup_coord,       markup_detail_nbyte,       markup_detail,       x_offset,       x_offset_dsdsunit,    y_offset,       y_offset_dsdsunit,    z_offset,       z_offset_dsdsunit,   text_nchar,          text,       box_height,       box_width,       box_outline,       box_outline_color,       box_opacity,       box_background_color,       box_border_width,       box_foreground_color,       local_box,         marker_size,       symbol_type,       symbol_id)
    VALUES (VARIABLES.inote_id, "NEW".inote_title, "NEW".instance_no, "NEW".inote_category_id, SUBSTRING("NEW".data_source, 1, 5), "NEW".related_obj_type, "NEW".related_obj_id, "NEW".effective_date, "NEW".min_geologic_age, "NEW".max_geologic_age, VARIABLES.orig_crs_id, "NEW".orig_x_lon, "NEW".orig_y_lat, "NEW".project_x, "NEW".project_y, "NEW".z_value, "NEW".z_value_unit, "NEW".z_domain, "NEW".z_domain_qualifier, "NEW".z_datum, "NEW".z_datum_unit, "NEW".storage_datum, "NEW".storage_datum_unit, "NEW".markup_ncoord, "NEW".markup_coord, "NEW".markup_detail_nbyte, "NEW".markup_detail, "NEW".x_offset, "NEW".xy_offset_unit, "NEW".y_offset, "NEW".xy_offset_unit, "NEW".z_offset, "NEW".z_offset_unit, VARIABLES.text_size, "NEW".text, "NEW".box_height, "NEW".box_width, "NEW".box_outline, "NEW".box_outline_color, "NEW".box_opacity, "NEW".box_background_color, "NEW".box_border_width, "NEW".box_foreground_color, "NEW".local_box,   "NEW".marker_size, "NEW".symbol_type, "NEW".symbol_id);

END;

Create Trigger on INoteSummary INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC

    DECLARE string VARIABLES.crs_errorMsg= CONCAT (CONCAT('ERROR: The given crs value "',"NEW".orig_crs),'" does not exist in OpenWorks or an equivalent mapping does not exist in DSDS');
    DECLARE string VARIABLES.orig_crs_id;
    IF("NEW".orig_crs IS NOT NULL)
    BEGIN
        VARIABLES.orig_crs_id = (SELECT id FROM OpenWorks_SM.CartoRefSys WHERE name = (SELECT * FROM (EXEC OpenWorks_SM.GetNativeCRS("NEW".orig_crs,'OW')) AS SysGenID));
            IF(VARIABLES.orig_crs_id is NULL)
                ERROR VARIABLES.crs_errorMsg;
    END

    DECLARE integer VARIABLES.text_size   = LENGTH(NVL(CAST("NEW".text AS string),''));

    UPDATE OpenWorks_SM.INoteSummary SET
      inote_title           = "NEW".inote_title,
      instance_no           = "NEW".instance_no,
      inote_category_id     = "NEW".inote_category_id,
      data_source           = SUBSTRING("NEW".data_source, 1, 5),
      related_obj_type      = "NEW".related_obj_type,
      related_obj_id        = "NEW".related_obj_id,
      effective_date        = "NEW".effective_date,
      min_geologic_age      = "NEW".min_geologic_age,
      max_geologic_age      = "NEW".max_geologic_age,
      orig_crs_id           = VARIABLES.orig_crs_id,
      orig_x_lon            = "NEW".orig_x_lon,
      orig_y_lat            = "NEW".orig_y_lat,
      project_x             = "NEW".project_x,
      project_y             = "NEW".project_y,
      z_value               = "NEW".z_value,
      z_value_dsdsunit      = "NEW".z_value_unit,
      z_domain              = "NEW".z_domain,
      z_domain_qualifier    = "NEW".z_domain_qualifier,
      z_datum               = "NEW".z_datum,
      z_datum_dsdsunit      = "NEW".z_datum_unit,
      storage_datum         = "NEW".storage_datum,
      storage_datum_dsdsunit= "NEW".storage_datum_unit,
      markup_ncoord         = "NEW".markup_ncoord,
      markup_coord          = "NEW".markup_coord,
      markup_detail_nbyte   = "NEW".markup_detail_nbyte,
      markup_detail         = "NEW".markup_detail,
      x_offset              = "NEW".x_offset,
      x_offset_dsdsunit     = "NEW".xy_offset_unit,
      y_offset              = "NEW".y_offset,
      y_offset_dsdsunit     = "NEW".xy_offset_unit,
      z_offset              = "NEW".z_offset,
      z_offset_dsdsunit     = "NEW".z_offset_unit,
      text_nchar            = VARIABLES.text_size,
      text                  = "NEW".text,
      box_height            = "NEW".box_height,
      box_width             = "NEW".box_width,
      box_outline           = "NEW".box_outline,
      box_outline_color     = "NEW".box_outline_color,
      box_opacity           = "NEW".box_opacity,
      box_background_color  = "NEW".box_background_color,
      box_border_width      = "NEW".box_border_width,
      box_foreground_color  = "NEW".box_foreground_color,
      local_box             = "NEW".local_box,
      marker_size           = "NEW".marker_size,
      symbol_type           = "NEW".symbol_type,
      symbol_id             = "NEW".symbol_id
    WHERE  native_uid = "OLD".native_uid;
END;

CREATE TRIGGER ON INoteSummary INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC
    DELETE FROM OpenWorks_SM.INoteSummary WHERE native_uid = "OLD".native_uid;
END;


/*
**********************************
* ENTITY: GeoShapeSet
**********************************
*/

CREATE VIEW GeoShapeSet
(
    native_uid             VARCHAR(1024)       OPTIONS("OpenWorksCommonModel:GeoShapeSet.native_uid.isUpdatable" false,
                                                       "OpenWorksCommonModel:GeoShapeSet.native_uid.isCreatable" false,
                                                       UPDATABLE 'FALSE'),
    geo_name               VARCHAR(256)         NOT NULL DEFAULT 'UNKNOWN',
    geo_type               VARCHAR(11)          NOT NULL DEFAULT 'OTHER',
    name                   VARCHAR(256)         NOT NULL DEFAULT 'UNKNOWN',
    data_source            VARCHAR(5)           NOT NULL,
    basin_name             VARCHAR(60)          DEFAULT 'UNKNOWN',
    field_name             VARCHAR(60)          DEFAULT 'UNKNOWN',
    play_name              VARCHAR(40)          DEFAULT 'UNKNOWN',
    pool_name              VARCHAR(40)          DEFAULT 'UNKNOWN',
    shape_set_type         VARCHAR(40),
    strat_column           VARCHAR(40)          DEFAULT 'UNKNOWN',
    min_x                  DOUBLE               OPTIONS("OpenWorksCommonModel:GeoShapeSet.min_x.unitField" 'xy_unit'),
    max_x                  DOUBLE               OPTIONS("OpenWorksCommonModel:GeoShapeSet.max_x.unitField" 'xy_unit'),
    min_y                  DOUBLE               OPTIONS("OpenWorksCommonModel:GeoShapeSet.min_y.unitField" 'xy_unit'),
    max_y                  DOUBLE               OPTIONS("OpenWorksCommonModel:GeoShapeSet.max_y.unitField" 'xy_unit'),
    xy_unit                VARCHAR(64)          OPTIONS("OpenWorksCommonModel:GeoShapeSet.xy_unit.unitType" 'project coordinate'),
    crs                    VARCHAR(80),
    z_domain               VARCHAR(13)          NOT NULL,
    z_domain_qualifier     VARCHAR(25),
    datum                  FLOAT                OPTIONS("OpenWorksCommonModel:GeoShapeSet.datum.unitField" 'datum_unit'),
    datum_unit             VARCHAR(64)          OPTIONS("OpenWorksCommonModel:GeoShapeSet.working_datum_unit.unitType" 'elevation'),
    remark                 VARCHAR(200),
    num_nodes              INTEGER,
    nodes                  BLOB                 OPTIONS("OpenWorksCommonModel:GeoShapeSet.nodes.unitField" 'nodes_unit'),
    num_shapes             INTEGER,
    shapes                 BLOB,
    create_date            TIMESTAMP            OPTIONS("OpenWorksCommonModel:GeoShapeSet.create_date.isUpdatable" false,
                                                        "OpenWorksCommonModel:GeoShapeSet.create_date.isCreatable" false,
                                                        UPDATABLE 'FALSE'),
    create_user_id         VARCHAR(32)          OPTIONS("OpenWorksCommonModel:GeoShapeSet.create_user_id.isUpdatable" false,
                                                        "OpenWorksCommonModel:GeoShapeSet.create_user_id.isCreatable" false,
                                                        UPDATABLE 'FALSE'),
    update_date            TIMESTAMP            OPTIONS("OpenWorksCommonModel:GeoShapeSet.update_date.isUpdatable" false,
                                                        "OpenWorksCommonModel:GeoShapeSet.update_date.isCreatable" false,
                                                        UPDATABLE 'FALSE'),
    update_user_id         VARCHAR(32)          OPTIONS("OpenWorksCommonModel:GeoShapeSet.update_user_id.isUpdatable" false,
                                                        "OpenWorksCommonModel:GeoShapeSet.update_user_id.isCreatable" false,
                                                        UPDATABLE 'FALSE'),
    alternate_uid    	   VARCHAR(4000)          OPTIONS("OpenWorksCommonModel:GeoShapeSet.alternate_uid.isCreatable" false,
                                                        "OpenWorksCommonModel:GeoShapeSet.alternate_uid.isUpdatable" false,
                                                        UPDATABLE 'FALSE'),
    spatial                BLOB,
    CONSTRAINT GeoShapeSet_PK PRIMARY KEY (native_uid),

    CONSTRAINT GeoShapeSet_UK1 UNIQUE (geo_name, geo_type, name, data_source),

    CONSTRAINT FK_GeoShapeSet_data_source
    FOREIGN KEY (data_source)
    REFERENCES DataSource(name),

    CONSTRAINT FK_GeoShapeSet_strat_unit_name
    FOREIGN KEY (geo_name)
    REFERENCES RefStratigraphicUnitName(strat_unit_name),

    CONSTRAINT FK_GeoShapeSet_field_name
    FOREIGN KEY (field_name)
    REFERENCES Field(field_name),

    CONSTRAINT FK_GeoShapeSet_crs
    FOREIGN KEY (crs)
    REFERENCES CartoReferenceSystem(name)

)
OPTIONS (UPDATABLE 'TRUE', GeoShapeSet.IMPLEMENTED 'TRUE')
  AS
  SELECT
     shape_set_id                               AS  native_uid,
     geo_name,
     geo_type,
     OpenWorks_SM.GeoShapeSet.name              AS name,
     data_source,
     basin_name,
     field_name,
     play_name,
     pool_name,
     shape_set_type,
     strat_column,
     min_x,
     max_x,
     min_y,
     max_y,
     coalesce(OpenWorks_SM.GeoShapeSet.min_x_dsdsunit, OpenWorks_SM.GeoShapeSet.max_x_dsdsunit) AS xy_unit,
     getDSDSCrs(OpenWorks_SM.CartoRefSys.name)  AS crs,
     z_domain,
     z_domain_qualifier,
     working_datum                              AS datum,
     working_datum_dsdsunit                     AS datum_unit,
     OpenWorks_SM.GeoShapeSet.remark            AS remark,
     num_nodes,
     nodes,
     num_shapes,
     shapes,
     OpenWorks_SM.GeoShapeSet.create_date       AS create_date,
     OpenWorks_SM.GeoShapeSet.create_user_id    AS create_user_id,
     OpenWorks_SM.GeoShapeSet.update_date       AS update_date,
     OpenWorks_SM.GeoShapeSet.update_user_id    AS update_user_id,
     OpenWorks_SM.GeoShapeSet.native_uid        AS alternate_uid,
     spatial
  FROM
    OpenWorks_SM.GeoShapeSet LEFT OUTER JOIN /*+ optional */ OpenWorks_SM.CartoRefSys ON wrk_crs_id = id;

CREATE TRIGGER ON GeoShapeSet INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC

  DECLARE string VARIABLES.crs_errorMsg= CONCAT (CONCAT('ERROR: The given crs value "',"NEW".crs),'" does not exist in OpenWorks or an equivalent mapping does not exist in DSDS');

  DECLARE string VARIABLES.crs_id;
  IF("NEW".crs IS NOT NULL)
  BEGIN
      VARIABLES.crs_id = (SELECT id FROM OpenWorks_SM.CartoRefSys WHERE name = (SELECT * FROM (EXEC OpenWorks_SM.GetNativeCRS("NEW".crs,'OW')) AS SysGenID));
          IF(VARIABLES.crs_id is NULL)
              ERROR VARIABLES.crs_errorMsg;
  END

  DECLARE integer VARIABLES.shape_set_id    = (SELECT * FROM (EXEC OpenWorks_SM.nextval('GeoShapeSet')) AS SysGenID);

  INSERT INTO OpenWorks_SM.GeoShapeSet
         (shape_set_id,           geo_name,       geo_type,       name,       data_source,                        basin_name,       field_name,       play_name,       pool_name,       shape_set_type,       strat_column,       min_x,       max_x,       min_y,       max_y,       crs_id,           z_domain,       z_domain_qualifier,       storage_datum, storage_datum_dsdsunit, remark,       num_nodes,       nodes,       num_shapes,       shapes)
  VALUES (VARIABLES.shape_set_id, "NEW".geo_name, "NEW".geo_type, "NEW".name, SUBSTRING("NEW".data_source, 1, 5), "NEW".basin_name, "NEW".field_name, "NEW".play_name, "NEW".pool_name, "NEW".shape_set_type, "NEW".strat_column, "NEW".min_x, "NEW".max_x, "NEW".min_y, "NEW".max_y, VARIABLES.crs_id, "NEW".z_domain, "NEW".z_domain_qualifier, "NEW".datum,   "NEW".datum_unit,       "NEW".remark, "NEW".num_nodes, "NEW".nodes, "NEW".num_shapes, "NEW".shapes);

END;

Create Trigger on GeoShapeSet INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC

  DECLARE string VARIABLES.crs_errorMsg= CONCAT (CONCAT('ERROR: The given crs value "',"NEW".crs),'" does not exist in OpenWorks or an equivalent mapping does not exist in DSDS');

  DECLARE string VARIABLES.crs_id;
  IF("NEW".crs IS NOT NULL)
  BEGIN
    VARIABLES.crs_id = (SELECT id FROM OpenWorks_SM.CartoRefSys WHERE name = (SELECT * FROM (EXEC OpenWorks_SM.GetNativeCRS("NEW".crs,'OW')) AS SysGenID));
      IF(VARIABLES.crs_id is NULL)
        ERROR VARIABLES.crs_errorMsg;
  END

  UPDATE OpenWorks_SM.GeoShapeSet SET
     geo_name                   = "NEW".geo_name,
     geo_type                   = "NEW".geo_type,
     name                       = "NEW".name,
     data_source                = SUBSTRING("NEW".data_source, 1, 5),
     basin_name                 = "NEW".basin_name,
     field_name                 = "NEW".field_name,
     play_name                  = "NEW".play_name,
     pool_name                  = "NEW".pool_name,
     shape_set_type             = "NEW".shape_set_type,
     strat_column               = "NEW".strat_column,
     min_x                      = "NEW".min_x,
     max_x                      = "NEW".max_x,
     min_y                      = "NEW".min_y,
     max_y                      = "NEW".max_y,
     crs_id                     = VARIABLES.crs_id,
     z_domain                   = "NEW".z_domain,
     z_domain_qualifier         = "NEW".z_domain_qualifier,
     storage_datum              = "NEW".datum,
     storage_datum_dsdsunit     = "NEW".datum_unit,
     remark                     = "NEW".remark,
     num_nodes                  = "NEW".num_nodes,
     nodes                      = "NEW".nodes,
     num_shapes                 = "NEW".num_shapes,
     shapes                     = "NEW".shapes
  WHERE  native_uid = "OLD".native_uid;
END;

CREATE TRIGGER ON GeoShapeSet INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC
  DELETE FROM OpenWorks_SM.GeoShapeSet WHERE native_uid = "OLD".native_uid;
END;


/*
**********************************
* ENTITY: GeoShapeAttribute
**********************************
*/


CREATE VIEW GeoShapeAttribute
(
    native_uid             VARCHAR(1024) 	      OPTIONS("OpenWorksCommonModel:GeoShapeAttribute.native_uid.isUpdatable" false,
                                                        "OpenWorksCommonModel:GeoShapeAttribute.native_uid.isCreatable" false,
                                                        UPDATABLE 'FALSE'),
    geoshapeset_native_uid VARCHAR(1024)        NOT NULL,
    attribute_name         VARCHAR(40)          NOT NULL DEFAULT 'UNKNOWN',
    unit_type              VARCHAR(64)          OPTIONS("OpenWorksCommonModel:GeoShapeAttribute.unit_type.isUpdatable" false,
                                                        "OpenWorksCommonModel:GeoShapeAttribute.unit_type.isCreatable" false,
                                                        UPDATABLE 'FALSE'),
    data_type              VARCHAR(8)           NOT NULL,
    no_data_value          FLOAT,
    remark                 VARCHAR(200),
    num_shapes             INTEGER,
    shape_attributes       BLOB,
    create_date            TIMESTAMP            OPTIONS("OpenWorksCommonModel:GeoShapeAttribute.create_date.isUpdatable" false,
                                                        "OpenWorksCommonModel:GeoShapeAttribute.create_date.isCreatable" false,
                                                        UPDATABLE 'FALSE'),
    create_user_id         VARCHAR(32)          OPTIONS("OpenWorksCommonModel:GeoShapeAttribute.create_user_id.isUpdatable" false,
                                                        "OpenWorksCommonModel:GeoShapeAttribute.create_user_id.isCreatable" false,
                                                        UPDATABLE 'FALSE'),
    update_date            TIMESTAMP            OPTIONS("OpenWorksCommonModel:GeoShapeAttribute.update_date.isUpdatable" false,
                                                        "OpenWorksCommonModel:GeoShapeAttribute.update_date.isCreatable" false,
                                                        UPDATABLE 'FALSE'),
    update_user_id         VARCHAR(32)          OPTIONS("OpenWorksCommonModel:GeoShapeAttribute.update_user_id.isUpdatable" false,
                                                        "OpenWorksCommonModel:GeoShapeAttribute.update_user_id.isCreatable" false,
                                                        UPDATABLE 'FALSE'),
    alternate_uid    	   VARCHAR(4000)        OPTIONS("OpenWorksCommonModel:GeoShapeAttribute.alternate_uid.isCreatable" false,
                                                        "OpenWorksCommonModel:GeoShapeAttribute.alternate_uid.isUpdatable" false,
                                                         UPDATABLE 'FALSE'),

    CONSTRAINT GeoShapeAttribute_PK PRIMARY KEY (native_uid),

    CONSTRAINT GeoShapeAttribute_UK1 UNIQUE (geoshapeset_native_uid, attribute_name),

    CONSTRAINT FK_GeoShapeAttribute_geoshapeset_native_uid
    FOREIGN KEY (geoshapeset_native_uid)
    REFERENCES GeoShapeSet(native_uid)


)
OPTIONS (UPDATABLE 'TRUE', GeoShapeAttribute.IMPLEMENTED 'TRUE')
    AS
    SELECT
        OpenWorks_SM.GeoShapeAttribute.native_uid                   AS native_uid,
        OpenWorks_SM.GeoShapeSet.shape_set_id                       AS geoshapeset_native_uid,
        attribute_name,
        unit_type_id                                                AS unit_type,
        data_type,
        no_data_value,
        OpenWorks_SM.GeoShapeAttribute.remark                       AS remark,
        OpenWorks_SM.GeoShapeAttribute.num_shapes                   AS num_shapes,
        shape_attributes,
        OpenWorks_SM.GeoShapeAttribute.create_date                  AS create_date,
        OpenWorks_SM.GeoShapeAttribute.create_user_id               AS create_user_id,
        OpenWorks_SM.GeoShapeAttribute.update_date                  AS update_date,
        OpenWorks_SM.GeoShapeAttribute.update_user_id               AS update_user_id,
        OpenWorks_SM.GeoShapeAttribute.native_uid                   AS alternate_uid
    FROM
        OpenWorks_SM.GeoShapeAttribute LEFT OUTER JOIN OpenWorks_SM.GeoShapeSet ON OpenWorks_SM.GeoShapeSet.shape_set_id = OpenWorks_SM.GeoShapeAttribute.shape_set_id;

CREATE TRIGGER ON GeoShapeAttribute INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC

  DECLARE string VARIABLES.geoshapeset_native_uid_errorMsg= CONCAT (CONCAT('ERROR: The given shape set id "',"NEW".geoshapeset_native_uid),'" does not exist.');
  DECLARE string VARIABLES.geoshapeset_native_uid;
  IF("NEW".geoshapeset_native_uid IS NOT NULL)
  BEGIN
      VARIABLES.geoshapeset_native_uid = (SELECT shape_set_id FROM OpenWorks_SM.GeoShapeSet WHERE shape_set_id="NEW".geoshapeset_native_uid);
          IF(VARIABLES.geoshapeset_native_uid is NULL)
              ERROR VARIABLES.geoshapeset_native_uid_errorMsg;
  END

  INSERT INTO OpenWorks_SM.GeoShapeAttribute
         (shape_set_id,                     attribute_name,       data_type,       no_data_value,       remark,       num_shapes,       shape_attributes)
  VALUES (VARIABLES.geoshapeset_native_uid, "NEW".attribute_name, "NEW".data_type, "NEW".no_data_value, "NEW".remark, "NEW".num_shapes, "NEW".shape_attributes);

END;

Create Trigger on GeoShapeAttribute INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC

  DECLARE string VARIABLES.geoshapeset_native_uid_errorMsg= CONCAT (CONCAT('ERROR: The given shape set id "',"NEW".geoshapeset_native_uid),'" does not exist.');

  DECLARE string VARIABLES.geoshapeset_native_uid;
  IF("NEW".geoshapeset_native_uid IS NOT NULL)
  BEGIN
      VARIABLES.geoshapeset_native_uid = (SELECT shape_set_id FROM OpenWorks_SM.GeoShapeSet WHERE shape_set_id="NEW".geoshapeset_native_uid);
          IF(VARIABLES.geoshapeset_native_uid is NULL)
              ERROR VARIABLES.geoshapeset_native_uid_errorMsg;
  END

  UPDATE OpenWorks_SM.GeoShapeAttribute SET
      attribute_name               = "NEW".attribute_name,
      data_type                    = "NEW".data_type,
      no_data_value                = "NEW".no_data_value,
      remark                       = "NEW".remark,
      num_shapes                   = "NEW".num_shapes,
      shape_attributes             = "NEW".shape_attributes
  WHERE  native_uid = "OLD".native_uid;
END;

CREATE TRIGGER ON GeoShapeAttribute INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC
    DELETE FROM OpenWorks_SM.GeoShapeAttribute WHERE native_uid = "OLD".native_uid;
END;



