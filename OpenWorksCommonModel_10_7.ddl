**********************************
*/
CREATE VIEW ProjectAccess
  (
    project_name            VARCHAR(20) NOT NULL,
    user_id                 VARCHAR(32) NOT NULL,
    security_level          INTEGER,
    create_date             timestamp,
    create_user_id          VARCHAR(32),
    update_date             timestamp,
    update_user_id          VARCHAR(32),
    mobile_db_admin         VARCHAR(1),
    orig_security_level     INTEGER ,

    CONSTRAINT ProjectAccess_PK PRIMARY KEY (user_id)

  )
  OPTIONS
  (
    UPDATABLE 'FALSE',
    ProjectAccess.IMPLEMENTED 'TRUE'
  )
   AS
 SELECT
    project_name ,
    user_id ,
    security_level ,
    create_date ,
    create_user_id  ,
    update_date     ,
    update_user_id  ,
    mobile_db_admin ,
    orig_security_level
FROM OpenWorks_SM.ProjUser;


