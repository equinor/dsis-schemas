        geologic_feature = "NEW".geologic_feature,
        fault_set_type = "NEW".fault_set_type,
        data_domain = "NEW".data_domain,
        z_domain_qualifier = "NEW".z_domain_qualifier,
        x_min = "NEW".x_min,
        x_max = "NEW".x_max,
        z_min = "NEW".data_min,
        z_max = "NEW".data_max,
        z_max_dsdsunit = "NEW".z_unit,
        z_min_dsdsunit = "NEW".z_unit,
        y_min = "NEW".y_min,
        y_max = "NEW".y_max,
        grid_intvl_x = "NEW".grid_interval_x,
        grid_intvl_y = "NEW".grid_interval_y,
        no_cols = "NEW".num_cols,
        no_rows = "NEW".num_rows,
        /*rotation_i = "NEW".rotation_i,
        rotation_j = "NEW".rotation_j,
        rotation_unit = "NEW".rotation_unit,
        rotation_origin_x = "NEW".rotation_origin_x,
        rotation_origin_y = "NEW".rotation_origin_y,*/
        OpenWorks_SM.Rgrid.znon = "NEW".data_null_value,
        unit_desc = "NEW".z_unit,
        unit_type_id = "NEW".z_unit_type,
        remark = SUBSTRING("NEW".remark, 1, 200)
      WHERE (data_source = "OLD".data_source) AND (geo_name = "OLD".geo_name) AND (map_data_set_name = "OLD".map_data_set_name)
      AND (attribute = "OLD".attribute) AND (geo_type = "OLD".geo_type) AND (OpenWorks_SM.Rgrid.grid_id = "OLD".native_uid);
    END

END;

CREATE TRIGGER ON SurfaceGridProperties INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC
    DELETE FROM OpenWorks_SM.Rgrid WHERE grid_id = "OLD".native_uid;
END;


/*
**********************************
*     "MappingPolygonSet"
**********************************
*/

CREATE VIEW MappingPolygonSet
(
  native_uid                    VARCHAR(1024)   OPTIONS("OpenWorksCommonModel:MappingPolygonSet.native_uid.isUpdatable" false,
                                                  "OpenWorksCommonModel:MappingPolygonSet.native_uid.isCreatable" false,
                                                          UPDATABLE 'FALSE'),
  surface_name                  VARCHAR(40)  DEFAULT 'UNKNOWN',
  polygon_set_name              VARCHAR(40)  NOT NULL,
  data_source                   VARCHAR(5)   NOT NULL,
  datum                         FLOAT        OPTIONS ("OpenWorksCommonModel:MappingPolygonSet.datum.unitField" 'datum_unit'),
  depth_domain                  VARCHAR(12),
  z_domain_qualifier            VARCHAR(24),
  unit_desc                     VARCHAR(30),
  max_x                         DOUBLE       NOT NULL    OPTIONS("OpenWorksCommonModel:MappingPolygonSet.max_x.unitField" 'xy_unit'),
  max_y                         DOUBLE       NOT NULL    OPTIONS("OpenWorksCommonModel:MappingPolygonSet.max_y.unitField" 'xy_unit'),
  min_x                         DOUBLE       NOT NULL    OPTIONS("OpenWorksCommonModel:MappingPolygonSet.min_x.unitField" 'xy_unit'),
  min_y                         DOUBLE       NOT NULL    OPTIONS("OpenWorksCommonModel:MappingPolygonSet.min_y.unitField" 'xy_unit'),
  no_data_value                 FLOAT,
  crs                           VARCHAR(80)  NOT NULL,
  polygon_set_data_type          VARCHAR(40) DEFAULT 'FAULT',
  remark                        VARCHAR(200),
  xy_unit                       VARCHAR(64),
  original_data_source          VARCHAR(5),
  datum_unit                    VARCHAR(64)  OPTIONS ("OpenWorksCommonModel:MappingPolygonSet.datum_unit.unitType" 'elevation'),
  processing_parameter_nbytes   INTEGER,
  processing_parameter          CLOB,
  create_date                   TIMESTAMP    OPTIONS("OpenWorksCommonModel:MappingPolygonSet.create_date.isUpdatable" false,
                                                     "OpenWorksCommonModel:MappingPolygonSet.create_date.isCreatable" false,
                                                      UPDATABLE 'FALSE'),
  create_user_id                VARCHAR(32)  OPTIONS("OpenWorksCommonModel:MappingPolygonSet.create_user_id.isUpdatable" false,
                                                     "OpenWorksCommonModel:MappingPolygonSet.create_user_id.isCreatable" false,
                                                      UPDATABLE 'FALSE'),
  update_date                   TIMESTAMP    OPTIONS("OpenWorksCommonModel:MappingPolygonSet.update_date.isUpdatable" false,
                                                     "OpenWorksCommonModel:MappingPolygonSet.update_date.isCreatable" false,
                                                      UPDATABLE 'FALSE'),
  update_user_id                VARCHAR(32)  OPTIONS("OpenWorksCommonModel:MappingPolygonSet.update_user_id.isUpdatable" false,
                                                     "OpenWorksCommonModel:MappingPolygonSet.update_user_id.isCreatable" false,
                                                      UPDATABLE 'FALSE'),
  alternate_uid    		            VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:MappingPolygonSet.alternate_uid.isCreatable" false,
                                                       "OpenWorksCommonModel:MappingPolygonSet.alternate_uid.isUpdatable" false,
                                                       UPDATABLE 'FALSE'),

    CONSTRAINT MappingPolygonSet_PK PRIMARY KEY (native_uid),

    CONSTRAINT MappingPolygonSet_UK1 UNIQUE (polygon_set_name, data_source),

    CONSTRAINT FK_MappingPolygonSet_data_source
        FOREIGN KEY (data_source)
        REFERENCES DataSource(name),

    CONSTRAINT FK_MappingPolygonSet_original_data_source
        FOREIGN KEY (original_data_source)
        REFERENCES DataSource(name)

)
OPTIONS(UPDATABLE 'TRUE',MappingPolygonSet.IMPLEMENTED 'TRUE')
AS
SELECT
         OpenWorks_SM.MappingPolySet.polygon_set_id AS native_uid,
         OpenWorks_SM.MappingPolySet.surface_name,
         OpenWorks_SM.MappingPolySet.polygon_set_name,
         OpenWorks_SM.MappingPolySet.data_source,
         OpenWorks_SM.MappingPolySet.working_datum AS datum,
         OpenWorks_SM.MappingPolySet.depth_domain,
         OpenWorks_SM.MappingPolySet.z_domain_qualifier,
         OpenWorks_SM.MappingPolySet.unit_desc,
         OpenWorks_SM.MappingPolySet.max_x,
         OpenWorks_SM.MappingPolySet.max_y,
         OpenWorks_SM.MappingPolySet.min_x,
         OpenWorks_SM.MappingPolySet.min_y,
         OpenWorks_SM.MappingPolySet.no_data_value,
         getDSDSCrs(OpenWorks_SM.CartoRefSys.name) AS crs,
         OpenWorks_SM.MappingPolySet.polygon_set_datatype,
         OpenWorks_SM.MappingPolySet.remark,
         coalesce(OpenWorks_SM.MappingPolySet.min_x_dsdsunit, OpenWorks_SM.MappingPolySet.max_x_dsdsunit) AS xy_unit,
         OpenWorks_SM.MappingPolySet.original_data_source,
         OpenWorks_SM.MappingPolySet.working_datum_dsdsunit AS datum_unit,
         OpenWorks_SM.MappingPolySet.processing_parameter_nbytes,
         OpenWorks_SM.MappingPolySet.processing_parameter,
         OpenWorks_SM.MappingPolySet.create_date,
         OpenWorks_SM.MappingPolySet.create_user_id,
         OpenWorks_SM.MappingPolySet.update_date,
         OpenWorks_SM.MappingPolySet.update_user_id,
         OpenWorks_SM.MappingPolySet.native_uid AS alternate_uid
    FROM
        OpenWorks_SM.MappingPolySet, OpenWorks_SM.CartoRefSys
    WHERE
        OpenWorks_SM.MappingPolySet.crs_id = OpenWorks_SM.CartoRefSys.id;


CREATE TRIGGER ON MappingPolygonSet INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC
     DECLARE string VARIABLES.crs_errorMsg='ERROR: The given value for crs does not exist';
    DECLARE integer VARIABLES.poly_set_id = (SELECT * FROM (EXEC OpenWorks_SM.nextval('MappingPolySet')) AS SysGenID);


    DECLARE string VARIABLES.crs_id;
    IF("NEW".crs is NOT NULL)
    BEGIN
    VARIABLES.crs_id     = (SELECT id FROM OpenWorks_SM.CartoRefSys WHERE name = (SELECT * FROM (EXEC OpenWorks_SM.GetNativeCRS(SUBSTRING("NEW".crs, 1, 80), 'OW')) AS SysGenID));
    IF(VARIABLES.crs_id is NULL) ERROR VARIABLES.crs_errorMsg;
    END


    INSERT INTO OpenWorks_SM.MappingPolySet
           (polygon_set_id, surface_name,                         polygon_set_name,                         data_source,                        storage_datum, storage_datum_dsdsunit, depth_domain,                         z_domain_qualifier,                         unit_desc,                         max_x,       max_y,       min_x,       min_y,       no_data_value,       crs_id, polygon_set_datatype,                          remark,                          original_data_source,                        processing_parameter_nbytes,       processing_parameter)
    VALUES (poly_set_id,    SUBSTRING("NEW".surface_name, 1, 40), SUBSTRING("NEW".polygon_set_name, 1, 40), SUBSTRING("NEW".data_source, 1, 5), "NEW".datum,   "NEW".datum_unit,       SUBSTRING("NEW".depth_domain, 1, 12), SUBSTRING("NEW".z_domain_qualifier, 1, 24), SUBSTRING("NEW".unit_desc, 1, 30), "NEW".max_x, "NEW".max_y, "NEW".min_x, "NEW".min_y, "NEW".no_data_value, crs_id, SUBSTRING("NEW".polygon_set_data_type, 1, 40), SUBSTRING("NEW".remark, 1, 200), SUBSTRING("NEW".original_data_source, 1, 5), "NEW".processing_parameter_nbytes, "NEW".processing_parameter);
END;

CREATE TRIGGER ON MappingPolygonSet INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC
  DECLARE string VARIABLES.crs_errorMsg='ERROR: The given value for crs does not exist';
    DECLARE integer VARIABLES.poly_set_id = (SELECT * FROM (EXEC OpenWorks_SM.nextval('MappingPolySet')) AS SysGenID);

    DECLARE string VARIABLES.crs_id;
    IF("NEW".crs is NOT NULL)
    BEGIN
    VARIABLES.crs_id     = (SELECT id FROM OpenWorks_SM.CartoRefSys WHERE name = (SELECT * FROM (EXEC OpenWorks_SM.GetNativeCRS(SUBSTRING("NEW".crs, 1, 80), 'OW')) AS SysGenID));
    IF(VARIABLES.crs_id is NULL) ERROR VARIABLES.crs_errorMsg;
    END

    UPDATE OpenWorks_SM.MappingPolySet SET surface_name = SUBSTRING("NEW".surface_name, 1, 40), storage_datum = "NEW".datum, storage_datum_dsdsunit = "NEW".datum_unit, depth_domain = SUBSTRING("NEW".depth_domain, 1, 12), z_domain_qualifier = SUBSTRING("NEW".z_domain_qualifier, 1, 24), unit_desc = SUBSTRING("NEW".unit_desc, 1, 30), max_x = "NEW".max_x, max_y = "NEW".max_y, min_x = "NEW".min_x, min_y = "NEW".min_y, no_data_value = "NEW".no_data_value, crs_id = VARIABLES.crs_id, polygon_set_datatype = SUBSTRING("NEW".polygon_set_data_type, 1, 40), remark = SUBSTRING("NEW".remark, 1, 200), original_data_source = SUBSTRING("NEW".original_data_source, 1, 5), processing_parameter_nbytes = "NEW".processing_parameter_nbytes, processing_parameter = "NEW".processing_parameter WHERE (polygon_set_name = "OLD".polygon_set_name) AND (data_source = "OLD".data_source);
END;

/*
**********************************
*     "MappingPolygon"
**********************************
*/

CREATE VIEW MappingPolygon
(
  native_uid                          VARCHAR(1024)       OPTIONS("OpenWorksCommonModel:MappingPolygon.native_uid.isUpdatable" false,
                                                                "OpenWorksCommonModel:MappingPolygon.native_uid.isCreatable" false,
                                                                UPDATABLE 'FALSE'),
  mappingpolygonset_native_uid        VARCHAR(1024) NOT NULL,
  polygon_set_name       VARCHAR(40)  OPTIONS("OpenWorksCommonModel:MappingPolygon.polygon_set_name.isUpdatable" false,
                                                                "OpenWorksCommonModel:MappingPolygon.polygon_set_name.isCreatable" false,
                                                                UPDATABLE 'FALSE'),
  data_source            VARCHAR(5)   OPTIONS("OpenWorksCommonModel:MappingPolygon.data_source.isUpdatable" false,
                                                                "OpenWorksCommonModel:MappingPolygon.data_source.isCreatable" false,
                                                                UPDATABLE 'FALSE'),
  polygon_seq_no         INTEGER NOT  NULL,
  fault                  VARCHAR(50)  DEFAULT 'UNKNOWN',
  datum                  FLOAT        OPTIONS("OpenWorksCommonModel:MappingPolygon.datum.unitField" 'datum_unit'),
  depth_domain           VARCHAR(12),
  z_domain_qualifier     VARCHAR(24),
  unit_desc              VARCHAR(30),
  xy_unit                VARCHAR(64),
  datum_unit             VARCHAR(64)  OPTIONS("OpenWorksCommonModel:MappingPolygon.datum_unit.unitType" 'elevation'),
  no_data_value          FLOAT,
  polygon_type           VARCHAR(9)   DEFAULT 'EXCLUSIVE',
  polygon_set_data_type  VARCHAR(40),
  area                   FLOAT        OPTIONS("OpenWorksCommonModel:MappingPolygon.area.unitField" 'area_unit'),
  color                  INTEGER,
  poly_z_value           FLOAT        OPTIONS("OpenWorksCommonModel:MappingPolygon.poly_z_value.unitField" 'poly_z_value_unit'),
  num_points             INTEGER      NOT NULL DEFAULT '0',
  data                   BLOB         NOT NULL
                                      OPTIONS ("OpenWorksCommonModel:MappingPolygon.data.isComplexType" true,
                                               "OpenWorksCommonModel:MappingPolygon.data.isComplexTypeArray" true,
                                               "OpenWorksCommonModel:MappingPolygon.data.elementType" 'MappingPolygonData',
                                               "OpenWorksCommonModel:MappingPolygon.data.elementStruct" '[{"name":"x_coord","type":"float[]"},{"name":"y_coord","type":"float[]"},{"name":"z_value","type":"float[]"},{"name":"throw_direction","type":"String[]"}]',
                                               "OpenWorksCommonModel:MappingPolygon.data.elementMetadata"    '[{"name":"x_coord", "unitField":"xy_unit"}, {"name":"y_coord", "unitField":"xy_unit"}, {"name":"z_value", "unitField":"z_value_unit"}]'),
  spatial                BLOB         OPTIONS ("OpenWorksCommonModel:MappingPolygon.spatial.isSpatial" true,
                                               "OpenWorksCommonModel:MappingPolygon.spatial.isCreatable" false,
                                               "OpenWorksCommonModel:MappingPolygon.spatial.isUpdatable" false,
                                               UPDATABLE 'FALSE',
                                               "OpenWorksCommonModel:MappingPolygon.spatial.isComplexType" true,
                                               "OpenWorksCommonModel:MappingPolygon.spatial.isComplexTypeArray" false,
                                               "OpenWorksCommonModel:MappingPolygon.spatial.elementType" 'LINESTRING',
                                               "OpenWorksCommonModel:MappingPolygon.spatial.elementStruct" '[{"name":"x","type":"double"},{"name":"y","type":"double"},{"name":"z","type":"double"}]'),
  crs                    VARCHAR(80)  NOT NULL,
  z_value_unit           VARCHAR(64)  OPTIONS ("OpenWorksCommonModel:MappingPolygon.z_value_unit.unitType" 'time depth measure'),
  area_unit              VARCHAR(64)  OPTIONS ("OpenWorksCommonModel:MappingPolygon.area_unit.unitType" 'area'),
  poly_z_value_unit      VARCHAR(64)  OPTIONS ("OpenWorksCommonModel:MappingPolygon.poly_z_value_unit.unitType" 'time depth measure'),
  remark                 VARCHAR(200),
 create_date             TIMESTAMP    OPTIONS("OpenWorksCommonModel:MappingPolygon.create_date.isUpdatable" false,
                                              "OpenWorksCommonModel:MappingPolygon.create_date.isCreatable" false,UPDATABLE 'FALSE'),
  create_user_id         VARCHAR(32)  OPTIONS("OpenWorksCommonModel:MappingPolygon.create_user_id.isUpdatable" false,
                                              "OpenWorksCommonModel:MappingPolygon.create_user_id.isCreatable" false,
                                               UPDATABLE 'FALSE'),
  update_date            TIMESTAMP    OPTIONS("OpenWorksCommonModel:MappingPolygon.update_date.isUpdatable" false,
                                              "OpenWorksCommonModel:MappingPolygon.update_date.isCreatable" false,UPDATABLE 'FALSE'),
  update_user_id         VARCHAR(32)  OPTIONS("OpenWorksCommonModel:MappingPolygon.update_user_id.isUpdatable" false,
                                              "OpenWorksCommonModel:MappingPolygon.update_user_id.isCreatable" false,
                                               UPDATABLE 'FALSE'),
  alternate_uid    		    VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:MappingPolygon.alternate_uid.isCreatable" false,
                                               "OpenWorksCommonModel:MappingPolygon.alternate_uid.isUpdatable" false,
                                                UPDATABLE 'FALSE'),

    CONSTRAINT MappingPolygon_PK PRIMARY KEY (native_uid),

    CONSTRAINT MappingPolygon_UK1 UNIQUE (mappingpolygonset_native_uid, polygon_seq_no),

    CONSTRAINT FK_MappingPolygon_mappingpolygonset_native_uid
        FOREIGN KEY                 (mappingpolygonset_native_uid)
        REFERENCES MappingPolygonSet(native_uid),

    CONSTRAINT FK_MappingPolygon_data_source
        FOREIGN KEY (data_source)
        REFERENCES DataSource(name)

)
OPTIONS (UPDATABLE 'TRUE',MappingPolygon.IMPLEMENTED 'TRUE')
AS
SELECT
 OpenWorks_SM.MappingPolygon.native_uid,
 OpenWorks_SM.MappingPolySet.polygon_set_id AS mappingpolygonset_native_uid,
 polygon_set_name,
 OpenWorks_SM.MappingPolySet.data_source,
 poly_seq_no,
 Openworks_SM.fault.name AS fault,
 OpenWorks_SM.MappingPolygon.working_datum AS datum,
 OpenWorks_SM.MappingPolygon.depth_domain,
 OpenWorks_SM.MappingPolygon.z_domain_qualifier,
 OpenWorks_SM.MappingPolygon.unit_desc,
 coalesce(x_coord_dsdsunit, y_coord_dsdsunit) AS xy_unit,
 OpenWorks_SM.MappingPolygon.working_datum_dsdsunit AS datum_unit,
 OpenWorks_SM.MappingPolygon.no_data_value,
 polygon_type,
 OpenWorks_SM.MappingPolygon.polygon_set_datatype,
 area,
 color,
 poly_z_value,
 num_points,
 combineBlobs(x_coord, y_coord, z_value, fetchNRenameBlob(throw_direction,'throw_direction','','string')) AS data,
 OpenWorks_SM.MappingPolygon.spatial,
 getDSDSCrs(OpenWorks_SM.CartoRefSys.name) AS crs,
 z_value_dsdsunit AS z_value_unit,
 area_dsdsunit AS area_unit,
 poly_z_value_dsdsunit AS poly_z_value_unit,
 null AS remark,
 OpenWorks_SM.MappingPolygon.create_date,
 OpenWorks_SM.MappingPolygon.create_user_id,
 OpenWorks_SM.MappingPolygon.update_date,
 OpenWorks_SM.MappingPolygon.update_user_id,
 OpenWorks_SM.MappingPolygon.native_uid
    FROM
        OpenWorks_SM.MappingPolygon, OpenWorks_SM.MappingPolySet, OpenWorks_SM.Fault, Openworks_SM.cartoRefSys
    WHERE
        (OpenWorks_SM.MappingPolygon.polygon_set_id = OpenWorks_SM.MappingPolySet.polygon_set_id) AND (Fault = Fault.name) AND (crs_id = Openworks_SM.cartoRefSys.id);

CREATE TRIGGER ON MappingPolygon INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC

/* DECLARE string VARIABLES.crs_errorMsg='ERROR: The given value for crs does not exist';
    DECLARE integer VARIABLES.crs_id;
   IF("NEW".crs is NOT NULL)
    BEGIN
    VARIABLES.crs_id     = (SELECT id FROM OpenWorks_SM.CartoRefSys WHERE name = (SELECT * FROM (EXEC OpenWorks_SM.GetNativeCRS(SUBSTRING("NEW".crs, 1, 80), 'OW')) AS SysGenID));
    IF(VARIABLES.crs_id is NULL) ERROR VARIABLES.crs_errorMsg;
    END
    */

   DECLARE string VARIABLES.poly_set_id_errorMsg='ERROR: The MappingPolygonSet with given values for (polygon_set_name,data_source) does not exist';
    DECLARE string VARIABLES.poly_set_id = (SELECT polygon_set_id FROM Openworks_SM.MappingPolySet WHERE polygon_set_id = "NEW".mappingpolygonset_native_uid);

    IF(VARIABLES.poly_set_id is NULL) ERROR VARIABLES.poly_set_id_errorMsg;


    INSERT INTO OpenWorks_SM.MappingPolygon (OpenWorks_SM.MappingPolygon.polygon_set_id, OpenWorks_SM.MappingPolygon.poly_seq_no, OpenWorks_SM.MappingPolygon.fault, OpenWorks_SM.MappingPolygon.storage_datum, OpenWorks_SM.MappingPolygon.polygon_type,OpenWorks_SM.MappingPolygon.area, OpenWorks_SM.MappingPolygon.area_dsdsunit, OpenWorks_SM.MappingPolygon.color, OpenWorks_SM.MappingPolygon.poly_z_value, OpenWorks_SM.MappingPolygon.poly_z_value_dsdsunit, OpenWorks_SM.MappingPolygon.num_points, OpenWorks_SM.MappingPolygon.x_coord, OpenWorks_SM.MappingPolygon.y_coord, OpenWorks_SM.MappingPolygon.z_value, OpenWorks_SM.MappingPolygon.z_value_dsdsunit, OpenWorks_SM.MappingPolygon.throw_direction) VALUES (VARIABLES.poly_set_id, "NEW".polygon_seq_no, SUBSTRING("NEW".fault, 1, 50), "NEW".datum, "NEW".polygon_type, "NEW".area, "NEW".area_unit, "NEW".color, "NEW".poly_z_value, "NEW".poly_z_value_unit, "NEW".num_points, fetchBlob("NEW".data, 'x_coord'), fetchBlob("NEW".data, 'y_coord'), fetchBlob("NEW".data, 'z_value'), "NEW".z_value_unit, fetchNRenameBlob("NEW".data,'throw_direction','','char'));
END;

CREATE TRIGGER ON MappingPolygon INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC
 /*DECLARE string VARIABLES.crs_errorMsg='ERROR: The given value for crs does not exist';
 DECLARE integer VARIABLES.crs_id;
 IF("NEW".crs is NOT NULL)
    BEGIN
    VARIABLES.crs_id     = (SELECT id FROM OpenWorks_SM.CartoRefSys WHERE name = (SELECT * FROM (EXEC OpenWorks_SM.GetNativeCRS(SUBSTRING("NEW".crs, 1, 80), 'OW')) AS SysGenID));
    IF(VARIABLES.crs_id is NULL) ERROR VARIABLES.crs_errorMsg;
    END
    */
 DECLARE string VARIABLES.poly_set_id_errorMsg='ERROR: The MappingPolygonSet with given values for (polygon_set_name,data_source) does not exist';

     DECLARE string VARIABLES.poly_set_id = (SELECT polygon_set_id FROM Openworks_SM.MappingPolySet WHERE polygon_set_id = "NEW".mappingpolygonset_native_uid);
     IF(VARIABLES.poly_set_id is NULL) ERROR VARIABLES.poly_set_id_errorMsg;

    UPDATE OpenWorks_SM.MappingPolygon SET fault = SUBSTRING("NEW".fault, 1, 50), storage_datum = "NEW".datum, polygon_type = "NEW".polygon_type,area = "NEW".area, area_dsdsunit = "NEW".area_unit, color = "NEW".color, poly_z_value = "NEW".poly_z_value, poly_z_value_dsdsunit = "NEW".poly_z_value_unit, num_points = "NEW".num_points, x_coord = fetchBlob("NEW".data, 'x_coord'), y_coord = fetchBlob("NEW".data, 'y_coord'), z_value = fetchBlob("NEW".data, 'z_value'), throw_direction = fetchNRenameBlob("NEW".data,'throw_direction','','char') WHERE  native_uid="OLD".native_uid;
END;



CREATE TRIGGER ON MappingPolygon INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC
    DELETE FROM OpenWorks_SM.MappingPolygon WHERE native_uid = "OLD".native_uid;
END;

/*
**********************************
*     "PointSet"
**********************************
*/
CREATE VIEW PointSet
(
  native_uid                    VARCHAR(1024)   OPTIONS("OpenWorksCommonModel:PointSet.native_uid.isUpdatable" false,
                                                        "OpenWorksCommonModel:PointSet.native_uid.isCreatable" false,
                                                         UPDATABLE 'FALSE'),
  map_data_set_name             VARCHAR(24) NOT NULL,
  geo_type                      VARCHAR(10) NOT NULL,
  geo_name                      VARCHAR(50) NOT NULL,
  data_source                   VARCHAR(5)  NOT NULL,
  point_set_type                VARCHAR(9)  NOT NULL,
  strat_column                  VARCHAR(40) DEFAULT 'UNKNOWN',
  geologic_feature              VARCHAR(40) DEFAULT 'UNKNOWN',
  default_znon                  DOUBLE,
  sorted                        VARCHAR(1),
  min_x                         DOUBLE      NOT NULL   OPTIONS ("OpenWorksCommonModel:PointSet.min_x.unitField" 'xy_unit'),
  max_x                         DOUBLE      NOT NULL   OPTIONS ("OpenWorksCommonModel:PointSet.max_x.unitField" 'xy_unit'),
  min_y                         DOUBLE      NOT NULL   OPTIONS ("OpenWorksCommonModel:PointSet.min_y.unitField" 'xy_unit'),
  max_y                         DOUBLE      NOT NULL   OPTIONS ("OpenWorksCommonModel:PointSet.max_y.unitField" 'xy_unit'),
  min_z                         float                  OPTIONS ("OpenWorksCommonModel:PointSet.min_z.unitField" 'z_unit'),
  max_z                         float                  OPTIONS ("OpenWorksCommonModel:PointSet.max_z.unitField" 'z_unit'),
  xy_unit                       VARCHAR(64),
  z_unit                        VARCHAR(64)            OPTIONS ("OpenWorksCommonModel:PointSet.z_unit.unitType" 'time depth measure'),
  z_domain                      VARCHAR(12) NOT NULL,
  datum                         float                  OPTIONS ("OpenWorksCommonModel:PointSet.datum.unitField" 'datum_unit'),
  datum_unit                    VARCHAR(64)            OPTIONS ("OpenWorksCommonModel:PointSet.datum_unit.unitType" 'elevation'),
  crs                           VARCHAR(80) NOT NULL,
  num_points                    INTEGER		NOT NULL,
  data                            BLOB        NOT NULL   OPTIONS ( "OpenWorksCommonModel:PointSet.data.isMedia"      true,
                                                           "OpenWorksCommonModel:PointSet.data.mediaContentType" 'application/octet-stream'),


  original_data_source          VARCHAR(5),
  remark                        VARCHAR(200),
  processing_parameter_nbytes   INTEGER,
  processing_parameter          CLOB,
  create_date                   TIMESTAMP   OPTIONS("OpenWorksCommonModel:PointSet.create_date.isUpdatable" false,
                                                    "OpenWorksCommonModel:PointSet.create_date.isCreatable" false,UPDATABLE 'FALSE'),
  create_user_id                VARCHAR(32) OPTIONS("OpenWorksCommonModel:PointSet.create_user_id.isUpdatable" false,
                                                    "OpenWorksCommonModel:PointSet.create_user_id.isCreatable" false,
                                                    UPDATABLE 'FALSE'),
  update_date                   TIMESTAMP   OPTIONS("OpenWorksCommonModel:PointSet.update_date.isUpdatable" false,
                                                    "OpenWorksCommonModel:PointSet.update_date.isCreatable" false,UPDATABLE 'FALSE'),
  update_user_id                VARCHAR(32) OPTIONS("OpenWorksCommonModel:PointSet.update_user_id.isUpdatable" false,
                                                    "OpenWorksCommonModel:PointSet.update_user_id.isCreatable" false,
                                                     UPDATABLE 'FALSE'),
  alternate_uid    		            VARCHAR(4000) OPTIONS ("OpenWorksCommonModel:PointSet.alternate_uid.isCreatable" false,
                                                       "OpenWorksCommonModel:PointSet.alternate_uid.isUpdatable" false,
                                                        UPDATABLE 'FALSE'),


    CONSTRAINT PointSet_PK PRIMARY KEY (native_uid),

    CONSTRAINT PointSet_UK1 UNIQUE (geo_name, geo_type, map_data_set_name, data_source, point_set_type),

  CONSTRAINT FK_PointSet_data_source
      FOREIGN KEY (data_source)
      REFERENCES DataSource(name),

  CONSTRAINT FK_PointSet_original_data_source
        FOREIGN KEY (original_data_source)
        REFERENCES DataSource(name),
        CONSTRAINT FK_PointSet_crs
        FOREIGN KEY          (crs)
        REFERENCES CartoReferenceSystem(name)


)
OPTIONS(UPDATABLE 'TRUE',PointSet.IMPLEMENTED 'TRUE') AS

SELECT
		point_set_id AS native_uid,
        map_data_set_name,
        geo_type,
        geo_name,
        data_source,
        point_set_type,
        strat_column,
        geologic_feature,
        default_znon,
        sorted,
        min_x,
        max_x,
        min_y,
        max_y,
        zdata.min_z,
        zdata.max_z,
        min_x_dsdsunit AS xy_unit,
        zdata.z_unit,
        zdata.z_domain,
        zdata.datum,
        zdata.datum_unit,
        getDSDSCrs(name) AS crs,
        num_points,
        OpenWorks_SM.PointSet.data,
        original_data_source,
        OpenWorks_SM.PointSet.remark,
        processing_parameter_nbytes,
        processing_parameter,
        OpenWorks_SM.PointSet.create_date,
        OpenWorks_SM.PointSet.create_user_id,
        OpenWorks_SM.PointSet.update_date,
        OpenWorks_SM.PointSet.update_user_id,
        OpenWorks_SM.PointSet.native_uid
                FROM
        OpenWorks_SM.PointSet INNER JOIN (select * from (EXEC ZPointSetTable()) as t1) AS zdata ON OpenWorks_SM.PointSet.point_set_id = zdata.pointsetid, OpenWorks_SM.CartoRefSys
WHERE
        crs_id = id;



CREATE TRIGGER ON PointSet INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC

		DECLARE string VARIABLES.crs_errorMsg='ERROR: The given value for crs does not exist';
        DECLARE integer VARIABLES.point_set_id = (SELECT * FROM (EXEC OpenWorks_SM.nextval('PointSet')) AS SysGenID);

      	DECLARE string VARIABLES.target_crs = (SELECT xy_crs FROM OpenWorksCommonModel.Project);

        DECLARE string VARIABLES.crs_id=(SELECT id FROM OpenWorks_SM.CartoRefSys WHERE name = VARIABLES.target_crs);
        IF(VARIABLES.crs_id is NULL) ERROR VARIABLES.crs_errorMsg;

        INSERT INTO OpenWorks_SM.PointSet (point_set_id,map_data_set_name, geo_type, geo_name, data_source, point_set_type, strat_column, geologic_feature, default_znon, sorted, min_x, max_x, min_y, max_y,crs_id, num_points,original_data_source, remark, processing_parameter_nbytes, processing_parameter,data,DataDomain,Datum,MinZ,MaxZ,orig_crs)
        values (VARIABLES.point_set_id,"NEW".map_data_set_name, "NEW".geo_type, "NEW".geo_name, "NEW".data_source, "NEW".point_set_type, "NEW".strat_column, "NEW".geologic_feature, "NEW".default_znon, "NEW".sorted, "NEW".min_x, "NEW".max_x, "NEW".min_y, "NEW".max_y, VARIABLES.crs_id, "NEW".num_points,"NEW".original_data_source, "NEW".remark, "NEW".processing_parameter_nbytes, "NEW".processing_parameter,"NEW".data,"NEW".z_domain,"NEW".datum,"NEW".min_z,"NEW".max_z,"NEW".crs);


END;

CREATE TRIGGER ON PointSet INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC

       DECLARE string VARIABLES.crs_errorMsg='ERROR: The given value for crs does not exist';
       DECLARE string VARIABLES.crs_id;
       DECLARE Blob pointSetData;
       DECLARE string VARIABLES.x_point_set_id;
       DECLARE string VARIABLES.y_point_set_id;
       DECLARE integer VARIABLES.z_point_set_id;
	   DECLARE float VARIABLES.x_min;
	   DECLARE float VARIABLES.x_max;
	   DECLARE float VARIABLES.y_min;
	   DECLARE float VARIABLES.z_min;
	   DECLARE float VARIABLES.y_max;
	   DECLARE float VARIABLES.z_max;
	   DECLARE string VARIABLES.DataDomain;
	   DECLARE float VARIABLES.Datum;
       DECLARE string VARIABLES.target_crs = (SELECT xy_crs FROM OpenWorksCommonModel.Project);


        IF("NEW".crs is NOT NULL)
    BEGIN
    VARIABLES.crs_id     = (SELECT id FROM OpenWorks_SM.CartoRefSys WHERE name = VARIABLES.target_crs);
    IF(VARIABLES.crs_id is NULL) ERROR VARIABLES.crs_errorMsg;
    END

        DECLARE string VARIABLES.point_set_id = (SELECT point_set_id FROM OpenWorks_SM.PointSet WHERE geo_name = "OLD".geo_name and data_source = "OLD".data_source and geo_type = "OLD".geo_type and map_data_set_name = "OLD".map_data_set_name and point_set_type = "OLD".point_set_type);



		if(CHANGING.data)
		BEGIN
		VARIABLES.x_min = CAST("OLD".min_x AS float);
		if("CHANGING".min_x)
			VARIABLES.x_min = CAST("NEW".min_x AS float);
		VARIABLES.y_min = CAST("OLD".min_y AS float);
		if("CHANGING".min_y)
			VARIABLES.y_min = CAST("NEW".min_y AS float);
		VARIABLES.z_min = CAST("OLD".min_z AS float);
		if("CHANGING".min_z)
			VARIABLES.z_min = CAST("NEW".min_z AS float);
        VARIABLES.x_max = CAST("OLD".max_x AS float);
		if("CHANGING".max_x)
			VARIABLES.x_max = CAST("NEW".max_x AS float);
		VARIABLES.y_max = CAST("OLD".max_y AS float);
		if("CHANGING".max_y)
			VARIABLES.y_max = CAST("NEW".max_y AS float);
		VARIABLES.z_max = CAST("OLD".max_z AS float);
		if("CHANGING".max_z)
			VARIABLES.z_max = CAST("NEW".max_z AS float);
		VARIABLES.DataDomain = "OLD".z_domain;
		if("CHANGING".z_domain)
			VARIABLES.DataDomain ="NEW".z_domain;
		VARIABLES.Datum ="OLD".datum;
		if("CHANGING".datum)
			VARIABLES.Datum = "NEW".datum;
		DECLARE integer VARIABLES.numPts="OLD".num_points;
		if("CHANGING".num_points)
			VARIABLES.numPts = "NEW".num_points;
		delete FROM OpenWorks_SM.PointSetField WHERE point_set_id = VARIABLES.point_set_id and field_type=1 and upper(attribute) like 'X%';
        delete  FROM OpenWorks_SM.PointSetField WHERE point_set_id = VARIABLES.point_set_id and field_type=2 and upper(attribute) like 'Y%';
        delete  from OpenWorks_SM.PointSetField WHERE point_set_id=VARIABLES.point_set_id and point_set_field_id = (EXEC DeterminePointSetFieldZ(cast(VARIABLES.point_set_id AS integer),3));
			if(CHANGING.crs)
				UPDATE OpenWorks_SM.PointSet set strat_column = "NEW".strat_column, geologic_feature = "NEW".geologic_feature, default_znon = "NEW".default_znon,  sorted = "NEW".sorted, min_x = VARIABLES.x_min, max_x =  VARIABLES.x_max, min_y = VARIABLES.y_min, max_y = VARIABLES.y_max,  crs_id = VARIABLES.crs_id, original_data_source = "NEW".original_data_source, remark = "NEW".remark, processing_parameter_nbytes = "NEW".processing_parameter_nbytes,  processing_parameter = "NEW".processing_parameter,data="NEW".data,num_points="NEW".num_points,orig_crs="NEW".crs,DataDomain=VARIABLES.DataDomain,Datum=VARIABLES.Datum,MinZ=VARIABLES.z_min,MaxZ=VARIABLES.z_max where point_set_id = VARIABLES.point_set_id;
			else
				UPDATE OpenWorks_SM.PointSet set strat_column = "NEW".strat_column, geologic_feature = "NEW".geologic_feature, default_znon = "NEW".default_znon,  sorted = "NEW".sorted, min_x = VARIABLES.x_min, max_x =  VARIABLES.x_max, min_y = VARIABLES.y_min, max_y = VARIABLES.y_max,  crs_id = VARIABLES.crs_id, original_data_source = "NEW".original_data_source, remark = "NEW".remark, processing_parameter_nbytes = "NEW".processing_parameter_nbytes,  processing_parameter = "NEW".processing_parameter,data="NEW".data,num_points="NEW".num_points,DataDomain=VARIABLES.DataDomain,Datum=VARIABLES.Datum,MinZ=VARIABLES.z_min,MaxZ=VARIABLES.z_max where point_set_id = VARIABLES.point_set_id;
		END
		ELSE
		BEGIN
			UPDATE OpenWorks_SM.PointSet set strat_column = "NEW".strat_column, geologic_feature = "NEW".geologic_feature, default_znon = "NEW".default_znon,  sorted = "NEW".sorted, crs_id = VARIABLES.crs_id, original_data_source = "NEW".original_data_source, remark = "NEW".remark, processing_parameter_nbytes = "NEW".processing_parameter_nbytes,  processing_parameter = "NEW".processing_parameter where point_set_id = VARIABLES.point_set_id;




        IF((CHANGING.datum) OR (CHANGING.datum_unit) OR (CHANGING.z_domain) OR (CHANGING.z_unit) OR (CHANGING.min_z) OR (CHANGING.max_z))
		BEGIN
			VARIABLES.x_point_set_id = (SELECT point_set_field_id FROM OpenWorks_SM.PointSetField WHERE point_set_id = VARIABLES.point_set_id and field_type=1 and upper(attribute) like 'X%');
			VARIABLES.y_point_set_id = (SELECT point_set_field_id FROM OpenWorks_SM.PointSetField WHERE point_set_id = VARIABLES.point_set_id and field_type=2 and upper(attribute) like 'Y%');
			VARIABLES.z_point_set_id = (SELECT t1.pointSetField from (EXEC DeterminePointSetFieldZ(cast(VARIABLES.point_set_id AS integer),3)) as t1);
            UPDATE OpenWorks_SM.PointSetField SET  data_type ='DOUBLE', storage_datum = VARIABLES.Datum, storage_datum_dsdsunit = "NEW".datum_unit, min_val = VARIABLES.x_min, max_val = VARIABLES.x_max, min_val_dsdsunit = "NEW".xy_unit, max_val_dsdsunit = "NEW".xy_unit, znon = CAST("NEW".default_znon AS float),data_dsdsunit = "NEW".xy_unit where point_set_field_id = VARIABLES.x_point_set_id;

            UPDATE OpenWorks_SM.PointSetField SET  data_type ='DOUBLE', storage_datum = VARIABLES.Datum, storage_datum_dsdsunit = "NEW".datum_unit, min_val = VARIABLES.y_min, max_val = VARIABLES.y_max, min_val_dsdsunit = "NEW".xy_unit, max_val_dsdsunit = "NEW".xy_unit, znon = CAST("NEW".default_znon AS float),data_dsdsunit = "NEW".xy_unit where point_set_field_id = VARIABLES.y_point_set_id;

            UPDATE OpenWorks_SM.PointSetField SET  data_type ='FLOAT', data_domain = VARIABLES.DataDomain,storage_datum = "NEW".datum, storage_datum_dsdsunit = "NEW".datum_unit, min_val = VARIABLES.z_min, max_val = VARIABLES.z_max,min_val_dsdsunit = "NEW".z_unit, max_val_dsdsunit = "NEW".z_unit, znon = CAST("NEW".default_znon AS float),data_dsdsunit = "NEW".z_unit where point_set_field_id = VARIABLES.z_point_set_id;

        END
	END

END;


CREATE TRIGGER ON PointSet INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC

    DECLARE string VARIABLES.point_set_id = (SELECT point_set_id FROM OpenWorks_SM.PointSet WHERE geo_name = "OLD".geo_name and data_source = "OLD".data_source and geo_type = "OLD".geo_type and map_data_set_name = "OLD".map_data_set_name and point_set_type = "OLD".point_set_type);

    DELETE FROM OpenWorks_SM.PointSet WHERE point_set_id = VARIABLES.point_set_id;

END;

/*
**********************************
*     "PointSetField"
**********************************
*/

CREATE VIEW PointSetField
(
  native_uid            VARCHAR(1024)  OPTIONS("OpenWorksCommonModel:PointSetField.native_uid.isUpdatable" false,
                                                "OpenWorksCommonModel:PointSetField.native_uid.isCreatable" false,
                                                UPDATABLE 'FALSE'),
  pointset_native_uid   VARCHAR(1024) NOT NULL,
  map_data_set_name      VARCHAR(24) OPTIONS("OpenWorksCommonModel:PointSetField.map_data_set_name.isUpdatable" false,
                                            "OpenWorksCommonModel:PointSetField.map_data_set_name.isCreatable" false,
                                            UPDATABLE 'FALSE'),
  geo_type              VARCHAR(10) OPTIONS("OpenWorksCommonModel:PointSetField.geo_type.isUpdatable" false,
                                            "OpenWorksCommonModel:PointSetField.geo_type.isCreatable" false,
                                            UPDATABLE 'FALSE'),
  geo_name              VARCHAR(50) OPTIONS("OpenWorksCommonModel:PointSetField.geo_name.isUpdatable" false,
                                            "OpenWorksCommonModel:PointSetField.geo_name.isCreatable" false,
                                            UPDATABLE 'FALSE'),
  data_source           VARCHAR(5)  OPTIONS("OpenWorksCommonModel:PointSetField.data_source.isUpdatable" false,
                                            "OpenWorksCommonModel:PointSetField.data_source.isCreatable" false,
                                            UPDATABLE 'FALSE'),
  point_set_type        VARCHAR(9)  OPTIONS("OpenWorksCommonModel:PointSetField.point_set_type.isUpdatable" false,
                                            "OpenWorksCommonModel:PointSetField.point_set_type.isCreatable" false,
                                            UPDATABLE 'FALSE'),
  attribute             VARCHAR(40) NOT NULL DEFAULT 'UNKNOWN',
  field_type            INTEGER     NOT NULL DEFAULT '0',
  data_type             VARCHAR(8) NOT NULL DEFAULT 'FLOAT',
  unit_type             VARCHAR(4000),
  unit                  VARCHAR(64),
  unit_desc             VARCHAR(30),
  data_domain           VARCHAR(12),
  z_domain_qualifier    VARCHAR(24),
  datum                 FLOAT       OPTIONS ("OpenWorksCommonModel:PointSetField.datum.unitField" 'datum_unit'),
  datum_unit            VARCHAR(64) OPTIONS ("OpenWorksCommonModel:PointSetField.datum_unit.unitType" 'elevation'),
  create_date           TIMESTAMP   OPTIONS("OpenWorksCommonModel:PointSetField.create_date.isUpdatable" false,
                                            "OpenWorksCommonModel:PointSetField.create_date.isCreatable" false,UPDATABLE 'FALSE'),
  create_user_id        VARCHAR(32) OPTIONS("OpenWorksCommonModel:PointSetField.create_user_id.isUpdatable" false,
                                            "OpenWorksCommonModel:PointSetField.create_user_id.isCreatable" false,UPDATABLE 'FALSE'),
  update_date           TIMESTAMP   OPTIONS("OpenWorksCommonModel:PointSetField.update_date.isUpdatable" false,
                                            "OpenWorksCommonModel:PointSetField.update_date.isCreatable" false,UPDATABLE 'FALSE'),
  update_user_id        VARCHAR(32) OPTIONS("OpenWorksCommonModel:PointSetField.update_user_id.isUpdatable" false,
                                            "OpenWorksCommonModel:PointSetField.update_user_id.isCreatable" false,UPDATABLE 'FALSE'),

  min_val               FLOAT,
  max_val               FLOAT,
  znon                  FLOAT,
  sort_key_seq          INTEGER,
  field_display_width   INTEGER,
  decimal_precision     INTEGER,
  print_format          VARCHAR(1),
  num_points            INTEGER     DEFAULT '0',
  remark                VARCHAR(200),
  data                  BLOB        OPTIONS ("OpenWorksCommonModel:PointSetField.data.isMedia"      true,
                                             "OpenWorksCommonModel:PointSetField.data.mediaContentType" 'application/octet-stream',
											"OpenWorksCommonModel:PointSetField.data.elementType" 'array_typed',
                                             "OpenWorksCommonModel:PointSetField.data.ArrayAny" true),
  alternate_uid    		    VARCHAR(4000)  OPTIONS ("OpenWorksCommonModel:PointSetField.alternate_uid.isCreatable" false,
                                                "OpenWorksCommonModel:PointSetField.alternate_uid.isUpdatable" false,
                                                 UPDATABLE 'FALSE'),

    CONSTRAINT PointSetField_PK PRIMARY KEY (native_uid),

    CONSTRAINT PointSetField_UK1 UNIQUE (pointset_native_uid, attribute),

    CONSTRAINT FK_PointSet_pointset_native_uid
        FOREIGN KEY        (pointset_native_uid)
        REFERENCES PointSet(native_uid),

    CONSTRAINT FK_PointSetField_data_source
        FOREIGN KEY (data_source)
        REFERENCES DataSource(name)

)OPTIONS (UPDATABLE 'TRUE',PointSetField.IMPLEMENTED 'TRUE')
    AS
SELECT
 Openworks_SM.PointSetField.point_set_field_id AS native_uid,
 Openworks_SM.PointSet.point_set_id AS pointset_native_uid,
 map_data_set_name,
 geo_type,
 geo_name,
 data_source,
 point_set_type,
 attribute,
    cast(field_type AS integer),
 data_type,
 unit_type_id AS unit_type,
 min_val_dsdsunit AS unit,
 unit_desc,
 data_domain,
 z_domain_qualifier,
 working_datum AS datum,
 working_datum_dsdsunit AS datum_unit,
 Openworks_SM.PointSetField.create_date,
 Openworks_SM.PointSetField.create_user_id,
 Openworks_SM.PointSetField.update_date,
 Openworks_SM.PointSetField.update_user_id,
 min_val,
 max_val,
 znon,
 sort_key_seq,
 field_display_width,
 decimal_precision,
 print_format,
 Openworks_SM.PointSetField.num_points,
 Openworks_SM.PointSetField.remark,
 Openworks_SM.PointSetField.data_stream,
 Openworks_SM.PointSetField.native_uid
    FROM
        Openworks_SM.PointSet, Openworks_SM.PointSetField where Openworks_SM.PointSetField.point_set_id = Openworks_SM.PointSet.point_set_id and Openworks_SM.PointSetField.field_type  NOT IN (1,2) and upper(attribute) not like ('Z%');


CREATE TRIGGER ON PointSetField INSTEAD OF INSERT AS
FOR EACH ROW
BEGIN ATOMIC

        DECLARE string VARIABLES.point_set_id_errorMsg='ERROR: The PointSet with values given for (geo_name,data_source,geo_type,map_data_set_name,point_set_type) does not exist';
        DECLARE integer VARIABLES.point_set_field_id = (SELECT * FROM (EXEC OpenWorks_SM.nextval('PointSetField')) AS SysGenID);

        DECLARE string VARIABLES.point_set_id = (SELECT point_set_id FROM OpenWorks_SM.PointSet WHERE point_set_id = "NEW".pointset_native_uid);

		DECLARE integer VARIABLES.num_points = "NEW".num_points;
		DECLARE integer VARIABLES.field_type = "NEW".field_type;

		        IF( VARIABLES.point_set_id is NULL) ERROR VARIABLES.point_set_id_errorMsg;

		IF((VARIABLES.num_points IS NULL) OR (VARIABLES.num_points = 0))
		BEGIN
		   VARIABLES.num_points = (SELECT num_points FROM OpenWorks_SM.PointSetfield where point_set_id="NEW".pointset_native_uid and attribute='X' limit 1);
		END
		IF(VARIABLES.field_type IS NULL)
		BEGIN
			VARIABLES.field_type = 0;
		END
		IF("NEW".data IS NULL)
		BEGIN
          INSERT INTO OpenWorks_SM.PointSetField(point_set_field_id,point_set_id,attribute,field_type,data_type,data_domain,unit_type_id,storage_datum,storage_datum_dsdsunit,min_val,max_val,min_val_dsdsunit,max_val_dsdsunit,znon,num_points,data_dsdsunit,unit_desc,remark,sort_key_seq,field_display_width,decimal_precision,print_format)
          values(VARIABLES.point_set_field_id,VARIABLES.point_set_id,"NEW".attribute,VARIABLES.field_type,"NEW".data_type,"NEW".data_domain,"NEW".unit_type,"NEW".datum,"NEW".datum_unit,"NEW".min_val,"NEW".max_val,"NEW".unit,"NEW".unit,"NEW".znon,VARIABLES.num_points,"NEW".unit,"NEW".unit_desc,"NEW".remark,"NEW".sort_key_seq,"NEW".field_display_width,"NEW".decimal_precision,"NEW".print_format);
        END
        ELSE
        BEGIN
          INSERT INTO OpenWorks_SM.PointSetField(point_set_field_id,point_set_id,attribute,field_type,data_type,data_domain,unit_type_id,storage_datum,storage_datum_dsdsunit,min_val,max_val,min_val_dsdsunit,max_val_dsdsunit,znon,num_points,data_stream,data_dsdsunit,unit_desc,remark,sort_key_seq,field_display_width,decimal_precision,print_format)
          values(VARIABLES.point_set_field_id,VARIABLES.point_set_id,"NEW".attribute,VARIABLES.field_type,"NEW".data_type,"NEW".data_domain,"NEW".unit_type,"NEW".datum,"NEW".datum_unit,"NEW".min_val,"NEW".max_val,"NEW".unit,"NEW".unit,"NEW".znon,VARIABLES.num_points,"NEW".data,"NEW".unit,"NEW".unit_desc,"NEW".remark,"NEW".sort_key_seq,"NEW".field_display_width,"NEW".decimal_precision,"NEW".print_format);
        END
END;

CREATE TRIGGER ON PointSetField INSTEAD OF UPDATE AS
FOR EACH ROW
BEGIN ATOMIC

    /*DECLARE integer VARIABLES.point_set_id = (SELECT point_set_id FROM OpenWorks_SM.PointSet WHERE point_set_id = "NEW".pointset_native_uid);

    DECLARE integer VARIABLES.point_set_field_id = -1;
    IF("OLD".data_domain IS NULL)
    BEGIN
        VARIABLES.point_set_field_id = (SELECT point_set_field_id FROM OpenWorks_SM.PointSetField WHERE point_set_id = VARIABLES.point_set_id and attribute ="OLD".attribute and field_type = "OLD".field_type);
    END ELSE
    BEGIN
        VARIABLES.point_set_field_id = (SELECT point_set_field_id FROM OpenWorks_SM.PointSetField WHERE point_set_id = VARIABLES.point_set_id and attribute ="OLD".attribute and field_type = "OLD".field_type and data_domain = "OLD".data_domain);
    END*/

    IF("NEW".data IS NOT NULL AND CHANGING.data)
    BEGIN
      UPDATE OpenWorks_SM.PointSetField set
        field_type = "NEW".field_type,
        data_type = "NEW".data_type,
        data_domain = "NEW".data_domain,
        unit_type_id =  "NEW".unit_type,
        storage_datum = "NEW".datum,
        storage_datum_dsdsunit = "NEW".datum_unit,
        min_val = "NEW".min_val,
        max_val = "NEW".max_val,
        min_val_dsdsunit = "NEW".unit,
        max_val_dsdsunit = "NEW".unit,
        znon = "NEW".znon,
        num_points = "NEW".num_points,
        data_stream = "NEW".data,
        data_dsdsunit = "NEW".unit,
        unit_desc ="NEW".unit_desc,
        remark = "NEW".remark,
        sort_key_seq = "NEW".sort_key_seq,
        field_display_width = "NEW".field_display_width,
        decimal_precision = "NEW".decimal_precision,
        print_format = "NEW".print_format
      where point_set_field_id = "OLD".native_uid;
    END
    ELSE
    BEGIN
      UPDATE OpenWorks_SM.PointSetField set
        field_type = "NEW".field_type,
        data_type = "NEW".data_type,
        data_domain = "NEW".data_domain,
        unit_type_id =  "NEW".unit_type,
        storage_datum = "NEW".datum,
        storage_datum_dsdsunit = "NEW".datum_unit,
        min_val = "NEW".min_val,
        max_val = "NEW".max_val,
        min_val_dsdsunit = "NEW".unit,
        max_val_dsdsunit = "NEW".unit,
        znon = "NEW".znon,
        num_points = "NEW".num_points,
        data_dsdsunit = "NEW".unit,
        unit_desc ="NEW".unit_desc,
        remark = "NEW".remark,
        sort_key_seq = "NEW".sort_key_seq,
        field_display_width = "NEW".field_display_width,
        decimal_precision = "NEW".decimal_precision,
        print_format = "NEW".print_format
      where point_set_field_id = "OLD".native_uid;
    END

END;

CREATE TRIGGER ON PointSetField INSTEAD OF DELETE AS
FOR EACH ROW
BEGIN ATOMIC

   /*DECLARE integer VARIABLES.point_set_id = (SELECT point_set_id FROM OpenWorks_SM.PointSet WHERE geo_name = "OLD".geo_name and data_source = "OLD".data_source and geo_type = "OLD".geo_type and map_data_set_name = "OLD".map_data_set_name and point_set_type = "OLD".point_set_type);

  DECLARE integer VARIABLES.point_set_field_id = -1;
