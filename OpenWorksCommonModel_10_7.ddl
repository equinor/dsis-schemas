        rotation_j = "NEW".rotation_j,
        rotation_unit = "NEW".rotation_unit,
        rotation_origin_x = "NEW".rotation_origin_x,
        rotation_origin_y = "NEW".rotation_origin_y,*/
        OpenWorks_SM.Rgrid.znon = "NEW".data_null_value,
        OpenWorks_SM.Rgrid.data = "NEW".data_values,
        unit_desc = "NEW".z_unit,
        unit_type_id = "NEW".z_unit_type,
